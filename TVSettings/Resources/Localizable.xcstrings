        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ikke ut til at profilen for denne konfigurasjonen er lastet inn. Prøv å bytte til Manuelt og tilbake til denne konfigurasjonen og så starte på nytt for å prøve å laste inn profilen igjen."
