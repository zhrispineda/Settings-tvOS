    "APSecurityChangePasswordMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة سر لتقييد وصول البث السريع. ستحتاج إلى كلمة السر لاستخدام البث السريع مع هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una contrasenya per restringir l’accés a l’AirPlay. La necessitaràs per fer servir l’AirPlay amb aquest Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte heslo pro omezení přístupu k AirPlay. Toto heslo budete potřebovat při použití AirPlay s touto Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en adgangskode for at begrænse AirPlay-adgang. Du skal bruge adgangskoden for at bruge AirPlay med dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Passwort aus, um den Zugriff auf AirPlay zu beschränken. Du benötigst das Passwort, um AirPlay mit diesem Apple TV zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα συνθηματικό για περιορισμό της πρόσβασης στο AirPlay. Θα χρειαστείτε το συνθηματικό για χρήση του AirPlay με αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password to restrict AirPlay access. You’ll need the password to use AirPlay with this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password to restrict AirPlay access. You’ll need the password to use AirPlay with this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password to restrict AirPlay access. You’ll need the password to use AirPlay with this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una contraseña para restringir el acceso a AirPlay. La necesitarás para utilizar AirPlay con este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una contraseña para restringir el acceso de AirPlay. La necesitarás al usar AirPlay con este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una contraseña para restringir el acceso de AirPlay. La necesitarás al usar AirPlay con este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajoita AirPlayn käyttöä valitsemalla salasana. Tarvitset salasanan, jotta voit käyttää AirPlayta tässä Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mot de passe pour restreindre l’accès via AirPlay. Ce mot de passe sera nécessaire lors de l’utilisation d’AirPlay avec cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un mot de passe pour restreindre l’accès à AirPlay. Il vous sera nécessaire pour utiliser AirPlay avec cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור סיסמה כדי להגביל את הגישה ל-AirPlay. יהיה לך צורך בסיסמה זו כדי להשתמש ב-AirPlay עם ה-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay का ऐक्सेस प्रतिबंधित करने के लिए पासवर्ड चुनें। आपको इस Apple TV के साथ AirPlay का उपयोग करने के लिए पासवर्ड की आवश्यकता होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite lozinku za ograničavanje pristupa AirPlayu. Lozinka će vam trebati za uporabu AirPlaya s ovim Apple TV‑om."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthat egy jelszót, amellyel korlátozhatja az AirPlayhez való hozzáférést. Ezt a jelszót kell megadni, amikor az AirPlayt ezzel az Apple TV-vel használják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata sandi untuk membatasi akses AirPlay. Anda akan memerlukan kata sandi untuk menggunakan AirPlay dengan Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una password per limitare l’accesso ad AirPlay. Ti servirà per utilizzare AirPlay con questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayへのアクセス用パスワードを選択します。このパスワードは、このApple TVでAirPlayを使用するために必要となります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 접근을 제한하려면 암호를 선택하십시오. 이 Apple TV와 AirPlay를 사용할 때 암호를 입력해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata laluan untuk mengehadkan akses AirPlay. Anda memerlukan kata laluan untuk menggunakan AirPlay dengan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et passord for å begrense AirPlay-tilgangen. Du trenger passordet for å bruke AirPlay med Apple TV-enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een wachtwoord om AirPlay-toegang te beperken. Dit wachtwoord moet je invoeren om AirPlay met deze Apple TV te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określ hasło, aby ograniczyć dostęp do AirPlay. Będzie ono wymagane do używania AirPlay z tym Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma senha para restringir o acesso ao AirPlay. Você precisará da senha para usar o AirPlay com esta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma palavra‑passe para restringir o acesso ao AirPlay. Necessitará da palavra‑passe para utilizar o AirPlay com esta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o parolă pentru a restricționa accesul AirPlay. Parola va fi necesară pentru a utiliza AirPlay cu acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите пароль для ограничения доступа к AirPlay. Этот пароль потребуется для использования AirPlay с этим Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte heslo na obmedzenie prístupu k AirPlay. Toto heslo budete potrebovať na používanie AirPlay s týmto Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite geslo, da omejite dostop funkcije AirPlay. Če boste želeli uporabljati funkcijo AirPlay s tem Apple TV-jem, boste potrebovali geslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett lösenord för begränsning av tillgången till AirPlay. Lösenordet kommer att behövas för att använda AirPlay med denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรหัสผ่านเพื่อจำกัดการเข้าถึง AirPlay คุณจะต้องป้อนรหัสผ่านนี้เพื่อใช้ AirPlay กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay erişimini sınırlamak için bir parola seçin. Bu Apple TV ile AirPlay’i kullanmak için bu parolaya gereksiniminiz olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть пароль, щоб обмежити доступ до AirPlay. Цей пароль буде потрібен для використання AirPlay із цим Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mật khẩu để hạn chế truy cập vào AirPlay. Bạn sẽ cần mật khẩu để sử dụng AirPlay với Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取密码来限制访问隔空播放。你需要输入密码才能通过此Apple TV隔空播放。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇限制取用AirPlay的密碼。你將需要該密碼以在此Apple TV上使用AirPlay。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要限制AirPlay連線權限的密碼。你需要該密碼才能搭配此Apple TV使用AirPlay。"
          }
        }
      }
    },
