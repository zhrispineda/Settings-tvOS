    "iTMSFreeNoDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم مطالبتك بكلمة السر الخاصة بك عند تنزيل العناصر المجانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No se’t demanarà la contrasenya quan descarreguis ítems gratuïts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při stahování bezplatných položek nebudete žádáni o heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bliver ikke bedt om din adgangskode, når du henter gratis emner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst bei kostenlosen Downloads nicht nach deinem Passwort gefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν θα ζητηθεί το συνθηματικό σας κατά τη λήψη δωρεάν στοιχείων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be asked for your password when downloading free items."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be asked for your password when downloading free items."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be asked for your password when downloading free items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se te solicitará la contraseña en las descargas de ítems gratuitos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se solicitará una contraseña al descargar elementos gratuitos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se solicitará una contraseña al descargar elementos gratuitos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaasi ei kysytä, kun lataat ilmaisia kohteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe ne vous sera pas demandé lorsque vous téléchargez des éléments gratuits."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe ne vous sera pas demandé lorsque vous téléchargez des éléments gratuits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במהלך הורדה של פריטים ללא תשלום, לא יהיה לך צורך לספק סיסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त आइटम डाउनलोड करते समय आपसे पासवर्ड नहीं पूछा जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilikom preuzimanja besplatnih stavki neće se zatražiti unos vaše lozinke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer nem fog jelszót kérni az ingyenes elemek letöltésekor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak akan dimintai kata sandi Anda saat mengunduh item gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verrà richiesta la password per i download gratuiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の項目をダウンロードするときにパスワードは求められません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 항목을 다운로드하는 경우에는 암호를 물어보지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan anda tidak akan diminta semasa memuat turun item percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ikke bli spurt om passord når du laster ned gratisobjekter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt niet gevraagd om je wachtwoord als je gratis onderdelen downloadt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do pobierania bezpłatnych rzeczy hasło nie będzie wymagane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha não será exigida para baixar itens gratuitos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não lhe será pedida a palavra‑passe quando descarregar elementos gratuitos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola dvs. nu va fi solicitată la descărcarea articolelor gratuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке бесплатного контента пароль запрашиваться не будет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri sťahovaní bezplatných položiek nebude potrebné zadávať heslo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob prenosu brezplačne vsebine vam ne bo treba vnesti gesla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer inte att bli tillfrågad om lösenordet när du hämtar kostnadsfria objekt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่ถูกถามรหัสผ่านเมื่อดาวน์โหลดรายการฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz öğeleri indirirken parolanız sorulmayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
