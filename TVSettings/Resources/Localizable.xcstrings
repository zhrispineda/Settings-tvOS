    "AccountsSharedWithYouDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للوسائط التي تتم مشاركتها معك في تطبيق الرسائل على iPhone أو iPad بأن تظهر تلقائيًا في التطبيقات المحددة على هذ الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que el contingut compartit amb tu a través de l’app Missatges de l’iPhone o l’iPad aparegui automàticament a les apps seleccionades d’aquest Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde můžete povolit, aby se média, která s vámi sdílejí jiní lidé prostřednictvím Zpráv na iPhonu a iPadu, automaticky objevovala ve vybraných aplikacích na této Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad, at medier, der deles med dig i Beskeder på din iPhone eller iPad, automatisk vises i valgte apps på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube, dass mit dir in „Nachrichten“ geteilte Medien auf deinem iPhone oder iPad automatisch in ausgewählten Apps auf diesem Apple TV angezeigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πολυμέσα που έχουν κοινοποιηθεί σε εσάς μέσω των Μηνυμάτων στο iPhone ή το iPad σας θα εμφανίζονται αυτόματα σε επιλεγμένες εφαρμογές σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow media shared with you in Messages on your iPhone or iPad to automatically appear in selected apps on this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow media shared with you in Messages on your iPhone or iPad to automatically appear in selected apps on this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow media shared with you in Messages on your iPhone or iPad to automatically appear in selected apps on this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el contenido compartido contigo a través de la app Mensajes del iPhone o el iPad aparezca automáticamente en determinadas apps de este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el contenido multimedia que se comparte contigo en Mensajes en tu iPhone o iPad se muestre automáticamente en las apps seleccionadas en este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el contenido multimedia que se comparte contigo en Mensajes en tu iPhone o iPad se muestre automáticamente en las apps seleccionadas en este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulle iPhonen tai iPadin Viesteissä jaettu media saa näkyä automaattisesti valituissa apeissa tässä Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les médias partagés avec vous dans Messages sur votre iPhone ou votre iPad à apparaître automatiquement dans les apps sélectionnées sur cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’affichage automatique dans certaines apps de cette Apple TV du contenu multimédia partagé avec vous dans Messages sur votre iPhone ou iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר למדיה ששותפה איתך דרך ״הודעות״ ב-iPhone או ב-iPad להופיע באופן אוטומטי ביישומים נבחרים ב‑Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश ऐप में आपके साथ आपके iPhone या iPad पर शेयर किया गया मीडिया इस Apple TV पर चुने गए ऐप्स में ऑटोमैटिकली दिखाए जाने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite da se medij koji je s vama podijeljen u Porukama na iPhoneu ili iPadu automatski prikazuje u odabranim aplikacijama na ovom Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezheti, hogy az iPhone-ján vagy iPadjén lévő Üzenetekben Önnel megosztott médiatartalmak automatikusan megjelenjenek a kijelölt appokban ezen az Apple TV-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan media yang dibagikan dengan Anda di Pesan di iPhone atau iPad Anda untuk muncul secara otomatis di app yang dipilih di Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti che i contenuti multimediali condivisi con te in Messaggi su iPhone o iPad vengano mostrati automaticamente in app selezionate su Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneまたはiPadの“メッセージ”で共有されたメディアが、このApple TVで選択したアプリに自動的に表示されるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad의 메시지 앱에서 사용자와 공유된 미디어가 이 Apple TV에서 선택한 앱에 자동으로 표시되도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan media yang dikongsi dengan anda dalam Mesej pada iPhone atau iPad anda untuk kelihatan secara automatik dalam app yang dipilih pada Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at media som deles med deg i Meldinger på iPhone eller iPad, vises automatisk i utvalgte apper på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat media die met je worden gedeeld in Berichten op je iPhone of iPad, automatisch worden weergegeven in geselecteerde apps op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Multimedia, które inni udostępnią Ci w Wiadomościach na Twoim iPhonie lub iPadzie, będą automatycznie wyświetlane w wybranych aplikacjach na tym Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que as mídias compartilhadas com você no app Mensagens no iPhone ou iPad apareçam automaticamente em apps selecionados nesta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que os conteúdos multimédia partilhados consigo na aplicação Mensagens no iPhone ou iPad apareçam automaticamente em determinadas aplicações nesta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți afișarea automată a conținutului multimedia partajat cu dvs. în aplicația Mesaje de pe iPhone sau iPad în aplicațiile selectate de pe acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиафайлы, которые Вы получили от других людей через Сообщения на iPhone или iPad, будут автоматически отображаться в выбранных приложениях на этом Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Médiá zdieľané s vami v apke Správy na iPhone alebo iPade sa budú automaticky zobrazovať vo vybraných apkách na tomto Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogočite, da se predstavnostne vsebine, ki jih je nekdo delil z vami v aplikaciji Sporočila v vašem iPhonu ali iPadu, samodejno prikažejo v izbranih aplikacijah v tem Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att medier som delas med dig i Meddelanden på iPhone eller iPad visas automatiskt i valda appar på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตสื่อที่แชร์กับคุณในข้อความบน iPhone หรือ iPad ของคุณเพื่อให้แสดงในแอปที่เลือกโดยอัตโนมัติบน Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzdaki veya iPad’inizdeki Mesajlar’da sizinle paylaşılan ortamların bu Apple TV’de seçilen uygulamalarda otomatik olarak görünmesine izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дає змогу автоматично відображати у вибраних програмах на цьому Apple TV медіавміст, поширений для вас у Повідомленнях на iPhone чи iPad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép phương tiện được chia sẻ với bạn trong Tin nhắn trên iPhone hoặc iPad tự động xuất hiện trong các ứng dụng được chọn trên Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在iPhone或iPad的“信息”中与你共享的媒体自动出现在此Apple TV上选定的App中。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許iPhone或iPad上的「訊息」中與你共享的媒體，在此Apple TV上所選的App中自動顯示。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許此Apple TV的所選App自動顯示iPhone或iPad「訊息」中與你分享的媒體。"
          }
        }
      }
