    "AccountsTapToSetupErrorVersionMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم وجود iOS 9.1 أو أحدث على جهاز iOS.\nغير متوفر على iPad 2."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositiu iOS requereix l’iOS 9.1 o posterior.\nNo disponible a l’iPad 2."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše iOS zařízení vyžaduje iOS 9.1 nebo novější.\nNedostupné na iPadu 2."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iOS-enhed kræver iOS 9.1 eller en nyere version.\nIkke tilgængelig på iPad 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iOS-Gerät erfordert iOS 9.1 (oder neuer).\nNicht verfügbar auf iPad 2."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή iOS σας απαιτεί iOS 9.1 ή μεταγενέστερη έκδοση.\nΔεν διατίθεται στο iPad 2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iOS device requires iOS 9.1 or later.\nNot available on iPad 2."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iOS device requires iOS 9.1 or later.\nNot available on iPad 2."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iOS device requires iOS 9.1 or later.\nNot available on iPad 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo iOS requiere iOS 9.1 o posterior.\nNo disponible para iPad 2."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo iOS requiere iOS 9.1 o posterior.\nNo está disponible en iPad 2."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo iOS requiere iOS 9.1 o posterior.\nNo está disponible en iPad 2."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-laitteesi vaatii iOS 9.1:n tai uudemman.\nEi käytettävissä iPad 2:lla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil iOS requiert iOS 9.1 ou ultérieur.\nNon disponible sur iPad 2."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil iOS requiert iOS 9.1 ou ultérieur.\nNon disponible sur l’iPad 2."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר ה-iOS שלך מצריך שימוש ב-iOS 9.1 ומעלה.\nאינו זמין ב-iPad 2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iOS डिवाइस के लिए iOS 9.1 या बाद का संस्करण आवश्यक है।\niPad 2 पर उपलब्ध नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš iOS uređaj zahtijeva iOS 9.1 ili noviji.\nNije dostupno na iPadu 2."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS-eszközének iOS 9.1-re vagy újabb rendszerre van szüksége. Nem érhető el iPad 2-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat Anda memerlukan iOS 9.1 atau lebih baru.\nTidak tersedia di iPad 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo dispositivo iOS richiede iOS 9.1 o versione successiva.\nNon è disponibile su iPad 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのiOSデバイスにはiOS 9.1以降が必要です。\niPad 2では利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 iOS 기기가 iOS 9.1 이상이어야 합니다.\niPad 2에서는 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti iOS anda memerlukan iOS 9.1 atau lebih baharu.\nTidak tersedia pada iPad 2."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-enheten krever iOS 9.1 eller nyere.\nIkke tilgjengelig på iPad 2."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je iOS-apparaat moet iOS 9.1 of nieuwer zijn geïnstalleerd.\nNiet beschikbaar op de iPad 2."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie wymaga systemu iOS 9.1 lub nowszego.\nFunkcja niedostępna na iPadzie 2."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dispositivo iOS requer o iOS 9.1 ou posterior.\nNão disponível no iPad 2."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo iOS necessita do iOS 9.1 ou posterior.\nNão está disponível no iPad 2."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul dvs. iOS necesită iOS 9.1 sau o versiune ulterioară.\nIndisponibil pe iPad 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого устройства iOS требуется iOS 9.1 или новее.\nНедоступно на iPad 2."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše iOS zariadenie vyžaduje iOS 9.1 alebo novší.\nNedostupné na iPade 2."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša naprava iOS zahteva različico iOS 9.1 ali novejšo.\nNi na voljo za iPad 2."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-enheten kräver iOS 9.1 eller senare.\nInte tillgängligt på iPad 2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ iOS ของคุณต้องใช้ iOS 9.1 ขึ้นไป\nไม่สามารถใช้ได้บน iPad 2"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS aygıtınız iOS 9.1 veya daha yenisini gerektirir.\niPad 2 üzerinde kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пристрій iOS потребує iOS 9.1 або новішої версії.\nНедоступно на iPad 2."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị iOS của bạn yêu cầu iOS 9.1 trở lên.\nKhông có sẵn trên iPad 2."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要求你的iOS设备为iOS 9.1或更高版本。\niPad 2上不可用。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS裝置需要iOS 9.1或以上版本。\n不適用於iPad 2。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的iOS裝置需要iOS 9.1或以上版本。\n不適用於iPad 2。"
          }
        }
      }
    },
    "AccountsTapToSetupInstructions_WIFI": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١.\tافتح قفل iPhone أو iPad.\n‏٢.\tاتصل بشبكة Wi-Fi.\n‏٣.\tشغل Bluetooth.\n‏٤.\tقرّب الجهاز من هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueja l’iPhone o l’iPad.\n2.\tConnecta’t a una xarxa Wi‑Fi.\n3.\tActiva el Bluetooth.\n4.\tMantén el dispositiu a prop de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdemkněte iPhone nebo iPad.\n2.\tPřipojte se k Wi‑Fi síti.\n3.\tZapněte Bluetooth.\n4.\tPodržte zařízení u Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås din iPhone eller iPad op.\n2.\tOpret forbindelse til et Wi-Fi-netværk.\n3.\tSlå Bluetooth til.\n4.\tHold enheden tæt på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tEntsperre dein iPhone oder iPad.\n2.\tStelle eine WLAN-Verbindung her.\n3.\tAktiviere Bluetooth.\n4.\tHalte das Gerät dicht an das Apple TV."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tΞεκλειδώστε το iPhone ή το iPad σας.\n2.\tΣυνδεθείτε σε δίκτυο Wi-Fi.\n3.\tΕνεργοποιήστε το Bluetooth.\n4.\tΚρατήστε τη συσκευή κοντά σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi‑Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tAvaa iPhonesi tai iPadisi.\n2.\tYhdistä Wi‑Fi-verkkoon.\n3.\tLaita Bluetooth päälle.\n4.\tPidä laitetta Apple TV:n lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tConnectez-vous à un réseau Wi-Fi.\n3.\tActivez le Bluetooth.\n4.\tPlacez l’appareil près de cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tConnectez l’appareil à un réseau Wi‑Fi.\n3.\tActivez Bluetooth.\n4.\tTenez l’appareil à proximité de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tיש לבטל את נעילת ה-iPhone או ה-iPad.\n‏2.\tיש להתחבר לרשת אלחוטית.\n‏3.\tיש להפעיל את Bluetooth.\n‏4.\tיש להחזיק את המכשיר קרוב ל-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tअपना iPhone या iPad अनलॉक करें।\n2.\tकिसी वाई-फ़ाई नेटवर्क से जुड़ें।\n3.\tBluetooth चालू करें।\n4.\tडिवाइस को इस Apple TV के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOtključajte svoj iPhone ili iPad.\n2.\tSpojite se na Wi-Fi mrežu.\n3.\tUključite Bluetooth.\n4.\tDržite uređaj blizu ovog Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOldja fel az iPhone-ját vagy az iPadjét.\n2.\tCsatlakozzon Wi‑Fi-hálózathoz.\n3.\tKapcsolja be a Bluetootht.\n4.\tTartsa közel az eszközt az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka iPhone atau iPad Anda.\n2.\tHubungkan ke jaringan Wi-Fi.\n3.\tNyalakan Bluetooth.\n4.\tDekatkan perangkat ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tSblocca iPhone o iPad.\n2.\tConnettiti a una rete Wi‑Fi.\n3.\tAttiva il Bluetooth.\n4.\tAvvicina il dispositivo ad Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhoneまたはiPadをロック解除します。\n2.\tWi‑Fiネットワークに接続します。\n3.\tBluetoothをオンにします。\n4.\tデバイスをこのApple TVに近付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone 또는 iPad를 잠금 해제하십시오.\n2.\tWi-Fi 네트워크에 연결하십시오.\n3.\tBluetooth를 켜십시오.\n4.\t해당 기기를 이 Apple TV 가까이 들고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka kunci iPhone atau iPad anda.\n2.\tSambung ke rangkaian Wi‑Fi.\n3.\tAktifkan Bluetooth.\n4.\tPegang peranti berdekatan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås opp iPhonen eller iPaden.\n2.\tKoble til et Wi‑Fi-nettverk.\n3.\tSlå på Bluetooth.\n4.\tHold enheten nær Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOntgrendel je iPhone of iPad.\n2.\tMaak verbinding met een wifinetwerk.\n3.\tSchakel Bluetooth in.\n4.\tHoud het apparaat dicht bij deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdblokuj swojego iPhone’a lub iPada.\n2.\tPołącz się z siecią Wi‑Fi.\n3.\tWłącz Bluetooth.\n4.\tZbliż urządzenie do Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o seu iPhone ou iPad.\n2.\tConecte-se a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tAproxime o dispositivo desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o iPhone ou iPad.\n2.\tEstabeleça ligação a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tMantenha o dispositivo perto desta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDeblocați‑vă iPhone‑ul sau iPad‑ul.\n2.\tConectați‑l la o rețea Wi‑Fi.\n3.\tActivați Bluetooth.\n4.\tȚineți dispozitivul aproape de acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tРазблокируйте свой iPhone или iPad.\n2.\tПодключитесь к сети Wi‑Fi.\n3.\tВключите Bluetooth.\n4.\tДержите устройство вблизи этого Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdomknite svoj iPhone alebo iPad.\n2.\tPripojte sa k Wi‑Fi sieti.\n3.\tZapnite Bluetooth.\n4.\tPodržte zariadenie pri Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdklenite svoj iPhone ali iPad.\n2.\tPovežite se z omrežjem Wi-Fi.\n3.\tVklopite Bluetooth.\n4.\tPribližajte napravo Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås upp iPhone eller iPad.\n2.\tAnslut till Wi-Fi-nätverk.\n3.\tSlå på Bluetooth.\n4.\tHåll enheten nära denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tปลดล็อค iPhone หรือ iPad ของคุณ\n2.\tเชื่อมต่อกับเครือข่าย Wi‑Fi\n3.\tเปิดบลูทูธ\n4.\tถืออุปกรณ์ไว้ใกล้กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone’unuzun ya da iPad’inizin kilidini açın.\n2.\tBir Wi-Fi ağına bağlanın.\n3.\tBluetooth’u açın.\n4.\tAygıtı bu Apple TV’ye yakın tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tВідімкніть свій iPhone чи iPad.\n2.\tПідʼєднайте пристрій до мережі Wi‑Fi.\n3.\tУвімкніть Bluetooth.\n4.\tПіднесіть пристрій до цього Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tMở khóa iPhone hoặc iPad của bạn.\n2.\tKết nối vào mạng Wi-Fi.\n3.\tBật Bluetooth.\n4.\tGiữ thiết bị gần Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解锁你的iPhone或iPad。\n2.\t接入Wi-Fi网络。\n3.\t打开蓝牙。\n4.\t将设备靠近此Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t連接Wi-Fi網絡。\n3.\t開啟藍牙。\n4.\t將裝置靠近此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t連接Wi-Fi網路。\n3.\t開啟藍牙。\n4.\t將裝置靠近此Apple TV。"
          }
        }
      }
    },
