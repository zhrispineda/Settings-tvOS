          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแอปที่ซื้อใหม่ที่ซื้อจากอุปกรณ์เครื่องอื่นโดยอัตโนมัติรวมทั้งแอปฟรีด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer aygıtlarda yeni satın alınan uygulamaları (ücretsiz uygulamalar da dahil olmak üzere) otomatik olarak yükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично інсталювати нові програми (зокрема безплатні), придбані з інших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động cài đặt ứng dụng mới được mua (bao gồm ứng dụng miễn phí) trên các thiết bị khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动安装在其他设备上购买的新App（含免费App）。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動安裝其他裝置上購買的新App（包括免費App）。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動安裝其他裝置上購買的新App（包含免費App）。"
          }
        }
      }
    },
