        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить к инструкциям пользовательское сообщение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte do inštrukcií vlastnú správu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Navodilom dodajte sporočilo po meri."
          }
        },
        "sv": {
