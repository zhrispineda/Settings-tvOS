    "CapsLockDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مفتاح تثبيت العالي للتبديل من وإلى آخر لوحة مفاتيح تم استخدامها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem la tecla de bloqueig de majúscules per canviar entre el teclat actual i l’últim emprat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání poslední použité klávesnice pomocí klávesy Caps Lock."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug skiftelåstasten til at skifte til og fra det sidst brugte tastatur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feststelltaste zum Wechsel zu und von der zuletzt benutzen Tastatur verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση του πλήκτρου Caps Lock για εναλλαγή από και προς το πιο πρόσφατο πληκτρολόγιο που χρησιμοποιήθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Caps Lock key to switch to and from the last used keyboard."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Caps Lock key to switch to and from the last used keyboard."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Caps Lock key to switch to and from the last used keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tecla Bloq Mayús para intercambiar entre el teclado utilizado en ese momento y el anterior."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tecla bloqueo de mayúsculas para cambiar desde y al teclado más reciente."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tecla bloqueo de mayúsculas para cambiar desde y al teclado más reciente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps lock ‑näppäimellä voit vaihtaa viimeksi käytettyyn näppäimistöön tai poistua siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la touche Verrouillage des majuscules pour activer ou désactiver le dernier clavier utilisé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la touche Verr. maj. pour basculer vers le dernier clavier utilisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להשתמש במקש Caps Lock כדי לעבור אל המקלדת הקודמת או ממנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम बार उपयोग किए गए कीबोर्ड से और उस पर स्विच करने के लिए कैप्स लॉक-की का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite tipku Caps Lock za prebacivanje s i na posljednje korištenu tipkovnicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Caps Lock billentyűvel válthat az utoljára használt billentyűzetre és billentyűzetről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol Caps Lock untuk beralih ke dan dari papan ketik yang terakhir digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il tasto “Blocco maiuscole” per passare all’ultima tastiera utilizzata e viceversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockで最後に使用したキーボードに切り替える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock 키를 사용하여 현재 키보드와 마지막으로 사용한 키보드 간에 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kekunci Caps Lock untuk bertukar kepada dan daripada papan kekunci yang terakhir digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk låsetasten til å veksle mellom nylig brukte tastaturer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Caps Lock om van en naar het laatst gebruikte toetsenbord te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączaj i wyłączaj ostatnio używaną klawiaturę, używając klawisza Caps Lock."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tecla Caps Lock para alternar de e para o último teclado usado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tecla Caps Lock para mudar de/para o último teclado usado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizați tasta Blocare majuscule pentru a comuta la și de la ultima tastatură folosită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте клавишу Caps Lock для переключения на клавиатуру, использованную ранее, и обратно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používať Caps Lock na prepínanie naposledy používanej klávesnice."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za preklapljanje na nazadnje uporabljeno tipkovnico in z nje uporabite tipko Caps Lock."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd skiftlåset när du vill växla till och från senast använda tangentbord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่ม Caps Lock เพื่อสลับเปลี่ยนระหว่างแป้นพิมพ์ที่ใช้ล่าสุดกับภาษาอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son kullanılan klavyeye/klavyeden geçiş için Büyük Harf Kilidi düğmesi kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте клавішу Caps Lock, щоб перемикати на останню застосовану клавіатуру та з неї."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng phím Caps Lock để chuyển đổi với bàn phím được sử dụng gần nhất."
          }
        },
        "zh_CN": {
          "stringUnit": {
