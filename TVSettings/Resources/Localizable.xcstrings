    "HomeKitActivityNotificationsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقي الإشعارات عندما تكتشف هذه الكاميرا نشاطًا مثل الحركة والأشخاص والحيوانات والمركبات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rep notificacions cada vegada que la càmera detecti activitat de moviment, persones, animals, vehicles, etc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tato kamera detekuje aktivitu, například pohyb, osoby, zvířata a vozidla, dostanete oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modtag notifikationer, når kameraet registrerer aktiviteter som bevægelse, personer, dyr og transportmidler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Mitteilungen, wenn diese Kamera Aktivitäten wie Bewegung, Personen, Tiere und Fahrzeuge erkennt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη γνωστοποιήσεων όταν αυτή η κάμερα ανιχνεύει δραστηριότητα, π.χ. κίνηση, άτομα, ζώα και οχήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive notifications when this camera detects activity like motion, people, animals, and vehicles."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive notifications when this camera detects activity like motion, people, animals and vehicles."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive notifications when this camera detects activity like motion, people, animals and vehicles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones cuando esta cámara detecte actividad como movimiento, personas, animales o vehículos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones cuando esta cámara detecte actividad como personas, movimiento, animales y vehículos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones cuando esta cámara detecte actividad como personas, movimiento, animales y vehículos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaanota ilmoituksia, kun tämä kamera havaitsee toimintaa, kuten liikettä, ihmisiä, eläimiä ja ajoneuvoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des notifications lorsque cette caméra détecte des activités comme des mouvements, des personnes, des animaux et des véhicules."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des notifications lorsque cette caméra détecte une activité, comme des mouvements, des personnes, des animaux et des véhicules."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לקבל עדכונים בכל פעם שהמצלמה מזהה פעילות כמו תנועה, אנשים, בעלי חיים וכלי רכב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोशन, लोग, जानवर और वाहन जैसी किसी गतिविधि का इस कैमरे के द्वारा पता लगने पर सूचनाएँ प्राप्त करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primajte obavijesti kad ova kamera detektira aktivnost poput kretanja, osoba, životinja i vozila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítéseket kaphat, amikor ez a kamera olyan tevékenységeket észlel, mint a mozgás, emberek, állatok és járművek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima pemberitahuan saat kamera ini mendeteksi aktivitas seperti gerakan, orang, hewan, dan kendaraan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi notifiche quando la videocamera rileva attività come movimento, persone, animali o veicoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラが動き、人、動物、車両などの活動を検知したら、通知を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카메라가 동작, 사람, 동물 및 차량 등과 같은 움직임을 감지하면 알림을 받습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima pemberitahuan apabila kamera ini mengesan aktiviti seperti pergerakan, orang, haiwan dan kenderaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli varslet når kameraet registrerer aktivitet som bevegelse, personer, dyr eller kjøretøyer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang meldingen wanneer deze camera activiteit detecteert, zoals beweging, personen, dieren en voertuigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia, gdy kamera wykryje aktywność, np. ruch, osoby, zwierzęta czy pojazdy."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba notificações quando esta câmera detectar atividades como movimento, pessoas, animais e veículos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber notificações quando esta câmara detetar atividade como movimento, pessoas, animais e veículos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primiți notificări atunci când această cameră detectează activități precum cele care implică mișcare, persoane, animale și vehicule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомления, когда эта камера фиксирует изменения, такие как движение или появление людей, животных или транспортных средств."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď táto kamera deteguje aktivitu, napríklad pohyb, osoby, zvieratá a vozidlá, dostanete hlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejmite obvestila, ko ta kamera zazna aktivnost, na primer gibanje, osebe, živali in vozila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få meddelanden när den här kameran upptäcker aktivitet som rörelse, personer, djur och fordon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนเมื่อกล้องนี้ตรวจพบกิจกรรม เช่น การเคลื่อนไหว ผู้คน สัตว์ และยานพาหนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kamera hareket, insan, hayvan ve taşıt gibi aktiviteler saptadığında bildirimler alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримувати сповіщення, коли ця камера виявляє активність, як‑от рух, людей, тварин і транспортні засоби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi camera này phát hiện hoạt động như chuyển động, người, động vật và xe cộ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当此摄像头检测到动作、人、动物和车辆活动时接收通知。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在此攝影機偵測到動作、人、動物或車輛活動時收到通知。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在此攝影機偵測到動作、人、動物和車輛時接收通知。"
          }
        }
      }
    },
