    "SettingsVPNNotLoadedText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التحقق من تكوين VPN بصورة صحيحة. يلزم توفر بيانات اعتماد AppleConnect صالحة، وأن يتم تحميل ملف التعريف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN estigui configurada correctament. Calen credencials de l’AppleConnect que siguin vàlides i que s’hagi carregat el perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte, zda je VPN síť nastavená správně. Vyžaduje platné přihlašovací údaje pro AppleConnect a načtený profil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft, at VPN er konfigureret korrekt. Kræver gyldige AppleConnect-godkendelsesoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe, ob VPN korrekt konfiguriert ist. Hierfür sind gültige AppleConnect-Zugangsdaten sowie ein bereits geladenes Profil erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθεύστε ότι το VPN διαμορφώθηκε σωστά. Απαιτούνται έγκυρα διαπιστευτήρια AppleConnect και πρέπει να έχει φορτωθεί το προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials and the profile loaded."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials and the profile loaded."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials and the profile loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la conexión VPN está configurada correctamente. Requiere credenciales de AppleConnect válidas y haber cargado el perfil."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN esté configurada de manera correcta. Esto requiere de credenciales válidas de AppleConnect y que se haya cargado el perfil."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN esté configurada de manera correcta. Esto requiere de credenciales válidas de AppleConnect y que se haya cargado el perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials and the profile loaded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le VPN est correctement configuré. Nécessite des identifiants AppleConnect valides ; le profil doit également être chargé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le VPN est configuré correctement. Des informations d’identification AppleConnect valides sont requises."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שתצורת ה-VPN הוגדרה כשורה. יש צורך בפרטי זיהוי תקינים של AppleConnect ובטעינת הפרופיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित करें कि VPN ठीक से कॉन्फ़िगर किया गया है। इसके लिए मान्य AppleConnect क्रेडेंशियल और लोड की हुई प्रोफ़ाइल चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite je li VPN ispravno podešen. Zahtijeva važeće AppleConnect vjerodajnice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze, hogy a VPN helyesen van-e konfigurálva. Érvényes AppleConnect bejelentkezési adatok szükségesek, és a profilt be kell tölteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi bahwa VPN dikonfigurasi dengan benar. Memerlukan kredensial AppleConnect yang sah dan profil yang dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il profilo VPN sia configurato correttamente. Devi caricare il profilo ed è necessario che le credenziali AppleConnect siano valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNプロファイルが正しく構成されているか検証してください。有効なAppleConnectの資格情報およびプロファイルの読み込みが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN이 올바르게 구성되어 있는지 확인하십시오. 유효한 AppleConnect 자격 증명이 필요하며 프로필을 로드해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan bahawa VPN dikonfigurasikan dengan betul. Memerlukan kelayakan AppleConnect yang sah dan profil dimuatkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiser at VPN er konfigurert riktig. Krever gyldige AppleConnect-akkreditiver og en innlastet profil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer dat VPN goed is geconfigureerd. Hiervoor zijn geldige toegangsgegevens voor AppleConnect en een geladen profiel vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że sieć VPN jest skonfigurowana prawidłowo. Wymaga poprawnych danych uwierzytelniania AppleConnect oraz wczytanego profilu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se a VPN está configurada corretamente. Requer credenciais válidas do AppleConnect e o perfil carregado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que a VPN está corretamente configurada. São necessárias credenciais AppleConnect válidas e o perfil tem de estar carregado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați dacă VPN‑ul este corect configurat. Necesită acreditări AppleConnect valide și profilul încărcat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте правильность конфигурации профиля VPN. Требуются действительные параметры входа AppleConnect и загруженный профиль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte správnosť nastavení VPN. Potrebujete platné prihlasovacie údaje do služby AppleConnect a načítaný profil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite, ali je VPN pravilno konfiguriran. Potrebne so veljavne poverilnice AppleConnect in naložen profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att VPN har konfigurerats korrekt. Du måste ha giltiga AppleConnect-handlingar och profilen måste vara inläst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบยืนยันว่า VPN ถูกกำหนดค่าอย่างถูกต้อง ต้องใช้ข้อมูลประจำตัว AppleConnect ที่ถูกต้องและโหลดโปรไฟล์แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN’in doğru şekilde konfigüre edildiğinden emin olun. Geçerli bir AppleConnect kimlik bilgisi ve yüklenmiş profil gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте, чи правильно сконфігуровано профіль VPN. Потрібні дійсні облікові дані AppleConnect і завантажений профіль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh rằng VPN được định cấu hình đúng cách. Yêu cầu thông tin đăng nhập AppleConnect hợp lệ và hồ sơ đã tải."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "验证VPN已正确配置。需要有效的AppleConnect凭证和载入的描述文件。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證VPN已正確設定。需要有效的AppleConnect憑証並已載入描述檔。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證該VPN已正確設定。需要有效的AppleConnect憑證並載入描述檔。"
          }
        }
      }
    },
