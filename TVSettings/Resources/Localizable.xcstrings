          "stringUnit": {
            "state": "translated",
            "value": "רק מי ששותף בבית זה יכול לראות ולהשתמש ב-AirPlay בטלוויזיה וברמקולים בבית זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस घर को शेयर करने वाले लोग ही इस घर के टीवी और स्पीकर को देख सकते हैं और उन पर AirPlay कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo osobe koje dijele ovaj dom mogu vidjeti i pokrenuti AirPlay na TV-u i zvučnicima u domu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az otthont megosztó személyek láthatják a TV-t és a hangszórókat, és játszhatnak le rajtuk AirPlay használatával tartalmat ebben az otthonban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang yang berbagi rumah ini yang dapat melihat dan menggunakan AirPlay ke TV dan speaker di rumah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo chi fa parte di questa abitazione può visualizzare e utilizzare AirPlay con il televisore e gli altoparlanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホームを共有している人だけがこのホームのテレビとスピーカーの表示およびAirPlayできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 홈을 공유하는 사람만 이 홈에 있는 TV 및 스피커를 볼 수 있고 해당 기기로 AirPlay할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang yang berkongsi rumah ini boleh melihat dan AirPlay ke TV dan speaker dalam rumah ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun medlemmer i hjemmet kan se og bruke AirPlay med TV-en og høyttalerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen personen die deze woning delen, kunnen AirPlay zien en gebruiken op de tv en luidsprekers in deze woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko osoby, którym udostępniany jest dom, mogą widzieć telewizor i głośniki w tym domu i strumieniować na nie przez AirPlay."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as pessoas que compartilham esta casa podem ver e usar o AirPlay na TV e nos alto-falantes desta casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as pessoas que partilham esta casa podem ver e usar AirPlay com a TV e colunas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar persoanele care partajează această locuință pot vedea și utiliza AirPlay pe televizorul și difuzoarele din această casă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только совместно использующие этот дом могут видеть и транслировать через AirPlay на этот телевизор и аудиосистему в этом доме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len užívatelia, ktorí zdieľajú domácnosť, uvidia TV a reproduktory v domácnosti a budú na nich môcť prehrávať obsah cez AirPlay."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo osebe, ki si delijo ta dom, lahko vidijo televizor in zvočnike v tem domu ter na njih predvajajo vsebine prek funkcije AirPlay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara personer som delar det här hemmet kan se och använda AirPlay med TV-apparater och högtalare i det här hemmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้คนที่แชร์บ้านนี้สามารถเห็นและเชื่อมต่อผ่าน AirPlay ไปที่ทีวีและลำโพงในบ้านนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu evi paylaşan kişiler bu evdeki TV’yi ve hoparlörleri görebilir ve onlara AirPlay ile bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ті, хто спільно користується цим домом, можуть бачити в ньому цей ТВ і динаміки й транслювати на них через AirPlay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người đang chia sẻ nhà này mới có thể xem và phát AirPlay đến TV và loa trong nhà này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅共享此家庭的用户可查看并通过电视和扬声器隔空播放。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有共享此家居的人，才可以檢視及AirPlay至此家居的電視和喇叭。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅共享此家庭的人才能看到並AirPlay到此家庭中的Apple TV和揚聲器。"
          }
        }
      }
    },
