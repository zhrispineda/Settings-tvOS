    "TVPSharedLibrary_tvOS_CloudWelcomeDescriptionBoth": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عرض جميع صور ومكتبات iCloud الحديثة، أو الألبومات التي تشاركها فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots veure totes les fototeques i fotos a l’iCloud recents, o només els àlbums que comparteixis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte zobrazení všech fotek a knihoven na iCloudu z poslední doby nebo jen alb, která sdílíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, om du vil se dine seneste iCloud-fotos og -biblioteker eller kun de album, du deler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, ob du alle neuesten iCloud-Fotos und -Mediatheken anzeigen lassen möchtest oder nur die von dir geteilten Alben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την προβολή όλων των πρόσφατων φωτογραφιών και βιβλιοθηκών iCloud ή μόνο των κοινόχρηστων άλμπουμ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to view all your recent iCloud photos and libraries, or just albums you share."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to view all your recent iCloud photos and libraries, or just albums you share."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to view all your recent iCloud photos and libraries, or just albums you share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres ver todas las fotos recientes en iCloud y las fototecas, o bien solo los álbumes que compartes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre ver todas tus fototecas y fotos recientes en iCloud, o solamente los álbumes que compartes."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre ver todas tus fototecas y fotos recientes en iCloud, o solamente los álbumes que compartes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, näytetäänkö kaikki äskeiset iCloud-kuvasi ja kirjastosi vai vain jakamasi albumit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez afficher toutes vos photos et photothèques iCloud récentes, ou uniquement les albums que vous partagez."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’afficher toutes vos photos et photothèques iCloud récentes ou uniquement les albums que vous partagez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך להציג את כל התמונות והספריות האחרונות שלך שב-iCloud, או רק את האלבומים ששיתפת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सभी हालिया iCloud तस्वीरें और लाइब्रेरी देखने का या केवल आपने जो ऐल्बम शेयर किए हैं उन्हें देखने का विकल्प चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite za prikazivanje svih svojih nedavnih iCloud fotografija i medijateka ili samo albuma koje dijelite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja, hogy az összes legutóbbi iCloud-fotóját és könyvtárait szeretné megtekinteni, vagy csak a megosztott albumait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih untuk melihat semua foto dan perpustakaan iCloud terbaru Anda atau hanya album yang Anda bagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli di visualizzare tutte le foto di iCloud e le librerie recenti o solo gli album che condividi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のiCloud写真とライブラリすべてか、または共有しているアルバムだけを表示するのかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 iCloud 사진 및 보관함을 모두 보거나 사용자가 공유한 앨범만 보도록 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih untuk melihat semua foto dan pustaka iCloud terbaharu anda atau hanya album yang anda kongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg å vise alle nylige iCloud-bilder og biblioteker eller kun albumene du deler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ervoor om al je recente foto's en bibliotheken in iCloud te bekijken of alleen albums die je deelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj wszystkie swoje najnowsze zdjęcia i biblioteki w iCloud lub tylko albumy udostępniane innym."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se você deseja ver todas as fotos recentes do iCloud e das fototecas ou apenas os álbuns que você compartilhar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opte entre ver todas as bibliotecas e fotografias em iCloud recentes ou apenas os álbuns partilhados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți să vedeți toate pozele și bibliotecile dvs. iCloud recente sau doar albumele pe care le partajați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно просматривать сразу все свои недавние фото и медиатеки iCloud или выбрать только альбомы с общим доступом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete si prezerať všetky svoje najnovšie fotky a knižnice na iCloude alebo len albumy, ktoré zdieľate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberete lahko prikaz vseh nedavnih fotografij in knjižnic iz storitve iCloud ali samo deljenih albumov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om du vill visa alla dina senaste iCloud-bilder och bibliotek eller endast de album du delar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเพื่อดูรูปภาพและคลังบน iCloud ล่าสุดทั้งหมดของคุณหรือเฉพาะอัลบั้มที่คุณแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son iCloud fotoğraflarınızın ve arşivlerinizin tümünü ya da yalnızca paylaştığınız albümleri görüntülemeyi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте всі свої недавні фотографії та фототеки з iCloud або тільки спільні альбоми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn xem tất cả các thư viện và ảnh iCloud gần đây của bạn hay chỉ các album mà bạn chia sẻ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择查看所有最近的iCloud照片和图库，还是仅查看你共享的相簿。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇來檢視你最近的所有iCloud相片和圖庫，或只檢視你共享的相簿。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇檢視所有最近的iCloud照片和圖庫，或只檢視你共享的相簿。"
          }
        }
      }
    },
    "TVPSharedLibrary_tvOS_CloudWelcomeDescriptioniCloud": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تسجيل الدخول للسماح بالوصول إلى صور iCloud على هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sessió per permetre l’accés a les fotos a l’iCloud des de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li na této Apple TV povolit přístup k vašim fotkám na iCloudu, přihlaste se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at tillade adgang til dine iCloud-fotos på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um den Zugriff auf deine iCloud-Fotos auf diesem Apple TV zu erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε για να επιτραπεί η πρόσβαση στις Φωτογραφίες iCloud σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to allow access to your iCloud Photos on this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to allow access to your iCloud Photos on this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to allow access to your iCloud Photos on this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para permitir el acceso a tus fotos en iCloud en este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para permitir el acceso a tus fotos en iCloud en este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para permitir el acceso a tus fotos en iCloud en este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu sisään ja salli iCloud-kuvien käyttö tässä Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour autoriser l’accès à Photos iCloud sur cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour autoriser l’accès à vos photos iCloud sur cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחבר כדי לאפשר גישה ל״תמונות iCloud״ ב‑Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV पर अपने iCloud तस्वीर में ऐक्सेस की अनुमति देने के लिए साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se kako biste dozvolili pristup svojim iCloud fotografijama na ovom Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be, ha engedélyezni szeretné az iCloud-fotókhoz való hozzáférést ezen az Apple TV‑n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk mengizinkan akses ke Foto iCloud Anda di Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il login per consentire l’accesso alle foto di iCloud su questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVでiCloud写真へのアクセスを許可するには、サインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV에서 iCloud 사진에 접근하는 것을 허용하려면 로그인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk untuk membenarkan akses kepada Foto iCloud anda pada Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på for tilgang til iCloud Bilder på denne Apple TV-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in voor toegang tot je iCloud-foto's op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się, aby pozwolić na dostęp do zdjęć w iCloud na tym Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie a sessão para permitir o acesso às Fotos do iCloud nesta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para permitir o acesso às suas fotografias em iCloud nesta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificați‑vă pentru a permite accesul la Poze iCloud pe acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просмотра Фото iCloud на этом Apple TV войдите в свою учетную запись."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete na tomto Apple TV povoliť prístup k iCloud Fotkám, prihláste sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpišite se, da omogočite dostop do funkcije Fotografije iCloud prek tega Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in för att ge tillgång till dina iCloud‑bilder på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าเพื่ออนุญาตให้เข้าถึงรูปภาพบน iCloud ของคุณบน Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’de iCloud Fotoğrafları’nıza erişime izin vermek için giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб дозволити доступ до ваших Фото iCloud на цьому Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để cho phép truy cập vào Ảnh iCloud của bạn trên Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "登录以允许在此Apple TV上访问你的iCloud照片。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "登入以允許在此Apple TV上取用你的iCloud相片。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "登入來允許取用你在此Apple TV上的iCloud照片。"
          }
        }
      }
