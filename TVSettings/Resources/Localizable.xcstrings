    "ProfileResultedInNoDataError": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف التعريف غير موجود أو لا يحتوي على أي بيانات. يرجى التأكد من أنك مخول لاستخدام VPN على Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat el perfil o no contenia dades. Comprova que tinguis autorització per utilitzar la VPN a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil se nepodařilo nalézt nebo je prázdný. Zkontrolujte, zda máte na Apple TV oprávnění používat VPN."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen blev ikke fundet eller indeholder ingen data. Kontroller, at du er godkendt til at bruge VPN på Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil wurde nicht gefunden oder enthält keine Daten. Überprüfe, dass du autorisiert bist, VPN auf Apple TV zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προφίλ δεν βρέθηκε ή δεν περιείχε δεδομένα. Ελέγξτε και βεβαιωθείτε ότι έχετε δικαίωμα χρήσης VPN σε Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile was not found or contained no data. Check that you are authorized to use VPN on Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile was not found or contained no data. Check that you are authorised to use VPN on Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile was not found or contained no data. Check that you are authorised to use VPN on Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado el perfil o no contenía datos. Comprueba que tienes autorización para usar la VPN en el Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el perfil o no contiene datos. Verifica que tienes autorización para usar VPN con el Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el perfil o no contiene datos. Verifica que tienes autorización para usar VPN con el Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilia ei löytynyt tai se ei sisältänyt dataa. Tarkista, että sinulla on lupa käyttää VPN:ää Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil est introuvable ou ne contient aucune donnée. Assurez-vous que vous êtes autorisé à utiliser le VPN sur l’Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil est introuvable ou vide. Vérifiez que vous avez l’autorisation d’utiliser le VPN sur l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופיל לא נמצא או לא הכיל נתונים. יש לבדוק שקיבלת אישור להשתמש ב-VPN ב-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल नहीं मिली या उसमें कोई डेटा नहीं था। जाँच लें कि आप Apple TV पर VPN का उपयोग करने के लिए अधिकृत हैं या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil nije pronađen ili ne sadrži podatke. Provjerite imate li autorizaciju za uporabu VPN-a na Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profil nem található, vagy nem tartalmazott adatot. Ellenőrizze, hogy fel van-e jogosítva a VPN használatára az Apple TV-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tidak ditemukan atau tidak berisi data. Periksa bahwa Anda disahkan untuk menggunakan VPN di Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo non è stato trovato o non contiene dati. Verifica di avere l’autorizzazione per utilizzare la VPN su Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルが見つからないか、データが含まれていません。Apple TVでVPNを使用する権限があるかどうか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 찾을 수 없거나 프로필에 데이터가 없습니다. Apple TV에서 VPN을 사용할 수 있는 권한이 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tidak ditemui atau tidak mengandungi data. Semak sama ada anda dibenarkan untuk menggunakan VPN pada Apple TV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen ble ikke funnet, eller den inneholder ingen data. Sjekk at du er autorisert til å bruke VPN på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel is niet gevonden of bevat geen gegevens. Controleer of je geautoriseerd bent om VPN op de Apple TV te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono profilu lub profil nie zawiera danych. Sprawdź, czy masz autoryzację do używania sieci VPN na Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil não foi encontrado ou não continha dados. Confira se você tem autorização para usar a VPN na Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil não foi encontrado ou não continha dados. Verifique se tem autorização para usar VPN na Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilul nu a fost găsit sau nu conține date. Verificați dacă vă este permis să utilizați VPN pe Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль не найден, или в нем нет данных. Убедитесь, что Вам разрешено использовать VPN на Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil sa nenašiel alebo neobsahuje žiadne dáta. Skontrolujte, či máte autorizáciu na používanie VPN na Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ni bil najden ali pa ni vseboval nobenih podatkov. Preverite, ali lahko uporabljate VPN v Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen hittades inte eller så innehöll den inga data. Kontrollera att du har behörighet att använda VPN på Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบโปรไฟล์หรือโปรไฟล์ไม่มีข้อมูล ตรวจสอบว่าคุณได้รับอนุญาตให้ใช้ VPN บน Apple TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil bulunamadı veya veri içermiyordu. Apple TV’de VPN kullanma yetkiniz olup olmadığını denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Такий профіль не знайдено або він не містив жодних даних. Упевніться, що вас авторизовано для використання VPN на Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy hồ sơ hoặc hồ sơ không có dữ liệu. Hãy kiểm tra để chắc chắn rằng bạn được phép sử dụng VPN trên Apple TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "描述文件找不到或没有包含任何数据。请检查你已获授权在Apple TV上使用VPN。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到該描述檔，或描述檔內沒有資料。請確定你已獲授權在Apple TV上使用VPN。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到描述檔或其中未包含資料。請檢查你是否已被授權在Apple TV上使用VPN。"
          }
        }
      }
    },
