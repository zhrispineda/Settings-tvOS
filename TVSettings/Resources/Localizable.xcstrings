            "value": "क्या आप इस Apple TV की अंक पद्धति को बदलना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite li promijeniti brojevni sustav ovog Apple TV-a?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítja ennek az Apple TV-nek a számozási rendszerét?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda ingin mengubah sistem penomoran Apple TV ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi modificare il sistema di numerazione di Apple TV?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVの番号システムを変更しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV의 번호 시스템을 변경하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda mahu menukar sistem penomboran Apple TV ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du endre tallsystemet på Apple TV?"
          }
        },
