    "AccountsUserSignOutAppleAccountDisabledGuestDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم هذا الحساب لحفظ بيانات التطبيقات في iCloud. لاستخدام حساب مختلف، يجب إزالة ملف التعريف هذا من Apple TV ثم إضافة ملف تعريف جديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte s’utilitza per desar les dades de les apps a l’iCloud. Per utilitzar un altre compte, elimina el perfil de l’Apple TV i, després, afegeix un perfil nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet se používá pro ukládání dat aplikací na iCloud. Chcete‑li použít jiný účet, odeberte tento profil z Apple TV a pak přidejte nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto bruges til at gemme appdata til iCloud. Hvis du vil bruge en anden konto, skal du først fjerne denne profil fra Apple TV og derefter tilføje en ny profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
