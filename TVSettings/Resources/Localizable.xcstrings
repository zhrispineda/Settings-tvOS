    "SiriLanguageChangeMessageFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستخدم Siri لغة مختلفة عن Apple TV والإملاء.\nهل ترغب أيضًا في تغيير لغة Apple TV والإملاء إلى %@؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri utilitzarà un idioma diferent del de l’Apple TV i del dictat.\nVols utilitzar també l’Apple TV i el dictat en %@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bude používat jiný jazyk než Apple TV a diktování.\nChcete Apple TV a diktování také nastavit na jazyk %@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vil bruge et andet sprog end Apple TV-enheden og Diktering.\nVil du også ændre sproget for Apple TV-enheden og Diktering til %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri verwendet eine andere Sprache als Apple TV und die Diktierfunktion.\nSoll die Sprache dort auch auf %@ geändert werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Siri θα χρησιμοποιεί διαφορετική γλώσσα από το Apple TV και την Υπαγόρευση.\nΘέλετε επίσης να αλλάξετε τη γλώσσα για το Apple TV και την Υπαγόρευση σε %@;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri will use a different language than Apple TV and Dictation.\nDo you also want to change the language for Apple TV and Dictation to %@?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri will use a different language to Apple TV and Dictation.\nDo you also want to change the language for Apple TV and Dictation to %@?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri will use a different language to Apple TV and Dictation.\nDo you also want to change the language for Apple TV and Dictation to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri usará un idioma diferente al del Apple TV y Dictado.\n¿Quieres cambiar también el idioma del Apple TV y Dictado a %@?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri usará un idioma distinto al de Apple TV y Dictado.\n¿Quieres también cambiar el idioma del Apple TV y Dictado a %@?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri usará un idioma distinto al de Apple TV y Dictado.\n¿Quieres también cambiar el idioma del Apple TV y Dictado a %@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri käyttää eri kieltä kuin Apple TV ja sanelu.\nVaihdetaanko myös Apple TV:n ja sanelun kieleksi %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri utilisera une langue différente de l’Apple TV et de Dictée.\nVoulez-vous également changer en %@ la langue de l’Apple TV et de Dictée ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri utilisera une langue différente de celle de l’Apple TV et de Dictée.\nSouhaitez-vous également utiliser l’Apple TV et Dictée en %@?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השפה שתשמש את Siri תהיה שונה מהשפה של ה-Apple TV ושל ״הכתבה״.\nהאם ברצונך לשנות גם את השפה של ה-Apple TV ושל ״הכתבה״ ל%@?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri द्वारा Apple TV और डिक्टेशन की भाषा से अलग भाषा का इस्तेमाल किया जाएगा।\nक्या आप Apple TV और डिक्टेशन की भाषा को भी %@ में बदलना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri će koristiti drugačiji jezik od Apple TV‑a i Diktata.\nŽelite li također promijeniti jezik Apple TV‑a i Diktata u %@?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri más nyelvet fog használni, mint az Apple TV és a Diktálás.\nSzeretné úgy módosítani, hogy az Apple TV és a Diktálás is %@ nyelvet használjon?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri akan menggunakan bahasa yang berbeda dari yang digunakan di Apple TV dan Dikte.\nApakah Anda juga ingin mengganti bahasa untuk Apple TV dan Dikte menjadi %@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri utilizzerà una lingua diversa da quella di Apple TV e Dettatura.\nVuoi cambiare anche la lingua di Apple TV e Dettatura in %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SiriはApple TVと音声入力と異なる言語を使用します。\nApple TVと音声入力の言語も%@に変更しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri가 Apple TV 및 받아쓰기와 다른 언어를 사용하게 됩니다.\nApple TV 및 받아쓰기의 언어를 %@로 변경하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri akan menggunakan bahasa berbeza daripada Apple TV dan Perencanaan.\nAdakah anda turut mahu menukar bahasa untuk Apple TV dan Perencanaan kepada %@?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vil bruke et annet språk enn Apple TV og diktering.\nVil du også endre språket for Apple TV og diktering til %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor Siri wordt een andere taal gebruikt dan voor de Apple TV en de dicteerfunctie.\nWil je de taal voor de Apple TV en de dicteerfunctie ook wijzigen in %@?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri będzie używać innego języka niż Apple TV i funkcja dyktowania.\nCzy chcesz także zmienić język Apple TV i funkcji dyktowania na %@?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri não usará o mesmo idioma que a Apple TV e o Ditado.\nVocê também deseja alterar o idioma da Apple TV e do Ditato para %@?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri usará um idioma diferente do da Apple TV e do Ditado.\nGostaria de alterar também o idioma da Apple TV e do Ditado para %@?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri va utiliza o altă limbă decât Apple TV‑ul și dictarea.\nDoriți să schimbați și limba pentru Apple TV și dictare în %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri будет использовать язык, отличающийся от языка Apple TV и Диктовки.\nХотите сменить язык Apple TV и Диктовки на %@?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bude používať iný jazyk ako Apple TV a Diktovanie.\nChcete zmeniť aj jazyk pre Apple TV a Diktovanie na %@?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bo uporabljala drug jezik kot Apple TV in funkcija Narekovanje.\nŽelite spremeniti tudi jezik za Apple TV in funkcijo Narekovanje v jezik: %@?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri använder ett annat språk än Apple TV och diktering.\nVill du även ändra språket för Apple TV och diktering till %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri จะใช้ภาษาที่แตกต่างจากภาษาของ Apple TV และการป้อนตามคำบอก\nคุณต้องการเปลี่ยนภาษาของ Apple TV และการป้อนตามคำบอกเป็น%[tt]@ด้วยหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri, Apple TV’den ve Dikte’den farklı bir dil kullanacaktır.\nApple TV’nin ve Dikte’nin dilini de %@ olarak değiştirmek istiyor musunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri використовуватиме мову, відмінну від мови Apple TV та Диктування.\nХочете, щоб мовою Apple TV та Диктування стала %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sẽ sử dụng một ngôn ngữ khác với Apple TV và Đọc chính tả.\nBạn có muốn đồng thời thay đổi ngôn ngữ cho Apple TV và Đọc chính tả thành %@ không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri将使用与Apple TV及“听写”不同的语言。\n你要将Apple TV和“听写”的语言也更改为%@吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會使用與Apple TV及「聽寫」不同的語言。\n你也要將Apple TV及聽寫的語言更改為%@嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會使用與Apple TV和「聽寫」不同的語言。\n你要將Apple TV和聽寫的語言改成%@嗎？"
          }
        }
      }
    },
