    "AirPlayPeerToPeerDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف اللاسلكية نظير إلى نظير يمكن أن يحفظ الطاقة. لاستخدام البث السريع، تأكد من أن أجهزتك على نفس شبكة Wi-Fi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si desactives la connexió d’igual a igual, es consumirà menys bateria. Per fer servir l’AirPlay, comprova que els dispositius estiguin connectats a la mateixa xarxa Wi‑Fi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutím přímého bezdrátového propojení můžete ušetřit energii. Chcete‑li používat AirPlay, připojte všechna zúčastněná zařízení k téže Wi‑Fi síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan spare på strømmen ved at slå Enhed til enhed (trådløs) fra. Hvis du vil bruge AirPlay, skal du sørge for, at dine enheder er på det samme Wi-Fi-netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Deaktivieren der kabellosen Peer-to-Peer-Verbindung kann Energie sparen. Um AirPlay zu verwenden, stelle sicher, dass sich deine Geräte im selben WLAN befinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να εξοικονομήσετε ενέργεια αν απενεργοποιήσετε την ασύρματη ομότιμη σύνδεση. Για χρήση του AirPlay, βεβαιωθείτε ότι οι συσκευές σας είναι συνδεδεμένες στο ίδιο δίκτυο Wi-Fi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off peer-to-peer wireless can save energy. To use AirPlay, make sure your devices are on the same Wi-Fi network."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off peer-to-peer wireless can save energy. To use AirPlay, make sure your devices are on the same Wi-Fi network."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off peer-to-peer wireless can save energy. To use AirPlay, make sure your devices are on the same Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la conexión inalámbrica P2P permite ahorrar energía. Para usar AirPlay, asegúrate de que tus dispositivos estén en la misma red Wi‑Fi."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede ahorrar energía al desactivar conexiones inalámbricas peer-to-peer. Para usar AirPlay, asegúrate de que tus dispositivos estén en la misma red Wi-Fi."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede ahorrar energía al desactivar conexiones inalámbricas peer-to-peer. Para usar AirPlay, asegúrate de que tus dispositivos estén en la misma red Wi-Fi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Langattoman vertaisverkon laittaminen pois päältä voi säästää energiaa. Varmista AirPlayn käyttöä varten, että laitteet ovat samassa Wi‑Fi-verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le sans fil pair-à-pair peut permettre d’économiser de l’énergie. Pour utiliser AirPlay, assurez-vous que vos appareils sont connectés au même réseau Wi-Fi."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver la connexion sans fil pair-à-pair permet d’économiser de l’énergie. Pour utiliser AirPlay, assurez-vous que vos appareils sont connectés au même réseau Wi‑Fi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי רשת עמית-לעמית אלחוטית יכול לחסוך אנרגיה. כדי להשתמש ב-AirPlay, יש לוודא שהמכשירים שלך מחוברים לאותה רשת אלחוטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीयर-टू-पीयर वायरलेस को बंद करने से ऊर्जा की बचत हो सकती है। AirPlay का इस्तेमाल करने के लिए सुनिश्चित करें कि आपके डिवाइस समान वाई-फ़ाई नेटवर्क पर हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključenje bežičnog peer-to-peera može uštedjeti energiju. Za uporabu AirPlaya vaši uređaji trebaju biti na istoj Wi-Fi mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vezeték nélküli közvetlen kapcsolat kikapcsolásával energiát takaríthat meg. Az AirPlay használatához győződjön meg arról, hogy az eszközei ugyanahhoz a Wi‑Fi‑hálózathoz csatlakoznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan nirkabel peer to peer dapat menghemat energi. Untuk menggunakan AirPlay, pastikan perangkat Anda terhubung ke jaringan Wi-Fi yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivare il wireless Peer‑to‑Peer può aiutare a risparmiare energia. Per utilizzare AirPlay, assicurati che i tuoi dispositivi si trovino sulla stessa rete Wi‑Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアワイヤレスをオフにすると、電力を節約できます。AirPlayを使用するには、デバイスが同じWi‑Fiネットワークに接続されていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 무선 통신을 끄면 에너지를 절약할 수 있습니다. AirPlay를 사용하려면, 기기가 동일한 Wi-Fi 네트워크에 연결되어 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyahaktifkan wayarles rakan ke rakan boleh menjimatkan tenaga. Untuk menggunakan AirPlay, pastikan peranti anda menggunakan rangkaian Wi‑Fi yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan spare strøm ved å slå av peer-to-peer-trådløsnettverk. AirPlay krever at enhetene er tilkoblet det samme Wi‑Fi-nettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitschakelen van 'Peer-to-peer draadloos' kan energie besparen. Zorg ervoor dat je apparaten zich op hetzelfde wifinetwerk bevinden om AirPlay te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączenie równorzędnej łączności bezprzewodowej może oszczędzać energię. Aby używać AirPlay, upewnij się, że Twoje urządzenia są w tej samej sieci Wi‑Fi."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao desativar a conexão peer-to-peer sem fio, você pode economizar energia. Para usar o AirPlay, os seus dispositivos devem estar na mesma rede Wi‑Fi."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar a ligação sem fios peer‑to‑peer pode poupar energia. Para usar AirPlay, certifique‑se de que os seus dispositivos estão ligados à mesma rede Wi‑Fi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivarea funcționalității wireless peer‑to‑peer poate economisi energie. Pentru a utiliza AirPlay, asigurați‑vă că dispozitivele dvs. se află în aceeași rețea Wi‑Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить беспроводную P2P‑сеть, можно сократить расход энергии. Для использования AirPlay необходимо, чтобы устройства были подключены к одной и той же сети Wi‑Fi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutím priameho bezdrôtového pripojenia môžete ušetriť energiu. Ak chcete používať AirPlay, vaše ostatné zariadenia musia byť pripojené k rovnakej Wi-Fi sieti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z izklopom brezžičnega omrežja enakovrednih naprav lahko prihranite energijo. Za uporabo funkcije AirPlay morajo biti naprave v istem omrežju Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger av trådlös P2P kan det spara energi. Om du vill använda AirPlay måste enheterna vara anslutna till samma Wi‑Fi-nätverk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดใช้เพียร์ทูเพียร์ไร้สายสามารถช่วยประหยัดพลังงานได้ ในการใช้ AirPlay ตรวจสอบให้แน่ใจว่าอุปกรณ์ของคุณอยู่บนเครือข่าย Wi‑Fi เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşler arası kablosuz iletişimin kapatılması enerji tasarrufu sağlayabilir. AirPlay’i kullanmak için aygıtlarınızın aynı Wi-Fi ağında olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнення бездротового P2P-звʼязку допоможе заощадити енергію. Щоб використовувати AirPlay, упевніться, що ваші пристрої підʼєднані до тієї самої мережі Wi‑Fi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tắt tùy chọn không dây ngang hàng có thể tiết kiệm năng lượng. Để sử dụng AirPlay, hãy đảm bảo rằng các thiết bị của bạn được kết nối vào cùng một mạng Wi-Fi."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭点对点无线可节省能源。若要使用隔空播放，请确保设备接入同一Wi-Fi网络。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉點對點無線網絡可以節省能源。如要使用AirPlay，請確保你的裝置均連接相同的Wi-Fi網絡。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉點對點無線網路可以節省能源。若要使用AirPlay，請確定裝置是連接相同的Wi-Fi網路。"
          }
        }
      }
    },
