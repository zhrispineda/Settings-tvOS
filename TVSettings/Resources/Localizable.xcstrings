    "APAccessTypeAnyDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص رؤية وتشغيل البث السريع على هذا التلفزيون والسماعات في هذا المنزل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom podrà veure el televisor i els altaveus de la casa i transmetre‑hi contingut per l’AirPlay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni uživatelé uvidí televizor a reproduktory v této domácnosti a budou na nich moct používat AirPlay."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan se og streame med AirPlay til tv og højttalere i dette hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder in diesem Zuhause kann das Apple TV und die Lautsprecher sehen und mit AirPlay verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οποιοσδήποτε θα μπορεί να δει την τηλεόραση και τα ηχεία αυτής της οικίας και να χρησιμοποιήσει το AirPlay σε αυτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can see and AirPlay to the TV and speakers in this home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can see and AirPlay to the TV and speakers in this home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can see and AirPlay to the TV and speakers in this home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera podrá ver y usar AirPlay con el televisor y los altavoces de esta casa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede ver y transmitir por AirPlay a la TV\ny a las bocinas de esta casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede ver y transmitir por AirPlay a la TV\ny a los altavoces de esta casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki näkevät tämän kodin TV:n ja kaiuttimet ja voivat käyttää niissä AirPlayta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut détecter le téléviseur et les haut-parleurs de ce domicile et diffuser du contenu sur ceux-ci via AirPlay."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut voir la télévision et les haut-parleurs dans ce domicile, et utiliser AirPlay avec ceux-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול לראות ולהשתמש ב-AirPlay בטלוויזיה וברמקולים בבית זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घर के टीवी और स्पीकर को कोई भी देख सकता है और उन पर AirPlay कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi mogu vidjeti i pokrenuti AirPlay na TV-u i zvučnicima u ovom domu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki láthatja a TV-t és a hangszórókat, és AirPlay használatával tartalmat játszhat le rajtuk ebben az otthonban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun dapat melihat dan menggunakan AirPlay ke TV dan speaker di rumah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti possono visualizzare e utilizzare AirPlay con il televisore e gli altoparlanti di questa abitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員がこのホームのテレビとスピーカーの表示およびAirPlayが可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 이 홈에 있는 TV 및 스피커를 볼 수 있고 해당 기기로 AirPlay할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa sahaja boleh melihat dan AirPlay ke TV dan speaker dalam rumah ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan se og bruke AirPlay med TV-en og høyttalerne i hjemmet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan AirPlay zien en gebruiken op de tv en luidsprekers in deze woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda osoba może widzieć telewizor i głośniki w tym domu i strumieniować na nie przez AirPlay."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos podem ver e usar o AirPlay na TV e nos alto-falantes desta casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos podem ver e usar AirPlay com a TV e colunas nesta casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate vedea și utiliza AirPlay pe televizorul și difuzoarele din această casă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой пользователь может видеть и транслировать через AirPlay на этот телевизор и аудиосистему в этом доме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetci užívatelia uvidia TV a reproduktory v domácnosti a budú na nich môcť prehrávať obsah cez AirPlay."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi lahko vidijo televizor in zvočnike v tem domu ter na njih predvajajo vsebine prek funkcije AirPlay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kan se och använda AirPlay med TV-apparater och högtalare i det här hemmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ได้สามารถเห็นและเชื่อมต่อผ่าน AirPlay ไปที่ทีวีและลำโพงในบ้านนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes bu evdeki TV’yi ve hoparlörleri görebilir ve onlara AirPlay ile bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі можуть бачити ТВ і динаміки в цьому домі й транслювати на них через AirPlay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai cũng có thể xem và phát AirPlay đến TV và loa trong nhà này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "家中的任何人均可查看并通过电视和扬声器隔空播放。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以檢視及AirPlay至此家居的電視和喇叭。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能看到並AirPlay到此家庭中的Apple TV和揚聲器。"
          }
        }
      }
    },
