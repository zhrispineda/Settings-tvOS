    "MusicUseListeningHistoryOFF": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموسيقى التي تُشغّل على هذا الجهاز لن تظهر ضمن المشغلة حديثًا ولا منوعات Replay، ولن تؤثر على توصياتك، ولن تظهر لمتابعيك إذا كنت قد قمت بإعداد ملف شخصي في Apple Music."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La música que escoltis en aquest dispositiu no es mostrarà a les reproduccions recents ni a les remescles anuals, i no influirà en les recomanacions que rebis. A més, si tens un perfil de l’Apple Music, qui et segueixi tampoc no podrà veure què escoltes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudba přehrávaná na tomto zařízení se nebude objevovat v seznamu naposledy poslouchaných skladeb a v Replay mixech ani ovlivňovat vaše doporučení. Pokud jste si vytvořili profil na Apple Music, lidé, kteří vás sledují, tuto hudbu neuvidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik, der afspilles på denne enhed, vises ikke i senest afspillet eller i replaymiks, den påvirker ikke dine anbefalinger, og dine følgere kan ikke se den, hvis du indstiller en Apple Music‑profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät wiedergegebene Musik wird nicht in „Zuletzt gespielt“ und in Mixen von „Erneut wiedergeben“ angezeigt, beeinflusst nicht, was dir empfohlen wird, und wird deinen Follower:innen nicht angezeigt, wenn du ein Apple Music-Profil konfigurierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μουσική που αναπαράγεται σε αυτήν τη συσκευή δεν θα εμφανίζεται στις Πρόσφατες αναπαραγωγές ούτε στις συνθέσεις Replay, δεν θα επηρεάζει τις εξατομικευμένες προτάσεις σας, και αν διαμορφώσετε ένα προφίλ στο Apple Music, δεν θα είναι ορατό στα άτομα που σας ακολουθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music played on this device will not appear in Recently Played, Replay mixes, influence your recommendations, and if you set up an Apple Music profile, it will not be seen by your followers."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Music played on this device will not appear in Recently Played or Replay mixes, or influence your recommendations, and if you set up an Apple Music profile, it will not be seen by your followers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Music played on this device will not appear in Recently Played and Replay mixes, or influence your recommendations, and if you set up an Apple Music profile, it will not be seen by your followers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música que se reproduzca en este dispositivo no aparecerá en las reproducciones recientes ni en las listas Replay Mix, no determinará las recomendaciones que recibas y, si configuras un perfil de Apple Music, tus seguidores no lo podrán ver."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La música que se reproduzca en este dispositivo no influenciará tus recomendaciones ni se mostrará en el contenido reciente ni en los mixes Replay. Además, si configuraste un perfil de Apple Music, tus seguidores tampoco la podrán ver."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La música que se reproduzca en este dispositivo no influenciará tus recomendaciones ni se mostrará en el contenido reciente ni en los mixes Replay. Además, si configuraste un perfil de Apple Music, tus seguidores tampoco la podrán ver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa toistettu musiikki ei näy Äskettäin toistetuissa tai Replay-mikseissä eikä vaikuta suosituksiin. Se ei näy seuraajillesi, jos otat käyttöön Apple Music -profiilin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique écoutée sur cet appareil n’apparaîtra pas dans « Écoutés récemment » et dans les mix Replay, n’influencera pas vos recommandations et, si vous avez configuré un profil Apple Music, ne sera pas visible pour vos abonnés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique écoutée sur cet appareil ne s’affichera pas dans Écoutée récemment ni dans les mix qui reprennent vos écoutes précédentes, et n’influencera pas les recommandations qui vous sont faites. Elle ne sera pas visible par vos abonnés si vous créez un profil Apple Music."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוזיקה שהופעלה במכשיר זה לא תופיע ב״הופעלו לאחרונה״ או בפלייליסטים של Replay, ולא תשפיע על ההמלצות שלך. היא גם לא תהיה גלויה לעוקבים שלך אם הגדרת פרופיל ב-Apple Music."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर चलाया गया संगीत हालिया चलाए गए, मिक्स फिर चलाएँ में नहीं दिखाई देगा, आपको मिलने वाली अनुशंसाओं को प्रभावित नहीं करेगा और अगर आप Apple Music प्रोफ़ाइल सेटअप करते हैं, तो आपके फ़ॉलोअर उसे नहीं देख सकेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glazba reproducirana za ovom uređaju neće se prikazivati u Ponovno slušamo, Ponovnoj reprodukciji mikseva niti utjecati na vaše preporuke, a ako ste podesili Apple Music profil, vaši ga pratitelji neće moći vidjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen az eszközön lejátszott zenék nem jelennek meg a Nemrég játszott részben vagy a Replay mixekben, és nem befolyásolják az Önnek szóló javaslatokat, ha pedig egy Apple Music-profilt állít be, a követői számára ezek nem lesznek láthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik yang diputar di perangkat ini tidak akan muncul di Baru Diputar dan campuran Putar Ulang serta tidak akan memengaruhi rekomendasi Anda. Selain itu, jika Anda mengatur profil Apple Music, pengaturan tersebut tidak akan terlihat oleh pengikut Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica riprodotta sul dispositivo non verrà mostrata nei brani ascoltati recentemente e nei mix Replay, non influenzerà i brani consigliati e, se hai configurato un profilo Apple Music, non sarà visualizzata dai tuoi follower."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで再生されたミュージックは、最近再生した項目やReplayミックスに表示されず、おすすめにも反映されません。また、Apple Musicのプロフィールを設定している場合は、あなたをフォローしている人に表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 재생되는 음악이 최근 재생된 항목 및 리플레이 믹스에서 보여지거나 추천 음악에 영향을 주지 않습니다. 사용자가 Apple Music 프로필을 설정한 경우 팔로워가 해당 프로필을 볼 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzik yang dimainkan pada peranti ini tidak akan kelihatan dalam Terbaru Dimainkan, campuran Replay, mempengaruhi pengesyoran anda dan jika anda menyediakan profil Apple Music, ia tidak akan dilihat oleh pengikut anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikk som spilles på denne enheten, vil ikke dukke opp i Nylig spilt eller Replay-mikser. Den vil ikke påvirke hvilke anbefalinger du får, og hvis du oppretter en Apple Music-profil, blir den heller ikke sett av de som følger deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziek die je afspeelt op dit apparaat wordt niet weergegeven in 'Recent afgespeeld', Replay-mixes, heeft geen invloed op je aanbevelingen en wordt niet door je volgers gezien als je een Apple Music-profiel configureert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka odtwarzana na tym urządzeniu nie będzie widoczna na liście Ostatnio odtwarzane ani w miksach Replay, nie będzie miała wpływu na Twoje rekomendacje i nie będzie widoczna dla osób obserwujących Cię (jeśli masz skonfigurowany profil w Apple Music)."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas reproduzidas neste dispositivo não aparecerão em Reproduções Recentes nem nas seleções de Replay, não influenciarão as suas recomendações e, se você configurar um perfil no Apple Music, não serão vistas pelos seus seguidores."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A música reproduzida neste dispositivo não aparecerá em Recentes nem nas misturas Replay, não influenciará as recomendações e, caso configure um perfil em Apple Music, não será vista pelos seus seguidores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzica redată pe acest dispozitiv nu va apărea în istoricul redărilor sau în mixajele pentru reascultare, nu va influența recomandările primite și, dacă vă configurați un profil Apple Music, nu va fi văzută de urmăritorii dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыка, воспроизводимая на этом устройстве, не будет отображаться в разделе «Недавно воспроизведенные» и в миксах «Мой год», а также не повлияет на Ваши рекомендации, а если Вы настроите профиль Apple Music, Ваши подписчики его не увидят."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudba prehrávaná na tomto zariadení sa nebude zobrazovať medzi naposledy hranými skladbami a v Replay mixoch, nebude ovplyvňovať vaše odporúčania a ak si nastavíte profil na Apple Music, vaši nasledovatelia ju neuvidia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasba, predvajana v tej napravi, ne bo prikazana v razdelku Nedavno predvajano, mešanih ponovnih predvajanjih, ne bo vplivala na vaša priporočila in če nastavite profil v storitvi Apple Music, je vaši sledilci ne bodo videli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik som spelas upp på den här enheten visas inte bland senast spelade eller Replay-mixar och påverkar inte vilka rekommendationer som du får. Om du ställer in en Apple Music-profil visas den inte för dina följare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงที่เล่นบนอุปกรณ์นี้จะไม่แสดงในเล่นล่าสุด, มิกซ์ Replay, จะมีผลต่อเพลงแนะนำของคุณ และถ้าคุณตั้งค่าโปรไฟล์ Apple Music ผู้ติดตามของคุณจะไม่เห็นเพลงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta çalınan müzikler Son Çalınan’da ve Dinlediklerin karmalarında görünmez, önerilerinizi etkilemez ve Apple Music profili ayarlarsanız takipçileriniz tarafından da görülmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музика, що відтворюється на цьому пристрої, не зʼявлятиметься в недавно відтвореному чи в міксах «На повторі», не впливатиме на рекомендації для вас і не відображатиметься для ваших прихильників, якщо у вас є профіль Apple Music."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhạc được phát trên thiết bị này sẽ không xuất hiện trong Đã phát gần đây, nhạc Replay kết hợp, không tác động đến các đề xuất của bạn và nếu bạn thiết lập trang cá nhân Apple Music, người theo dõi của bạn sẽ không nhìn thấy nhạc đó."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上播放的音乐将不会出现在“最近播放”、“音乐回忆歌单”中，也不会影响你的推荐；若你设置了Apple Music个人资料，这些音乐也不会被关注者看到。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在此裝置上播放的音樂將不會在「最近播放」、「重播選集」中出現，亦不會影響你收到的建議項目。如你設定Apple Music個人檔案，你的關注者將不會看到。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在此裝置上播放的音樂將不會顯示於「最近播放」、「音樂回憶歌單」，且不會影響你的推薦項目。若你已設定Apple Music個人檔案，你的追蹤者將不會看到這些音樂。"
          }
        }
      }
    },
    "MusicUseListeningHistoryON": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموسيقى التي تُشغّل على هذا الجهاز ستظهر ضمن المشغلة حديثًا ومنوعات Replay، وتؤثر على توصياتك، وستظهر لمتابعيك أيضًا إذا كنت قد قمت بإعداد ملف شخصي في Apple Music."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La música que escoltis en aquest dispositiu es mostrarà a les reproduccions recents i a les remescles anuals, i influirà en les recomanacions que rebis. A més, si tens un perfil de l’Apple Music, qui et segueixi podrà veure què escoltes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudba přehrávaná na tomto zařízení se bude objevovat v seznamu naposledy poslouchaných skladeb a v Replay mixech a ovlivňovat vaše doporučení. Pokud jste si vytvořili profil na Apple Music, uvidí tuto hudbu lidé, kteří vás sledují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
