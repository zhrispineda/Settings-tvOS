        "ro": {
          "stringUnit": {
            "value": "Volumul conținutului multimedia și al apelurilor nu se va modifica în timpul enunțării VoiceOver.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Громкость медиаконтента и вызовов не будет изменяться, когда VoiceOver говорит.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Keď VoiceOver rozpráva, hlasitosť médií ani hovorov sa nezníži.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Med predvajanjem govora s funkcijo VoiceOver ostane glasnost predstavnostne vsebine in klicev nespremenjena.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Volymen för medier och samtal förändras inte när VoiceOver läser upp.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ระดับเสียงของสื่อและสายโทรจะไม่เปลี่ยนเมื่อ VoiceOver อ่านออกเสียงอยู่",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver konuşurken ortamların ve aramaların ses yüksekliği değiştirilmez.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Гучність викликів і медіавмісту не змінюватиметься під час мовлення VoiceOver.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Âm lượng của phương tiện và cuộc gọi sẽ không thay đổi khi VoiceOver đang nói.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "“旁白”朗读时，媒体和通话音量不会变化。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "「旁白」朗讀期間，媒體和通話的音量不會改變。",
