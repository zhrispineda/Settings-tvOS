            "value": "‏Apple TV غير متصل بالإنترنت. لاستخدام Apple TV، يجب توصيله بالإنترنت باستخدام Wi-Fi أو الإيثرنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV no està connectat a internet. Per utilitzar‑lo, connecta’l a una xarxa Wi‑Fi o Ethernet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV není připojená k internetu. Chcete‑li ji použít, připojte ji pomocí Wi‑Fi nebo Ethernetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple TV-enhed er ikke forbundet til internettet. Hvis du vil bruge Apple TV, skal du oprette forbindelse vha. Wi‑Fi eller Ethernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV ist nicht mit dem Internet verbunden. Stelle eine Verbindung über WLAN oder Ethernet her, um Apple TV zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV δεν είναι συνδεδεμένο στο Διαδίκτυο. Για χρήση του Apple TV, συνδεθείτε μέσω Wi-Fi ή Ethernet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect using Wi-Fi or Ethernet."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect using Wi-Fi or Ethernet."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect using Wi-Fi or Ethernet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no está conectado a internet. Para poder utilizarlo, conéctalo a la red Wi‑Fi o Ethernet."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no tiene conexión a Internet. Para usarlo, conéctalo a una red Wi‑Fi o a Ethernet."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no tiene conexión a Internet. Para usarlo, conéctalo a una red Wi‑Fi o a Ethernet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ei ole yhteydessä internetiin. Yhdistä Wi‑Fiin tai Ethernetiin, jotta voit käyttää Apple TV:tä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Pour pouvoir l’utiliser, connectez-vous via Wi-Fi ou Ethernet."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Pour utiliser l’Apple TV, connectez-la au moyen d’une connexion Wi‑Fi ou Ethernet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV לא מחובר לאינטרנט. כדי להשתמש ב-Apple TV, יש להתחבר באמצעות רשת אלחוטית או Ethernet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV इंटरनेट से कनेक्टेड नहीं है। Apple TV का उपयोग करने के लिए वाई-फ़ाई या ईथरनेट का उपयोग करके कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV nije spojen na internet. Za uporabu Apple TV‑a spojite se koristeći Wi-Fi ili Ethernet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV nem csatlakozik az internethez. Az Apple TV használatához csatlakozzon Wi-Fi vagy Ethernet használatával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda tidak terhubung ke internet. Untuk menggunakan Apple TV, hubungkan menggunakan Wi-Fi atau Ethernet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV non è connessa a internet. Per utilizzarla, connettiti tramite una rete Wi‑Fi o il cavo Ethernet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVがインターネットに接続されていません。Apple TVを使用するには、Wi‑FiまたはEthernetを使用して接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 인터넷에 연결되어 있지 않습니다. Apple TV를 사용하려면 Wi‑Fi 또는 이더넷을 통해 인터넷에 연결하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda tidak disambungkan ke internet. Untuk menggunakan Apple TV, sambung menggunakan Wi‑Fi atau Ethernet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er ikke koblet til internett. Du må koble til Wi‑Fi eller Ethernet for å bruke Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV is niet verbonden met het internet. Om Apple TV te gebruiken, maak je verbinding via wifi of ethernet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nie ma połączenia z Internetem. Aby używać Apple TV, połącz się z Internetem przez sieć Wi‑Fi lub Ethernet."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está conectada à internet. Para usar a Apple TV, conecte‑a à internet via Wi‑Fi ou Ethernet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está ligada à internet. Para usar a Apple TV, estabeleça ligação através de Wi‑Fi ou Ethernet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul dvs. nu este conectat la internet. Pentru a utiliza Apple TV‑ul, conectați‑l utilizând o rețea Wi‑Fi sau Ethernet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV не подключен к интернету. Чтобы использовать Apple TV, необходимо подключиться к сети Wi‑Fi или Ethernet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše Apple TV nie je pripojené na internet. Ak chcete používať Apple TV, pripojte ho cez Wi-Fi alebo ethernet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nima vzpostavljene internetne povezave. Če želite uporabljati Apple TV, vzpostavite povezavo prek omrežja Wi-Fi ali Ethernet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV är inte ansluten till internet. Om du vill använda Apple TV ansluter du till Wi‑Fi eller Ethernet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณไม่ได้เชื่อมต่อกับอินเทอร์เน็ต ในการใช้ Apple TV ให้เชื่อมต่อโดยใช้ Wi‑Fi หรืออีเธอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz internete bağlı değil. Apple TV’yi kullanmak için Wi‑Fi’yi veya Ethernet’i kullanarak bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не зʼєднано з інтернетом. Щоб використовувати Apple TV, підʼєднайте його за допомогою Wi‑Fi‑мережі або Ethernet‑кабелю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn không được kết nối vào internet. Để sử dụng Apple TV, hãy kết nối bằng Wi-Fi hoặc Ethernet."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV尚未接入互联网。若要使用Apple TV，请使用Wi-Fi或以太网连接。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV尚未連接互聯網。如要使用Apple TV，請使用Wi-Fi或乙太網絡連線。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV並未連接網際網路。若要使用Apple TV，請使用Wi-Fi或乙太網路連接。"
          }
        }
      }
    },
