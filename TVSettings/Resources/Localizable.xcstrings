          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le profil VPN. Nécessite des identifiants AppleConnect valides."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le profil VPN. Des informations d’identification AppleConnect valides sont requises."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טעינת פרופיל VPN. יש צורך בפרטי זיהוי תקינים של AppleConnect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN प्रोफ़ाइल लोड करें। इसके लिए मान्य AppleConnect क्रेडेंशियल चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitajte VPN profil. Zahtijeva važeće AppleConnect vjerodajnice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töltse be a VPN-profilt. Érvényes AppleConnect bejelentkezési adatokat igényel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat profil VPN. Memerlukan info pengesahan AppleConnect yang sah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica il profilo VPN. Richiede credenziali AppleConnect valide."
