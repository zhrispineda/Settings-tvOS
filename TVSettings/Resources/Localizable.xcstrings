    "SiriDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل Siri معلومات، مثل إدخال الصوت والموقع، إلى Apple بهدف معالجة الطلبات. ولن يتم إرسال إدخال الصوت من تهجئة إملاء أسماء المستخدمين أو كلمات السر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envia informació a Apple, com ara les ordres de veu i la ubicació, per processar les sol·licituds. No s’enviarà cap nom ni cap contrasenya que dictis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri odesílá informace, jako je váš hlasový vstup a údaje o poloze, společnosti Apple ke zpracování požadavků. Hlasový vstup obsahující hláskování uživatelských jmen a hesel odesílán není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sender oplysninger såsom taleinput og lokalitet til Apple til behandling af dine anmodninger. Når du staver til brugernavne og adgangskoder vha. diktering, sendes din tale ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sendet Informationen wie Spracheingaben und Standortdaten an Apple, um Anfragen zu bearbeiten. Spracheingaben von buchstabierten Benutzernamen und Passwörtern werden nicht gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Siri στέλνει στην Apple πληροφορίες, όπως δεδομένα φωνητικής εισόδου και την τοποθεσία σας, για επεξεργασία αιτημάτων. Δεν αποστέλλονται δεδομένα φωνητικής εισόδου από υπαγόρευση συλλαβισμού ονομάτων χρηστών και συνθηματικών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of user names and passwords won’t be sent."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of usernames and passwords won’t be sent."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of usernames and passwords won’t be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envía información (como la voz o la ubicación) a Apple para procesar las peticiones. Los nombres y contraseñas que dictes no se enviarán."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envía información a Apple, como el registro de tu voz y tu ubicación, para procesar solicitudes. No se enviará tu voz al dictar nombres de usuario y contraseñas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envía información a Apple, como el registro de tu voz y tu ubicación, para procesar solicitudes. No se enviará tu voz al dictar nombres de usuario y contraseñas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri lähettää tietoja, kuten puhesyötteesi ja sijaintisi, Applelle pyyntöjesi käsittelyä varten. Puhesyötettä kirjaimittain sanelluista käyttäjätunnuksista ja salasanoista ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envoie des informations telles que votre voix et votre position géographique à Apple afin de traiter vos requêtes. Les noms d’utilisateur et mots de passe dictés ne sont pas envoyés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envoie des informations à Apple, comme les contenus vocaux et votre position, pour traiter vos demandes. Les contenus vocaux correspondant aux noms d’utilisateurs et aux mots de passe ne sont pas envoyés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מידע כגון קלט קולי ופרטי מיקום נשלח על-ידי Siri ל-Apple לצורך עיבוד בקשות. קלט קולי מהכתבת איות של שמות משתמשים וסיסמאות לא יישלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri द्वारा अनुरोधों को प्रोसेस करने के लिए आपके वॉइस इनपुट और स्थान जैसी जानकारी Apple को भेजी जाती है। यूज़रनेम और पासवर्ड की वर्तनी डिक्टेशन का वॉइस इनपुट नहीं भेजा जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri šalje tvrtki Apple informacije poput vašeg glasovnog unosa i lokacije kako bi obradila vaše zahtjeve. Glasovni unosi slovkanja korisničkih imena i lozinki neće biti poslani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri információkat küld az Apple-nek a kérelmek feldolgozásához, például a hangbevitelt és helyzetet. A felhasználónevek és jelszavak betűzéséhez használt hangbevitel nem lesz elküldve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri mengirimkan informasi, seperti input suara dan lokasi, ke Apple untuk memproses permintaan. Input suara dari dikte ejaan nama pengguna dan kata sandi tidak akan dikirimkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri invia informazioni come l’input vocale e la posizione in cui ti trovi ad Apple per elaborare le richieste. L’input vocale per la dettatura dei nomi utente e delle password non verrà inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriを使用すると、リクエストを処理するために、音声入力の内容や位置情報などの情報がAppleに送信されます。ユーザ名およびパスワードのスペルを音声入力したときは内容が送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri는 사용자의 요청을 처리하기 위해 음성 입력과 위치 등의 정보를 Apple에 보냅니다. 사용자 이름 및 암호의 철자를 받아쓰기한 음성 입력은 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri menghantar maklumat, seperti input suara dan lokasi, kepada Apple untuk memproses permintaan. Input suara daripada perencanaan ejaan nama pengguna dan kata laluan tidak akan dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sender informasjon som taleinndata og posisjon til Apple for å behandle forespørsler. Taleinndata med staving av brukernavn og passord sendes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri stuurt gegevens, zoals steminvoer en locatie, naar Apple om verzoeken te verwerken. Steminvoer voor het spellen van gebruikersnamen en wachtwoorden wordt niet verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri wysyła informacje, np. Twoje polecenia głosowe i położenie, do Apple w celu ich przetworzenia. Literowane nazwy użytkownika i hasła nie są wysyłane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri envia dados como a sua voz, contatos e localizações à Apple para processar seus pedidos. Dados de voz que contêm nomes de usuário e senhas não são enviados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envia à Apple informação, como dados de voz e localização, para processar os seus pedidos. Não são enviados dados de voz relacionados com o ditado de nomes de utilizadores e palavras‑passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri trimite la Apple informații, precum comenzile vocale și localizarea dvs., pentru procesarea solicitărilor. Comenzile vocale rezultate din dictarea pe litere a numelor de utilizator și a parolelor nu vor fi trimise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обработки запросов Siri отправляет в Apple такую информацию, как голосовой ввод и геопозиция. Надиктованные данные, такие как имена пользователей и пароли, не отправляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri odosiela do Apple kvôli spracovaniu vašich žiadostí informácie, ako je váš hlasový vstup a vaša poloha. Hlasový vstup obsahujúci hláskovanie užívateľských mien a hesiel nie je odosielaný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri družbi Apple pošilja podatke, kot so vaš glasovni vnos in lokacija, da lahko obdela vaše zahteve. Glasovni vnos ob narekovanju črkovanja uporabniških imen in gesel ne bo poslan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri skickar information, till exempel din röstinmatning och din plats till Apple för att kunna behandla förfrågningar. Röstinmatning från stavningsdiktering av användarnamn och lösenord skickas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri จะส่งข้อมูล เช่น คำพูดและตำแหน่งที่ตั้ง ไปที่ Apple เพื่อดำเนินการตามคำขอของคุณ ชื่อผู้ใช้และรหัสผ่านที่คุณพูดเมื่อป้อนตามคำบอกจะไม่ถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri, isteklerinizi işlemek için ses girişleriniz ve konumunuz gibi bilgileri Apple’a gönderir. Kullanıcı adı ve parola dikte ederken hecelenen ses girişleri gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для опрацювання ваших запитів Siri надсилає до Apple певні відомості, як‑от дані голосового вводу й геопозицію. Голосові дані посимвольного вводу облікових імен і паролів не надсилаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri gửi thông tin, như dữ liệu đầu vào bằng giọng nói và vị trí của bạn, đến Apple để xử lý yêu cầu. Dữ liệu đầu vào bằng giọng nói từ đọc chính tả đánh vần tên người dùng và mật khẩu của bạn sẽ không được gửi."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri会将语音输入和位置等信息发送到Apple以处理请求。拼写用户名和密码的语音输入将不会发送。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會將一些資料（例如語音輸入及位置等）傳送予Apple以處理要求。傳送的資料不包括串字聽寫用户名稱及密碼的語音輸入。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會將語音輸入和位置等資訊傳送給Apple來處理要求。不會傳送使用者名稱和密碼的拼字聽寫語音輸入。"
          }
        }
      }
    },
    "SiriDisableWarningMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعلومات التي يستخدمها Siri للاستجابة لطلباتك سيتم أيضًا استخدامها للإملاء، وسيتم إبقاؤها على خوادم Apple إلا إذا تم إيقاف الإملاء أيضًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La informació que Siri utilitza per donar resposta a les teves sol·licituds també s’utilitza per al dictat i es conservarà als servidors d’Apple a menys que també desactivis el dictat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, která Siri používá k odpovědím na vaše žádosti, jsou také využívána pro Diktování a budou nadále uložena na serverech společnosti Apple (pokud také nevypnete Diktování)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De oplysninger, som Siri bruger til at besvare dine anmodninger, bruges også til diktering og forbliver på Apples servere, medmindre diktering også slås fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von Siri zum Antworten auf Anfragen verwendeten Informationen werden auch von der Diktierfunktion verwendet und bleiben auf den Apple-Servern, es sei denn, die Diktierfunktion ist ebenfalls deaktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πληροφορίες που χρησιμοποιεί το Siri για να αποκρίνεται στα αιτήματά σας χρησιμοποιούνται επίσης για την Υπαγόρευση και θα παραμείνουν στους διακομιστές της Apple μέχρι να απενεργοποιηθεί η Υπαγόρευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Dictation is also turned off."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Dictation is also turned off."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Dictation is also turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado también utiliza la información que usa Siri para responder a tus solicitudes, por lo que esta permanece en los servidores de Apple a menos que se desactive Dictado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder a tus solicitudes, Siri usa información que Dictado también usa y que residirá en los servidores de Apple salvo que se desactive Dictado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder a tus solicitudes, Siri usa información que Dictado también usa y que residirá en los servidores de Apple salvo que se desactive Dictado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja, joita Siri käyttää vastatessaan pyyntöihisi, käytetään myös sanelua varten. Tiedot säilyvät Applen palvelimilla ellet laita myös sanelua pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations utilisées par Siri pour répondre à vos requêtes sont également utilisées pour Dictée et resteront sur les serveurs Apple sauf si Dictée est aussi désactivée."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations utilisées par Siri pour répondre à vos requêtes sont également utilisées par Dictée et sont conservées sur les serveurs d’Apple, à moins que Dictée ne soit désactivée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המידע שמשמש את Siri כדי להגיב לבקשות שלך משמש גם את המאפיין ״הכתבה״ ונשאר בשרתים של Apple, אלא אם כן כיבית גם את ״הכתבה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अनुरोधों का उत्तर देने के लिए Siri द्वारा जिस जानकारी का उपयोग किया जाता है, उसी का उपयोग डिक्टेशन के लिए भी किया जाता है और वह जानकारी डिक्टेशन के बंद किए जाने तक Apple के सर्वर पर उपलब्ध रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacije koje Siri koristi za odgovaranje na vaše zahtjeve također se koriste za Diktat i zadržat će se na Appleovim serverima osim ako ne isključite i Diktat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri által a kérések megválaszolására használt információk a Diktálás használatához is szükségesek, ezért ezek addig az Apple szerverein maradnak, amíg a Diktálást is ki nem kapcsolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi yang digunakan Siri untuk merespons permintaan Anda juga digunakan untuk Dikte dan akan tetap berada di server Apple kecuali jika Dikte dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni utilizzate da Siri per rispondere alle tue richieste sono usate anche per Dettatura e rimarranno sui server di Apple a meno che non disabiliti anche Dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriがユーザのリクエストに応じる際に参照する情報は音声入力でも使用され、音声入力もオフになっている場合を除き、Appleサーバからは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri가 사용자의 요청에 응답하기 위해 사용하는 정보는 받아쓰기에서도 사용되며 받아쓰기가 꺼져 있지 않는 한 Apple 서버에 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat yang digunakan oleh Siri untuk membalas permintaan anda turut digunakan untuk Perencanaan dan akan kekal pada pelayan Apple melainkan Perencanaan turut dinyahaktifkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasjonen Siri bruker til å svare på forespørslene dine, brukes også til diktering og blir værende på Apples tjenere med mindre diktering også slås av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De informatie die Siri gebruikt om te reageren op je verzoeken wordt ook gebruikt voor de dicteerfunctie en blijft aanwezig op de Apple servers tenzij de dicteerfunctie ook wordt uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje, których Siri używa do przetwarzania Twoich poleceń, są także używane przez funkcję dyktowania i pozostaną na serwerach Apple, o ile jej nie wyłączysz."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações usadas pela Siri para responder a seus pedidos também são usadas para o Ditado e permanecerão nos servidores da Apple, a menos que o Ditado também seja desativado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A informação usada por Siri para responder aos seus pedidos é igualmente utilizada pela funcionalidade Ditado e permanecerá nos servidores da Apple, a menos que também desative o Ditado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informațiile utilizate de Siri pentru a răspunde solicitărilor dvs. sunt utilizate și pentru dictare și vor rămâne pe serverele Apple, cu excepția cazului în care dezactivați și dictarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация, используемая Siri для ответов на Ваши запросы, также используется для Диктовки и будет храниться на серверах Apple, пока Диктовка также не будет выключена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Informácie, ktoré Siri používa na spracovanie vašich žiadostí, používa aj Diktovanie a zostanú na serveroch Apple, kým nebude vypnuté aj Diktovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki, ki jih Siri uporablja za odgovarjanje na vaše zahteve, se uporabljajo tudi za Narekovanje in bodo ostali v strežnikih Apple, razen če izklopite tudi Narekovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationen som Siri använder till att utföra dina instruktioner används även av diktering och kommer att finnas kvar på Apples servrar om inte diktering också stängs av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่ Siri ใช้เพื่อตอบสนองต่อคำขอของคุณจะถูกใช้สำหรับการป้อนตามคำบอกด้วย และจะอยู่บนเซิร์ฟเวอร์ของ Apple นอกจากจะปิดใช้งานการป้อนตามคำบอกด้วยเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri’nin isteklerinize yanıt vermek için kullandığı bilgiler Dikte için de kullanılır ve Dikte kapatılmadığı sürece de Apple sunucularında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація, яку Siri використовує, щоб відповідати на ваші запити, також використовується для Диктування і лишатиметься на серверах Apple, доки Диктування не вимкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin mà Siri sử dụng để đáp ứng yêu cầu của bạn cũng được sử dụng cho Đọc chính tả và sẽ vẫn ở trên máy chủ của Apple trừ khi Đọc chính tả cũng bị tắt."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri用于回应你请求所用的信息也会用于“听写”，除非也同时关闭“听写”，否则这些信息将保留在Apple服务器上。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri用作回應你要求的資料亦同時用於「聽寫」。除非「聽寫」被關上，否則該資料將繼續保留在Apple的伺服器上。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri回應你要求時所用的資訊也會用在「聽寫」，除非關閉「聽寫」，否則此資訊都會保留在Apple伺服器中。"
          }
        }
      }
    },
