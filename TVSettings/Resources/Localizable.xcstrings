          }
        },
        "he": {
          "stringUnit": {
            "value": "עוצמת השמע של מדיה ושיחות לא תשתנה בעת הקראה של VoiceOver.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver के बोलने के दौरान मीडिया और कॉल का वॉल्यूम बदला नहीं जाएगा।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Glasnoća medija i poziva neće se promijeniti kad VoiceOver čita.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A média és a hívások hangereje nem fog változni, amikor a VoiceOver beszél.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Volume media dan panggilan tidak akan berubah saat VoiceOver berbicara.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Il volume dei contenuti multimediali e delle chiamate non cambierà durante la lettura di VoiceOver.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverが読み上げるときにメディアと通話の音量は変更されません。",
