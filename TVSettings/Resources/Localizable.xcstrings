    "AXGeneratedSubtitlesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "إظهار الترجمة المُولَّدة تلقائيًا عند عدم توفر الترجمة العادية.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Mostra automàticament els subtítols generats quan no hi hagi subtítols convencionals disponibles.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Když nejsou k dispozici běžné titulky, automaticky se zobrazí generované.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Vis automatisk genererede undertekster, når almindelige undertekster ikke er tilgængelige.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Automatisch generierte Untertitel anzeigen, wenn keine regulären Untertitel verfügbar sind.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αυτόματη εμφάνιση δημιουργημένων υπότιτλων όταν οι κανονικοί υπότιτλοι δεν είναι διαθέσιμοι.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Automatically show generated subtitles when regular subtitles are not available.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Automatically show generated subtitles when regular subtitles are not available.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Automatically show generated subtitles when regular subtitles are not available.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Automatically show generated subtitles when normal subtitles are not available.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Automatically show generated subtitles when regular subtitles are not available.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Si no hay subtítulos disponibles, se mostrarán subtítulos generados automáticamente.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Muestra automáticamente subtítulos generados cuando no haya subtítulos regulares.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Muestra automáticamente subtítulos generados cuando no haya subtítulos regulares.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Näytä generoidut tekstitykset automaattisesti, kun tavallisia tekstityksiä ei ole saatavilla.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Affichez automatiquement des sous-titres générés lorsque les sous-titres standard ne sont pas disponibles.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Affiche automatiquement les sous-titres générés lorsque les sous-titres standards ne sont pas disponibles.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להציג אוטומטית כתוביות שנוצרו כאשר כתוביות רגילות אינן זמינות.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "नियमित सबटाइटल उपलब्ध न होने पर जनरेट किए गए सबटाइटल ऑटोमैटिकली दिखाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Automatski prikaz generiranih titlova kad redovni titlovi nisu dostupni.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Automatikusan generált feliratokat jelenít meg, ha nem érhetők el normál feliratok.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tampilkan subtitle yang dihasilkan secara otomatis saat subtitle reguler tidak tersedia.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Mostra automaticamente i sottotitoli generati quando quelli standard non sono disponibili.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "通常の字幕を利用できない場合、生成された字幕を自動的に表示します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "일반 자막을 사용할 수 없을 때 자동으로 생성된 자막을 표시합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tunjukkan sari kata yang dijana secara automatik apabila sari kata biasa tidak tersedia.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Toon gegenereerde ondertiteling automatisch wanneer de normale ondertiteling niet beschikbaar is.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Vis automatisk genererte undertekster når vanlige undertekster ikke er tilgjengelige.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Automatycznie wyświetlaj napisy generowane, gdy zwykłe nie są dostępne.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Mostra automaticamente as legendas geradas quando as legendas comuns não estiverem disponíveis.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Mostrar automaticamente legendas geradas se não estiverem disponíveis legendas normais.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Subtitrările generate vor fi afișate automat atunci când subtitrările obișnuite nu sunt disponibile.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Автоматически показывать сгенерированные субтитры, если обычные субтитры недоступны.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Keď nie sú k dispozícii bežné titulky, budú sa automaticky zobrazovať vygenerované titulky.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Samodejno prikažite ustvarjene podnapise, ko običajni podnapisi niso na voljo.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Visa genererade undertexter automatiskt när vanliga undertexter inte är tillgängliga.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แสดงคำบรรยายที่สร้างโดยอัตโนมัติเมื่อไม่มีคำบรรยายปกติ",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Normal altyazılar olmadığında oluşturulan altyazıları otomatik olarak gösterir.",
            "state": "translated"
          }
        },
        "uk": {
