    "SettingsVPNOKConnectedText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه تم تمكين VPN بشكل صحيح.\nتم تحميل ملف تعريف VPN وستنتهي صلاحيته في %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembla que la VPN està ben configurada.\nEl perfil de VPN està carregat (data de caducitat: %@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN síť je zřejmě nastavená správně.\nJe načtený VPN profil, který vyprší %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ud til, at VPN er konfigureret korrekt.\nVPN‑profilen er indlæst og udløber den %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN ist anscheinend korrekt konfiguriert.\nDas VPN-Profil ist geladen und läuft am %@ ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται ότι το VPN έχει διαμορφωθεί σωστά.\nΤο προφίλ VPN έχει φορτωθεί και λήγει στη(στις) %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like VPN is configured OK.\nThe VPN profile is loaded and expires on %@."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like VPN is configured OK.\nThe VPN profile is loaded and expires on %@."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like VPN is configured OK.\nThe VPN profile is loaded and expires on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la conexión VPN está configurada correctamente.\nEl perfil VPN está cargado y caduca el %@."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la VPN está configurada correctamente.\nEl perfil de VPN está cargado y vence el %@."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la VPN está configurada correctamente.\nEl perfil de VPN está cargado y vence el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like VPN is configured OK.\nThe VPN profile is loaded and expires on %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du VPN semble être correcte.\nLe profil VPN est chargé et expire le %@."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le VPN semble correctement configuré.\nLe profil VPN est chargé et expire le %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שה-VPN מוגדר באופן תקין.\nפרופיל ה-VPN טעון ותוקפו יפוג ב-%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा लगता है कि VPN ठीक से कॉन्फ़िगर किया हुआ है।\nVPN प्रोफ़ाइल लोड की गई है और इसकी समय सीमा %@ को समाप्त हो जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čini se da je VPN pravilno konfiguriran.\nVPN profil je učitan i istječe %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik a VPN megfelelően konfigurálva van.\nA VPN-profil be van töltve, és lejár ekkor: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya konfigurasi VPN OKE.\nProfil VPN dimuat dan kedaluwarsa pada %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La VPN è configurata correttamente.\nIl profilo VPN è caricato e scadrà il giorno %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNは正しく構成されているようです。\nVPNプロファイルは読み込まれていて、%@に期限が切れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 VPN이 올바르게 구성되어 있습니다.\nVPN 프로필이 로드되었으며 %@에 만료됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nampaknya konfigurasi VPN tiada masalah.\nProfil VPN dimuatkan dan tamat tempoh pada %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ut til at VPN er konfigurert riktig.\nVPN-profilen er lastet inn og utløper %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo te zien is VPN geconfigureerd.\nHet VPN-profiel is geladen en verloopt op %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że masz połączenie z siecią VPN.\nProfil VPN jest wczytany i wygaśnie %@."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a VPN está configurada corretamente.\nO perfil de VPN está carregado e expira em %@."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a VPN está bem configurada.\nO perfil da VPN está carregado e caduca a %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că VPN‑ul este configurat OK.\nProfilul VPN este încărcat și expiră pe %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, VPN настроен правильно.\nПрофиль VPN загружен, срок его действия истекает %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá sa, že konfigurácia VPN je v poriadku.\nVPN profil je načítaný a vyprší %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videti je, da je VPN ustrezno konfiguriran.\nProfil VPN je naložen in poteče %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det verkar som om VPN är konfigurerat på ett korrekt sätt.\nVPN-profilen har lästs in och förfaller den %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่ากำหนดค่า VPN ถูกต้อง\nโปรไฟล์ VPN ถูกโหลดและหมดอายุ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN doğru ayarlanmış gibi görünüyor.\nVPN profili yüklenmiş ve %@ tarihinde sona eriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, VPN сконфігуровано правильно.\nПрофіль VPN завантажено, і він застаріє %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dường như VPN được định cấu hình bình thường.\nHồ sơ VPN được tải và hết hạn vào %@."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN似乎已配置好。\nVPN描述文件已载入且将于%@过期。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎已設定好VPN。\n已載入VPN描述檔並將於%@到期。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "看起來VPN已正確設定。\n已載入VPN描述檔，會在%@到期。"
          }
        }
      }
    },
    "SettingsVPNOnInternalNetworkMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان بالإمكان الوصول إلى الموقع الداخلي، ولكن ربما كان ذلك لأنك تبدو على شبكة داخلية. لا يلزم VPN ولا يُستخدم أثناء الاتصال بشبكة داخلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha pogut accedir al lloc web intern, però segurament és perquè ets en una xarxa interna. Si ets en una xarxa interna, la VPN no és necessària i no s’utilitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interní server je dosažitelný, ale zřejmě jste na interní síti. Na interní síti není VPN potřeba, a ani se nepoužívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det interne websted kunne nås, men det kan være, fordi det ser ud til, at du er på et internt netværk. VPN er ikke nødvendigt eller benyttet ved internt netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die interne Site konnte erreicht werden, was wahrscheinlich daran liegt, dass du dich im internen Netzwerk befindest. Im internen Netzwerk ist VPN nicht erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επικοινωνία με τον εσωτερικό ιστότοπο ήταν εφικτή, αλλά αυτό μπορεί να ισχύει, διότι φαίνεται ότι βρίσκεστε σε εσωτερικό δίκτυο. Δεν απαιτείται ή δεν χρησιμοποιείται το VPN όταν βρίσκεστε σε εσωτερικό δίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The internal site was reachable but that might be because you appear to be on an internal network. VPN is not needed or used when on an internal network."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The internal site was reachable but that might be because you appear to be on an internal network. VPN is not needed or used when on an internal network."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The internal site was reachable but that might be because you appear to be on an internal network. VPN is not needed or used when on an internal network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha podido acceder al sitio interno, pero podría ser porque al parecer tienes conexión a una red interna. Cuando se está en una red interna, no es necesario activar ni usar la conexión VPN."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pudo contactar al sitio interno, aunque eso podría deberse a que parece que te conectaste a una red interna. No se necesita ni se utiliza VPN al usar una red interna."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pudo contactar al sitio interno, aunque eso podría deberse a que parece que te conectaste a una red interna. No se necesita ni se utiliza VPN al usar una red interna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The internal site was reachable but that might be because you appear to be on an internal network. VPN is not needed or used when on an internal network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site interne était accessible, mais peut-être parce que vous semblez être sur un réseau interne. Le VPN n’est ni nécessaire ni utilisé sur un réseau interne."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site interne était joignable, probablement parce que votre appareil était connecté à un réseau interne. Le VPN n’est ni utilisé ni requis lorsque votre appareil est connecté à un réseau interne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האתר הפנימי היה נגיש, אך ייתכן שזה משום שנראה שיש לך חיבור לרשת פנימית. חיבור VPN אינו נחוץ ולא נעשה בו שימוש בעת החיבור לרשת פנימית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आंतरिक साइट पर पहुँचा जा सकता था लेकिन शायद इसलिए क्योंकि ऐसा लग रहा है कि आप आंतरिक नेटवर्क पर हैं। आंतरिक नेटवर्क पर रहने पर VPN की ज़रूरत नहीं होती है न ही उसका इस्तेमाल किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interno mjesto je unutar dosega, ali do toga može doći jer se čini da ste spojeni na internu mrežu. VPN nije potreban ili se ne koristi kad ste spojeni na internu mrežu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikerült elérni a belső webhelyet, de előfordulhat, hogy ez azért van, mert Ön egy belső hálózathoz csatlakozik. Belső hálózaton a VPN nem szükséges vagy nincs használatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs internal dapat dijangkau, tapi hal tersebut dapat membuat Anda tampak terhubung ke jaringan internal. VPN tidak diperlukan atau digunakan saat terhubung ke jaringan internal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al sito interno è stata effettuata, ma è possibile che sia avvenuta perché ti trovi su una rete interna. Il profilo VPN non è necessario né viene utilizzato con la rete interna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部用サイトに到達できましたが、それは内部ネットワークに接続しているからかもしれません。内部ネットワークの場合VPNは不必要または使用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 사이트에 접속할 수 있지만, 이는 현재 사용자가 내부 네트워크에 연결되어 있기 때문일 수 있습니다. 내부 네트워크상에 있는 경우 VPN이 필요하지 않거나 사용되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapak dalaman boleh dicapai tetapi mungkin kerana anda sedang menggunakan rangkaian dalaman. VPN tidak diperlukan atau tidak digunakan apabila menggunakan rangkaian dalaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det interne nettstedet kunne nås, men det kan være fordi du er på et internt nettverk. VPN verken kreves eller brukes på interne nettverk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De interne site kon worden bereikt maar waarschijnlijk omdat je je in een intern netwerk bevindt. VPN is niet vereist of wordt niet gebruikt bij een intern netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witryna wewnętrzna jest osiągalna, być może dlatego, że prawdopodobnie jesteś w sieci wewnętrznej. Sieć VPN nie jest potrzebna ani nie jest używana, gdy jesteś w sieci wewnętrznej."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É possível acessar o site interno, mas provavelmente isso ocorre porque você aparenta estar em uma rede interna. Em uma rede interna, a VPN não é necessária nem usada."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao site interno foi bem‑sucedido, mas pode ser porque o seu dispositivo se encontra ligado a uma rede interna. Neste caso, a VPN não é necessária nem usada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Site‑ul intern a putut fi accesat, posibil deoarece pare că vă aflați într‑o rețea internă. Conexiunea VPN nu este necesară sau utilizată într‑o rețea internă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внутренний сайт мог быть Вам доступен, так как Вы были подключены к внутренней сети. VPN не требуется или не используется при подключении к внутренней сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Interná stránka bola dosiahnuteľná, môže to však byť dôsledkom toho, že ste pravdepodobne pripojení k internej sieti. V internej sieti VPN nie je potrebné a nepoužíva sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notranje spletno mesto je bilo dosegljivo, vendar je to tega morda prišlo zato, ker je videti, da ste v notranjem omrežju. VPN se ne zahteva ali uporablja, kadar ste v notranjem omrežju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick att nå den interna webbplatsen men det kan bero på att du verkar vara ansluten till ett internt nätverk. VPN behövs inte och används inte när du är ansluten till ett internt nätverk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคยเข้าถึงเว็บไซต์ภายในได้แต่อาจเป็นเพราะว่าคุณอยู่บนเครือข่ายภายใน ซึ่งไม่จำเป็นต้องใช้ VPN เมื่ออยู่บนเครือข่ายภายใน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahili siteye erişilebilir görünüyordu ama bu, dahili bir ağa bağlı göründüğünüz için olabilir. Dahili bir ağa bağlıyken VPN gerekli değildir ve kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внутрішній сайт був досяжним, та це може бути через те, що ви перебуваєте у внутрішній мережі. У внутрішній мережі сервіс VPN не потрібний і не використовується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể kết nối vào trang web nội bộ, nhưng có thể là do thiết bị của bạn dường như được kết nối vào mạng nội bộ. VPN không cần thiết hoặc không được sử dụng khi kết nối vào mạng nội bộ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "内部站点之前可访问，可能因为你使用了内部网络。内部网络无需使用或不使用VPN。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可連接內部網頁可能是因為你連接了內部網絡。使用內部網絡時無需（或不使用）VPN。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "內部網站之所以可以連接可能是因為你連接了內部網路。連接內部網路時不需要也不會使用VPN。"
          }
        }
      }
    },
