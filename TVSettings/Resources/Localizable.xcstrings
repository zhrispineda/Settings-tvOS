    "AccountsTapToSetupErrorMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك بالشبكة وحاول مرة أخرى. إذا استمرت المشكلة، فاتصل بدعم Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova la connexió de xarxa i torna‑ho a provar. Si el problema es manté, posa’t en contacte amb el servei de suport d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte připojení k síti a zkuste to znovu. Pokud problém přetrvává, obraťte se na zákaznickou podporu společnosti Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller din netværksforbindelse, og prøv igen. Hvis problemet fortsætter, skal du kontakte Apple-support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Netzwerkverbindung und versuche es erneut. Sollte das Problem weiterhin bestehen, wende dich an den Apple-Support."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τη σύνδεση δικτύου σας και δοκιμάστε ξανά. Αν το πρόβλημα παραμένει, επικοινωνήστε με την Υποστήριξη Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network connection and try again. If the problem persists, contact Apple Support."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network connection and try again. If the problem persists, contact Apple Support."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network connection and try again. If the problem persists, contact Apple Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión de red e inténtalo de nuevo. Si el problema persiste, ponte en contacto con el servicio de soporte de Apple."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu conexión de red y reintenta. Si el problema persiste, comunícate con el soporte técnico de Apple."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu conexión de red y reintenta. Si el problema persiste, comunícate con el soporte técnico de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista verkkoyhteytesi ja yritä uudelleen. Jos ongelma jatkuu, ota yhteys Applen tukeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion réseau et réessayez. Si le problème persiste, contactez l’assistance Apple."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion réseau, puis réessayez. Si le problème persiste, contactez l’assistance Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נא לבדוק את חיבור הרשת ולנסות שוב. אם הבעיה נמשכת, יש ליצור קשר עם התמיכה של Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने नेटवर्क कनेक्शन की जाँच करके फिर कोशिश करें। यदि समस्या बनी रहती है, तो Apple सहायता से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite mrežnu vezu i pokušajte ponovno. Ako problem i dalje bude prisutan, obratite se Appleovoj podršci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze a hálózati kapcsolatot, és próbálja újra. Ha a probléma továbbra is fennáll, forduljon az Apple-támogatáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa koneksi jaringan Anda dan coba lagi. Jika masalah berlanjut, hubungi Dukungan Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la connessione di rete e riprova. Se il problema persiste, contatta il supporto Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続を確認してやり直してください。問題が解決しない場合は、Appleサポートに問い合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결을 확인하고 다시 시도하십시오. 문제가 계속 발생하면 Apple 지원팀에 문의하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa sambungan rangkaian anda dan cuba lagi. Jika masalah berterusan, hubungi Sokongan Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller nettverksforbindelsen og prøv igjen. Kontakt Apple-kundestøtten hvis problemet vedvarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de netwerkverbinding en probeer het opnieuw. Neem contact op met Apple Support als het probleem zich blijft voordoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie sieciowe i spróbuj jeszcze raz. Jeżeli problem będzie się powtarzał, skontaktuj się ze wsparciem Apple."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão à rede e tente novamente. Se o problema persistir, contate o Suporte da Apple."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ligação à rede e volte a tentar. Se o problema persistir, contacte o Suporte Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați conexiunea de rețea și reîncercați. Dacă problema persistă, contactați asistența Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте интернет‑подключение и повторите попытку. Если проблему устранить не удалось, обратитесь в службу поддержки Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte svoje pripojenie k sieti a skúste to znovu. Ak problém pretrváva, kontaktuje podporu Apple."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite omrežno povezavo in poskusite znova. Če težava ni odpravljena, se obrnite na tehnično podporo družbe Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera nätverksanslutningen och försök igen. Om problemet kvarstår kontaktar du Apple Support."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเชื่อมต่อกับเครือข่ายของคุณแล้วลองอีกครั้ง ถ้ายังเกิดปัญหาอยู่ ให้ติดต่อบริการช่วยเหลือของ Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ bağlantınızı denetleyin ve yeniden deneyin. Sorun sürerse, Apple Destek’e danışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте зʼєднання з мережею та спробуйте ще раз. Якщо проблема не зникне, зверніться до Служби підтримки Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra kết nối mạng của bạn và thử lại. Nếu sự cố vẫn tiếp diễn, hãy liên hệ với bộ phận Hỗ trợ của Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接并重试。如果问题仍然存在，请联系Apple支持。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網絡連線後再試一次。如果問題持續，請聯絡「Apple支援」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查你的網路連線然後重試一次。若問題依然存在，請聯絡「Apple支援」。"
          }
        }
      }
    },
