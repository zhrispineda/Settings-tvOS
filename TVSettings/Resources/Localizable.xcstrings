          }
        },
        "ru": {
          "stringUnit": {
            "value": "Настройка переопределений для тестирования приложений, использующих управляемый фоновый медиаконтент.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Umožňuje nakonfigurovať výnimky pre testovanie apiek, ktoré používajú spravované prostriedky na pozadí.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Konfigurirajte preglasitve za preizkušanje aplikacij, ki uporabljajo upravljana sredstva v ozadju.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Konfigurera åsidosättningar för att testa appar som använder hanterade bakgrundsresurser.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "กำหนดค่าการเขียนทับสำหรับทดสอบแอปที่ใช้ส่วนประกอบอยู่เบื้องหลังที่มีการจัดการ",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Yönetilen arka plan öğelerini kullanan test uygulamaları için geçersiz kılmaları ayarlayın.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Конфігурація заміщень для тестування програм, що використовують керовані фонові медіаматеріали.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Định cấu hình mục thay thế cho các ứng dụng thử nghiệm có sử dụng Tài nguyên trong nền được quản lý.",
            "state": "translated"
          }
        },
        "zh_CN": {
