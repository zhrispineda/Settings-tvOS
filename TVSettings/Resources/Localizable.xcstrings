        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите удалить тестовую учетную запись %@ с этого Apple TV?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete z tohto Apple TV odstrániť sandbox účet %@?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste prepričani, da želite odstraniti račun Sandbox %@ iz tega Apple TV-ja?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort sandbox-kontot %@ från denna Apple TV?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าคุณต้องการเอาบัญชี Sandbox %@ ออกจาก Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sandbox hesabını bu Apple TV’den silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справді вилучити обліковий запис пісочниці %@ з цього Apple TV?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa tài khoản Sandbox %@ khỏi Apple TV này không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要将沙盒账户“%@”从这台Apple TV上移除吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要移除此Apple TV上的Sandbox帳户%@嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
