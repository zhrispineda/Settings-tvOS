    "SystemPairingsUnpairInstructions": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إلغاء حفظ جهاز، لن يعود بإمكانك استخدامه مع هذا الـ Apple TV.\n\nلمزيد من المعلومات، يرجى مراجعة:\nsupport.apple.com/appletv/remote"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si omets un dispositiu, ja no podràs utilitzar‑lo amb l’Apple TV.\n\nPer obtenir més informació, visita support.apple.com/appletv/remote."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když zrušíte spárování, zařízení už nebude možné s Apple TV používat.\n\nDalší informace najdete na stránce support.apple.com/appletv/remote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vælger at glemme en enhed, kan du ikke længere bruge den med Apple TV.\n\nDer er flere oplysninger på support.apple.com/appletv/remote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ein Gerät ignoriert, kann es nicht mehr mit diesem Apple TV benutzt werden.\n\nWeitere Informationen sind unter support.apple.com/appletv/remote erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν επιλέξετε αγνόηση μιας συσκευής, δεν θα μπορείτε πλέον να τη χρησιμοποιείτε με αυτό το Apple TV.\n\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση support.apple.com/appletv/remote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you forget a device, you’ll no longer be able to use it with this Apple TV.\n\nFor more information see support.apple.com/appletv/remote."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "When you forget a device, you’ll no longer be able to use it with this Apple TV.\n\nFor more information, see support.apple.com/appletv/remote"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you forget a device, you’ll no longer be able to use it with this Apple TV.\n\nFor more information see support.apple.com/appletv/remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al omitir un dispositivo, no podrás seguir utilizándolo con este Apple TV.\n\nPara más información, visita support.apple.com/appletv/remote."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si olvidas un dispositivo, ya no lo podrás usar con este Apple TV.\n\nObtén más detalles en support.apple.com/appletv/remote."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si olvidas un dispositivo, ya no lo podrás usar con este Apple TV.\n\nObtén más detalles en support.apple.com/appletv/remote."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun laite unohdetaan, et voi enää käyttää sitä tämän Apple TV:n kanssa.\n\nLisätietoja löytyy osoitteesta support.apple.com/appletv/remote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous oubliez un appareil, vous ne pourrez plus l’utiliser avec cette Apple TV.\n\nPour en savoir plus, accédez à support.apple.com/appletv/remote."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous oubliez un appareil, celui-ci ne peut plus être utilisé avec cette Apple TV.\n\nPour obtenir plus d’informations, rendez-vous sur support.apple.com/appletv/remote."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר שמכשיר כלשהו מוסר, לא ניתן עוד להשתמש בו עם ה-Apple TV.\n\nפרטים נוספים זמינים בכתובת: support.apple.com/appletv/remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी डिवाइस को याद नहीं रखते हैं, तो आप इस Apple TV के साथ उसका इस्तेमाल नहीं कर पाएँगे।\n\nअधिक जानकारी के लिए support.apple.com/appletv/remote देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad “zaboravite” uređaj, više ga nećete moći koristiti s ovim Apple TV-om.\n\nZa dodatne informacije pogledajte support.apple.com/appletv/remote."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy eszköz elfelejtését választja, akkor nem fogja tudni használni ezzel az Apple TV-vel.\n\nBővebben: support.apple.com/hu/appletv/remote."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda melupakan perangkat, Anda tidak akan lagi dapat menggunakannya dengan Apple TV ini.\n\nUntuk informasi lainnya, lihat support.apple.com/id/appletv/remote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver dissociato un dispositivo, non potrai più utilizzarlo con Apple TV.\n\nPer ulteriori informazioni, consulta la pagina support.apple.com/it/appletv/remote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの登録を解除すると、デバイスはこのApple TVで使用できなくなります。\n\n詳しくは、support.apple.com/jp/appletv/remote を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 지우면 더 이상 이 Apple TV와 함께 사용할 수 없습니다.\n\n자세한 사항은 support.apple.com/appletv/remote 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda melupakan peranti, anda tidak lagi akan dapat menggunakannya dengan Apple TV ini.\n\nUntuk mendapatkan maklumat lanjut, lihat support.apple.com/en-my/HT201664."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du glemmer en enhet, vil den ikke lenger være tilgjengelig for Apple TV.\n\nFinn ut mer på support.apple.com/appletv/remote."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een apparaat vergeet, kun je het niet meer gebruiken met deze Apple TV.\n\nGa voor meer informatie naar support.apple.com/appletv/remote."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zapomnisz urządzenie, nie będzie można go używać z tym Apple TV.\n\nWięcej informacji możesz znaleźć na stronie support.apple.com/pl-pl/HT201664."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você esquece um dispositivo, não pode mais usá‑lo com esta Apple TV.\n\nPara saber mais, acesse support.apple.com/appletv/remote."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando opta por esquecer um dispositivo, deixará de o poder usar com esta Apple TV.\n\nEncontrará informação adicional em support.apple.com/appletv/remote."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce ignorați un dispozitiv, nu îl veți mai putea utiliza cu acest Apple TV.\n\nPentru mai multe informații, consultați support.apple.com/appletv/remote."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только устройство будет забыто, Вы не сможете использовать его с этим Apple TV.\n\nПодробнее на сайте support.apple.com/ru-ru/appletv/remote."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenie po odstránení nebude možné používať s týmto Apple TV.\n\nViac informácií nájdete na stránke support.apple.com/sk/appletv/remote."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko prekličete seznanitev naprave, je ne boste mogli več uporabljati s tem Apple TV-jem.\n\nZa več informacij preverite support.apple.com/appletv/remote."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du tar bort parkopplingen till en enhet kan du inte längre använda den med denna Apple TV.\n\nMer information finns på support.apple.com/appletv/remote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณลบอุปกรณ์ อุปกรณ์จะไม่ถูกจับคู่กับ Apple TV เครื่องนี้อีกต่อไป\n\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่ support.apple.com/appletv/remote"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıtı unuttuğunuzda onu artık bu Apple TV ile kullanamazsınız.\n\nDaha fazla bilgi için support.apple.com/appletv/remote adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо забути пристрій, ним не можна буде користуватися із цим Apple TV.\n\nДодаткову інформацію наведено на вебсторінці support.apple.com/appletv/remote."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi quên một thiết bị, bạn sẽ không thể sử dụng thiết bị đó với Apple TV này nữa.\n\nĐể biết thêm thông tin, hãy xem support.apple.com/appletv/remote."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略设备后，你将无法再配合Apple TV使用它。\n\n更多信息请访问support.apple.com/appletv/remote。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當你忘記裝置時，你便不能再將裝置與此Apple TV配合使用。\n\n詳情請瀏覽support.apple.com/zh-hk/HT201664。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "忘記裝置設定時，你將無法再與此Apple TV搭配使用。\n\n如需更多資訊，請參閱：support.apple.com/appletv/remote。"
          }
        }
      }
    },
