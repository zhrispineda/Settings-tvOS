    "AVNativeModeSwitchingFormatToMatchVideoDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستخدم Apple TV تنسيق العرض المحدد لديك لتشغيل المحتوى دون تعديل. يمكن لـ Apple TV أيضًا تبديل التنسيقات تلقائيًا لتتوافق مع النطاق الديناميكي ومعدل إطارات المحتوى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilitzarà el format de pantalla que has seleccionat per reproduir el contingut sense alteracions. També pot canviar de format automàticament per adequar‑se al rang dinàmic i a la freqüència de fotogrames del contingut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude přehrávat obsah beze změn v obrazovém formátu, který jste vybrali. Formát se také může přepínat automaticky podle dynamického rozsahu a snímkové frekvence obrazového signálu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bruger det valgte skærmformat, så indhold afspilles uden ændringer. Apple TV kan også ændre formatet automatisk, så det matcher indholdets billedfrekvens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV verwendet das gewählte Anzeigeformat, um Inhalte ohne Änderungen zu übertragen. Apple TV kann auch automatisch Formate wechseln, sodass sie dem Dynamikbereich und der Bildrate des Inhalts entsprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα χρησιμοποιεί την επιλεγμένη μορφή οθόνης για αναπαραγωγή περιεχομένου χωρίς μεταβολή. Το Apple TV μπορεί επίσης να αλλάζει αυτόματα τη μορφή ώστε να αντιστοιχεί στο δυναμικό εύρος και στον ρυθμό καρέ του περιεχομένου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will use your selected display format to play content without alteration. Apple TV can also switch formats automatically to match the dynamic range and frame rate of the content."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will use your selected display format to play content without alteration. Apple TV can also switch formats automatically to match the dynamic range and frame rate of the content."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will use your selected display format to play content without alteration. Apple TV can also switch formats automatically to match the dynamic range and frame rate of the content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV usará el formato de visualización que tenías seleccionado para reproducir contenido sin modificarlo. El Apple TV también puede cambiar el formato automáticamente para ajustarlo al rango dinámico y a la frecuencia de fotogramas del contenido."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV usará el formato de pantalla que seleccionaste para reproducir el contenido sin alterarlo. El Apple TV también puede cambiar el formato automáticamente para ajustarlo al rango dinámico y la frecuencia de fotogramas del contenido."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV usará el formato de pantalla que seleccionaste para reproducir el contenido sin alterarlo. El Apple TV también puede cambiar el formato automáticamente para ajustarlo al rango dinámico y la frecuencia de fotogramas del contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV käyttää valitsemaasi näyttötilaa sisällön toistamiseen ilman muutoksia. Apple TV voi myös muuttaa näyttötilan automaattisesti sisällön dynaamisen alueen ja kuvataajuuden mukaiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilisera le format d’affichage sélectionné pour le visionnage du contenu sans altération. L’Apple TV peut également adapter automatiquement le format à la plage dynamique et à la fréquence d’images du contenu."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilisera le format d’affichage que vous avez sélectionné pour visionner les contenus sans les modifier. Elle peut également modifier automatiquement les formats pour correspondre à la gamme dynamique et à la fréquence d’images du contenu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישתמש בפורמט התצוגה שבחרת כדי להפעיל תוכן ללא שינויים באיכות. ה-Apple TV יכול גם לעבור בין פורמטים באופן אוטומטי כדי להתאים אותם לטווח הדינמי ולקצב הפריימים של התוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना बदलाव के कॉन्टेंट चलाने के लिए Apple TV आपके चयनित डिस्प्ले फ़ॉर्मैट का उपयोग करेगा। कॉन्टेंट की डाइनैमिक रेंज और फ़्रेम दर से मिलान करने के लिए Apple TV ऑटोमैटिकली फ़ॉर्मैट भी स्विच कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV koristit će format slike koji ste odabrali za reproduciranje sadržaja bez izmjena. Apple TV također može automatski prebaciti format u skladu s brzinom sličica sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tartalmak változtatás nélküli megjelenítéséhez az Apple TV az Ön által kiválasztott megjelenítési formátumot fogja használni. Az Apple TV ezenkívül automatikusan át tudja állítani a formátumokat a tartalmak dinamikatartománya és képkockasebessége szerint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan menggunakan format tampilan yang Anda pilih untuk memutar konten tanpa perubahan. Apple TV juga dapat mengalihkan format secara otomatis agar cocok dengan rentang dinamis dan laju bingkai konten tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV utilizzerà il formato di visualizzazione che hai selezionato per riprodurre contenuti senza apportare modifiche. Apple TV potrà inoltre passare automaticamente da un formato all’altro, a seconda dell’intervallo dinamico e della frequenza dei fotogrammi del contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVは、選択したディスプレイフォーマットを使用してコンテンツをそのまま再生します。また、ダイナミックレンジおよびコンテンツのフレームレートに合うように自動的にフォーマットを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 없이 콘텐츠를 재생하기 위해 Apple TV가 사용자가 선택한 디스플레이 포맷을 사용합니다. 또한, Apple TV가 콘텐츠의 다이내믹 레인지 및 프레임률에 맞게 자동으로 포맷을 변경할 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan menggunakan format paparan yang anda pilih untuk memainkan kandungan tanpa perubahan. Apple TV juga boleh mengubah format secara automatik supaya sepadan dengan julat dinamik dan kadar bingkai kandungan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bruker det valgte skjermformatet ditt til å spille av innhold uten endringer. Apple TV kan også bytte format automatisk for å tilpasse det til bildefrekvensen og det dynamiske området i innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV gebruikt je geselecteerde beeldschermstructuur om materiaal ongewijzigd af te spelen. Apple TV kan ook automatisch van structuur wisselen, zodat deze bij het dynamische bereik en de beeldsnelheid van het materiaal past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie używać wybranego formatu obrazu do odtwarzania zawartości bez zmian. Może również automatycznie przełączać formaty, aby były zgodne z zakresem tonalnym i częstotliwością klatek zawartości."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usará o formato de tela selecionado para reproduzir conteúdo sem alterações. A Apple TV também pode alternar os formatos automaticamente para corresponder ao alcance dinâmico e à taxa de atualização do conteúdo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usará o formato de ecrã selecionado para reproduzir conteúdo sem alterações. É também possível mudar o formato automaticamente para igualar a taxa de fotogramas do conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va utiliza formatul de afișare selectat pentru a reda conținutul fără alterare. De asemenea, Apple TV‑ul poate comuta automat formatele pentru a se adapta la gama dinamică și la frecvența de cadre a conținutului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV будет воспроизводить контент в выбранном формате без изменения. Apple TV также может переключать форматы автоматически для согласования динамического диапазона и частоты кадров контента."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV použije vybraný formát na prehranie obsahu bez akýchkoľvek úprav. Môžete však nastaviť automatické prepínanie formátu a jeho prispôsobenie dynamickému rozsahu a frekvencii snímok obsahu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo za predvajanje vsebine uporabil izbrano obliko prikaza in je ne bo spreminjal. Apple TV lahko tudi samodejno preklopi na drugo obliko zapisa, da bo usklajena z dinamičnim razponom in hitrostjo sličic vsebine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV använder visningsformatet som du har valt till att spela upp innehåll utan någon förändring. Apple TV kan även byta format automatiskt så att innehållets dynamiska omfång och bildfrekvens matchas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะใช้รูปแบบการแสดงผลที่คุณเลือกเพื่อเล่นเนื้อหาโดยไม่เปลี่ยนแปลง Apple TV ยังสามารถเปลี่ยนรูปแบบโดยอัตโนมัติเพื่อให้ตรงกับช่วงแสงกว้างและอัตราเฟรมของเนื้อหาได้อีกด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, değişiklik yapmadan içeriği oynatmak için seçtiğiniz görüntüleme biçimini kullanır. Apple TV ayrıca içeriğin kare hızı ile eşlemek için biçimler arasında otomatik olarak geçiş de yapabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV використовуватиме вибраний вами формат відображення, щоб відтворювати вміст без змін. Apple TV також може автоматично перемикати формати для узгодження частоти кадрів вмісту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ sử dụng định dạng màn hình được chọn của bạn để phát nội dung mà không sửa đổi. Apple TV cũng có thể tự động chuyển đổi định dạng để phù hợp với dải tần nhạy sáng và tốc độ khung hình của nội dung."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将不作更改而直接使用你选择的显示格式播放内容。Apple TV还可自动切换格式以匹配内容的动态范围和帧速率。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV將會使用你所選的顯示格式，在不經修改下播放內容。Apple TV亦會自動切換格式以符合動態範圍和內容的格率。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會使用你所選的顯示格式，並在不經修改的情況下播放內容，或是自動切換格式來符合內容的動態範圍和影格率。"
          }
        }
      }
    },
