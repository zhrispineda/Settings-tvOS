    "GraphicsHUDGroupDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تظهر تقنية HUD لأداء الغرافيكس معدل الإطارات، وزمن GPU، واستخدام الذاكرة، ويمكنها تسجيل بيانات الأداء لتحليلها لاحقًا.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "L’indicador en pantalla del rendiment dels gràfics mostra la freqüència de fotogrames, el temps de GPU i l’ús de memòria, i pot registrar les dades del rendiment per analitzar‑les posteriorment.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "HUD výkonu grafiky zobrazuje snímkovou frekvenci, čas GPU a využití paměti a může zaznamenávat údaje o výkonu pro pozdější analýzu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Grafikydeevne-HUD viser billedfrekvens, GPU-tid og hukommelsesforbrug og kan registrere ydeevnedata til analyse på et senere tidspunkt.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Die Schwebepalette für Grafikleistung zeigt Bildrate, GPU-Zeit und Speichernutzung an. Sie kann zudem Leistungsdaten für spätere Analysen protokollieren.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Το HUD απόδοσης γραφικών εμφανίζει τον ρυθμό καρέ, τον χρόνο GPU και τη χρήση μνήμης, και μπορεί να καταγράφει δεδομένα απόδοσης για μεταγενέστερες αναλύσεις.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "The graphics performance HUD shows framerate, GPU time, and memory usage, and can log performance data for later analysis.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "The graphics performance HUD shows frame rate, GPU time and memory usage, and can log performance data for later analysis.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "The graphics performance HUD shows framerate, GPU time, and memory usage, and can log performance data for later analysis.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "The graphics performance HUD shows frame rate, GPU time and memory usage, and can log performance data for later analysis.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El HUD del rendimiento de gráficos muestra la frecuencia de fotogramas, el tiempo de la GPU y el uso de la memoria, y puede registrar los datos de rendimiento para su análisis posterior.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El HUD del rendimiento de los gráficos muestra la frecuencia de cuadros, el tiempo de la GPU y el uso de la memoria, y puede registrar datos de rendimiento para su análisis posterior.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Grafiikan suorituskykyvisiiri näyttää kuvataajuuden, GPU-ajan ja muistin käytön sekä voi kirjata suorituskykytietoja lokiin myöhempää analyysia varten.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "La palette des performances graphiques indique la fréquence d’images, le temps du GPU et l’utilisation de la mémoire. Elle permet également d’enregistrer les données de performances en vue d’une analyse ultérieure.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "L’ATH de performance graphique affiche la fréquence d’images, le temps de traitement graphique ainsi que l’utilisation de la mémoire et peut enregistrer des données de performance aux fins d’analyse.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ביצועי גרפיקה במצב HUD מציגים קצב פריימים, זמן GPU ושימוש בזיכרון, ויכולים ליצור דו״חות עם נתוני ביצועים שניתן יהיה לנתח בהמשך.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "ग्राफ़िक्स कार्यक्षमता HUD फ़्रेमरेट, GPU टाइम और मेमोरी उपयोग प्रदर्शित करता है और कार्यक्षमता डेटा को बाद में विश्लेषण के लिए लॉग कर सकता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "HUD izvedba grafike prikazuje brzinu sličica, vrijeme GPU-a i uporabu memorije te može zabilježiti podatke o performansama radi kasnije analize.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A grafikai teljesítmény HUD-ja megjeleníti a képkockasebességet, a GPU órajelét és a memóriahasználatot, valamint képes teljesítményadatokat naplózni a későbbi elemzés céljából.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "HUD kinerja grafis menampilkan laju bingkai, waktu GPU, penggunaan memori, dan dapat mencatat data kinerja untuk dianalisis di kemudian waktu.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "L’HUD per le prestazioni della grafica mostra la frequenza dei fotogrammi, il tempo GPU e l’utilizzo di memoria. Può anche registrare i dati delle prestazioni per analisi successive.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "グラフィックスパフォーマンスのHUDは、フレームレート、GPU時間、およびメモリ使用状況を表示し、あとで解析するためにパフォーマンスデータを記録できます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "그래픽 성능 HUD는 프레임률, GPU 시간 및 메모리 사용을 보여주고, 이후 분석을 위해 성능 데이터를 기록할 수 있습니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "HUD prestasi grafik menunjukkan kadar bingkai, masa GPU dan penggunaan memori dan boleh mengelog data prestasi untuk dianalisis kemudian.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "De HUD voor grafische prestaties toont de beeldsnelheid, de GPU-tijd en het geheugengebruik, en kan prestatiegegevens vastleggen voor latere analyse.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Grafikkytelsesoverlegget viser bildefrekvens, GPU-tid og minnebruk, og kan loggføre ytelsesdata for senere analyse.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "HUD wydajności grafiki pokazuje częstotliwość klatek, czas GPU i użycie pamięci oraz może rejestrować dane wydajności do dalszej analizy.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "A HUD para desempenho gráfico mostra a taxa de quadro, tempo de GPU e uso de memória, além de poder registrar dados de desempenho para futura análise.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "O HUD de desempenho gráfico mostra a taxa de fotogramas, tempo da GPU e utilização de memória, e pode registar dados de desempenho para análise posterior.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Panoul de comenzi pentru performanța grafică afișează frecvența de cadre, timpul GPU și utilizarea memoriei și poate înregistra datele de performanță pentru a fi analizate ulterior.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Панель мониторинга графики показывает частоту кадров, время работы графического процессора и использование памяти, а также может вести журнал производительности для последующего анализа.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "HUD grafického výkonu zobrazuje rýchlosť snímok, čas GPU a využitie pamäte a môže zaznamenávať dáta týkajúce sa výkonu na ďalšiu analýzu.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "HUD za učinkovitost grafike prikazuje hitrost sličic, čas GPE in uporabo pomnilnika ter lahko beleži podatke o učinkovitosti za poznejšo analizo.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Grafikprestandaöverlägget visar bildhastighet, GPU-tid och minnesanvändning och kan logga prestandadata för senare analys.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ประสิทธิภาพกราฟิกของ HUD จะแสดงอัตราเฟรม, เวลา GPU และปริมาณหน่วยความจำที่ใช้ และสามารถบันทึกข้อมูลประสิทธิภาพเพื่อใช้วิเคราะห์ในภายหลังได้",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Grafik performansı HUD kare hızını, GPU süresini ve bellek kullanımını gösterir, ayrıca daha sonra analiz edilmesi için performans verilerinin günlüğünü de tutabilir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Інформаційна панель для графіки показує частоту кадрів, час графічного процесора та дані про використання памʼяті й може створювати журнали даних про продуктивність для подальшого аналізу.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "HUD hiệu năng đồ họa cho biết tốc độ khung hình, thời gian GPU và mức sử dụng bộ nhớ, đồng thời có thể ghi nhật ký dữ liệu hiệu năng để phân tích sau này.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
