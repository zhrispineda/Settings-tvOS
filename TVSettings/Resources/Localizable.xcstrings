    "iCloudPhotoDefaultUserAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاختيار شاشة التوقف هذه، يرجى إضافة ملف تعريف افتراضي في \"ملفات التعريف والحسابات\". ثم تسجيل الدخول إلى صور iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per seleccionar aquest estalvi de pantalla, afegeix un perfil per omissió a la secció de perfils i comptes i, després, inicia la sessió a les fotos a l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li vybrat  tento spořič obrazovky, přidejte v oddílu Profily a účty výchozí profil. Pak se přihlaste ke službě Fotky na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal tilføje en standardprofil i Profiler og konti for at vælge denne skærmskåner. Log derefter ind på iCloud-fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diesen Bildschirmschoner auszuwählen, füge in „Profile und Accounts“ einen Standardprofil hinzu. Melde dich anschließend bei „iCloud-Fotos“ an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για επιλογή αυτής της προφύλαξης οθόνης, προσθέστε ένα προεπιλεγμένο προφίλ στο τμήμα «Προφίλ και λογαριασμοί». Στη συνέχεια, συνδεθείτε στις Φωτογραφίες iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To choose this screen saver, add a default profile in Profiles and Accounts. Then sign in to iCloud Photos."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To choose this screen saver, add a default profile in Profiles and Accounts. Then sign in to iCloud Photos."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To choose this screen saver, add a default profile in Profiles and Accounts. Then sign in to iCloud Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seleccionar este salvapantallas, añade un perfil por omisión en “Perfiles y cuentas”. A continuación, inicia sesión en Fotos en iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para elegir este protector de pantalla, agrega un usuario predeterminado en Perfiles y cuentas. Después, inicia sesión en Fotos en iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para elegir este protector de pantalla, agrega un usuario predeterminado en Perfiles y cuentas. Después, inicia sesión en Fotos en iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat valita tämän näytönsäästäjän, lisää oletusprofiili Profiilit ja tilit -asetuksissa. Kirjaudu sitten sisään iCloud-kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour sélectionner cet économiseur d’écran, ajoutez un profil par défaut dans « Profils et comptes », puis connectez-vous à Photos iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour choisir cet économiseur d’écran, ajoutez un profil par défaut dans Profils et comptes, puis connectez-vous à Photos iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לבחור בשומר מסך זה יש להוסיף פרופיל ברירת מחדל ב״פרופילים וחשבונות״. לאחר מכן יש להתחבר ל״תמונות iCloud״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्क्रीन सेवर चुनने के लिए “प्रोफ़ाइल और खाते” में डिफ़ॉल्ट प्रोफ़ाइल जोड़ें। फिर iCloud तस्वीर में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za odabir ove zaštite zaslona dodajte standardni profil u Profile i račune. Zatim se prijavite u iCloud fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a képernyővédőnek a kiválasztásához adjon hozzá egy alapértelmezett profilt a Profilok és fiókok menüpontban. Ezután jelentkezzen be az iCloud-fotókba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memilih penghemat layar ini, tambahkan profil default di Profil dan Akun. Lalu masuk ke Foto iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scegliere questo salvaschermo, aggiungi un profilo di default in “Profili e account”, quindi accedi a “Foto di iCloud”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスクリーンセーバを選択するには、“プロフィールとアカウント”でデフォルトプロフィールを追加してください。次に、iCloud写真にサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면 보호기를 선택하려면 ‘프로필 및 계정’에서 기본 프로필을 추가하십시오. 그런 다음 iCloud 사진에 로그인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memilih penyelamat skrin ini, tambahkan profil lalai dalam Profil dan Akaun. Kemudian daftar masuk ke Foto iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må legge til en standardprofil i Profiler og kontoer for å velge denne skjermspareren. Logg deretter på iCloud Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om deze schermbeveiliging te kiezen, voeg je een standaardprofiel toe in 'Profielen en accounts'. Vervolgens log je in bij iCloud-foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wybrać ten wygaszacz, dodaj profil domyślny na ekranie Profile i konta. Następnie zaloguj się w Zdjęciach w iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escolher este protetor de tela, adicione um perfil padrão no ajuste Usuários e Contas. Em seguida, inicie a sessão nas Fotos do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escolher esta proteção de ecrã, adicione um perfil predefinido em Perfis e contas. Depois, inicie sessão em Fotografias em iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a alege acest screensaver, adăugați un profil implicit în „Profiluri și conturi”. Apoi, autentificați‑vă în Poze iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выбрать этот тип заставки, добавьте профиль по умолчанию в разделе «Профили и учетные записи». Затем выполните вход в Фото iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete vybrať tento šetrič obrazovky, v časti Profily a účty pridajte predvolený profil. Potom sa prihláste do iCloud Fotiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite izbrati ta ohranjevalnik zaslona, dodajte privzeti profil v razdelku Profili in računi. Nato se vpišite v Fotografije iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en förvald profil i Profiler och konton om du vill välja den här skärmsläckaren. Logga sedan in till iCloud-bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการเลือกภาพพักหน้าจอนี้ ให้เพิ่มโปรไฟล์เริ่มต้นในโปรไฟล์และบัญชี จากนั้นลงชื่อเข้า “รูปภาพบน iCloud”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran koruyucuyu seçmek için Profiller ve Hesaplar’da saptanmış bir profil ekleyin. Sonra iCloud Fotoğrafları’na giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб обрати цю екранну заставку, додайте типовий профіль у розділі «Профілі й облікові записи». Потім увійдіть у Фото iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chọn trình bảo vệ màn hình này, hãy thêm một hồ sơ mặc định trong Hồ sơ và Tài khoản. Sau đó, đăng nhập vào Ảnh iCloud."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要选取此屏幕保护程序，请在“个人资料和账户”中添加默认个人资料。然后登录iCloud照片。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要選擇此螢幕保護程式，請在「個人檔案和帳户」中加入預設個人檔案。然後登入「iCloud相片」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要選擇此螢幕保護程式，請在「個人檔案和帳號」中加入預設個人檔案。接著登入「iCloud照片」。"
          }
        }
      }
    },
