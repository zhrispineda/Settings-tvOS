        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्यूलेटर पर अतिरिक्त प्रोफ़ाइल के लिए समर्थन प्रदान नहीं किया गया है। कृपया किसी Apple TV डिवाइस का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni profili nisu podržani na simulatoru. Upotrijebite uređaj Apple TV."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "További profilok nem támogatottak a szimulátoron. Kérjük, használjon egy Apple TV-eszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil tambahan tidak didukung di simulator. Gunakan perangkat Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il simulatore non supporta altri profili. Utilizza un’Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータではプロフィールの追加には対応していません。Apple TVデバイスを使用してください。"
