        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdemkněte iPhone nebo iPad uživatele %@.\n2.\tPřipojte se k WLAN síti.\n3.\tZapněte Bluetooth.\n4.\tPodržte zařízení u Apple TV."
