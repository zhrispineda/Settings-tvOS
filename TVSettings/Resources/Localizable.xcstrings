    "SaverBackdropSourceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار كل الذكريات أو المميزة كمفضلة فقط. يتم تحديث الذكريات مرة واحدة في اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tots els records o només els que hagis afegit als favorits. Els records s’actualitzen un cop al dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje všechny nebo jen oblíbené vzpomínky. Vzpomínky se aktualizují jednou za den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis alle minder eller kun dem, der er markeret som favoritter. Minder opdateres en gang om dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende alle Rückblicke ein oder nur die als Favorit markierten. Rückblicke werden einmal pro Tag aktualisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση όλων των αναμνήσεων ή μόνο αυτών που έχουν σημανθεί ως Αγαπημένες. Οι αναμνήσεις ενημερώνονται μία φορά την ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories or just the ones marked as Favorites. Memories are updated once a day."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories or just the ones marked as Favourites. Memories are updated once a day."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories or just the ones marked as Favourites. Memories are updated once a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o solo los que hayas marcado como favoritos. Los recuerdos se actualizan una vez al día."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o sólo aquellos que marcaste como favoritos. Los recuerdos se actualizan una vez al día."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o sólo aquellos que marcaste como favoritos. Los recuerdos se actualizan una vez al día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä kaikki muistot tai vain suosikiksi merkityt muistot. Muistot päivitetään kerran päivässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez tous les souvenirs ou uniquement les souvenirs préférés. Les souvenirs sont mis à jour quotidiennement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez tous les souvenirs ou uniquement les favoris. Les souvenirs sont mis à jour une fois par jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג את הזיכרונות או רק אלה שמסומנים כמועדפים. הזיכרונות מתעדכנים פעם ביום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी यादें या केवल पसंदीदा के रूप में चिह्नित यादें दिखाएँ। यादें दिन में एक बार अपडेट की जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikažite sve uspomene ili samo one koje ste označili kao omiljene. Uspomene se ažuriraju jedanput dnevno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenítheti az összes vagy csak a kedvencnek jelölt emlékeket. Az emlékek naponta egyszer frissülnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan semua Memori atau hanya yang ditandai sebagai Favorit. Memori diperbarui sehari sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutti i ricordi o solo quelli contrassegnati come preferiti. I ricordi vengono aggiornati una volta al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのメモリー、またはお気に入りに追加したメモリーのみを表示できます。メモリーは1日に1回アップデートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 추억을 보여주거나, 즐겨찾기로 표시한 사진만 보여줄 수 있습니다. 추억은 하루에 한 번 업데이트됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan semua Memori atau hanya yang ditandakan sebagai Kegemaran. Memori dikemas kini sekali sehari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis alle minner eller kun de som er merket som favoritter. Minner oppdateres én gang om dagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon alle terugblikken of alleen die terugblikken die als favoriet zijn gemarkeerd. Terugblikken worden eenmaal per dag bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać wszystkie lub tylko ulubione wspomnienia. Wspomnienia są uaktualniane raz dziennie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra todas as Memórias ou apenas as marcadas como Favoritas. As Memórias são atualizada uma vez por dia."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra todas as recordações ou apenas as assinaladas como favoritas. As recordações são atualizadas uma vez por dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați toate amintirile sau doar pe cele marcate drept favorite. Amintirile sunt actualizate o dată pe zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать все воспоминания или только отмеченные как избранные. Воспоминания обновляются один раз в сутки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí všetky spomienky alebo len tie, ktoré ste označili ako obľúbené. Spomienky sa aktualizujú raz denne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberete lahko prikaz vseh elementov iz Spominov ali pa samo tistih z oznako Priljubljeno. Spomini se posodobijo enkrat na dan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa alla minnen eller bara de som är favoritmarkerade. Minnen uppdateras en gång om dagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงความทรงจำทั้งหมดหรือเพียงความทรงจำที่ทำเครื่องหมายเป็นรายการโปรด อัปเดตความทรงจำวันละหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm anıları veya yalnızca favori olarak işaretlenmiş olanları gösterin. Anılar günde bir kere güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати всі спогади чи тільки ті, що позначені як улюблені. Спогади оновлюються щодня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tất cả các kỷ niệm hoặc chỉ các kỷ niệm được đánh dấu là Mục ưa thích. Kỷ niệm được cập nhật một lần mỗi ngày."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有“回忆”或者仅显示标为“个人收藏”的回忆。“回忆”每日更新一次。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示全部「回憶」或只顯示標示為「喜好項目」的「回憶」。「回憶」一日更新一次。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所有「回憶」，或只顯示有「喜好項目」標記的「回憶」。「回憶」會一天更新一次。"
          }
        }
      }
    },
    "SaverBackdropSourceDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار كل الذكريات أو اختيار الذكريات التي تظهر، وتمييز بعضها كمفضلة في تطبيق الصور. يتم تحديث الذكريات مرة واحدة في اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tots els records o, si prefereixes que només se’n mostri una selecció, ves a l’app Fotos i afegeix‑ne uns quants als favorits. Els records s’actualitzen un cop al dia."
