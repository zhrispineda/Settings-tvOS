    "AboutDiagnosticsTicketDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لبدء التشخيصات، أدخل رقم التذكرة الذي استلمته\nمن دعم Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per iniciar el diagnòstic, introdueix el número de tiquet\nque has rebut del servei de suport d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li spustit diagnostiku, zadejte číslo lístku, které jste\nobdrželi od podpory Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du starter diagnosticering ved at skrive det sagsnummer,\ndu modtog fra Apple-support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Ticketnummer ein, die du vom Apple-Support\nerhalten hast, um die Diagnose zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για έναρξη των διαγνωστικών, εισαγάγετε τον αριθμό δελτίου\nπου λάβατε από την Υποστήριξη Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start diagnostics, enter the ticket number you received\nfrom Apple Support."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To start diagnostics, enter the ticket number you received\nfrom Apple Support."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To start diagnostics, enter the ticket number you received\nfrom Apple Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar el diagnóstico, introduce el número de ticket\nque has recibido del servicio de soporte de Apple."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comenzar el diagnóstico, ingresa el número de ticket\nque recibiste del soporte técnico de Apple."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comenzar el diagnóstico, ingresa el número de ticket\nque recibiste del soporte técnico de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita vianmääritys syöttämällä Applen tuesta\nsaamasi pyynnön numero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour lancer le diagnostic, saisissez le numéro de ticket\nenvoyé par l’assistance Apple."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour démarrer Diagnostic, entrez le numéro de ticket\ncommuniqué par l’assistance Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להתחיל באבחון, יש להזין את מספר הפנייה שקיבלת\nמהתמיכה של Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायग्नॉस्टिक शुरू करने के लिए Apple सहायता से प्राप्त\nटिकट संख्या दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pokretanje dijagnostike, unesite broj naloga\nkoji ste primili od Appleove podrške."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagnosztika elindításához adja meg az Apple-támogatástól kapott jegy számát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memulai diagnostik, masukkan nomor tiket yang\nAnda terima dari Dukungan Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per iniziare la procedura di diagnosi, inserisci il numero di ticket ricevuto dal supporto Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断を開始するには、Appleサポートから通知されたチケット\n番号を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단을 시작하려면 Apple 지원팀에서 보낸\n티켓 번호를 입력하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memulakan diagnostik, masukkan nombor tiket yang anda terima\ndaripada Sokongan Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi saksnummeret du mottok fra Apple-kundestøtten for å starte diagnostikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de diagnostische test te starten, voer je het ticketnummer\nin dat je van Apple Support hebt gekregen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby rozpocząć diagnostykę, podaj numer biletu otrzymany\nod Wsparcia Apple."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar o diagnóstico, digite o número do tíquete que\nvocê recebeu do Suporte da Apple."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar o diagnóstico, digite o número de referência que lhe foi enviado pelo Suporte Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru o începe diagnoza, introduceți numărul de tichet\nprimit de la Apple Care."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать диагностику, введите номер билета,\nполученного из службы поддержки Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete spustiť diagnostiku, zadajte číslo lístka, ktoré ste\ndostali od podpory Apple."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za zagon diagnostike vnesite številko zahtevka, ki ste ga\nprejeli od tehnične podpore družbe Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja diagnosen genom att ange ärendenumret som du fick\nfrån Apples Support."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มการวินิจฉัยโดยป้อนหมายเลขตั๋วที่คุณได้รับ\nจากบริการช่วยเหลือของ Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıları başlatmak için Apple Destek tarafından gönderilen\ndestek talebi numarasını girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб почати діагностику, введіть номер звернення, отриманий\nвід Служби підтримки Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để bắt đầu chẩn đoán, nhập số phiếu mà bạn đã nhận được\ntừ bộ phận Hỗ trợ của Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入你从Apple支持收到的报告编号，以开始诊断。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要開始診斷，請輸入你從「Apple支援」接收到的票號。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要開始診斷，請輸入你從「Apple支援」收到的單據編號。"
          }
        }
      }
    },
