          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih untuk menunjukkan Filem iTunes pada skrin Utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg å vise iTunes-filmer på Hjem-skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ervoor om iTunes-films op het beginscherm weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy ikona Filmy iTunes ma być widoczna na ekranie głównym."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se os Filmes do iTunes aparecem na tela de Início."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se pretende mostrar Filmes do iTunes no ecrã principal."
