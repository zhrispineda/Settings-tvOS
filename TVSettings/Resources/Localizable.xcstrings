    "RemoteAppHomeSharingAccountDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للبدء، قم بتشغيل المشاركة المنزلية في تطبيق الريموت وعلى Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per començar, activa l’ús compartit a casa a l’app Comandament i a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li začít, zapněte v aplikaci Remote a na Apple TV funkci Domácí sdílení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer i gang ved at slå Deling i hjemme til i appen Remote og på Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Privatfreigabe in der App „Remote“ und auf dem Apple TV, um zu beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ξεκινήσετε, ενεργοποιήστε την Οικιακή κοινή χρήση στην εφαρμογή Remote και στο Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get started, turn on Home Sharing in the Remote app and on Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To get started, turn on Home Sharing in the Remote app and on Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To get started, turn on Home Sharing in the Remote app and on Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comenzar, activa “Compartir en casa” en la app Mando y en el Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comenzar, activa Compartir en casa en la app Control remoto y en el Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comenzar, activa Compartir en casa en la app Control remoto y en el Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita laittamalla Kotijako päälle Kaukosäädin-apissa ja Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour commencer, activez le partage à domicile dans l’app Remote et sur l’Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour commencer, activez le partage à domicile à partir de l’app Télécommande et de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להתחיל, יש להפעיל את ״שיתוף ביתי״ ביישום ״שלט״ וב-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए Remote ऐप में और Apple TV पर होम शेयरिंग चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za početak uključite Dijeljenje unutar doma u aplikaciji Upravljač i na Apple TV‑u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdéshez kapcsolja be az Otthoni megosztást a Remote appban és az Apple TV-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memulai, nyalakan Berbagi Rumah di app Remote dan di Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per iniziare, attiva l’opzione “In casa” nell’app Remote e su Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始するには、リモコンアプリとApple TVでホームシェアリングをオンにしててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 리모컨 앱 및 Apple TV에서 홈 공유를 켜십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bermula, aktifkan Perkongsian Rumah dalam app Remote dan pada Apple TV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med å slå på Hjemmedeling i Fjernkontroll-appen og på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel om te beginnen thuisdeling in in de app Remote en op de Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby rozpocząć, włącz Kolekcję domową w aplikacji Pilot i w Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para começar, ative o Compartilhamento Pessoal no app Remote e na Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para começar, ative a Partilha doméstica na aplicação Comando e na Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a începe, activați funcționalitatea Partajare casnică în aplicația Remote și pe Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы приступить, включите Домашнюю коллекцию в приложении «Пульт» и на Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete začať, zapnite Domáce zdieľanie v apke Ovládač a na Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za začetek vklopite možnost Souporaba doma v aplikaciji Daljinec in v Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer igång genom att aktivera Hemmadelning i appen Fjärrkontroll och på Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการเริ่มต้น ให้เปิดการแชร์ภายในพื้นที่บนแอปรีโมทและบน Apple TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için Remote uygulamasında ve Apple TV’de Ev Paylaşımı’nı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб почати, увімкніть Домашню колекцію і програму «Пульт» на Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để bắt đầu, bật Home Sharing trong ứng dụng Điều khiển từ xa và trên Apple TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要开始，请在“遥控器”App和Apple TV上打开“家庭共享”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要開始使用，請在「遙控器」App及Apple TV上開啟「家庭共享」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要開始使用，請開啟「遙控器」App和Apple TV上的「家庭共享」。"
          }
        }
      }
    },
