          "stringUnit": {
            "state": "translated",
            "value": "מאפיין זה מתאים את עוצמת השמע של מדיה בתגובה לסביבה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके परिवेश के आधार पर मीडिया का वॉल्यूम ऐडजस्ट करता है।"
          }
        },
