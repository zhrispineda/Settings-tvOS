        },
        "el": {
          "stringUnit": {
            "value": "Η ένταση ήχου πολυμέσων και κλήσεων δεν θα αλλάζει όταν το VoiceOver πραγματοποιεί εκφώνηση.",
            "state": "translated"
          }
        },
        "en": {
