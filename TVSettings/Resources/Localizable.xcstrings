    "OSUpdateIsSupervised": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Apple TV حاليًا بأحدث إصدار برامج مسموح به من المسؤول لديك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV té instal·lada l’actualització de programari més recent permesa per l’administrador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple TV je nainstalovaná nejnovější aktualizace softwaru povolená správcem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV har den nyeste softwareopdatering, der er godkendt af administratoren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV verwendet das neueste von dem:der Admin genehmigte Update."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Apple TV εκτελείται η πιο πρόσφατη ενημέρωση λογισμικού που επιτρέπει ο διαχειριστής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV is running the latest software update allowed by your administrator."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV is using the latest software update allowed by your administrator."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV is using the latest software update allowed by your administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV tiene instalada la actualización de software más reciente permitida por el administrador."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cuenta con la actualización de software más reciente que permite tu administrador."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cuenta con la actualización de software más reciente que permite tu administrador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV:ssä on uusin ylläpitäjän sallima ohjelmistopäivitys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV dispose de la dernière mise à jour autorisée par votre administrateur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV exécute la version logicielle la plus récente autorisée par votre administrateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Apple TV שלך מותקן עדכון התוכנה האחרון שאושר על ידי מנהל המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple TV पर आपके ऐडमिनिस्ट्रेटर द्वारा अनुमति प्राप्त नवीनतम सॉफ़्टवेयर अपडेट चल रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV ima najnovije ažuriranje softvera koje vam je odobrio vaš administrator."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV-jén az adminisztrátor által engedélyezett legújabb szoftverfrissítés fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda menjalankan pembaruan perangkat lunak terbaru yang diizinkan oleh administrator Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione del software attualmente installata su Apple TV è la più recente consentita dall’amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVは、管理者によって許可された最新のソフトウェアアップデートを実行しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 Apple TV는 관리자가 허용한 최신 소프트웨어 업데이트를 실행 중입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda menjalankan kemas kini perisian terkini yang dibenarkan oleh pentadbir anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV har den nyeste programvareversjonen som er godkjent av administratoren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV heeft de nieuwste door de beheerder goedgekeurde software-update."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV zawiera najnowsze uaktualnienia oprogramowania dozwolone przez administratora."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV está executando a atualização de software mais recente permitida pelo administrador."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua Apple TV tem a versão mais recente do software permitida pelo administrador do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul dvs. rulează cea mai recentă actualizare software permisă de administrator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Вашем Apple TV установлена новейшая версия ПО, разрешенная администратором."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašom Apple TV je nainštalovaná najnovšia aktualizácia softvéru povolená správcom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V vašem Apple TV-ju je nameščena najnovejša posodobitev programske opreme, ki jo dovoljuje skrbnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste programuppdateringen som tillåts av administratören används på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณใช้รายการอัปเดตซอฟต์แวร์ล่าสุดที่ได้รับอนุญาตโดยผู้ดูแลระบบของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz, yöneticiniz tarafından izin verilen en son yazılım güncellemeyi çalıştırıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому Apple TV інстальовано найновіше оновлення ПЗ, яке дозволив ваш адміністратор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
