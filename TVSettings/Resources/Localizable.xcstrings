          }
        },
        "no": {
          "stringUnit": {
            "value": "Vis avskrift av VoiceOver-tale i et tekstpanel på skjermen",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Pokazuj, co mówi VoiceOver, w panelu napisów na ekranie",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Mostra a saída de voz do VoiceOver em um painel com legendas na tela",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Mostra a transcrição da fala do VoiceOver no ecrã num painel de legendas.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Afișați textul enunțării VoiceOver pe ecran, într‑un panou de subtitrare",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Отображать речевые ответы VoiceOver в экранной панели субтитров.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Zobrazuje hlasový výstup VoiceOveru na paneli titulkov na obrazovke.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Prikažite izpis govora funkcije VoiceOver na zaslonu na plošči z napisi.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Visa VoiceOver-uppläsning som undertexter på skärmen",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แสดงเสียงพูด VoiceOver เป็นข้อความบนหน้าจอในแผงคำบรรยาย",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver konuşmasının çıktısını ekrandaki bir altyazı panelinde gösterir",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Показувати вивід мовлення VoiceOver на екрані в панелі текстового супроводу",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Hiển thị đầu ra lời nói VoiceOver trên màn hình trong khung chú thích",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "在屏幕上的字幕面板中显示旁白语音输出",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "在螢幕上的字幕面板中顯示「旁白」語音輸出",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "在螢幕上的字幕面板中顯示「旁白」語音輸出",
            "state": "translated"
          }
        }
      }
    },
    "AXColorFiltersDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يمكن استخدام فلاتر الألوان للتمييز بين الألوان بواسطة المستخدمين الذين يعانون من عمى الألوان، وكذلك لمساعدة المستخدمين الذين لديهم صعوبات في قراءة النص على الشاشة.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Els filtres de color serveixen perquè les persones amb daltonisme puguin diferenciar els colors. També faciliten la lectura a les persones que tenen dificultats per llegir el text de la pantalla.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Barevné filtry mohou pomoci barvoslepým uživatelům s rozlišováním barev a slabozrakým uživatelům se čtením textu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Farvefiltre kan gøre det nemmere at se forskel på farver for brugere, der er farveblinde, og hjælpe brugere som har svært ved at læse tekst på skærmen.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Benutzer:innen, die farbenblind sind oder Schwierigkeiten haben, Text auf dem Display zu lesen, können die Farbfilter zum Unterscheiden von Farben verwenden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Τα χρωματικά φίλτρα μπορούν να χρησιμοποιηθούν για διαφοροποίηση χρωμάτων από χρήστες που έχουν αχρωματοψία και ως βοήθημα για χρήστες που αντιμετωπίζουν δυσκολίες κατά την ανάγνωση κειμένου στην οθόνη.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Color filters can be used to differentiate colors by users who are color blind and aid users who have difficulty reading text on the display.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Colour filters can be used to differentiate colours by users who are colour blind and to aid users who have difficulty reading text on the display.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Colour filters can be used to differentiate colours by users who are colour blind and aid users who have difficulty reading text on the display.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Colour filters can be used to differentiate colours by users who are colour blind and aid users who have difficulty reading text on the display.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Color filters can be used to differentiate colors by users who are color blind and aid users who have difficulty reading text on the display.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Los filtros de color ayudan a los usuarios daltónicos a diferenciar los colores. También pueden ayudar a los usuarios que tienen dificultad para leer el texto de la pantalla.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Los filtros de colores se pueden usar para que los usuarios daltónicos diferencien colores y para ayudar a quienes tienen dificultades al leer la pantalla.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Los filtros de colores se pueden usar para que los usuarios daltónicos diferencien colores y para ayudar a quienes tienen dificultades al leer la pantalla.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Värisuodattimia voidaan käyttää erottamaan värejä värisokeille tai auttamaan käyttäjiä, joilla on vaikeuksia lukea näytön tekstiä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Les filtres de couleur peuvent être utilisés par les utilisateurs daltoniens pour différencier les couleurs, et par certains utilisateurs qui éprouveraient des difficultés à lire du texte à l’écran.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Les filtres de couleurs peuvent être utiles aux daltoniens pour qu’ils puissent différencier les couleurs ainsi qu’aux utilisateurs qui éprouvent des difficultés à lire du texte sur un écran.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להשתמש במסנני צבע כדי לעזור לעיוורי צבעים להבדיל בין צבעים וכדי לעזור למתקשים בקריאה לקרוא מלל שמופיע בצג.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "रंग फ़िल्टर के उपयोग से रंग अंधत्व से पीड़ित यूज़र रंगों का अंतर समझ सकते हैं और उससे ऐसे यूज़र को सहायता मिलती है जिन्हें डिस्प्ले पर टेक्स्ट पढ़ने में कठिनाई होती है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Filtri boja mogu se koristiti kako bi korisnici daltonisti lakše razlikovali boje i kao pomoć korisnicima koji imaju poteškoća s čitanjem teksta na zaslonu.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A színszűrők használatával megkülönböztethetők a színek a színvakok számára, és segítenek az olyan felhasználóknak, akik nehezen tudják elolvasni a kijelzőn megjelenő szöveget.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Filter warna dapat digunakan untuk membedakan warna oleh pengguna yang buta warna dan membantu pengguna yang kesulitan membaca teks di layar.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "I filtri colore possono essere utilizzati da chi è affetto da daltonismo o ha difficoltà a leggere il testo sullo schermo.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "カラーフィルタを使用することで、色の識別が困難な方が色を見分けやすくなり、画面のテキストが読みにくい場合の補助にもなります。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "색맹으로 인해 화면의 텍스트를 읽는 데 어려움이 있는 사용자는 색상 필터를 통해 색상을 구별하기 쉽게 조절할 수 있습니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Penapis warna boleh digunakan untuk membezakan warna oleh pengguna yang buta warna dan membantu pengguna yang menghadapi kesukaran membaca teks pada paparan.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Kleurfilters kunnen worden gebruikt om kleuren te onderscheiden door gebruikers die kleurenblind zijn en vormen een hulpmiddel voor gebruikers die moeite hebben om de tekst op het scherm te lezen.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Fargefiltre kan brukes av fargeblinde for å skille mellom ulike farger, og hjelpe brukere som har problemer med å lese tekst på skjermen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Filtry barwne mogą ułatwiać rozróżnianie kolorów osobom z daltonizmem oraz wspomagać użytkowników, którym sprawia trudność odczytywanie tekstu na ekranie.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Os filtros de cor podem ser usados para diferenciar as cores para usuários que são daltônicos e ajudar usuários que têm dificuldade para ler textos na tela.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Os filtros de cor podem ser usados para ajudar os utilizadores que sofram de daltonismo ou tenham dificuldade em ler texto no ecrã.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Filtrele de culoare pot fi folosite pentru diferențierea culorilor de către utilizatorii daltoniști și pentru a‑i ajuta pe utilizatorii care întâmpină dificultăți la citirea textului pe ecran.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Светофильтры позволяют людям с плохим восприятием цвета лучше различать цвета и текст на экране.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Farebné filtre slúžia na odlíšenie farieb pre farboslepých užívateľov a môžu pomôcť osobám, ktoré majú problém s čítaním textu na displeji.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Barvno slepi in ljudje, ki imajo težave z branjem besedila na zaslonu, lahko uporabijo barvne filtre za lažje razlikovanje barv.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Färgfilter kan användas till att göra det lättare för färgblinda användare att skilja mellan färger. Det kan också hjälpa användare som har svårt att läsa text på skärmen.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ฟิลเตอร์สีจะใช้แสดงความแตกต่างของสีได้สำหรับผู้ใช้ที่มีภาวะตาบอดสีและผู้ใช้ที่มีปัญหาในการอ่านตัวหนังสือบนจอภาพด้วย",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Renk filtreleri, renk körlüğü olan kişilerin renkleri ayırt etmesini sağlamak ve ekrandaki metinleri okuma zorluğu çeken kişilere yardımcı olmak için kullanılabilir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Колірні фільтри можуть допомогти розрізняти кольори людям з колірною сліпотою та стати у пригоді тим, кому важко читати текст на дисплеї.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Các bộ lọc màu có thể được sử dụng để giúp người dùng bị mù màu phân biệt các màu sắc và hỗ trợ người dùng gặp khó khăn trong việc đọc văn bản trên màn hình.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "色盲用户可使用色彩滤镜来区分颜色，此功能还可帮助在屏幕上阅读文本有困难的用户。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "色盲及螢幕閲讀障礙人士可以利用「色彩過濾」功能辨識顏色。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "顏色濾鏡可讓色盲的使用者辨識不同的顏色，以及協助有閱讀螢幕文字障礙的使用者。",
            "state": "translated"
          }
        }
      }
    },
    "AXPrefersTapsForDirectionalNavigationDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "استخدم الضغط الخفيف بدلاً من الضغط الشديد للتنقل باستخدام ريموت Apple TV.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Per navegar amb el comandament de l’Apple TV, fes servir tocs en comptes de prémer botons.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Při navigaci pomocí ovladače Apple TV používáte klepnutí místo stisknutí.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Brug lette tryk i stedet for almindelige tryk til at navigere med din Apple TV-fjernbetjening.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Navigiere mit der Apple TV-Fernbedienung durch Tippen anstatt Drücken.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Χρήση αγγιγμάτων αντί πατημάτων για πλοήγηση με το Apple TV Remote.",
            "state": "translated"
