          "stringUnit": {
            "state": "translated",
            "value": "Actualiza tu cuenta de Apple para usar las funciones nuevas. Acerca tu iPhone o tu iPad a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza tu cuenta de Apple para usar las funciones nuevas. Acerca tu iPhone o tu iPad a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-tili on päivitettävä uusien ominaisuuksien käyttöä varten. Päivitä pitämällä iPhonea tai iPadia tämän Apple TV:n lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Apple doit être mis à jour pour utiliser les nouvelles fonctionnalités. Pour ce faire, tenez votre iPhone ou iPad près de cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour votre compte Apple pour utiliser les nouvelles fonctionnalités. Tenez votre iPhone ou iPad à proximité de cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש במאפיינים חדשים, יש לעדכן את חשבון ה-Apple. יש לקרב את ה-iPhone או ה-iPad ל‑Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए फ़ीचर का उपयोग करने के लिए अपना Apple खाता अपडेट करें। अपने iPhone या iPad को इस Apple TV के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurirajte svoj Apple račun kako biste mogli koristiti nove značajke. Držite iPhone ili iPad blizu ovog Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítse az Apple-fiókját az új funkciók használatához. Tartsa közel iPhone-ját vagy iPadjét ehhez az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui Akun Apple Anda untuk menggunakan fitur baru. Dekatkan iPhone atau iPad Anda ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare le nuove funzionalità, devi aggiornare Apple Account. Avvicina iPhone o iPad a questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新機能を使用するには、Apple Accountをアップデートしてください。このiPhoneまたはiPadをこのApple TVの近くにかざしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 기능을 사용하려면 Apple 계정을 업데이트하십시오. iPhone 또는 iPad를 이 Apple TV 가까이 들고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini Akaun Apple anda untuk menggunakan ciri baharu. Pegang iPhone atau iPad anda berdekatan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater Apple-kontoen din for å få tilgang til nye funksjoner. Hold iPhonen eller iPaden din nær Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk je Apple Account bij om nieuwe functies te gebruiken. Houd je iPhone of iPad dicht bij deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać z nowych funkcji, musisz uaktualnić swoje konto Apple. Zbliż iPhone’a lub iPada do tego Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize a sua Conta Apple para usar novos recursos. Aproxime seu iPhone ou iPad desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize a sua conta Apple para usar novas funcionalidades. Aproxime o iPhone ou iPad desta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizați‑vă contul Apple pentru a beneficia de noi funcționalități. Țineți iPhone‑ul sau iPad‑ul în apropierea acestui Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите свой Аккаунт Apple, чтобы получить доступ к новым функциям. Для обновления держите iPhone или iPad вблизи этого Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizujte svoj Apple účet, aby ste mohli používať nové funkcie. Podržte iPhone alebo iPad pri Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo novih funkcij posodobite svoj račun Apple. Pridržite iPhone ali iPad v bližini tega Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera ditt Apple‑konto, så att nya funktioner kan användas, genom att hålla iPhone eller iPad nära denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตบัญชี Apple ของคุณเพื่อใช้คุณสมบัติใหม่ๆ ถือ iPhone หรือ iPad ให้ใกล้กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni özellikleri kullanmak için Apple Hesabı’nızı güncelleyin. iPhone’unuzu veya iPad’inizi bu Apple TV’ye yaklaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть свій обліковий запис Apple, щоб використовувати нові функції. Розмістіть iPhone чи iPad поряд із цим Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật Tài khoản Apple của bạn để sử dụng các tính năng mới. Hãy giữ iPhone hoặc iPad của bạn gần Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更新Apple账户使用新功能。请将iPhone或iPad靠近此Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更新你的Apple帳户以使用新功能。請將iPhone或iPad靠近此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新你的「Apple帳號」才能使用新功能。請將iPhone或iPad靠近此Apple TV。"
          }
        }
      }
    },
