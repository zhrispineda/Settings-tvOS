    "AccountsUserSubscriptionsDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض وإدارة الاشتراكات، قم بالتبديل إلى هذا المستخدم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per veure i gestionar les subscripcions, canvia a aquest usuari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tohoto uživatele přepněte, chcete‑li zobrazit a spravovat předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til denne bruger for at se og administrere abonnementer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Abonnements anzuzeigen und zu verwalten, wechsle zu diesem:dieser Benutzer:in."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για προβολή και διαχείριση συνδρομών, κάντε εναλλαγή σε αυτόν τον χρήστη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To view and manage subscriptions, switch to this user."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To view and manage subscriptions, switch to this user."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To view and manage subscriptions, switch to this user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver y gestionar las suscripciones, cambia a este usuario."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver y administrar las suscripciones, cambia a este usuario."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver y administrar las suscripciones, cambia a este usuario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda tähän käyttäjään, jos haluat tarkastella ja hallita tilauksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour consulter et gérer les abonnements, accédez au compte de cet utilisateur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher les gérer les abonnements, sélectionnez cet utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג ולנהל מינויים, יש לעבור אל משתמש זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन को देखने और प्रबंधित करने के लिए, इस यूज़र पर स्विच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prikaz i upravljanje pretplatama prebacite se na ovog korisnika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések megtekintéséhez és kezeléséhez váltson át erre a felhasználóra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat dan mengelola langganan, beralih ke pengguna ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per visualizzare e gestire gli abbonamenti, passa a questo utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションを表示/管理するには、このユーザに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 보고 관리하려면 이 사용자로 전환하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat dan mengurus langganan, bertukar kepada pengguna ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt til denne brukeren for å se og administrere abonnementer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om abonnementen te bekijken en te beheren, schakel je over naar deze gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyświetlić subskrypcje i zarządzać nimi, przełącz na wybranego użytkownika."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver e gerenciar assinaturas, alterne para este usuário."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver e gerir as assinaturas, mude para este utilizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vizualiza și gestiona abonamentele, comutați la acest utilizator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просмотреть подписки и управлять ими, переключитесь на учетную запись этого пользователя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete prezerať a spravovať odbery, prepnite na tohto užívateľa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če si želite ogledati in upravljati naročnine, preklopite na tega uporabnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla till den här användaren om du vill visa och hantera abonnemang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการดูและจัดการการสมัครสมาชิก ให้สลับมายังผู้ใช้นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikleri görüntülemek ve yönetmek için bu kullanıcıya geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перегляду й змінення підписок перемкніться на обліковий запис цього користувача."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem và quản lý các đăng ký, hãy chuyển sang người dùng này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要查看和管理订阅，请切换到此用户。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要檢視和管理訂閲項目，請切換至此用户。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要檢視和管理訂閱項目，請切換至此使用者。"
          }
        }
      }
    },
