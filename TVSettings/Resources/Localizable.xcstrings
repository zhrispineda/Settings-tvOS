    "SaverBackdropPhotoTransitionStylesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار كيفية الانتقال بين الصور في شاشة التوقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria l’estil de transició entre les imatges de l’estalvi de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak bude spořič obrazovky přecházet mezi obrázky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvordan overgangen mellem billeder skal være i skærmskåneren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welchen Übergang der Bildschirmschoner zwischen Bildern verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τον τρόπο μετάβασης των εικόνων στην προφύλαξη οθόνης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how the screen saver transitions between images."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how the screen saver transitions between images."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how the screen saver transitions between images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona cómo pasan de una a otra las imágenes del salvapantallas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo quieres que sean las transiciones de una imagen a otra en el protector de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo quieres que sean las transiciones de una imagen a otra en el protector de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, miten näytönsäästäjä siirtyy kuvasta toiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le type de transition entre les images de l’économiseur d’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un type de transition entre les images pour l’économiseur d’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את סגנון המעברים בין התמונות בשומר המסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि इमेज के बीच स्क्रीन सेवर ट्रांज़िशन कैसे करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite način prijelaza između slika zaštite zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja, hogy milyenek legyenek a képernyővédő átmenetei a képek között."
          }
        },
        "id": {
