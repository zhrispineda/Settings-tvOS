    "AXBrailleTranslationAddNewLanguageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "جداول برايل المضافة هنا ستظهر في دوار جداول برايل في التعليق الصوتي",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Les taules Braille que afegeixis aquí es mostraran al rotor de taules Braille del VoiceOver.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Braillovy tabulky, které zde přidáte, se zobrazí na rotoru Braillových tabulek ve VoiceOveru",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Punktskrifttabeller, der tilføjes her, vises i rotoren Punktskrifttabeller i VoiceOver",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Hier hinzugefügte Braille-Tabellen werden im Braille-Tabellenrotor in VoiceOver angezeigt.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Οι πίνακες Μπράιγ που προστίθενται εδώ θα εμφανίζονται στον ρότορα «Πίνακες Μπράιγ» στο VoiceOver.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Braille tables added here will appear in the Braille Tables rotor in VoiceOver",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Braille tables added here will appear in the Braille Tables rotor in VoiceOver",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Braille tables added here will appear in the Braille Tables rotor in VoiceOver",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Braille tables added here will appear in the Braille Tables rotor in VoiceOver",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Braille tables added here will appear in the Braille Tables rotor in VoiceOver",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Las tablas de braille añadidas aquí aparecerán en el rotor “Tablas de braille” en VoiceOver.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Las tablas Braille que se agreguen aquí aparecerán en el rotor Tablas Braille en VoiceOver",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Las tablas Braille que se agreguen aquí aparecerán en el rotor Tablas Braille en VoiceOver",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Tähän lisätyt pistekirjoitustaulukot näkyvät VoiceOverin Pistekirjoitustaulukot-roottorissa",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Les tables braille ajoutées ici s’afficheront dans le rotor « Tables braille » de VoiceOver.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Les tableaux braille ajoutés ici s’afficheront dans le rotor « Tableaux braille » dans VoiceOver.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "טבלאות ברייל שיוספו כאן יופיעו בחוגת טבלאות הברייל ב-VoiceOver",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "यहाँ जोड़े गए ब्रेल टेबल VoiceOver में ब्रेल टेबल रोटर में दिखेंगे",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Brajeve tablice koje ovdje dodate prikazivat će se u rotoru Brajeve tablice u VoiceOveru",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Az itt hozzáadott Braille-táblák a VoiceOver Braille-táblák rotorjában fognak megjelenni",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tabel Braille yang ditambahkan di sini akan muncul di rotor Tabel Braille di VoiceOver",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Le tabelle Braille aggiunte qui verranno visualizzate nel rotore “Tabelle Braille” in VoiceOver",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "ここで追加された点字表は、VoiceOverの点字表ローターに表示されます",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "여기에 추가된 점자표가 VoiceOver의 점자표 로터에 나타납니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Jadual Braille yang ditambahkan di sini akan kelihatan pada rotor Jadual Braille dalam VoiceOver",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Brailletabellen die hier worden toegevoegd, worden weergegeven in de rotor 'Brailletabellen' in VoiceOver",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Punktskrifttabeller som legges til her, vil bli vist i Punktskrifttabell-rotoren i VoiceOver",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Dodane tutaj tabele Braille'a będą wyświetlane na pokrętle Tabele Braille'a w VoiceOver",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "As tabelas de braille adicionadas aqui aparecerão no rotor Tabelas de Braille no VoiceOver",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "As tabelas braille adicionadas aqui aparecem no rotor de tabelas braille no VoiceOver",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Tabelele Braille adăugate aici vor apărea în rotorul Tabele Braille din VoiceOver",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Добавленные здесь таблицы Брайля появятся в роторе таблиц Брайля в VoiceOver",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Braillove tabuľky, ktoré tu pridáte, sa zobrazia v rotore Braillova tabuľka pri používaní VoiceOveru.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Tabele za Braillovo pisavo, dodane tukaj, se bodo prikazale v rotorju tabel za Braillovo pisavo v funkciji VoiceOver.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Punktskriftstabeller som läggs till här visas i rotorn Punktskriftstabeller i VoiceOver.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ตารางอักษรเบรลล์ที่เพิ่มที่นี่จะแสดงในตัวหมุนตารางอักษรเบรลล์ใน VoiceOver",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Buraya eklenen Braille Tabloları, VoiceOver’da Braille Tablosu rotorunda görünür",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Додані тут брайль-таблиці зʼявлятимуться в роторі Брайль-таблиць у VoiceOver",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Các bảng braille được thêm tại đây sẽ xuất hiện trong rô-to Bảng braille trong VoiceOver",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "此处添加的盲文表会显示在“旁白”的“盲文表”转子中",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "在此新增的點字表會在「旁白」的點字表轉輪中顯示",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "已加入此處的點字表會顯示於「旁白」的「點字表」轉輪",
            "state": "translated"
          }
        }
      }
    },
