        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV에서 인물 사진을 사용하려면 iCloud 사진을 설정하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan Potret pada Apple TV ini, sediakan Foto iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargjør iCloud Bilder for å bruke Portretter på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om 'Portretten' op deze Apple TV te gebruiken, configureer je iCloud-foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać portretów na tym Apple TV, skonfiguruj Zdjęcia w iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar Retratos nesta Apple TV, configure as Fotos do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar Retratos nesta Apple TV, configure Fotografias em iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a utiliza Portrete pe acest Apple TV, configurați Poze iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать Портреты на этом Apple TV, настройте Фото iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete na tomto Apple TV používať šetrič Portréty, nastavte si službu iCloud Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo portretov v tem Apple TV-ju nastavite Fotografije iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in iCloud-bilder om du vill använda Porträtt på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการใช้ภาพถ่ายบุคคลบน Apple TV เครื่องนี้ ให้ตั้งค่า “รูปภาพบน iCloud”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’de Portreler’i kullanmak için iCloud Fotoğrafları’nı ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати Портрети на цьому Apple TV, налаштуйте Фото iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sử dụng Chân dung trên Apple TV này, hãy thiết lập Ảnh iCloud."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在此Apple TV上使用“人像”，请设置iCloud照片。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
