    "TimeZoneUpdateAvailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوفر مناطق زمنية جديدة وسيتم تثبيتها عند إعادة تشغيل الـ Apple TV في المرة القادمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha noves zones horàries disponibles i s’instal·laran la propera vegada que es reiniciï l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou k dispozici nová časová pásma. Po příštím restartu Apple TV se nainstalují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye tidszoner er tilgængelige og installeres næste gang Apple TV starter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Zeitzonen sind verfügbar und werden nach dem Neustart von Apple TV installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατίθενται νέες ζώνες ώρας και θα εγκατασταθούν την επόμενη φορά που θα επανεκκινηθεί το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New time zones are available and will be installed next time your Apple TV restarts."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "New time zones are available and will be installed next time your Apple TV restarts."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "New time zones are available and will be installed next time your Apple TV restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una actualización disponible de zonas horarias nuevas que se instalará la próxima vez que se reinicie el Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas zonas horarias está disponibles y se instalarán la próxima vez que se reinicie tu Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas zonas horarias está disponibles y se instalarán la próxima vez que se reinicie tu Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet aikavyöhykkeet ovat saatavilla ja ne asennetaan, kun Apple TV seuraavan kerran käynnistetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouveaux fuseaux horaires sont disponibles et seront installés lors du prochain redémarrage de votre Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouveaux fuseaux horaires sont disponibles et seront installés au prochain redémarrage de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ישנם שעונים מקומיים חדשים זמינים. הם יותקנו בהפעלה מחדש הבאה של ה-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए समय क्षेत्र उपलब्ध हैं और अगली बार आपके Apple TV के रीस्टार्ट होने पर ये इंस्टॉल हो जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupne su nove vremenske zone i instalirat će se kad se vaš Apple TV sljedeći put ponovno uključi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új időzóna-beállítások érhetők el, melyek az Apple TV következő újraindítása után lesznek telepítve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona waktu baru tersedia dan akan diinstal setelah Apple TV Anda dimulai ulang."
