    "iCloudSharedAlbumsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مشاهدة الصور والفيديوهات التي شاركتها مع أصدقائك وعائلتك. ويمكنك أيضًا مشاهدة الصور والفيديوهات والتعليقات التي أضافوها إلى ألبوماتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualitza les fotos i els vídeos que has compartit amb la família i les amistats. També pots veure les fotos, els vídeos i els comentaris que hagin afegit als àlbums."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde vidíte fotky a videozáznamy, které sdílíte s přáteli a rodinou. Také zde můžete vidět fotky, videa a komentáře, které do vašich alb přidali oni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se de fotos og videoer, du har delt med venner og familie. Du kan også se de fotos, videoer og kommentarer, som de har føjet til dine album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige die Fotos und Videos an, die du mit Freund:innen und Familie teilst. Du kannst auch Fotos, Videos und Kommentare sehen, die diese zu deinen Alben hinzugefügt haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τις φωτογραφίες και τα βίντεο που έχετε μοιραστεί με φίλους και συγγενείς. Μπορείτε επίσης να δείτε τις φωτογραφίες, τα βίντεο και τα σχόλια που έχουν προσθέσει στα άλμπουμ σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the photos and videos you shared with your friends and family. You can also see the photos, videos, and comments they’ve added to your albums."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "See the photos and videos you shared with your friends and family. You can also see the photos, videos and comments they’ve added to your albums."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "See the photos and videos you shared with your friends and family. You can also see the photos, videos and comments they’ve added to your albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira las fotos y vídeos que has compartido con tu familia y amigos. También puedes ver las fotos, vídeos y comentarios que ellos han añadido a tus álbumes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve las fotos y los videos que compartes con amigos y familiares. También puedes ver los comentarios que dejaron en fotos, videos y en tus álbumes."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve las fotos y los videos que compartes con amigos y familiares. También puedes ver los comentarios que dejaron en fotos, videos y en tus álbumes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe kuvat ja videot, jotka olet jakanut ystäville ja perheenjäsenille. Näe myös kuvat, videot ja kommentit, jotka he ovat lisänneet albumeihisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les photos et vidéos partagées avec vos proches. Vous pouvez également voir les photos, vidéos et commentaires qu’ils ont ajoutés à vos albums."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les photos et vidéos que vous avez partagées avec vos amis et votre famille. Vous pouvez également afficher les photos, vidéos et commentaires qu’ils ont ajoutés à vos albums."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לראות את התמונות והסרטים ששיתפת עם חברים ובני משפחה. באפשרותך גם לראות תמונות, סרטים ותגובות שהם הוסיפו לאלבומים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने दोस्तों और परिवार के साथ आपके द्वारा शेयर की गई तस्वीरें और वीडियो देखें। आप अपने ऐल्बम में उनके द्वारा जोड़ी गईं तस्वीरें, वीडियो और टिप्पणियाँ भी देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte fotografije i videozapise koje ste podijelili sa svojim prijateljima i obitelji. Također možete pogledati fotografije, videozapise i komentare koje su dodali u vaše albume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtekintheti a barátaival és családjával megosztott fotókat és videókat. Láthatja továbbá azokat a fotókat, videókat és megjegyzéseket is, amelyeket ők adnak hozzá az Ön albumaihoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat foto dan video yang Anda bagikan dengan teman dan keluarga. Anda juga dapat melihat foto, video, dan komentar yang telah mereka tambahkan ke album Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda le foto e i video che hai condiviso con i tuoi familiari e amici. Puoi anche visualizzare le foto, i video e i commenti che hanno aggiunto ai tuoi album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達や家族と共有した写真やビデオを閲覧できます。友達や家族があなたのアルバムに追加した写真、ビデオ、およびコメントを確認することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 가족과 공유한 사진과 비디오를 봅니다. 또한 사용자의 앨범에 친구 및 가족이 추가한 사진, 비디오 및 댓글을 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat foto dan video yang anda kongsi bersama rakan dan keluarga anda. Anda juga boleh melihat foto, video dan komen yang telah mereka tambah ke album anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bilder og videoer du har delt med venner og familie. Du kan også se bilder, videoer og kommentarer de har lagt til i albumene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de foto's en video's die je met vrienden en familie hebt gedeeld. Je kunt ook de foto's, video's en opmerkingen zien die zij aan jouw albums hebben toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądaj zdjęcia i wideo, które udostępniasz rodzinie i znajomym. Możesz również przeglądać zdjęcia, wideo i komentarze dodane do Twoich albumów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as fotos e os vídeos que você compartilhou com amigos e familiares. Você também pode ver as fotos, vídeos e comentários que foram adicionados aos seus álbuns."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as fotografias e vídeos que partilhou com amigos e família. Também pode ver as fotografias, vídeos e comentários que foram adicionados aos seus álbuns."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți pozele și clipurile video pe care le‑ați partajat cu prietenii și familia. De asemenea, puteți vedea pozele, clipurile video și comentariile pe care aceștia le‑au adăugat în albumele dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите фото и видео, которыми Вы поделились с друзьями и членами семьи. Вы можете также видеть фото, видео и комментарии, добавленные ими в Ваши альбомы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezerajte si fotky a videá zdieľané s priateľmi a rodinou. Zároveň si môžete prezerať fotky, videá a komentáre, ktoré boli pridané do vašich albumov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglejte si fotografije in videoposnetke, ki ste jih delili s prijatelji in družino. Ogledate si lahko tudi fotografije, videoposnetke in komentarje, ki so jih dodali v vaše albume."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bilder och videor som du har delat med vänner och familj. Du kan även se bilder, videor och kommentarer som de har lagt till i dina album."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูรูปภาพและวิดีโอที่คุณแชร์กับเพื่อนและครอบครัวของคุณ คุณยังสามารถดูรูปภาพ วิดีโอ และความคิดเห็นที่พวกเขาเพิ่มไปยังอัลบั้มของคุณได้อีกด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşlarınızla ve ailenizle paylaştığınız fotoğrafları ve videoları görün. Bu kişilerin albümlerinize eklediği fotoğrafları, videoları ve yorumları da görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте фото й відео, які ви поширили для друзів і рідних. Ви також можете бачити фото, відео та коментарі, додані ними до ваших альбомів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem các ảnh và video mà bạn đã chia sẻ với gia đình và bạn bè. Bạn cũng có thể xem ảnh, video và nhận xét mà họ đã thêm vào các album của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你与朋友和家人共享的照片和视频。你还可以查看他们添加到相簿中的照片、视频和评论。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你與家人及朋友共享的相片及影片。你亦可以查看他們在相簿中加入的相片、影片及評論。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視你和家人朋友共享的照片和影片。你也可以檢視他們在你相簿中加入的照片、影片和評論。"
          }
        }
      }
    },
