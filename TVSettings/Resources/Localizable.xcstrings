        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’ye yeni bir profil ekleyerek profil sahibinin şovlarına, filmlerine, İzlemeyi Sürdür’üne, iCloud’daki uygulama verilerine ve Game Center hesabına erişin."
          }
