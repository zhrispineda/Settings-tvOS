    "LegaliTunesTermsShortWithURL": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاطلاع على شروط وأحكام خدمات وسائط Apple، يرجى زيارة الصفحة التالية:\nwww.apple.com/legal/internet-services/itunes/"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per consultar els termes i les condicions dels serveis de contingut multimèdia d’Apple, ves a www.apple.com/es/legal/internet-services/itunes/."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmínky a ujednání pro mediální služby Apple najdete na www.apple.com/legal/internet-services/itunes/"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du finder vilkår og betingelser for Apples medietjenester, hvis du besøger www.apple.com/dk/legal/internet-services/itunes/"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzungsbedingungen der Apple-Mediendienste sind unter www.apple.com/de/legal/internet-services/itunes/ erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τους όρους και προϋποθέσεις των Υπηρεσιών Apple Media, επισκεφθείτε τη διεύθυνση www.apple.com/legal/internet-services/itunes/gr/terms.html"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Apple Media Services terms and conditions, please visit www.apple.com/legal/internet-services/itunes/"
          }
