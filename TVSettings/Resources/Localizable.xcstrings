    "AVNativeModeSwitchingUnverifiedModesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد هذا التنسيق للتأكد أنه يعمل مع تلفزيونك. وبمجرد التحقق، يمكن أن يستخدمه Apple TV تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona aquest format per verificar que funcioni amb el televisor. Un cop s’hagi verificat, s’utilitzarà automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento formát vyberte, chcete‑li zjistit, jestli na vašem televizoru funguje. Po ověření ho může Apple TV používat automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dette format for at sikre, at det virker på dit fjernsyn. Når det er blevet bekræftet, kan Apple TV bruge det automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle dieses Format, um sicherzustellen, dass es mit deinem TV-Gerät funktioniert. Nach der Verifizierung kann es von Apple TV automatisch verwendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε αυτήν τη μορφή για να ελεγχθεί αν λειτουργεί με την τηλεόρασή σας. Όταν επαληθευτεί ότι λειτουργεί, το Apple TV θα μπορεί να τη χρησιμοποιεί αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this format to make sure it works with your television. Once verified, Apple TV can use it automatically."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this format to make sure it works with your television. Once verified, Apple TV can use it automatically."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this format to make sure it works with your television. Once verified, Apple TV can use it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona este formato para comprobar si es compatible con tu televisor. Después de verificarlo, el Apple TV lo podrá usar automáticamente."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona este formato para verificar que tu TV sea compatible con él. Una vez verificado, el Apple TV lo podrá usar automáticamente."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona este formato para verificar que tu TV sea compatible con él. Una vez verificado, el Apple TV lo podrá usar automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista valitsemalla tämä näyttötila, että se toimii televisiossasi. Kun tämä on vahvistettu, Apple TV voi käyttää sitä automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez ce format pour vérifier s’il est compatible avec votre téléviseur. S’il l’est, l’Apple TV pourra l’utiliser automatiquement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez ce format pour vérifier qu’il fonctionne avec votre télévision. Une fois qu’elle l’a vérifié, l’Apple TV peut l’utiliser automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור את הפורמט הזה כדי לוודא שהוא נתמך בטלוויזיה שלך. לאחר האימות, ה-Apple TV יוכל להשתמש בו באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ॉर्मैट यह निश्चित करने के लिए चुनें कि यह आपके टेलीविज़न के साथ काम करता है। सत्यापन के बाद Apple TV इसका ऑटोमैटिकली उपयोग कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite ovaj format kako biste provjerili hoće li raditi na vašem televizoru. Nakon verificiranja, Apple TV ga može automatski koristiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ezt a formátumot annak érdekében, hogy meggyőződjön arról, az működik a televíziójával. Az ellenőrzés után az Apple TV már automatikusan tudja használni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih format ini untuk memastikan bahwa format dapat digunakan di televisi Anda. Setelah diverifikasi, Apple TV dapat menggunakannya secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona questo formato per verificare che sia compatibile con il tuo televisore. Se è supportato, Apple TV può utilizzarlo automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのテレビで動作するか確認するにはこのフォーマットを選択してください。動作が検証されれば、Apple TVは自動的にそれを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 포맷을 선택하여 사용자의 텔레비전과 호환되는지 확인하십시오. 호환되는 것으로 확인되면 Apple TV가 자동으로 이 포맷을 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih format ini untuk memastikan ia berfungsi dengan televisyen anda. Setelah disahkan, Apple TV boleh menggunakannya secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg dette formatet for å forsikre deg om at det støttes av TV-en din. Etter verifiseringen kan formatet brukes automatisk på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer deze structuur om ervoor te zorgen dat deze geschikt is voor je televisie. Apple TV kan deze structuur automatisch gebruiken, zodra deze is geverifieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ten format, aby sprawdzić, czy działa na Twoim telewizorze. Jeśli tak, możemy używać go automatycznie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
