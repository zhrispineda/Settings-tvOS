    "AXUsePitchDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "للمساعدة في تمييز السياق، يمكن للتعليق الصوتي تغيير حدة الصوت عند النطق.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Per ajudar a distingir el context, el VoiceOver pot canviar el to quan parla.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "VoiceOver může na pomoc s rozlišením kontextu změnit výšku hlasu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "VoiceOver kan ændre tonehøjden ved oplæsning for at hjælpe dig med at forstå sammenhængen.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "VoiceOver kann die Tonhöhe beim Sprechen ändern, um Inhalte leichter unterscheiden zu können.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Για διάκριση στοιχείων περιβάλλοντος, το VoiceOver μπορεί να αλλάξει το τονικό ύψος κατά την εκφώνηση.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "To help distinguish context, VoiceOver can change the pitch when speaking.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "To help distinguish context, VoiceOver can change the pitch when speaking.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "To help distinguish context, VoiceOver can change the pitch when speaking.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "To help distinguish context, VoiceOver can change the pitch when speaking.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "To help distinguish context, VoiceOver can change the pitch when speaking.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Para poder distinguir el contexto, VoiceOver puede cambiar el tono de la voz al hablar.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Para ayudar a distinguir el contexto, VoiceOver puede cambiar el tono al hablar.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Para ayudar a distinguir el contexto, VoiceOver puede cambiar el tono al hablar.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Jotta asiayhteys erottuisi paremmin, VoiceOver voi muuttaa äänenkorkeutta puhuttaessa.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Pour aider à différencier les contextes, VoiceOver peut changer de tonalité pendant l’énonciation.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "VoiceOver peut modifier le ton de la voix pour distinguer le contexte.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "כדי להבחין טוב יותר בין ההקשרים, VoiceOver יכול לשנות את גובה הצליל של הדיבור שלו.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "बोले जा रहे शब्दों के संदर्भ में अंतर स्पष्ट करने हेतु VoiceOver बोलने के दौरान पिच बदल सकता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Kako biste lakše raspoznali kontekst, VoiceOver može promijeniti visinu tona tijekom govora.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A szövegkörnyezet megkülönböztetéséhez a VoiceOver módosíthatja a hangmagasságot beszéd közben.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Untuk membantu membedakan konteks, VoiceOver dapat mengubah nada saat berbicara.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Per aiutare a distinguere il contesto, VoiceOver può modificare il tono durante la lettura.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "コンテキストを区別できるように、VoiceOverが読み上げるときのピッチを変更できます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "문맥을 구별하기 위해 VoiceOver가 말할 때 음높이를 변경할 수 있습니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Untuk membantu membezakan konteks, VoiceOver boleh menukar pic semasa bercakap.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Om onderscheid te maken in context, kan VoiceOver de toonhoogte van de stem wijzigen.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "VoiceOver kan endre toneleiet under talen for å hjelpe deg å forstå sammenhengen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "VoiceOver może zmieniać wysokość tonu mowy, aby pomóc odróżniać kontekst.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Para ajudar a distinguir o contexto, o VoiceOver pode alterar o tom ao falar.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Para ajudar a distinguir o contexto, o VoiceOver pode mudar de tom de voz.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Pentru a vă ajuta să distingeți contextul, VoiceOver poate varia tonalitatea enunțării.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Для лучшего распознавания контекста VoiceOver может менять высоту тона при произнесении слов.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Za účelom rozlíšeniu kontextu môže VoiceOver meniť počas rozprávania výšku hlasu.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Za pomoč pri razlikovanju konteksta lahko VoiceOver med govorjenjem spremeni višino tona.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "VoiceOver kan ändra röstens tonläge under uppläsningen så att det blir lättare att särskilja sammanhang.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เพื่อให้เกิดความแตกต่างกัน VoiceOver สามารถเปลี่ยนระดับเสียงเวลาออกเสียงพูดได้",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "İçeriğin anlaşılmasına yardımcı olmak için VoiceOver konuşurken perdeyi değiştirebilir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Щоб легше було розрізнити контекст, VoiceOver може міняти тон під час мовлення.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Để giúp phân biệt ngữ cảnh, VoiceOver có thể thay đổi cao độ khi nói.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "为了有效区别上下文，“旁白”可以在朗读时改变音高。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "為了有效區分內容，「旁白」可以在説話時改變音調。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "為了協助區分內容，「旁白」可在朗讀時更改音高。",
            "state": "translated"
          }
        }
      }
    },
