        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 और Apple Home के लिए iCloud खाता ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 i Apple Dom zahtijevaju iCloud račun."
          }
        },
        "hu": {
          "stringUnit": {
