          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть надійніший пароль, мінімум 6 символів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng chọn một mật khẩu mạnh hơn, có tối thiểu 6 ký tự."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择包含至少6个字符的强密码。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇較強的密碼，至少包含6個字元。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇強度較高的密碼，至少包含6個字元。"
          }
        }
      }
    },
