    "AccountsAdditionalUserProfileDescriptionWithoutDefaultUser": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعديل معلومات حساب \"%@\". إذا كنت تريد تعيين هذا الشخص ليكون ملف التعريف الافتراضي، فأزل حسابه من Apple TV. ثم أضفه مرة أخرى واجعله ملف التعريف الافتراضي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita la informació del compte “%@”. Si vols que aquesta persona sigui el perfil per omissió, elimina’n el compte de l’Apple TV. A continuació, afegeix‑lo com a perfil per omissió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava údajů o účtu profilu „%@“. Pokud chcete profil tohoto uživatele nastavit jako výchozí, odeberte jeho účet z Apple TV. Potom ho znovu přidejte jako výchozí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger kontooplysninger for “%@”. Hvis du vil gøre denne person til standardprofilen, skal du fjerne vedkommendes konto fra Apple TV. Tilføj derefter personen igen som standardprofil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite die Accountinformationen für „%@“. Wenn du diese Person als Standardprofil festlegen möchtest, entferne deren Account von dem Apple TV. Füge es anschließend wieder als Standardprofil hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργαστείτε τις πληροφορίες λογαριασμού για «%@». Αν θέλετε να καθορίσετε το προφίλ αυτού του ατόμου ως το προεπιλεγμένο προφίλ, αφαιρέστε τον λογαριασμό του από το Apple TV. Στη συνέχεια, προσθέστε το εκ νέου ως προεπιλεγμένο προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit account information for “%@”. If you want to make this person the default profile, remove their account from the Apple TV. Then add them back as the default profile."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit account information for “%@”. If you want to make this person the default profile, remove their account from the Apple TV. Then add them back as the default profile."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit account information for “%@”. If you want to make this person the default profile, remove their account from the Apple TV. Then add them back as the default profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita la información de la cuenta de %@. Si quieres que esta persona sea el perfil por omisión, elimina su cuenta del Apple TV. A continuación, añádelo como el perfil por omisión."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita la información de la cuenta de “%@”. Si quieres hacer que esta persona sea el perfil predeterminado, elimina su cuenta del Apple TV y luego vuelve a agregarlo como el perfil predeterminado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita la información de la cuenta de “%@”. Si quieres hacer que esta persona sea el perfil predeterminado, elimina su cuenta del Apple TV y luego vuelve a agregarlo como el perfil predeterminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa tilitietoja (%@). Jos haluat tehdä tästä käyttäjästä oletusprofiilin, poista hänen tilinsä Apple TV:stä. Lisää hänet sitten takaisin oletusprofiiliksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les informations du compte « %@ ». Pour définir cette personne comme profil par défaut, supprimez son compte de l’Apple TV, puis ajoutez-le de nouveau en tant que profil par défaut."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les informations du compte ^[de %@](inflect: true). Si vous voulez que cette personne devienne le profil par défaut, supprimez son compte de l’Apple TV, puis ajoutez-le comme profil par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לערוך את פרטי החשבון של ״%@״. אם ברצונך להגדיר את הפרופיל של אדם זה כפרופיל ברירת המחדל יש להסיר את החשבון שלו מה‑Apple TV. לאחר מכן יש להוסיף אותו חזרה כפרופיל ברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” के लिए खाता जानकारी संपादित करें। अगर आप इस व्यक्ति को डिफ़ॉल्ट प्रोफ़ाइल बनाना चाहते हैं, तो उनका खाता Apple TV से निकालें। फिर उन्हें डिफ़ॉल्ट प्रोफ़ाइल के तौर पर वापस जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uredite informacije računa za “%@”. Ako želite podesiti ovu osobu kao standardni profil, uklonite njezin račun s Apple TV-a. Zatim je vratite kao standardni profil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” fiókinformációinak szerkesztése. Ha ezt a személyt szeretné beállítani alapértelmezett profilként, akkor távolítsa el a fiókját az Apple TV-ről. Ezután adja hozzá újra alapértelmezett profilként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit informasi akun untuk “%@”. Jika Anda ingin menjadikan orang ini profil default, hapus akunnya dari Apple TV. Lalu tambahkan kembali sebagai profil default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le informazioni dell’account di “%@”. Se vuoi impostare questa persona come profilo di default, rimuovi il suo account da Apple TV, quindi aggiungilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”さんのアカウント情報を編集します。この人のプロフィールをデフォルトにするには、まずその人のアカウントをApple TVから削除してください。それから、デフォルトプロフィールとして追加し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’님의 계정 정보를 편집합니다. 이 사람을 기본 프로필로 설정하려면, 이 사람의 계정을 Apple TV에서 제거한 다음 기본 프로필로 다시 추가하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit maklumat akaun untuk “%@”. Jika anda mahu menjadikan orang ini sebagai profil lalai, keluarkan akaun mereka daripada Apple TV. Kemudian tambahkannya semula sebagai profil lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger kontoinformasjonen til «%@». Hvis du vil gjøre denne personen om til standardprofil, må du først fjerne kontoen fra Apple TV. Legg hen deretter til igjen som standardprofil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig accountgegevens voor '%@'. Als je van deze persoon het standaardprofiel wilt maken, moet je de account van deze persoon verwijderen van de Apple TV. Voeg het profiel vervolgens weer toe als standaardprofiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj dane konta „%@”. Jeśli ta osoba ma być profilem domyślnym, usuń jego konto z tego Apple TV. Następnie dodaj go ponownie jako profil domyślny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite as informações da conta de %@. Para que esta pessoa seja o perfil padrão, remova a conta dela da Apple TV. Em seguida, adicione‑a de volta como o perfil padrão."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite a informação de conta de “%@”. Se quiser tornar esta pessoa o perfil predefinido, primeiro tem de remover a respetiva conta da Apple TV. Depois, adicione‑o como perfil predefinido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editați informațiile contului pentru „%@”. Dacă doriți să definiți această persoană drept profil implicit, eliminați contul său de pe Apple TV. Apoi, adăugați‑l înapoi drept profil implicit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактировать данные учетной записи профиля %@. Чтобы сделать профиль этого человека профилем по умолчанию, удалите его учетную запись с этого Apple TV. Затем добавьте ее повторно, уже как профиль по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upraviť informácie o účte užívateľa %@. Ak chcete túto osobu nastaviť ako predvolený profil, odstráňte jej účet z Apple TV. Potom ho znovu pridajte ako predvolený profil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uredite podatke o računu uporabnika »%@«. Če želite nastaviti to osebo kot privzeti profil, odstranite njen račun iz Apple TV‑ja. Potem ga spet dodajte kot privzeti profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera kontoinformation för ”%@”. Om du vill göra den här personen till den förvalda profilen tar du bort personens konto från Apple TV. Sedan lägger du till personen igen som förvald profil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขข้อมูลบัญชีสำหรับ “%@” ถ้าคุณต้องการให้คนนี้เป็นโปรไฟล์เริ่มต้น ให้เอาบัญชีของเขาออกจาก Apple TV จากนั้นเพิ่มกลับเข้าไปเป็นโปรไฟล์เริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için hesap bilgilerini düzenleyin. Bu kişiyi saptanmış profil yapmak istiyorsanız kişinin hesabını Apple TV’den silin. Sonra, saptanmış profil olarak yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити інформацію облікового запису для користувача «%@». Щоб задати профіль цієї особи як типовий, вилучіть її обліковий запис з Apple TV. Потім додайте його знову як типовий профіль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa thông tin tài khoản cho “%@”. Nếu bạn muốn đặt người này là hồ sơ mặc định, hãy xóa tài khoản của họ khỏi Apple TV. Sau đó, hãy thêm lại hồ sơ đó làm hồ sơ mặc định."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑“%@”账户信息。若要将此设为默认个人资料，请先将其账户从Apple TV移除。再作为默认个人资料重新添加。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯「%@」的帳户資料。如你想將此人設定為預設個人檔案，請先從Apple TV移除此人的帳户。然後將其重新加入為預設個人檔案。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯「%@」的帳號資訊。若要將此人設為預設個人檔案，請先將其帳號從Apple TV移除。接著再將其重新加入為預設個人檔案。"
          }
        }
      }
    },
