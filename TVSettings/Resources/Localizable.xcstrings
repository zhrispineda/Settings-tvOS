        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een nieuw profiel toe aan deze Apple TV voor toegang tot programma's, films, 'Kijk verder', appgegevens in iCloud en de Game Center-account van deze gebruiker."
