          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Apple TV este supervizat, iar „%@” poate să monitorizeze traficul de internet pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Apple TV контролируется, а организация «%@» может выполнять мониторинг интернет‑трафика на данном устройстве."
          }
