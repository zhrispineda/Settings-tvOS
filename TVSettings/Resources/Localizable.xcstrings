    "AVNativeModeSwitchingMatchVideoFrameRateDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل محتوى الأفلام والمحتوى الدولي بمعدل إطاراته الأصلي. بعض التلفزيونات تفعل ذلك تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodueix pel·lícules i contingut internacional en la freqüència de fotogrames original. Alguns televisors ho fan automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy a mezinárodní obsah se budou přehrávat s původní snímkovou frekvencí. Některé televizory takto fungují automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil film og internationalt indhold i den oprindelige billedfrekvens. Nogle fjernsyn gør dette automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe von Film- und internationalen Inhalten mit der Original-Bildrate. Bei manchen TV-Geräten geschieht das automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναπαραγωγή ταινιών και διεθνούς περιεχομένου στον αρχικό τους ρυθμό καρέ. Κάποιες τηλεοράσεις εκτελούν αυτήν την ενέργεια αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play film and international content at its original frame rate. Some televisions do this automatically."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Play film and international content at its original frame rate. Some televisions do this automatically."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Play film and international content at its original frame rate. Some televisions do this automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contenidos internacionales y de películas se reproducen con su frecuencia de fotogramas original. Algunos televisores usan esta configuración automáticamente."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce películas y contenido internacional usando su frecuencia de fotogramas original. Algunas televisiones lo hacen automáticamente."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce películas y contenido internacional usando su frecuencia de fotogramas original. Algunas televisiones lo hacen automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista elokuvia ja kansainvälistä sisältöä alkuperäisellä kuvataajuudella. Joissakin televisioissa tämä tapahtuu automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visionnez les films et le contenu international avec leur fréquence d’images d’origine. Certains téléviseurs effectuent automatiquement ce changement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visionnez les films et les contenus internationaux en appliquant leur fréquence d’images originale. Certaines télévisions font cela automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להשתמש בקצב הפריימים המקורי של סרטים ותכנים בינלאומיים בעת הפעלתם. בחלק מהטלוויזיות פעולה זו מתבצעת באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्म और अंतरराष्ट्रीय कॉन्टेंट को उसके मूल फ़्रेम दर पर चलाएँ। कुछ टेलीविज़न ऑटोमैटिकली ऐसा करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduciranje filmskih i međunarodnih sadržaja pri izvornoj brzini sličica. Neki televizori to automatski rade."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A filmeket és a nemzetközi tartalmakat lejátszhatja az eredeti képkockasebességgel. Néhány televízió ezt automatikusan végzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar film dan konten internasional pada laju bingkai aslinya. Sebagian televisi melakukan ini secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci contenuti su pellicola e internazionali alla frequenza originale dei fotogrammi. Alcuni televisori eseguono l’operazione automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画フィルムおよびインターナショナルコンテンツをオリジナルのフレームレートで再生します。一部のテレビではこれを自動的に行う場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화 및 국제적인 콘텐츠를 원래의 프레임률로 재생합니다. 일부 텔레비전에서는 이 기능이 자동으로 동작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan filem dan kandungan antarabangsa pada kadar bingkai asalnya. Sesetengah televisyen melakukannya secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill av filmer og internasjonalt innhold i den opprinnelige bildefrekvensen. Noen TV-er vil gjøre dette automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel films en internationaal materiaal af met de oorspronkelijke beeldsnelheid. Sommige televisies doen dit automatisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj film i zawartość międzynarodową z oryginalną częstotliwością klatek. Niektóre telewizory robią to automatycznie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduza filmes e conteúdo internacional com a taxa de atualização original. Algumas televisões fazem isso automaticamente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo internacional e cinematográfico é reproduzido com a taxa de fotogramas original. Em algumas televisões, esta opção é automática."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redați conținutul filmelor și conținutul internațional la frecvența de cadre inițială a acestora. Unele televizoare fac acest lucru automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводите фильмы и международный контент с их исходной частотой кадров. Некоторые телевизоры выполняют это автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehrá filmový a medzinárodný obsah s pôvodnou frekvenciou snímok. Niektoré televízory to robia automaticky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvajajte film in mednarodno vsebino v izvirni hitrosti sličic. Nekateri televizorji to izvedejo samodejno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela upp film och internationellt innehåll med den ursprungliga bildfrekvensen. Vissa TV-apparater gör detta automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นฟิล์มและเนื้อหาระหว่างประเทศด้วยอัตราเฟรมของเนื้อหาต้นฉบับ โทรทัศน์บางเครื่องทำเช่นนี้อยู่แล้วโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmleri ve uluslararası içeriği özgün kare hızında oynatır. Bazı televizyonlar bunu otomatik olarak yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюйте фільми й міжнародний вміст з оригінальною частотою кадрів. Деякі телевізори роблять це автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát phim và nội dung quốc tế bằng tốc độ khung hình gốc. Một số tivi tự động thực hiện việc này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "以原始帧速率播放影片和国际内容。部分电视机会自动以此方式执行。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以原始格率播放影片和國際影音內容。部份電視會自行調整。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以原始影格率播放影片和國際影音內容。部分電視會自行調整。"
          }
        }
      }
    },
