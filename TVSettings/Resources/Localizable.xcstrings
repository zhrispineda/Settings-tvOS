          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV는 감독 중인 기기이며, ‘%@’에서 이 기기의 인터넷 트래픽을 모니터할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini diselia dan “%@” boleh memantau trafik Internet pada peranti ini."
