        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto, Memori atau seni album Muzik anda. Anda juga boleh berkongsi daripada rangkaian rumah anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorittbildene eller -minnene dine, eller plateomslag fra musikkbiblioteket ditt. Du kan også dele fra hjemmenettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je favoriete foto's, terugblikken of Muziek-albumillustraties. Je kunt ook delen vanuit het netwerk in je woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ulubione zdjęcia, wspomnienia i grafiki albumów muzycznych. Możesz nawet udostępnić rzeczy ze swojej sieci domowej."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos, Memórias ou capas de Álbum Musical que você mais gosta. Você também pode compartilhá‑los da sua rede doméstica."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas fotografias favoritas, recordações ou grafismos de álbuns. Também pode partilhar conteúdos através da rede doméstica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele, amintirile sau ilustrațiile albumelor muzicale preferate. Le puteți partaja și din rețeaua casnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши любимые фото, воспоминания и обложки альбомов из Музыки. Также можно делиться контентом по домашней сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše obľúbené fotky, spomienky a grafiky hudobných albumov. Zdieľať ich môžete aj zo svojej domácej siete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše priljubljene fotografije, spomini ali naslovnica glasbenega albuma. Delite lahko tudi vsebine iz domačega omrežja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina favoritbilder, minnen eller albummaterial från Musik. Du kan även dela från hemnätverket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพโปรด ความทรงจำโปรด หรือภาพหน้าปกอัลบั้มเพลงโปรดของคุณ คุณยังสามารถแชร์จากเครือข่ายภายในบ้านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori fotoğraflarınız, anılarınız veya Müzik albüm kapağınız. Evinizdeki ağdan da paylaşabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Улюблені фотографії, спогади чи обкладинки альбомів із Музики. Можна також поширювати вміст із домашньої мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những bức ảnh, kỷ niệm hoặc hình minh họa album nhạc ưa thích của bạn. Bạn cũng có thể chia sẻ từ mạng gia đình của mình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你喜爱的照片、“回忆”或“音乐”专辑插图。还可从家庭网络共享。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你喜愛的相片、「回憶」或「音樂」專輯插圖。你亦可以從家居網絡共享。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你喜愛的照片、「回憶」或「音樂」專輯插圖。你也可以從家庭網路共享。"
          }
        }
      }
    },
    "SaverSelectionDescriptionPhotosSetUp": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام الصور المفضلة أو الذكريات، يجب إعداد صور iCloud. لاستخدام غلاف ألبوم الموسيقى أو المشاركة من شبكتك المنزلية، انتقل إلى تفضيلات شاشة التوقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilitzar els records i les teves fotos favorites, activa les fotos a l’iCloud. Per utilitzar les il·lustracions dels àlbums de música o compartir contingut de la xarxa local, ves a la configuració de l’estalvi de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li používat své oblíbené fotky, nebo vzpomínky, nastavte si službu Fotky na iCloudu. Chcete‑li používat grafiku hudebních alb nebo sdílení z domácí sítě, přejděte do předvoleb spořiče obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil bruge dine yndlingsfotos eller minder, skal du indstille iCloud‑fotos. Gå til indstillingerne til skærmskåner, hvis du vil bruge albumbilleder eller dele fra dit hjemmenetværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Lieblingsfotos oder Rückblicke zu verwenden, richte „iCloud‑Fotos“ ein. Um Albencover von „Musik“ zu verwenden oder im Netzwerk des Zuhauses geteilte Medien, öffne „Bildschirmschoner“ in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για χρήση των αγαπημένων σας φωτογραφιών ή αναμνήσεων, διαμορφώστε τις Φωτογραφίες iCloud. Για χρήση εξώφυλλου μουσικού άλμπουμ ή κοινοποίηση από το δίκτυο οικίας σας, μεταβείτε στις Προτιμήσεις προφύλαξης οθόνης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use your favorite photos or Memories, set up iCloud Photos. To use Music album art or share from your home network, go to Screen Saver Preferences."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To use your favourite photos or Memories, set up iCloud Photos. To use Music album art or share from your home network, go to Screen Saver Preferences."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To use your favourite photos or Memories, set up iCloud Photos. To use Music album art or share from your home network, go to Screen Saver Preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar tus fotos o recuerdos favoritos, configura Fotos en iCloud. Para usar la ilustración de un álbum de música o compartir contenido desde tu red doméstica, ve a “Preferencias del salvapantallas”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar tus fotos o tus recuerdos favoritos, configura Fotos en iCloud. Para usar las ilustraciones de tus álbumes musicales favoritos o para compartir contenido desde tu red local, ve a Preferencias del protector de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar tus fotos o tus recuerdos favoritos, configura Fotos en iCloud. Para usar las ilustraciones de tus álbumes musicales favoritos o para compartir contenido desde tu red local, ve a Preferencias del protector de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat käyttää suosikkikuviasi tai muistojasi, ota iCloud-kuvat käyttöön. Jos haluat käyttää Musiikki-albumin kuvitusta tai jakaa kotiverkostasi, avaa Näytönsäästäjä-asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser vos photos ou souvenirs préférés, configurez Photos iCloud. Pour utiliser des illustrations d’albums de Musique ou partager du contenu depuis le réseau de votre domicile, accédez aux préférences de l’économiseur d’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser vos photos ou souvenirs préférés, configurez Photos iCloud. Pour utiliser les illustrations d’albums ou partager du contenu à partir du réseau de votre domicile, accédez à « Préférences de l’économiseur d’écran »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש בתמונות או בזיכרונות המועדפים, יש להגדיר את ״תמונות iCloud״. כדי להשתמש בעטיפות אלבומים מ״מוזיקה״ או לשתף פריטים מהרשת הביתית, יש לעבור אל ״העדפות שומר המסך״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पसंदीदा तस्वीरें या यादें इस्तेमाल करने के लिए iCloud तस्वीर सेटअप करें। संगीत ऐल्बम कलाकृति का इस्तेमाल करने या अपने होम नेटवर्क से शेयर करने के लिए स्क्रीन सेवर प्राथमिकता पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabu omiljenih fotografija ili uspomena podesite iCloud fotografije. Za uporabu omota glazbenih albuma ili dijeljenje s kućne mreže idite u postavke Zaštite zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvenc fotói vagy emlékei használatához állítsa be az iCloud‑fotókat. A Zenében található albumborítók használatához vagy az otthoni hálózatból történő megosztásukhoz nyissa meg a Képernyővédők beállításait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan foto atau Memori favorit Anda, atur Foto iCloud. Untuk menggunakan gambar album Musik atau membagikan dari jaringan rumah Anda, buka Preferensi Penghemat Layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare le foto e i ricordi che preferisci, configura “Foto di iCloud”. Per usare le illustrazioni degli album di Musica o condividere contenuti dalla rete domestica, vai alle preferenze del salvaschermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの写真や“メモリー”を使用するには、iCloud写真を設定します。“ミュージック”のアルバムアートを使用したり、ホームネットワークから共有したりするには、スクリーンセーバ環境設定に移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 사진 또는 추억을 사용하려면 iCloud 사진을 설정하십시오. 음악 앨범 표지를 사용하거나 홈 네트워크에서 공유하려면 화면 보호기 환경설정으로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan foto atau Memori kegemaran anda, sediakan Foto iCloud. Untuk menggunakan seni album Muzik atau berkongsi daripada rangkaian rumah anda, pergi ke Keutamaan Penyelamat Skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må klargjøre iCloud Bilder før du kan bruke favorittbildene eller -minnene dine. Gå til Skjermsparervalg hvis du vil bruke plateomslag eller dele fra hjemmenettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Configureer iCloud-foto's om je favoriete foto's of terugblikken te gebruiken. Ga naar de schermbeveiligingsvoorkeuren om Muziek-albumillustraties te gebruiken of materiaal te delen vanuit het netwerk in je woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać ulubionych zdjęć lub wspomnień, skonfiguruj Zdjęcia w iCloud. Aby użyć grafiki albumu muzycznego lub udostępnić z sieci domowej, przejdź do preferencji wygaszacza ekranu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar suas fotos ou Memórias favoritas, configure as Fotos do iCloud. Para usar a capa de álbuns do app Música ou compartilhar da sua rede doméstica, acesse as Preferências de Protetor de Tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar as suas fotografias favoritas ou recordações, configure Fotografias em iCloud. Para usar grafismos de álbuns ou partilhar através da rede doméstica, aceda às preferências de proteção de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a utiliza pozele sau amintirile favorite, configurați Poze iCloud. Pentru a utiliza ilustrațiile albumelor muzicale sau pentru a partaja din rețeaua casnică, accesați preferințele pentru screensaver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать избранные фото и воспоминания, настройте Фото iCloud. Чтобы использовать обложки альбомов из Музыки или делиться контентом по домашней сети, перейдите в Настройки заставок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať svoje obľúbené fotky alebo spomienky, nastavte si službu iCloud Fotky. Ak chcete používať grafiku z hudobných albumov alebo zdieľanie z domácej siete, prejdite do nastavení šetriča obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo priljubljenih fotografij ali spominov nastavite Fotografije iCloud. Za uporabo naslovnice glasbenega albuma ali deljenje vsebin iz domačega omrežja odprite Nastavitve ohranjevalnika zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in iCloud-bilder om du vill visa dina favoritbilder och minnen. Om du vill använda albummaterial från Musik eller dela från hemnätverket öppnar du inställningarna för skärmsläckare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการใช้รูปภาพหรือความทรงจำโปรดของคุณ ให้ตั้งค่า “รูปภาพ iCloud” ในการใช้ภาพหน้าปกอัลบั้มเพลงหรือแชร์จากเครือข่ายภายในบ้านของคุณ ให้ไปที่การตั้งค่าภาพพักหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori fotoğraflarınızı veya anılarınızı kullanmak için iCloud Fotoğrafları’nı ayarlayın. Müzik albüm kapağınızı kullanmak veya evinizdeki ağdan paylaşmak için Ekran Koruyucu tercihlerine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб переглядати улюблені фотографії чи спогади, налаштуйте Фото iCloud. Щоб переглядати обкладинки альбомів із музичної колекції чи вміст із домашньої мережі, перейдіть у Параметри екранної заставки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sử dụng ảnh hoặc kỷ niệm ưa thích của bạn, hãy thiết lập Ảnh iCloud. Để sử dụng hình minh họa album nhạc hoặc chia sẻ từ mạng gia đình của bạn, hãy đi tới Tùy chọn Trình bảo vệ màn hình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用喜爱的照片或“回忆”，请设置iCloud照片。若要使用“音乐”专辑插图或从家庭网络共享，请前往“屏幕保护程序”偏好设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要使用你喜愛的相片或「回憶」，請設定「iCloud相片」。如要使用「音樂」專輯插圖或從你的家居網絡共享，請前往「螢幕保護程式」的「偏好設定」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用你喜愛的照片或「回憶」，請設定「iCloud照片」。若要使用「音樂」專輯插圖或從你的家庭網路共享，請前往「螢幕保護程式」的偏好設定。"
          }
        }
      }
    },
