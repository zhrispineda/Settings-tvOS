        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns nya tidszoner som kommer att installeras nästa gång Apple TV startar om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการกำหนดไทม์โซนใหม่ซึ่งจะติดตั้งครั้งถัดไปเมื่อ Apple TV ของคุณเริ่มการทำงานเครื่องใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
