        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulátor nepodporuje ďalšie profily. Použite Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni profili niso podprti v simulatorju. Uporabite napravo Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ytterligare profiler stöds inte på simulatorn. Använd en Apple TV-enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รองรับโปรไฟล์เพิ่มเติมบนโปรแกรมจำลอง โปรดใช้อุปกรณ์ Apple TV"
