    "SiriAvailableMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدك Siri على إنجاز الأشياء بمجرد الطلب. يمكنك البحث عن الأفلام وتمكين التعليقات المصاحبة وتفقد معلومات الطقس والمزيد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri t’ajuda a fer coses; només has de demanar‑li‑ho. Pots cercar pel·lícules, activar els subtítols descriptius, consultar el temps que farà i altres coses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vám pomáhá provádět úlohy tak, že prostě řeknete, co chcete udělat. Můžete vyhledat filmy, zapnout titulky, zjistit, jaká je předpověď počasí, a mnoho dalšího."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed Siri om at hjælpe dig med ting. Du kan søge efter film, slå closed captioning til eller tjekke vejrudsigten m.m."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri hilft dir beim Erledigen von Aufgaben, indem du einfach fragst. Du kannst nach Filmen suchen, erweiterte Untertitel aktivieren, den Wetterbericht abfragen und vieles mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Siri σάς βοηθά να πραγματοποιείτε διάφορες ενέργειες, αρκεί απλώς να το ζητήσετε. Μπορείτε να το χρησιμοποιήσετε για αναζήτηση ταινιών, ενεργοποίηση κλειστών λεζαντών, εμφάνιση του καιρού, και πολλά ακόμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri helps you get things done just by asking. You can search for movies, enable closed captioning, check the weather, and more."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri helps you get things done just by asking. You can search for movies, enable closed captioning, check the weather and more."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri helps you get things done just by asking. You can search for movies, enable closed captioning, check the weather and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri te ayuda a llevar a cabo tareas con tan solo pedirlo. Puedes buscar una película, activar los subtítulos, consultar la previsión del tiempo y mucho más."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri te ayuda con tan sólo pedírselo. Puedes buscar películas, activar subtítulos, revisar el clima y más."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri te ayuda con tan sólo pedírselo. Puedes buscar películas, activar subtítulos, revisar el clima y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirin avulla saat asioita aikaan pelkän kysymyksen avulla. Voit etsiä elokuvia, ottaa käyttöön kuvailevan tekstityksen, tarkistaa säätiedot ja muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vous aide à être plus efficace, il vous suffit de demander. Vous pouvez rechercher des films, activer les sous-titres codés ou encore consulter la météo."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Siri, il vous suffit de demander. Vous pouvez rechercher des films, activer les sous-titres, consulter la météo et plus encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לקבל עזרה מ-Siri בביצוע פעולות באמצעות בקשה פשוטה. למשל, ניתן לחפש סרטים, להפעיל כתוביות, לבדוק את מזג האוויר ועוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri की मदद से आप केवल बोलकर भी काम करवा सकते हैं। आप फ़िल्में ढूँढ सकते हैं, क्लोज़्ड कैप्शनिंग सक्षम कर सकते हैं और मौसम संबंधी जानकारी पाने सहित अन्य काम कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri pomaže u obavljanju zadataka čim to zatražite. Možete potražiti filmove, uključiti proširene titlove, provjeriti vremensku prognozu i još mnogo toga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak egy szavába kerül, és Siri segítségével mindent elintézhet. Kereshet filmeket, engedélyezheti a szöveges átiratokat, megtekintheti az időjárást és egyebeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri membantu Anda menyelesaikan sesuatu hanya dengan meminta. Anda dapat mencari film, mengaktifkan teks tertulis, memeriksa cuaca, dan lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ti aiuta a svolgere attività con una semplice richiesta. Puoi cercare film, abilitare i sottotitoli, controllare il meteo e molto altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriは話しかけるだけでやりたいことを手伝ってくれます。映画を検索したり、クローズドキャプションを有効にしたり、天気を調べたり、さまざまなことを実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 요청만으로도 Siri에게 다양한 작업을 맡길 수 있습니다. 영화를 검색하거나, 청각 장애인용 자막을 활성화하거나, 날씨를 확인하는 등 많은 작업을 수행할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri membantu anda menyelesaikan tugas dengan hanya meminta. Anda boleh menyemak cuaca dan banyak lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Be Siri om å utføre oppgaver for deg. Du kan blant annet søke etter filmer, aktivere skjult teksting, sjekke været og mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri kan je met van alles helpen. Je hoeft er alleen maar om te vragen. Zo kun je onder andere naar films zoeken, bijschriften voor spraak en geluiden inschakelen of de weersverwachting opvragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri wykonuje Twoje polecenia głosowe. Możesz, na przykład, szukać filmów, włączać napisy dla niesłyszących czy sprawdzać pogodę."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri ajuda você a realizar ações através de perguntas. Você pode buscar filmes, ativar as legendas ocultas, verificar a previsão do tempo e mais."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ajuda a tratar de tudo – é só pedir. Pode procurar filmes, ativar a legendagem opcional, consultar o estado do tempo e muito mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vă ajută să realizați o acțiune printr‑o simplă solicitare. Puteți să căutați filme, să activați subtitrările complexe, să aflați starea vremii și multe altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri помогает выполнять различные действия простыми запросами. Можно найти фильмы, включить скрытые субтитры, а также узнать прогноз погоды и многое другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vám umožňuje vykonávať úlohy tak, že jednoducho poviete, čo chcete spraviť. Môžete vyhľadávať filmy, povoliť skryté titulky, pozrieť si predpoveď počasia a vykonávať ďalšie úlohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri vam pomaga pri vaših opravilih, le naročiti ji morate. Lahko iščete filme, omogočite podnapise, preverite vreme in še več."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Siri får du saker gjorda genom att helt enkelt be om dem. Du kan söka efter filmer, aktivera dold textning, kolla vädret med mera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ช่วยทำอะไรได้หลายอย่างเพียงแค่คุณบอก คุณสามารถค้นหาภาพยนตร์ เปิดใช้งานคำบรรยายภาพ เช็คสภาพอากาศ และอื่นๆ ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri’den işlerinizi gerçekleştirmeye yardımcı olmasını istemeniz yeterli. Filmleri aratabilir, açıklamalı altyazıları etkinleştirebilir, hava durumunu vb. denetleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri допоможе виконати багато завдань, лише попросіть. Можна шукати фільми, увімкнути субтитри, перевірити прогноз погоди тощо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri giúp bạn thực hiện mọi việc chỉ bằng việc hỏi. Bạn có thể tìm kiếm phim, bật chú thích chi tiết, kiểm tra thời tiết, v.v."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只需发出语音指令，就可让Siri帮助你完成任务。你可以搜索电影、启用隐藏式字幕、查看天气及进行更多操作。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只要説出指令，Siri便會幫你完成任務。你可以搜尋電影、啟用隱藏式字幕或查詢天氣等。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只要你說一聲，Siri便可以幫你搞定大小事。你可以搜尋電影、啟用隱藏式字幕或查詢天氣等內容。"
          }
        }
      }
    },
