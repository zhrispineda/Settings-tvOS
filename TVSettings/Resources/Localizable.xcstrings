        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hồ sơ mới vào Apple TV này để truy cập các chương trình, phim, mục Tiếp tục xem, dữ liệu ứng dụng trong iCloud và tài khoản Game Center của họ."
          }
