        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på fra iPhone for å dele iCloud-data med Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je iPhone om in te loggen om iCloud-gegevens te delen met deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
