        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" supervisa este Apple TV y puede observar el tráfico de Internet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä Apple TV:tä valvotaan. %@ voi tarkkailla tämän laitteen internet-liikennettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV est supervisée, et « %@ » peut surveiller le trafic Internet sur cet appareil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV est supervisée, et « %@ » peut surveiller le trafic Internet de cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Apple TV זה נמצא תחת פיקוח, ובאפשרות ״%@״ לנטר את תעבורת האינטרנט במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Apple TV पर्यवेक्षित है और “%@” द्वारा इस डिवाइस पर इंटरनेट ट्रैफ़िक की निगरानी रखी जा सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Apple TV je pod nadzorom i \"%@\" može pratiti internetski promet na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy felügyelt Apple TV. A(z) „%@” figyelheti az internetforgalmat ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini diawasi dan “%@” dapat memonitor lalu lintas internet di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV è supervisionata. “%@” può monitorare il traffico internet su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
