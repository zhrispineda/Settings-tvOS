    "SiriHistoryDescriptionOptedIn": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف تفاعلات Siri والإملاء المرتبطة حاليًا بهذا الـ Apple TV من خوادم Apple. أما البيانات المأخوذة كعينة للمساعدة في تحسين Siri والإملاء، فلم تعد مرتبطة بهذا الـ Apple TV ولن تُحذف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina dels servidors d’Apple les interaccions de Siri i del dictat que estiguin associades a l’Apple TV. Les dades que s’hagin analitzat per ajudar a millorar Siri i el dictat ja no estan associades a l’Apple TV i no s’eliminaran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce smaže ze serverů Apple informace o komunikaci se Siri a s funkcí diktování, které jsou nyní přidružené k této Apple TV. Data navzorkovaná za účelem zlepšování Siri a diktování už k této Apple TV přidružená nejsou a smazána nebudou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet interaktioner med Siri og Diktering, der er knyttet til dette Apple TV, fra Apples servere. Data, der er blevet indsamlet med henblik på at forbedre Siri og Diktering, er ikke længere knyttet til dette Apple TV og bliver ikke slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche mit diesem Apple TV verknüpfte Interaktionen mit Siri und der Diktierfunktion von den Apple-Servern. Daraus gewonnene Daten zur Verbesserung von Siri und der Diktierfunktion werden nicht mehr mit diesem Apple TV verknüpft und werden nicht gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή των αλληλεπιδράσεών σας με το Siri και την Υπαγόρευση που είναι συσχετισμένες με αυτό το Apple TV από τους διακομιστές της Apple. Τα δείγματα δεδομένων που χρησιμοποιήθηκαν για τη βελτίωση του Siri και της Υπαγόρευσης δεν είναι πλέον συσχετισμένα με αυτό το Apple TV και δεν θα διαγραφούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Siri & Dictation interactions currently associated with this Apple TV from Apple servers. Data that has been sampled to help improve Siri and Dictation is no longer associated with this Apple TV and will not be deleted."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Siri and Dictation interactions currently associated with this Apple TV from Apple servers. Data that has been sampled to help improve Siri and Dictation is no longer associated with this Apple TV and will not be deleted."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Siri & Dictation interactions currently associated with this Apple TV from Apple servers. Data that has been sampled to help improve Siri and Dictation is no longer associated with this Apple TV and will not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de los servidores de Apple las interacciones de Siri y Dictado actualmente asociadas con este Apple TV. Los datos usados para ayudar a mejorar Siri y Dictado ya no están asociados a este Apple TV y no se eliminarán."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las interacciones de Siri y el dictado asociadas actualmente con este Apple TV de los servidores de Apple. Las muestras que se tomaron para ayudar a mejorar Siri y Dictado ya no están asociadas con este Apple TV y no se eliminarán."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las interacciones de Siri y el dictado asociadas actualmente con este Apple TV de los servidores de Apple. Las muestras que se tomaron para ayudar a mejorar Siri y Dictado ya no están asociadas con este Apple TV y no se eliminarán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tähän Apple TV:hen liitetyt Siri-keskustelut ja sanelutoiminnot Applen palvelimilta. Tietoja, joita on käytetty Sirin ja sanelun parantamiseen, ei enää liitetä tähän Apple TV:hen eikä niitä poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les interactions avec Siri et Dictée actuellement associées à cette Apple TV des serveurs Apple. Les données recueillies en vue d’améliorer Siri et Dictée ne sont plus associées à cette Apple TV et ne seront pas supprimées."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les interactions avec Siri et Dictée actuellement associées à cette Apple TV des serveurs d’Apple. Les données qui ont été échantillonnées pour contribuer à l’amélioration de Siri et de Dictée ne sont plus associées à cette Apple TV et ne seront pas supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן למחוק מהשרתים של Apple את האינטראקציות עם Siri ועם ״הכתבה״ שמקושרות כרגע ל-Apple TV זה. מידע שנדגם כדי לשפר את Siri ו״הכתבה״ כבר לא מקושר עם Apple TV זה ולא יימחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple सर्वर से इस Apple TV के साथ अभी संबद्ध Siri और डिक्टेशन इंटरऐक्शन को डिलीट करें। Siri और डिक्टेशन को बेहतर बनाने में मदद करने के लिए नमूने के रूप में लिया गया डेटा अब इस Apple TV से संबद्ध नहीं किया जाता है और उसे डिलीट नहीं किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrišite interakcije sa Siri i Diktatom koje su trenutačno povezane s ovim Apple TV-om s Appleovih servera. Podaci koji su uzorkovani radi poboljšanja Siri i Diktata više nisu povezani s ovim Apple TV-om i neće biti obrisani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölheti az Apple szervereiről a Sirivel és a Diktálással végzett olyan műveleteket, amelyek jelenleg ezzel az Apple TV-vel vannak társítva. A Siri és a Diktálás továbbfejlesztése céljából mintavételezett adatok nincsenek többé ezzel az Apple TV-vel társítva, és nem lesznek törölve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus interaksi Siri & Dikte yang saat ini dikaitkan dengan Apple TV ini dari server Apple. Data yang telah dibuat sampel untuk membantu meningkatkan Siri dan Dikte tidak lagi dikaitkan dengan Apple TV ini dan tidak akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina dai server Apple le interazioni con Siri e Dettatura attualmente associate a questa Apple TV. I dati campione raccolti per migliorare Siri e Dettatura non saranno più associati a questa Apple TV e non verranno eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVに現在関連付けられているSiriと音声入力に対する操作の音声をAppleのサーバから削除します。Siriと音声入力の改善のためにサンプリングが済んでいるデータは、このApple TVとの関連付けはすでに解除されていて削除はされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 서버에서 현재 이 Apple TV와 관련된 Siri 및 받아쓰기 상호 작용을 삭제합니다. Siri 및 받아쓰기 기능을 향상하기 위해 샘플링된 데이터는 더 이상 이 Apple TV와 연계되지 않지만 삭제되지는 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam interaksi Siri & Perencanaan yang pada masa ini dikaitkan dengan Apple TV ini daripada pelayan Apple. Data yang telah disampel untuk membantu meningkatkan Siri dan Perencanaan tidak lagi dikaitkan dengan Apple TV ini serta tidak akan dipadamkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett Siri- og Diktering-interaksjon som er tilknyttet denne Apple TV-enheten, fra Apples tjenere. Dataprøver som har blitt innhentet for å hjelpe med å forbedre Siri og Diktering, er ikke lenger tilknyttet denne Apple TV-enheten og vil ikke bli slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder interacties met Siri en de dicteerfunctie die momenteel met deze Apple TV zijn geassocieerd van de Apple servers. Gegevens die zijn gesampled om Siri en de dicteer­functie te verbeteren, zijn dan niet meer geassocieerd met deze Apple TV en worden niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń interakcje z Siri i funkcją Dyktowanie powiązane obecnie z tym Apple TV z serwerów Apple. Dane, na których przeprowadzono próbkowanie na potrzeby udoskonalania Siri i funkcji Dyktowanie, nie są już powiązane z tym Apple TV i nie zostaną usunięte."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague as interações com a Siri e o Ditado associadas atualmente a esta Apple TV dos servidores da Apple. Os dados transformados em amostras para melhorar a Siri e o Ditado não estão mais associados a esta Apple TV e não serão apagados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar dos servidores da Apple as interações com Siri e o Ditado atualmente associadas a esta Apple TV. As amostras de dados que foram usadas para ajudar a melhorar Siri e o Ditado já não estão associadas a esta Apple TV e não serão apagadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți de pe serverele Apple interacțiunile care implică Siri și dictarea asociate în prezent cu acest Apple TV. Datele care au fost eșantionate pentru a susține îmbunătățirea funcționalităților Siri și Dictare nu mai sunt asociate cu acest Apple TV și nu vor fi șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить с серверов Apple данные взаимодействия с Siri и Диктовкой, ассоциированные с этим Apple TV. Данные, отобранные для использования в целях улучшения Siri и Диктовки, не ассоциированы с этим Apple TV, поэтому не будут удалены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazať interakcie so Siri a Diktovaním priradené k tomuto Apple TV zo serverov spoločnosti Apple. Dáta, ktoré boli vybrané na vylepšovanie Siri a Diktovania, už nie sú priradené k tomuto Apple TV a nebudú vymazané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišite interakcije s Siri in funkcijo Narekovanje, ki so trenutno povezane s tem Apple TV-jem, iz strežnikov Apple. Podatki, ki so bili vzorčeni za izboljšanje Siri in funkcije Narekovanje, niso več povezani s tem Apple TV-jem in ne bodo izbrisani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera Siri- och dikteringsinteraktioner som för närvarande är associerade med denna Apple TV från Apple-servrar. Data som har använts till att hjälpa till att förbättra Siri och diktering är inte längre associerade med denna Apple TV och kommer inte att raderas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบการโต้ตอบกับ Siri และการป้อนตามคำบอกที่ปัจจุบันนี้ผูกกับ Apple TV เครื่องนี้ออกจากเซิร์ฟเวอร์ Apple ข้อมูลที่ถูกสุ่มตัวอย่างเพื่อช่วยปรับปรุง Siri และการป้อนตามคำบอกไม่ผูกกับ Apple TV เครื่องนี้อีกต่อไปและจะไม่ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV ile ilişkili Siri ve Dikte etkileşimlerini Apple sunucularından siler. Siri’yi ve Dikte’yi iyileştirmeye yardımcı olmak için örneklenen veriler artık bu Apple TV ile ilişkili değildir ve silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити взаємодії із Siri й Диктуванням, наразі повʼязані з цим Apple TV, із серверів Apple. Зразки даних, дібрані для вдосконалення Siri й Диктування, більше не повʼязуватимуться з цим Apple TV й не видалятимуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các tương tác Siri & Đọc chính tả hiện được liên kết với Apple TV này khỏi các máy chủ của Apple. Dữ liệu đã được lấy mẫu để giúp cải tiến Siri và Đọc chính tả không được liên kết với Apple TV này nữa và sẽ không bị xóa."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从Apple服务器上删除当前与这台Apple TV关联的Siri与听写交互。用于协助改进Siri和听写的采样数据将不再与这台Apple TV关联，且不会被删除。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從Apple伺服器刪除目前連繫至此Apple TV的「Siri與聽寫」互動內容。用來改進「Siri與聽寫」的已取樣資料已不再連繫至此Apple TV，且不會被刪除。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從Apple伺服器刪除目前與此Apple TV相關的「Siri與聽寫」互動內容。用來協助改進Siri和「聽寫」的已取樣資料不會與此Apple TV產生關聯，但不會被刪除。"
          }
        }
      }
    },
