    "OSBetaSoftwareEnrollConfirmMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب في الحصول على تحديثات برامج تجريبية على هذا الـ Apple TV كجزء من برنامج Apple Beta Software؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols rebre actualitzacions de programari beta en aquest Apple TV com a part del programa Apple Beta Software?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete na Apple TV v rámci Apple Beta Software Programu stahovat aktualizace betaverzí softwaru?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du modtage offentlige betasoftwareopdateringer på dette Apple TV, som en del af Apple Beta Software Program?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du auf diesem Apple TV Beta-Softwareupdates als Teil des Apple-Beta-Softwareprogramms laden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε να λαμβάνετε ενημερώσεις λογισμικού beta σε αυτό το Apple TV ως μέρος του Προγράμματος Apple Beta Software;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to get beta software updates on this Apple TV as part of the Apple Beta Software Program?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to get beta software updates on this Apple TV as part of the Apple Beta Software Program?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to get beta software updates on this Apple TV as part of the Apple Beta Software Programme?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres obtener actualizaciones de software beta en este Apple TV como parte del programa Apple Beta Software?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres obtener actualizaciones de software beta en este Apple TV como parte del programa Apple Beta Software?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres obtener actualizaciones de software beta en este Apple TV como parte del programa Apple Beta Software?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko betaohjelmistopäivityksiä tähän Apple TV:hen osana Apple Beta Software Program -ohjelmaa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous recevoir les mises à jour de logiciels bêta sur cette Apple TV dans le cadre du programme de logiciels bêta d’Apple ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous obtenir les mises à jour des logiciels bêta sur cette Apple TV dans le cadre du programme de logiciels bêta d’Apple?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך לקבל עדכוני תוכנת בטא ב-Apple TV זה כחלק מתוכנית Apple Beta Software‏?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप Apple Beta Software प्रोग्राम के हिस्से के रूप में इस Apple TV पर बीटा सॉफ़्टवेयर अपडेट प्राप्त करना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite li primati beta ažuriranja softvera na ovaj Apple TV kao dio Apple Beta Software programa?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Le szeretne tölteni bétaszoftver-frissítéseket ezen az Apple TV-n az Apple Beta Software program részeként?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda ingin mendapatkan pembaruan perangkat lunak beta di Apple TV ini sebagai bagian dari Program Apple Beta Software?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi ricevere aggiornamenti relativi alle versioni beta del software su Apple TV in quanto parte dell’Apple Beta Software Program?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software Programの一環として、このApple TV用にベータ版のソフトウェアを入手しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 베타 소프트웨어 프로그램의 일부로 이 Apple TV에 공개 베타 소프트웨어 업데이트를 받겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda mahu mendapatkan kemas kini perisian beta pada Apple TV ini sebagai sebahagian daripada Program Apple Beta Software?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du hente betaversjoner av Apple TV-programvaren som del av Apple Beta Software-programmet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je bètasoftware-updates ontvangen op deze Apple TV als onderdeel van het Apple Beta Software-programma?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz otrzymywać uaktualnienia oprogramowania w wersji beta na tym Apple TV w ramach Apple Beta Software Program?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseja obter atualizações de software beta nesta Apple TV como parte do Programa Apple Beta Software?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de obter atualizações das versões beta de software nesta Apple TV, no âmbito do Apple Beta Software Program?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doriți să primiți actualizări software beta pe acest Apple TV ca parte a programului Apple Beta Software?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите получать на этом Apple TV бета‑версии обновлений ПО в качестве участника Программы бета-тестирования Apple?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete v rámci Apple Beta Software Programu na tomto Apple TV získavať aktualizácie beta verzií softvéru?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite prejemati posodobitve beta programske opreme za ta Apple TV v okviru programa Apple Beta Software?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du få betaversioner av programvara på denna Apple TV som en del av Apple Beta Software Program?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องการรับซอฟต์แวร์รุ่นเบต้าบน Apple TV เครื่องนี้ในฐานะที่เป็นส่วนหนึ่งของโปรแกรม Apple Beta Software หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software Programı’nın bir parçası olarak bu Apple TV’de beta yazılımı güncellemelerini almak istiyor musunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримувати оновлення бета-версій ПЗ на цьому Apple TV у рамках Програми бета-тестування Apple Beta Software?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có muốn nhận các bản cập nhật phần mềm beta trên Apple TV này như một phần của Chương trình Apple Beta Software không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你要在此Apple TV上获取作为Apple Beta版软件计划一部分的Beta版软件更新吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "作為「Apple Beta Software計劃」的一部份，你希望在此Apple TV上取得Beta軟件更新嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要在此Apple TV上取得Beta版軟體更新嗎（「Apple Beta版軟體計畫」的一部分）？"
          }
        }
      }
    },
