    "SettingsFavoritesSortOffDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لترتيب برامج التلفزيون في المفضلة، حدد برنامج التلفزيون الذي ترغب في نقله، واضغط مطولاً على سطح اللمس إلى أن يهتز برنامج التلفزيون، ثم قم بالتمرير لترتيبه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ordenar les sèries favorites, selecciona la que vols moure, mantén premuda la superfície tàctil fins que la sèrie comenci a tremolar i arrossega‑la on vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li seřadit seriály v Oblíbených, vyberte seriál, který chcete přesunout, podržte prst na dotykovém povrchu, dokud se seriál nezačne třást, a potom ho přetáhněte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du flytter rundt på tv-udsendelser i dine favoritter ved at vælge de tv-udsendelser, du vil flytte, og derefter holde en finger på berøringsoverfladen, indtil tv-udsendelsen begynder at vrikke. Derefter skal du skubbe for at flytte rundt på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anordnen von TV-Sendungen in den Favoriten wähle die TV-Sendung aus, die verschoben werden soll, lege den Finger auf die Berührungsfläche, bis die TV-Sendung zu wackeln beginnt, und bewege sie durch Streichen an die gewünschte Position."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για διευθέτηση τηλεοπτικών εκπομπών στα Αγαπημένα σας, επιλέξτε την εκπομπή που θέλετε να μετακινήσετε, κρατήστε πατημένη την επιφάνεια αφής μέχρι να αρχίσει να αναπηδά η εκπομπή και μετά σαρώστε για να την τακτοποιήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To arrange TV shows in your Favorites, select the TV show you want to move, press and hold the Touch surface until the TV show jiggles, then swipe to arrange it."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To arrange TV shows in your Favourites, select the TV show you want to move, press and hold the Touch surface until the TV show jiggles, then swipe to arrange it."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To arrange TV shows in your Favourites, select the TV show you want to move, press and hold the Touch surface until the TV show jiggles, then swipe to arrange it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ordenar tus series favoritas, selecciona la que quieras mover, mantén pulsada la superficie táctil hasta que la serie empiece a temblar y arrástrala adonde quieras."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ordenar programas de TV en tus Favoritos, selecciona el programa que quieres trasladar, presiona sin soltar la superficie táctil hasta que el programa comience a agitarse y desliza para acomodarlo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ordenar programas de TV en tus Favoritos, selecciona el programa que quieres trasladar, presiona sin soltar la superficie táctil hasta que el programa comience a agitarse y desliza para acomodarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä TV-ohjelmat suosikeissa valitsemalla TV-ohjelma, jonka haluat siirtää, paina ja pidä painettuna kosketuspintaa kunnes ohjelma alkaa heilua, ja järjestä se pyyhkäisemällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour réorganiser les séries TV dans vos favoris, sélectionnez une série TV à déplacer, maintenez votre doigt sur la surface tactile jusqu’à ce que la série vibre puis faites-la glisser."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour organiser les émissions de télévision dans vos Favoris, sélectionnez l’émission que vous souhaitez déplacer, appuyez sur la surface tactile de façon prolongée jusqu’à ce que l’émission commence à remuer, puis balayez-la pour la déplacer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לסדר תוכניות טלוויזיה ב״מועדפים״, יש לבחור בתוכנית הטלוויזיה שברצונך להזיז, ללחוץ על המשטח ולהחזיק עד שהתוכנית תחל לרעוד. לאחר מכן, יש להחליק כדי לסדר אותה במקום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा में टीवी कार्यक्रमों को व्यवस्थित करने के लिए उस टीवी कार्यक्रम को चुनें जिसे आप ट्रांसफ़र करना चाहते हैं, टच सतह को दबाएँ और तब तक दबाए रखें जब तक वह टीवी कार्यक्रम हिलने ना लगे फिर उसे व्यवस्थित करने के लिए स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za razvrstavanje TV emisija u mapi Omiljeno, označite TV emisiju koju želite premjestiti, pritisnite i zadržite dodirnu površinu sve dok TV emisija ne počne podrhtavati, zatim je povucite na željeno mjesto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kedvencekben lévő tv-műsorok rendezéséhez jelölje ki az áthelyezni kívánt tv-műsort, tartsa megnyomva az érintőfelületet, amíg a tv-műsor remegni nem kezd, majd legyintsen a rendezéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyusun acara TV di Favorit Anda, pilih acara TV yang ingin Anda pindahkan, tekan dan tahan permukaan Sentuh hingga acara TV berguncang, lalu gesek untuk menyusunnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per organizzare i programmi TV nella sezione Preferiti, seleziona l’elemento che desideri spostare, tieni premuta la superficie touch del telecomando fino a quando il titolo non inizia a muoversi, quindi sposta il programma TV dove preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“お気に入り”のテレビ番組を並べ替えるには、移動したいテレビ番組を選択し、テレビ番組が波打ち始めるまでタッチサーフェスを押さえたままにしてから、スワイプして並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기에서 TV 프로그램을 정렬하려면 이동할 TV 프로그램을 선택하고 TV 프로그램이 흔들릴때까지 터치 표면을 길게 누른 다음 밀어서 정렬하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyusun rancangan TV dalam Kegemaran anda, pilih rancangan TV yang anda mahu alihkan, tekan dan tahan permukaan Sentuh sehingga rancangan TV bergoyang, kemudian leret untuk menyusunnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan organisere TV-programmer i favorittlisten din ved å velge TV-programmet du vil flytte, trykke på og holde inne berøringsflaten til symbolet begynner å skjelve, og sveipe mot høyre eller venstre for å flytte det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om tv-programma's in je favorieten te rangschikken, selecteer je het tv-programma dat je wilt verplaatsen en houd je het aanraakoppervlak ingedrukt totdat het tv-programma trilt. Veeg vervolgens om het te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uporządkować programy TV w Ulubionych, zaznacz program TV do przeniesienia, naciśnij i przytrzymaj powierzchnię dotykową, aż program zacznie drgać, a następnie przeciągnij go w nowe miejsce."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para organizar os programas de TV nos seus Favoritos, selecione o programa de TV que deseja mover, pressione a superfície de Toque e mantenha-a pressionada até que o programa de TV comece a tremer e arraste para organizar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para organizar os programas de TV nos Favoritos, selecione o programa que pretende mover, mantenha premida a superfície táctil até o programa começar a abanar e, depois, passe o dedo para reorganizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a aranja emisiunile TV din Favorite, selectați emisiunea TV pe care doriți să o mutați, țineți apăsată suprafața tactilă până când emisiunea TV începe să tremure, apoi glisați pentru a o aranja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы изменить расположение телешоу в разделе «Избранное», выберите телешоу, которое хотите переместить, нажмите и удерживайте сенсорную поверхность, пока телешоу не начнет покачиваться, а затем расположите его жестом смахивания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete usporiadať TV seriály vo svojich obľúbených položkách, vyberte TV seriál, ktorý chcete presunúť, stlačte a podržte dotykový povrch, až kým sa TV seriál nezačne chvieť, a potom ho potiahnite na požadované miesto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite urediti televizijske oddaje v mapi Priljubljeno, izberite televizijsko oddajo, ki jo želite premakniti, pritisnite in pridržite sledilno ploščico, dokler se televizijska oddaja ne začne tresti, nato pa podrsnite, da jo uredite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill ordna TV-program i favoriter väljer du TV-programmet som du vill flytta, håller ned tryckområdet tills TV-programmet skakar och drar det sedan till önskad plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการจัดเรียงรายการทีวีในรายการโปรดของคุณ ให้เลือกรายการทีวีที่คุณต้องการย้าย กดพื้นผิวระบบสัมผัสค้างไว้จนกระทั่งรายการทีวีสั่น แล้วปัดขึ้นลงเพื่อจัดเรียงรายการทีวีนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorilerinizdeki TV şovlarını düzenlemek için taşımak istediğiniz TV şovunu seçin, TV şovu titreyene kadar Dokunma yüzeyini basılı tutun ve sonra düzenlemek için kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінити порядок телешоу в Улюблених, виберіть телешоу, яке потрібно перемістити, натисніть і утримуйте сенсорну поверхню, доки іконка телешоу не почне тремтіти, а потім перемістіть її в потрібне місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sắp xếp các chương trình TV trong Mục ưa thích, chọn chương trình TV bạn muốn di chuyển, nhấn và giữ bề mặt cảm ứng cho tới khi chương trình TV rung lắc, sau đó vuốt để sắp xếp."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要排列“个人收藏”中的电视节目，请选择你想移动的电视节目，按住触控表面直至电视节目开始抖动，再轻扫以排列。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要排列「喜好項目」中的電視節目，請選擇要移動的電視節目，按住「觸控」表面直至電視節目搖動，然後輕掃以排列。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在「喜好項目」中排列電視節目，請選取要搬移的電視節目，按住觸控表面，直到電視節目開始搖動為止，然後滑動來排列。"
          }
        }
      }
    },
    "SettingsKeyBoardBTPairingInstructionsFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز الاقتران على \"%@\"، ثم اضغط على مفتاح الرجوع أو الإدخال."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el codi d’enllaç a “%@” i prem la tecla de retorn o d’introducció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte párovací kód na zařízení „%@“ a stiskněte klávesu Return nebo Enter."
          }
        },
        "da": {
