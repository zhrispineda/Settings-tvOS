    "SaverBackdropPhotosDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الصور أو الذكريات أو أغلفة ألبومات الموسيقى المفضلة. يمكنك أيضًا المشاركة من شبكتك المنزلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria les fotos, els records o les il·lustracions dels àlbums de música que més t'agradin. També pots compartir contingut de la xarxa de casa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte oblíbené fotky, vzpomínky nebo grafiku alb z aplikace Hudba. Můžete také sdílet fotky ze své domácí sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dine yndlingsfotos, minder eller albumbilleder. Du kan også dele fra dit hjemmenetværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine Lieblingsfotos, Rückblicke oder Albencover von „Musik“. Du kannst auch über dein Privatnetzwerk teilen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τις αγαπημένες σας φωτογραφίες, αναμνήσεις ή εξώφυλλα μουσικών άλμπουμ. Μπορείτε επίσης να πραγματοποιήσετε κοινοποίηση από το οικιακό σας δίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your favorite photos, Memories, or Music album art. You can also share from your home network."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your favourite photos, Memories or Music album art. You can also share from your home network."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your favourite photos, Memories or Music album art. You can also share from your home network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona las fotos, los recuerdos o las ilustraciones de álbumes de música que más te gusten. También puedes compartir contenido desde tu red doméstica."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las fotos, recuerdos o ilustraciones de álbumes de música que más te gusten. También puedes compartir contenido de la red de tu casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las fotos, recuerdos o ilustraciones de álbumes de música que más te gusten. También puedes compartir contenido de la red de tu casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse suosikkikuvasi, muistosi tai Musiikki-albumin kuvitus. Voit myös jakaa kotiverkostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez vos photos, souvenirs ou illustrations d’albums de musique préférés. Vous pouvez également partager du contenu depuis le réseau de votre domicile."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez vos photos, souvenirs ou illustrations d’album préférés. Vous pouvez également partager du contenu à partir de votre réseau local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את התמונות, הזיכרונות או עטיפות אלבומי המוזיקה המועדפים. ניתן גם לשתף פריטים מהרשת הביתית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पसंदीदा तस्वीरें, यादें या संगीत ऐल्बम आर्ट चुनें। आप अपने होम नेटवर्क से भी शेयर कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite svoje omiljene fotografije, uspomene ili omote glazbenih albuma. Također možete dijeliti sa svoje kućne mreže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja kedvenc fotóit, emlékeit vagy a Zenében lévő albumborítóit. Az otthoni hálózatában található tartalmakat is megoszthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto, Memori, atau gambar album Musik favorit Anda. Anda juga dapat berbagi dari jaringan rumah Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le foto, i ricordi o le illustrazioni degli album di Musica che preferisci. Puoi anche condividere contenuti dalla tua rete domestica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの写真、メモリー、またはミュージックのアルバムアートを選択してください。ホームネットワークから共有することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 사진, 추억 또는 음악 앨범 표지를 선택합니다. 홈 네트워크에서 공유할 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto, Memori atau seni album Muzik kegemaran anda. Anda juga boleh berkongsi daripada rangkaian rumah anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg blant de beste bildene, minnene eller albumbildene dine. Du kan også dele fra hjemmenettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je favoriete foto's, terugblikken of illustraties van muziekalbums. Je kunt ook delen vanaf je thuisnetwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ulubione zdjęcia, wspomnienia lub okładki albumów. Możesz również udostępniać ze swojej sieci domowej."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha suas fotos, Memórias ou capas de álbuns favoritas. Você também pode compartilhar da sua rede doméstica."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as suas fotografias favoritas, recordações ou grafismos de álbuns. Também pode partilhar através da rede doméstica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți pozele, amintirile sau ilustrațiile albumelor muzicale favorite. De asemenea, puteți partaja din rețeaua casnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно использовать избранные фото, воспоминания или обложки музыкальных альбомов. Также можно использовать контент из домашней сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte obľúbené fotky, spomienky alebo obal albumu z apky Hudba. Môžete tiež zdieľať obsah zo svojej domácej siete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite priljubljene fotografije, spomine ali naslovnico glasbenega albuma. Lahko tudi delite iz domačega omrežja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj dina favoritbilder, -minnen eller -omslag från musikalbum. Du kan även dela från ditt hemnätverk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปภาพโปรด ความทรงจำโปรด หรือภาพหน้าปกอัลบั้มเพลงโปรดของคุณ คุณยังสามารถแชร์ได้จากเครือข่ายภายในพื้นที่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori fotoğraflarınızı, anılarınızı veya Müzik albüm kapağınızı seçin. Ev ağınızdan da paylaşabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть улюблені фотографії, спогади чи обкладинки музичних альбомів. Можна також поширювати вміст із домашньої мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh, kỷ niệm hoặc hình minh họa album Nhạc ưa thích của bạn. Bạn cũng có thể chia sẻ từ mạng gia đình của mình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取喜爱的照片、“回忆”或“音乐”专辑插图。你也可以从家庭网络共享。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你喜愛的相片、「回憶」或「音樂」專輯插圖。你也可以從家居網絡共享。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你喜愛的照片、「回憶」或「音樂」專輯插圖。你也可以從家庭網路共享。"
          }
        }
      }
    },
