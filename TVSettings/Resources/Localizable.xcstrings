    "OSUpdateManagedDeviceText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب مؤسستك تحديث جهازك إلى ⁨tvOS %@⁩. يمكنك اختيار التحديث الآن أو سيعاد تشغيل الجهاز والتحديث تلقائيًا على %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’organització requereix que actualitzis el dispositiu al tvOS %@. Pots actualitzar‑lo ara o es reiniciarà i s’actualitzarà automàticament el dia %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše organizace vyžaduje aktualizaci zařízení na tvOS %@. Aktualizaci můžete spustit hned, jinak se zařízení %@ restartuje a aktualizaci nainstaluje automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisation kræver, at din enhed opdateres til tvOS %@. Du kan vælge at opdatere nu, eller vente til den genstartes og opdateres automatisk den %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Organisation verlangt, dass dein Gerät auf tvOS %@ aktualisiert wird. Du kannst jetzt aktualisieren oder dein Gerät startet am %@ automatisch neu und führt das Update durch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο οργανισμός σας απαιτεί την ενημέρωση της συσκευής σας στο tvOS %@. Μπορείτε να επιλέξετε να πραγματοποιήσετε ενημέρωση τώρα, ή επανεκκίνηση και αυτόματη ενημέρωση την/στις %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization is requiring your device to be updated to tvOS %@. You can choose to update now or it will restart and update automatically on %@."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organisation is requiring your device to be updated to tvOS %@. You can choose to update now or it will restart and update automatically on %@."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organisation requires your device to be updated to tvOS %@. You can choose to update now or it will restart and update automatically on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu organización requiere que actualices el dispositivo a tvOS %@. Si no actualizas ahora, se reiniciará y actualizará automáticamente el %@."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu organización requiere que actualices tu dispositivo a tvOS %@. Puedes actualizarlo ahora o se reiniciará y actualizará automáticamente el %@."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu organización requiere que actualices tu dispositivo a tvOS %@. Puedes actualizarlo ahora o se reiniciará y actualizará automáticamente el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisaatiosi vaatii laitteen päivityksen tvOS-versioon %@. Voit halutessasi päivittää nyt, tai se käynnistetään uudelleen ja päivitetään automaattisesti %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre organisation exige que votre appareil soit mis à jour vers tvOS %@. Vous pouvez lancer la mise à jour maintenant ou attendre que votre appareil redémarre et se mette à jour automatiquement le %@."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre organisation requiert la mise à jour de votre appareil vers tvOS %@. Vous pouvez effectuer la mise à jour maintenant ou attendre le %@ qu’un redémarrage automatique mette à jour le système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארגון שלך מחייב ביצוע עדכון לגירסת ⁨tvOS %@⁩. באפשרותך לבחור אם לעדכן את המכשיר כעת או לאפשר הפעלה מחדש ועדכון אוטומטי ב: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संगठन के मुताबिक़ आपके डिवाइस को tvOS %@ पर अपडेट करने की ज़रूरत है। आप अभी अपडेट करने का विकल्प चुन सकते हैं या %@ को इसे ऑटोमैटिकली रीस्टार्ट और अपडेट कर दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša organizacija zahtijeva ažuriranje vašeg uređaja na tvOS %@. Možete odabrati ažuriranje sada ili će se automatski ponovno uključiti i ažurirati %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervezete megköveteli, hogy az eszköze a tvOS %@ rendszerre legyen frissítve. Dönthet úgy, hogy most végzi el a frissítést, vagy az eszköz ekkor fog automatikusan újraindulni és frissülni: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisasi Anda mengharuskan perangkat Anda untuk diperbarui ke tvOS %@. Anda dapat memilih untuk memperbarui sekarang atau perangkat akan dimulai ulang dan diperbarui secara otomatis pada %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua organizzazione sta richiedendo l’aggiornamento del dispositivo a tvOS %@. Puoi scegliere di procedere adesso o attendere che il dispositivo venga riavviato e aggiornato automaticamente il giorno %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織/団体によってデバイスをtvOS %@にアップデートすることが必須とされています。今すぐアップデートするか、%@にデバイスを再起動して自動的にアップデートするかを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 조직에서 사용자의 기기를 tvOS %1$@ 버전으로 업데이트할 것을 요구합니다. 지금 업데이트하도록 선택할 수 있습니다. 선택하지 않은 경우에는 %@에 기기가 재시동되고 자동으로 업데이트됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisasi anda memerlukan peranti anda dikemas kini kepada tvOS %@. Anda boleh memilih untuk mengemas kini sekarang atau ia akan mula semula dan dikemas kini secara automatik pada %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisasjonen krever at enheten din oppdateres til tvOS %@. Du kan velge å oppdatere nå, eller så vil den starte på nytt og oppdatere automatisk %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je organisatie vereist dat je apparaat wordt bijgewerkt naar tvOS %@. Je kunt de update nu installeren of de update wordt automatisch geïnstalleerd op %@ nadat het apparaat opnieuw is opgestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja organizacja wymaga uaktualnienia urządzenia do systemu tvOS %@. Możesz zrobić to od razu. W przeciwnym razie urządzenie uruchomi się ponownie i automatycznie zainstaluje uaktualnienie %@."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua organização exige a atualização do seu dispositivo para o tvOS %@. Se você não atualizar agora, o dispositivo será reiniciado e atualizado automaticamente em %@."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua organização requer a atualização do dispositivo com o tvOS %@. Pode atualizar agora ou o dispositivo será reiniciado e atualizado automaticamente a %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizația dvs. impune actualizarea dispozitivului dvs. la tvOS %@. Puteți opta să îl actualizați acum sau va reporni și va fi actualizat automat pe %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша организация требует обновить устройство до tvOS %@. Вы можете сделать это сейчас, либо %@ устройство перезагрузится и установит обновление автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša organizácia vyžaduje aktualizáciu vášho zariadenia na tvOS %@. Môžete ho aktualizovať hneď alebo sa automaticky reštartuje a aktualizuje %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša organizacija zahteva posodobitev vaše naprave na operacijski sistem tvOS različice %@. Posodobite jo lahko zdaj ali pa se bo samodejno znova zagnala in posodobila dne %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisation kräver att din enhet uppdateras till tvOS %@. Du kan välja att uppdatera nu, annars startas den här enheten om och uppdateras automatiskt %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "องค์กรของคุณต้องการให้อัปเดตอุปกรณ์เป็น tvOS %@ คุณสามารถเลือกได้ว่าจะอัปเดตตอนนี้หรือจะให้อุปกรณ์เริ่มการทำงานใหม่และอัปเดตโดยอัตโนมัติในวันที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuruluşunuz, aygıtınızın tvOS %@ sürümüne güncellenmesini gerektiriyor. Şimdi güncellemeyi seçebilirsiniz ya da aygıt %@ tarihinde otomatik olarak yeniden başlatılıp güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша установа вимагає оновити ваш пристрій до tvOS %@. Можна оновити зараз, або пристрій перезапуститься та оновиться автоматично %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ chức của bạn yêu cầu cập nhật thiết bị của bạn lên tvOS %@. Bạn có thể lựa chọn cập nhật bây giờ hoặc thiết bị sẽ khởi động lại và cập nhật tự động vào %@."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你的组织要求将设备更新至Apple tvOS %@。你可以选择立即更新，否则设备将在%@重新启动并自动更新。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的機構要求你的裝置更新至tvOS %@。你可以選擇立即更新，否則它將於%@自動重新啟動並更新。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的組織要求裝置更新到tvOS %@。你可以選擇立即更新或在%@重新開機並自動更新。"
          }
        }
      }
    },
