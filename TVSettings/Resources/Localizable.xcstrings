    "AVCheckCableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن اتصال HDMI يدعم الإعدادات الحالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que la connexió HDMI sigui compatible amb la configuració actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že vaše HDMI připojení podporuje aktuální nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at HDMI-forbindelsen understøtter dine nuværende indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergewissere dich, dass deine HDMI-Verbindung die aktuellen Einstellungen unterstützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι η σύνδεση HDMI υποστηρίζει τις τρέχουσες ρυθμίσεις σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your HDMI connection supports your current settings."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your HDMI connection supports your current settings."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your HDMI connection supports your current settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la conexión HDMI que estás utilizando es compatible con los ajustes actuales."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu conexión HDMI sea compatible con tu configuración actual."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu conexión HDMI sea compatible con tu configuración actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että HDMI-yhteys tukee nykyisiä asetuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si votre connexion HDMI prend en charge les réglages actuels."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre connexion HDMI prend vos réglages actuels en charge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לוודא שחיבור ה-HDMI שלך תומך בהגדרות הנוכחיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि आपका HDMI कनेक्शन आपकी वर्तमान सेटिंग का समर्थन करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite podržava li vaša HDMI veza trenutačne postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződjön meg róla, hogy a HDMI-kapcsolata támogatja az aktuális beállításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan koneksi HDMI Anda mendukung pengaturan saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che la connessione HDMI supporti le impostazioni attuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI接続が現在の設定に対応していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI 연결이 현재 설정을 지원하는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan sambungan HDMI anda menyokong seting semasa anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller at HDMI-forbindelsen din støtter de gjeldende innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of je HDMI-verbinding je huidige instellingen ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że Twoje połączenie HDMI obsługuje bieżące ustawienia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que a conexão HDMI é compatível com os ajustes atuais."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique‑se de que a ligação HDMI é compatível com as definições atuais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați compatibilitatea conexiunii HDMI cu configurările actuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что HDMI-соединение поддерживает текущие настройки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že vaše HDMI pripojenie podporuje aktuálne nastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepričajte se, da vaša povezava HDMI podpira vaše trenutne nastavitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att HDMI-anslutningen har stöd för dina aktuella inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่าการเชื่อมต่อ HDMI รองรับการตั้งค่าปัจจุบันของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI bağlantınızın şu anki ayarlarınızı desteklediğine emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упевніться, що це HDMI-зʼєднання підтримує ваші поточні параметри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo kết nối HDMI của bạn hỗ trợ cài đặt hiện tại của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确保HDMI连接支持当前设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確定你的HDMI連線支援你目前的設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
