    "AVShowWhenMutedDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الترجمة عند كتم مستوى الصوت أو خفضه إلى أدنى مستوى. هذا غير مدعوم عندما يكون التحكم في مستوى صوت التلفزيون عبر IR."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa els subtítols si el volum està al mínim o en silenci. Aquesta funció no està disponible en controlar el volum del televisor per infrarojos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne titulky, když vypnete nebo úplně zeslabíte zvuk. Nepodporováno při ovládání hlasitosti televizoru infračerveným ovladačem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå undertekster til, når lyden er slået fra, eller der er skruet helt ned for lydstyrken. Ikke understøttet, når fjernsynets lydstyrke styres via IR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Untertitel, wenn die Lautstärke stummgeschaltet oder ganz leise gestellt ist. Dies wird nicht unterstützt, wenn die TV-Lautstärke über IR gesteuert wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίηση υπότιτλων όταν η ένταση ήχου μειωθεί πλήρως ή τεθεί σε σίγαση. Δεν υποστηρίζεται όταν η ένταση ήχου της τηλεόρασης ελέγχεται μέσω υπέρυθρων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on subtitles when the volume is muted or turned all the way down. Not supported when TV volume is controlled via IR."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on subtitles when the volume is muted or turned all the way down. Not supported when TV volume is controlled via IR."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on subtitles when the volume is muted or turned all the way down. Not supported when TV volume is controlled via IR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos se activarán cuando el volumen se baje al mínimo o se silencie. Esta función no es compatible cuando el volumen del televisor se controla mediante un mando de infrarrojos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los subtítulos cuando el volumen está muy bajo o silenciado. No es compatible si el volumen de la TV se controla mediante un control remoto infrarrojo (IR)."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los subtítulos cuando el volumen está muy bajo o silenciado. No es compatible si el volumen de la TV se controla mediante un control remoto infrarrojo (IR)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita tekstitys päälle, kun ääni on mykistetty tai hiljennetty kokonaan. Ei tuettu, kun TV:n äänenvoimakkuutta säädetään IR-säätimellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les sous-titres lorsque le son est coupé ou que le volume est baissé au minimum. Cette fonctionnalité n’est pas prise en charge lorsque le volume du téléviseur est contrôlé avec une télécommande infrarouge."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les sous-titres lorsque le son est coupé ou au minimum. Cette fonctionnalité n’est pas prise en charge lorsque le volume de la télévision est contrôlé par infrarouge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להפעיל כתוביות כשהשמע מושתק או כשהעוצמה שלו מונמכת עד הסוף. הגדרה זו אינה נתמכת כאשר עוצמת השמע של הטלוויזיה נשלטת דרך IR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब वॉल्यूम को म्यूट किया गया हो या पूरी तरह से बंद कर दिया गया हो, तब सबटाइटल चालू करें। अगर टीवी वॉल्यूम को IR के ज़रिए नियंत्रित किया जा रहा हो, तब समर्थित नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključenje titlova kad je glasnoća isključena ili sasvim stišana. Nije podržano kad se glasnoćom TV-a upravlja putem IR-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja a feliratokat, amikor a hangerő némítva van, vagy teljesen le van halkítva. Nem támogatott, amikor a tévé hangereje infravörös jel használatával van vezérelve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan subtitle saat volume dibisukan atau dikecilkan sepenuhnya. Tidak didukung saat volume TV dikontrol melalui IR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva i sottotitoli quando l’audio è disattivato o il volume è al minimo. La funzionalità non è supportata quando controlli il volume della TV tramite infrarossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消音時または音量がゼロに下げられたときに自動的に字幕をオンにします。TVの音量が赤外線（IR）で操作されている場合には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 꺼져 있거나 음량이 최소인 경우 자막을 켭니다. TV 음량이 IR을 통해 제어될 경우 지원되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan sari kata apabila kelantangan disenyapkan atau ditutup sepenuhnya. Tidak disokong apabila kelantangan TV dikawal melalui IR."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på undertekster når lyden slås av eller skrus helt ned. Støttes ikke hvis TV-lyden styres via infrarød."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel ondertiteling in wanneer het volume is gedempt of helemaal uit staat. Niet ondersteund wanneer tv-volume wordt geregeld via IR."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączaj napisy, gdy dźwięk jest wyciszony lub maksymalnie ściszony. Nieobsługiwane, gdy do sterowania głośnością telewizora używany jest pilot na podczerwień."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as legendas quando o volume for silenciado ou estiver no mínimo. Incompatível quando o volume da TV é controlado via infravermelho."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar as legendas quando o volume estiver desativado ou no mínimo. Não suportado quando o volume da TV for controlado por infravermelhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitrările vor fi activate când volumul sunetului este tăiat sau dat complet la minim. Opțiunea nu este funcțională când volumul televizorului este controlat prin IR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включать субтитры, когда выключен звук или установлен минимальный уровень громкости. Не поддерживается, если громкость телевизора регулируется через ИК."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri vypnutí alebo úplnom zoslabení zvuku budú zapnuté titulky. Pri ovládaní hlasitosti televízora pomocou infračerveného ovládača táto funkcia nie je podporovaná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite podnapise, ko je zvok izklopljen ali povsem utišan. Ni podprto, kadar je glasnost TV-ja upravljana z IR-daljincem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på undertexter när volymen är avstängd eller på lägsta möjliga nivå. Stöds inte när TV-volymen styrs via IR."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้คำบรรยายเมื่อระดับเสียงถูกปิดหรือถูกลดระดับลงทั้งหมด ไม่รองรับเมื่อระดับเสียงของทีวีถูกควบคุมผ่านทาง IR"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kapalıyken veya tamamen kısıkken altyazıları açar. TV ses yüksekliği IR aracılığıyla denetlenirken desteklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикати субтитри, якщо гучність вимкнено або зведено до мінімуму. Не підтримується, коли гучністю телевізора керують з ІЧ‑пульта."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật phụ đề khi tắt tiếng hoặc âm lượng được giảm hết mức. Không được hỗ trợ khi âm lượng TV được điều khiển qua IR."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "静音或音量调到最低时打开字幕。通过红外线控制电视音量时不受支持。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當音量為靜音或已調到最低時，開啟字幕。透過紅外線控制電視音量時不支援。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音量設為靜音或調到最低時，開啟字幕。透過紅外線控制電視音量時不支援此功能。"
          }
        }
      }
    },
