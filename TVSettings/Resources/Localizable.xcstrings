    "AVShowForDifferentLanguagesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الترجمة تلقائيًا عندما لا تتطابق لغة الفيديو الذي تشاهده مع لغتك المفضلة في Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa els subtítols automàticament si l’idioma del vídeo que reprodueixes no coincideix amb l’idioma principal de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se zobrazí titulky, pokud se jazyk sledovaného videa liší od preferovaného jazyka Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis automatisk undertekster, når sproget i den video, du ser, ikke er det samme som dit foretrukne Apple TV-sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel werden automatisch angezeigt, wenn die Sprache des Videos, das du ansiehst, nicht mit deiner bevorzugten Sprache auf dem Apple TV übereinstimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη εμφάνιση υπότιτλων όταν η γλώσσα του βίντεο που παρακολουθείτε δεν αντιστοιχεί στην προτιμώμενη γλώσσα του Apple TV σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos se muestran automáticamente cuando el idioma del vídeo que estás viendo no coincide con el idioma principal de tu Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra subtítulos automáticamente cuando el video que ves no corresponde a tu idioma preferido en el Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra subtítulos automáticamente cuando el video que ves no corresponde a tu idioma preferido en el Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tekstitys automaattisesti, kun katsomasi videon kieli ei ole sama kuin ensisijainen Apple TV -kieli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez automatiquement les sous-titres lorsque la langue de la vidéo en cours ne correspond pas à votre langue préférée sur l’Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche automatiquement les sous-titres lorsque la langue de la vidéo à l’écoute ne correspond pas à votre langue préférée pour l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג כתוביות באופן אוטומטי כששפת הווידאו הנצפה אינה תואמת לשפת ה‑Apple TV המועדפת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबटाइटल ऑटोमैटिकली दिखाएँ जब आपके द्वारा देखे जा रहे वीडियो की भाषा Apple TV पर आपकी पसंदीदा भाषा से मेल नहीं खाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko prikazivanje titlova kad se jezik videozapisa koji gledate ne podudara s vašim preferiranim jezikom Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan megjeleníti a feliratokat, amikor a nézett videó nyelve nem felel meg az Ön Apple TV‑n beállított előnyben részesített nyelvének."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan subtitle secara otomatis saat bahasa video yang sedang Anda tonton tidak sesuai dengan bahasa Apple TV pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra automaticamente i sottotitoli quando la lingua del video che stai guardando non corrisponde a quella preferita di Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴中のビデオの言語がApple TVの優先する言語と一致しないときに自動的に字幕を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청 중인 비디오의 언어가 선호하는 Apple TV 언어와 일치하지 않는 경우 자동으로 자막을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan sari kata secara automatik apabila bahasa video yang anda tonton tidak sepadan dengan bahasa Apple TV pilihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis undertekster automatisk når videoer spilles på et annet språk enn det som er ditt foretrukne språk på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertiteling wordt automatisch weergegeven wanneer de taal van de video die je bekijkt niet overeenkomt met de gewenste Apple TV-taal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wyświetlaj napisy, gdy język wideo nie jest zgodny z preferowanym językiem Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra automaticamente as legendas quando o idioma do vídeo que você está vendo não é igual ao seu idioma preferido na Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar legendas automaticamente se o idioma do vídeo em reprodução não corresponder ao idioma preferido configurado na Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitrările vor fi afișate automat atunci când limba conținutului video pe care îl vizionați nu corespunde cu limba preferată pentru Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры отображаются автоматически, если язык просматриваемого видео не соответствует предпочитаемому языку Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky zobrazí titulky, keď sa jazyk prehrávaného videa líši od preferovaného jazyka Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogočite samodejen prikaz podnapisov, kadar se jezik predvajanega videa ne ujema z izbranim jezikom Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa automatiskt undertexter när språket i videon du tittar på inte matchar ditt föredragna språk på Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำบรรยายโดยอัตโนมัติเมื่อภาษาของวิดีโอที่คุณกำลังดูไม่ตรงกับภาษาที่ต้องการของ Apple TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediğiniz videonun dili tercih ettiğiniz Apple TV diliyle eşleşmediğinde altyazıları otomatik olarak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично показувати субтитри, якщо мова відтворюваного відео відрізняється від заданої на Apple TV пріоритетної мови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hiển thị phụ đề khi ngôn ngữ của video mà bạn đang xem không khớp với ngôn ngữ Apple TV được ưu tiên của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所观看视频的语言与Apple TV首选语言不匹配时自动显示字幕。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當觀看的影片語言與你偏好的Apple TV語言不相符時，自動顯示字幕。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在觀看的影片不符合你偏好的Apple TV語言時自動顯示字幕。"
          }
        }
      }
    },
