    "MediaLibraryServiceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات التي طلبت الوصول إلى Apple Music ونشاطي الموسيقى والفيديو لديك ومكتبة الوسائط الخاصة بك ستظهر هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que hagin sol·licitat accedir a l’Apple Music, a la teva activitat relacionada amb la música i els vídeos i a la biblioteca multimèdia es mostraran aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí aplikace, které si vyžádaly přístup k Apple Music, vaší aktivitě v poslouchání hudby a sledování videí a vaší knihovně médií."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der har bedt om adgang til Apple Music, din musik- og videoaktivitet og dit mediebibliotek, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Apps angezeigt, die auf Apple Music, deine Musik- und Videoaktivitäten und deine Mediathek zugreifen möchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ θα εμφανίζονται εφαρμογές που έχουν ζητήσει πρόσβαση στο Apple Music, στη δραστηριότητα μουσικής και βίντεο, καθώς και στη βιβλιοθήκη πολυμέσων σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Music, your music and video activity, and your media library appear here."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Music, your music and video activity, and your media library appear here."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Music, your music and video activity, and your media library appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán las apps que hayan solicitado acceso a Apple Music, tu actividad relacionada con la música y los vídeos y tu biblioteca multimedia."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se mostrarán las apps que han solicitado acceso a Apple Music, tu actividad musical y de videos, y tu biblioteca de contenidos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se mostrarán las apps que han solicitado acceso a Apple Music, tu actividad musical y de videos, y tu biblioteca de contenidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit, jotka ovat pyytäneet lupaa käyttää Apple Musicia, musiikki- ja videotoimintaasi sekä mediakirjastoasi, näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ayant demandé l’accès à Apple Music, votre activité musicale et vidéo, et votre bibliothèque multimédia s’affichent ici."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ayant demandé l’accès à Apple Music, à votre activité audiovisuelle et à votre bibliothèque multimédia figurent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שביקשו גישה ל-Apple Music, פעילות המוזיקה והסרטים שלך וספריית המדיה, יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन ऐप्स ने Apple Music, आपकी संगीत और वीडियो ऐक्टिविटी और आपकी मीडिया लाइब्रेरी के ऐक्सेस का अनुरोध किया है, वे यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje su zatražile pristup Apple Musicu, vašoj glazbenoj i video aktivnosti te medijateci prikazat će se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg az Apple Musichoz, az Ön zenével és videóval kapcsolatos tevékenységéhez és médiakönyvtárához hozzáférést kérelmező appok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta akses ke Apple Music, aktivitas musik dan video Anda, serta perpustakaan media Anda akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che hanno richiesto l’accesso ad Apple Music, alla tua cronologia di riproduzione di musica e video e ai contenuti della tua libreria multimediale verranno visualizzate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music、ミュージックとビデオの履歴、およびメディアライブラリへのアクセスを要求したアプリがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music, 음악, 비디오 활동 및 미디어 보관함에 접근을 요청한 앱이 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta akses kepada Apple Music, aktiviti muzik dan video anda serta pustaka media anda kelihatan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper som har bedt om tilgang til Apple Music, musikk- og videoaktiviteten din og mediebiblioteket, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staan de apps die om toegang tot Apple Music, je muziek- en videoactiviteit en je mediabibliotheek hebben gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu pojawiają się aplikacje, które proszą o dostęp do Apple Music, danych Twojej aktywności dotyczącej muzyki i wideo oraz do Twojej biblioteki multimediów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que solicitaram acesso ao Apple Music, sua atividade com músicas e vídeos, e à biblioteca de mídia aparecerão aqui."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que pediram acesso a Apple Music, à informação de atividade (música e vídeo) e à sua biblioteca de conteúdo multimédia aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care au solicitat acces la Apple Music, la activitatea dvs. legată de muzică și clipuri video și la biblioteca multimedia vor fi afișate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся приложения, запросившие доступ к Apple Music, Вашей активности, связанной с музыкой и видео, а также к Вашей медиатеке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia apky, ktoré žiadali o prístup k Apple Music, k vašej knižnici médií a vašim aktivitám súvisiacim s hudbou a videami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki so zahtevale dostop do storitve Apple Music, vaše glasbene in video dejavnosti ter knjižnice predstavnostnih vsebin, bodo prikazane tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som har begärt tillgång till Apple Music, din musik- och videoaktivitet samt ditt mediebibliotek visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ได้ขอเข้าถึง Apple Music กิจกรรมเพลงและวิดีโอ และคลังสื่อของคุณจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music’e, müzik ve video etkinliklerinize ve ortam arşivinize erişmek isteyen uygulamalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут зʼявлятимуться програми, що запитали доступ до Apple Music, вашої музичної та відео активності, а також медіатеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã yêu cầu truy cập vào Apple Music, hoạt động nhạc và video cũng như thư viện phương tiện của bạn sẽ xuất hiện tại đây."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求访问Apple Music、你的音乐和视频活动以及媒体资料库的App将在此处显示。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此處會顯示曾要求取用Apple Music、音樂與影片活動，以及媒體資料庫的App。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "之前要求取用Apple Music、你的音樂和影片活動，以及媒體資料庫的App會顯示在此處。"
          }
        }
      }
    },
