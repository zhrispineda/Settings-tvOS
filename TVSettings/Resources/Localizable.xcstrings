    "AccountsRepairCDPDialogMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تخويل هذا الـ Apple TV للانضمام إلى المنزل. سيتم التحقق منه من خلال جهاز iOS موثوق به للمتابعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV necessita autorització per unir‑se a casa teva. Demanarà permís a un dispositiu iOS de confiança per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před připojením k domácnosti je třeba Apple TV autorizovat. Než budete pokračovat, naváže kontrolní spojení s důvěryhodným iOS zařízením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette Apple TV skal godkendes, før det kan føjes til dit Hjem. Godkend via en kendt iOS-enhed for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Apple TV muss für die Aufnahme in dein Zuhause autorisiert werden. Vor dem Fortsetzen erfolgt eine Prüfung mit einem iOS-Gerät, dem vertraut wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Apple TV πρέπει να εξουσιοδοτηθεί για προσθήκη στην Οικία σας. Θα πραγματοποιήσει έλεγχο με μια αξιόπιστη συσκευή iOS για να συνεχίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV needs to be authorized to join your Home. It will check with a trusted iOS device to proceed."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV needs to be authorised to join your Home. It will check with a trusted iOS device to proceed."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV needs to be authorised to join your Home. It will check with a trusted iOS device to proceed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder añadir este Apple TV a tu casa, debe estar autorizado. Se verificará mediante un dispositivo iOS de confianza para continuar."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV necesita autorización para unirse a tu casa. Se verificará con un dispositivo iOS de confianza para continuar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV necesita autorización para unirse a tu casa. Se verificará con un dispositivo iOS de confianza para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Apple TV on valtuutettava kotiin liittämistä varten. Luotettu iOS-laite varmistaa sen ennen jatkamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV doit être autorisée à rejoindre votre domicile. Pour ce faire, utilisez un appareil iOS approuvé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV doit être autorisée à se connecter à votre domicile. Confirmez l’accès sur un appareil iOS de confiance pour poursuivre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאשר ל-Apple TV זה להצטרף אל ״הבית שלי״. כדי לאשר, יש להשתמש במכשיר iOS מהימן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके घर से जोड़ने के लिए इस Apple TV को अधिकृत करना होगा। आगे बढ़ने के लिए यह किसी भरोसेमंद iOS डिवाइस के साथ जाँचेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Apple TV treba biti autoriziran za pridruživanje vašem Domu. Za nastavak će se izvršiti provjera pomoću pouzdanog iOS uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az Apple TV‑t fel kell jogosítani, hogy csatlakozni tudjon az otthonához. A folytatáshoz ellenőrzést kell végezni egy megbízható iOS-eszközzel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini harus disahkan untuk bergabung dengan Rumah Anda. Apple TV akan mengonfirmasi dengan perangkat iOS tepercaya untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV deve essere autorizzata per essere aggiunta all’abitazione. Verrà eseguita la verifica con un dispositivo iOS attendibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームに追加するには、このApple TVが認証されている必要があります。処理を続行するため信頼できるiOSデバイスでチェックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV를 홈에 추가하려면 승인을 받아야 합니다. 신뢰하는 iOS 기기에서 확인 절차를 진행합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini perlu dibenarkan untuk menyertai Rumah anda. Ia akan menyemak dengan peranti iOS dipercayai untuk meneruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV må autoriseres for å bli med i hjemmet ditt. Autoriser den på en godkjent iOS-enhet for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Apple TV moet worden geautoriseerd om aan deze woning te kunnen worden toegevoegd. Om door te gaan, moet verificatie via een vertrouwd iOS-apparaat plaatsvinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz autoryzować ten Apple TV przed dołączeniem go do domu. W tym celu zostanie sprawdzony przez zaufane urządzenie iOS."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple TV precisa de autorização para fazer parte da sua Casa. Para continuar, ela será verificada com um dispositivo iOS."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple TV tem de estar autorizada a aceder à sua casa. Para avançar, será verificada através de um dispositivo iOS fidedigno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Apple TV trebuie să fie autorizat pentru a fi adăugat în Locuință. În acest scop, va fi utilizat un dispozitiv iOS de încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить в Ваш дом этот Apple TV, требуется авторизовать его. Чтобы продолжить, Apple TV установит связь с доверенным устройством iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete toto Apple TV pridať do svojej domácnosti, je potrebné ho autorizovať. Skôr ako bude možné pokračovať, skontroluje ho dôveryhodné iOS zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Apple TV je treba pooblastiti, da se lahko pridruži vašemu Domu. Za nadaljevanje se bo opravilo preverjenje z zaupanja vredno napravo iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV måste auktoriseras innan den kan ansluta till ditt hem. Den kontaktar en betrodd iOS-enhet för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV เครื่องนี้ต้องได้รับอนุญาตให้เข้าร่วมบ้านของคุณ การอนุญาตจะตรวจสอบด้วยอุปกรณ์ iOS ที่เชื่อถือแล้วเพื่อดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’nin Ev’inize katılabilmesi için yetkilendirilmesi gerekiyor. İşlemi sürdürmek için güvenilir bir iOS aygıtı ile denetleyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Apple TV слід авторизувати, щоб приєднати до вашого Дому. Запит авторизації надійде на будь-який довірений iOS‑пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV này cần được cấp phép để kết nối vào nhà của bạn. Thiết bị sẽ kiểm tra với một thiết bị iOS được tin cậy để tiếp tục."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV需要授权才能加入你的家。它会检查受信任的iOS设备以继续。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV需經授權才可加至「家居」。需與受信任的iOS裝置確認才可繼續。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV需要授權才能加入你的「家庭」。會與受信任iOS裝置查驗後繼續執行。"
          }
        }
      }
    },
    "AccountsSandboxDeleteMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إزالة حساب Sandbox ‏\"%@\" من هذا الـ Apple TV؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols eliminar el compte d’entorn de proves “%@” d’aquest Apple TV?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete z této Apple TV odstranit sandboxový účet %@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
