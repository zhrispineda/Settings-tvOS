    "AXVoiceOverAudioDuckingAlwaysFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "سيتم خفض مستوى صوت الوسائط والمكالمات دائمًا عندما تكون ميزة التعليق الصوتي مشغلة.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "S’abaixarà el volum de les trucades i del contingut multimèdia sempre que el VoiceOver estigui activat.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Hlasitost médií a hovorů bude při zapnutém VoiceOveru trvale snížená.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Lydstyrken på medier og opkald bliver altid skruet ned, når VoiceOver er slået til.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Die Lautstärke von Medien und Anrufen wird immer reduziert, wenn VoiceOver aktiv ist.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Η ένταση ήχου πολυμέσων και κλήσεων θα μειώνεται πάντα όταν είναι ενεργό το VoiceOver.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "The volume of media and calls will always be reduced when VoiceOver is on.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "The volume of media and calls will always be reduced when VoiceOver is on.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "The volume of media and calls will always be reduced when VoiceOver is on.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "The volume of media and calls will always be reduced when VoiceOver is on.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "The volume of media and calls will always be reduced when VoiceOver is on.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El volumen del contenido multimedia y las llamadas se reducirá siempre cuando VoiceOver esté activado.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El volumen del contenido y las llamadas se reducirá cuando VoiceOver esté activado.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "El volumen del contenido y las llamadas se reducirá cuando VoiceOver esté activado.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Median ja puhelujen äänenvoimakkuutta lasketaan aina, kun VoiceOver on päällä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Le volume des contenus multimédias et des appels sera toujours baissé lorsque VoiceOver sera activé.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Le volume du contenu multimédia et des appels sera toujours réduit lorsque VoiceOver sera activé.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "עוצמת השמע של מדיה ושיחות תמיד תופחת כאשר VoiceOver פעיל.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver चालू रहने पर मीडिया और कॉल का वॉल्यूम हमेशा कम किया जाएगा।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Glasnoća medija i poziva uvijek će se stišati kad je uključen VoiceOver.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A média és a hívások hangereje mindig csökkentve lesz, amikor a VoiceOver be van kapcsolva.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Volume media dan panggilan akan selalu dikurangi saat VoiceOver menyala.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Il volume dei contenuti multimediali e delle chiamate verrà sempre ridotto quando VoiceOver è attivo.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverがオンのときにメディアと通話の音量は常に下がります。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "VoiceOver가 켜져 있으면 미디어 및 통화 음량을 항상 줄입니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Kelantangan media dan panggilan akan sentiasa dikurangkan apabila VoiceOver aktif.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Het volume van media en oproepen wordt altijd verlaagd wanneer VoiceOver is ingeschakeld.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Volumet i medieavspilling og samtaler vil alltid bli redusert når VoiceOver er på.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Głośność multimediów i połączeń będzie zawsze obniżana, gdy funkcja VoiceOver jest włączona.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "O volume de chamadas e mídias será sempre reduzido quando o VoiceOver estiver ativado.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "O volume do conteúdo multimédia e das chamadas é sempre reduzido quando o VoiceOver está ativado.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Volumul conținutului multimedia și al apelurilor va fi redus întotdeauna dacă funcționalitatea VoiceOver este activată.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Громкость медиаконтента и вызовов всегда будет уменьшаться при включенном VoiceOver.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Hlasitosť médií a hovorov bude pri zapnutej funkcii VoiceOver vždy znížená.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Ko je funkcija VoiceOver vklopljena, bo glasnost predstavnostne vsebine in klicev vedno zmanjšana.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Volymen för medier och samtal sänks alltid när VoiceOver är på.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ระดับเสียงของสื่อและสายโทรจะลดลงเสมอเมื่อเปิดใช้ VoiceOver",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver açıkken ortamların ve aramaların ses yüksekliği her zaman azaltılır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Гучність викликів і медіавмісту завжди знижуватиметься, якщо ввімкнено VoiceOver.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Âm lượng của phương tiện và cuộc gọi sẽ luôn được giảm xuống khi VoiceOver được bật.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "“旁白”打开时，始终降低媒体和通话音量。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "「旁白」開啟期間，媒體和通話的音量總是會降低。",
            "state": "translated"
