    "SoundProfileSettingDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعد الصوت المكاني المخصص على تحسين البث عند استخدام AirPods مع أجهزة Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’àudio espacial personalitzat millora la renderització quan utilitzes els AirPods amb dispositius Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobení prostorového zvuku zlepšuje modelování prostorového zvuku při používání AirPodů s vašimi zařízeními Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasset rumlig lyd forbedrer gengivelsen af lyd, når du bruger AirPods med dine Apple-enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalisiertes 3D-Audio verbessert den Rendervorgang bei der Nutzung von AirPods mit Apple-Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Εξατομικευμένος χωρικός ήχος βελτιώνει την απόδοση ήχου κατά τη χρήση των AirPods με τις συσκευές Apple σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalized Spatial Audio improves rendering when using AirPods with your Apple devices."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalised Spatial Audio improves rendering when using AirPods with your Apple devices."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalised Spatial Audio improves rendering when using AirPods with your Apple devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado ofrece una mejor calidad al usar los AirPods con tus dispositivos Apple."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado mejora la reproducción al usar los AirPods con tus dispositivos Apple."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado mejora la reproducción al usar los AirPods con tus dispositivos Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Personoitu tilaääni parantaa tilaäänen toteutusta käytettäessä AirPods-kuulokkeita Apple-laitteiden kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio spatial personnalisé améliore le rendu lors de l’utilisation d’AirPods avec vos appareils Apple."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio spatial personnalisé améliore le rendu sonore lors de l’utilisation d’AirPods avec vos appareils Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאפיין ״שמע מרחבי בהתאמה אישית״ משפר את עיבוד השמע בעת שימוש ב-AirPods עם מכשירי Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple डिवाइस के साथ AirPods का इस्तेमाल करते समय वैयक्तिकृत स्पेशियल ऑडियो से रेंडरिंग में सुधार होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizirani prostorni zvuk poboljšava obrađivanje prilikom uporabe slušalica AirPods s Apple uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Személyre szabott térbeli hangzás javítja a kiadott hang minőségét, amikor AirPodsot használ Apple-eszközeivel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Spasial yang Dipersonalisasi meningkatkan pengolahan saat menggunakan AirPods dengan perangkat Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Audio spaziale personalizzato” migliora la resa quando utilizzi gli AirPods con i dispositivi Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーソナライズされた空間オーディオで、AppleデバイスでAirPodsを使用中にレンダリングが改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 맞춤형 공간 음향을 사용하면 Apple 기기에서 AirPods을 사용할 때 공간 음향 렌더링 품질을 향상할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Ruang Diperibadikan meningkatkan persembahan audio ruang apabila menggunakan AirPods dengan peranti Apple anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personlig romtilpasset lyd forbedrer lydgjengivelsen når du bruker AirPods med Apple-enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepersonaliseerde ruimtelijke audio verbetert de rendering van ruimtelijke audio wanneer je AirPods gebruikt met je Apple apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spersonalizowany dźwięk przestrzenny poprawia odwzorowanie dźwięku w słuchawkach AirPods używanych z urządzeniami Apple."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Áudio Espacial Personalizado melhora a renderização do áudio espacial quando você usa os AirPods com dispositivos Apple."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio espacial personalizado melhora o processamento ao usar AirPods com dispositivos Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcționalitatea „Audio spațial personalizat” îmbunătățește redarea atunci când folosiți căști AirPods cu dispozitivele dvs. Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональное пространственное аудио повышает качество рендеринга звука при использовании AirPods с устройствами Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobený priestorový zvuk vylepšuje podanie zvuku v AirPodoch pri používaní s Apple zariadeniami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagojeni prostorski zvok izboljša upodabljanje pri uporabi slušalk AirPods z napravami Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personanpassat rumsligt ljud gör ljudet bättre när du använder AirPods med Apple-enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงเชิงมิติพื้นที่สำหรับคุณจะปรับปรุงการส่งเสียงเมื่อใช้ AirPods กับอุปกรณ์ Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiselleştirilmiş Uzamsal Ses, Apple aygıtlarınızla AirPods kullanırken ses işlemeyi iyileştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функція «Персоналізоване просторове аудіо» покращує відтворення звуку під час використання навушників AirPods із пристроями Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh không gian cá nhân hóa cải thiện việc kết xuất khi sử dụng AirPods với thiết bị Apple của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配Apple设备使用AirPods时，个性化空间音频可提升渲染效果。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「個人化的空間音訊」可改進配搭Apple裝置使用AirPods時的渲染效果。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「個人化空間音訊」可改進將AirPods與Apple裝置搭配使用時的運算方式。"
          }
        }
      }
    },
    "SoundProfileSettingNotAvailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة الصوت المكاني المخصص بين iPhone ملف التعريف الافتراضي وهذا الـ Apple TV. ويمكن إقران سماعات رأس أخرى بهذا الـ Apple TV، لكنها لن تستخدم الصوت المكاني المخصص."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’àudio espacial personalitzat se sincronitza entre el perfil de l’iPhone per omissió i l’Apple TV. Pots enllaçar altres auriculars amb l’Apple TV, però no utilitzaran l’àudio espacial personalitzat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobení prostorového zvuku se synchronizuje mezi iPhonem patřícím k výchozímu profilu a touto Apple TV. Můžete s ní spárovat i jiná sluchátka, ta ale nebudou přizpůsobení prostorového zvuku používat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasset rumlig lyd synkroniseres mellem standardprofilens iPhone og denne Apple TV-enhed. Andre hovedtelefoner kan danne par med denne Apple TV-enhed, men de vil ikke bruge Tilpasset rumlig lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalisiertes 3D-Audio wird zwischen dem iPhone des Standardprofils und diesem Apple TV synchronisiert. Andere Kopfhörer können mit diesem Apple TV gekoppelt werden, verwenden aber nicht personalisiertes 3D-Audio."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Εξατομικευμένος χωρικός ήχος συγχρονίζεται μεταξύ του iPhone του προεπιλεγμένου προφίλ και αυτού του Apple TV. Άλλα ακουστικά μπορούν να ζευγοποιηθούν με αυτό το Apple TV αλλά δεν θα χρησιμοποιούν τον Εξατομικευμένο χωρικό ήχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalized Spatial Audio is synchronized between the default profile’s iPhone and this Apple TV. Other headphones can be paired with this Apple TV, but they won’t use Personalized Spatial Audio."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalised Spatial Audio is synchronised between the default profile’s iPhone and this Apple TV. Other headphones can be paired with this Apple TV, but they won’t use Personalised Spatial Audio."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalised Spatial Audio is synchronised between the default profile’s iPhone and this Apple TV. Other headphones can be paired with this Apple TV, but they won’t use Personalised Spatial Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado se sincroniza entre el iPhone asociado al perfil por omisión y este Apple TV. Puedes enlazar otros auriculares con este Apple TV, pero no usarán el audio espacial personalizado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado se sincroniza entre el iPhone del usuario predeterminado y este Apple TV. Es posible enlazar otros audífonos con este Apple TV, pero no usarán el audio espacial personalizado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio espacial personalizado se sincroniza entre el iPhone del usuario predeterminado y este Apple TV. Es posible enlazar otros audífonos con este Apple TV, pero no usarán el audio espacial personalizado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Personoitu tilaääni synkronoidaan oletusprofiilin iPhonen ja tämän Apple TV:n välillä. Muita kuulokkeita voidaan liittää pariksi tämän Apple TV:n kanssa, mutta ne eivät käytä personoitua tilaääntä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio spatial personnalisé est synchronisé entre l’iPhone du profil par défaut et cette Apple TV. D’autres écouteurs peuvent être jumelés avec cette Apple TV, mais ils n’utiliseront pas l’audio spatial personnalisé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio spatial personnalisé est synchronisé avec l’iPhone du profil par défaut et cette Apple TV. D’autres écouteurs peuvent être jumelés avec cette Apple TV, mais sans l’audio spatial personnalisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאפיין ״שמע מרחבי בהתאמה אישית״ מסונכרן בין iPhone ברירת המחדל של הפרופיל לבין Apple TV זה. ניתן לקשר אוזניות נוספות ל-Apple TV, אך הן לא ישתמשו ב״שמע מרחבי בהתאמה אישית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैयक्तिकृत स्पेशियल ऑडियो डिफ़ॉल्ट प्रोफ़ाइल के iPhone और इस Apple TV के बीच सिंक्रोनाइज़ होता है। इस Apple TV के साथ अन्य हेडफ़ोन पेयर किए जा सकते हैं, लेकिन वे वैयक्तिकृत स्पेशियल ऑडियो का इस्तेमाल नहीं करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizirani prostorni zvuk sinkronizira se između iPhonea standardnog profila i ovog Apple TV-a. Druge slušalice mogu se upariti s ovim Apple TV-om, ali neće koristiti personalizirani prostorni zvuk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Személyre szabott térbeli hangzás szinkronizálva van az alapértelmezett profil iPhone-ja és az Apple TV között. Más fejhallgatók is párosíthatók ezzel az Apple TV-vel, de nem fognak Személyre szabott térbeli hangzást használni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Spasial yang Dipersonalisasi diselaraskan di antara iPhone profil default dan Apple TV ini. Headphone lainnya dapat dipasangkan dengan Apple TV ini, tapi tidak akan menggunakan Audio Spasial yang Dipersonalisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Audio spaziale personalizzato” è sincronizzato tra l’iPhone del profilo di default e Apple TV. È possibile abbinare altre cuffie a questa Apple TV, ma non utilizzeranno l’audio spaziale personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーソナライズされた空間オーディオは、デフォルトプロフィールのユーザのiPhoneとこのApple TVの間で同期されます。その他のヘッドフォンはこのApple TVとペアリングできますが、パーソナライズされた空間オーディオは使用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 맞춤형 공간 음향은 기본 프로필의 iPhone과 이 Apple TV 사이에서 동기화됩니다. 다른 헤드폰 또한 이 Apple TV와 페어링될 수 있으나, 개인 맞춤형 공간 음향을 사용하지는 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Ruang Diperibadikan diselaraskan antara iPhone profil lalai dengan Apple TV ini. Fon kepala lain boleh dipasangkan dengan Apple TV ini, tetapi ia tidak akan menggunakan Audio Ruang Diperibadikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personlig romtilpasset lyd synkroniseres mellom standardprofilens iPhone og denne Apple TV-en. Andre hodetelefoner kan sammenkobles med denne Apple TV-en, men de vil da ikke bruke Personlig romtilpasset lyd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepersonaliseerde ruimtelijke audio wordt gesynchroniseerd tussen de iPhone van het standaardprofiel en deze Apple TV. Andere koptelefoons kunnen worden gekoppeld met deze Apple TV, maar ze gebruiken geen gepersonaliseerde ruimtelijke audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spersonalizowany dźwięk przestrzenny jest synchronizowany między domyślnym iPhone’em profilu i tym Apple TV. Z tym Apple TV można używać innych słuchawek, ale nie będą one korzystały ze spersonalizowanego dźwięku przestrzennego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Áudio Espacial Personalizado é sincronizado entre o iPhone associado ao perfil padrão e esta Apple TV. Outros fones de ouvido podem ser emparelhados com esta Apple TV, mas não usarão o Áudio Espacial Personalizado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio espacial personalizado é sincronizado entre o iPhone do perfil predefinido e esta Apple TV. Quaisquer outros auscultadores emparelhados com esta Apple TV não usarão o áudio espacial personalizado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcționalitatea „Audio spațial personalizat” este sincronizată între iPhone‑ul profilului implicit și acest Apple TV. Alte căști audio pot fi asociate cu acest Apple TV, dar nu vor folosi audio spațial personalizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональное пространственное аудио синхронизируется между iPhone профиля по умолчанию и этим Apple TV. Этот Apple TV можно объединять в пары с другими наушниками, но на них не будет использоваться персональное пространственное аудио."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobený priestorový zvuk je synchronizovaný medzi iPhonom predvoleného profilu a týmto Apple TV. S Apple TV môžete spárovať aj iné slúchadlá, nebudú však používať prispôsobený priestorový zvuk."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagojen prostorski zvok se sinhronizira med iPhonom privzetega profila in tem Apple TV-jem. S tem Apple TV-jem lahko povežete tudi druge slušalke, vendar ne bodo uporabljale prilagojenega prostorskega zvoka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personanpassat rumsligt ljud synkroniseras mellan den förvalda profilens iPhone och denna Apple TV. Andra hörlurar kan parkopplas med denna Apple TV, men de använder inte personanpassat rumsligt ljud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงเชิงมิติพื้นที่สำหรับคุณจะถูกเชื่อมข้อมูลระหว่าง iPhone ของโปรไฟล์เริ่มต้นกับ Apple TV เครื่องนี้ หูฟังอื่นก็สามารถจับคู่กับ Apple TV เครื่องนี้ได้แต่จะไม่ใช้เสียงเชิงมิติพื้นที่สำหรับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiselleştirilmiş Uzamsal Ses, saptanmış profilin iPhone’u ile bu Apple TV arasında eşzamanlanır. Diğer kulaklıklar, bu Apple TV ile eşlenebilir ama Kişiselleştirilmiş Uzamsal Ses’i kullanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Персоналізоване просторове аудіо синхронізується між iPhone основного профілю й цим Apple TV. Інші навушники можуть створити пару з цим Apple TV, але вони не використовуватимуть персоналізоване просторове аудіо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh không gian cá nhân hóa được đồng bộ hóa giữa iPhone của hồ sơ mặc định và Apple TV này. Các tai nghe khác có thể được ghép đôi với Apple TV này, nhưng chúng sẽ không sử dụng Âm thanh không gian cá nhân hóa."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "个性化空间音频在默认个人资料的iPhone和此Apple TV之间同步。其他耳机可与此Apple TV配对，但不会使用个性化空间音频。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「個人化的空間音訊」在預設個人檔案的iPhone和此Apple TV之間同步。其他耳筒可與此Apple TV配對，但不會使用「個人化的空間音訊」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「個人化空間音訊」會在預設個人檔案的iPhone和此Apple TV間同步。其他耳機可與此Apple TV配對，但不會使用「個人化空間音訊」。"
          }
        }
      }
    },
