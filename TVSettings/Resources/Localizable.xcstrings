    "RCLearnRemoteBasicSetUpCompleteDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن استخدام الريموت مع هذا الـ Apple TV. لإعداد أزرار إضافية، حدد \"إعداد أزرار التشغيل\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja pots utilitzar el comandament amb l’Apple TV. Per configurar més botons, selecciona “Configura els botons de reproducció”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď můžete s touto Apple TV používat svůj ovladač. Chcete‑li nastavit další tlačítka, vyberte volbu Nastavit tlačítka přehrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nu bruge fjernbetjeningen med dette Apple TV. Hvis du vil indstille yderligere knapper, skal du vælge Indstil knapper til afspilning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Fernbedienung jetzt mit diesem Apple TV verwenden. Um weitere Tasten zu konfigurieren, wähle „Wiedergabetasten konfigurieren“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα θα μπορείτε να χρησιμοποιείτε το τηλεχειριστήριο με αυτό το Apple TV. Για διαμόρφωση πρόσθετων κουμπιών, επιλέξτε «Διαμόρφωση κουμπιών αναπαραγωγής»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes utilizar tu mando con este Apple TV. Para configurar más botones, selecciona “Configurar botones de reproducción”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes usar tu control remoto con este Apple TV. Para configurar botones adicionales, selecciona Configurar botones de reproducción."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes usar tu control remoto con este Apple TV. Para configurar botones adicionales, selecciona Configurar botones de reproducción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt käyttää kaukosäädintäsi tämän Apple TV:n kanssa. Ota lisää painikkeita käyttöön valitsemalla Määritä toistopainikkeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez maintenant utiliser votre télécommande avec cette Apple TV. Choisissez « Configurer les boutons de lecture » pour configurer d’autres boutons."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais utiliser votre télécommande avec cette Apple TV. Pour configurer d’autres boutons, sélectionnez Configurer les boutons de lecture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כעת ניתן להשתמש בשלט עם Apple TV זה. להגדרת כפתורים נוספים, יש לבחור באפשרות ״הגדרת כפתורי הפעלה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप अपने रिमोट का इस Apple TV के साथ उपयोग कर सकते हैं। अतिरिक्त बटन सेटअप करने के लिए, प्लेबैक सेटअप करें बटन चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sad možete koristiti svoj upravljač s ovim Apple TV‑om. Za podešavanje dodatnih tipki odaberite Podesi tipke za reprodukciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már használhatja a távirányítót ezzel az Apple TV-vel. További gombok beállításához válassza a Lejátszási gombok beállítása lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini Anda dapat menggunakan remote Anda dengan Apple TV ini. Untuk mengatur tombol tambahan, pilih Atur Tombol Pemutaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telecomando è pronto per essere utilizzato con Apple TV. Per impostare tasti aggiuntivi, seleziona “Imposta tasti di riproduzione”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのリモコンは、このApple TVで使用できるようになりました。その他のボタンを設定するには、“再生ボタンを設定”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 사용자의 리모컨으로 이 Apple TV를 사용할 수 있습니다. 추가 버튼을 설정하려면 재생 버튼 설정을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini boleh menggunakan kawalan jauh anda dengan Apple TV ini. Untuk menyediakan butang tambahan, pilih Sediakan Butang Main Balik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nå bruke fjernkontrollen med Apple TV. Velg Konfigurer avspillingsknapper for å konfigurere flere knapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu je afstandsbediening gebruiken met deze Apple TV. Selecteer 'Configureer afspeelknoppen' om extra knoppen in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz teraz sterować Apple TV za pomocą pilota. Aby skonfigurować dodatkowe przyciski, wybierz Konfiguruj przyciski odtwarzania."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode usar seu controle remoto com esta Apple TV. Para configurar outros botões, selecione Configurar Botões de Reprodução."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora já pode usar o seu comando à distância com esta Apple TV. Para configurar botões adicionais, selecione Configurar botões de reprodução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum puteți utiliza telecomanda dvs. cu acest Apple TV. Pentru a configura butoane suplimentare, selectați Configurați butoanele de redare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Ваш пульт можно использовать с этим Apple TV. Чтобы настроить дополнительные кнопки, выберите «Настроить кнопки воспроизведения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svoje Apple TV teraz môžete ovládať pomocou ovládača. Ak chcete nastaviť ďalšie tlačidlá, vyberte Nastaviť tlačidlá prehrávania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj lahko daljinec uporabljate s tem Apple TV-jem. Če želite nastaviti dodatne gumbe, izberite možnost Nastavi gumbe za predvajanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du använda din fjärrkontroll med denna Apple TV. Du kan ställa in fler knappar genom att gå till Ställ in uppspelningsknappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณสามารถใช้รีโมทของคุณกับ Apple TV เครื่องนี้ได้แล้ว ในการตั้งค่าปุ่มอื่นเพิ่มเติม ให้เลือกการตั้งค่าปุ่มการเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık kumandanızı bu Apple TV ile kullanabilirsiniz. Ek düğmeler ayarlamak için Oynatma Düğmelerini Ayarla’yı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете використовувати свій пульт із цим Apple TV. Щоб налаштувати додаткові кнопки, виберіть «Налаштувати кнопки відтворення»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ, bạn có thể sử dụng điều khiển từ xa với Apple TV này. Để thiết lập các nút bổ sung, hãy chọn Thiết lập các nút phát lại."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在可以将你的遥控器用于此Apple TV。选择“设置播放按钮”来设置其他按钮。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以使用你的遙控器控制此Apple TV。如要設定額外按鈕，請選擇「設定播放按鈕」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以在此Apple TV上使用遙控器。若要設定其他按鈕，請選取「設定播放按鈕」。"
          }
        }
      }
    },
    "RCLearnRemoteBasicSetUpCompleteDescriptionTextAlt": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن استخدام الريموت مع هذا الـ Apple TV. لإعداد أزرار إضافية، حدد \"إعداد أزرار التشغيل\" أو \"إعداد أزرار الدليل\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja pots utilitzar el comandament amb l’Apple TV. Per configurar més botons, selecciona “Configura els botons de reproducció” o “Configura els botons de guia”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď můžete s touto Apple TV používat svůj ovladač. Chcete‑li nastavit další tlačítka, vyberte volbu Nastavit tlačítka přehrávání nebo Nastavit programová tlačítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nu bruge fjernbetjeningen med dette Apple TV. Hvis du vil indstille yderligere knapper, skal du vælge Indstil knapper til afspilning eller Indstil guideknapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Fernbedienung jetzt mit diesem Apple TV verwenden. Um weitere Tasten zu konfigurieren, wähle „Wiedergabetasten konfigurieren“ oder „Führungstasten konfigurieren“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα θα μπορείτε να χρησιμοποιείτε το τηλεχειριστήριο με αυτό το Apple TV. Για διαμόρφωση πρόσθετων κουμπιών, επιλέξτε «Διαμόρφωση κουμπιών αναπαραγωγής» ή «Διαμόρφωση κουμπιών Οδηγού»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons or Set Up Guide Buttons."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons or Set Up Guide Buttons."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now use your remote with this Apple TV. To set up additional buttons, select Set Up Playback Buttons or Set Up Guide Buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes utilizar el mando con este Apple TV. Para configurar más botones, selecciona “Configurar botones de reproducción” o “Configurar botones de la guía”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes usar tu control remoto con este Apple TV. Para configurar botones adicionales, selecciona Configurar botones de reproducción o Configurar botones de guía."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes usar tu control remoto con este Apple TV. Para configurar botones adicionales, selecciona Configurar botones de reproducción o Configurar botones de guía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt käyttää kaukosäädintäsi tämän Apple TV:n kanssa. Ota lisää painikkeita käyttöön valitsemalla Määritä toistopainikkeet tai Määritä opaspainikkeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez maintenant utiliser votre télécommande avec cette Apple TV. Choisissez « Configurer les boutons de lecture » ou « Configurer les boutons de guide » pour configurer d’autres boutons."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais utiliser votre télécommande avec cette Apple TV. Pour configurer d’autres boutons, sélectionnez « Configurer les boutons de lecture » ou « Configurer les boutons de programme »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כעת ניתן להשתמש בשלט עם Apple TV זה. להגדרת כפתורים נוספים, יש לבחור באפשרות ״הגדרת כפתורי הפעלה״ או ״הגדרת כפתורי המדריך״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप अपने रिमोट का इस Apple TV के साथ उपयोग कर सकते हैं। अतिरिक्त बटन सेटअप करने के लिए, “प्लेबैक बटन सेटअप करें” या “गाइड बटन सेटअप करें” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sad možete koristiti svoj upravljač s ovim Apple TV‑om. Za podešavanje dodatnih tipki odaberite Podesi tipke za reprodukciju ili Podesi tipke Vodiča."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már használhatja a távirányítót ezzel az Apple TV-vel. További gombok beállításához válassza ki a Lejátszási gombok beállítása vagy a Műsorújság-gombok beállítása lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini Anda dapat menggunakan remote Anda dengan Apple TV ini. Untuk mengatur tombol tambahan, pilih Atur Tombol Pemutaran atau Atur Tombol Panduan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telecomando è pronto per essere utilizzato con Apple TV. Per configurare tasti aggiuntivi, seleziona “Imposta i tasti di riproduzione” o “Imposta i tasti della guida”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのリモコンは、このApple TVで使用できるようになりました。その他のボタンを設定するには、“再生ボタンを設定”または“ガイドボタンを設定”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 사용자의 리모컨으로 이 Apple TV를 사용할 수 있습니다. 추가 버튼을 설정하려면 ‘재생 버튼 설정’ 또는 ‘가이드 버튼 설정’을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini boleh menggunakan kawalan jauh anda dengan Apple TV ini. Untuk menyediakan butang tambahan, pilih Sediakan Butang Main Balik atau Sediakan Butang Panduan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nå bruke fjernkontrollen med Apple TV. Velg Konfigurer avspillingsknapper eller Konfigurer knapper for guide for å konfigurere flere knapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu je afstandsbediening gebruiken met deze Apple TV. Selecteer 'Configureer afspeelknoppen' of 'Configureer gidsknoppen' om extra knoppen in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz teraz sterować Apple TV za pomocą pilota. Aby skonfigurować dodatkowe przyciski, wybierz Konfiguruj przyciski odtwarzania lub Konfiguruj przyciski przewodnika."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode usar o controle remoto com esta Apple TV. Para configurar outros botões, selecione Configurar Botões de Reprodução ou Configurar Botões Guia."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora pode usar o seu comando à distância com esta Apple TV. Para configurar botões adicionais, selecione Configurar botões de reprodução ou Configurar botões de guia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum puteți utiliza telecomanda dvs. cu acest Apple TV. Pentru a configura butoane suplimentare, selectați „Configurați butoanele de redare” sau „Configurați butoanele ghidului”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Ваш пульт можно использовать с этим Apple TV. Чтобы настроить дополнительные кнопки, выберите «Настроить кнопки воспроизведения» или «Настроить кнопки управления»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svoje Apple TV teraz môžete ovládať pomocou ovládača. Ak chcete nastaviť ďalšie tlačidlá, vyberte Nastaviť tlačidlá prehrávania alebo Nastaviť programové tlačidlá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj lahko daljinec uporabljate s tem Apple TV-jem. Če želite nastaviti dodatne gumbe, izberite možnost Nastavi gumbe za predvajanje ali Nastavi gumbe Vodnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du använda din fjärrkontroll med denna Apple TV. Du kan ställa in fler knappar genom att gå till Ställ in uppspelningsknappar eller Ställ in guideknappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณสามารถใช้รีโมทของคุณกับ Apple TV เครื่องนี้ได้แล้ว ในการตั้งค่าปุ่มเพิ่มเติม ให้เลือกตั้งค่าปุ่มการเล่นหรือตั้งค่าปุ่มรายการที่น่าสนใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık kumandanızı bu Apple TV ile kullanabilirsiniz. Ek düğmeler ayarlamak için Oynatma Düğmelerini Ayarla’yı ya da Kılavuz Düğmelerini Ayarla’yı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете використовувати свій пульт із цим Apple TV. Щоб налаштувати додаткові кнопки, виберіть «Налаштувати кнопки відтворення» або «Налаштувати кнопки списку телепередач»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ, bạn có thể sử dụng điều khiển từ xa với Apple TV này. Để thiết lập các nút bổ sung, hãy chọn Thiết lập các nút phát lại hoặc Thiết lập các nút hướng dẫn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在可以将遥控器用于此Apple TV。选择“设置播放按钮”或“设置指南按钮”来设置其他按钮。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以使用你的遙控器控制此Apple TV。如要設定其他按鈕，請選擇「設定播放按鈕」或「設定指南按鈕」。"
          }
        },
        "zh_TW": {
