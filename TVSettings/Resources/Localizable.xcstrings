    "SaverBackdropMemoryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكريات هي مجموعات مخصصة من الصور. يمكن أن تعرض شاشة التوقف كل الذكريات أو الذكريات المميزة ضمن المفضلة فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els records són col·leccions de fotos personalitzades. L’estalvi de pantalla pot mostrar‑los tots o només els que afegeixis als favorits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzpomínky jsou osobní sbírky fotek. Spořič obrazovky může zobrazovat všechny vzpomínky nebo jen ty, které jste označili jako oblíbené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder er personlige fotosamlinger. Skærmskåneren kan vise alle minder eller kun dem, der er markeret som favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückblicke“ enthalten eine personalisierte Sammlung von Fotos. Der Bildschirmschoner kann alle oder nur die als Favoriten markierten Rückblicke anzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναμνήσεις είναι εξατομικευμένες συλλογές φωτογραφιών. Η προφύλαξη οθόνης μπορεί να εμφανίζει όλες τις αναμνήσεις, ή μόνο αυτές που έχουν σημανθεί ως Αγαπημένες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories are personalized collections of photos. The screen saver can show all Memories, or just ones marked as Favorites."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories are personalised collections of photos. The screen saver can show all Memories, or just ones marked as Favourites."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories are personalised collections of photos. The screen saver can show all Memories, or just ones marked as Favourites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuerdos son colecciones de fotos personalizadas. El salvapantallas puede mostrarlos todos o solo los que marques como favoritos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuerdos son colecciones personalizadas de fotos. El protector de pantalla puede mostrar todos tus recuerdos o sólo aquellos marcados como favoritos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuerdos son colecciones personalizadas de fotos. El protector de pantalla puede mostrar todos tus recuerdos o sólo aquellos marcados como favoritos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistot ovat personoituja kuvakokoelmia. Näytönsäästäjä voi näyttää kaikki muistot tai vain suosikiksi merkityt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs sont constitués de collections de photos personnalisées. L’économiseur d’écran peut afficher tous les souvenirs ou uniquement les souvenirs ajoutés aux favoris."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs sont des collections personnalisées de photos. L’économiseur d’écran peut tous les afficher ou n’afficher que les favoris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זיכרונות הם אוספי תמונות בהתאמה אישית. שומר המסך יכול להציג את כל הזיכרונות, או רק את אלה שמסומנים כמועדפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यादें तस्वीरों का वैयक्तिकृत संग्रह होती हैं। स्क्रीन सेवर द्वारा सभी यादें या केवल पसंदीदा के रूप में चिह्नित यादें दिखाई जा सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspomene su personalizirane kolekcije fotografija. Tijekom zaštite zaslona mogu se prikazivati sve uspomene ili samo one koje označite kao omiljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Emlékek a fotók személyre szabott gyűjteményei. A képernyővédő megjelenítheti az összes emléket, vagy csak a kedvencként megjelölteket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori adalah koleksi foto yang dipersonalisasi. Penghemat layar dapat menampilkan semua Memori atau hanya yang ditandai sebagai Favorit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ricordi sono raccolte di foto personalizzate. Il salvaschermo può mostrarli tutti o solo quelli indicati come preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリーはパーソナライズされた写真のコレクションです。すべてのメモリー、またはお気に入りに追加したメモリーをスクリーンセーバで表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘추억’은 개인적인 사진의 모음입니다. 화면 보호기에서 모든 추억을 보여주거나, 즐겨찾기로 표시한 사진만 보여줄 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori ialah koleksi foto diperibadikan. Penyelamat skrin boleh menunjukkan semua Memori atau hanya yang ditandakan sebagai Kegemaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minner er personlig tilpassede bildesamlinger. Skjermspareren kan vise alle minnene, eller kun de som er favorittmerket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugblikken zijn gepersonaliseerde verzamelingen van foto's. De schermbeveiliging kan alle terugblikken tonen of alleen de terugblikken die als favoriet zijn gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspomnienia to spersonalizowane zbiory zdjęć. Wygaszacz ekranu może wyświetlać wszystkie lub tylko ulubione wspomnienia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Memórias são coleções personalizadas de fotos. O protetor de tela pode mostrar todas as Memórias ou apenas as marcadas como Favoritas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As recordações são coleções personalizadas de fotografias. A proteção de ecrã pode mostrar todas as recordações ou apenas as assinaladas como favoritas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amintirile sunt colecții personalizate de poze. Screensaverul poate afișa toate amintirile sau doar pe cele marcate drept favorite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспоминания — это коллекции фото, созданные специально для Вас. На заставке могут отображаться все воспоминания или только те, которые отмечены как избранные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spomienky sú prispôsobené zbierky fotiek. Šetrič obrazovky môže zobrazovať všetky spomienky alebo len tie, ktoré ste označili ako obľúbené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spomini so osebno prilagojene zbirke fotografij. Ohranjevalnik zaslona lahko prikazuje vse elemente iz Spominov ali pa le tiste z oznako Priljubljeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnen är personligt anpassade bildsamlingar. Skärmsläckaren kan visa alla minnen eller bara de som är favoritmarkerade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความทรงจำคือคอลเลกชั่นรูปภาพสำหรับคุณโดยเฉพาะ ภาพพักหน้าจอสามารถแสดงความทรงจำทั้งหมดหรือเฉพาะความทรงจำที่เป็นรายการโปรดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anılar, kişiselleştirilmiş fotoğraf koleksiyonlarıdır. Ekran koruyucu, tüm anıları veya yalnızca favori olarak işaretlenmiş olanları gösterebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спогади — це персоналізовані колекції фотографій. Для екранної заставки можуть використовуватися всі спогади чи тільки улюблені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỷ niệm là các bộ sưu tập ảnh được cá nhân hóa. Trình bảo vệ màn hình có thể hiển thị tất cả kỷ niệm hoặc chỉ các kỷ niệm được đánh dấu là Mục ưa thích."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“回忆”为个性化的照片集。屏幕保护程序可显示所有回忆，也可仅显示标为“个人收藏”的回忆。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「回憶」是個人化的相片集。螢幕保護程式可以顯示全部「回憶」，或只顯示已標示為「喜好項目」的回憶。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「回憶」是個人化的照片選集。螢幕保護程式可以顯示所有回憶，或只顯示已標示為「喜好項目」的回憶。"
          }
        }
      }
    },
