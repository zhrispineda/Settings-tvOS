          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використати типове значення, натисніть кнопку Play/Pause."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sử dụng giá trị mặc định, nhấn Phát/Tạm dừng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
