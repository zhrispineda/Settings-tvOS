    "SiriTCCGroupDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات التي تستخدمها مع Siri قد تقوم بإرسال معلومات مثل جهات الاتصال الخاصة بك وغيرها من البيانات إلى Apple بهدف إكمال طلباتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per processar les teves sol·licituds, les apps que utilitzes amb Siri poden enviar informació com ara els teus contactes i altres dades a Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, které používáte se Siri, mohou za účelem zpracování vašich požadavků posílat společnosti Apple vaše kontakty a další data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, som du bruger sammen med Siri, sender muligvis oplysninger som f.eks. dine kontakter og andre data til Apple til behandling af dine anmodninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die mit Siri verwendet werden, können Informationen wie Kontakte und andere Daten an Apple senden, um deine Anfragen zu verarbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που χρησιμοποιείτε με το Siri μπορεί να στέλνουν πληροφορίες, όπως τις επαφές σας και άλλα δεδομένα, στην Apple για επεξεργασία των αιτημάτων σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you use with Siri may send information like your contacts and other data to Apple to process your requests."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you use with Siri may send information like your contacts and other data to Apple to process your requests."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you use with Siri may send information like your contacts and other data to Apple to process your requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que uses con Siri pueden enviar información a Apple, como tus contactos y otros datos, para procesar tus solicitudes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que uses con Siri podrían enviar información como tus contactos y otros datos a Apple para procesar tus solicitudes."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que uses con Siri podrían enviar información como tus contactos y otros datos a Apple para procesar tus solicitudes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirin yhteydessä käyttämäsi apit voivat lähettää tietoja, esimerkiksi yhteystietosi ja muita tietoja, Applelle pyyntöjesi käsittelyä varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que vous utilisez avec Siri peuvent envoyer des données, telles que vos contacts et autres, à Apple pour le traitement de vos requêtes."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que vous utilisez avec Siri sont susceptibles d’envoyer des informations à Apple, telles que vos contacts et d’autres données, pour traiter vos demandes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שבהם ייעשה שימוש עם Siri עשויים לשלוח ל-Apple מידע כגון אנשי הקשר שלך או נתונים אחרים לצורך עיבוד הבקשות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri के साथ उपयोग में लाए जाने वाले ऐप्स द्वारा आपके अनुरोधों को प्रोसेस करने के लिए Apple को आपके संपर्क और अन्य डेटा जैसी जानकारी भेजी जा सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje koristite sa značajkom Siri mogu slati informacije poput vaših kontakata i drugih podataka tvrtki Apple radi obrade vaših zahtjeva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfordulhat, hogy a Sirivel használt appok olyan információkat küldenek el az Apple-nek az Ön kérelmének feldolgozásához, mint a kontaktok és egyéb adatok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang Anda gunakan dengan Siri dapat mengirimkan informasi seperti kontak dan data lainnya ke Apple untuk memproses permintaan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che utilizzi con Siri potrebbero inviare informazioni come i tuoi contatti e altri dati ad Apple al fine di elaborare le tue richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriと一緒にアプリを使用すると、リクエストを処理するために、連絡先情報やその他のデータの情報がAppleに送信される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri와 함께 사용하는 앱이 사용자의 요청을 처리할 수 있도록 연락처 및 기타 데이터 등의 정보를 Apple에 보낼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang anda gunakan dengan Siri mungkin menghantar maklumat seperti kenalan anda dan data lain kepada Apple untuk memproses permintaan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper du bruker med Siri, kan sende informasjon som kontakter og andre data til Apple for å behandle forespørselen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps die je met Siri gebruikt, kunnen informatie zoals contactpersonen en andere gegevens naar Apple sturen om je verzoeken te verwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje używane z Siri mogą wysyłać informacje, np. Twoje kontakty i inne dane, do Apple w celu przetwarzania Twoich poleceń."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps usados com a Siri podem enviar informações como seus contatos e outros dados para que a Apple possa processar suas solicitações."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que usa com Siri poderão enviar informação (contactos e outros dados) à Apple para processar os seus pedidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile pe care le utilizați împreună cu Siri pot trimite informații precum contactele dvs. și alte date la Apple pentru a vă procesa solicitările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, с которыми Вы используете Siri, могут отправлять в Apple определенную информацию, например Ваши контакты, для обработки запросов Siri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apky, ktoré používate so Siri, môžu na účely spracovania vašich žiadostí posielať do Apple informácie o vašich kontaktoch a ďalšie dáta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki jih uporabljate s Siri, lahko družbi Apple pošiljajo podatke, kot so vaši stiki in drugi podatki, za obdelavo vaših zahtev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar du använder med Siri kan skicka information om sådant som dina kontakter och andra data till Apple för att bearbeta dina förfrågningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่คุณใช้กับ Siri อาจส่งข้อมูลไปที่ Apple เช่น รายชื่อและข้อมูลอื่นเพื่อดำเนินการตามคำขอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ile kullandığınız uygulamalar, kişileriniz gibi bilgileri ve diğer verileri isteklerinizin işlenmesi için Apple’a gönderebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми, якими ви користуєтесь разом із Siri, можуть слати до Apple таку інформацію, як ваші контакти й інші дані для опрацювання ваших запитів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng bạn sử dụng với Siri có thể gửi thông tin như các liên hệ của bạn và dữ liệu khác đến Apple để xử lý yêu cầu của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你通过Siri使用的App可能会将通讯录等信息和其他数据发送给Apple以处理你的请求。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你配合Siri使用的App可能會將一些資料，例如通訊錄及其他資料傳送予Apple以便處理你的要求。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你與Siri搭配使用的App可能會將一些資訊，如你的聯絡人和其他資料傳送給Apple來處理你的要求。"
          }
        }
      }
    },
