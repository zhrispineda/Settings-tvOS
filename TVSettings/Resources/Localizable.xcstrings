    "OSUpdateTextClearNumberValue": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام القيمة الافتراضية، اضغط على تشغيل/إيقاف مؤقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilitzar el valor per omissió prem “Reprodueix/pausa”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stisknutím tlačítka Přehrát/Pozastavit nastavíte výchozí hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Afspil/pause for at bruge standardværdien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Standardwert zu verwenden, drücke „Play/Pause“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για χρήση της προεπιλεγμένης τιμής, πατήστε «Αναπαραγωγή/Παύση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use the default value, press Play/Pause."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To use the default value, press Play/Pause."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To use the default value, press Play/Pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar el valor por omisión, pulsa el botón de reproducción/pausa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar el valor predeterminado, presiona Reproducir/pausa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar el valor predeterminado, presiona Reproducir/pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä oletusarvoa painamalla Play/Pause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser la valeur par défaut, appuyez sur Lecture/Pause."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser la valeur par défaut, appuyez sur Lecture/Pause."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש בערך ברירת המחדל, יש ללחוץ על הכפתור ״הפעלה/השהיה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट मान का उपयोग करने के लिए चलाएँ/पॉज़ करें दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabu standardne vrijednosti pritisnite Play/Pause."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértelmezett érték használatához nyomja meg a Play/Pause gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan nilai default, tekan Putar/Jeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare il valore di default, premi Riproduci/Pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの値を使用するには、再生/一時停止を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 값을 사용하려면 재생/일시 정지를 누르십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan nilai lalai, tekan Main/Jeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Play/Pause for å bruke standardverdien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de afspeelknop om de standaardwaarde te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby użyć wartości domyślnej, Naciśnij Odtwórz/Pauza."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o valor padrão, pressione Reproduzir/Pausar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o valor predefinido, prima Reproduzir/pausar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a utiliza valoarea implicită, apăsați Redare/Pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования значения по умолчанию нажмите Play/Pause."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete použiť predvolenú hodnotu, stlačte Play/Pause."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite uporabiti privzeto vrednost, pritisnite Predvajaj/Začasno zaustavi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill använda standardvärdet trycker du på uppspelnings-/pausknappen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการใช้ค่าเริ่มต้น ให้กด Play/Pause"
