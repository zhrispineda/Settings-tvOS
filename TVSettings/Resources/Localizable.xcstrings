    "AccountsCannotAddMoreAdditionalUsersDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم Apple TV حتى ١٥ ملفًا تعريفًا. لإضافة ملف تعريف آخر، أزل أحدها أولًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV admet 15 perfils com a màxim. Per afegir‑ne un altre, elimina’n algun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV podporuje maximálně 15 profilů. Chcete‑li přidat nový, nejprve odeberte jeden ze stávajících."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV understøtter op til 15 profiler. Du skal fjerne en profil for at kunne tilføje en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple TV unterstützt bis zu 15 Profile. Um ein weiteres Profil hinzuzufügen, entferne zuerst ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV υποστηρίζει έως και 15 προφίλ. Για προσθήκη άλλου προφίλ, αφαιρέστε πρώτα ένα προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV supports up to 15 profiles. To add another profile, remove one first."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV supports up to 15 profiles. To add another profile, remove one first."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV supports up to 15 profiles. To add another profile, remove one first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV admite hasta 15 perfiles. Para añadir más, deberás eliminar uno antes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV permite hasta 15 perfiles. Para agregar otro más, primero quita uno."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV permite hasta 15 perfiles. Para agregar otro más, primero quita uno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV tukee enintään 15:tä profiilia. Poista yksi ennen uuden lisäämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV prend en charge jusqu’à 15 profils. Pour ajouter un autre profil, supprimez-en d’abord un."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV prend en charge un maximum de 15 profils. Pour en ajouter un autre, supprimez-en d’abord un."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV תומך בעד 15 פרופילים. להוספת פרופיל נוסף יש להסיר תחילה אחד קיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV अधिकतम 15 प्रोफ़ाइल का समर्थन करता है। एक और प्रोफ़ाइल जोड़ने के लिए पहले से मौजूद किसी प्रोफ़ाइल को निकालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV podržava do najviše 15 profila. Za dodavanje još jednog profila prvo jednog uklonite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV legfeljebb 15 profilt képes támogatni. További profil hozzáadásához el kell távolítania egy meglévőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV mendukung maksimum 15 profil. Untuk menambahkan profil lain, hapus satu terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV supporta fino a 15 profili. Per aggiungerne uno nuovo, rimuovine uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVに登録できるプロフィールは15個までです。新規に追加するには、まず最初に既存のプロフィールを1つ削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV는 최대 15개의 프로필을 지원합니다. 다른 프로필을 추가하려면 기존의 프로필을 먼저 삭제하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV menyokong sehingga 15 profil. Untuk menambah profil lain, keluarkan satu dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV støtter opptil 15 profiler. Fjern en profil for å legge til en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ondersteunt maximaal 15 profielen. Om een profiel toe te voegen, moet je er eerst een verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV obsługuje do 15 profili. Aby dodać kolejny profil, usuń jeden z istniejących."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV é compatível com até 15 perfis. Para adicionar outro perfil, remova um primeiro."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV suporta até 15 perfis. Para adicionar outro perfil, remova um primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația Apple TV permite cel mult 15 profiluri. Pentru a adăuga un nou profil, eliminați altul în prealabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV можно создать не более 15 профилей. Чтобы добавить новый профиль, сначала удалите любой другой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV podporuje najviac 15 profilov. Pred pridaním ďalšieho profilu najskôr niektorý odstráňte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV podpira do 15 profilov. Če želite dodati nov profil, najprej enega odstranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV har stöd för upp till 15 profiler. Om du vill lägga till en profil till måste du först ta bort en befintlig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV รองรับได้สูงสุด 15 โปรไฟล์ ในการเพิ่มอีกหนึ่งโปรไฟล์ ให้เอาออกหนึ่งโปรไฟล์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV en fazla 15 profili destekler. Başka bir profil eklemek için önce birini silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV підтримує максимум 15 профілів. Щоб додати профіль, спершу вилучіть один із наявних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV hỗ trợ tối đa 15 hồ sơ. Để thêm một hồ sơ khác, trước tiên hãy xóa một hồ sơ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV最多支持添加15个用户的个人资料。若要添加其他个人资料，请先删除一个。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV支援最多15個個人檔案。如要加入其他個人檔案，請先移除一個。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV支援最多15個個人檔案。若要加入其他個人檔案，請先移除一個。"
          }
        }
      }
    },
