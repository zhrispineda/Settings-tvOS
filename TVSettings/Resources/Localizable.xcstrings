    "AVEnhanceDialogueLevelIsolateDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عزل صوت الحوار تمامًا لمن يحتاج إلى أقصى حد من الوضوح. سيتم تقليل عناصر المزيج الصوتي الأخرى بشكل جوهري."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aïlla completament el diàleg perquè sigui el més clar possible. Es redueixen considerablement altres components de la combinació d’àudio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogy jsou zcela izolované s ohledem na osoby, které potřebují co největší srozumitelnost. Hlasitost ostatních prvků zvukového mixu bude výrazně snížená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen er fuldstændig isoleret til gavn for brugere, der har brug for maksimal klarhed. De andre elementer i lydmikset reduceres betydeligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog wird für Personen vollständig isoliert, die maximale Verständlichkeit benötigen. Andere Elemente der Audioeingabe werden stark reduziert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διάλογος απομονώνεται εντελώς για τα άτομα που χρειάζονται μέγιστη καθαρότητα. Άλλα στοιχεία της μείξης ήχου θα μειώνονται σημαντικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is completely isolated for those who need maximum clarity. Other elements of the audio mix will be substantially reduced."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is completely isolated for those who need maximum clarity. Other elements of the audio mix will be substantially reduced."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is completely isolated for those who need maximum clarity. Other elements of the audio mix will be substantially reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aísla completamente el diálogo para que las personas que lo necesiten puedan escucharlo con la mayor claridad posible. Se minimiza el volumen del resto de elementos de la mezcla de audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se aíslan del todo para quienes necesitan la máxima claridad posible. Los otros elementos de la mezcla de audio se reducirán considerablemente."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se aíslan del todo para quienes necesitan la máxima claridad posible. Los otros elementos de la mezcla de audio se reducirán considerablemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogi eristetään täysin käyttäjille, jotka tarvitsevat parhaan mahdollisen selkeyden. Muita äänimiksauksen elementtejä vaimennetaan huomattavasti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues seront totalement isolés pour apporter un maximum de clarté aux personnes qui en ont le plus besoin. Le volume des autres éléments du mix audio sera sensiblement baissé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues sont complètement isolés pour les personnes qui ont besoin d’un maximum de clarté. Les autres éléments du mix audio seront considérablement réduits."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדיבור יבודד לחלוטין למי שזקוקים לצלילות מרבית. מרכיבים אחרים בשמע המשולב יוחלשו באופן משמעותי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन्हें अधिकतम स्पष्टता की ज़रूरत होती है उन लोगों के लिए डायलॉग को पूरी तरह अलग कर दिया जाता है। ऑडियो मिक्स के अन्य एलिमेंट बहुत हद तक कम कर दिए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijalog je potpuno izoliran za one kojima je potrebna maksimalna jasnoća. Ostali elementi audio miksa bit će znatno smanjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd teljesen izolálva van, hogy azok a személyek is hallhassák, akiknek maximális hangtisztaságra van szükségük. Az audiomix egyéb elemei jelentősen csökkentve vannak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog sepenuhnya terisolasi untuk pengguna yang memerlukan audio yang benar-benar jelas. Elemen lainnya dari mixing audio akan dikurangi secara drastis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dialoghi vengono completamente isolati per garantire la massima chiarezza uditiva. Gli altri elementi del mix audio verranno notevolmente attenuati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大限の明瞭さを必要とする人のために、対話を完全に分離します。オーディオミックスのその他の部分は大幅に低減されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 최대한 명료하게 들리기를 원하는 사람을 위해 대화 소리가 완전히 분리됩니다. 오디오 믹스의 다른 요소는 대폭 감소됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog diasingkan sepenuhnya untuk orang yang memerlukan kejelasan maksimum. Elemen lain pada campuran audio akan dikurangkan dengan ketara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen er fullstendig isolert for dem som trenger den så tydelig som mulig. Andre elementer av lydmiksen vil være betydelig redusert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen worden volledig geïsoleerd voor personen die maximale duidelijkheid nodig hebben. Andere elementen van de audiomix worden aanzienlijk verminderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogi będą całkowicie izolowane, zapewniając maksymalną czystość dźwięku. Głośność innych składników materiału audio zostanie znacznie obniżona."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diálogo é totalmente isolado, para quem precisa de máxima clareza. Outros elementos do mix de áudio serão reduzidos substancialmente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diálogos são isolados completamente para permitir a maior clareza possível. Os outros elementos da mistura de áudio serão reduzidos significativamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogurile sunt izolate complet pentru persoanele care au nevoie de claritate maximă. Celelalte elemente ale mixajului audio vor fi reduse substanțial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалоги изолируются для максимально четкого звучания. Остальные звуки значительно приглушаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialógy sú dokonale izolované od rušivých vplyvov pre osoby, ktoré potrebujú čo najlepšiu zrozumiteľnosť. Hlasitosť ostatných prvkov v mixe audia bude výrazne znížená."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog je povsem izoliran za osebe, za katere je potrebna večja jasnost. Drugi elementi zvočne slike bodo znatno zmanjšani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen isoleras fullständigt för personer som behöver maximal tydlighet. Andra element i ljudmixningen minskas avsevärt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกเสียงบทสนทนาแยกออกสำหรับผู้ที่ต้องการความชัดเจนสูงสุด ส่วนประกอบอื่นของเสียงที่ผสมกันจะถูกลดลงเป็นอย่างมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyaloglar maksimum konuşma netliğine ihtiyacı olan kişiler için tamamen izole edilir. Ses miksinin diğer öğeleri oldukça azaltılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діалоги повністю виокремлюються для максимальної чіткості. Інші звуки в аудіодоріжці можуть значно стишуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hội thoại được tách biệt hoàn toàn đối với những người cần độ rõ tối đa. Các thành phần khác của âm thanh tổng hợp sẽ được giảm xuống đáng kể."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对话会完全从其他声音中分离，供需要最高清晰度的用户听取。混音中的其他元素将大幅减少。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對話被完全隔離，為有需要用户提供最高的清晰度。其他混音元素將大幅降低。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會對需要最高清晰度的使用者完全隔離對白。混音的其他元件會大幅度降低。"
          }
        }
      }
    },
