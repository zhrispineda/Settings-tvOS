    "SaverBackdropPortraitClockChangeEveryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معدل التكرار الذي تريده لتغيير الصورة على شاشة التوقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria la freqüència amb què vulguis que canviï la foto de l’estalvi de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak často chcete fotky ve spořiči obrazovky měnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor ofte fotoet på din skærmskåner skifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, wie oft die Fotos deines Bildschirmschoners geändert werden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πόσο συχνά θέλετε να αλλάζει η φωτογραφία στην προφύλαξη οθόνης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want the photo on your screen saver to change."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want the photo on your screen saver to change."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want the photo on your screen saver to change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige con qué frecuencia quieres que cambie la foto del salvapantallas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué tan seguido quieres que cambien las fotos de tu protector de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué tan seguido quieres que cambien las fotos de tu protector de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, kuinka usein haluat näytönsäästäjän kuvan vaihtuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la fréquence à laquelle vous souhaitez changer de photo pour votre économiseur d’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la fréquence à laquelle vous voulez que votre économiseur change de photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את התדירות שבה יתחלפו התמונות בשומר המסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि आप अपने स्क्रीन सेवर में तस्वीर को कितनी बार बदलना चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koliko često želite da se fotografije zaštite zaslona mijenjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja, hogy milyen gyakran változzon a fotó a képernyővédőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih seberapa sering Anda ingin foto di penghemat layar Anda berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la frequenza di aggiornamento della foto di sfondo del salvaschermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンセーバに写っている写真をどれくらいの頻度で切り替えるかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 보호기의 사진을 변경할 빈도를 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kekerapan anda mahu foto pada penyelamat skrin anda berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor ofte du vil at skjermspareren skal endre bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal hoe vaak je de foto op je schermbeveiliging wilt wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak często zdjęcie wyświetlane przez wygaszacz ekranu ma być zmieniane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha com que frequência você deseja que a foto do protetor de tela seja alterada."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione com que regularidade deve ser alterada a fotografia na proteção de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți cât de frecvent doriți să se schimbe poza de pe screensaver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как часто будут сменяться фото в заставке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, ako často sa majú meniť fotky v šetriči obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Določite, kako pogosto naj se fotografija na ohranjevalniku zaslona zamenja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur ofta du vill att bilden på skärmsläckaren ska ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าคุณต้องการให้เปลี่ยนรูปภาพของภาพพักหน้าจอบ่อยแค่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran koruyucunuzdaki fotoğrafın hangi sıklıkta değişmesini istediğinizi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, як часто міняти фотографії на екранній заставці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tần suất mà bạn muốn ảnh trên trình bảo vệ màn hình thay đổi."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取屏幕保护程序照片更改的频率。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你要的螢幕保護程式相片更改頻率。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇螢幕保護程式上的照片要多久更換一次。"
          }
        }
      }
    },
    "SaverBackdropPortraitClockChoosePhotosDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار الصور التي يجب استخدامها للبورتريه. استخدم الكل، أو حدد المفضلة، أو النشاط المشترك، أو ألبومات محددة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria les fotos que vulguis que surtin a la categoria de retrats. Utilitza‑les totes, les favorites, les compartides o les d’àlbums específics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte fotky, které má spořič Portréty používat. Můžete použít všechny fotky nebo výběr omezit na oblíbené, sdílené aktivity nebo konkrétní alba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilke fotos der skal bruges til Portrætter. Brug alle, eller begræns til favoritter, delt aktivitet eller bestemte album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welche Fotos für „Porträts“ verwendet werden sollen. Nutze alle oder beschränke die Anzeige auf Favoriten, geteilte Aktivitäten oder bestimmte Alben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τις φωτογραφίες που θα χρησιμοποιηθούν για τα Πορτρέτα. Επιλέξτε είτε όλες οι φωτογραφίες είτε αγαπημένες ή κοινόχρηστες φωτογραφίες, ή συγκεκριμένα άλμπουμ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which photos should be used for Portraits. Use all, or limit to favorites, shared activity, or specific albums."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which photos should be used for Portraits. Use all, or limit to favourites, shared activity or specific albums."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which photos should be used for Portraits. Use all, or limit to favourites, shared activity or specific albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona qué fotos usar en el salvapantallas Retratos. Usa todas las fotos, solo las favoritas, las compartidas o las de álbumes específicos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué fotos se deben usar para Retratos. Usa todo o limita a favoritos, actividad compartida o álbumes específicos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué fotos se deben usar para Retratos. Usa todo o limita a favoritos, actividad compartida o álbumes específicos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Muotokuvissa käytettävät kuvat. Käytä kaikkia tai rajoita suosikkeihin, jaettuun toimintaan tai tiettyihin albumeihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les photos à utiliser dans Portraits. Utilisez toutes les photos ou limitez votre sélection aux photos favorites, aux activités partagées ou à des albums spécifiques."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les photos à utiliser dans Portraits. Utilisez toutes les photos ou uniquement celles parmi vos favoris, les photos partagées ou certains albums."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לבחור את התמונות שיוצגו ב״תמונות פורטרט״. ניתן להשתמש בכל התמונות או להגביל את השימוש לתמונות מועדפות, תמונות מפעילות משותפת או אלבומים מסוימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि किन तस्वीरों का इस्तेमाल पोर्ट्रेट के लिए किया जाना चाहिए। सभी का इस्तेमाल करें या पसंदीदा, शेयर की गई ऐक्टिविटी या ख़ास ऐल्बम तक सीमित रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite fotografije koje bi se trebale koristiti za Portrete. Upotrijebite sve ili ograničite na omiljene, dijeljenu aktivnost ili određene albume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja azokat a fotókat, amelyeket a Portrék képernyővédőhöz szeretne használni. Az összeset használhatja, vagy a használatot a kedvencekre, a megosztott tevékenységre, illetve meghatározott albumokra korlátozhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto mana yang harus digunakan untuk Potret. Gunakan semua, atau batasi untuk favorit, aktivitas bersama, atau album tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali foto utilizzare per il salvaschermo Ritratti. Usa tutte le foto o limita la selezione a quelle preferite, alle attività condivise o ad album specifici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ポートレート”に使用する写真を選択します。すべてを使用することも、お気に入り、共有アクティビティ、または特定のアルバムに制限することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인물 사진에 사용할 사진을 선택합니다. 모두 사용하거나 즐겨찾는 항목, 공유 활동 또는 특정 앨범으로 제한합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto yang patut digunakan untuk Potret. Gunakan semua atau hadkan kepada kegemaran, aktiviti dikongsi atau album khusus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bilder som skal brukes med Portrett. Bruk alle eller avgrens til favoritter, delt aktivitet eller bestemte albumer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke foto's moeten worden gebruikt voor portretten. Gebruik alles of beperk tot favorieten, gedeelde activiteit of specifieke albums."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcia, które mają być używane jako portrety. Możesz użyć wszystkich, tylko ulubionych lub udostępnianych zdjęć albo zdjęć z określonych albumów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais fotos você quer usar para o protetor de tela Retratos. Você pode selecionar todas as fotos ou se limitar às favoritas, compartilhadas ou incluídas em álbuns específicos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as fotografias que devem ser usadas para Retratos. Pode usar todas ou limitar a seleção às favoritas, atividade partilhada ou álbuns específicos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ce poze să fie utilizate pentru Portrete. Utilizați‑le pe toate sau limitați‑vă la favorite, activitatea partajată sau anumite albume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие фото будут использоваться для заставки «Портреты». Можно выбрать все фото либо только избранные, общие или фото из определенных альбомов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte fotky, ktoré sa majú používať v šetriči Portréty. Môžete použiť všetky fotky alebo obmedziť výber na obľúbené, spoločné aktivity alebo konkrétne albumy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, katere fotografije naj bodo uporabljene za Portrete. Uporabite vse ali se omejite na priljubljene vsebine, deljeno aktivnost ali posamezne albume."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka bilder som ska användas till Porträtt. Använd alla, eller begränsa till favoriter, delade aktiviteter eller specifika album."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปภาพที่ควรใช้เป็นภาพถ่ายบุคคล ใช้ทั้งหมด หรือจำกัดเฉพาะรายการโปรด กิจกรรมที่แชร์ หรืออัลบั้มที่ระบุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portreler ile hangi fotoğrafların kullanılması gerektiğini seçin. Tümünü kullanın veya favoriler, paylaşılan aktivite veya belirli albümlerle sınırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, які фотографії використовувати в Портретах. Використовувати всі або тільки улюблені чи спільні фото або ж певні альбоми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các ảnh sẽ được sử dụng cho Chân dung. Sử dụng tất cả hoặc giới hạn trong các mục ưa thích, hoạt động được chia sẻ hoặc album cụ thể."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取应该用于“人像”的照片。全部使用，或者限为使用个人收藏、共享活动或特定相簿。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇應該用於「人像」的相片。使用全部，或限於喜好項目，共享活動，或特定相簿。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇哪些照片應該用於「人像」。使用全部，或限於喜好項目，共享的活動，或特定相簿。"
          }
        }
      }
    },
