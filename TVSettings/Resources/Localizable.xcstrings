    "DedicatedCameraDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك كاميرا الاستمرار المخصصة إبقاء iPhone متصلًا بالتلفزيون، حتى يكون جاهزًا للاستخدام دائمًا. يجب استخدام iPhone يمكنك تركه بالقرب من التلفزيون طوال الوقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilitzes una càmera de continuïtat específica, pots deixar un iPhone connectat al televisor perquè sempre estigui a punt. Fes servir un iPhone que puguis deixar a prop del televisor en tot moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení vyhrazeného fotoaparátu přes službu Kontinuita vám umožňuje ponechat iPhone připojený k Apple TV, takže bude neustále k dispozici. Použijte iPhone, který můžete trvale nechávat poblíž televizoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et dedikeret kontinuitetskamera kan du have en iPhone, der har forbindelse til fjernsynet hele tiden, så det altid er klar til brug. Brug en iPhone, som du altid har placeret tæt på fjernsynet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer dedizierten Integrationskamera kannst du ein iPhone mit deinem TV-Gerät verbunden lassen, sodass es immer einsatzbereit ist. Verwende ein iPhone, das du immer in der Nähe deines TV-Geräts liegen lassen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αποκλειστική Κάμερα συνέχισης επιτρέπει τη διατήρηση της σύνδεσης ενός iPhone στην τηλεόρασή σας, ώστε να είναι πάντα έτοιμο προς χρήση. Χρησιμοποιήστε ένα iPhone που μπορείτε να αφήσετε πάντα κοντά στην τηλεόρασή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. Use an iPhone you can leave near your TV all the time."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. Use an iPhone you can leave near your TV all the time."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. Use an iPhone you can leave near your TV all the time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad específica te permite dejar un iPhone conectado al televisor para que esté siempre disponible. Usa un iPhone que puedas dejar cerca del televisor todo el tiempo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad dedicada te permite dejar un iPhone conectado a la TV para que siempre esté listo para usarse. Usa un iPhone que puedas dejar cerca de tu TV todo el tiempo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad dedicada te permite dejar un iPhone conectado a la TV para que siempre esté listo para usarse. Usa un iPhone que puedas dejar cerca de tu TV todo el tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varattu jatkuvuuskamera pitää iPhonen yhdistettynä TV:hen, joten se on aina käyttövalmis. Käytä iPhonea, jonka voit jättää aina TV:n lähelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une caméra Continuité dédiée vous permet de laisser un iPhone connecté à votre téléviseur de manière à ce qu’il soit toujours prêt à être utilisé. Utilisez un iPhone que vous pouvez laisser à proximité de votre téléviseur en permanence."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une caméra de continuité dédiée permet de maintenir un iPhone connecté à votre télévision pour pouvoir l’utiliser à tout moment. Utilisez un iPhone que vous pouvez laisser en permanence près de votre télévision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה ייעודית של ״המשכיות במצלמה״ מאפשרת לך לשמור על חיבור קבוע של iPhone לטלוויזיה, כך שהיא תמיד מוכנה לשימוש. באפשרותך להשתמש ב-iPhone שניתן להשאיר ליד הטלוויזיה באופן קבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशेष कॉन्टिन्यूटी कैमरा की मदद से iPhone को आपके टीवी से कनेक्टेड रखा जा सकता है, ताकि इसे हमेशा इस्तेमाल किया जा सके। किसी ऐसे iPhone का इस्तेमाल करें जिसे आप अपने TV के पास हमेशा छोड़ सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasebna Kamera kontinuiteta omogućuje da iPhone ostane povezan s vašim TV-om, tako da je uvijek spreman za korištenje. Koristite iPhone koji možete ostaviti blizu TV-a cijelo vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt folytonossági kamera lehetővé teszi, hogy az iPhone-ját a TV-hez csatlakoztatva tartsa, így az mindig használatra kész legyen. Olyan iPhone‑t használjon, amely mindig a TV‑je közelében maradhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan Kamera Kontinuitas khusus, iPhone akan terus terhubung ke TV Anda sehingga selalu siap digunakan. Gunakan iPhone yang dapat ditinggalkan di dekat TV Anda setiap saat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fotocamera Continuity dedicata ti consente di mantenere un iPhone connesso ad Apple TV in modo che sia sempre pronto all’uso. Usa un iPhone che puoi lasciare sempre vicino ad Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用の連係カメラを使えば、iPhoneをテレビに接続しておくことができ、いつでも使用できます。テレビの近くにいつも置いておけるiPhoneを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전용 연속성 카메라를 사용하면 iPhone을 TV에 연결된 상태로 유지하여 항상 이용할 수 있습니다. TV 근처에 항상 둘 수 있는 iPhone을 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera Kesinambungan khusus membolehkan anda memastikan iPhone terus bersambung ke TV anda, supaya ia sentiasa bersedia untuk digunakan. Gunakan iPhone yang boleh anda sentiasa tinggalkan berdekatan TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et dedikert kontinuitetskamera kan du holde en iPhone tilkoblet TV-en slik at den alltid er klar til bruk. Bruk en iPhone som kan oppbevares nær TV-en til enhver tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een speciale continuïteitscamera kun je een iPhone verbonden houden met je tv, zodat deze altijd klaar is voor gebruik. Gebruik een iPhone die je de hele tijd in de buurt van je tv kunt laten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skonfigurowaniu dedykowanej kamery Continuity iPhone jest stale połączony z Apple TV i gotowy do użycia. Użyj iPhone’a, który może zawsze znajdować się w pobliżu telewizora."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Câmera de Continuidade dedicada permite manter um iPhone conectado à TV, para que esteja sempre pronto para uso. Use um iPhone que você possa deixar sempre perto da TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Câmara de Continuidade exclusiva permite manter um iPhone ligado à Apple TV, sempre pronto a usar. Use um iPhone que possa deixar sempre perto da televisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cameră Continuitate dedicată vă permite să mențineți un iPhone conectat la televizor, pentru a fi oricând gata de utilizare. Utilizați un iPhone pe care îl puteți lăsa tot timpul în apropierea televizorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроив отдельную Непрерывную камеру, Вы сможете оставлять iPhone подключенным к телевизору, чтобы он всегда был готов к использованию. Выберите iPhone, который Вы сможете на постоянной основе оставить рядом с телевизором."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vyhradíte kameru pre kontinuitu, môžete ponechať iPhone pripojený k televízoru, aby bol vždy k dispozícii na používanie. Použite iPhone, ktorý môžete trvalo nechať v blízkosti televízora."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namenska enovita kamera vam omogoča, da ohranite povezavo iPhona s televizorjem, tako da je vedno pripravljen za uporabo. Uporabite iPhone, ki ga ne boste pogrešali in lahko ves čas ostane v bližini televizorja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en dedikerad kontinuitetskamera kan iPhone vara ansluten till en TV hela tiden så att den alltid är klar att använda. Använd en iPhone som du kan lämna nära TV:n hela tiden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กล้องต่อเนื่องเท่านั้นจะช่วยให้คุณเชื่อมต่อ iPhone กับทีวีของคุณทุกครั้งเพื่อให้พร้อมใช้เสมอ ใช้ iPhone ที่คุณสามารถทิ้งเครื่องไว้ใกล้ทีวีของคุณได้ตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atanmış bir Süreklilik Kamerası, iPhone’un TV’nize bağlı tutulup her zaman kullanıma hazır olmasını sağlar. Sürekli olarak TV’nizin yanında bırakabileceğiniz bir iPhone kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спеціально призначена неперервна камера дає змогу залишати iPhone підʼєднаним до телевізора, тому вона може бути завжди напоготові. Використовуйте iPhone, який ви можете залишити біля телевізора на тривалий час."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một Camera thông suốt chuyên biệt cho phép bạn duy trì kết nối của iPhone với TV, sao cho thiết bị luôn sẵn sàng để sử dụng. Sử dụng một iPhone mà bạn có thể để ở gần TV của mình mọi lúc."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "专用连续互通相机可让你保持iPhone与电视连接，以保证随时可用。使用可一直放在电视附近的iPhone。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "專用的「相機接續互通」讓你保持iPhone與電視的連線，方便你隨時使用。使用可以一直放在電視旁邊的iPhone。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "專用的「接續互通相機」讓你保持iPhone與電視的連線，以便你隨時使用。使用你可以一直放在電視旁的iPhone。"
          }
        }
      }
    },
    "DedicatedCameraDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك كاميرا الاستمرار المخصصة إبقاء iPhone متصلًا بالتلفزيون، حتى يكون جاهزًا للاستخدام دائمًا. لإعدادها، يجب قطع اتصال كاميرا الاستمرار الحالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilitzes una càmera de continuïtat específica, pots deixar un iPhone connectat al televisor perquè sempre estigui a punt. Per configurar‑la, desconnecta la càmera de continuïtat actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení vyhrazeného fotoaparátu přes službu Kontinuita vám umožňuje ponechat iPhone připojený k Apple TV, takže bude neustále k dispozici. Chcete‑li tuto funkci nastavit, odpojte fotoaparát, který máte momentálně přes službu Kontinuita připojený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et dedikeret kontinuitetskamera kan du have en iPhone, der har forbindelse til fjernsynet hele tiden, så det altid er klar til brug. Du skal først afbryde forbindelsen til det aktuelle kontinuitetskamera, før du kan indstille et nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer dedizierte Integrationskamera kannst du ein iPhone mit deinem TV-Gerät verbunden lassen, so dass es immer einsatzbereit ist. Zum Einrichten muss zuerst die Verbindung zur aktuellen Integrationskamera getrennt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αποκλειστική Κάμερα συνέχισης επιτρέπει τη διατήρηση της σύνδεσης ενός iPhone στην τηλεόρασή σας, ώστε να είναι πάντα έτοιμο προς χρήση. Για διαμόρφωση, αποσυνδέστε την τρέχουσα Κάμερα συνέχισης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. To set up, disconnect your current Continuity Camera."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. To set up, disconnect your current Continuity Camera."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated Continuity Camera lets you keep an iPhone connected to your TV, so it’s always ready to use. To set up, disconnect your current Continuity Camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad específica te permite dejar un iPhone conectado al televisor para que esté siempre disponible. Para iniciar la configuración, primero debes desconectar la cámara de continuidad actual."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad dedicada te permite dejar un iPhone conectado a la TV para que siempre esté listo para usarse. Para configurarlo, desconecta tu cámara de continuidad actual."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cámara de continuidad dedicada te permite dejar un iPhone conectado a la TV para que siempre esté listo para usarse. Para configurarlo, desconecta tu cámara de continuidad actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varattu jatkuvuuskamera pitää iPhonen yhdistettynä TV:hen, joten se on aina käyttövalmis. Katkaise nykyisen jatkuvuuskameran yhteys, jotta voit aloittaa käyttöönoton."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une caméra Continuité dédiée vous permet de laisser un iPhone connecté à votre téléviseur de manière à ce qu’il soit toujours prêt à être utilisé. Pour procéder à la configuration, déconnectez votre caméra Continuité actuelle."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une caméra de continuité dédiée permet de maintenir un iPhone connecté à votre télévision pour pouvoir l’utiliser à tout moment. Pour procéder à la configuration, déconnectez la caméra de continuité actuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה ייעודית של ״המשכיות במצלמה״ מאפשרת לך לשמור על חיבור קבוע של iPhone לטלוויזיה, כך שהיא תמיד מוכנה לשימוש. כדי להגדיר אותה, יש לנתק תחילה את ״המשכיות במצלמה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशेष कॉन्टिन्यूटी कैमरा की मदद से iPhone को आपके टीवी से कनेक्टेड रखा जा सकता है, ताकि इसे हमेशा इस्तेमाल किया जा सके। सेटअप करने के लिए अपना मौजूदा कॉन्टिन्यूटी कैमरा डिस्कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasebna Kamera kontinuiteta omogućuje da iPhone ostane povezan s vašim TV-om, tako da je uvijek spreman za korištenje. Za podešavanje odspojite trenutačnu Kameru kontinuiteta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt folytonossági kamera lehetővé teszi, hogy az iPhone-ját a TV-hez csatlakoztatva tartsa, így az mindig használatra kész legyen. A beállításhoz válassza le a jelenlegi folytonossági kameráját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan Kamera Kontinuitas khusus, iPhone akan terus terhubung ke TV Anda sehingga selalu siap digunakan. Untuk mengatur, putuskan Kamera Kontinuitas Anda saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fotocamera Continuity dedicata ti consente di mantenere un iPhone connesso ad Apple TV in modo che sia sempre pronto all’uso. Per configurarla, disconnetti la fotocamera Continuity attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用の連係カメラを使えば、iPhoneをテレビに接続しておくことができ、いつでも使用できます。設定するには、現在の連係カメラの接続を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전용 연속성 카메라를 사용하면 iPhone을 TV에 연결된 상태로 유지하여 항상 이용할 수 있습니다. 설정하려면 현재 연속성 카메라를 연결 해제하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera Kesinambungan khusus membolehkan anda memastikan iPhone terus bersambung ke TV anda, supaya ia sentiasa bersedia untuk digunakan. Untuk menyediakan, putuskan sambungan Kamera Kesinambungan semasa anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et dedikert kontinuitetskamera kan du holde en iPhone tilkoblet TV-en slik at den alltid er klar til bruk. Du må først koble fra det nåværende kontinuitets­kameraet før du kan legge til et nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een speciale continuïteitscamera kun je een iPhone verbonden houden met je tv, zodat deze altijd klaar is voor gebruik. Voor de configuratie verbreek je de verbinding met de huidige continuïteitscamera."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skonfigurowaniu dedykowanej kamery Continuity iPhone jest stale połączony z Apple TV i gotowy do użycia. Aby skonfigurować, rozłącz najpierw bieżącą kamerę Continuity."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Câmera de Continuidade dedicada permite manter um iPhone conectado à TV, para que esteja sempre pronto para uso. Para configurar, desconecte a Câmera de Continuidade atual."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Câmara de Continuidade exclusiva permite manter um iPhone ligado à Apple TV, sempre pronto a usar. Para configurar, desligue a Câmara de Continuidade atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cameră Continuitate dedicată vă permite să mențineți un iPhone conectat la televizor, pentru a fi oricând gata de utilizare. Pentru configurare, deconectați mai întâi camera Continuitate actuală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроив отдельную Непрерывную камеру, Вы сможете оставлять iPhone подключенным к телевизору, чтобы он всегда был готов к использованию. Чтобы выполнить настройку, отключите текущую Непрерывную камеру."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vyhradíte kameru pre kontinuitu, môžete ponechať iPhone pripojený k televízoru, aby bol vždy k dispozícii na používanie. Ak chcete nastaviť vyhradenú kameru, odpojte aktuálnu kameru pripojenú cez kontinuitu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namenska enovita kamera vam omogoča, da ohranite povezavo iPhona s televizorjem, tako da je vedno pripravljen za uporabo. Če jo želite nastaviti, prekinite povezavo s trenutno enovito kamero."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en dedikerad kontinuitetskamera kan iPhone vara ansluten till en TV hela tiden så att den alltid är klar att använda. Koppla från den befintliga kontinuitetskameran när du vill ställa in detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กล้องต่อเนื่องเท่านั้นจะช่วยให้คุณเชื่อมต่อ iPhone กับทีวีของคุณทุกครั้งเพื่อให้พร้อมใช้เสมอ ในการตั้งค่า ให้เลิกเชื่อมต่อกับกล้องต่อเนื่องปัจจุบันของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atanmış bir Süreklilik Kamerası, iPhone’un TV’nize bağlı tutulup her zaman kullanıma hazır olmasını sağlar. Ayarlamak için önce şu anki Süreklilik Kamerası bağlantınızı kesin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спеціально призначена неперервна камера дає змогу залишати iPhone підʼєднаним до телевізора, тому вона може бути завжди напоготові. Щоб налаштувати, відʼєднайте поточну неперервну камеру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một Camera thông suốt chuyên biệt cho phép bạn duy trì kết nối của iPhone với TV, sao cho thiết bị luôn sẵn sàng để sử dụng. Để thiết lập, hãy ngắt kết nối Camera thông suốt hiện tại của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "专用连续互通相机可让你保持iPhone与电视连接，以保证随时可用。若要设置，请与当前连续互通相机断开连接。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "專用的「相機接續互通」讓你保持iPhone與電視的連線，方便你隨時使用。如要設定，請中斷連接目前的「相機接續互通」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "專用的「接續互通相機」讓你保持iPhone與電視的連線，以便你隨時使用。若要設定，請中斷連接目前的「接續互通相機」。"
          }
        }
      }
    },
