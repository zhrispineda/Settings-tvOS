    "SettingsAudioBTPairingInstructionsFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز الاقتران المكوّن من ٤ أرقام المعروض على الجهاز \"%@\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el codi d’enllaç de 4 dígits que es mostra al dispositiu “%@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte čtyřmístný párovací kód zobrazený na zařízení „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv den 4-cifrede pardannelseskode, der vises på “%@“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den 4-stelligen Kopplungscode ein, der auf dem Gerät „%@“ angezeigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον 4ψήφιο κωδικό ζευγοποίησης που εμφανίζεται στη συσκευή «%@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 4 digit pairing code shown on device “%@”."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the four digit pairing code shown on device “%@”."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 4-digit pairing code shown on device “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de enlace de 4 dígitos que aparece en el dispositivo “%@”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código de enlace de 4 dígitos que se muestra en el dispositivo “%@”."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código de enlace de 4 dígitos que se muestra en el dispositivo “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä nelinumeroinen parinmuodostuskoodi, joka näkyy laitteessa ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code de jumelage à 4 chiffres affiché sur l’appareil « %@ »."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le code de jumelage à 4 chiffres qui s’affiche sur l’appareil « %@ »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין את קוד הקישור בן 4 הספרות שמופיע במכשיר ״%@״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस “%@” पर दिखाया गया 4 अंकों का पेयरिंग कोड दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite 4-znamenkasti kôd za uparivanje prikazan na uređaju “%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja be a(z) „%@” eszközén megjelenő 4 számjegyű párosítási kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode pemasangan 4 digit yang ditampilkan di perangkat “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di abbinamento di 4 cifre mostrato sul dispositivo “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス“%@”に表示されている4桁のペアリングコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 기기에 표시된 4자리 페어링 코드를 입력하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kod berpasangan 4 digit yang ditunjukkan pada peranti “%@”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi den firesifrede koden som vises på enheten «%@»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de 4-cijferige koppelingscode in die wordt weergegeven op '%@'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj 4-cyfrowy kod łączenia w parę widoczny na urządzeniu „%@”."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de emparelhamento de 4 dígitos mostrado no dispositivo “%@”."
          }
        },
        "pt_PT": {
          "stringUnit": {
