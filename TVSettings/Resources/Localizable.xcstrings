    "AdaptiveVolumeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط مستوى صوت الوسائط حسب البيئة المحيطة بك."
          }
        },
        "ca": {
