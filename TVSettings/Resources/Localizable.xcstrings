    "SaverDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوصى بالصور العائمة والأشكال الورقية على أجهزة التلفزيون البلازمية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recomana seleccionar Flotant i Papiroflèxia per als televisors de plasma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro plazmové televizory jsou doporučeny spořiče obrazovky Plovoucí a Origami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flydende og Origami anbefales til plasmafjernsyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Plasmafernseher werden „Schwebend“ und „Origami“ empfohlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές «Αιώρηση» και «Οριγκάμι» συνιστώνται για τηλεοράσεις plasma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating and Origami are recommended for plasma TVs."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating and Origami are recommended for plasma TVs."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating and Origami are recommended for plasma TVs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda seleccionar Flotante o Papiroflexia para los televisores de plasma."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda seleccionar Flotante u Origami para las TV de plasma."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda seleccionar Flotante u Origami para las TV de plasma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasmatelevisioille suositellaan Kelluvaa ja Origamia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les effets Flottant et Origami sont recommandés pour les téléviseurs plasma."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les effets Flottant et Origami sont recommandés pour les télévisions plasma."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור טלוויזיות פלזמה, מומלץ להשתמש ב״צף״ וב״אוריגמי״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्लोटिंग और ओरिगामी की अनुशंसा प्लाज़्मा टीवी के लिए की गई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teme Plutanje i Origami preporučuju se za plazma TV prijemnike."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A plazmatévékhez a Lebegés és az Origami ajánlott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapung dan Origami disarankan untuk TV plasma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i televisori al plasma si consigliano foto fluttuanti e origami."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラズマテレビの場合は、フローティングと折り紙をお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플라즈마 TV에는 플로팅 및 종이접기를 권장합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terapung dan Origami disyorkan untuk TV plasma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytende og Origami anbefales for plasma-TV-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Zwevend' en 'Origami' worden aanbevolen voor plasma-tv's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla telewizorów plazmowych zalecane są efekty Swobodne i Origami."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutuante e Origami são recomendados para TVs de plasma."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os efeitos Flutuante e Origami são recomendados para televisões com ecrãs a plasma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotant și Origami sunt recomandate pentru televizoarele cu plasmă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходы «Плавающий» и «Оригами» рекомендуются для телевизоров с плазменными экранами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre plazmové televízory sa odporúčajú prechody Pohyblivý a Origami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Načina Plavajoče in Origami sta priporočljiva za plazma televizorje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytande och Origami rekommenderas för plasma-TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำให้ใช้ภาพลอยและภาพโอริกามิสำหรับทีวีจอพลาสมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plazma TV’ler için Serbest ve Origami önerilmektedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для плазмових ТВ рекомендовано використовувати «Течії» і «Оригамі»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả trôi và Xếp giấy được đề xuất cho các TV plasma."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "建议在等离子电视机上使用浮动和折纸效果。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "等離子電視機上建議使用「浮動」或「摺紙效果」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "電漿電視建議使用「浮動」和「摺紙」。"
          }
        }
      }
    },
