    "PrivacyLogFileInstructionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الملف: %@\n\nيمكنك عرض هذه البيانات من خلال مشاركة الملف مع جهاز Apple باستخدام الإرسال السريع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida de l’arxiu: %@\n\nPer veure aquestes dades, comparteix l’arxiu amb un altre dispositiu Apple a través de l’AirDrop."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost souboru: %@\n\nTato data zobrazíte sdílením souboru s jiným zařízením přes AirDrop."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivstørrelse: %@\n\nDu kan se disse data ved at dele arkivet med en anden Apple-enhed vha. AirDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateigröße: %@\n\nDu kannst diese Daten anzeigen, indem du die Datei über AirDrop mit einem anderen Apple-Gerät teilst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέγεθος αρχείου: %@\n\nΓια να προβάλετε αυτά τα δεδομένα, μοιραστείτε το αρχείο με μια άλλη συσκευή Apple μέσω AirDrop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File Size: %@\n\nYou can view this data by sharing the file with another Apple device using AirDrop."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "File Size: %@\n\nYou can view this data by sharing the file with another Apple device using AirDrop."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "File Size: %@\n\nYou can view this data by sharing the file with another Apple device using AirDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del archivo: %@\n\nPuedes consultar estos datos compartiendo el archivo con otro dispositivo Apple mediante AirDrop."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de archivo: %@\n\nPuedes ver estos datos al compartir el archivo con otro dispositivo Apple mediante AirDrop."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de archivo: %@\n\nPuedes ver estos datos al compartir el archivo con otro dispositivo Apple mediante AirDrop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostokoko: %@\n\nVoit tarkastella näitä tietoja jakamalla tiedoston toiseen Apple-laitteeseen AirDropilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille du fichier : %@\n\nVous pouvez consulter ces données en partageant le fichier avec un autre appareil Apple en utilisant AirDrop."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille du fichier : %@\n\nVous pouvez visualiser ces données en partageant le fichier avec un autre appareil Apple au moyen d’AirDrop."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל הקובץ: %@\n\nבאפשרותך לבדוק מידע זה על ידי שיתוף הקובץ עם מכשיר Apple נוסף באמצעות AirDrop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल आकार : %@\n\nआप AirDrop के इस्तेमाल से किसी दूसरे Apple डिवाइस के साथ फ़ाइल शेयर कर के इसका डेटा देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veličina datoteke: %@\n\nOve podatke možete gledati tako da AirDropom podijelite datoteku s drugim Apple uređajem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájlméret: %@\n\nAz adatokat megtekintheti, ha AirDrop használatával megosztja a fájlt egy másik Apple eszközzel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran File: %@\n\nAnda dapat melihat data ini dengan membagikan file dengan perangkat Apple lain menggunakan AirDrop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensioni file: %@\n\nPuoi visualizzare questi dati condividendo il file con un altro dispositivo Apple che utilizza AirDrop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルサイズ: %@\n\nAirDropを使用してほかのAppleデバイスとファイルを共有することで、このデータを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 크기: %@\n\n이 데이터는 AirDrop을 사용하여 다른 Apple 기기와 파일을 공유하여 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz Fail: %@\n\nAnda boleh melihat data ini dengan berkongsi fail bersama peranti Apple lain menggunakan AirDrop."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filstørrelse: %@\n\nDu kan se disse dataene ved å dele filen med en annen Apple-enhet via AirDrop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestandsgrootte: %@\n\nJe kunt deze gegevens bekijken door het bestand te delen met een ander Apple apparaat dat gebruikmaakt van AirDrop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielkość pliku: %@\n\nMożesz wyświetlić tę informację, udostępniając plik innemu urządzeniu Apple przez AirDrop."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do Arquivo: %@\n\nVocê pode usar o AirDrop para compartilhar o arquivo com outro dispositivo da Apple para visualizar esses dados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do ficheiro: %@\n\nPara ver estes dados, partilhe o ficheiro com outro dispositivo Apple através de AirDrop."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiune fișier: %@\n\nPuteți vizualiza aceste date prin partajarea fișierului cu un alt dispozitiv Apple utilizând AirDrop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер файла: %@\n\nЭти данные можно просмотреть, отправив файл на другое устройство Apple через AirDrop."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Veľkosť súboru: %@\n\nTieto dáta môžete zobraziť zdieľaním súboru s iným Apple zariadením cez AirDrop."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost datoteke: %@\n\nTe podatke si lahko ogledate tako, da delite datoteko z drugo napravo Apple, ki uporablja funkcijo AirDrop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filstorlek: %@\n\nDu kan visa dessa data genom att dela filen med en annan Apple-enhet via AirDrop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดไฟล์: %@\n\nคุณสามารถดูข้อมูลนี้ได้โดยการแชร์ไฟล์กับอุปกรณ์ Apple อีกเครื่องโดยใช้ AirDrop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya Büyüklüğü: %@\n\nBu veriyi görüntülemek için dosyayı AirDrop kullanarak başka bir Apple aygıtı ile paylaşabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір файлу: %@\n\nМожна переглянути ці дані, передавши цей файл на інший пристрій Apple за допомогою AirDrop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích cỡ tệp: %@\n\nBạn có thể xem dữ liệu này bằng cách chia sẻ tệp với một thiết bị Apple khác bằng AirDrop."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "文件大小：%@\n\n你可以使用隔空投送与另一台Apple设备共享该文件来查看此数据。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案大小：%@\n\n你可使用AirDrop將檔案分享至另一部Apple裝置來檢視此資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案大小：%@\n\n你可以使用AirDrop與其他Apple裝置共享檔案來檢視這項資料。"
          }
        }
      }
    },
