    "ResetDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد \"إعادة التعيين\" لإعادة تعيين Apple TV إلى إعدادات المصنع ومسح جميع الإعدادات والمعلومات.\n\nحدد \"إعادة التعيين والتحديث\" لإعادة تعيين Apple TV إلى إعدادات المصنع، ومسح جميع الإعدادات والمعلومات، وتحديثه إلى آخر إصدار من tvOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona “Restableix” per restaurar la configuració de fàbrica de l’Apple TV i esborrar‑ne els paràmetres i tota la informació.\n\nSelecciona “Restableix i actualitza” per restaurar la configuració de fàbrica de l’Apple TV, esborrar‑ne els paràmetres i tota la informació, i actualitzar‑lo a la darrera versió del tvOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volbou Resetovat obnovíte tovární nastavení Apple TV a smažete všechna svoje nastavení a data.\n\nVolbou Resetovat a aktualizovat obnovíte tovární nastavení Apple TV, smažete všechna svoje nastavení a data a provedete aktualizaci na nejnovější verzi tvOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Nulstil for at gendanne din Apple TV-enhed til fabriksindstillinger og slette alle indstillinger og oplysninger.\n\nVælg Nulstil og opdater for at gendanne din Apple TV-enhed til fabriksindstillinger, slette alle indstillinger og oplysninger og opdatere til den seneste tvOS-version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Zurücksetzen“, um das Apple TV zurückzusetzen und alle Einstellungen und Informationen zu löschen.\n\nWähle „Zurücksetzen und Aktualisieren“, um das Apple TV auf die Werkseinstellungen zurückzusetzen, alle Einstellungen und Informationen zu löschen und auf die neueste tvOS-Version zu aktualisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «Επαναφορά» για επαναφορά του Apple TV στις εργοστασιακές ρυθμίσεις και σβήσιμο όλων των ρυθμίσεων και πληροφοριών.\n\nΕπιλέξτε «Επαναφορά και ενημέρωση» για επαναφορά του Apple TV στις εργοστασιακές ρυθμίσεις, σβήσιμο όλων των ρυθμίσεων και πληροφοριών και ενημέρωση στην πιο πρόσφατη έκδοση tvOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Reset to restore your Apple TV to factory settings and erase all settings and information.\n\nSelect Reset and Update to restore your Apple TV to factory settings, erase all settings and information, and update to the latest tvOS version."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Reset to restore your Apple TV to factory settings and erase all settings and information.\n\nSelect Reset and Update to restore your Apple TV to factory settings, erase all settings and information, and update to the latest tvOS version."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Reset to restore your Apple TV to factory settings and erase all settings and information.\n\nSelect Reset and Update to restore your Apple TV to factory settings, erase all settings and information, and update to the latest tvOS version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Restablecer para restaurar los ajustes originales del Apple TV y borrar todos los ajustes y los datos.\n\nSelecciona “Restablecer y actualizar” para restaurar los ajustes originales del Apple TV, borrar todos los ajustes y los datos, y actualizarlo a la última versión de tvOS disponible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Restablecer para restaurar tu Apple TV a la configuración predeterminada y borrar toda su configuración y datos.\n\nSelecciona Restablecer y actualizar para restaurar tu Apple TV a la configuración predeterminada, borrar toda su configuración y datos, y actualizarlo a la versión más reciente de tvOS."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Restablecer para restaurar tu Apple TV a la configuración predeterminada y borrar toda su configuración y datos.\n\nSelecciona Restablecer y actualizar para restaurar tu Apple TV a la configuración predeterminada, borrar toda su configuración y datos, y actualizarlo a la versión más reciente de tvOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa Apple TV:n tehdasasetuksiin ja tyhjentää kaikki asetukset ja tiedot valitsemalla Nollaa.\n\nVoit palauttaa Apple TV:n tehdasasetuksiin, tyhjentää kaikki asetukset ja tiedot ja päivittää laitteen uusimpaan tvOS-versioon valitsemalla Nollaa ja päivitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Réinitialiser pour réinitialiser tous les réglages de votre Apple TV et effacer toutes les données.\n\nSélectionnez « Réinitialiser et mettre à jour » pour réinitialiser tous les réglages de votre Apple TV, effacer toutes les données et mettre à jour vers la dernière version de tvOS."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez « Réinitialiser » pour rétablir les réglages d’origine de votre Apple TV et réinitialiser tous les réglages et les informations.\n\nSélectionnez « Réinitialiser et mettre à jour » pour rétablir les réglages d’origine de votre Apple TV, réinitialiser tous les réglages et les informations, et effectuer une mise à jour vers la dernière version de tvOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור ב״איפוס״ כדי לשחזר את הגדרות היצרן של ה-Apple TV ולמחוק את כל ההגדרות והמידע.\n\nיש לבחור ב״איפוס ועדכון״ כדי לשחזר את הגדרות היצרן של ה-Apple TV, למחוק את כל ההגדרות והמידע ולעדכן לגירסת ה-tvOS העדכנית ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple TV को फ़ैक्ट्री सेटिंग पर रीस्टोर करने और सभी सेटिंग और जानकारी मिटाने के लिए “रीसेट करें” चुनें।\n\nअपने Apple TV को फ़ैक्ट्री सेटिंग पर रीस्टोर करने, सभी सेटिंग और जानकारी को मिटाने और tvOS के नवीनतम संस्करण पर अपडेट करने के लिए “रीसेट और अपडेट करें” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite “Resetiraj” za resetiranje Apple TV‑a na tvorničke postavke te brisanje svih postavki i informacija.\n\nOdaberite “Resetiraj i ažuriraj” za resetiranje Apple TV‑a na tvorničke postavke, brisanje svih postavki i informacija te ažuriranje na najnoviju verziju tvOS-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Alaphelyzetbe állítás kiválasztásával visszaállítja az Apple TV gyári beállításait, és töröl minden beállítást és információt.\n\nAz Alaphelyzetbe állítás és frissítés kiválasztásával visszaállítja az Apple TV gyári beállításait, töröl minden beállítást és információt, és frissít a legújabb tvOS-verzióra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Atur Ulang untuk memulihkan Apple TV Anda ke pengaturan pabrik serta menghapus semua pengaturan dan informasi.\n\nPilih Atur Ulang dan Perbarui untuk memulihkan Apple TV Anda ke pengaturan pabrik, menghapus semua pengaturan dan informasi, serta memperbarui ke tvOS versi terbaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona Inizializza per riportare Apple TV alle impostazioni di fabbrica e inizializzare impostazioni e dati.\n\nScegli “Inizializza e aggiorna” per riportare Apple TV alle impostazioni di fabbrica, inizializzare le impostazioni e i dati e installare l’ultima versione di tvOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVを工場出荷時の設定に復元してすべての設定と情報を消去する場合は、“リセット”を選択してください。\n\nApple TVを工場出荷時の設定に復元してすべての設定と情報を消去し、最新のtvOSバージョンにアップデートする場合は、“リセットしてアップデート”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV를 초기 설정으로 복원하고 모든 설정 및 정보를 지우려면 재설정을 선택하십시오.\n\nApple TV를 초기 설정으로 복원하고, 모든 설정 및 정보를 지우며, 최신 tvOS 버전으로 업데이트하려면 재설정 및 업데이트를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Reset untuk memulihkan Apple TV anda kepada seting kilang dan memadamkan semua seting serta maklumat.\n\nPilih Reset dan Kemas Kini untuk memulihkan Apple TV anda kepada seting kilang, padamkan semua seting serta maklumat dan kemas kini kepada versi tvOS terkini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Nullstill for å gjenopprette Apple TV til fabrikkinnstillingene og slette alle innstillinger og data.\n\nVelg Nullstill og oppdater for å gjenopprette Apple TV til fabrikkinnstillingene, slette alle innstillinger og data og oppdatere til nyeste tvOS-versjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer 'Herstel' om de fabrieksinstellingen van je Apple TV te herstellen en alle instellingen en informatie te wissen.\n\nSelecteer 'Herstel en werk bij' om de fabrieksinstellingen van je Apple TV te herstellen, alle instellingen en informatie te wissen en bij te werken naar de nieuwste versie van tvOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Wyzeruj, aby przywrócić ustawienia fabryczne Apple TV oraz wymazać wszystkie ustawienia i dane.\n\nWybierz Wyzeruj i uaktualnij, aby przywrócić ustawienia fabryczne Apple TV, usunąć wszystkie ustawienia i dane oraz uaktualnić go do najnowszej wersji tvOS."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Redefinir para restaurar a Apple TV aos ajustes de fábrica e apagar todos os ajustes e informações.\n\nSelecione Redefinir e Atualizar para restaurar a Apple TV aos ajustes de fábrica, apagar todos os ajustes e informações e atualizar para a versão mais recente do tvOS."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Repor para restaurar as definições de fábrica na Apple TV e apagar todas as outras definições e informação.\n\nSelecione Repor e atualizar para restaurar as definições de fábrica na Apple TV, apagar todas as outras definições e informação, e atualizar com a versão mais recente do tvOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați Resetați pentru a restaura Apple TV‑ul la configurările din fabrică și pentru a șterge toate configurările și informațiile.\n\nSelectați Resetați și actualizați pentru a restaura Apple TV‑ul la configurările din fabrică, pentru a șterge toate configurările și informațiile și pentru a actualiza la cea mai recentă versiune de tvOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Сбросить», чтобы восстановить заводские настройки Apple TV и стереть все настройки и информацию.\n\nВыберите «Сбросить и обновить», чтобы восстановить заводские настройки Apple TV, стереть все настройки и информацию, а также обновить tvOS до новейшей версии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete na svojom Apple TV obnoviť pôvodné nastavenia a vymazať všetky nastavenia a informácie, vyberte Resetovať.\n\nAk chcete na svojom Apple TV obnoviť pôvodné nastavenia, vymazať všetky nastavenia a informácie a aktualizovať na najnovšiu verziu tvOS, vyberte Resetovať a aktualizovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite možnost Ponastavi, da ponastavite Apple TV na tovarniške nastavitve ter izbrišete vse nastavitve in informacije.\n\nIzberite možnost Ponastavi in posodobi, da ponastavite Apple TV na tovarniške nastavitve, izbrišete vse nastavitve in informacije ter posodobite napravo na najnovejšo različico tvOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Nollställ om du vill återställa Apple TV till fabriksinställningarna och radera alla inställningar och all information.\n\nVälj Nollställ och uppdatera om du vill återställa Apple TV till fabriksinställningarna, radera alla inställningar och all information och uppdatera till senaste versionen av tvOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรีเซ็ตเพื่อกู้คืน Apple TV ของคุณให้กลับเป็นการตั้งค่าจากโรงงานและลบการตั้งค่าและข้อมูลทั้งหมด\n\nเลือกรีเซ็ตและอัปเดตเพื่อกู้คืน Apple TV ของคุณให้กลับเป็นการตั้งค่าจากโรงงาน ลบการตั้งค่าและข้อมูลทั้งหมด และอัปเดต tvOS เป็นเวอร์ชั่นล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nizi fabrika ayarlarına geri yükleyip tüm ayarları ve bilgileri silmek için Sıfırla’yı seçin.\n\nApple TV’nizi fabrika ayarlarına geri yüklemek, tüm ayarları ve bilgileri silmek ve en son tvOS sürümüne güncellemek için Sıfırla ve Güncelle’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Скинути», щоб відновити Apple TV до заводських параметрів і стерти всі параметри й дані.\n\nВиберіть «Скинути й оновити», щоб відновити Apple TV до заводських параметрів, стерти всі параметри й дані та оновити до останньої версії tvOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Đặt lại để khôi phục Apple TV của bạn về cài đặt gốc, đồng thời xóa tất cả các cài đặt và thông tin.\n\nChọn Đặt lại và cập nhật để khôi phục Apple TV của bạn về cài đặt gốc, xóa tất cả các cài đặt và thông tin, đồng thời cập nhật lên phiên bản tvOS mới nhất."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“还原”可将Apple TV恢复为出厂设置并抹掉所有设置和信息。\n\n选择“还原并更新”可将Apple TV恢复为出厂设置、抹掉所有设置和信息并更新至最新Apple tvOS版本。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「重設」以將Apple TV還原為出廠預設值，並清除所有設定及資料。\n\n選擇「重設並更新」以將Apple TV還原為出廠預設值、清除所有設定及資料，並更新到tvOS的最新版本。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選取「重置」來將Apple TV回復成原廠設定，並清除所有設定和資訊。\n\n請選取「重置並更新」來將Apple TV回復成原廠設定、清除所有設定和資訊，並更新到最新的tvOS版本。"
          }
        }
      }
    },
    "ResetFailedText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إعادة تعيين الإعدادات.\nيمكنك المحاولة مرة أخرى، وإذا استمرت المشكلة، فحدد \"استعادة\" بدلاً من ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot restablir la configuració.\nTorna-ho a provar i, si el problema continua, selecciona “Restaura”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení nelze resetovat.\nMůžete to zkusit znovu. Pokud problém přetrvává, vyberte volbu Obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine indstillinger kan ikke nulstilles.\nDu kan prøve igen, men hvis problemet fortsætter, skal du vælge Gendan i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen können nicht zurückgesetzt werden.\nDu kannst es erneut versuchen und, falls das Problem weiterhin besteht, stattdessen „Wiederherstellen“ auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η επαναφορά των ρυθμίσεών σας. \nΔοκιμάστε ξανά και, αν το πρόβλημα παραμένει, επιλέξτε «Επαναφορά»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reset your settings.\nYou can try again and if the problem persists, select Restore instead."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reset your settings.\nYou can try again and, if the problem persists, select Restore instead."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reset your settings.\nYou can try again and if the problem persists, select Restore instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden restablecer los ajustes.\nInténtalo de nuevo y, si el problema persiste, selecciona Restaurar."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restablecer la configuración.\nPuedes reintentar. Si el problema persiste, selecciona Restaurar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restablecer la configuración.\nPuedes reintentar. Si el problema persiste, selecciona Restaurar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetuksia ei voida nollata. Voit yrittää uudelleen, ja jos ongelma jatkuu, valitse sen sijaan Palautus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de réinitialiser vos réglages.\nRéessayez. Si le problème persiste, sélectionnez Restaurer."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de réinitialiser les réglages. Vous pouvez réessayer. Si le problème persiste, sélectionnez Restaurer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאפס את ההגדרות.\nבאפשרותך לנסות שוב. אם הבעיה נמשכת, יש לבחור באפשרות ״שחזור״ במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेटिंग रीसेट नहीं की जा सकती हैं।\nआप फिर कोशिश कर सकते हैं और यदि समस्या बनी रहती है, तो “रीस्टोर करें” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše se postavke ne mogu resetirati.\nMožete pokušati ponovno i ako problem i dalje bude prisutan, pokrenite obnavljanje umjesto resetiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások nem állíthatók alaphelyzetbe.\nPróbálja újra, és ha a probléma továbbra is fennáll, válassza a Visszaállítás lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengatur ulang pengaturan Anda.\nAnda dapat mencoba lagi dan, jika masalah berlanjut, pilih Pulihkan sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile inizializzare le impostazioni.\nRiprova. Se il problema persiste, seleziona l’opzione Inizializza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定をリセットできません。\nやり直してみて、それでも問題が解決しない場合は、代わりに“復元”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 초기화할 수 없습니다. \n다시 시도해 보고 문제가 계속 발생하면 ‘복원’을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak boleh mereset seting anda.\nAnda boleh mencuba lagi dan jika masalah berterusan, pilih Pulihkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nullstille innstillingene.\nPrøv igjen. Hvis problemet vedvarer, kan du velge Gjenopprett i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je instellingen kunnen niet opnieuw worden ingesteld.\nJe kunt het opnieuw proberen en als het probleem zich blijft voordoen, selecteer je 'Zet terug'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wyzerować ustawień.\nSpróbuj ponownie. Jeśli problem będzie się powtarzać, wybierz Odtwórz."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível redefinir os ajustes.\nTente novamente. Se o problema persistir, selecione Restaurar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível repor as definições.\nPode voltar a tentar e, se o problema persistir, selecione Restaurar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurările nu au putut fi resetate.\nReîncercați și, dacă problema persistă, selectați opțiunea „Restaurați”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается сбросить настройки.\nПопробуйте снова. Если проблема не исчезнет, выполните восстановление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nastavenia sa nedajú resetovať.\nMôžete to skúsiť znovu a ak problém pretrváva, vyberte namiesto toho Obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaših nastavitev ni mogoče ponastaviti.\nLahko poskusite znova ali pa izberite možnost Ponastavi, če ne odpravite težave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att nollställa dina inställningar.\nFörsök igen. Om problemet kvarstår väljer du Återskapa istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถรีเซ็ตการตั้งค่าของคุณได้\nคุณสามารถลองอีกครั้งได้และหากยังเกิดปัญหาอยู่ ให้เลือกกู้คืนแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız sıfırlanamıyor.\nYeniden deneyin. Sorun sürerse onun yerine Geri Yükle’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається скинути ваші налаштування.\nСпробуйте ще раз. Якщо проблема не зникне, виберіть натомість «Відновити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt lại cài đặt của bạn.\nBạn có thể thử lại và nếu sự cố vẫn tiếp diễn, hãy chọn Khôi phục."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法还原你的设置。\n你可以重试。如果问题仍然存在，请选择“恢复”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重設設定。\n你可以再試一次，如問題持續，請選擇「還原」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重置你的設定。\n你可以再試一次，若問題持續發生，請改為選取「回復」。"
          }
        }
      }
    },
