    "AccountsUserSignOutAppleAccountDisabledPrimaryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم هذا الحساب لحفظ البيانات والوصول إلى تطبيق المنزل من Apple وصور iCloud. لاستخدام حساب مختلف، يجب إزالة ملف التعريف هذا من Apple TV ثم إضافة ملف تعريف افتراضي جديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte s’utilitza per desar dades i accedir a l’Apple Home i a les fotos a l’iCloud. Per utilitzar un altre compte, elimina el perfil de l’Apple TV i, després, afegeix un perfil per omissió nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet se používá pro ukládání dat a přístup k Domácnosti Apple a fotkám na iCloudu. Chcete‑li použít jiný účet, odeberte tento profil z Apple TV a pak přidejte nový výchozí profil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto bruges til at gemme data og få adgang til Apple Hjem og iCloud-fotos. Hvis du vil bruge en anden konto, skal du først fjerne denne profil fra Apple TV og derefter tilføje en ny standardprofil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account wird verwendet, um Daten zu sichern und auf Apple Home und iCloud-Fotos zuzugreifen. Um einen anderen Account zu verwenden, entferne dieses Profil vom Apple TV und füge dann ein neues Standardprofil hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός χρησιμοποιείται για αποθήκευση δεδομένων και πρόσβαση στην Οικία Apple και τις Φωτογραφίες iCloud. Για χρήση διαφορετικού λογαριασμού, αφαιρέστε αυτό το προφίλ από το Apple TV, και στη συνέχεια προσθέστε ένα νέο προεπιλεγμένο προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is used to save data and access Apple Home and iCloud Photos. To use a different account, remove this profile from Apple TV, then add a new default profile."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is used to save data and access Apple Home and iCloud Photos. To use a different account, remove this profile from Apple TV, then add a new default profile."
