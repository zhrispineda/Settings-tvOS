        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버튼은 이미 사용 중입니다. 다른 버튼을 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butang ini telah digunakan. Cuba butang berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne knappen er allerede i bruk. Prøv med en annen knapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze knop wordt al gebruikt. Probeer een andere knop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten przycisk jest już używany. Spróbuj wybrać inny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este botão já está sendo usado. Tente um botão diferente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este botão já está em uso. Experimente outro botão."
          }
        },
