    "APCRDEveryTimeCodeRemoveFromHomeMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لطلب رمز PIN في كل مرة تستخدم البث السريع، يجب إزالة هذا الـ Apple TV من منزلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per demanar un PIN cada vegada que vols utilitzar l’AirPlay has d’eliminar l’Apple TV de casa teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud chcete na Apple TV požadovat PIN pro každé použití AirPlay, musíte ji odstranit z domácnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil kræve pinkode, hver gang der streames med AirPlay, skal du fjerne dette Apple TV fra dit Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bei jedem Senden mit AirPlay ein PIN angefordert werden soll, muss dieses Apple TV von deinem Zuhause entfernt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να απαιτείται κωδικός PIN κάθε φορά που επιθυμείτε αναπαραγωγή μέσω AirPlay, πρέπει να αφαιρέσετε αυτό το Apple TV από την οικία σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To require a PIN every time you want to AirPlay, you need to remove this Apple TV from your home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To require a PIN every time you want to AirPlay, you need to remove this Apple TV from your home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To require a PIN every time you want to AirPlay, you need to remove this Apple TV from your home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un código PIN cada vez que quieras enviar contenido por AirPlay, tienes que quitar este Apple TV de tu app Casa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un PIN cada vez que se quiera transmitir por AirPlay, debes eliminar este Apple TV de tu casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un PIN cada vez que se quiera transmitir por AirPlay, debes eliminar este Apple TV de tu casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tämä Apple TV kodistasi, jos haluat vaatia PIN-koodia aina AirPlayta käytettäessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour pouvoir exiger un code PIN à chaque fois que vous souhaitez diffuser du contenu sur cette Apple TV via AirPlay, vous devez supprimer celle-ci de votre domicile."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour exiger un NIP à chaque fois que vous souhaitez utiliser AirPlay sur cette Apple TV, supprimez celle-ci de votre domicile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לדרוש קוד PIN עבור כל העברה באמצעות AirPlay, יש צורך להסיר את Apple TV זה מהבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप चाहते हैं कि AirPlay करने के लिए हर बार PIN आवश्यक हो, तो इसके लिए आपको इस Apple TV को अपने घर ऐप से हटाना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za zatraživanje PIN-a prilikom svakog prijenosa sadržaja putem značajke AirPlay trebate ukloniti ovaj Apple TV iz Doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha minden alkalommal PIN-kódot szeretne kérni az AirPlay használatakor, akkor távolítsa el ezt az Apple TV-t az Otthonból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memerlukan PIN setiap saat Anda ingin menggunakan AirPlay, Anda perlu menghapus Apple TV ini dari rumah Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fare in modo che ti venga richiesto un codice PIN ogni volta che vuoi utilizzare AirPlay, rimuovi questa Apple TV dalla tua abitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVにAirPlayするときに毎回PINを入力させるには、このApple TVをホームから削除する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV로 AirPlay할 때마다 PIN이 요구되도록 하려면 홈 앱에서 이 Apple TV를 제거해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memerlukan PIN setiap kali anda mahu AirPlay, anda perlu mengeluarkan Apple TV ini daripada rumah anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må fjerne Apple TV-enheten fra hjemmet for å kreve en PIN-kode hver gang du bruker AirPlay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je elke keer dat je AirPlay wilt gebruiken om een pincode wilt worden gevraagd, moet je deze Apple TV uit je woning verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby strumieniowanie przez AirPlay na ten Apple TV każdorazowo wymagało podania kodu PIN, musisz usunąć ten Apple TV z domu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para exigir um PIN sempre que você quiser usar o AirPlay, esta Apple TV deve ser removida da sua casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se optar por ter de digitar um PIN sempre que quiser usar AirPlay, tem de remover esta Apple TV da casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a solicita un PIN de fiecare dată când doriți să utilizați AirPlay, trebuie să eliminați acest Apple TV din locuința dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы требовать введения PIN-кода каждый раз при трансляции через AirPlay, нужно удалить этот Apple TV из дома."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete vyžadovať PIN kód pri každom použití AirPlay, musíte odstrániť Apple TV z domácnosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite zahtevati kodo PIN vsakič, ko želite predvajati vsebino prek funkcije AirPlay, morate odstraniti ta Apple TV iz svojega doma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill att en PIN-kod ska krävas varje gång du vill använda AirPlay måste du ta bort denna Apple TV från ditt hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการถาม PIN ทุกครั้งที่คุณต้องการใช้ AirPlay คุณต้องเอา Apple TV เครื่องนี้ออกจากบ้านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay ile bağlanmak istediğiniz her zaman PIN gerekmesi için bu Apple TV’yi evinizden silmelisiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб PIN-код вимагався щоразу, коли ви хочете транслювати через AirPlay, ви маєте вилучити цей Apple TV зі свого дому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để yêu cầu mã PIN mỗi lần bạn muốn phát AirPlay, bạn cần xóa Apple TV này khỏi nhà của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要每次隔空播放时都需要PIN码，你需要从家中移除这台Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要在每次AirPlay時要求輸入PIN，你需要從你的家居移除此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若想要在每次AirPlay時都限制輸入PIN，你需要將此Apple TV從你的家庭中移除。"
          }
        }
      }
    },
