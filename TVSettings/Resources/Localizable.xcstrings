    "iCloudSignInDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud لاستخدام المشاركة العائلية والصور وتخزين معلومات التطبيقات، والمزيد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sessió a l’iCloud per utilitzar el grup familiar i l’app Fotos, per desar la informació de les apps, i molt més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se k iCloudu a používejte funkce, jako je Rodinné sdílení a Fotky, ukládejte na iCloud data aplikací a mnoho dalšího."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på iCloud for at bruge Familiedeling og Fotos, lagre dine appoplysninger m.m."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an, um Familienfreigabe und Fotos zu verwenden, App-Infos zu speichern und vieles mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο iCloud για χρήση της Οικογενειακής κοινής χρήσης και των Φωτογραφιών, για αποθήκευση πληροφοριών εφαρμογών, και πολλά άλλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing and Photos, store your app information, and more."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing and Photos, store your app information and more."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing and Photos, store your app information, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para usar “En familia” y Fotos, guardar la información de tus apps y muchas otras cosas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para usar Compartir en familia y Fotos, almacenar tu información de apps, y más."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para usar Compartir en familia y Fotos, almacenar tu información de apps, y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu iCloudiin, jotta voit esimerkiksi käyttää Perhejakoa ja Kuvia sekä tallentaa appien tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud pour utiliser le partage familial et Photos, stocker les données de vos apps, et bien plus."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud pour utiliser le partage familial et Photos, stocker les informations de vos apps, etc."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחבר ל-iCloud כדי להשתמש ב״שיתוף משפחתי״ וב״תמונות״, כדי לאחסן מידע לגבי יישומים ועוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ैमिली शेयरिंग और तस्वीर का उपयोग करने व अपनी ऐप जानकारी संग्रहित करने इत्यादि के लिए iCloud में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na iCloud kako biste mogli koristiti Dijeljenje s obitelji i Foto, spremiti informacije o aplikacijama i još mnogo toga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be az iCloudba a Családi megosztás és a Fotók használatához, az appinformációk tárolásához és egyéb funkciók használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke iCloud untuk menggunakan fitur Keluarga Berbagi, Foto, dan iMovie Theater. Selain itu, Anda dapat menyimpan app dan informasi game Anda, dan masih banyak lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua l’accesso a iCloud per usare “In famiglia” e Foto, per conservare le informazioni relative alle tue app e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインすると、ファミリー共有や写真を使用したり、アプリの情報を保存したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인하면 가족 공유 및 사진을 사용하고, 앱 정보를 저장하며, 그 외에도 더 많은 기능을 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk ke iCloud untuk menggunakan Perkongsian Keluarga dan Foto, menyimpan maklumat app anda serta banyak lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på iCloud for å bruke Familiedeling og Bilder, lagre app- og spillinformasjon og annet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud om 'Delen met gezin' en 'Foto's' te gebruiken, je app- en gamegegevens te bewaren en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się w iCloud, aby używać Chmury rodzinnej i Zdjęć, zachowywać dane aplikacji itd."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma sessão no iCloud para usar o Compartilhamento Familiar e Fotos, armazenar informações de apps e mais."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão em iCloud para poder usar a Partilha com a família e a aplicação Fotografias, armazenar os dados das aplicações e muito mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificați-vă pe iCloud pentru a utiliza funcții precum Partajare familială și Poze, pentru a stoca informații referitoare la aplicații ș.a.m.d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в iCloud, чтобы использовать Семейный доступ и Фото, хранить информацию приложений и многое другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať Rodinné zdieľanie a Fotky, uchovávať dáta apiek a využívať ďalšie funkcie, prihláste sa do iCloudu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpišite se v storitev iCloud, če želite uporabljati Deljenje v družini in Fotografije, shranjevati podatke o aplikacijah in še več."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på iCloud så kan du använda familjedelning och bilder, spara information om appar med mera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้า iCloud เพื่อใช้การแชร์กันในครอบครัวและรูปภาพ จัดเก็บข้อมูลแอปและอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aile Paylaşımı’nı ve Fotoğraflar’ı kullanmak, uygulama bilgilerinizi saklamak vb. için iCloud’a giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть до iCloud, щоб користуватись Домашньою колекцією і Фотографіями, зберігати дані програм тощо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào iCloud để sử dụng Chia sẻ trong gia đình và Ảnh, lưu trữ thông tin ứng dụng của bạn, v.v."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "登录iCloud来使用“家人共享”和“照片”，储存你的App信息，及实现更多功能。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "登入iCloud以使用「家人共享」、相片及儲存你的App資料等等。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "登入iCloud來使用「家人共享」和「照片」、儲存你的App資訊，以及其他項目。"
          }
        }
      }
    },
