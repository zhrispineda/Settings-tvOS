    "iTMSSandboxAccountDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُستخدم هذا الحساب إلا لأغراض اختبار عمليات الشراء داخل التطبيق أثناء التطوير محليًا. سيُستخدم حساب App Store الحالي لتطبيقات TestFlight."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només s’utilitzarà el compte per provar les compres integrades en desenvolupar contingut en local. Per a les apps TestFlight s’utilitzarà el compte actual de l’App Store."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet bude používán jen pro testování nákupů v aplikacích při lokálním vývoji. V aplikacích TestFlight bude použit váš stávající účet v App Storu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto bruges kun til testning af dine køb i apps, mens du udvikler software lokalt. Din eksisterende App Store-konto bruges til TestFlight-apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account wird nur zum Testen deiner In-App-Käufe während der Entwicklung vor Ort verwendet. Dein bestehender App Store-Account wird für TestFlight-Apps verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός θα χρησιμοποιείται μόνο για δοκιμή των αγορών εντός εφαρμογών σας κατά την τοπική ανάπτυξη. Ο υπάρχων λογαριασμός σας στο App Store θα χρησιμοποιείται για εφαρμογές TestFlight."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account will be only used for testing your in-app purchases while developing locally. Your existing App Store account will be used for TestFlight apps."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This account will only be used for testing your in-app purchases while developing locally. Your existing App Store account will be used for TestFlight apps."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account will only be used for testing your in-app purchases while developing locally. Your existing App Store account will be used for TestFlight apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta solo se usará para probar las compras dentro de la app al desarrollar localmente. Tu cuenta de App Store se utilizará para las apps TestFlight."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se usará sólo para probar tus compras dentro de apps mientras desarrollas de forma local. Tu cuenta de App Store existente se usará para las apps de TestFlight."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se usará sólo para probar tus compras dentro de apps mientras desarrollas de forma local. Tu cuenta de App Store existente se usará para las apps de TestFlight."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tiliä käytetään vain apeissa tehtävien ostojen testaamiseen, kun kehität paikallisesti. Nykyistä App Store ‑tiliäsi käytetään TestFlight-apeille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne sera utilisé que pour tester les achats intégrés pendant le développement en local. Votre compte App Store existant sera utilisé pour les apps TestFlight."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte servira uniquement à tester vos achats intégrés lors des tâches locales de développement. Votre compte App Store sera utilisé par les apps TestFlight."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון זה ישמש רק כדי לבדוק רכישות בתוך היישום בזמן פיתוח מקומי. חשבון ה-App Store הקיים שלך ישמש עבור יישומי TestFlight."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से डेवलप करने के दौरान इस खाते का इस्तेमाल केवल आपकी इन-ऐप ख़रीदारी की जाँच के लिए किया जाएगा। आपके मौजूदा App Store खाते का इस्तेमाल TestFlight ऐप्स के लिए किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj će se račun upotrebljavati samo za testiranje vaših in-app kupnji dok se razvijaju lokalno. Vaš postojeći App Store račun koristit će se za TestFlight aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók csak az appbeli vásárlásainak helyi fejlesztés közben való teszteléséhez lesz használva. A meglévő App Store-fiókja a TestFlight-appokhoz lesz használva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini hanya akan digunakan untuk menguji pembelian di app Anda saat dikembangkan secara lokal. Akun App Store Anda yang ada akan digunakan untuk app TestFlight."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account verrà usato soltanto per testare i tuoi acquisti in‑app, in fase di sviluppo locale. Il tuo account esistente di App Store verrà utilizzato per le app TestFlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはローカルで開発中にアプリ内課金をテストするときにだけ使用されます。お使いの既存のApp StoreアカウントがTestFlightアプリで使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 로컬 개발을 진행하는 동안 앱 내 구입을 테스트하는 목적으로만 사용됩니다. TestFlight 앱에는 사용자의 기존 App Store 계정이 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini hanya akan digunakan untuk menguji pembelian in-app anda semasa pembangunan setempat. Akaun App Store sedia ada anda akan digunakan untuk app TestFlight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen vil kun bli brukt i lokal utvikling for å teste kjøp i apper. Den eksisterende App Store-kontoen din vil bli brukt med TestFlight-apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze account wordt alleen gebruikt voor het testen van je in-app aankopen tijdens lokale ontwikkeling. Je bestaande App Store-account wordt gebruikt voor TestFlight-apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto będzie używane tylko do lokalnego testowania zakupów w tworzonych aplikacjach. W przypadku aplikacji TestFlight używane będzie istniejące konto App Store."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta será usada apenas para testar as suas compras dentro de apps durante o desenvolvimento. A sua conta da App Store será usada para os apps do TestFlight."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta será utilizada apenas para testes de compras integradas durante a fase de desenvolvimento a nível local. A sua conta da App Store existente será usada para aplicações do TestFlight."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont va fi utilizat doar pentru testarea cumpărăturilor dvs. din aplicații în timpul dezvoltării locale. Contul dvs. App Store existent va fi utilizat pentru aplicațiile TestFlight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учетная запись будет использоваться только для тестирования встроенных покупок в приложениях при локальной разработке. Ваша существующая учетная запись App Store будет использоваться для приложений TestFlight."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet bude slúžiť len na testovanie nákupov v apke počas lokálneho vývoja. TestFlight apky budú používať váš existujúci App Store účet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta račun se bo uporabljal le za preizkušanje nakupov znotraj aplikacije tekom lokalnega razvoja. Obstoječi račun za trgovino App Store bo uporabljen za aplikacije TestFlight."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot kommer endast att användas för test av dina köp inuti appar medan du utvecklar lokalt. Ditt befintliga App Store-konto används för TestFlight-appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้จะถูกใช้สำหรับการทดสอบการซื้อภายในแอปของคุณระหว่างการพัฒนาเฉพาะภายในเท่านั้น บัญชี App Store ที่มีอยู่ของคุณจะถูกใช้สำหรับแอป TestFlight"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap yalnızca yerel geliştirme sırasında uygulama içi satın alımlarınızı test etmek için kullanılır. Var olan App Store hesabınız TestFlight uygulamaları için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис застосовуватиметься тільки для тестування ваших покупок у програмі під час локальної розробки. Ваш наявний обліковий запис App Store застосовуватиметься для програм у TestFlight."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này sẽ chỉ được sử dụng để kiểm tra các mục mua in-app trong khi phát triển cục bộ. Tài khoản App Store hiện có của bạn sẽ được sử dụng cho các ứng dụng TestFlight."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户将仅用于本地开发时，测试App内购买项目。你当前的App Store账户将用于TestFlight App。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳户只會用於在本機開發時測試你的App內購物。你現有的App Store帳户會用於TestFlight App。"
          }
        },
