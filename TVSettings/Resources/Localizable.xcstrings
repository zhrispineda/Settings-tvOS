    "AccountsUserGameCenterDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا الحساب للوصول إلى Game Center، بما في ذلك لوحة الأوائل والإنجازات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza el compte d’Apple per accedir al Game Center i veure les classificacions i els assoliments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet můžete používat pro přístup ke Game Centru včetně žebříčků a úspěchů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug denne konto til Game Center, herunder resultattavler og bedrifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende diesen Account für Game Center (z. B. Bestenlisten und Erfolge)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε αυτόν τον λογαριασμό για το Game Center, συμπεριλαμβανομένων πινάκων κορυφαίων παικτών και επιτευγμάτων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this account for Game Center, including leaderboards and achievements."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this account for Game Center, including leaderboards and achievements."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this account for Game Center, including leaderboards and achievements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esta cuenta para acceder a Game Center y ver los marcadores y logros."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esta cuenta para acceder a Game Center y ver logros y clasificaciones."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esta cuenta para acceder a Game Center y ver logros y clasificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Game Centeriä, mukaan lukien tulostaulukoita ja saavutuksia, tällä tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ce compte pour accéder à Game Center, notamment aux classements et aux réalisations."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ce compte pour Game Center, y compris pour les classements et les réalisations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להשתמש בחשבון זה ב-Game Center, כולל לוחות שחקנים והישגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीडरबोर्ड और उपलब्धियों सहित Game Center के लिए इस खाते का उपयोग करें।"
