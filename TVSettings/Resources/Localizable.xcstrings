    "AXSubtitlesOnSkipBackDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تشغيل الترجمة مؤقتًا عند التخطي للخلف، لحد ٣٠ ثانية.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Activa els subtítols temporalment en fer retrocedir la reproducció fins a 30 segons.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Dočasně zapne titulky, když se vrátíte nejvýše o 30 sekund zpátky.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Slå midlertidigt undertekster til, når du spoler tilbage – op til 30 sekunder.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Untertitel werden vorübergehend aktiviert, wenn du bis zu 30 Sekunden zurückspringst.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Προσωρινή ενεργοποίηση υπότιτλων κατά τη μετάβαση πίσω έως και 30 δευτερόλεπτα.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Se activan temporalmente los subtítulos al retroceder en el contenido hasta 30 segundos.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Activa temporalmente los subtítulos cuando retrocedes hasta por 30 segundos.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Activa temporalmente los subtítulos cuando retrocedes hasta por 30 segundos.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Laita tekstitys päälle tilapäisesti, kun siirryt taaksepäin enintään 30 sekuntia.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Activez temporairement les sous-titres lorsque vous revenez en arrière, jusqu’à 30 secondes.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Active temporairement les sous-titres lorsque vous effectuez un saut vers l’arrière, pendant 30 secondes au maximum.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להפעיל כתוביות באופן זמני בעת דילוג אחורה, עד פרק זמן של 30 שניות.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "30 सेकंड तक पीछे स्किप करने पर सबटाइटल अस्थायी रूप से चालू करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Privremeno uključenje titlova kad preskočite do 30 sekundi unatrag.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Ideiglenesen bekapcsolja a feliratokat, amikor legfeljebb 30 másodpercet visszaléptet.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Nyalakan subtitle saat Anda melewati mundur untuk sementara, hingga 30 detik.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Attiva temporaneamente i sottotitoli quando vai indietro, fino a 30 secondi.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "前にスキップするときに字幕が一時的にオンになります（最大30秒）。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "최대 30초 뒤로 건너뛰면 일시적으로 자막을 켭니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Aktifkan sari kata buat sementara apabila anda melangkau ke belakang, sehingga 30 saat.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Schakel ondertiteling tijdelijk in wanneer je terugspringt, maximaal 30 seconden.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Slå midlertidig på undertekster når du hopper tilbake i videoer, opptil 30 sekunder.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Tymczasowo włączaj napisy po przejściu w tył (o maksymalnie 30 sekund).",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Ative temporariamente as legendas ao retroceder até 30 segundos.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Ativar as legendas temporariamente ao retroceder até 30 segundos.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Subtitrările vor fi activate temporar atunci când săriți înapoi până la 30 de secunde.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Субтитры отображаются временно при перемотке назад до 30 секунд.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Dočasne zobrazí titulky, keď preskočíte dozadu najviac o 30 sekúnd.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Omogočite začasen prikaz podnapisov ob preskoku nazaj za največ 30 sekund.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Slå på undertexter tillfälligt (upp till 30 sekunder) när du hoppar bakåt.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เปิดใช้คำบรรยายชั่วคราวเมื่อคุณข้ามไปข้างหลัง ซึ่งข้ามได้สูงสุด 30 วินาที",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "En fazla 30 saniye geri atladığınızda altyazıları geçici olarak açar.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Тимчасово вмикати субтитри, якщо виконано перехід назад на 30 секунд.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Tạm thời bật phụ đề khi bạn lùi về sau, tối đa 30 giây.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "快退时，暂时打开字幕最长30秒钟。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "回帶時暫時開啟字幕（最多30秒）。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "倒轉時暫時開啟字幕，最多顯示30秒。",
            "state": "translated"
          }
        }
      }
    },
    "AXDifferentiateWithoutColorDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يستبدل عناصر شاشة المستخدم التي تعتمد حصرًا على اللون لنقل المعلومات مع بدائل.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Substitueix els ítems de la interfície d’usuari que depenen únicament del color i en transmet la informació d’altres maneres.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Nahrazuje prvky uživatelského rozhraní, které předávají uživateli informace čistě pomocí barvy, jinými alternativami.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Erstatter emner i brugergrænsefladen, der udelukkende bruger farve til at angive oplysninger, med alternativer.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Ersetzt Elemente der Benutzeroberfläche, deren Bedeutung nur durch Farbe kenntlich gemacht wird, durch Alternativen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αντικατάσταση στοιχείων διεπαφής χρήστη που βασίζονται αποκλειστικά σε χρώματα για επικοινωνία πληροφοριών με εναλλακτικούς τρόπους.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Replaces user interface items that rely solely on color to convey information with alternatives.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Replaces user interface items that rely solely on colour to convey information with alternatives.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Replaces user interface items that rely solely on colour to convey information with alternatives.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Replaces user interface items that rely solely on colour to convey information with alternatives.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Replaces user interface items that rely solely on color to convey information with alternatives.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Reemplaza ítems de la interfaz de usuario que solo utilizan colores para transmitir información por otras alternativas.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Reemplaza elementos de la interfaz de usuario que dependen de colores para brindar información mediante alternativas.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Reemplaza elementos de la interfaz de usuario que dependen de colores para brindar información mediante alternativas.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Korvaa käyttöliittymän kohteet, jotka välittävät tiedon pelkästään värillä, vaihtoehtoisilla kohteilla.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Remplace les éléments de l’interface utilisateur qui fournissent des informations uniquement à l’aide de couleurs par d’autres éléments.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Remplace les éléments de l’interface d’utilisation qui reposent uniquement sur les couleurs pour fournir des informations par d’autres types d’éléments.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו מחליפה את פריטי הממשק של המשתמש שמסתמכים אך ורק על צבעים כדי לספק מידע בדרך חלופית.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "विकल्पों के साथ जानकारी देते हुए रंग पर पूरी तरह से निर्भर रहने वाले यूज़र इंटरफ़ेस आइटम को बदलता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Alternativama zamjenjuje stavke korisničkog sučelja koje se oslanjaju samo na boju za pružanje informacija.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Lecseréli a felhasználóifelület-elemeket, amelyek kizárólag a színeken alapulnak, hogy az információk egyéb módon legyenek átadva.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Mengganti item antarmuka pengguna yang hanya mengandalkan warna untuk menyampaikan informasi dengan alternatif.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Sostituisce gli elementi dell’interfaccia utente che si basano solamente sul colore per fornire informazioni con alternative.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "カラーのみに依存するインターフェイス項目を置き換えて、ほかの方法で情報を伝えます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "색상에만 의존하여 정보를 전달하는 인터페이스 항목을 대체 항목으로 대치합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Menggantikan item antara muka yang bergantung sepenuhnya pada warna untuk menyampaikan maklumat dengan alternatif.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Gebruikt alternatieven voor onderdelen van de gebruikersinterface die uitsluitend kleur gebruiken voor het overbrengen van informatie.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Erstatter objekter i grensesnittet som kun bruker farge til å formidle informasjon, med andre alternativer.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Wyświetla zamienniki elementów interfejsu użytkownika, które do przekazywania informacji używają wyłącznie koloru.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Substitui os itens da interface do usuário que dependem exclusivamente de cores para transmitir informações com alternativas.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Substitui por elementos alternativos os elementos da interface do utilizador que dependem apenas de cor para veicular informação.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Înlocuiți elementele interfeței cu utilizatorul care se bazează exclusiv pe culori pentru a transmite informații cu alternative.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Замена объектов пользовательского интерфейса, которые для передачи информации с альтернативами исключительно полагаются на цвет.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Nahradí prvky rozhrania, ktoré odovzdávajú informácie výhradne pomocou farby, inými alternatívami.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Nadomestite elemente uporabniškega vmesnika, ki za posredovanje informacij uporabljajo samo barve, z alternativami.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Ersätter objekt i användargränssnittet som enbart använder färg till att förmedla information med alternativ.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แทนที่ชิ้นส่วนที่ใช้เฉพาะสีเท่านั้นในส่วนติดต่อ (อินเทอร์เฟส) กับผู้ใช้เพื่อแยกความแตกต่างโดยไม่ใช้สี",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Alternatif bilgi iletmek için yalnızca renge dayanan kullanıcı arayüzü öğelerini değiştirir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Замінює елементи користувацького інтерфейсу, що покладаються виключно на колір для передання варіантної інформації.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Thay thế các mục giao diện người dùng chỉ dựa trên màu để truyền tải thông tin bằng các mục thay thế.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "将仅靠颜色区分的用户界面项目替换为用其他方式传达信息。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "將只靠顏色區分的用户介面項目改為以其他方式表達資訊。\n",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "以替用項目取代只仰賴顏色來表達資訊的使用者介面項目。",
            "state": "translated"
          }
        }
      }
    },
