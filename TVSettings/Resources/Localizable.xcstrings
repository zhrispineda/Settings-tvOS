    "BluetoothDeviceRequiresFirmwareUpdateDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تحديث البرنامج الثابت على \"%@\" لحل المشاكل المتعلقة بالاتصال والأداء. لمزيد من المعلومات، يرجى زيارة:\nhttps://support.apple.com/tv/bluetooth"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositiu “%@” necessita una actualització de firmware per resoldre els problemes de connectivitat i de rendiment. Per obtenir més informació, ves a https://support.apple.com/tv/bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení „%@“ potřebuje aktualizaci firmwaru, která vyřeší problémy s připojením a výkonností. Další informace najdete na https://support.apple.com/tv/bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” har brug for en firmwareopdatering for at løse problemer med forbindelser og ydeevne. Du kan finde flere oplysninger på https://support.apple.com/tv/bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ benötigt ein Firmwareupdate, um Verbindungs- und Leistungsprobleme zu beheben. Weitere Informationen erhältst du unter https://support.apple.com/tv/bluetooth."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή «%@» χρειάζεται ενημέρωση υλικολογισμικού για επίλυση ζητημάτων συνδεσιμότητας και απόδοσης. Για περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση https://support.apple.com/tv/bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” needs a firmware update to resolve connectivity and performance issues. Visit https://support.apple.com/tv/bluetooth for more information."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” needs a firmware update to resolve connectivity and performance issues. For more information, go to support.apple.com/tv/bluetooth"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” needs a firmware update to resolve connectivity and performance issues. Visit https://support.apple.com/tv/bluetooth for more information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario actualizar el firmware del dispositivo “%@” para resolver problemas de conectividad y rendimiento. Visita https://support.apple.com/tv/bluetooth para obtener más información."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” necesita una actualización de firmware para resolver los problemas de conectividad y rendimiento. Para obtener más información, visita: https://support.apple.com/tv/bluetooth."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” necesita una actualización de firmware para resolver los problemas de conectividad y rendimiento. Para obtener más información, visita: https://support.apple.com/tv/bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarvitsee laiteohjelmisto­päivityksen yhteys- ja suorituskyky­ongelmien ratkaisemista varten. Lisätietoja on osoitteessa https://support.apple.com/tv/bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme interne de « %@ » doit être mis à jour afin de résoudre des problèmes de connectivité et de performances. Consultez la page https://support.apple.com/tv/bluetooth pour en savoir plus."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme interne de « %@ » doit être mis à jour pour résoudre des problèmes de connectivité et de performance. Rendez-vous sur https://support.apple.com/tv/bluetooth pour en savoir plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לפתור בעיות חיבור וביצועים, יש לעדכן את הקושחה של ״%@״. מידע נוסף זמין בכתובת: https://support.apple.com/tv/bluetooth."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्टिविटी और कार्यक्षमता संबंधी समस्याएँ दूर करने के लिए “%@” पर फ़र्मवेयर अपडेट करना आवश्यक है। अधिक जानकारी के लिए https://support.apple.com/tv/bluetooth पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebno je ažurirati firmver uređaja “%@” kako bi se riješili problemi s povezivanjem i performansama. Posjetite https://support.apple.com/tv/bluetooth za više informacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatlakozással és teljesítménnyel kapcsolatos problémák megoldása érdekében a(z) „%@” firmware-jét frissíteni kell. További tudnivalókért látogasson el a https://support.apple.com/tv/bluetooth weboldalra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” memerlukan pembaruan firmware untuk menyelesaikan masalah konektivitas dan kinerja. Kunjungi https://support.apple.com/tv/bluetooth untuk informasi lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario aggiornare il firmware di %@ per risolvere problemi di connettività e prestazioni. Per ulteriori informazioni, visita la pagina https://support.apple.com/tv/bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続およびパフォーマンスの問題を解決するために、“%@”のファームウェアをアップデートする必要があります。詳しくは、https://support.apple.com/tv/bluetooth を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’의 연결 및 성능 문제를 해결하려면 펌웨어 업데이트가 필요합니다. 자세한 정보는 https://support.apple.com/tv/bluetooth 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” memerlukan kemas kini perisian tegar untuk menyelesaikan isu ketersambungan dan prestasi. Lawati https://support.apple.com/en-my/HT211232?cid=mc-ols-appletv-article_ht208237-tvos_ui-08032020 untuk mendapatkan maklumat lanjut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» trenger en firmwareoppdatering for å løse tilkoblings- og ytelsesproblemer. Finn ut mer på https://support.apple.com/tv/bluetooth."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' heeft een firmware-update nodig om verbindings- en prestatieproblemen op te lossen. Ga naar https://support.apple.com/tv/bluetooth voor meer informatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” wymaga uaktualnienia oprogramowania sprzętowego, które rozwiąże problemy z łącznością i wydajnością. Więcej informacji znajdziesz na stronie https://support.apple.com/tv/bluetooth."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo “%@” precisa de uma atualização de firmware para resolver problemas de conectividade e desempenho. Para saber mais, visite https://support.apple.com/tv/bluetooth."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” necessita de uma atualização de firmware para resolver problemas de conectividade e desempenho. Encontrará informação adicional em https://support.apple.com/tv/bluetooth."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” necesită o actualizare de firmware pentru rezolvarea problemelor de conectivitate și performanță. Vizitați https://support.apple.com/tv/bluetooth pentru informații suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимо обновить прошивку устройства «%@» для устранения проблем с подключением и производительностью. Подробнее: https://support.apple.com/tv/bluetooth."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Problémy s pripojením a výkonom zariadenia %@ je potrebné vyriešiť aktualizáciou firmvéru. Viac informácií nájdete na stránke https://support.apple.com/tv/bluetooth."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite odpraviti težave s povezljivostjo in učinkovitostjo delovanja, morate posodobiti vdelano programsko opremo v napravi »%@«. Obiščite https://support.apple.com/tv/bluetooth za več informacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fasta programvaran för ”%@” bör uppdateras för att lösa problem med anslutning och prestanda. Besök https://support.apple.com/tv/bluetooth för mer information."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ต้องอัปเดตเฟิร์มแวร์เพื่อแก้ไขปัญหาเกี่ยวกับการเชื่อมต่อและประสิทธิภาพการทำงาน ให้ไปที่ https://support.apple.com/tv/bluetooth สำหรับข้อมูลเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”, bağlantı ve performans sorunlarını çözmek için bir firmware güncellemesi gerektiriyor. Daha fazla bilgi için https://support.apple.com/tv/bluetooth adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб усунути проблеми зі зʼєднанням і продуктивністю, потрібно оновити прошивку %@. Додаткову інформацію наведено на вебсторінці https://support.apple.com/tv/bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” cần một bản cập nhật vi chương trình để giải quyết các sự cố về kết nối và hiệu năng. Hãy truy cập https://support.apple.com/tv/bluetooth để biết thêm thông tin."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”需要更新固件以解决连接和性能问题。若要了解更多信息，请访问https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要韌體更新才能解決連線和效能問題。詳情請到訪：https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要韌體更新以解決連線和效能問題。請參訪https://support.apple.com/tv/bluetooth以取得更多資訊。"
          }
        }
      }
    },
    "BluetoothDisconnectDeviceMessage": {
