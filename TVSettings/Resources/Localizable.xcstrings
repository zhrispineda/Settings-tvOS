        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте кнопку «%@» до заполнения индикатора выполнения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naďalej držte tlačidlo %@, až kým sa indikátor priebehu nevyplní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumb %@ držite pritisnjen, dokler se vrstica napredka ne zapolni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt hålla %@-knappen nedtryckt tills förloppsfältet är fullt."
