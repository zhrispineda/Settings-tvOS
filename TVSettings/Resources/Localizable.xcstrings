        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono disponibili nuovi fusi orari aggiornati, verranno installati al prossimo riavvio di Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい時間帯を使用できます。次にApple TVを再起動するときにインストールされます。"
