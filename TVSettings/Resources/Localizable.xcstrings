    "SettingsVPNCheckVPNText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أنه تم تكوين VPN بصورة صحيحة. يجب أن يكون لديك بيانات اعتماد AppleConnect صالحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN estigui configurada correctament. Requereix unes credencials de l’AppleConnect vàlides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte, zda je VPN síť nastavená správně. Vyžaduje platné přihlašovací údaje pro AppleConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft, at VPN er konfigureret korrekt. Kræver gyldige AppleConnect-godkendelsesoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθεύστε ότι το VPN διαμορφώθηκε σωστά. Απαιτούνται έγκυρα διαπιστευτήρια AppleConnect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la conexión VPN está configurada correctamente. Requiere credenciales de AppleConnect válidas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN esté configurada de manera correcta, lo cual requiere que credenciales válidas de AppleConnect."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que la VPN esté configurada de manera correcta, lo cual requiere que credenciales válidas de AppleConnect."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le VPN est correctement configuré. Nécessite des identifiants AppleConnect valides."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le VPN est configuré correctement. Des informations d’identification AppleConnect valides sont requises."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נא לוודא שתצורת ה-VPN הוגדרה כשורה. יש צורך בפרטי זיהוי תקינים של AppleConnect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित करें कि VPN ठीक से कॉन्फ़िगर किया हुआ है। इसके लिए मान्य AppleConnect क्रेडेंशियल चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite je li VPN ispravno podešen. Zahtijeva važeće AppleConnect vjerodajnice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze, hogy a VPN helyesen van-e konfigurálva. Érvényes AppleConnect bejelentkezési adatok szükségesek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi bahwa VPN dikonfigurasi dengan benar. Memerlukan info pengesahan AppleConnect yang sah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il profilo VPN sia configurato correttamente (richiede credenziali AppleConnect valide)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNプロファイルが正しく構成されているか検証してください。有効なAppleConnectの資格情報が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN이 올바르게 구성되어 있는지 확인하십시오. 유효한 AppleConnect 자격 증명이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan bahawa VPN dikonfigurasikan dengan betul. Memerlukan kelayakan AppleConnect yang sah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiser at VPN er konfigurert riktig. Krever gyldige AppleConnect-akkreditiver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer of VPN goed is geconfigureerd. Hiervoor zijn geldige toegangsgegevens voor AppleConnect vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that VPN is configured correctly. Requires valid AppleConnect credentials."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se a VPN está configurada corretamente. Requer credenciais válidas do AppleConnect."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que a VPN está corretamente configurada. São necessárias credenciais AppleConnect válidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați dacă VPN‑ul este corect configurat. Necesită acreditări AppleConnect valide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте правильность конфигурации профиля VPN. Требуются действительные параметры входа AppleConnect."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte správnosť nastavení VPN. Potrebujete platné prihlasovacie údaje do služby AppleConnect."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite, ali je VPN pravilno konfiguriran. Potrebne so veljavne poverilnice AppleConnect."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att VPN har konfigurerats korrekt. Giltiga AppleConnect-handlingar krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบยืนยันว่า VPN ถูกกำหนดค่าที่ถูกต้อง ต้องใช้ข้อมูลประจำตัว AppleConnect ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN’in doğru şekilde konfigüre edildiğinden emin olun. Geçerli bir AppleConnect kimlik bilgisi gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте, чи правильно сконфігуровано профіль VPN. Потрібні дійсні облікові дані AppleConnect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh rằng VPN được định cấu hình đúng cách. Yêu cầu thông tin đăng nhập AppleConnect hợp lệ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "验证VPN已正确配置。需要有效的AppleConnect凭证。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證VPN已正確設定。需要有效的AppleConnect憑証。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證該VPN已正確設定。需要有效的AppleConnect憑證。"
          }
        }
      }
    },
