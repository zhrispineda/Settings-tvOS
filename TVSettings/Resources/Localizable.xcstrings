        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje všechny vzpomínky. Chcete‑li zobrazit jen výběr, označte některé vzpomínky v aplikaci Fotky jako oblíbené. Vzpomínky se aktualizují jednou za den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis alle minder, eller marker nogle som favoritter i appen Fotos, hvis du vil vælge dem, der skal vises. Minder opdateres en gang om dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende alle Rückblicke ein oder wähle aus, welche angezeigt werden sollen, indem du sie in der Fotos-App als Favoriten markierst. Rückblicke werden einmal pro Tag aktualisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση όλων των αναμνήσεων. Για εμφάνιση επιλεγμένων αναμνήσεων, σημαίνετε μερικές ως Αγαπημένες στην εφαρμογή «Φωτογραφίες». Οι αναμνήσεις ενημερώνονται μία φορά την ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories, or to choose which ones appear, mark some as Favorites in the Photos app. Memories are updated once a day."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories, or to choose which ones appear, mark some as Favourites in the Photos app. Memories are updated once a day."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all Memories, or to choose which ones appear, mark some as Favourites in the Photos app. Memories are updated once a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o, si quieres que aparezcan solo algunos, márcalos como favoritos en la app Fotos. Los recuerdos se actualizan una vez al día."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o elige cuáles quieres ver; puedes marcar algunos como favoritos en Fotos. Los recuerdos se actualizan una vez al día."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los recuerdos o elige cuáles quieres ver; puedes marcar algunos como favoritos en Fotos. Los recuerdos se actualizan una vez al día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä kaikki muistot tai valitse ne, jotka näkyvät, merkitsemällä niitä suosikeiksi Kuvat-apissa. Muistot päivitetään kerran päivässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez tous les souvenirs ou choisissez les souvenirs à afficher en les ajoutant aux préférés dans l’app Photos. Les souvenirs sont mis à jour quotidiennement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez tous les souvenirs ou ajoutez-en aux favoris dans l’app Photos pour choisir ceux que vous voulez afficher. Les souvenirs sont mis à jour une fois par jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג את כל הזיכרונות או לבחור אילו מהם יופיעו על ידי הוספתם ל״מועדפים״ ביישום ״תמונות״. הזיכרונות מתעדכנים פעם ביום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी यादें दिखाएँ या जो यादें दिखाना चाहते हैं उन्हें चुनने के लिए कुछ को तस्वीर ऐप में पसंदीदा के रूप में चिह्नित करें। यादें दिन में एक बार अपडेट की जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikažite sve uspomene ili za odabir onih koje će se prikazivati označite neke kao omiljene u aplikaciji Foto. Uspomene se ažuriraju jedanput dnevno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenítheti az összes emléket, vagy kiválaszthatja, hogy melyek jelenjenek meg, ha kedvencként jelöli meg őket a Fotók appban. Az emlékek naponta egyszer frissülnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan semua Memori, atau untuk memilih mana yang muncul, tandai beberapa sebagai Favorit di app Foto. Memori diperbarui sehari sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutti i ricordi oppure scegli quali verranno visualizzati contrassegnandoli come preferiti nell’app Foto. I ricordi vengono aggiornati una volta al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリで、すべてのメモリーを表示するか、または一部の項目をお気に入りに追加して表示する項目を選択します。メモリーは1日に1回アップデートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 추억을 보여주거나, 사진 앱에서 일부 사진을 즐겨찾기로 표시하여 해당 사진만 나타나도록 선택할 수 있습니다. 추억은 하루에 한 번 업데이트됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan semua Memori, atau untuk memilih yang kelihatan, tandakan sesetengah sebagai Kegemaran dalam app Foto. Memori dikemas kini sekali sehari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis alle minner, eller merk noen som favoritter i Bilder-appen for å velge hvilke som skal vises. Minner oppdateres én gang om dagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon alle terugblikken of markeer sommige terugblikken als favoriet in de Foto's-app als je wilt bepalen welke worden weergegeven. Terugblikken worden eenmaal per dag bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać wszystkie wspomnienia lub oznaczyć część z nich jako ulubione w aplikacji Zdjęcia, aby wyświetlać tylko je. Wspomnienia są uaktualniane raz dziennie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra todas as Memórias. Para escolher quais aparecem, marque algumas como Favoritas no app Fotos. As Memórias são atualizadas uma vez por dia."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra todas as recordações ou as que escolher para serem apresentadas assinalando algumas como favoritas na aplicação Fotografias. As recordações são atualizadas uma vez por dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați toate amintirile sau, pentru a alege care dintre acestea să apără, marcați unele amintiri drept favorite în aplicația Poze. Amintirile sunt actualizate o dată pe zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать все воспоминания или только определенные воспоминания (для этого отметьте их как избранные в приложении «Фото»). Воспоминания обновляются один раз в сутки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí všetky spomienky. Ak chcete, aby sa zobrazovali len niektoré spomienky, označte ich ako obľúbené v apke Fotky. Spomienky sa aktualizujú raz denne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberete lahko prikaz vseh spominov ali pa izberite, kateri naj bodo prikazani, in sicer tako, da določenim dodate oznako Priljubljeni v aplikaciji Photos. Spomini se posodobijo enkrat na dan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan visa alla minnen eller välja vilka som ska visas genom att favoritmarkera vissa bilder i appen Bilder. Minnen uppdateras en gång om dagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงความทรงจำทั้งหมด หรือเลือกความทรงจำที่จะแสดง \nหรือทำเครื่องหมายบางความทรงจำเป็นรายการโปรด\nในแอปรูปภาพ อัปเดตความทรงจำวันละหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm anıları gösterin veya hangilerinin görüneceğini seçmek için Fotoğraflar uygulamasında bazılarını favori olarak işaretleyin. Anılar günde bir kere güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна показувати всі спогади чи тільки окремі, позначивши їх як улюблені в програмі «Фотографії». Спогади оновлюються щодня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tất cả các kỷ niệm hoặc đánh dấu một số kỷ niệm là Mục ưa thích trong ứng dụng Ảnh để chọn những kỷ niệm sẽ xuất hiện. Kỷ niệm được cập nhật một lần mỗi ngày."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有“回忆”，或在“照片”App中将部分回忆标为“个人收藏”以选择要显示的回忆。“回忆”每日更新一次。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所有「回憶」，或者如需選擇要顯示的回憶，請在「相片」App中將部份回憶標示為「喜好項目」。「回憶」一日更新一次。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所有「回憶」，或是若要有所選擇，請在「照片」App中將部分「回憶」標示為「喜好項目」。「回憶」會一天更新一次。"
          }
        }
      }
    },
