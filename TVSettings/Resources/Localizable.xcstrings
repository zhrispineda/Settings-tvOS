    "AccountsTapToAddSuggestedUserInstructions_WLAN": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١.\tافتح قفل iPhone أو iPad الخاص بـ \"%@\".\n‏٢.\tاتصل بشبكة WLAN.\n‏٣.\tشغل Bluetooth.\n‏٤.\tقرّب الجهاز من هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueja l’iPhone o l’iPad que fa servir %@.\n2.\tConnecta’t a una xarxa WLAN.\n3.\tActiva el Bluetooth.\n4.\tMantén el dispositiu a prop de l’Apple TV."
          }
