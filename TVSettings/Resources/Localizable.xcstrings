    "SiriHSAccessoriesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استماع إلى \"%1$@\" عند اتصال\nسماعات رأس مدعومة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Siri dient “%1$@” quan hi hagi\nconnectats uns auriculars compatibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekat na vyslovení „%1$@“, když jsou\npřipojená podporovaná sluchátka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyt efter “%1$@”, når der er tilsluttet\nunderstøttede hovedtelefoner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%1$@“ achten, wenn kompatible\nKopfhörer verbunden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακρόαση για «%1$@» όταν είναι συνδεδεμένα\nυποστηριζόμενα ακουστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen for “%1$@” when supported\nheadphones are connected."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen for “%1$@” when supported\nheadphones are connected."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen for “%1$@” when supported\nheadphones are connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activará Siri al oír “%1$@” cuando haya\nunos auriculares compatibles conectados."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectar “%1$@” al conectar audífonos compatibles."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectar “%1$@” al conectar audífonos compatibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagoi “%1$@“ -kutsuun, kun tuetut kuulokkeet on yhdistetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détectez « %1$@ » lorsque des\nécouteurs pris en charge sont connectés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « %1$@ » lorsque des\nécouteurs pris en charge sont connectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוזניות נתמכות יכולות להיות בהאזנה\nל-״%1$@״ כאשר הן מחוברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित हेडफ़ोन कनेक्ट किए जाने पर\n“%1$@” के लिए सुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagiranje na “%1$@” kad su spojene\npodržane slušalice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” felismerése, amikor támogatott\nfejhallgatók vannak csatlakoztatva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan “%1$@” saat headphone\nyang didukung terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva “%1$@” quando le cuffie\nsupportate sono connesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応しているヘッドフォンが接続されているとき\n“%1$@”を聞き取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 헤드폰이 연결되어 있을 때\n‘“%1$@” 듣기’를 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengar untuk “%1$@” apabila\nfon kepala disokong disambungkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lytt etter «%1$@» når støttede\nhodetelefoner er koblet til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luister naar \"%1$@\" wanneer een\nondersteunde koptelefoon is verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasłuchuj „%1$@” po połączeniu\nz obsługiwanymi słuchawkami."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve “%1$@” quando fones de ouvido\ncompatíveis estão conectados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar ao ouvir “%1$@” quando estão\nligados auscultadores compatíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comanda „%1$@” va fi ascultată atunci când sunt conectate căști audio compatibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушать «%1$@», когда подключены\nподдерживаемые наушники."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pripojení podporovaných slúchadiel\nčakať na frázu „%1$@“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzovi se na »%1$@«, ko so povezane\npodprte slušalke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssna efter ”%1$@” när hörlurar\nsom stöds är anslutna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟัง “%1$@” เมื่อหูฟังที่รองรับ\nเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir kulaklık bağlıyken\n“%1$@”yi dinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекати на «%1$@», коли підʼєднано\nпідтримувані навушники."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắng nghe “%1$@” khi tai nghe\nđược hỗ trợ được kết nối."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连接受支持的耳机时\n听取“%1$@”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當支援的耳筒連接時聆聽「%1$@」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連接支援的耳機時聆聽「%1$@」。"
          }
        }
      }
    },
