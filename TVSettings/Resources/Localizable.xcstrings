    "SiriOSAItemDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام صوتك لتحديد العناصر على الشاشة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona els ítems de la pantalla amb la veu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky na obrazovce můžete vybírat hlasovými příkazy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug din stemme til at vælge emner på skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deine Stimme, um Objekte auf dem Bildschirm auszuwählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τη φωνή σας για να επιλέξετε στοιχεία στην οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your voice to select items on-screen."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your voice to select items on screen."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your voice to select items onscreen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona los ítems de la pantalla con la voz."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu voz para seleccionar elementos en pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu voz para seleccionar elementos en pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kohteita näytöltä käyttämällä ääntäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre voix pour sélectionner des éléments à l’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre voix pour sélectionner des éléments à l’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך להשתמש בקול שלך כדי לבחור פריטים במסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर मौजूद आइटम चुनने के लिए अपनी आवाज़ का इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasom odaberite stavke na zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a hangját a képernyőn megjelenő elemek kiválasztásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan suara Anda untuk memilih item pada layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la voce per selezionare gli elementi sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声を使用して画面上の項目を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성을 사용하여 화면상의 항목을 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan suara anda untuk memilih item atas skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg objekter på skjermen ved hjelp av stemmen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je stem om onderdelen op het scherm te selecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybieraj rzeczy na ekranie telewizora, używając poleceń głosowych."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a voz para selecionar itens na tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar elementos no ecrã usando a voz."
          }
        },
