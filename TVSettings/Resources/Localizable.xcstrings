            "value": "Biztos benne, hogy el szeretné távolítani a(z) %@ sandboxfiókot erről az Apple TV-ről?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus akun sandbox %@ dari Apple TV ini?"
