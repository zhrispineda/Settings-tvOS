    "BTErrorEarbudsGenericFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تشغيل \"%@\" ووجودها على مسافة قريبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que els auriculars “%@” estiguin activats i a l’abast."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že jsou zařízení „%@“ zapnutá a v dosahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at “%@” er tændt og inden for rækkevidde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergewissere dich, dass „%@“ eingeschaltet und in Reichweite sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι τα ακουστικά «%@» είναι ενεργοποιημένα και εντός εμβέλειας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure “%@” are turned on and in range."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure “%@” are turned on and in range."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure “%@” are turned on and in range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que los auriculares “%@” están encendidos y se encuentran dentro del alcance."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que “%@” estén encendidos y dentro del alcance."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que “%@” estén encendidos y dentro del alcance."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että %@ ovat päällä ja kantaman sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que les « %@ » sont allumés et à portée."
          }
        },
        "fr_CA": {
