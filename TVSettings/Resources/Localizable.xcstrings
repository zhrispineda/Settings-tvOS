            "state": "translated",
            "value": "اختر درجة الدقة ومعدل الإطارات والنطاق الديناميكي لتلفزيونك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona la resolució, la freqüència de fotogrames i el rang dinàmic del televisor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte rozlišení, snímkovou frekvenci a dynamický rozsah televizoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dit fjernsyns opløsning, billedfrekvens og dynamiske område."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Auflösung, Bildrate und den Dynamikbereich deines Fernsehgeräts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την ανάλυση, τον ρυθμό καρέ και το δυναμικό εύρος της τηλεόρασής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your TV’s resolution, frame rate, and dynamic range."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your TV’s resolution, frame rate and dynamic range."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your TV’s resolution, frame rate and dynamic range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona la resolución, la frecuencia de fotogramas y el rango dinámico del televisor."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la resolución, frecuencia de fotogramas y rango dinámico de tu TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la resolución, frecuencia de fotogramas y rango dinámico de tu TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse TV:n tarkkuus, kuvataajuus ja dynaaminen alue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la résolution, la fréquence d’images et la plage dynamique de votre téléviseur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la résolution, la fréquence d’image et la gamme dynamique de votre télévision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את הרזולוציה, קצב הפריימים והטווח הדינמי של הטלוויזיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने टीवी का रिज़ोल्यूशन, फ़्रेम दर और डाइनैमिक रेंज चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite razlučivost, brzinu sličica i dinamički raspon TV prijemnika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a televíziója felbontását, képkockasebességét és dinamikatartományát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih resolusi, laju bingkai, dan rentang dinamis TV Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la risoluzione, la frequenza dei fotogrammi e l’intervallo dinamico del tuo televisore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレビの解像度、フレームレート、およびダイナミックレンジを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV 해상도, 프레임률 및 다이내믹 레인지를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih resolusi, kadar bingkai dan julat dinamik TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg oppløsning, bildefrekvens og dynamisk område for TV-en din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de resolutie, de beeldsnelheid en het dynamische bereik van je tv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz rozdzielczość, częstotliwość klatek i zakres dynamiczny TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a resolução, taxa de atualização e intervalo dinâmico da sua TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a resolução, taxa de fotogramas e a gama dinâmica da sua televisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți rezoluția, frecvența de cadre și gama dinamică a televizorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите разрешение, частоту кадров и динамический диапазон для телевизора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte rozlíšenie, frekvenciu snímok a dynamický rozsah televízora."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izboljšajte ločljivost televizorja, hitrost sličic in dinamični razpon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj TV:ns upplösning, bildfrekvens och dynamiska omfång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกความละเอียด อัตราเฟรม และช่วงแสงกว้างของทีวีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV’nizin çözünürlüğünü, kare hızını ve dinamik aralığını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть роздільність, частоту кадрів і динамічний діапазон для свого телевізора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn độ phân giải, tốc độ khung hình và dải tần nhạy sáng của TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取电视的分辨率、帧速率和动态范围。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇電視的解像度、格率和動態範圍。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你的電視解析度、影格率和動態範圍。"
          }
        }
      }
    },
