    "RCLearnRemoteStartDialogDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تستخدم ريموتًا عموميًا يتحكم في عدة أجهزة، يرجى تحديد جهاز غير مستخدَم قبل البدء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilitzes un comandament universal per controlar diversos dispositius, selecciona’n un que no facis servir abans de començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud používáte univerzální ovladač, kterým ovládáte více zařízení, nejprve vyberte nepoužívané zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du bruger en universalfjernbetjening, der styrer flere enheder, skal du vælge en ubrugt enhed, før du starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine universelle Fernbedienung verwendest, die mehrere Geräte steuert, wähle vor dem Start ein Gerät, das nicht verwendet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν χρησιμοποιείτε ένα καθολικό τηλεχειριστήριο που ελέγχει πολλές συσκευές, επιλέξτε μια αχρησιμοποίητη συσκευή προτού ξεκινήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re using a universal remote that controls multiple devices, select an unused device before you start."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re using a universal remote that controls multiple devices, select an unused device before you start."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re using a universal remote that controls multiple devices, select an unused device before you start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas un mando a distancia universal que controla varios dispositivos, selecciona un dispositivo que no esté en uso antes de empezar."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas un control remoto universal que controla varios dispositivos, elige uno que no esté en uso antes de empezar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas un control remoto universal que controla varios dispositivos, elige uno que no esté en uso antes de empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytät yleiskaukosäädintä, jolla ohjataan useita laitteita, valitse ennen aloittamista käyttämätön laite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez une télécommande universelle permettant de contrôler plusieurs appareils, sélectionnez un appareil non utilisé avant de commencer."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez une télécommande universelle qui contrôle plusieurs appareils, sélectionnez un appareil non utilisé avant de commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם שלט אוניברסלי משמש אותך לשליטה במכשירים מרובים, יש לבחור מכשיר שאינו בשימוש לפני תחילת הפעולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप किसी ऐसे यूनिवर्सल रिमोट का उपयोग कर रहे हैं जो कई डिवाइस को नियंत्रित करता है, तो शुरू करने से पहले कोई अप्रयुक्त डिवाइस चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako koristite univerzalni upravljač koji služi za upravljanje više uređaja, odaberite nekorišteni uređaj prije nego što započnete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha univerzális távirányítót használ, amely több eszközt vezérel, a kezdés előtt válasszon egy nem használt eszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda menggunakan remote universal yang mengontrol beberapa perangkat, pilih perangkat yang tidak digunakan sebelum Anda memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utilizzi un telecomando universale che controlla più dispositivi, selezionane uno non in uso prima di iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数デバイスをコントロールするユニバーサルリモコンを使用している場合、開始する前に使用していないデバイスを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 기기를 제어하는 범용 리모컨을 사용하는 경우, 시작하기 전에 사용 중이 아닌 기기를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menggunakan kawalan jauh universal yang mengawal berbilang peranti, pilih peranti yang tidak digunakan sebelum anda bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du bruker en universal fjernkontroll som styrer flere enheter, må du velge en ubrukt enhet før du starter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een universele afstandsbediening gebruikt die meerdere apparaten bedient, selecteer je een ongebruikt apparaat voordat je start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli używasz uniwersalnego pilota, który steruje wieloma urządzeniami, przed rozpoczęciem wybierz nieużywane urządzenie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso esteja usando um controle remoto universal que controla vários dispositivos, selecione um dispositivo não usado antes de começar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver a usar um comando universal que controla vários dispositivos, selecione um dispositivo não usado antes de começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă utilizați o telecomandă universală, care controlează mai multe dispozitive, selectați un dispozitiv neutilizat înainte de a începe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Вы управляете несколькими устройствами с универсального пульта, сначала выберите свободное устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak používate univerzálny ovládač, ktorý ovláda viacero zariadení, pred spustením nastavovania vyberte nepoužívané zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če uporabljate univerzalni daljinec, ki nadzoruje več naprav, izberite napravo, ki je ne uporabljate, preden začnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du använder en universalfjärrkontroll som styr flera enheter väljer du en enhet som inte används innan du börjar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณใช้รีโมทสากลที่ควบคุมอุปกรณ์ได้หลายเครื่อง ให้เลือกอุปกรณ์ที่ไม่ได้ใช้ก่อนที่คุณจะเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla aygıtı denetleyen evrensel bir kumanda kullanıyorsanız başlamadan önce kullanılmayan bir aygıtı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви використовуєте універсальний пульт, який керує кількома пристроями, то спочатку виберіть пристрій, який не використовується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đang sử dụng điều khiển từ xa đa năng điều khiển nhiều thiết bị, hãy chọn một thiết bị chưa sử dụng trước khi bắt đầu."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若在用可控制多部设备的通用遥控器，请在开始前选择未使用的设备。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如你使用的是可控制多部裝置的通用遙控器，請在開始前選擇一個未使用的裝置。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若你使用的是可控制多部裝置的萬用遙控器，請在開始前選取未使用的裝置。"
          }
        }
      }
    },
    "RCLearnRemoteStartDialogTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
