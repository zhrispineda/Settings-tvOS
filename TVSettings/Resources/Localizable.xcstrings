        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่ม %@ ค้างไว้ต่อไปจนกระทั่งแถบดำเนินการเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme çubuğu dolana dek %@ düğmesine basmayı sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте кнопку «%@», доки смуга виконання не заповниться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục giữ nút %@ tới khi thanh tiến trình đầy."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "继续按住%@按钮，直到进度条显示完整为止。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
