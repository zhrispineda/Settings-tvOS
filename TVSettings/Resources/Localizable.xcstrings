        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați un profil nou pe acest Apple TV pentru a‑i accesa emisiunile, filmele, secțiunea „Continuați vizionarea”, datele aplicațiilor de pe iCloud și contul de Game Center."
