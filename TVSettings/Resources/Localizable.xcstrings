    "GameCenterSignInDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول لرؤية لوحات الأوائل وإنجازات Game Center الخاصة بك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sessió per veure els assoliments i les classificacions del Game Center."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se a podívejte se na svoje úspěchy a žebříčky ve službě Game Center."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at se dine bedrifter og resultattavler i Game Center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Game Center-Erfolge und die Bestenlisten zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε για εμφάνιση των επιτευγμάτων σας και των πινάκων κορυφαίων παικτών στο Game Center."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your Game Center achievements and leaderboards."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your Game Center achievements and leaderboards."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your Game Center achievements and leaderboards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus logros y clasificaciones de Game Center."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus logros y clasificaciones de Game Center."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus logros y clasificaciones de Game Center."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääset katselemaan Game Centerin saavutuksia ja tulostaulukoita kirjautumalla sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir vos réalisations et classements Game Center."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour consulter vos réalisations et les classements Game Center."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחבר כדי לראות את ההישגים ולוחות השחקנים שלך מ-Game Center."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी Game Center उपलब्धियों और लीडरबोर्ड को देखने के लिए साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se kako biste vidjeli vaša Game Center dostignuća i rang-liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be a Game Center-ponttáblázatok és ‑eredmények megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk melihat pencapaian dan papan nilai Game Center Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua l’accesso per visualizzare le classifiche e gli obiettivi di Game Center."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、Game Centerの達成項目やランクを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 Game Center 목표 달성 및 순위표를 보려면 로그인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk untuk melihat pencapaian dan papan juara Game Center anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på for å se Game Center-prestasjoner og ledertavler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in om je Game Center-achievements en -ranglijsten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się, aby zobaczyć swoje osiągnięcia i tabele wyników Game Center."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma sessão para ver as conquistas e placares do Game Center."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para ver as suas proezas e as tabelas de classificação do Game Center."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificați‑vă pentru a vedea realizările și clasamentele dvs. din Game Center."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в Game Center, чтобы увидеть свои таблицы результатов и достижений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete prezerať svoje úspechy a umiestnenia v rebríčkoch v Game Center, prihláste sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpišite se za ogled dosežkov in seznamov vodilnih igralcev v storitvi Game Center."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in om du vill visa prestationer och resultattavlor på Game Center."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าเพื่อดูผลสำเร็จและลีดเดอร์บอร์ดใน Game Center ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center başarılarınızı ve puan cetvellerinizi görmek için giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб побачити свої досягнення і списки лідерів Game Center."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem thành tích và bảng xếp hạng Game Center của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "登录来查看你在Game Center中的成就和排行榜。"
          }
        },
        "zh_HK": {
