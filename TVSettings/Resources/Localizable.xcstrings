          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu mengeluarkan akaun medan ujian %@ daripada Apple TV ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne sandkassekontoen %@ fra Apple TV?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je Sandbox-account '%@' wilt verwijderen uit deze Apple TV?"
