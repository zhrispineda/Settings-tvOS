    "AXReduceMotionAutoplayVideoPreviewsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "السماح بالتشغيل التلقائي لمحتوى الفيديوهات في تطبيقات مثل تطبيق التلفزيون.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Permet que el contingut de vídeo es reprodueixi automàticament en apps com ara l’app TV.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Automatické přehrávání videoobsahu v aplikacích, jako je TV.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Tillader, at videoindhold autoafspilles i apps som TV.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Erlaubt die automatische Wiedergabe von Videoinhalten in Apps wie „TV“.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Επιτρέπει την αυτόματη αναπαραγωγή περιεχομένου βίντεο σε εφαρμογές όπως το TV.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Allows video content to auto-play in apps like TV.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Allows video content to auto-play in apps like TV.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Allows video content to auto-play in apps like TV.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Allows video content to auto-play in apps like TV.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Allows video content to auto-play in apps like TV.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Permite que el contenido en vídeo se reproduzca automáticamente en apps como TV.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Permite que los contenidos en video se reproduzcan en apps como TV.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Permite que los contenidos en video se reproduzcan en apps como TV.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Sallii videoiden automaattisen toiston apeissa, esimerkiksi TV-apissa.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Permet la lecture automatique du contenu vidéo dans les apps comme TV.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Autorise la lecture automatique de vidéos dans les apps semblables à TV.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו מאפשרת לתוכני וידאו להיות מופעלים באופן אוטומטי ביישומים כגון TV.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "TV जैसे ऐप्स में वीडियो कॉन्टेंट को ऑटो-प्ले करने की अनुमति देता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Dozvoljava automatsku reprodukciju video sadržaja u aplikacijama kao što je TV.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A videotartalom automatikus lejátszásának engedélyezése az olyan appokban, mint a TV.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Memungkinkan konten video untuk diputar secara otomatis di app seperti TV.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Consente la riproduzione automatica dei contenuti video in app come TV.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "TVのように、アプリ内でビデオコンテンツの自動再生を許可します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "TV 등의 앱에서 비디오 콘텐츠의 자동 재생을 허용합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Membenarkan kandungan video dimain auto dalam app seperti TV.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Hiermee kan videocontent automatisch worden afgespeeld in apps zoals de TV-app.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Tillater automatisk avspilling av videoinnhold i apper som TV-appen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Pozwala automatycznie odtwarzać materiały wideo w aplikacjach, na przykład TV.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Permite que conteúdo em vídeo seja reproduzido automaticamente em apps como TV.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Permite a reprodução automática de conteúdo de vídeo em aplicações como TV.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Permite redarea automată a conținutului video în aplicații precum TV.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Разрешить автовоспроизведение видеоконтента в таких приложениях, как TV.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Umožní automaticky prehrávať videá v apkách, ako napríklad v apke Apple TV.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Omogoča samodejno predvajanje vsebine v aplikacijah, kot je TV.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Tillåter att videoinnehåll spelas upp automatiskt i appar som TV.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "อนุญาตให้เนื้อหาวิดีโอเล่นอัตโนมัติในแอป เช่น แอป TV",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Video içeriklerinin TV gibi uygulamalarda otomatik olarak oynatılmasına izin verir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Дозволяє автовідтворення відеоконтенту в таких програмах, як TV.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Cho phép nội dung video tự động phát trong các ứng dụng như TV.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "允许视频内容在App（如TV）中自动播放。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "允許影片內容於TV等App中自動播放。",
