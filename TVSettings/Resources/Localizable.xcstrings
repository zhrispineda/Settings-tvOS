    "AccountsICloudDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Apple المقترن بحساب iCloud هذا يحدد المنزل ومكتبة الصور و CloudKit لهذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El compte d’Apple associat a aquest iCloud determina la informació de casa, la fototeca i el CloudKit d’aquest Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet Apple sdružený s tímto účtem na iCloudu určuje domácnost, knihovnu fotek a CloudKit pro tuto Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-kontoen tilknyttet denne iCloud-konto bestemmer Hjem, fotobiblioteket og CloudKit til dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhand des mit dieser iCloud verknüpften Apple Accounts werden die Home-App, die Fotomediathek und CloudKit für dieses Apple TV bestimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός Apple που είναι συσχετισμένος με αυτό το iCloud προσδιορίζει την Οικία, τη Βιβλιοθήκη φωτογραφιών και το CloudKit για αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Account associated with this iCloud determines the Home, Photo Library, and CloudKit for this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Account associated with this iCloud determines the Home, Photo Library and CloudKit for this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Account associated with this iCloud determines the Home, Photo Library and CloudKit for this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Apple asociada a este iCloud determina la información de la app Casa, la fototeca y los datos de CloudKit de este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Apple asociada con esta cuenta de iCloud determina el uso de Casa, la fototeca y CloudKit en este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Apple asociada con esta cuenta de iCloud determina el uso de Casa, la fototeca y CloudKit en este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän iCloudiin yhdistetty Apple-tili määrittää tämän Apple TV:n Kodin, kuvakirjaston ja CloudKitin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte Apple associé à ce compte iCloud détermine l’écran d’accueil, la photothèque et les données CloudKit utilisés par cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app Domicile, la photothèque et les données CloudKit de cette Apple TV s’affichent en fonction du compte Apple associé à ce compte iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון ה-Apple שמקושר ל-iCloud זה יגדיר אצלך ב-Apple TV את ״הבית שלי״, ״ספריית התמונות״ ו-CloudKit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iCloud से संबद्ध Apple खाता इस Apple TV के लिए घर, तस्वीर लाइब्रेरी और CloudKit को निर्धारित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple račun povezan s ovim iCloud računom određuje Dom, Foto medijateku i CloudKit za ovaj Apple TV."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ehhez az iCloudhoz hozzárendelt Apple-fiók határozza meg az Otthont, a Fotókönyvtárat és a CloudKitet ehhez az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Apple yang terkait dengan iCloud ini menentukan Beranda, Perpustakaan Foto, dan CloudKit untuk Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple Account associato a questo account iCloud gestisce l’abitazione, la libreria foto e CloudKit su questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiCloudに関連付けられているApple Accountにより、このApple TV用のホーム、写真ライブラリ、CloudKitが決定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iCloud와 연결된 Apple 계정은 이 Apple TV용으로 사용할 홈, 사진 보관함 및 CloudKit를 결정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun Apple yang dikaitkan dengan iCloud ini menentukan Rumah, Pustaka Foto dan CloudKit untuk Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-kontoen tilknyttet denne iCloud-kontoen avgjør hvilket Hjem, bildebibliotek og CloudKit som brukes med Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple Account die aan deze iCloud is gekoppeld, bepaalt de woning, fotobibliotheek en CloudKit voor deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto Apple powiązane z tym kontem iCloud określa dom, bibliotekę zdjęć i CloudKit tego Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Conta Apple associada a esta conta do iCloud determina o app Casa, a Fototeca e o CloudKit para esta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta Apple associada a esta conta iCloud determina a aplicação Casa, a fototeca e CloudKit a usar com esta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul Apple asociat cu acest cont de iCloud determină locuința, biblioteca foto și opțiunile CloudKit pentru acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От Аккаунта Apple, связанного с iCloud, зависит то, какой контент будет отображаться на этом Apple TV в приложении «Дом», медиатеке «Фото», а также в приложениях с поддержкой CloudKit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude pre knižnicu fotiek, Domácnosť a CloudKit používať iCloud dáta z tohto Apple účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun Apple, povezan s tem računom iCloud, določa Dom, knjižnico fotografij in CloudKit za ta Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Apple‑konto som är kopplat till detta iCloud-konto bestämmer Hem, Bildbibliotek och CloudKit för denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Apple ที่ผูกกับ iCloud นี้ใช้กำหนดบ้าน คลังรูปภาพ และ CloudKit สำหรับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iCloud ile ilişkili Apple Hesabı, bu Apple TV için Ev’i, Fotoğraf Arşivi’ni ve CloudKit’i belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис Apple, повʼязаний із цим iCloud, визначає Дім, Фототеку і CloudKit для цього Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple được liên kết với iCloud này xác định Nhà, Thư viện ảnh và CloudKit cho Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这台Apple TV的“家庭”、照片图库和CloudKit取决于与此iCloud关联的Apple账户。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "與此iCloud有關聯的Apple帳户會決定此Apple TV的「家居」、「相片圖庫」及CloudKit。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "與此iCloud相關的「Apple帳號」會決定這部Apple TV的「家庭」、「照片圖庫」和CloudKit。"
          }
        }
      }
    },
