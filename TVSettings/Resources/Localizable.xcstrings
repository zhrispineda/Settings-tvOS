    "RemoteAppPairingInstructions": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الموجود على الجهاز الذي تحاول إقرانه"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el codi del dispositiu que proves d’enllaçar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte kód na zařízení, které se pokoušíte spárovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv koden på den enhed, som du prøver at danne par med"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code auf dem Gerät eingeben, das gekoppelt werden soll"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον κωδικό στη συσκευή που θέλετε να ζευγοποιήσετε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code on the device that you’re trying to pair"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code on the device that you’re trying to pair"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code on the device that you’re trying to pair"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código en el dispositivo que intentas enlazar"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código que se muestra en el dispositivo que intentas enlazar"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código que se muestra en el dispositivo que intentas enlazar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä koodi siitä laitteesta, josta olet tekemässä paria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code sur l’appareil que vous tentez de jumeler"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le code sur l’appareil que vous essayez de jumeler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין את הקוד במכשיר שברצונך לקשר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिस डिवाइस को पेयर करने की कोशिश कर रहे हैं, उस पर दर्शाया गया कोड दर्ज करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite kôd na uređaj koji pokušavate upariti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a kódot a párosítani próbált eszközön"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode di perangkat yang Anda coba pasangkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice mostrato sul dispositivo che stai provando ad abbinare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングしようとしているデバイスでコードを入力してください"
