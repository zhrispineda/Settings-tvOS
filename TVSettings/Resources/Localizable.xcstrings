    "AccountsEditUserTapToSignInBody": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تقريب iPhone أو iPad من Apple TV للبدء. عند تسجيل الدخول باستخدام iPhone أو iPad، تتم مشاركة بيانات iCloud بأمان لتتمكن من استخدام جميع ميزات Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apropa l’iPhone o l’iPad a l’Apple TV per començar. Si inicies sessió amb l’iPhone o l’iPad, es compartiran les dades de l’iCloud de manera segura perquè puguis utilitzar totes les funcions de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizaci spustíte podržením svého iPhonu nebo iPadu u Apple TV. Přihlášením pomocí iPhonu nebo iPadu umožníte bezpečné sdílení vašich dat na iCloudu, abyste mohli používat všechny funkce Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold din iPhone eller iPad i nærheden af Apple TV-enheden for at begynde. Når du logger ind med iPhone eller iPad, deles dine iCloud-data på sikker vis, så du kan bruge alle funktioner på Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dein iPhone oder iPad nahe an das Apple TV, um zu beginnen. Durch das Anmelden mit deinem iPhone oder iPad werden iCloud-Daten sicher geteilt, damit du alle Apple TV-Funktionen verwenden kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το iPhone ή το iPad σας κοντά στο Apple TV για να ξεκινήσετε. Η σύνδεση μέσω iPhone ή iPad κοινοποιεί με ασφάλεια τα δεδομένα iCloud σας, έτσι ώστε να μπορείτε να χρησιμοποιήσετε όλες τις δυνατότητες του Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone or iPad close to the Apple TV to get started. Signing in with your iPhone or iPad securely shares your iCloud data, so you can use all Apple TV features."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone or iPad close to the Apple TV to get started. Signing in with your iPhone or iPad securely shares your iCloud data, so you can use all Apple TV features."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone or iPad close to the Apple TV to get started. Signing in with your iPhone or iPad securely shares your iCloud data, so you can use all Apple TV features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para empezar, acerca tu iPhone o iPad al Apple TV. Iniciar sesión con el iPhone o iPad permite compartir tus datos de iCloud de forma segura para que puedas disfrutar de todas las funciones del Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca tu iPhone o iPad al Apple TV para comenzar. Al iniciar sesión con tu iPhone o iPad, se comparten tus datos de iCloud de forma segura para que puedas disfrutar de todas las funciones del Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca tu iPhone o iPad al Apple TV para comenzar. Al iniciar sesión con tu iPhone o iPad, se comparten tus datos de iCloud de forma segura para que puedas disfrutar de todas las funciones del Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita pitämällä iPhonea tai iPadia Apple TV:n lähellä. Kirjautuminen iPhonella tai iPadilla jakaa iCloud-tietosi suojatusti, joten voit käyttää kaikkia Apple TV:n ominaisuuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre iPhone ou iPad près de l’Apple TV pour commencer. La connexion avec votre iPhone ou iPad vous permet de partager en toute sécurité vos données iCloud pour pouvoir utiliser toutes les fonctionnalités de l’Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre iPhone ou iPad proche de l’Apple TV pour commencer. La connexion avec votre iPhone ou iPad partage en sécurité vos données iCloud pour que vous puissiez utiliser toutes les fonctionnalités de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להתחיל יש לקרב את ה-iPhone או ה-iPad ל‑Apple TV. התחברות מאובטחת באמצעות ה-iPhone או ה-iPad מאפשרת לך לשתף את נתוני ה-iCloud שלך וכך להשתמש בכל המאפיינים של ה‑Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए अपने iPhone या iPad को Apple TV के पास रखें। अपने iPhone या iPad के साथ साइन इन करने से आपका iCloud डेटा सुरक्षित रूप से शेयर किया जाता है, ताकि आप Apple TV के सभी फ़ीचर का इस्तेमाल कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za početak držite svoj iPhone ili iPad blizu Apple TV-a. Prijavljivanje pomoću iPhonea ili iPada omogućava sigurno dijeljenje vaših iCloud podataka kako biste mogli koristiti sve značajke Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdéshez tartsa közel az iPhone-ját vagy iPadjét az Apple TV-hez. Az iPhone-nal vagy iPaddel való bejelentkezés biztonságosan megosztja az Ön iCloud-adatait, így az Apple TV összes funkcióját használhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekatkan iPhone atau iPad Anda ke Apple TV untuk memulai. Jika Anda masuk menggunakan iPhone atau iPad dengan aman, data iCloud Anda akan dibagikan agar Anda dapat menggunakan semua fitur Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina iPhone o iPad ad Apple TV per iniziare. Eseguendo l’accesso con iPhone o iPad, i dati di iCloud vengono condivisi in modo sicuro per consentirti di utilizzare tutte le funzionalità di Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneまたはiPadをApple TVの近くにかざして開始してください。iPhoneまたはiPadで安全にサインインするとiCloudデータが共有されるため、Apple TVのすべての機能を使用することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 iPhone 또는 iPad를 Apple TV 가까이 들고 있으십시오. iPhone 또는 iPad로 로그인하면 iCloud 데이터가 안전하게 공유되어, Apple TV의 모든 기능을 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang iPhone atau iPad anda berdekatan Apple TV untuk bermula. Mendaftar masuk dengan iPhone atau iPad anda akan berkongsi data iCloud anda dengan selamat, jadi anda boleh menggunakan semua ciri Apple TV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold iPhonen eller iPaden nær Apple TV for å komme i gang. Pålogging fra iPhonen eller iPaden deler iCloud-dataene dine på en sikker måte, slik at du kan bruke alle Apple TV-funksjonene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je iPhone of iPad in de buurt van deze Apple TV om te beginnen. Als je inlogt met je iPhone of iPad, worden je iCloud-gegevens veilig gedeeld, zodat je alle Apple TV-functies kunt gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby rozpocząć, zbliż iPhone’a lub iPada do Apple TV. Jeśli zalogujesz się, używając iPhone’a lub iPada, uzyskasz dostęp do wszystkich funkcji Apple TV dzięki bezpiecznemu udostępnianiu danych iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para começar, aproxime o iPhone ou iPad da Apple TV. Se você iniciar a sessão com o iPhone ou iPad, poderá compartilhar com segurança os dados do iCloud para usar todos os recursos da Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime o iPhone ou iPad da Apple TV para começar. Iniciar sessão com o iPhone ou iPad permite partilhar com segurança os seus dados em iCloud, para que possa usar todas as funcionalidades da Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți iPhone‑ul sau iPad‑ul în apropierea acestui Apple TV pentru a începe. Autentificarea cu iPhone‑ul sau iPad‑ul permite partajarea în mod securizat a datelor iCloud, astfel încât să puteți utiliza toate funcționalitățile Apple TV‑ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы приступить, держите iPhone или iPad вблизи этого Apple TV. Если выполнить вход на iPhone или iPad, Вы сможете безопасно делиться своими данными из iCloud и пользоваться всеми функциями Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite podržaním iPhonu alebo iPadu v blízkosti Apple TV. Prihlásením pomocou iPhonu alebo iPadu umožníte bezpečné zdieľanie svojich dát na iCloude, aby ste mohli používať všetky funkcie Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za začetek pridržite iPhone ali iPad v bližini Apple TV-ja. Če se vpišete z iPhonom ali iPadom, omogočite varno deljenje podatkov v storitvi iCloud, da bi lahko uporabljali vse funkcije Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom igång genom att hålla iPhone eller iPad nära Apple TV. När du loggar in med iPhone eller iPad delas dina iCloud-data på ett säkert sätt så att du kan använda alla Apple TV-funktioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถือ iPhone หรือ iPad ของคุณให้ใกล้กับ Apple TV เพื่อเริ่มต้น การลงชื่อเข้าด้วย iPhone หรือ iPad จะแชร์ข้อมูล iCloud ของคุณอย่างปลอดภัย ซึ่งคุณสามารถใช้คุณสมบัติ Apple TV ทั้งหมดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için iPhone’unuzu veya iPad’inizi Apple TV’ye yaklaştırın. iPhone’unuz veya iPad’iniz ile giriş yapma iCloud verilerinizin güvenle paylaşılmasını sağlar, böylece bütün Apple TV özelliklerini kullanabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб почати, розмістіть iPhone або iPad поруч з Apple TV. Вхід через iPhone або iPad дає змогу безпечно поширювати дані iCloud, щоб використовувати всі функції Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ iPhone hoặc iPad của bạn gần Apple TV để bắt đầu. Việc đăng nhập bằng iPhone hoặc iPad sẽ chia sẻ bảo mật dữ liệu iCloud để bạn có thể sử dụng tất cả các tính năng của Apple TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将iPhone或iPad靠近Apple TV以开始。通过iPhone或iPad登录会安全共享你的iCloud数据，以便你可以使用Apple TV的所有功能。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的iPhone或iPad靠近此Apple TV以開始操作。透過iPhone或iPad登入可安全地共享iCloud資料，讓你能使用所有Apple TV功能。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將iPhone或iPad靠近Apple TV來開始設定。使用iPhone或iPad登入來安全地分享你的iCloud資料，以便使用所有的Apple TV功能。"
          }
        }
      }
    },
