    "OSBetaSoftwareUpdatesUnenrolledInfoText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تسجيل هذا الـ Apple TV في Apple Beta Software Program للحصول على التحديثات التجريبية لـ tvOS.\n\nلمزيد من المعلومات، انتقل إلى:\nbeta.apple.com"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots inscriure l’Apple TV en un programa Apple Beta Software per rebre actualitzacions beta per al tvOS.\n\nPer obtenir més informació, ves a beta.apple.com."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li stahovat aktualizace betaverzí tvOS, zaregistrujte Apple TV do programu Apple Beta Software.\n\nDalší informace najdete na stránce beta.apple.com."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilmelde dette Apple TV til et Apple Beta Software Program for at få beta-opdateringer til tvOS.\n\nLæs mere på beta.apple.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registriere dieses Apple TV für ein Beta Software-Programm von Apple, um Beta-Updates für tvOS zu laden.\n\nWeitere Informationen erhältst du unter beta.apple.com."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να εγγράψετε αυτό το Apple TV σε ένα Πρόγραμμα Apple Beta Software για να λαμβάνετε ενημερώσεις beta για το tvOS.\n\nΓια περισσότερες πληροφορίες, μεταβείτε στη διεύθυνση beta.apple.com."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can enroll this Apple TV in an Apple Beta Software Program to get beta updates for tvOS.\n\nFor more information, go to beta.apple.com."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can enrol this Apple TV in an Apple Beta Software Program to get beta updates for tvOS.\n\nFor more information, go to beta.apple.com."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can enrol this Apple TV in an Apple Beta Software Programme to get beta updates for tvOS.\n\nFor more information, go to beta.apple.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes inscribir este Apple TV en un programa Apple Beta Software para obtener actualizaciones beta de tvOS.\n\nPara más información, visita beta.apple.com."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes inscribir este Apple TV en el programa Apple Beta Software para obtener actualizaciones beta de tvOS.\n\nConsulta más información en beta.apple.com."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes inscribir este Apple TV en el programa Apple Beta Software para obtener actualizaciones beta de tvOS.\n\nConsulta más información en beta.apple.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit hankkia beta-päivityksiä tvOS:lle rekisteröimällä tämän Apple TV:n Apple Beta Software Program ‑ohjelmaan.\n\nLisätietoja löytyy osoitteesta beta.apple.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez inscrire cette Apple TV à un programme de logiciels bêta d’Apple pour obtenir les mises à jour bêta de tvOS.\n\nPour en savoir plus, consultez la page https://beta.apple.com/sp/fr/betaprogram/."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez inscrire cette Apple TV à un programme de logiciels bêta d’Apple et obtenir les mises à jour de tvOS correspondantes.\n\nRendez-vous sur beta.apple.com pour obtenir plus d’informations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לרשום את מכשיר ה-Apple TV לתוכנית Apple Beta Software ולקבל עדכוני בטא של tvOS.\n\nפרטים נוספים זמינים בכתובת: beta.apple.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tvOS के लिए बीटा अपडेट प्राप्त करने के लिए आप इस Apple TV को Apple Beta Software प्रोग्राम में नामांकित कर सकते हैं।\n\nअधिक जानकारी के लिए beta.apple.com पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete prijaviti ovaj Apple TV u Apple Beta Software program kako biste mogli preuzimati beta ažuriranja za tvOS.\n\nZa dodatne informacije posjetite beta.apple.com."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tvOS nyilvános bétaverzióihoz való hozzáféréshez feliratkozhat az Apple Beta Software programra ezzel az Apple TV-vel.\n\nTovábbi információkért keresse fel a beta.apple.com webhelyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mendaftarkan Apple TV ini di Program Apple Beta Software untuk mendapatkan pembaruan beta untuk tvOS.\n\nUntuk informasi lainnya, buka beta.apple.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi registrare Apple TV a uno degli Apple Beta Software Program per ricevere aggiornamenti beta per tvOS.\n\nPer ulteriori informazioni, vai alla pagina beta.apple.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVをApple Beta Software Programに登録して、tvOSのベータアップデートを入手することができます。\n\n詳しくは、beta.apple.comをご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV를 Apple 베타 소프트웨어 프로그램에 등록하여 tvOS 베타 업데이트를 받을 수 있습니다.\n\n자세한 정보는 beta.apple.com 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mendaftarkan Apple TV ini dalam Program Apple Beta Software untuk mendapatkan kemas kini beta bagi tvOS.\n\nUntuk mendapatkan maklumat lanjut, pergi ke beta.apple.com."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan registrere Apple TV i program for betatesting av tvOS fra Apple Beta Software-programmet.\n\nFinn ut mer på beta.apple.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze Apple TV inschrijven voor een Apple Beta Software-programma om bèta-updates te ontvangen voor tvOS.\n\nGa voor meer informatie naar beta.apple.com."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zarejestrować ten Apple TV w programie Apple Beta Software i otrzymywać uaktualnienia beta systemu tvOS.\n\nWięcej informacji: beta.apple.com."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode inscrever esta Apple TV em um Programa Apple Beta Software para obter atualizações beta do tvOS.\n\nPara obter mais informações, acesse beta.apple.com."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode registar esta Apple TV num Apple Beta Software Program para obter atualizações das versões beta do tvOS.\n\nEncontrará informação adicional em beta.apple.com."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți înscrie acest Apple TV într‑un program Apple Beta Software pentru a primi actualizări beta pentru tvOS.\n\nPentru mai multe informații, accesați beta.apple.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете зарегистрировать этот Apple TV в Программе бета-тестирования Apple, чтобы получать бета‑версии обновлений tvOS.\n\nПодробнее на сайте beta.apple.com."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto Apple TV môžete registrovať v Apple Beta Software Programe a získavať aktualizácie betaverzií tvOS.\n\nViac informácií nájdete na stránke beta.apple.com."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Apple TV lahko vpišete v program Apple Beta Software, da prejmete posodobitve beta za tvOS.\n\nZa več informacij pojdite na beta.apple.com."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan registrera denna Apple TV i ett Apple Beta Software Program om du vill få betaversioner för tvOS.\n\nMer information hittar du på beta.apple.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถลงทะเบียน Apple TV เครื่องนี้ได้ในโปรแกรม Apple Beta Software เพื่อรับการอัปเดตรุ่นเบต้าสำหรับ tvOS\n\nสำหรับข้อมูลเพิ่มเติม ให้ไปที่ beta.apple.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’yi bir Apple Beta Software Programı’na kaydettirip tvOS için beta güncellemelerini alabilirsiniz.\n\nDaha fazla bilgi için beta.apple.com adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна зареєструвати цей Apple TV в одній із Програм бета-тестування Apple Beta Software, щоб отримувати бета-оновлення для tvOS.\n\nДодаткові відомості наведено на вебсайті beta.apple.com."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đăng ký Apple TV này vào một Chương trình Apple Beta Software để nhận các bản cập nhật beta cho tvOS.\n\nĐể biết thêm thông tin, hãy truy cập beta.apple.com."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“Apple Beta版软件计划”中注册此Apple TV以获取Apple tvOS的Beta版更新。\n\n若要了解更多信息，请访问beta.apple.com。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以為此Apple TV註冊「Apple Beta Software計劃」以取得tvOS的Beta更新項目。\n\n詳情請瀏覽beta.apple.com。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你可將此Apple TV在「Apple Beta版軟體計畫」中註冊來取得tvOS的Beta版更新項目。\n\n如需更多資訊，請前往beta.apple.com"
          }
        }
      }
    },
