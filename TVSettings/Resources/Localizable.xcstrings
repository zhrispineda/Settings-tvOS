    "NetworkConfigureDNSEntryPrompt": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان لديك عنوان IP الخاص بخادم DNS، فأدخله ثم حدد \"تم\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tens l’adreça IP d’un servidor DNS de l’encaminador, introdueix‑la i selecciona “Fet”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte‑li k dispozici IP adresu DNS serveru, zadejte ji a vyberte volbu Hotovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har IP-adressen til en DNS-server, skal du skrive den og vælge OK."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du über die IP-Adresse eines DNS-Servers verfügst, gib diese ein und wähle „OK“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν έχετε τη διεύθυνση IP για έναν διακομιστή DNS, εισαγάγετέ την και μετά επιλέξτε «Τέλος»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have the IP address for a DNS server, enter it and then select Done."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have the IP address for a DNS server, enter it and then select Done."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have the IP address for a DNS server, enter it and then select Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes la dirección IP de un servidor DNS, introdúcela y selecciona OK."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes la dirección IP de un servidor DNS, ingrésala y selecciona Listo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes la dirección IP de un servidor DNS, ingrésala y selecciona Listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tiedät nimipalvelimen IP-osoitteen, syötä se ja valitse sitten OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez l’adresse IP d’un serveur DNS, saisissez-la puis sélectionnez OK."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez l’adresse IP d’un serveur DNS, entrez-la puis sélectionnez OK."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יש ברשותך את כתובת ה-IP של שרת DNS, יש להזין אותה ולבחור ב״סיום״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपके पास DNS सर्वर के लिए IP पता है, तो उसे दर्ज करें और “पूर्ण” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako imate IP adresu DNS servera, unesite je pa odaberite Gotovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha rendelkezik a DNS-szerver IP-címével, adja meg azt, majd válassza a Kész lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda memiliki alamat IP untuk server DNS, masukkan lalu pilih Selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponi di un indirizzo IP per il server DNS, inseriscilo e seleziona Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSサーバのIPアドレスがあれば入力して、“完了”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 서버 IP 주소가 있다면 입력한 다음 완료를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda mempunyai alamat IP untuk pelayan DNS, masukkannya, kemudian pilih Selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har IP-adressen til en DNS-tjener, skriver du den inn og velger Ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het IP-adres voor een DNS-server hebt, voer je dat in en selecteer je 'OK'."
