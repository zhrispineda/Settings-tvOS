    "RootCertificateWarningMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: تمكين هذه الشهادة للمواقع الإلكترونية سيسمح للجهات الخارجية بمشاهدة أي بيانات خاصة مرسلة إلى المواقع الإلكترونية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avís: Si actives el certificat per als llocs web, les empreses de tercers podran consultar les dades privades que hi enviïs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Varování: Zapnutím tohoto certifikátu pro webové stránky zpřístupníte třetím stranám veškerá soukromá data odeslaná na webové stránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarsel: hvis du slår dette certifikat til for websteder, vil tredjeparter kunne se alle private data, som sendes til websteder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Durch Aktivierung dieses Zertifikats für Websites haben Drittanbieter Einblick in sämtliche private Daten, die an Websites geschickt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προειδοποίηση: Αν ενεργοποιήσετε αυτό το πιστοποιητικό για ιστότοπους, θα επιτρέπεται σε τρίτους η προβολή προσωπικών δεδομένων που στέλνονται σε ιστότοπους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: enabling this certificate for websites will allow third parties to view any private data sent to websites."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: enabling this certificate for websites will allow third parties to view any private data sent to websites."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: enabling this certificate for websites will allow third parties to view any private data sent to websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertencia: Al activar este certificado para sitios web, se permitirá que terceros vean los datos privados que se envíen a los sitios web."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertencia: activar este certificado en páginas de Internet permitirá que terceros vean los datos privados que se envíen."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertencia: activar este certificado en páginas de Internet permitirá que terceros vean los datos privados que se envíen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varoitus: jos tämä varmenne otetaan käyttöön sivustoille, kolmannet osapuolet voivat nähdä sivustoille lähetettyjä yksityisiä tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement : l’activation de ce certificat pour les sites web autorise les tiers à consulter les données privées envoyées aux sites web."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement : L’activation de ce certificat pour les sites Web permet aux tiers d’afficher les données privées envoyées aux sites Web."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזהרה: הפעלת אישור זה באתרי אינטרנט תאפשר לגורמים חיצוניים לצפות בנתונים פרטיים הנשלחים אל אתרי אינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी : वेबसाइटों के लिए इस सर्टिफ़िकेट को सक्षम करने पर वेबसाइटों को भेजा जाने वाला कोई भी गोपनीय डेटा तृतीय पक्ष द्वारा देखा जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenje: omogućite li ovaj certifikat za web stranice, drugim stranama bit će omogućeno pregledavanje svih privatnih podataka koji su poslani web stranicama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztetés: Ha engedélyezi ezt a tanúsítványt a webhelyekhez, akkor lehetővé teszi harmadik felek számára, hogy megtekintsék a webhelyeknek küldött személyes információkat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan: jika sertifikat ini diaktifkan untuk situs web, pihak ketiga akan dapat melihat data pribadi yang dikirimkan ke situs web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso: abilitando questo certificato per i siti web, consentirai a terze parti di accedere a qualsiasi dato privato che invii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告:  このWebサイト用証明書を有効にすると、第三者がWebサイトに送信された非公開データをすべて見ることができるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고: 웹사이트에 대한 이 인증서를 활성화하면 웹사이트로 보내진 모든 개인정보 데이터를 타사에서 볼 수 있게 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran: mendayakan sijil ini untuk tapak web akan membenarkan pihak ketiga melihat sebarang data peribadi yang dihantar ke tapak web."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarsel: Hvis du aktiverer dette sertifikatet for nettsteder, kan tredjeparter se all personlig informasjon som sendes til nettsteder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwing: wanneer je dit certificaat voor websites inschakelt kunnen derde partijen persoonlijke gegevens bekijken die naar websites worden verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: Jeśli włączysz ten certyfikat dla witryn, inne podmioty będą miały wgląd w prywatne dane wysyłane do witryn."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: a ativação deste certificado para sites autorizará terceiros a ver todos os dados privados enviados para sites."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: a ativação deste certificado para sites permitirá a terceiros verem todos os dados privados enviados a sites."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertisment: activarea acestui certificat pentru site‑uri web va permite vizualizarea de către terțe părți a oricăror date private trimise site‑urilor web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание! Включение этого сертификата для сайтов позволит третьей стороне видеть личные данные, отправляемые на сайты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie: povolením tohto certifikátu pre webové stránky umožníte tretím stranám prezerať si súkromné údaje odosielané na stránky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorilo: če omogočite to potrdilo za spletna mesta, boste tretjim osebam omogočili ogled zasebnih podatkov, ki so poslani spletnim mestom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varning: Om du aktiverar detta certifikat för webbplatser kan tredje parter se alla privata data som skickas till webbplatser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเตือน: การเปิดใช้งานใบรับรองนี้สำหรับเว็บไซต์จะอนุญาตให้บริษัทหรือบุคคลอื่นดูข้อมูลส่วนตัวที่ส่งไปยังเว็บไซต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı: Web siteleri için bu sertifikayı etkinleştirmek üçüncü partilerin web sitelerine gönderilen özel verileri görmesine izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застереження! Увімкнення цього сертифіката для вебсайтів дозволить третім особам бачити будь-які особисті дані, які надсилаються до вебсайтів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo: việc bật chứng nhận này cho các trang web sẽ cho phép các bên thứ ba xem mọi dữ liệu riêng tư được gửi đến trang web."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：为网站启用此证书将允许第三方查看发送给网站的任何私人数据。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：為網站啟用此憑證將允許第三方檢視任何傳送到網站的私人資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：為網站啟用此憑證將允許第三方檢視任何傳送到網站的私人資料。"
          }
        }
      }
    },
