    "AXSpatialAudioFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "عند استخدام صوت مركزي، يبدو الصوت المكاني وكأنه قادم من التلفزيون، حتى عند تحريك رأسك. وعند إيقاف الصوت المركزي، يظل الصوت المكاني تجربة صوتية غامرة، لكنه لا يتتبع حركة رأسك.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Amb l’opció de centrar l’àudio, semblarà que l’àudio espacial vingui del televisor, fins i tot en moure el cap. Si la desactives, l’àudio espacial continuarà sent una experiència immersiva, però no seguirà el moviment del teu cap.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Při zapnutém centrování zní prostorový zvuk tak, jako by stále vycházel z televize, i když pohybujete hlavou. Když centrování vypnete, bude prostorový zvuk dál vytvářet imerzivní zvukové prostředí, ale nebude se měnit podle toho, jak natočíte hlavu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Centrering får det til at lyde som om rumlig lyd kommer fra fjernsynet, selv når du bevæger hovedet. Hvis du slår centrering fra, vil du fortsat få en fordybende lydoplevelse med rumlig lyd, men lyden følger ikke længere hovedets bevægelser.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Durch das Zentrieren klingt 3D-Audio so, als käme es von deinem TV-Gerät, selbst wenn du den Kopf bewegst. Wenn du das Zentrieren deaktivierst, ist 3D-Audio weiterhin ein immersives Klangerlebnis, folgt aber nicht deinen Kopfbewegungen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Χάρη στο κεντράρισμα, ο χωρικός ήχος ακούγεται σαν να προέρχεται από την τηλεόρασή σας, ακόμη και όταν κινείται το κεφάλι σας. Αν απενεργοποιήσετε το κεντράρισμα, ο χωρικός ήχος εξακολουθεί να παρέχει καθηλωτική εμπειρία ήχου, αλλά δεν ακολουθεί την κίνηση του κεφαλιού σας.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Centering makes it sound like spatial audio is coming from your TV, even when your head moves. If you turn off centering, spatial audio is still an immersive sound experience, but does not track with your head movement.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Centring makes it sound like spatial audio is coming from your TV, even when your head moves. If you turn off centring, spatial audio is still an immersive sound experience, but does not track with your head movement.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Centering makes it sound like spatial audio is coming from your TV, even when your head moves. If you turn off centering, spatial audio is still an immersive sound experience, but does not track with your head movement.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Centring makes it sound like spatial audio is coming from your TV, even when your head moves. If you turn off centring, spatial audio is still an immersive sound experience but does not track with your head movement.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Centering makes it sound like spatial audio is coming from your TV, even when your head moves. If you turn off centering, spatial audio is still an immersive sound experience, but does not track with your head movement.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Al activar esta función, el audio espacial sonará como si procediera del televisor, aunque muevas la cabeza. Si desactivas esta función, el audio espacial seguirá ofreciéndote una experiencia de sonido inmersiva, pero no seguirá el movimiento de tu cabeza.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Al centrar, el audio espacial sonará como si viniera de tu TV, incluso si mueves la cabeza. Si desactivas esta opción, el audio espacial seguirá siendo una experiencia inmersiva, pero no seguirá el movimiento de tu cabeza.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Al centrar, el audio espacial sonará como si viniera de tu TV, incluso si mueves la cabeza. Si desactivas esta opción, el audio espacial seguirá siendo una experiencia inmersiva, pero no seguirá el movimiento de tu cabeza.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "TV:n asettaminen äänen keskipisteeksi saa tilaäänen kuulostamaan siltä kuin se tulisi TV:stäsi silloinkin, kun pääsi liikkuu. Jos laitat tämän pois päältä, tilaääni on edelleen immersiivinen, mutta se ei enää seuraa pääsi liikettä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Le centrage de l’audio donne l’impression que l’audio spatial provient de votre téléviseur, même lorsque vous bougez la tête. Si vous désactivez le centrage, l’audio spatial continuera de vous offrir une expérience sonore immersive, mais elle ne suivra pas les mouvements de votre tête.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Le centrage donne l’impression que l’audio spatial provient de votre télévision, et ce, même lorsque vous bougez la tête. Si vous désactivez le centrage, l’audio spatial offrira toujours une expérience sonore immersive, mais elle ne suivra pas les mouvements de votre tête.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "פעולת המרכוז גורמת לצליל להישמע כאילו שמע מרחבי בוקע מהטלוויזיה, גם אם הראש שלך זז. אם פעולת המרכוז תכובה, השמע המרחבי עדיין יצור חוויית שמע רב-ממדית, אך בלי לעקוב אחר תנועות הראש שלך.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "केंद्रित करने से ऐसा लगता है कि स्पेशियल ऑडियो आपके टीवी से आ रहा है, तब भी जबकि आपका सिर हिल रहा हो। यदि आप केंद्रित करना बंद कर देते हैं, तब भी स्पेशियल ऑडियो इमर्सिव ध्वनि का अनुभव देता है लेकिन आपके सिर के हिलने-डुलने को ट्रैक नहीं करता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Centriranjem se postiže dojam da prostorni zvuk dolazi iz vašeg televizora, čak i kad vam se glava pomiče. Ako isključite centriranje, prostorni zvuk je i dalje prožimajući zvučni doživljaj, ali ne prati vaše pomicanje glave.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A hang középre igazítása olyan hatást kelt, mintha a térbeli hang a televízióból szólna, még akkor is, ha Ön mozgatja a fejét. Ha kikapcsolja a középre igazítást, a térbeli hang továbbra is magával ragadó hangzást fog nyújtani, azonban nem követi az Ön fejmozgását.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Pemusatan membuat audio spasial seperti berasal dari TV Anda, bahkan saat kepala Anda bergerak. Jika Anda mematikan pemusatan, pengalaman audio spasial masih imersif, tapi tidak melacak gerakan kepala Anda.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Se attivi l’opzione, l’audio spaziale sembrerà provenire dalla TV anche quando muovi la testa. Se la disattivi, l’audio spaziale offrirà comunque un’esperienza avvolgente, ma i movimenti della testa non verranno rilevati.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "センタリングを行うと、頭が動いても、空間オーディオがテレビから聞こえてくるようになります。センタリングをオフにすると、空間オーディオは頭の動きに追従せず、臨場感のあるサウンド体験が得られます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "오디오를 TV 중앙에 두면 머리를 움직이더라도 공간 음향이 TV로부터 나오는 것으로 들립니다. 이 기능을 끄면 공간 음향이 여전히 몰입감 있는 음향을 제공하지만, 머리의 움직임을 따라가지는 않습니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Memusatkan membuatkan audio ruang berbunyi seakan-akan datang daripada TV anda, walaupun kepala anda bergerak. Jika anda menyahaktifkan pemusatan, audio ruang masih memberikan pengalaman bunyi imersif, tetapi tidak menjejak dengan pergerakan kepala anda.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Door audio te centreren lijkt het alsof ruimtelijke audio van je tv komt, ook als je je hoofd beweegt. Als je centrering uitschakelt, is ruimtelijke audio nog steeds een meeslepende geluidservaring, maar wordt je hoofdbeweging er niet mee gevolgd.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Sentrering gjør at det høres ut som romtilpasset lyd kommer fra TV-en, selv når du beveger på hodet. Hvis du slår av sentrering, vil romtilpasset lyd fortsatt gi en flerdimensjonal lydopplevelse, men lyden vil ikke følge hodebevegelsene dine.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Gdy środkowanie jest włączone, dźwięk przestrzenny zdaje się zawsze dochodzić z telewizora, niezależnie od ruchów Twojej głowy. Po wyłączeniu tej opcji dźwięk jest nadal immersyjny, ale nie podąża za ruchami Twojej głowy.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Com a centralização, o áudio espacial soa como se estivesse vindo da TV, mesmo quando você move a cabeça. Se você desativar a centralização, o áudio espacial ainda oferecerá uma experiência de som imersiva, mas não acompanhará o movimento da sua cabeça.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Centrar dá a impressão que o áudio espacial vem da televisão, mesmo quando move a cabeça. Se desativar o centramento, o áudio espacial continua a proporcionar uma experiência sonora imersiva, mas não segue o movimento da sua cabeça.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Centrarea face să pară că sunetul spațial provine de la televizor, chiar dacă mișcați capul. Dacă dezactivați centrarea, sunetul spațial oferă în continuare o experiență audio captivantă, dar nu vă urmărește mișcarea capului.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Когда включено центрирование, пространственное аудио звучит так, будто оно исходит из телевизора, даже если Вы двигаете головой. Когда центрирование выключено, пространственное аудио создает эффект присутствия, но не следует за движениями Вашей головы.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Pri použití centrovania bude priestorový zvuk zdanlivo vychádzať z televízora, dokonca aj pri pohyboch hlavy. Ak centrovanie vypnete, priestorový zvuk bude aj naďalej poskytovať pohlcujúci zvukový zážitok, nebude však sledovať pohyby vašej hlavy.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Pri osredotočenju zvoka se zdi, da prostorski zvok izvira iz televizorja, tudi ko premikate glavo. Če osredotočenje izklopite, prostorski zvok še vedno zagotavlja pristno zvočno izkušnjo, vendar ne sledi premikanju vaše glave.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Centrering får det att låta som om rumsligt ljud kommer från din TV, även om du rör på huvudet. Om du stänger av centrering blir rumsligt ljud fortfarande en omslutande ljudupplevelse, men det följer inte dina huvudrörelser.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ศูนย์กลางเสียงทำให้เสียงเชิงมิติพื้นที่เหมือนมาจากทีวีของคุณแม้ว่าคุณจะเคลื่อนไหวศีรษะก็ตาม ถ้าคุณปิดใช้ศูนย์กลางเสียง เสียงเชิงมิติพื้นที่ยังคงให้ประสบการณ์เสียงสมจริง แต่ไม่ติดตามการเคลื่อนไหวของศีรษะของคุณ",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Ortalamak, kafanızı hareket ettirdiğinizde bile uzamsal sesin TV’nizden geliyor gibi duyulmasını sağlar. Ortalamayı kapatırsanız uzamsal ses sarmalayan bir ses deneyimi sunmaya devam eder ama kafa hareketlerinizi izlemez.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Завдяки центруванню просторове аудіо відтворюється так, немов воно лунає з телевізора, навіть якщо ви рухаєте головою. Якщо вимкнути центрування, просторове аудіо створюватиме ефект присутності, але не відтворюватиметься за рухом вашої голови.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Định tâm làm cho âm thanh không gian giống như xuất phát từ TV của bạn, ngay cả khi đầu của bạn di chuyển. Nếu bạn tắt tính năng định tâm, âm thanh không gian vẫn là trải nghiệm âm thanh siêu chân thực, nhưng không đi theo chuyển động đầu của bạn.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "居中时，即使移动头部，空间音频听起来也像是来自电视。如果关闭居中，空间音频仍将提供沉浸式声音体验，但不会追踪你的头部移动。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "即使你的頭部移動，置中也會讓空間音訊聽起來像是來自你的電視。如果你關閉置中，空間音訊仍會給予你沉浸式聲音體驗，但不會跟隨你的頭部移動。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "即使在你的頭部移動時，置中也可讓空間音訊聽起來像從電視傳來。若你關閉置中，空間音訊仍為沉浸式音效體驗，但不會追蹤你的頭部移動。",
            "state": "translated"
          }
        }
      }
    },
