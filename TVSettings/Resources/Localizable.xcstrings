    "AccountsTapToAddUserGameCenterAccountAlreadyInErrorMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Game Center على جهاز iOS يستخدمه بالفعل مستخدم آخر على هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú altre ja està fent servir el compte del Game Center del dispositiu iOS en aquest Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet používaný na tomto iOS zařízení pro Game Center už je na Apple TV přidružený k jinému uživateli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-kontoen på iOS-enheden bruges allerede af en anden bruger på Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Game Center-Account auf dem iOS-Gerät wird bereits von einer anderen Person auf diesem Apple TV verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός για το Game Center στη συσκευή iOS χρησιμοποιείται ήδη από έναν άλλο χρήστη σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Game Center account on the iOS device is already in use by another user on this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Game Center account on the iOS device is already in use by another user on this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Game Center account on the iOS device is already in use by another user on this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro usuario ya está usando la cuenta de Apple de Game Center del dispositivo iOS en este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Game Center del dispositivo iOS ya se emplea para otro usuario de este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Game Center del dispositivo iOS ya se emplea para otro usuario de este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-laitteessa oleva Game Center -tili on jo muun käyttäjän käytössä tässä Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte Game Center de l’appareil iOS est déjà utilisé par un autre utilisateur sur cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte Game Center sur l’appareil iOS est déjà utilisé par un autre utilisateur sur cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון ה-Game Center במכשיר iOS זה כבר נמצא בשימוש של משתמש נוסף ב-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS डिवाइस पर Game Center खाता इस Apple TV के अन्य यूज़र के द्वारा पहले से उपयोग में है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi korisnik ovog Apple TV-a već koristi račun za Game Center na iOS uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS-eszközön beállított Game Center-fiókot már használja egy másik felhasználó ezen az Apple TV‑n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Game Center di perangkat iOS telah digunakan oleh pengguna lain di Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account Game Center sul dispositivo iOS è già usato da altro utente su questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSデバイスのGame Centerのアカウントは、このApple TVのほかのユーザによってすでに使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자가 이 Apple TV에서 iOS 기기의 Game Center 계정을 이미 사용하고 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun Game Center pada peranti iOS sedang digunakan oleh pengguna lain pada Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-kontoen på denne iOS-enheten brukes allerede av en annen bruker på Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Game Center-account op het iOS-apparaat wordt al door iemand anders op deze Apple TV gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto Game Center z tego urządzenia iOS jest już używane na tym Apple TV przez innego użytkownika."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do Game Center no dispositivo iOS já está sendo usada por outro usuário nesta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do Game Center no dispositivo iOS já está a ser usada por outro utilizador nesta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul de Game Center de pe dispozitivul iOS este deja utilizat de un alt utilizator de pe acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учетная запись, используемая для Game Center на этом устройстве iOS, уже используется другим пользователем на этом Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center účet z tohto iOS zariadenia už na tomto Apple TV používa iný užívateľ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun Game Center v napravi iOS že uporablja drug uporabnik tega Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-kontot på iOS-enheten används redan av en annan användare på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Game Center บนอุปกรณ์ iOS ถูกใช้แล้วโดยผู้ใช้อื่นที่อยู่บน Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS aygıtındaki Game Center hesabı bu Apple TV’deki başka bir kullanıcı tarafından zaten kullanılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис Game Center на пристрої iOS уже використовуються іншим користувачем на цьому Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Game Center trên thiết bị iOS này đã được một người dùng khác sử dụng trên Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV上的其他用户已在使用iOS设备上的Game Center账户。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS裝置上的Game Center帳户已被此Apple TV上的其他用户使用。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS裝置上的Game Center帳號已由此Apple TV上的其他使用者使用中。"
          }
        }
      }
    },
    "AccountsTapToAddUserInstructions_WIFI": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١.\tافتح قفل iPhone أو iPad.\n‏٢.\tاتصل بشبكة Wi-Fi.\n‏٣.\tشغل Bluetooth.\n‏٤.\tقرّب الجهاز من هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueja l’iPhone o l’iPad.\n2.\tConnecta’t a una xarxa Wi‑Fi.\n3.\tActiva el Bluetooth.\n4.\tMantén el dispositiu a prop de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdemkněte iPhone nebo iPad.\n2.\tPřipojte se k Wi‑Fi síti.\n3.\tZapněte Bluetooth.\n4.\tPodržte zařízení u Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås din iPhone eller iPad op.\n2.\tOpret forbindelse til et Wi-Fi-netværk.\n3.\tSlå Bluetooth til.\n4.\tHold enheden tæt på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tEntsperre dein iPhone oder iPad.\n2.\tStelle eine WLAN-Verbindung her.\n3.\tAktiviere Bluetooth.\n4.\tHalte das Gerät dicht an das Apple TV."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tΞεκλειδώστε το iPhone ή το iPad σας.\n2.\tΣυνδεθείτε σε δίκτυο Wi-Fi.\n3.\tΕνεργοποιήστε το Bluetooth.\n4.\tΚρατήστε τη συσκευή κοντά σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi‑Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tAvaa iPhonesi tai iPadisi.\n2.\tYhdistä Wi‑Fi-verkkoon.\n3.\tLaita Bluetooth päälle.\n4.\tPidä laitetta Apple TV:n lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tConnectez-vous à un réseau Wi-Fi.\n3.\tActivez le Bluetooth.\n4.\tPlacez l’appareil près de cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tConnectez l’appareil à un réseau Wi‑Fi.\n3.\tActivez Bluetooth.\n4.\tTenez l’appareil à proximité de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tיש לבטל את נעילת ה-iPhone או ה-iPad.\n‏2.\tיש להתחבר לרשת אלחוטית.\n‏3.\tיש להפעיל את Bluetooth.\n‏4.\tיש להחזיק את המכשיר קרוב ל-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tअपना iPhone या iPad अनलॉक करें।\n2.\tकिसी वाई-फ़ाई नेटवर्क से जुड़ें।\n3.\tBluetooth चालू करें।\n4.\tडिवाइस को इस Apple TV के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOtključajte svoj iPhone ili iPad.\n2.\tSpojite se na Wi-Fi mrežu.\n3.\tUključite Bluetooth.\n4.\tDržite uređaj blizu ovog Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOldja fel az iPhone-ját vagy az iPadjét.\n2.\tCsatlakozzon Wi‑Fi-hálózathoz.\n3.\tKapcsolja be a Bluetootht.\n4.\tTartsa közel az eszközt az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka iPhone atau iPad Anda.\n2.\tHubungkan ke jaringan Wi-Fi.\n3.\tNyalakan Bluetooth.\n4.\tDekatkan perangkat ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tSblocca iPhone o iPad.\n2.\tConnettiti a una rete Wi‑Fi.\n3.\tAttiva il Bluetooth.\n4.\tAvvicina il dispositivo ad Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhoneまたはiPadをロック解除します。\n2.\tWi‑Fiネットワークに接続します。\n3.\tBluetoothをオンにします。\n4.\tデバイスをこのApple TVに近付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone 또는 iPad를 잠금 해제하십시오.\n2.\tWi-Fi 네트워크에 연결하십시오.\n3.\tBluetooth를 켜십시오.\n4.\t해당 기기를 이 Apple TV 가까이 들고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka kunci iPhone atau iPad anda.\n2.\tSambung ke rangkaian Wi‑Fi.\n3.\tAktifkan Bluetooth.\n4.\tPegang peranti berdekatan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås opp iPhonen eller iPaden.\n2.\tKoble til et Wi‑Fi-nettverk.\n3.\tSlå på Bluetooth.\n4.\tHold enheten nær Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOntgrendel je iPhone of iPad.\n2.\tMaak verbinding met een wifinetwerk.\n3.\tSchakel Bluetooth in.\n4.\tHoud het apparaat dicht bij deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdblokuj swojego iPhone’a lub iPada.\n2.\tPołącz się z siecią Wi‑Fi.\n3.\tWłącz Bluetooth.\n4.\tZbliż urządzenie do Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o seu iPhone ou iPad.\n2.\tConecte-se a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tAproxime o dispositivo desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o iPhone ou iPad.\n2.\tEstabeleça ligação a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tMantenha o dispositivo perto desta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDeblocați‑vă iPhone‑ul sau iPad‑ul.\n2.\tConectați‑l la o rețea Wi‑Fi.\n3.\tActivați Bluetooth.\n4.\tȚineți dispozitivul aproape de acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tРазблокируйте свой iPhone или iPad.\n2.\tПодключитесь к сети Wi‑Fi.\n3.\tВключите Bluetooth.\n4.\tДержите устройство вблизи этого Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdomknite svoj iPhone alebo iPad.\n2.\tPripojte sa k Wi‑Fi sieti.\n3.\tZapnite Bluetooth.\n4.\tPodržte zariadenie pri Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdklenite svoj iPhone ali iPad.\n2.\tPovežite se z omrežjem Wi-Fi.\n3.\tVklopite Bluetooth.\n4.\tPribližajte napravo Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås upp iPhone eller iPad.\n2.\tAnslut till Wi-Fi-nätverk.\n3.\tSlå på Bluetooth.\n4.\tHåll enheten nära denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tปลดล็อค iPhone หรือ iPad ของคุณ\n2.\tเชื่อมต่อกับเครือข่าย Wi‑Fi\n3.\tเปิดบลูทูธ\n4.\tถืออุปกรณ์ไว้ใกล้กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone’unuzun ya da iPad’inizin kilidini açın.\n2.\tBir Wi-Fi ağına bağlanın.\n3.\tBluetooth’u açın.\n4.\tAygıtı bu Apple TV’ye yakın tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tВідімкніть свій iPhone чи iPad.\n2.\tПідʼєднайте пристрій до мережі Wi‑Fi.\n3.\tУвімкніть Bluetooth.\n4.\tПіднесіть пристрій до цього Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tMở khóa iPhone hoặc iPad của bạn.\n2.\tKết nối vào mạng Wi-Fi.\n3.\tBật Bluetooth.\n4.\tGiữ thiết bị gần Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解锁你的iPhone或iPad。\n2.\t接入Wi-Fi网络。\n3.\t打开蓝牙。\n4.\t将设备靠近此Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t連接Wi-Fi網絡。\n3.\t開啟藍牙。\n4.\t將裝置靠近此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t連接Wi-Fi網路。\n3.\t開啟藍牙。\n4.\t將裝置靠近此Apple TV。"
          }
        }
      }
    },
