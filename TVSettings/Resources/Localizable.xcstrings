            "state": "translated",
            "value": "Si sabes la máscara de subred, introdúcela y selecciona OK."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sabes tu máscara de subred, ingrésala y selecciona Listo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sabes tu máscara de subred, ingrésala y selecciona Listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tiedät aliverkon peitteen, syötä se ja valitse OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous connaissez votre masque de sous-réseau, saisissez-le puis sélectionnez OK."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous connaissez votre masque de sous-réseau, entrez-le puis sélectionnez OK."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ידועה לך מסכת תת-הרשת שלך, יש להזין אותה ולבחור ב״אישור״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको अपना सबनेट मास्क पता है, तो उसे दर्ज करें और “पूर्ण” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako znate vašu masku podmreže, unesite je pa odaberite Gotovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha tudja az alhálózati maszkot, adja meg, majd válassza a Kész lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mengetahui subnet mask Anda, masukkan dan pilih Selesai."
