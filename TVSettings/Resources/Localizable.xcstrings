    "iCloudPhotoSyncingAlertDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء مزامنة الصور، ستعرض شاشة التوقف صورًا جوية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre se sincronitzin les fotos, es mostraran les vistes aèries a l’estalvi de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spořič obrazovky bude během synchronizace fotek zobrazovat letecké záběry."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmskåneren viser luftfotos, mens dine fotos synkroniseres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Synchronisation der Fotos zeigt der Bildschirmschoner Luftaufnahmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προφύλαξη οθόνης θα εμφανίζει αεροβίντεο κατά τον συγχρονισμό των φωτογραφιών σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While your photos are syncing, the screen saver will display Aerials."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "While your photos are syncing, the screen saver will display Aerials."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "While your photos are syncing, the screen saver will display Aerials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se sincronizan tus fotos, el salvapantallas mostrará vistas aéreas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se estén sincronizando tus fotos, el protector de pantalla mostrará vistas aéreas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se estén sincronizando tus fotos, el protector de pantalla mostrará vistas aéreas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kuvia synkronoidaan, näytönsäästäjä näyttää ilmakuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran affichera des vues aériennes pendant la synchronisation de vos photos."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran affichera des vues aériennes tant que vos photos seront en cours de synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במהלך סנכרון התמונות, שומר המסך יציג צילומים אוויריים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी तस्वीरें सिंक हो रही हों, तो स्क्रीन सेवर एरियल दिखाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok se vaše fotografije sinkroniziraju, zaštita zaslona prikazivat će zračne snimke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a fotói szinkronizálódnak, a képernyővédő légi felvételeket fog megjeleníteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat foto Anda sedang diselaraskan, penghemat layar akan menampilkan Aerial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la sincronizzazione delle foto, il salvaschermo mostrerà le viste aeree."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を同期している間、スクリーンセーバには“空撮”が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 동기화되는 동안 화면 보호기에 항공 사진이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa foto anda diselaraskan, penyelamat skrin akan memaparkan Tema Udara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermspareren vil vise luftfoto mens bildene dine synkroniseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het synchroniseren van je foto's wordt de schermbeveiliging 'In vogelvlucht' weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trakcie synchronizowania zdjęć używany jest wygaszacz ekranu Z lotu ptaka."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a sincronização das fotos, o protetor de tela exibirá vistas Aéreas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a sincronização das fotografias, serão apresentadas vistas aéreas na proteção de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timpul sincronizării pozelor, screensaverul va afișa vederi aeriene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока фото синхронизируются, на телевизоре будут отображаться аэрозаставки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas synchronizácie fotiek bude šetrič obrazovky zobrazovať letecké zábery."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medtem ko se fotografije sinhronizirajo, bo ohranjevalnik zaslona prikazoval posnetke iz zraka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmsläckaren visar flygfoton medan dina bilder synkroniseras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในระหว่างที่รูปภาพของคุณกำลังเชื่อมข้อมูลอยู่ ภาพพักหน้าจอจะแสดงภาพมุมสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınız eşzamanlanırken ekran koruyucu havadan öğeleri görüntüler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки фотографії синхронізуються, заставка показуватиме види з повітря."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong khi ảnh của bạn đang đồng bộ hóa, trình bảo vệ màn hình sẽ hiển thị Không trung."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "同步照片时，屏幕保护程序将显示航拍。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "相片同步期間，螢幕保護程式將會顯示「航拍」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的照片同步期間，螢幕保護程式會顯示「空照圖」。"
          }
        }
      }
    },
