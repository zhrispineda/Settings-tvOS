            "value": "Apple TV’niz, Dolby Atmos da dahil olmak üzere\nen iyi ses biçimini otomatik olarak kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV автоматично застосовує найкращий \nіз наявних форматів звуку, зокрема Dolby Atmos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn tự động sử dụng định dạng âm thanh\ntốt nhất có sẵn, bao gồm Dolby Atmos."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV会自动使用可用的最佳音频格式，\n包括杜比全景声。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會自動使用可用的最佳音訊格式，\n包括杜比全景聲。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會自動使用最佳的音訊格式，\n包含杜比全景聲。"
          }
        }
      }
    },
