          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A utilização de “%@” pode afetar a conectividade WLAN e Bluetooth. Encontrará informação adicional em https://support.apple.com/tv/bluetooth."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizarea „%@” poate afecta conectivitatea WLAN și Bluetooth. Vizitați https://support.apple.com/tv/bluetooth pentru informații suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование устройства «%@» может повлиять на подключение к WLAN и Bluetooth. Подробнее: https://support.apple.com/tv/bluetooth."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používanie „%@“ môže negatívne ovplyvniť WLAN a Bluetooth pripojenie. Viac informácií nájdete na stránke https://support.apple.com/tv/bluetooth."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba naprave %@ lahko vpliva na povezljivost WLAN in Bluetooth. Obiščite https://support.apple.com/tv/bluetooth za več informacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du använder ”%@” kan det påverka WLAN- och Bluetooth-anslutningar. Besök https://support.apple.com/tv/bluetooth för mer information."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้ “%@” อาจมีผลต่อการเชื่อมต่อกับ WLAN และบลูทูธ ให้ไปที่ https://support.apple.com/tv/bluetooth สำหรับข้อมูลเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” aksesuarını kullanmak WLAN ve Bluetooth bağlantılarını etkileyebilir. Daha fazla bilgi için https://support.apple.com/tv/bluetooth adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання «%@» може вплинути на якість зʼєднання через WLAN чи Bluetooth. Додаткову інформацію наведено на вебсторінці https://support.apple.com/tv/bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc sử dụng “%@” có thể ảnh hưởng đến khả năng kết nối WLAN và Bluetooth. Hãy truy cập https://support.apple.com/tv/bluetooth để biết thêm thông tin."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“%@”可能会影响无线局域网和蓝牙连接性。若要了解更多信息，请访问https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「%@」可能會影響WLAN和藍牙的連線能力。詳情請到訪：https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「%@」可能會影響WLAN和藍牙的連線。請參訪https://support.apple.com/tv/bluetooth以取得更多資訊。"
          }
        }
      }
    },
