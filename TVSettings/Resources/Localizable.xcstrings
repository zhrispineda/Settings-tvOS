    "OSUpdateCancelText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إلغاء هذا التحديث؟ إذا قمت بالإلغاء الآن، يمكنك التحقق من وجود تحديث لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols cancel·lar aquesta actualització? Si cancel·les ara, podràs comprovar si hi ha actualitzacions més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete tuto aktualizaci zrušit? Pokud ji nyní zrušíte, můžete vyhledat aktualizace později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil annullere opdateringen? Hvis du annullerer nu, kan du søge efter en opdatering senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll dieses Update wirklich abgebrochen werden? Du kannst dann später nach Updates suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να ακυρώσετε αυτήν την ενημέρωση; Αν την ακυρώσετε τώρα, μπορείτε να ελέγξετε για διαθέσιμες ενημερώσεις αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this update? If you cancel now, you can check for an update later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this update? If you cancel now, you can check for an update later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this update? If you cancel now, you can check for an update later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres cancelar esta actualización? Si cancelas el proceso ahora, podrás buscar actualizaciones más tarde."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cancelar esta actualización? Si cancelas el proceso ahora, podrás buscar actualizaciones más tarde."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cancelar esta actualización? Si cancelas el proceso ahora, podrás buscar actualizaciones más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumotaanko päivitys? Jos lopetat nyt, voit tarkistaa päivitykset myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment annuler cette mise à jour ? Si vous annulez, vous pourrez vérifier les mises à jour plus tard."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment annuler cette mise à jour? Si vous annulez, vous pourrez vérifier les mises à jour plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך לבטל עדכון זה? אם בחרת לבטל, יהיה באפשרותך לבדוק אם קיים עדכון במועד מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निश्चित हैं कि आप इस अपडेट को रद्द करना चाहते हैं? यदि आप इसे अभी रद्द कर भी देते हैं, तो बाद में फिर अपडेट की जाँच कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurno želite poništiti ovo ažuriranje? Poništite li sada, možete potražiti ažuriranje kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan megszakítja a frissítést? Ha most megszakítja, később is kereshet frissítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin membatalkan pembaruan ini? Jika Anda membatalkannya saat ini, Anda dapat memeriksa pembaruan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi di voler annullare l’aggiornamento? Potrai verificare in seguito la presenza di aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップデートをキャンセルしますか? キャンセルしても、アップデートはあとで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업데이트를 취소하겠습니까? 지금 취소하면, 나중에 업데이트를 확인할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu membatalkan kemas kini ini? Jika anda membatalkan sekarang, anda boleh menyemak kemas kini kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil avbryte denne oppdateringen? Hvis du avbryter nå, kan du søke etter oppdateringer senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze update wilt annuleren? Als je nu annuleert, kun je later alsnog naar updates zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz anulować to uaktualnienie? Jeśli anulujesz teraz, możesz sprawdzić dostępność uaktualnień później."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja cancelar esta atualização? Se você cancelar agora, será possível buscar uma atualização mais tarde."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende cancelar esta atualização? Se cancelar agora, pode voltar a procurar atualizações mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți să anulați această actualizare? Dacă anulați acum, puteți căuta o actualizare mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить обновление? Вы сможете снова проверить наличие обновлений позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete zrušiť aktualizáciu? Ak ju zrušíte teraz, môžete vyhľadať aktualizácie neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste prepričani, da želite preklicati to posodobitev? Če prekličete zdaj, lahko pozneje preverite, ali je na voljo posodobitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill avbryta den här uppdateringen? Om du avbryter nu kan du leta efter en uppdatering senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าคุณต้องการยกเลิกรายการอัปเดตนี้ ถ้าคุณยกเลิกตอนนี้ คุณสามารถตรวจสอบรายการอัปเดตได้ในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güncellemeden vazgeçmek istediğinizden emin misiniz? Şimdi vazgeçerseniz, daha sonra güncelleme olup olmadığını denetleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати це оновлення? Якщо його скасувати зараз, виконати оновлення можна пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn hủy bản cập nhật này không? Nếu bạn hủy bây giờ, bạn có thể kiểm tra bản cập nhật sau này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要取消此更新项目吗？若现在取消，你可稍后再检查更新项目。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要取消此更新項目嗎？如現在取消，你可稍後再檢查更新項目。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要取消此更新項目嗎？若現在取消，你可稍後再檢查更新項目。"
          }
        }
      }
    },
    "OSUpdateCheckLoginDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن اسم المستخدم وكلمة السر بإمكانهما تسجيل الدخول إلى AppleConnect بنجاح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que el compte i la contrasenya puguin iniciar sessió correctament a l’AppleConnect."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte, zda se můžete pomocí tohoto účtu a hesla připojit ke službě AppleConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft, at konto og adgangskode kan bruges til at logge ind på AppleConnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log into AppleConnect."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθεύστε ότι είναι δυνατή η επιτυχής είσοδος στο AppleConnect με τον λογαριασμό και το συνθηματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log into AppleConnect."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log into AppleConnect."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log in to AppleConnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que puedes iniciar sesión correctamente en AppleConnect con la cuenta y su contraseña."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que puedas iniciar sesión en AppleConnect con la cuenta y la contraseña."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que puedas iniciar sesión en AppleConnect con la cuenta y la contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log into AppleConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le compte et le mot de passe saisis permettent de se connecter à AppleConnect."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le compte et le mot de passe vous permettent de vous connecter à AppleConnect."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שניתן להתחבר ל-AppleConnect עם החשבון והסיסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित करें कि इस खाता और पासवर्ड से AppleConnect में सफलतापूर्वक लॉगइन किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite mogu li se račun i lozinka uspješno prijaviti na AppleConnect."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze, hogy be tud-e jelentkezni a fiókkal és jelszóval az AppleConnectbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi bahwa akun dan kata sandi dapat berhasil masuk ke AppleConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica di poter eseguire correttamente l’accesso su AppleConnect tramite la password e i dati associati al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントとパスワードで正しくAppleConnectにログインできるか検証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 계정 및 암호로 AppleConnect에 로그인할 수 있는지 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan bahawa akaun dan kata laluan boleh berjaya log masuk ke AppleConnect."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiser at kontoen og passordet kan brukes til å logge på AppleConnect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer dat je met de account en het wachtwoord kunt inloggen bij AppleConnect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the account and password can successfully log into AppleConnect."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se a conta e a senha podem iniciar uma sessão no AppleConnect com sucesso."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que a conta e palavra‑passe são válidas para iniciar sessão em AppleConnect."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați dacă puteți efectua login la AppleConnect folosind contul și parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, можно ли войти в AppleConnect, используя данные учетную запись и пароль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte, či sa pomocou účtu a hesla dokážete prihlásiť do služby AppleConnect."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite, da se lahko z računom in geslom uspešno prijavite v AppleConnect."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att det går att logga in på AppleConnect med kontot och lösenordet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบยืนยันว่าคุณสามารถใช้บัญชีและรหัสผ่านเพื่อเข้าสู่ระบบ AppleConnect ได้สำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve parolanın AppleConnect’te başarıyla oturum açabildiğinden emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте, що обліковий запис і пароль приймаються для входу в AppleConnect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh rằng tài khoản và mật khẩu có thể đăng nhập thành công vào AppleConnect."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "验证账户和密码可成功登录AppleConnect。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證此帳户和密碼能夠成功登入AppleConnect。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證帳號和密碼能正確登入AppleConnect。"
          }
        }
      }
    },
