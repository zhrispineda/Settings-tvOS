    "HomeKitUnlockSecureAccessoriesAppleTVRemotesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم في الملحقات الأمنية باستخدام الريموتات والأجهزة الشخصية المقترنة التي تدعم Bluetooth، مثل أجهزة iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla els accessoris de seguretat amb els comandaments Bluetooth enllaçats i dispositius personals com ara l’iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní příslušenství bude možné ovládat spárovanými Bluetooth ovladači a osobními zařízeními, například iPhony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betjen sikkerhedstilbehør med parrede Bluetooth-fjernbetjeninger og personlige enheder, f.eks. en iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere Sicherheitszubehör mit gekoppelten Bluetooth-Fernbedienungen und persönlichen Geräten wie iPhones."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειριστείτε αξεσουάρ ασφαλείας με ζευγοποιημένα τηλεχειριστήρια Bluetooth και προσωπικές συσκευές, π.χ. iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with paired Bluetooth remotes and personal devices like iPhones."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with paired Bluetooth remotes and personal devices like iPhones."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with paired Bluetooth remotes and personal devices like your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los accesorios de seguridad con mandos a distancia Bluetooth enlazados y dispositivos personales, como el iPhone."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla tus accesorios de seguridad mediante controles remotos Bluetooth y dispositivos personales, como tu iPhone."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla tus accesorios de seguridad mediante controles remotos Bluetooth y dispositivos personales, como tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa turvalisälaitteita pariksi liitetyillä Bluetooth-kaukosäätimillä ja henkilökohtaisilla laitteilla, kuten iPhonella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez les accessoires de sécurité avec les télécommandes Bluetooth jumelées et les appareils personnels, comme les iPhone."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez les accessoires de sécurité avec les télécommandes Bluetooth jumelées et des appareils personnels, comme les iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשלוט באביזרי אבטחה באמצעות שלטי Bluetooth מקושרים ומכשירים אישיים כמו מכשירי iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा ऐक्सेसरी को पेयर किए गए Bluetooth रिमोट और iPhone जैसे व्यक्तिगत डिवाइस से नियंत्रित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljajte sigurnosnim priborima pomoću uparenih Bluetooth upravljača i osobnih uređaja poput iPhonea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonsági kiegészítőket vezérelhet párosított Bluetooth-távirányítókkal és személyes eszközökkel, például iPhone-okkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol aksesori keamanan dengan remote Bluetooth yang dipasangkan atau perangkat pribadi seperti iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli accessori di sicurezza con i telecomandi Bluetooth abbinati e i dispositivi personali come iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングされたBluetoothリモコンやiPhoneなどの個人用デバイスでセキュリティアクセサリをコントロールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Bluetooth 리모컨 및 iPhone 등의 개인 기기로 보안 액세서리를 제어할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawal aksesori keselamatan dengan kawalan jauh Bluetooth berpasangan dan peranti peribadi seperti iPhone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr sikkerhetstilbehør med sammenkoblede Bluetooth-fjernkontroller og personlige enheter som iPhoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedien beveiligingsaccessoires met via Bluetooth gekoppelde afstands­bedieningen en persoon­lijke apparaten zoals iPhones."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcesoriami systemu zabezpieczeń możesz sterować przy użyciu pilotów połączonych w parę przez Bluetooth oraz urządzeń osobistych, na przykład iPhone’a."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle acessórios de segurança com controles remotos Bluetooth emparelhados e dispositivos pessoais, como iPhones."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlar os acessórios de segurança com comandos Bluetooth emparelhados e dispositivos pessoais como iPhones."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlați accesoriile de securitate cu telecomenzi Bluetooth asociate și dispozitive personale, precum iPhone‑uri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте системами защиты дома с объединенных в пару пультов Bluetooth и своих личных устройств, таких как iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostné príslušenstvo bude možné ovládať pomocou spárovaných Bluetooth ovládačov a osobných zariadení, napríklad iPhonov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostno dodatno opremo lahko upravljate s seznanjenim daljincem Bluetooth ali z osebnimi napravami, kot je iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr säkerhetstillbehör med parkopplade Bluetooth-fjärrkontroller och personliga enheter som iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมอุปกรณ์เสริมความปลอดภัยด้วยรีโมทบลูทูธและอุปกรณ์ส่วนบุคคลที่จับคู่ด้วย เช่น iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik aksesuarlarını, eşlenmiş Bluetooth kumandaları ve iPhone gibi kişisel aygıtlar ile denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте приладами безпеки зі спарених Bluetooth-пультів та особистих пристроїв, як‑от iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển các phụ kiện an ninh bằng điều khiển từ xa Bluetooth được ghép đôi và các thiết bị cá nhân như iPhone."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用配对的蓝牙遥控器和iPhone等个人设备来控制安全配件。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通過已配對的藍牙遙控器和個人裝置（如iPhone）控制保安配件。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過配對的藍牙遙控器和iPhone等個人裝置來控制安全性配件。"
          }
        }
      }
    },
