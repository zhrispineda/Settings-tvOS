        },
        "fr": {
          "stringUnit": {
            "value": "Le volume des contenus multimédias et des appels restera au même niveau pendant l’énonciation de VoiceOver.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Le volume du contenu multimédia et des appels ne variera pas pendant l’énonciation de VoiceOver.",
