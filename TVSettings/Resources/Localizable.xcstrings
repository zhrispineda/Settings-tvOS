    "SaverBackdropRefreshDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معدل التنزيل الذي تريده لتنزيل الصور الجوية الجديدة. حجم الفيديوهات يبلغ في المتوسط أقل من ١ غيغابايت، ولكن يمكن أن يكون أكبر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria la freqüència amb què vulguis descarregar les vistes aèries noves. De mitjana, els vídeos no superen 1 GB, però alguns poden ser més grans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak často chcete stahovat nové letecké záběry. Videa mají v průměru méně než 1 GB, ale můžou být i větší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor ofte nye luftfotos hentes. Videoer er i gennemsnit mindre end 1 GB, men kan være større."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, wie oft neue Luftaufnahmen geladen werden sollen. Videos sind im Durchschnitt kleiner als 1 GB, können aber größer sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πόσο συχνά επιθυμείτε τη λήψη νέων αεροβίντεο. Η μέση χωρητικότητα των βίντεο είναι κάτω από 1 GB, ωστόσο μπορεί να είναι και μεγαλύτερη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want to download new Aerials. Videos are less than 1 GB on average, but can be larger."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want to download new Aerials. Videos are less than 1 GB on average, but can be larger."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often you want to download new Aerials. Videos are less than 1 GB on average, but can be larger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige con qué frecuencia quieres descargar nuevas vistas aéreas. Los vídeos suelen ocupar menos de 1 GB, pero quizá superen ese tamaño."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué tan seguido quieres descargar nuevas vistas aéreas. Los videos ocupan generalmente menos de 1 GB de espacio, aunque podrían requerir más."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué tan seguido quieres descargar nuevas vistas aéreas. Los videos ocupan generalmente menos de 1 GB de espacio, aunque podrían requerir más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, kuinka usein haluat ladata uusia ilmakuvia. Videot ovat keskimäärin alle 1 Gt:n kokoisia, mutta ne voivat olla suurempia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la fréquence à laquelle vous souhaitez télécharger de nouvelles vues aériennes. Les vidéos font en moyenne moins de 1 Go, mais peuvent être plus volumineuses."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la fréquence à laquelle vous voulez télécharger les nouvelles vues aériennes. Les vidéos ont une taille moyenne inférieure à 1 Go, mais peuvent être plus volumineuses."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את תדירות ההורדה של צילומי אוויר חדשים. גודל הסרטונים אינו עולה בדרך כלל על 1 ג״ב בממוצע, אך יכול להיות גדול יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि नए एरियल कितनी जल्दी-जल्दी डाउनलोड करना चाहते हैं। औसतन वीडियो 1 GB से कम होते हैं, लेकिन इससे बड़े भी हो सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koliko često želite preuzimati nove zračne snimke. Videozapisi su prosječno manji od 1 GB, ali mogu biti veći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, hogy milyen gyakran szeretne letölteni új légi felvételeket. A videók mérete átlagosan 1 GB alatt van, azonban nagyobb is lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih seberapa sering Anda ingin mengunduh Aerial baru. Video kurang dari rerata 1 GB, tapi bisa lebih besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli con che frequenza vuoi scaricare nuove viste aeree. I video sono in media inferiori a 1 GB, ma possono essere più grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのくらいの頻度で新しい空撮をダウンロードするかを選択してください。ビデオのサイズは平均して1GB未満ですが、それより大きい場合もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 항공 사진을 다운로드할 빈도를 선택하십시오. 비디오는 평균 1GB 미만이지만, 더 클 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kekerapan anda mahu memuat turun Tema Udara baharu. Video kurang daripada 1 GB secara purata, tetapi boleh menjadi lebih besar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor ofte du vil laste ned nye luftfoto. Videoer er i gjennom­snitt mindre enn 1 GB, men de kan være større."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal hoe vaak je nieuwe 'In vogelvlucht'-beelden wilt downloaden. Video's zijn gemiddeld kleiner dan 1 GB, maar kunnen groter zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak często chcesz pobierać nowe wygaszacze Z lotu ptaka. Pliki wideo średnio mają mniej niż 1 GB, ale mogą być większe."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha com que frequência você deseja baixar novos Aéreos. Os vídeos têm menos de 1 GB em média, mas podem ser maiores."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione com que regularidade devem ser descarregadas novas vistas aéreas. Os vídeos ocupam, em média, menos de 1 GB, mas podem ser maiores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți cât de frecvent doriți să descărcați vederi aeriene noi. Clipurile video au în medie mai puțin de 1 GB, dar pot fi mai mari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как часто будут загружаться новые аэрозаставки. Обычно размер видео не превышает 1 ГБ, но иногда может быть и больше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, ako často sa majú sťahovať nové letecké zábery. Videá majú zvyčajne menej ako 1 GB, môžu však byť väčšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, kako pogosto naj se prenesejo novi posnetki iz zraka. Povprečna velikost videov je manj kot 1 GB, videi pa so lahko tudi večji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur ofta du vill hämta nya flygfoton. Videor är i genomsnitt mindre än 1 GB, men kan vara större."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าคุณต้องการให้ดาวน์โหลดภาพมุมสูงใหม่บ่อยแค่ไหน โดยเฉลี่ยแล้ววิดีโอมีขนาดน้อยกว่า 1 GB แต่สามารถมีขนาดใหญ่กว่านี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni havadan öğeleri hangi sıklıkta indirmek istediğinizi seçin. Videolar ortalama 1 GB’tan küçüktür ama daha büyük de olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, як часто викачувати нові види з повітря. Розмір відео становить в середньому менше 1 ГБ, але може бути й більше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tần suất mà bạn muốn tải về video Không trung mới. Kích cỡ video trung bình dưới 1 GB nhưng có thể lớn hơn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取新航拍的下载频率。视频平均不到1 GB，但可能更大。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你要下載新「航拍」的頻率。影片平均小於1 GB，但可能會更大。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇下載新空照圖的頻率。影片平均小於1 GB，但可能會更大。"
          }
        }
      }
    },
