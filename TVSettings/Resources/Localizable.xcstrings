    "iTMSHDPreviewsOnDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستكون المعاينات بالدقة العالية، عند توفرها. يوصى بهذا الإعداد عندما يكون اتصال الإنترنت سريعًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les previsualitzacions seran en alta definició, si està disponible. És l’opció recomanada si la connexió a internet és ràpida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázky se budou přehrávat ve vysoké kvalitě (bude‑li dostupná). Toto nastavení je vhodné pro rychlé připojení k internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det er tilgængeligt, vil eksempler være i HD-format. Denne indstilling anbefales til en hurtig internetforbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschauwiedergabe erfolgt im HD-Format (wenn verfügbar). Diese Einstellung wird für schnelle Internetverbindungen empfohlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν διατίθεται αυτή η επιλογή, οι προεπισκοπήσεις θα αναπαράγονται σε Υψηλή ευκρίνεια (HD). Αυτή η ρύθμιση συνιστάται αν είναι γρήγορη η ταχύτητα σύνδεσής σας στο Διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If available, previews will be in High Definition. This setting is recommended for a fast internet connection."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If available, previews will be in High Definition. This setting is recommended for a fast internet connection."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If available, previews will be in High Definition. This setting is recommended for a fast internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las previsualizaciones se verán en alta definición, si está disponible. Este es el ajuste recomendado para conexiones a internet de alta velocidad."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si están disponibles, los avances se muestran en alta definición. Se recomienda esta configuración si tienes una conexión a Internet de alta velocidad."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si están disponibles, los avances se muestran en alta definición. Se recomienda esta configuración si tienes una conexión a Internet de alta velocidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos saatavilla, esikatselut toistetaan teräväpiirtona. Tätä asetusta suositellaan nopealle internet-yhteydelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits seront en haute définition (si disponible). Ce réglage est recommandé pour les connexions Internet rapides."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus seront affichés en haute définition dans la mesure du possible. Ce réglage est recommandé si votre connexion Internet est rapide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגות מקדימות, כאשר הן זמינות, יוצגו באיכות HD. הגדרה זו מומלצת במקרה של חיבורי אינטרנט מהירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि उपलब्ध हो, तो प्रीव्यू हाई डेफ़िनिशन वाले होंगे। यह सेटिंग तेज़ गति वाले इंटरनेट कनेक्शन के लिए अनुशंसित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledi će biti u visokoj definiciji ako je dostupna. Ovo podešenje preporučeno je za brzu internetsku vezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézetek nagy felbontásban fognak megjelenni, ha az elérhető. Ez a beállítás gyors internetkapcsolat esetén javasolt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tersedia, pratinjau akan berformat Definisi Tinggi. Pengaturan ini dianjurkan untuk koneksi internet cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponibili, le anteprime verranno riprodotte in alta definizione. L’opzione è consigliata per connessioni a internet veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューがHD解像度になります（この解像度が用意されている場合）。この設定はインターネットの接続速度が速い場合に推奨されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 경우 미리보기가 고화질(HD)로 재생됩니다. 이 설정은 인터넷 연결 속도가 빠른 경우에 권장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tersedia, pratonton akan disediakan dalam Definisi Tinggi. Seting ini disyorkan untuk sambungan internet yang laju."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisninger vises i høy oppløsning hvis tilgjengelig. Innstillingen anbefales for raske internettforbindelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorvertoningen worden afgespeeld in HD, indien beschikbaar. Deze instelling wordt aangeraden voor een snelle internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądy są odtwarzane w rozdzielczości HD (jeśli jest dostępna). To ustawienie jest zalecane, jeśli masz szybkie połączenie z Internetem."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponíveis, as pré-visualizações serão em Alta Definição. Este ajuste é recomendado para uma conexão rápida à internet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que HD esteja disponível, os excertos serão reproduzidos nesta definição. A definição HD é recomendada para uma ligação rápida à internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În funcție de disponibilitate, previzualizările vor avea definiție înaltă. Această configurare este recomandată pentru o conexiune rapidă la internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По мере возможности предпросмотр контента будет воспроизводиться в формате HD. Этот вариант рекомендуется для быстрого интернет-соединения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážky budú vo vysokom rozlíšení, pokiaľ je dostupné. Toto nastavenie sa odporúča pre rýchle internetové pripojenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predogledi bodo v visoki ločljivosti, če je na voljo. Ta nastavitev je priporočljiva za hitre internetne povezave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsvisningar visas i HD-upplösning om tillgängligt. Den här inställningen rekommenderas med en snabb internetanslutning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงตัวอย่างจะเล่นในแบบความละเอียดสูงหากมี แนะนำให้ใช้การตั้งค่านี้สำหรับการเชื่อมต่อกับอินเทอร์เน็ตความเร็วสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsa önizlemeler Yüksek Çözünürlük’te gösterilir. Bu ayar, hızlı bir internet bağlantısı için önerilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передогляди відтворюватимуться у високій чіткості, якщо це можливо. Рекомендовано для швидкого інтернет-зʼєднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có sẵn, bản xem trước sẽ có định dạng Độ nét cao. Cài đặt này được đề xuất cho kết nối internet nhanh."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可用时，将以高清晰度预览。推荐互联网连接较快时使用此设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽會使用高清畫質播放（如適用）。如果使用高速互聯網連線，建議使用此設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若可用，預覽將會以高畫質格式顯示。此設定適用於高速網際網路連線。"
          }
        }
      }
    },
