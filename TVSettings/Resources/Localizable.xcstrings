    "UserInterfaceStyleDetailedDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد \"داكن\" أو \"فاتح\" لتغيير مظهر الخلفيات والقوائم. وحدد \"تلقائي\" لتغيير المظهر إلى \"داكن\" ليلاً، و\"فاتح\" نهارًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona “Clar” o “Fosc” per canviar l’aspecte dels fons i dels menús. Selecciona “Automàtic” perquè l’aspecte canviï automàticament i s’enfosqueixi durant la nit i s’aclareixi durant el dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li změnit vzhled pozadí a nabídek, vyberte Světlý nebo Tmavý. Volbou Automaticky nastavíte tmavý vzhled v noci a světlý ve dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Lys eller Mørk for at ændre udseende på baggrunde og menuer. Vælg Automatisk for at ændre indstillingen af udseende til Mørk om aftenen og Lys om dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Hell“ oder „Dunkel“, um das Erscheinungsbild für Hintergründe und Menüs zu ändern. Wähle „Automatisch“, um nachts „Dunkel“ und tagsüber „Hell“ zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «Ανοιχτόχρωμη» ή «Σκούρα» για να αλλάξετε την εμφάνιση των φόντων και των μενού. Επιλέξτε «Αυτόματα» για να αλλάξετε την εμφάνιση σε «Σκούρα» τις βραδινές ώρες και σε «Ανοιχτόχρωμη» κατά τη διάρκεια της ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Light or Dark to change the appearance of backgrounds and menus. Select Automatic to change the appearance to Dark at night, and Light during the day."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Light or Dark to change the appearance of backgrounds and menus. Select Automatic to change the appearance to Dark at night and Light during the day."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Light or Dark to change the appearance of backgrounds and menus. Select Automatic to change the appearance to Dark at night and Light during the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Claro u Oscuro para cambiar el aspecto de los fondos y los menús. Selecciona Automático para que el ajuste de aspecto cambie a Oscuro por la noche y a Claro durante el día."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Claro u Obscuro para cambiar el aspecto de los fondos y menús. Selecciona Automático para cambiar el aspecto a Obscuro durante la noche y Claro durante el día."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Claro u Oscuro para cambiar el aspecto de los fondos y menús. Selecciona Automático para cambiar el aspecto a Oscuro durante la noche y Claro durante el día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta taustan ja valikoiden ulkoasua valitsemalla Vaalea tai Tumma. Valitse Automaattinen, jos haluat muuttaa ulkoasun illalla tummaksi ja päivällä vaaleaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Clair ou Sombre pour modifier l’apparence des arrière-plans et des menus. Sélectionnez Automatique pour que l’apparence passe à Sombre la nuit et à Clair la journée."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Claire ou Sombre pour modifier l’apparence de l’arrière-plan et des menus. Sélectionnez Automatique pour que l’apparence soit sombre la nuit et claire le jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור ״בהיר״ או ״כהה״ כדי לשנות את המראה של הרקעים והתפריטים. ניתן לבחור ״אוטומטי״ כדי לשנות את המראה ל״כהה״ בלילה ול״בהיר״ במהלך היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड और मेन्यू के प्रकटन को परिवर्तित करने के लिए “हल्का” या “गहरा” चुनें। प्रकटन को रात में “गहरा” और दिन में “हल्का” के रूप में बदलने के लिए ऑटोमैटिक चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite Svijetli ili Tamni za promjenu izgleda pozadina i izbornika. Odaberite Automatski za promjenu izgleda u Tamno noću i Svijetlo tijekom dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon a Világos vagy Sötét lehetőségek közül a hátterek és menük megjelenítésének módosításához. Válassza az Automatikus lehetőséget, ha a megjelenést éjjel Sötétre, nappal pedig Világosra szeretné állítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Terang atau Gelap untuk mengubah tampilan latar belakang dan menu. Pilih Otomatis untuk mengubah tampilan ke Gelap saat malam dan Terang saat siang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona le opzioni Scuro o Chiaro per modificare l’aspetto dello sfondo e dei menu. Selezionando Automatico, l’aspetto passerà da chiaro a scuro a seconda dell’orario del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ライト”または“ダーク”を選択して、背景およびメニューの外観を変更できます。夜間に自動的に外観を暗く、昼間に自動的に明るくするには“自動”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 및 메뉴 화면 모드를 변경하려면 ‘라이트’ 또는 ‘다크’를 선택하십시오. 화면 모드를 밤에는 다크 모드로, 낮에는 라이트 모드로 변경하려면 ‘자동’을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Cerah atau Gelap untuk menukar penampilan latar belakang dan menu. Pilih Automatik untuk menukar penampilan kepada Gelap pada waktu malam dan Cerah pada siang hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Lyst eller Mørkt for å endre utseendet på bakgrunner og menyer. Velg Automatisk for å endre utseendet til Mørkt om kvelden og Lyst på dagtid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer 'Licht' of 'Donker' om de weergave van achtergronden en menu's te wijzigen. Selecteer 'Automatisch' om de weergave 's avonds en 's nachts 'Donker', en overdag 'Licht' te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zmienić wygląd tła i menu, wybierz opcję Jasny lub Ciemny. Aby w nocy zawsze używać ciemnego interfejsu, a za dnia jasnego, wybierz opcję Automatycznie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Clara ou Escura para alterar a aparência de fundos e menus. Selecione Automática para alterar a aparência para Escura à noite e Clara durante o dia."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Tons claros ou Tons escuros para alterar a apresentação dos fundos de ecrã e dos menus. Para mudar automaticamente para tons escuros à noite e tons claros durante o dia, selecione Automática."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați Luminos sau Întunecat pentru a schimba aspectul fundalurilor și meniurilor. Selectați Automat pentru ca aspectul să fie întunecat noaptea și luminos în timpul zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Светлое» или «Темное», чтобы изменить оформление фона и меню. Выберите «Авто», чтобы оформление менялось в зависимости от времени суток с темного на светлое и наоборот."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeňte vzhľad pozadí a menu výberom možnosti Svetlý alebo Tmavý. Ak chcete, aby sa vzhľad menil na Tmavý v noci a Svetlý počas dňa, vyberte možnosť Automatický."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite način Svetlo ali Temno, da spremenite videz ozadij in menijev. Izberite način Samodejno, da se videz spremeni v način Temno zvečer in Svetlo podnevi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att välja Ljust eller Mörkt kan du ändra utseende på bakgrunder och menyer. Välj Automatiskt om du vill ändra utseendet till Mörkt på natten och Ljust på dagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสว่างหรือมืดเพื่อเปลี่ยนรูปแบบของพื้นหลังและเมนู เลือกอัตโนมัติเพื่อเปลี่ยนรูปแบบเป็นมืดในเวลากลางคืนและสว่างในเวลากลางวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planların ve menülerin görünüşünü değiştirmek için Açık Renk’i ya da Koyu Renk’i seçin. Görünüşün gece Koyu Renk, gündüz Açık Renk olması için Otomatik’i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Світлий» або «Темний» для змінення вигляду тла й меню. Виберіть «Автоматично», щоб вигляд змінювався на «Темний» уночі та на «Світлий» удень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Sáng hoặc Tối để thay đổi giao diện của nền và menu. Chọn Tự động để thay đổi giao diện thành Tối vào ban đêm và Sáng trong thời gian ban ngày."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“浅色”或“深色”来更改背景和菜单的外观。选择“自动”以在夜间将外观更改为“深色”，白天更改为“浅色”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇淺色或深色可更改背景和選單的外觀。選擇「自動」將外觀在夜間轉為深色，白天轉為淺色。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選取「淺色」或「深色」來更改背景和選單外觀。選取「自動」來在夜間將外觀更改為「深色」，並在日間更改為「淺色」。"
          }
        }
      }
    },
