    "AVNativeModeSwitchingUnverifiedModesDescriptionPAL25": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد هذا التنسيق للتأكد أنه يعمل مع تلفزيونك. وبمجرد التحقق، يمكن أن يستخدمه Apple TV تلقائيًا.\n‏%@ هو المعدل القياسي على أجهزة التلفزيون التي لا تدعم %@ في أجزاء من أوروبا وآسيا والدول الأخرى التي تستخدم PAL أو SECAM."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona aquest format per verificar que funcioni amb el televisor. Un cop s’hagi verificat, s’utilitzarà automàticament.\nEn regions d’Europa, Àsia i altres països on s’utilitza el sistema PAL o SECAM, la freqüència estàndard en televisors que no admeten freqüències de %@ és %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento formát vyberte, chcete‑li zjistit, jestli na vašem televizoru funguje. Po ověření ho může Apple TV používat automaticky.\n%@ je standardní frekvence televizorů, které nepodporují frekvenci %@, v některých částech Evropy a Asie a v dalších zemích, kde se používá standard PAL nebo SECAM."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dette format for at sikre, at det virker på dit fjernsyn. Når det er blevet bekræftet, kan Apple TV bruge det automatisk.\n%@ er standard på fjernsyn, der ikke understøtter %@, i dele af Europa, Asien og andre lande, der bruger PAL eller SECAM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle dieses Format, um sicherzustellen, dass es mit deinem TV-Gerät funktioniert. Nach der Verifizierung kann es von Apple TV automatisch verwendet werden.\n%@ ist in Teilen von Europa, Asien und anderen Ländern, die PAL oder SECAM verwenden, der Standard auf Fernsehgeräten, die %@ nicht unterstützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε αυτήν τη μορφή για να ελεγχθεί αν λειτουργεί με την τηλεόρασή σας. Όταν επαληθευτεί ότι λειτουργεί, το Apple TV θα μπορεί να τη χρησιμοποιεί αυτόματα.\nΗ συχνότητα %@ είναι η τυπική συχνότητα για τηλεοράσεις που δεν υποστηρίζουν συχνότητες %@ σε κάποιες περιοχές της Ευρώπης, της Ασίας και άλλες χώρες όπου χρησιμοποιείται το πρότυπο PAL ή SECAM."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this format to make sure it works with your television. Once verified, Apple TV can use it automatically.\n%@ is standard on televisions that don’t support %@ in parts of Europe, Asia, and other countries using PAL or SECAM."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this format to make sure it works with your television. Once verified, Apple TV can use it automatically.\n%@ is standard on televisions that don’t support %@ in parts of Europe, Asia and other countries using PAL or SECAM."
