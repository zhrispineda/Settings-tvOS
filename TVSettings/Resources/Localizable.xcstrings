            "value": "Ten Apple TV jest nadzorowany. „%@” może monitorować dane przesyłane przez Internet przy użyciu tego urządzenia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple TV é supervisionada. “%@” pode monitorar o tráfego de internet neste dispositivo."
          }
        },
        "pt_PT": {
          "stringUnit": {
