            "value": "ניתן להציג באנר בתוך המשחק בכל פעם שנשלח ניקוד לוח שחקנים.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "हर बार लीडरबोर्ड स्कोर सबमिट करने पर एक इन-गेम बैनर प्रदर्शित करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Prikazivanje banera unutar igre svaki put kad se pošalje rezultat rang liste.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Megjeleníthet egy játékon belüli szalagcímet, amikor eredménytábla-pontszámokat küld be.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tampilkan spanduk dalam game setiap kali skor papan nilai dikirim.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Mostra un banner nel gioco ogni volta che viene inviato un punteggio in classifica.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "Leaderboardのスコアが送信されるたびに、ゲーム内のバナーを表示します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "순위표 점수가 제출될 때마다 게임 내 배너를 표시합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Paparkan sepanduk dalam permainan pada bila-bila masa skor papan juara dihantar.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Toon een in-game banner wanneer een ranglijstscore wordt vastgelegd.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Vis et banner i spillet når det sendes en poengsum til ledertavlen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Wyświetlaj podczas gry banery z informacją o nowych wynikach na tablicy.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Exibe um banner no jogo sempre que uma pontuação do placar é enviada.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Mostrar uma faixa durante o jogo sempre que for enviada uma pontuação da tabela de classificação.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "De fiecare dată când se trimite un scor în clasament, în joc va fi afișat un banner.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Отображать в игре баннер о начислении очков в таблице результатов.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Pri každom odoslaní skóre do rebríčka sa v hre zobrazí banner.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Prikažite pasico v igri ob vsaki predložitvi seznama vodilnih igralcev.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Visa en banderoll i spelet varje gång ett resultat på resultattavlan skickas in.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แสดงป้ายประกาศในเกมทุกครั้งที่ส่งคะแนนในลีดเดอร์บอร์ด",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Puan cetveli puanı gönderildiğinde bir oyun içi başlık görüntüler.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Показувати банер у грі, коли результат надсилається в таблицю лідерів.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Hiển thị một biểu ngữ trong trò chơi mỗi khi điểm trên bảng xếp hạng được gửi.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "提交排行榜得分时，显示游戏内横幅。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "每次送出排行榜分數時，顯示遊戲內的橫額。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "每次送出排行榜分數時顯示遊戲內的橫幅。",
            "state": "translated"
          }
        }
      }
