    "RCVolumeUIInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعرض Apple TV الاستجابة لمستوى الصوت من الأجهزة الخارجية مثل أجهزة الاستقبال وسماعات ساوندبار."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV mostrarà el nivell de volum dels dispositius externs, com ara receptors i barres de so."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude zobrazovat odezvu na ovládání hlasitosti z externích zařízení, jako jsou receivery a soundbary."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV viser feedback om lydstyrke fra eksterne enheder som modtagere og soundbars."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV zeigt Rückmeldungen für die Lautstärke von externen Geräten wie Receivern und Sound Bars an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα εμφανίζει ανάδραση έντασης ήχου από εξωτερικές συσκευές, όπως δέκτες και ηχομπάρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will display volume feedback from external devices like receivers and sound bars."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will display volume feedback from external devices like receivers and sound bars."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will display volume feedback from external devices like receivers and sound bars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV mostrará el nivel de volumen de dispositivos externos como receptores y barras de sonido."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV mostrará el nivel de volumen de dispositivos externos como receptores y barras de sonido."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV mostrará el nivel de volumen de dispositivos externos como receptores y barras de sonido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV näyttää äänenvoimakkuuden palautteen ulkoisista laitteista, kuten vastaanottimista ja soundbar-kaiuttimista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV affichera le curseur de volume des appareils externes, tels que les récepteurs et les barres de son."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV affichera les modifications du volume effectuées à partir d’appareils externes tels que des récepteurs et des barres de son."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יציג את משוב עוצמת השמע ממכשירים חיצוניים כגון מגברים ומקרני קול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV रिसीवर और साउंड बार जैसे बाहरी डिवाइस से वॉल्यूम फ़ीडबैक डिस्प्ले करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV će prikazivati povratnu informaciju za glasnoću s vanjskih uređaja poput prijemnika i soundbar zvučnika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV hangerő-visszajelzéseket fog megjeleníteni a külső eszközökről, például a vevőkészülékekről és a hangprojektorokról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan menampilkan umpan balik volume dari perangkat eksternal seperti penerima dan sound bar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV mostrerà il livello del volume di dispositivi esterni come ricevitori e altoparlanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVで、レシーバー、サウンドバーなどの外部デバイスからの音量のフィードバックを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 수신기 및 사운드 바 같은 외장 기기로부터 받은 음량 피드백을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memaparkan maklum balas kelantangan daripada peranti luaran seperti penerima dan bar bunyi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil vise voluminformasjon fra eksterne enheter som hjemmekinoanlegg og lydplanker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV toont volumefeedback van externe apparaten, zoals ontvangers en soundbars."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie wyświetlać informacje o głośności z urządzeń zewnętrznych, na przykład odbiorników i soundbarów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV mostrará o volume de dispositivos externos, como receivers e barras de som."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV mostrará o volume de dispositivos externos, como recetores e barras de som."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va afișa nivelul volumului de pe dispozitive precum receivere și sisteme sound bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет отображаться уровень громкости внешних устройств, таких как ресиверы и звуковые панели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude zobrazovať odozvu na zmenu hlasitosti externých zariadení, ako sú prijímače a soundbary."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo prikazal povratne informacije o glasnosti zunanjih naprav, kot so sprejemniki in zvočne palice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV visar volymfeedback från externa enheter som mottagare och soundbarer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะแสดงระดับเสียงพูดจากอุปกรณ์ภายนอก เช่น ตัวรับสัญญาณและลําโพงซาวด์บาร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, alıcılar ve ses çubukları gibi harici aygıtlardan ses yüksekliği geri bildirimi görüntüler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV показуватиме меню керування гучністю для зовнішніх пристроїв, як‑от приймачів і динаміків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ hiển thị phản hồi âm lượng từ các thiết bị bên ngoài như đầu thu và loa thanh."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将显示外部设备（如接收器和条形音箱）的音量反馈。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV將會顯示外置裝置（例如接收器和回音壁）的音量回報。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會顯示接收器和聲霸等外部裝置的音量回饋。"
          }
        }
      }
    },
