        },
        "zh_HK": {
          "stringUnit": {
            "value": "圖形效能HUD顯示影格率、GPU時間和記憶體用量，並且可以記錄效能資料，以供日後分析之用。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "圖形效能HUD會顯示影格率、GPU時間、記憶體用量，並可以記錄效能資料以供日後分析。",
            "state": "translated"
          }
        }
      }
    },
    "NLCInfoGroupDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "النطاق الترددي بالكيلوبت/ث، وفقدان الحزم بالنسبة المئوية، ومدة التأخير بالملي ثانية",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Amplada de banda en kbps, ràtio de pèrdua de paquets en percentatge i retard en mil·lisegons",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Šířka pásma v kb/s, ztráta paketů v procentech a prodleva v milisekundách",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Båndbredde i kb/s, pakketab i procent og forsinkelse i millisekunder",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Bandbreite in KBit/s, Paketverlustrate in Prozent und Verzögerung in Millisekunden",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Εύρος ζώνης σε kb/δευτ., ρυθμός απώλειας πακέτου σε % και καθυστέρηση σε χιλιοστά δευτερολέπτου",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Bandwidth in kb/s, packet loss rate in %, and delay in milliseconds",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Bandwidth in kb/s, packet loss rate in % and delay in milliseconds",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Bandwidth in kb/s, packet loss rate in %, and delay in milliseconds",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Bandwidth in kbps, packet loss rate in % and delay in milliseconds",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Ancho de banda en kb/s, índice de pérdida de paquetes en porcentaje y demora en milisegundos",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Ancho de banda en kb/s, tasa de pérdida de paquetes en porcentaje y retraso en milisegundos",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Kaistanleveys kb/s:inä, pakettihäviö prosentteina ja viive millisekunteina",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "La bande passante en kb/s, le taux de perte de paquets en pourcentage et le délai en millisecondes.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "La bande passante en ko/s, le taux de perte de paquets en pourcentage et le délai en millisecondes",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "רוחב הפס צריך להיות בק״ב לשנייה, שיעור אובדן המנות צריך להיות באחוזים וערך ההשהיה צריך להיות באלפיות השנייה",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "बैंडविड्थ kb/s में, पैकेट लॉस दर % में और डिले मिलीसेकंड में",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Pojasna širina u kb/s, stopa gubitka paketa u postocima i odgoda u milisekundama",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Sávszélesség kb/s értékben, csomagveszteségi arány százalékban, és késleltetés ezredmásodpercben kifejezve",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Bandwidth dalam kb/d, laju pengurangan paket dalam %, dan penundaan dalam milidetik",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Larghezza di banda in kb/s, frequenza perdita di pacchetti in percentuale e ritardo in millisecondi",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "帯域幅（単位: kb/s）、パケット損失レート（単位: パーセント）、遅延（単位: ミリ秒）",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "대역폭(kb/s), 패킷 유실률(%) 및 지연(밀리초)",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Lebar jalur dalam kb/s, kadar kehilangan paket dalam % dan tundaan dalam milisaat",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Bandbreedte in Kbps, pakketverliesfrequentie in % en vertraging in milliseconden",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Båndbredde i kB/s, pakketap­frekvens i % og forsinkelse i millisekunder",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Szerokość pasma (w kb/s), współczynnik utraty pakietów (w %) i opóźnienie (w ms)",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Largura de banda em kb/s, taxa de perda de pacotes em porcentagem e atraso em milissegundos",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Largura de banda em kb/s, taxa de perda de pacotes em percentagem e atraso em milissegundos",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Lățimea de bandă în kb/s, rata pierderii de pachete în procente și întârzierea în milisecunde",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Ширина полосы в килобайтах в секунду, коэффициент потери пакетов в процентах и задержка в миллисекундах",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Šírka pásma v kb/s, strata paketov v percentách a oneskorenie v milisekundách",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Pasovna širina v kb/s, stopnja izgube pri paketnem prenosu podatkov v % in zakasnitev v milisekundah",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Bandbredd i kbit/s, paketförlust i procentandel och fördröjning i millisekunder",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แบนด์วิดท์เป็น kb/s, อัตราการสูญเสียแพ็คเกตเป็น % และความล่าช้าเป็นมิลลิวินาที",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Bant genişliği kb/sn, paket kayıp hızı % ve gecikme milisaniye olarak gösterilir",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Пропускна здатність у Кбіт/с, коефіцієнт втрати пакетів у відсотках і затримка в мілісекундах",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Băng thông tính bằng kb/s, tỷ lệ mất gói tính bằng % và độ trễ tính bằng mili giây",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "带宽单位为kb/s，丢包率单位为%，延迟单位为毫秒",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "頻寬單位為kb/s，封包遺失率單位為%，延遲時間單位為毫秒",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "以kb/秒為單位的頻寬，以%為單位的封包遺失率，和以毫秒為單位的延遲時間",
            "state": "translated"
          }
        }
      }
    },
