    "TimeZoneSetAutomaticallyDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين التاريخ والوقت تلقائيًا باستخدام موقعك الحالي (إذا كان متوفرًا)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableix la data i l’hora automàticament utilitzant la teva ubicació actual (si està disponible)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum a čas se nastaví automaticky pomocí vaší aktuálního polohy (je‑li k dispozici)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil dato og tid automatisk vha. din aktuelle lokalitet (hvis tilgængelig)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Datum und Uhrzeit automatisch anhand deines aktuellen Aufenthaltsorts (wenn verfügbar) fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη ρύθμιση της ημερομηνίας και της ώρας χρησιμοποιώντας την τρέχουσα τοποθεσία σας (όπου διατίθεται)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the date and time automatically using your current location (if available)."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the date and time automatically using your current location (if available)."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the date and time automatically using your current location (if available)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta automáticamente la fecha y la hora según tu ubicación actual (si está disponible)."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta automáticamente la hora y la fecha según tu ubicación actual (si está disponible)."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta automáticamente la hora y la fecha según tu ubicación actual (si está disponible)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta päivämäärä ja aika automaattisesti nykyisen sijainnin mukaan (jos saatavilla)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez la date et l’heure automatiquement en fonction de votre emplacement géographique (si disponible)."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez la date et l’heure automatiquement en fonction de votre emplacement géographique (si disponible)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאריך והשעה יכולים להיות מוגדרים באופן אוטומטי באמצעות מיקומך הנוכחי (אם זמין)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वर्तमान स्थान का उपयोग कर तिथि और समय को ऑटोमैटिकली सेट करें (यदि उपलब्ध हो)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski podesite datum i vrijeme koristeći svoju trenutačnu lokaciju (ako je dostupna)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállíthatja automatikusan a dátumot és időt az aktuális helyszín alapján (ha elérhető)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tanggal dan waktu secara otomatis menggunakan lokasi Anda saat ini (jika tersedia)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona data e ora automaticamente in base alla tua posizione attuale (se disponibile)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の位置情報が利用可能な場合は、その情報に基づいて日時を自動的に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 현재 위치를 기반으로(사용 가능한 경우) 날짜 및 시간을 자동으로 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setkan tarikh dan masa secara automatik menggunakan lokasi semasa anda (jika tersedia)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi dato og tid automatisk ut fra hvor du befinner deg (hvis tilgjengelig)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de datum en tijd automatisch in op basis van je huidige locatie (indien beschikbaar)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datę i czas możesz ustawić automatycznie, na podstawie bieżącego położenia (wybrane lokalizacje)."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir a data e hora automaticamente usando a sua localização atual (se disponível)."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a data e hora automaticamente usando a sua localização atual (caso esteja disponível)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixați automat data și ora utilizând localizarea dvs. curentă (în funcție de disponibilitate)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата и время могут настраиваться автоматически на основе Вашего местонахождения (если доступно)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví dátum a čas automaticky použitím vašej aktuálnej polohy (ak je dostupná)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno nastavite datum in čas na podlagi trenutne lokacije (če je na voljo)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in datum och tid baserat på din nuvarande plats (om tillgänglig)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งวันที่และเวลาอัตโนมัติโดยใช้ตำแหน่งที่ตั้งปัจจุบันของคุณ (หากมี)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anki konumunuzu (varsa) kullanarak tarihi ve saati otomatik olarak ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично змінювати дату та час за поточним місцем (якщо є)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đặt ngày và giờ bằng cách sử dụng vị trí hiện tại của bạn (nếu có sẵn)."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你当前的位置（如果有的话）来自动设置日期与时间。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以使用現時的位置（如適用）自動設定日期及時間。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前位置自動設定日期與時間（若可取得的話）。"
          }
        }
      }
    },
