    "SpatialAudioTutorialInstructions": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك رأسك لليمين واليسار أثناء الاستماع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou el cap a l’esquerra i la dreta mentre escoltes l’àudio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při poslechu otáčejte hlavou doleva a doprava."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevæg hovedet til venstre og højre, mens du lytter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege deinen Kopf beim Hören nach links und rechts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γυρίστε το κεφάλι σας προς τα αριστερά και τα δεξιά ενόσω ακούτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your head to the left and right while listening."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your head to the left and right while listening."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your head to the left and right while listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la cabeza hacia la izquierda y hacia la derecha mientras escuchas el audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la cabeza a la izquierda o a la derecha mientras escuchas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la cabeza a la izquierda o a la derecha mientras escuchas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä päätäsi vasemmalle ja oikealle kuunnellessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la tête vers la gauche et la droite pendant l’écoute."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la tête à gauche et à droite tout en écoutant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזיז את הראש שמאלה וימינה בעת ההאזנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनते समय अपने सिर को बाएँ और दाएँ घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomičite glavu ulijevo i udesno tijekom slušanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozgassa a fejét balra vagy jobbra a hang hallgatása közben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan kepala Anda ke kiri dan kanan saat mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi la testa a sinistra e a destra durante l’ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴いている間に頭を左右に動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 듣는 동안 머리를 좌우로 움직이십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan kepala anda ke kiri dan ke kanan semasa mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snu hodet mot høyre eller venstre mens du lytter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg je hoofd naar links en naar rechts terwijl je luistert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obracaj głowę w lewo i w prawo podczas słuchania."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a cabeça para a esquerda e para a direita enquanto ouve."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a cabeça para a esquerda e para a direita ao ouvir o áudio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mișcați‑vă capul spre stânga și spre dreapta în timp ce ascultați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прослушивании двигайте головой влево и вправо."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas počúvania pohybujte hlavou do strán."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med poslušanjem premaknite glavo v levo in desno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid huvudet åt vänster och höger medan du lyssnar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หันศีรษะของคุณไปทางซ้ายและขวาในระหว่างฟังเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlerken başınızı sola ve sağa çevirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час прослуховування рухайте головою вліво і вправо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển đầu của bạn sang trái và phải trong khi đang nghe."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "聆听时，请左右移动头部。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽時，頭部向左右兩邊轉動。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽時請將你的頭部左右移動。"
          }
        }
      }
    },
