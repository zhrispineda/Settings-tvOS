        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det här formatet om du vill vara säker på att det fungerar tillsammans med din TV. När det har verifierats kan det användas med Apple TV automatiskt.\n%@ är en exakt matchning för innehåll som är inspelat med %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปแบบนี้เพื่อให้แน่ใจว่ารูปแบบนี้ใช้ได้กับโทรทัศน์ของคุณ Apple TV สามารถใช้รูปแบบนี้ได้โดยอัตโนมัติหลังจากตรวจสอบยืนยันแล้ว\n%@ เป็นความถี่ที่ตรงกันสำหรับเนื้อหาที่บันทึกที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
