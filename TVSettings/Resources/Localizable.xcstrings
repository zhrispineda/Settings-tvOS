    "OSBetaSoftwareTermsMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسجيل Apple TV في برنامج Apple Beta Software، يجب الموافقة على كل الشروط التالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per inscriure aquest Apple TV al programa Apple Beta Software has d’acceptar les condicions següents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li Apple TV zaregistrovat do Apple Beta Software Programu, musíte souhlasit s následujícími podmínkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal acceptere Vilkår og betingelser for Apple Beta Software Program for at kunne tilmelde dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dieses Apple TV für das Apple Beta Software-Programm zu registrieren, musst du allen folgenden Bestimmungen zustimmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για εγγραφή αυτού του Apple TV στο Πρόγραμμα Apple Beta Software, πρέπει να αποδεχτείτε όλους τους ακόλουθους όρους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To enroll this Apple TV in the Apple Beta Software Program, you must agree to all the following terms."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To enrol this Apple TV in the Apple Beta Software Program, you must agree to all the following terms."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To enrol this Apple TV in the Apple Beta Software Programme, you must agree to all the following terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para inscribir este Apple TV en el programa Apple Beta Software, tienes que aceptar estas condiciones."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para inscribir este Apple TV en el programa Apple Beta Software, debes aceptar los siguientes términos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para inscribir este Apple TV en el programa Apple Beta Software, debes aceptar los siguientes términos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekisteröi tämä Apple TV Apple Beta Software Program ‑ohjelmaan hyväksymällä kaikki seuraavat ehdot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour inscrire cette Apple TV au programme de logiciels bêta d’Apple, vous devez accepter les conditions suivantes."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour inscrire cette Apple TV au programme de logiciels bêta d’Apple, vous devez accepter les modalités suivantes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לרשום Apple TV זה בתוכנית Apple Beta Software, יש להסכים לכל התנאים הבאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software प्रोग्राम में इस Apple TV के नामांकन के लिए आपको निम्नलिखित सभी नियमों से सहमत होना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prijavu ovog Apple TV-a u Apple Beta Software program trebate se složiti sa sljedećim odredbama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az Apple TV-nek az Apple Beta Software programba való feliratkoztatásához el kell fogadnia a következő feltételeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendaftarkan Apple TV ini di Program Apple Beta Software, Anda harus menyetujui semua ketentuan berikut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare Apple TV all’Apple Beta Software Program, devi accettare tutti i termini di seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVをApple Beta Software Programに登録するには、以下の規約に同意しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV를 Apple 베타 소프트웨어 프로그램에 등록하려면 다음 약관에 모두 동의해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendaftarkan Apple TV ini dalam Program Apple Beta Software, anda mesti bersetuju dengan semua syarat berikut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil registrere Apple TV-enheten i Apple Beta Software-programmet, må du først godta vilkårene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om deze Apple TV in te schrijven voor het Apple Beta Software-programma, moet je akkoord gaan met al de volgende voorwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zarejestrować ten Apple TV w Apple Beta Software Program, musisz zaakceptować poniższe warunki."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para inscrever esta Apple TV no Programa Apple Beta Software, você deve concordar com todos os termos a seguir."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para inscrever esta Apple TV no Apple Beta Software Program, tem de aceitar os termos que se seguem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a înscrie acest Apple TV în programul Apple Beta Software, trebuie să fiți de acord cu toate condițiile următoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для регистрации этого Apple TV в Программе бета-тестирования Apple необходимо принять следующие условия использования:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete registrovať toto Apple TV v Apple Beta Software Programe, musíte súhlasiť s nasledujúcimi zmluvnými podmienkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite vpisati ta Apple TV v program Apple Beta Software, se morate strinjati z naslednjimi pogoji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill registrera denna Apple TV i Apple Beta Software Program måste du godkänna alla följande villkor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการลงทะเบียน Apple TV เครื่องนี้กับโปรแกรม Apple Beta Software คุณต้องยอมรับข้อตกลงทั้งหมดต่อไปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’yi Apple Beta Software Programı’na kaydetmek için aşağıdaki tüm hükümleri kabul etmelisiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зареєструвати цей Apple TV у Програмі бета-тестування Apple Beta Software, ви маєте погодитися з усіма наведеними нижче умовами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đăng ký Apple TV này trong Chương trình Apple Beta Software, bạn phải đồng ý với tất cả các điều khoản sau."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要注册此Apple TV至Apple Beta版软件计划，你必需同意以下所有条款。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要在「Apple Beta Software計劃」中註冊此Apple TV，你必須同意以下所有條款。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要將此Apple TV在「Apple Beta版軟體計畫」中註冊，你必須同意下列所有條款。"
          }
        }
      }
    },
