          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να συνδεθείτε χειροκίνητα;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign in manually?"
          }
        },
        "en_AU": {
          "stringUnit": {
