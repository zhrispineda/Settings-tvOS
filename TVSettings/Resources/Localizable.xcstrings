    "SaverBackdropThemeCallout": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير شاشة التوقف باستمرار باستخدام الصور الجوية على Apple TV. يمكنك إخفاء أي صور لا ترغب في تضمينها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estalvi de pantalla mostrarà les vistes aèries de l’Apple TV de manera aleatòria. Pots ocultar les que no vulguis que hi apareguin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spořič obrazovky cyklicky střídá všechny letecké záběry, které jsou v Apple TV k dispozici. Pokud chcete některé vynechat, skryjte je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmskåneren skifter mellem luftfotoene på dit Apple TV. Skjul de luftfotos, som ikke skal inkluderes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirmschoner zeigt die Luftaufnahmen auf deinem Apple TV in einer Diashow an. Blende alle aus, die nicht angezeigt werden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προφύλαξη οθόνης εμφανίζει εναλλάξ αεροβίντεο στο Apple TV. Αποκρύψτε αυτά που δεν θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver rotates through the Aerials on your Apple TV. Hide any you don’t want included."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver rotates through the Aerials on your Apple TV. Hide any you don’t want included."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver rotates through the Aerials on your Apple TV. Hide any you don’t want included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El salvapantallas va mostrando las distintas vistas aéreas en el Apple TV. Puedes ocultar las que no quieras incluir."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El protector de pantalla muestra diversas vistas aéreas en tu Apple TV. Oculta las que no quieras incluir."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El protector de pantalla muestra diversas vistas aéreas en tu Apple TV. Oculta las que no quieras incluir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytönsäästäjä kierrättää ilmakuvia Apple TV:ssä. Kätke ne, joita et halua sisällyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran fait défiler les vues aériennes sur votre Apple TV. Vous pouvez masquer celles que vous ne souhaitez pas inclure."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran fait défiler les vues aériennes sur votre Apple TV. Masquez celles que vous ne voulez pas inclure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר המסך מחליף בין צילומי האוויר ב‑Apple TV. באפשרותך להסתיר את אלה שאינך רוצה לכלול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple TV पर स्क्रीन सेवर एक से दूसरे एरियल पर बदलता रहता है। जो पसंद न हों, उन्हें छिपाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštita zaslona rotira zračne snimke na vašem Apple TV-u. Sakrijte one koje ne želite uključiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyővédő egymás után megjeleníti a légi felvételeket az Apple TV‑n. Elrejtheti azokat, amelyeket nem szeretne, hogy megjelenjenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghemat layar merotasi Aerial di Apple TV Anda. Sembunyikan Aerial yang tidak ingin Anda sertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvaschermo mostra in sequenza le viste aeree su Apple TV. Nascondi quelle che non vuoi includere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVのスクリーンセーバで“空撮”がローテーション表示されます。ローテーションに含めたくないものを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV의 화면 보호기에 항공 사진이 순환하며 표시됩니다. 표시하고 싶지 않은 항공 사진은 가리십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelamat skrin menggilirkan Tema Udara pada Apple TV anda. Sembunyikan mana-mana yang anda tidak mahu sertakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermspareren blar gjennom luftfotoene på Apple TV. Du kan skjule luftfoto du ikke vil ha med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermbeveiliging roteert door de 'In vogelvlucht'-beelden op je Apple TV. Verberg de beelden die je niet wilt zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygaszacz ekranu Apple TV cyklicznie zmienia widoki z lotu ptaka. Możesz ukryć te, których nie chcesz wyświetlać."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O protetor de tela alterna as Vistas Aéreas da Apple TV. Oculte aquelas que você não deseja incluir."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção de ecrã alterna entre as vistas aéreas na Apple TV. Oculte as que não quiser ver incluídas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Screensaverul afișează alternativ vederile aeriene pe Apple TV. Ascundeți‑le pe cele care nu doriți să fie incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аэрозаставки будут поочередно отображаться на Apple TV. Если Вы не хотите видеть какие‑то из них, скройте их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šetrič obrazovky strieda letecké zábery na vašom Apple TV. Tie, ktoré nechcete zobrazovať, môžete skryť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohranjevalnik zaslona v Apple TV-ju izmenično prikazuje zračne posnetke. Skrijte vse, ki jih ne želite vključiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmsläckaren roterar bland flygfotona på Apple TV. Göm alla foton som inte ska ingå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพพักหน้าจอจะแสดงภาพมุมสูงสลับต่อกันไปเรื่อยๆ บน Apple TV ของคุณ\nเลือกซ่อนภาพที่คุณไม่ต้องการให้แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran koruyucu, Apple TV’nizdeki Havadan öğeleri arasında geçiş yapar. Dahil etmek istemediklerinizi gizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На екранній заставці Apple TV чергуються види з повітря. Сховайте ті з них, які не потрібно показувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình bảo vệ màn hình luân chuyển qua các video Không trung trên Apple TV của bạn. Ẩn bất kỳ mục nào mà bạn không muốn bao gồm."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕保护程序会循环播放Apple TV上的航拍。隐藏任何你不想包含的内容。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕保護程式會在Apple TV的「航拍」上輪播。請隱藏任何你不想包括在內的項目。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕保護程式會循環播放Apple TV上的「空照圖」。隱藏任何你不想包含的空照圖。"
          }
        }
      }
    },
    "SaverBackdropThemeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار الصور الجوية المراد عرضها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona les vistes aèries que vulguis que es mostrin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje vybrat letecké záběry."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvilke luftfotos, der vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Luftaufnahmen angezeigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ποια αεροβίντεο θα εμφανίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which Aerials are displayed."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which Aerials are displayed."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which Aerials are displayed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona qué vistas aéreas se mostrarán."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los protectores de vista aérea que se mostrarán."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los protectores de vista aérea que se mostrarán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitkä ilmakuvat näytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes à afficher."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes à afficher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת הצילומים האוויריים שיוצגו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनाव करें कि कौन से एरियल दिखाने हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite zračne snimke koje će se prikazivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, milyen légi felvételek jelenjenek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Aerial mana yang akan ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le viste aeree da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの空撮を表示するか選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 항공 사진을 표시할지 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Tema Udara yang dipaparkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilke luftfoto som vises."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal welke schermbeveiligingen worden weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór wyświetlanych wygaszaczy Z lotu ptaka."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais vistas Aéreas são exibidas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os temas que devem ser apresentados."
          }
        },
        "ro": {
