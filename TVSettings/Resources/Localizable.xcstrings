    "RestrictionsPasscodeSetPrompt": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإعداد القيود، أدخل رمز دخول جديدًا مكونًا من أربعة أرقام.\nستلزم إعادة إدخال رمز الدخول كلما غيّرت القيود."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per configurar les restriccions, introdueix un nou codi de 4 dígits.\nHauràs de tornar a introduir el codi cada cop que vulguis canviar‑les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li nastavit omezení, zadejte nový čtyřmístný kód.\nPři každé změně omezení ho budete zadávat znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en ny kode på fire cifre for at indstille begrænsninger.\nDu skal skrive koden igen, hver gang du vil ændre begrænsningerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Einschränkungen festzulegen, gib einen vierstelligen Code ein.\nDu gibst den Code bei jedem Ändern der Einschränkungen erneut ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για διαμόρφωση περιορισμών, εισαγάγετε έναν νέο τετραψήφιο κωδικό.\nΑν θελήσετε να αλλάξετε τους περιορισμούς στο μέλλον, θα πρέπει να εισαγάγετε τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To set up restrictions, enter a new four-digit passcode.\nYou will reenter the passcode whenever you change restrictions."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To set up restrictions, enter a new four-digit passcode.\nYou will re-enter the passcode whenever you change restrictions."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To set up restrictions, enter a new four-digit passcode.\nYou will re-enter the passcode whenever you change restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para establecer restricciones, define un nuevo código de cuatro dígitos.\nTendrás que volver a introducir este código cuando cambies las restricciones."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para configurar las restricciones, ingresa un código nuevo de cuatro dígitos.\nDeberás ingresarlo cada vez que quieras cambiar las restricciones."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para configurar las restricciones, ingresa un código nuevo de cuatro dígitos.\nDeberás ingresarlo cada vez que quieras cambiar las restricciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota rajoitukset käyttöön syöttämällä uusi nelinumeroinen pääsykoodi.\nPääsykoodi on syötettävä uudelleen, kun haluat tehdä muutoksia rajoituksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour configurer des restrictions, saisissez un nouveau code à 4 chiffres.\nVous devrez saisir ce code pour modifier les restrictions."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour configurer des restrictions, entrez un nouveau code à quatre chiffres.\nVous devrez entrer ce code chaque fois que vous modifiez les restrictions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להגדיר הגבלות, יש להזין קוד גישה חדש בן ארבע ספרות.\nיהיה צורך להזין מחדש את קוד הגישה עם כל שינוי של ההגבלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिबंध सेटअप करने के लिए नया चार अंकों का पासकोड दर्ज करें।\nप्रतिबंधों में बदलाव करने के लिए आपको हर बार पासकोड दर्ज करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za podešavanje ograničenja unesite novu četveroznamenkastu šifru.\nTrebat ćete ponovno unijeti šifru svaki put kad promijenite ograničenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátozások beállításához adjon meg egy új négyjegyű jelkódot.\nHa módosítani szeretné a korlátozásokat, újra meg kell adnia a jelkódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengatur pembatasan, masukkan kode sandi empat digit baru.\nAnda akan memasukkan kembali kode sandi setiap kali mengubah pembatasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per configurare le restrizioni, inserisci un nuovo codice a quattro cifre.\nDovrai reinserire il codice ogni volta che le modificherai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限を設定するには、新しい4桁のパスコードを入力してください。\n制限を変更するときには、常にこのパスコードの再入力を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한을 설정하려면 새로운 4자리의 암호를 입력하십시오.\n제한을 변경하려면 암호를 다시 입력하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyediakan pengehadan, masukkan kod laluan empat digit baharu.\nAnda akan memasukkan semula kod laluan pada bila-bila masa anda menukar pengehadan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi en ny firesifret kode for å konfigurere restriksjoner.\nDu må skrive inn koden hver gang du endrer restriksjonene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om beperkingen in te stellen, voer je een nieuwe toegangscode van vier cijfers in.\nJe moet de toegangscode telkens invoeren als je beperkingen wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby skonfigurować ograniczenia, podaj nowy czterocyfrowy kod.\nPonowne podanie kodu będzie konieczne przy każdej zmianie ograniczeń."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para configurar restrições, digite um novo código de quatro dígitos.\nSempre que você alterar as restrições, deverá inserir o código novamente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para configurar restrições, digite um código de quatro dígitos.\nTerá de voltar a digitar o código sempre que pretender alterar as restrições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a configura restricțiile, introduceți un nou cod de acces din patru cifre.\nVeți reintroduce codul de acces de fiecare dată când schimbați restricțiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы настроить ограничения, введите новый код‑пароль из 4 цифр.\nЕго потребуется вводить при любом изменении ограничений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete nastaviť obmedzenia, vytvorte si štvorciferný kód.\nPri každej zmene obmedzení ho budete musieť zadať znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite nastaviti omejitve, vnesite novo štirimestno kodo za dostop.\nKodo za dostop boste morali znova vnesti vsakič, ko boste spremenili omejitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en ny fyrsiffrig lösenkod om du vill ställa in begränsningar.\nDu måste ange lösenkoden varje gång du vill ändra begränsningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการตั้งค่าการจำกัด ให้ป้อนรหัสตัวเลขสี่หลักชุดใหม่\nคุณจะต้องป้อนรหัสอีกครั้งเมื่อคุณเปลี่ยนการจำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlamaları ayarlamak için dört basamaklı yeni bir kod girin.\nSınırlamaları değiştirmek istediğinizde bu kodu yeniden girmeniz gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб налаштувати обмеження, введіть новий 4‑значний код допуску.\nЦей код допуску потрібно буде вводити для кожного змінення обмежень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thiết lập các giới hạn, hãy nhập một mật mã mới gồm 4 chữ số.\nBạn sẽ nhập lại mật mã bất kỳ lúc nào bạn thay đổi các giới hạn."
