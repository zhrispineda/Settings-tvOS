        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви маєте IP‑адресу маршрутизатора, введіть її і виберіть «Готово»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn biết địa chỉ IP của bộ định tuyến, hãy nhập địa chỉ đó và chọn Xong."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你知道路由器的IP地址，请输入并选择“完成”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你知道路由器的IP位址，請輸入有關位址及選擇「完成」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
