    "MoviesAppVisibilityDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار إظهار أفلام iTunes على الشاشة الرئيسية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria si vols que es mostrin les pel·lícules de l’iTunes a la pantalla d’inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, pokud chcete na ploše zobrazit aplikaci Filmy v iTunes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, at film i iTunes skal vises på hjemmeskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, ob iTunes-Filme auf dem Home-Bildschirm angezeigt werden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε να εμφανίζονται οι ταινίες iTunes στην οθόνη Αφετηρίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to show iTunes Movies on the Home screen."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to show iTunes Movies on the Home Screen."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to show iTunes Movies on the Home Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si mostrar la app Películas de iTunes en la pantalla de inicio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres mostrar Películas en iTunes en la pantalla de inicio."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres mostrar Películas en iTunes en la pantalla de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä iTunes-elokuvat Koti-valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si les films iTunes doivent être affichés sur l’écran d’accueil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’afficher l’app Films iTunes sur l’écran d’accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור להציג את ״סרטים״ של iTunes במסך הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iTunes फ़िल्में होम स्क्रीन पर दिखाने का विकल्प चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite za prikaz iTunes filmova na početnom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja, hogy az iTunes-filmek megjelenjenek‑e a Főképernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih untuk menampilkan Film iTunes di layar Utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se vuoi mostrare i film di iTunes sulla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面にiTunesの映画を表示するかどうかを選択します。"
