    "DiagnosticSendToDevelopersText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد مطوري التطبيقات على تحسين تطبيقاتهم عن طريق السماح لـ Apple بمشاركة أي بيانات تعطل وكذلك إحصاءات حول كيفية استخدامك للتطبيقات معهم.\n\nلمعرفة المزيد حول سياسة الخصوصية المتبعة لدى Apple، يرجى مراجعة:\nhttps://www.apple.com/ae-ar/privacy"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda els equips de desenvolupament d’apps a millorar‑les. Per fer‑ho, permet que Apple hi comparteixi informació d’errors i estadístiques sobre com utilitzes les apps.\n\nTrobaràs més informació sobre la política de privacitat d’Apple a https://www.apple.com/es/privacy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozte vývojářům ve vylepšování aplikací tím, že povolíte společnosti Apple, aby s nimi sdílela veškerá data související s haváriemi a statistiky využití.\n\nDalší informace o zásadách ochrany soukromí uživatelů společnosti Apple najdete na https://www.apple.com/cz/privacy/."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp appudviklere med at forbedre deres apps ved at tillade Apple at dele alle oplysninger om systemsvigt og statistiske oplysninger om, hvordan du bruger udviklernes apps, med dem.\n\nDer findes flere oplysninger om Apples anonymitetspolitik på https://www.apple.com/dk/privacy/"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mit, Apps zu verbessern, indem du Apple erlaubst, Absturzdaten und Statistiken über die Benutzung von Apps mit Entwicklern zu teilen.\n\nWeitere Informationen über die Datenschutzrichtlinie von Apple sind unter https://www.apple.com/de/privacy/ erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοηθήστε τους δημιουργούς εφαρμογών να βελτιώσουν τις εφαρμογές τους επιτρέποντας στην Apple την κοινοποίηση στους δημιουργούς των δεδομένων ολικών σφαλμάτων, καθώς και των στατιστικών σχετικά με τον τρόπο που χρησιμοποιείτε τις εφαρμογές.\n\nΜάθετε περισσότερα για την Πολιτική απορρήτου της Apple στη διεύθυνση http://www.apple.com/gr/privacy/"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help app developers improve their apps by allowing Apple to share any crash data and statistics about how you use their apps with them.\n\nLearn more about Apple’s Privacy Policy, see https://www.apple.com/privacy/"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Help app developers improve their apps by allowing Apple to share any crash data and statistics about how you use their apps with them.\n\nLearn more about Apple’s Privacy Policy at https://www.apple.com/au/privacy/"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Help app developers improve their apps by allowing Apple to share any crash data and statistics about how you use their apps with them.\n\nTo learn more about Apple’s Privacy Policy, see apple.com/uk/privacy/"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a los desarrolladores a mejorar sus apps autorizando a Apple a compartir con ellos los datos de los errores que experimentes, así como tus estadísticas de uso de dichas apps.\n\nPara obtener más información acerca de la política de privacidad de Apple, visita https://www.apple.com/es/privacy/."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a los desarrolladores de apps a mejorar sus apps permitiendo que Apple comparta con ellos datos de bloqueos, errores y estadísticas de cómo usas sus apps.\n\nPara obtener detalles sobre la Política de Privacidad de Apple, consulta https://www.apple.com/la/privacy/."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a los desarrolladores de apps a mejorar sus apps permitiendo que Apple comparta con ellos datos de bloqueos, errores y estadísticas de cómo usas sus apps.\n\nPara obtener detalles sobre la Política de Privacidad de Apple, consulta https://www.apple.com/la/privacy/."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta appikehittäjiä parantamaan appejaan sallimalla Applen jakaa kehittäjille kaatumistiedot ja tilastotiedot siitä, kuinka käytät kehittäjien appeja.\n\nLisätietoja Applen tietosuojakäytännöstä on osoitteessa https://www.apple.com/fi/privacy/."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez les développeurs d’apps à améliorer leurs apps en autorisant Apple à partager avec eux les données liées aux pannes et les statistiques sur la façon dont vous utilisez leurs apps.\n\nPour en savoir plus sur l’Engagement de confidentialité d’Apple, consultez la page suivante : https://www.apple.com/fr/privacy/"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez les développeurs d’apps à améliorer leurs applications en autorisant Apple à partager avec eux les données liées aux pannes et les statistiques sur la façon dont vous utilisez leurs apps.\n\nPour en savoir plus sur la politique de confidentialité d’Apple, rendez-vous sur https://www.apple.com/ca/fr/privacy/."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לעזור למפתחים לשפר את היישומים שלהם על-ידי מתן רשות ל-Apple לשתף איתם נתוני קריסת יישומים ונתונים על אופן השימוש שלך ביישומים.\n\nפרטים נוספים על מדיניות הפרטיות של Apple זמינים בכתובת: https://www.apple.com/privacy/‎"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple को क्रैश डेटा और ऐप्स के आपके उपयोग से संबंधित आँकड़े ऐप डेवलपर के साथ शेयर करने की अनुमति दें जिससे कि वे अपने ऐप्स को बेहतर बना सकें।\n\nApple की गोपनीयता नीति के बारे में अधिक जानें, https://www.apple.com/in/privacy/ देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozite developerima aplikacija u poboljšanju njihovih aplikacija tako da dozvolite Appleu da s njima dijeli bilo kakve podatke o rušenju kao i statistiku o vašem načinu uporabe njihovih aplikacija.\n\nZa dodatne informacije o Appleovim pravilima privatnosti posjetite https://www.apple.com/legal/privacy/hr/."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segíthet az appfejlesztőknek az appjaik javításában, ha engedélyezi, hogy az Apple megossza velük az összeomlási adatokat, valamint az appok használatának módját.\n\nAz Apple adatvédelmi szabályzatával kapcsolatos további tudnivalókért tekintse meg a https://www.apple.com/hu/privacy weboldalt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu pengembang app meningkatkan app mereka dengan mengizinkan Apple untuk membagikan semua data crash serta statistik mengenai cara Anda menggunakan app tersebut ke pengembang.\n\nPelajari Kebijakan Privasi Apple lebih lanjut, lihat https://www.apple.com/id/privacy/"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta le aziende di sviluppo a migliorare le proprie app consentendo ad Apple di condividere con loro i dati sui blocchi e le statistiche di utilizzo delle app.\n\nPer saperne di più sull’informativa sulla privacy di Apple, vai su https://www.apple.com/it/privacy/"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleがすべてのクラッシュデータ/アプリの使用状況の統計情報をアプリデベロッパと共有することを許可することでアプリの品質向上にご協力いただけます。\n\nAppleのプライバシーポリシーについて詳しくは、https://www.apple.com/jp/privacy/ を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 개발자가 앱을 향상할 수 있도록 Apple이 충돌 데이터 및 사용자의 앱 사용 정보에 관한 통계를 개발자와 공유하도록 허용합니다.\n\nApple의 개인정보 처리방침에 대해 더 알아보려면, https://www.apple.com/kr/privacy/를 방문하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu pembangun app meningkatkan app mereka dengan membenarkan Apple berkongsi sebarang data ranap dan statistik tentang cara anda menggunakan app mereka dengannya.\n\nKetahui lebih lanjut tentang Dasar Privasi Apple, lihat https://www.apple.com/my/privacy/."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp apputviklere å forbedre produktene sine ved å la Apple sende dem krasjinformasjon og statistikk over hvordan du bruker appene.\n\nFinn ut mer om Apples retningslinjer for personvern på https://www.apple.com/no/privacy/"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help ontwikkelaars hun apps te verbeteren door toe te staan dat Apple crashgegevens en statistische gegevens over je gebruik van hun apps met hen deelt.\n\nMeer informatie over het privacybeleid van Apple vind je op https://www.apple.com/nl/privacy/."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż deweloperom udoskonalać aplikacje, pozwalając Apple udostępniać im dane o awariach ich aplikacji oraz statystykach ich użycia.\n\nAby dowiedzieć się więcej o zasadach ochrony prywatności Apple, zobacz: https://www.apple.com/pl/privacy/"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude os desenvolvedores a melhorar seus apps permitindo que a Apple compartilhe com eles os dados sobre falhas e as estatísticas de como você usa os apps deles.\n\nSaiba mais sobre a Política de Privacidade da Apple em https://www.apple.com/br/privacy/"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude os programadores a melhorarem as respetivas aplicações permitindo que a Apple partilhe com eles quaisquer dados de falha e estatísticas de utilização das mesmas.\n\nEncontrará informação adicional acerca da Política de Privacidade da Apple em https://www.apple.com/pt/privacy/"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuiți la îmbunătățirea aplicațiilor de către dezvoltatori permițând ca Apple să partajeze cu aceștia orice date referitoare la disfuncționalități și informații statistice despre modul în care le utilizați aplicațiile.\n\nAflați mai multe informații despre Politica de confidențialitate Apple la adresa https://www.apple.com/ro/privacy/."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите разработчикам ПО улучшить их приложения, разрешив Apple делиться Вашими данными о сбоях, а также статистикой того, как Вы используете их приложения.\n\nПодробнее о Политике конфиденциальности Apple: https://www.apple.com/ru/privacy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomôžte vývojárom apiek vylepšovať apky tým, že umožníte spoločnosti Apple zdieľať s nimi všetky chybové dáta a štatistiky používania apiek.\n\nViac informácií o zásadách ochrany osobných údajov nájdete na stránke https://www.apple.com/sk/privacy/."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite družbi Apple, da z razvijalci aplikacij deli morebitne podatke o sesutju in statistike o tem, kako uporabljate njihove aplikacije, ter jim tako pomagajte izboljšati njihove aplikacije.\n\nVeč o pravilniku o zasebnosti družbe Apple je na voljo na https://www.apple.com/privacy/"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp apputvecklare att förbättra sina appar genom att låta Apple dela kraschdata och statistik över hur du använder deras appar med dem.\n\nDu kan läsa mer om Apples integritetspolicy på https://www.apple.com/se/privacy/"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยนักพัฒนาแอปปรับปรุงแอปของพวกเขาโดยอนุญาตให้ Apple แชร์ข้อมูลการปิดตัวลงโดยไม่ทราบสาเหตุและสถิติเกี่ยวกับการใช้แอปของคุณกับพวกเขา\n\nเรียนรู้เพิ่มเติมเกี่ยวกับนโยบายความเป็นส่วนตัวของ Apple ให้ดู https://www.apple.com/th/privacy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ın, çökme verilerini ve uygulamaları nasıl kullandığınızla ilgili istatistikleri uygulama geliştiricilerle paylaşmasına izin vererek uygulama geliştiricilerin uygulamalarını iyileştirmelerine yardımcı olun.\n\nApple’ın Gizlilik Politikası hakkında daha fazla bilgi için https://www.apple.com/tr/privacy/ adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоможіть розробникам удосконалювати програми, дозволивши Apple поширювати для них усі дані про збої, а також статистику використання їхніх програм.\n\nДокладні відомості про Політику конфіденційності Apple наведено на https://www.apple.com/ua/privacy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp nhà phát triển ứng dụng cải thiện ứng dụng của họ bằng cách cho phép Apple chia sẻ với họ bất kỳ dữ liệu sự cố nào và số liệu thống kê về cách bạn sử dụng ứng dụng của họ.\n\nTìm hiểu thêm về Chính sách quyền riêng tư của Apple, hãy xem https://www.apple.com/vn/privacy/"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许Apple将崩溃数据和与你使用App的方式相关的统计数据共享给App开发者，以帮助开发者改进App。\n\n若要进一步了解Apple的“隐私政策”，请参阅https://www.apple.com/cn/privacy/"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許Apple與App開發者分享任何當機資料和使用方式統計資料，以幫助改善他們的App。\n\n如要進一步了解Apple私隱政策，請參閲網站：https://www.apple.com/hk/privacy"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許Apple與App開發者分享當機資料和App使用方式的統計資料，來協助他們改善App。\n\n若要進一步瞭解Apple的「隱私權政策」，請參閱：https://www.apple.com/tw/privacy/。"
          }
        }
      }
    },
