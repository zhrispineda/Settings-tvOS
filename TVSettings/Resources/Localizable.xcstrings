    "GameCenterAllowNearbyPlayersDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للاعبي Game Center القريبين بالعثور عليك ودعوتك أنت وأي مستخدم على هذا الـ Apple TV للألعاب متعددة اللاعبين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que els jugadors del Game Center propers trobin qualsevol usuari d’aquest Apple TV i el convidin a partides multijugador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní hráči v Game Centru budou moct vyhledat kteréhokoli uživatele této Apple TV a pozvat ho k hrám pro více hráčů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-spillere i nærheden må finde og invitere brugere på dette Apple TV til multiplayer-spil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-Spieler:innen in der Nähe dürfen jede:n Benutzer:in auf diesem Apple TV finden und zu Mehrspielerspielen einladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κοντινοί παίκτες Game Center θα μπορούν να βρίσκουν και να προσκαλούν οποιονδήποτε χρήστη σε παιχνίδια πολλών παικτών σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow nearby Game Center players to find and invite any user on this Apple TV to multiplayer games."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow nearby Game Center players to find and invite any user on this Apple TV to multiplayer games."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow nearby Game Center players to find and invite any user on this Apple TV to multiplayer games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los jugadores de Game Center que están cerca puedan encontrar e invitar a jugar a cualquier usuario de este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los jugadores de Game Center que estén cerca puedan encontrar e invitar a jugar a cualquier usuario de este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los jugadores de Game Center que estén cerca puedan encontrar e invitar a jugar a cualquier usuario de este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli lähellä olevien Game Center -pelaajien etsiä keitä tahansa tämän Apple TV:n käyttäjiä ja kutsua heidät moninpeleihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les joueurs Game Center à proximité à inviter les utilisateurs de cette Apple TV à des jeux multijoueurs."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les joueurs Game Center à proximité à inviter un utilisateur de cette Apple TV à des jeux multijoueurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר לשחקני Game Center בסביבה לחפש משתמשים ב-Apple TV זה ולהזמין משתמשים אלה למשחקים מרובי-משתתפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास के Game Center खिलाड़ियों को इस Apple TV पर किसी भी यूज़र को ढूँढने और मल्टीप्लेयर गेम में आमंत्रित करने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite obližnjim Game Center igračima pronalaženje i pozivanje bilo kojeg igrača na ovom Apple TV-u na igranje igara s više igrača."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közeli Game Center-játékosok megkereshetnek és meghívhatnak bármilyen felhasználót ezen az Apple TV-n többszemélyes játékokba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan pemain Game Center di sekitar untuk menemukan dan mengundang semua pengguna di Apple TV ini ke game multipemain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti ai giocatori su Game Center nelle vicinanze di trovare e invitare qualsiasi utente di questa Apple TV a partite multiplayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのGame CenterプレイヤーからこのApple TVのユーザに対するマルチプレイゲームの参加依頼を受け付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처에 있는 Game Center 플레이어가 이 Apple TV의 사용자를 찾고 멀티플레이어 게임에 초대할 수 있도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan pemain Game Center berdekatan mencari dan menjemput mana-mana pengguna pada Apple TV ini ke permainan berbilang pemain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at Game Center-spillere i nærheten kan se og invitere alle brukere på Apple TV til flerspillerspill."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-spelers in de buurt mogen elke gebruiker op deze Apple TV vinden en uitnodigen voor multiplayergames."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobliscy gracze Game Center mogą znajdować i zapraszać do gier wieloosobowych dowolnego użytkownika tego Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que jogadores do Game Center por perto encontrem e convidem qualquer usuário desta Apple TV para jogos multiplayer."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que jogadores do Game Center que estejam por perto encontrem e enviem convites a qualquer utilizador nesta Apple TV para jogos multijogador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți jucătorilor Game Center din apropiere să găsească și să invite orice utilizator al acestui Apple TV la jocuri multiplayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить ближайшим игрокам Game Center находить и приглашать любого пользователя этого Apple TV на многопользовательские игры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní hráčom Game Center vo vašom okolí vyhľadať a pozvať akéhokoľvek hráča na tomto Apple TV do hier pre viac hráčov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bližnjim igralcem v omrežju Game Center omogočite, da poiščejo kateregakoli uporabnika tega Apple TV-ja in ga povabijo v večigralske igre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Game Center-spelare i närheten att hitta och bjuda in alla användare på denna Apple TV till multiplayerspel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตผู้เล่น Game Center ใกล้เคียงให้ค้นหาและเชิญผู้ใช้ที่มีอยู่บน Apple TV เครื่องนี้เพื่อเล่นเกมที่เล่นได้หลายคนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki Game Center oyuncuları bu Apple TV’deki herhangi bir kullanıcıyı bulup çok oyunculu oyunlara davet edebilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити гравцям Game Center поблизу знаходити й запрошувати до гуртових ігор будь-якого користувача цього Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép người chơi Game Center gần bạn tìm và mời bất kỳ người dùng nào trên Apple TV này chơi trò chơi nhiều người chơi."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许周围的Game Center玩家找到并邀请此Apple TV上的任何用户加入多人游戏。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許附近的Game Center玩家尋找並邀請此Apple TV上的任何用户參與多人遊戲。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許附近的Game Center玩家尋找並邀請此Apple TV上的任何使用者加入多人遊戲。"
          }
        }
      }
    },
