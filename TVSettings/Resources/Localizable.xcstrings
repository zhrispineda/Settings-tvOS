        },
        "en_GB": {
          "stringUnit": {
            "value": "Use taps instead of presses to navigate with Apple TV Remote.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Use taps instead of presses to navigate with Apple TV remote.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Toca en vez de pulsar para navegar con el mando del Apple TV.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
