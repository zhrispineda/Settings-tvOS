        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסך הבית יתרענן לאחר שינוי השפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी भाषा बदलने पर आपका होम स्क्रीन रीफ़्रेश हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Početni zaslon osvježit će se kad promijenite jezik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Főképernyője a nyelv módosításakor frissítve lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar Utama akan disegarkan setelah Anda mengubah bahasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificando la lingua, la schermata Home si aggiornerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を変更するとホーム画面がリフレッシュされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어를 변경하면 홈 화면이 새로 고쳐집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin Utama anda akan disegarkan semula apabila anda menukar bahasa anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjem-skjermen din lastes inn på nytt når du endrer språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beginscherm wordt vernieuwd wanneer je je taal wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana języka spowoduje odświeżenie ekranu głównego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tela de Início será atualizada quando você alterar o idioma."
          }
        },
