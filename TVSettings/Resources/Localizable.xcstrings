            "value": "Voeg een aangepast bericht toe aan de instructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do instrukcji własną wiadomość."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma mensagem personalizada às instruções."
          }
        },
        "pt_PT": {
          "stringUnit": {
