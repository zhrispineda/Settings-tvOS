          "stringUnit": {
            "state": "translated",
            "value": "Частота %@ используется на телевизорах в некоторых странах Европы и Азии, а также в других регионах, где действует стандарт PAL или SECAM."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je štandard na televízoroch v niektorých častiach Európy, v Ázii a v ďalších regiónoch, v ktorých sa používa formát PAL alebo SECAM."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je standard v televizorjih v delih Evrope, v Aziji in drugih regijah, ki uporabljajo PAL ali SECAM."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är standard på TV-apparater i delar av Europa, Asien och andra regioner som använder PAL eller SECAM."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@เป็นความถี่มาตรฐานทางโทรทัศน์ในส่วนต่างๆ ของยุโรป เอเชีย และภูมิภาคอื่นที่ใช้ PAL หรือ SECAM"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; Avrupa’nın, Asya’nın ve PAL veya SECAM kullanan diğer bölgelerin bazı yerlerinde televizyonlardaki standarttır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота %@ використовується на телевізорах у країнах Європи, Азії та інших регіонів, де використовується стандарт PAL або SECAM."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là tốc độ tiêu chuẩn trên các tivi tại một phần của Châu Âu, Châu Á và các vùng khác đang sử dụng PAL hoặc SECAM."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用PAL或SECAM的部分欧洲、亚洲和其他地区，%@是电视的标准。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是歐洲部份地區、亞洲和其他使用PAL或SECAM地區的電視的標準。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用PAL或SECAM的部分歐洲、亞洲和其他地區，%@為電視的標準。"
          }
        }
      }
    },
