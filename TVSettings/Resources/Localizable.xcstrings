    "NumberingSystemChangeRestartWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تحديث الشاشة الرئيسية عند تغيير نظام الأرقام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan canviïs el sistema de numeració, la pantalla d’inici s’actualitzarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po změně systému číslování se aktualizuje plocha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din hjemmeskærm opdateres, når du ændrer nummereringssystemet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Home-Bildschirm wird aktualisiert, wenn du das Zahlensystem änderst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη Αφετηρίας θα ανανεωθεί όταν αλλάξετε το σύστημα αρίθμησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home Screen will refresh when you change your numbering system."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home Screen will refresh when you change your numbering system."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home Screen will refresh when you change your numbering system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de inicio se actualizará cuando cambies el sistema de numeración."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de inicio se actualizará cuando cambies el sistema de numeración."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de inicio se actualizará cuando cambies el sistema de numeración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koti-valikko päivitetään, kun vaihdat numerojärjestelmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran d’accueil sera actualisé lorsque vous changerez de système de numérotation."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran d’accueil se mettra à jour si vous changez de système de numération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסך הבית יתרענן לאחר שינוי שיטת המספור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप अपनी अंक पद्धति को बदलेंगे, तो आपकी होम स्क्रीन रीफ़्रेश हो जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Početni zaslon osvježit će se kad promijenite brojevni sustav."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Főképernyője a számozási rendszer módosításakor frissítve lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar Utama Anda akan disegarkan setelah Anda mengubah sistem penomoran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificando il sistema di numerazione, la schermata Home si aggiornerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号システムを変更するとホーム画面がリフレッシュされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호 시스템을 변경하면 홈 화면이 새로 고쳐집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin Utama anda akan disegarkan semula apabila anda menukar sistem penomboran anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjem-skjermen din lastes inn på nytt når du endrer tallsystem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beginscherm wordt vernieuwd wanneer je je nummersysteem wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana systemu numerowania spowoduje odświeżenie ekranu głównego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tela de Início será atualizada quando você alterar o sistema de numeração."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã principal será atualizado se alterar o sistema de numeração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul principal va fi actualizat la schimbarea sistemului de numerotare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене системы счисления экран «Домой» обновится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri zmene systému číslovania dôjde k osvieženiu plochy."
