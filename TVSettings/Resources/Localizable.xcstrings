    "CrossAppTrackingAllowAppsToRequestToTrackDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للتطبيقات بطلب تتبع نشاطك في التطبيقات والمواقع الإلكترونية التابعة لشركات أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que les apps et demanin permís per rastrejar la teva activitat en apps i llocs web de tercers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace budou moct žádat o povolení ke sledování vaší aktivity v aplikacích a na webových stránkách jiných společností."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps må anmode om at spore din aktivitet på tværs af andre virksomheders apps og websteder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Apps, deine Erlaubnis für das Erfassen deiner Aktivitäten in Apps und auf Websites anderer Unternehmen anzufordern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπεται σε εφαρμογές να ζητούν άδεια για ανίχνευση της δραστηριότητάς σας σε εφαρμογές και ιστότοπους άλλων εταιρειών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps to ask to track your activity across other companies’ apps and websites."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps to ask to track your activity across other companies’ apps and websites."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps to ask to track your activity across other companies’ apps and websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps soliciten realizar un seguimiento de tu actividad en los sitios web y en las apps de otras empresas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps soliciten rastrear tu actividad en sitios web y apps de otras empresas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps soliciten rastrear tu actividad en sitios web y apps de otras empresas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli appien pyytää seurata toimintaasi muiden yritysten apeissa ja sivustoilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les apps à vous demander la permission de suivre vos activités dans les apps et sur les sites web d’autres sociétés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les apps à demander de suivre votre activité dans les apps et sur les sites Web d’autres entreprises."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלה של הגדרה זו מאפשרת ליישומים לבקש לעקוב אחר הפעילות שלך ביישומים ואתרים של חברות אחרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स को अन्य कंपनियों के ऐप्स और वेबसाइट पर आपकी ऐक्टिविटी ट्रैक करने के लिए अनुरोध करने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite aplikacijama da vas mogu zatražiti praćenje vaše aktivnosti na aplikacijama i web stranicama drugih tvrtki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezheti, hogy az appok engedélyt kérjenek az Ön más vállalatok appjaiban és webhelyein végzett tevékenységének követésére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan app untuk meminta izin melacak aktivitas Anda di app dan situs web perusahaan lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alle app di chiederti di tenere traccia delle attività che svolgi nelle app e sui siti web di altre aziende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが他社のアプリやWebサイトを横断してあなたのアクティビティをトラッキングすることを要求できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다른 회사의 앱 및 웹사이트에서 사용자의 활동 추적을 요청할 수 있도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan app meminta untuk menjejak aktiviti anda merentas app dan tapak web syarikat lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at apper kan be om å spore aktiviteten din på tvers av andre selskapers apper og nettsteder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat apps vragen om je activiteit te tracken in apps en websites van andere bedrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól aplikacjom prosić o zgodę na śledzenie Twojej aktywności w aplikacjach i witrynach innych firm."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que apps peçam para rastrear suas atividades entre apps e sites de outras empresas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que as aplicações peçam para seguir a sua atividade nos sites e aplicações de outras empresas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți aplicațiilor să vă ceară permisiunea de a vă urmări activitatea în aplicațiile și pe site‑urile altor companii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить приложениям спрашивать, можно ли отслеживать Ваши действия в приложениях и на сайтах других компаний."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolí apkám žiadať o sledovanie vašich aktivít v apkách a na webových stránkach iných spoločností."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite aplikacijam, da sledijo vaši aktivnosti v aplikacijah in na spletnih mestih drugih podjetij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att appar ber om att få spåra din aktivitet mellan andra företags appar och webbplatser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้แอปขอติดตามกิจกรรมของคุณบนแอปและเว็บไซต์ของบริษัทอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar, diğer şirketlerin uygulamalarındaki ve web sitelerindeki eylemlerinizi takip etmek için izin isteyebilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити програмам запитувати дозвіл на відстеження ваших дій у програмах і на вебсайтах інших компаній."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép các ứng dụng xin phép theo dõi hoạt động của bạn trên các ứng dụng và trang web của các công ty khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许App请求跟踪你在其他公司的App及网站上的活动。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許App要求追蹤你在其他公司的App和網站上的活動。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許App請求許可來追蹤你在其他公司App和網站的活動。"
          }
        }
      }
    },
