        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να αφαιρέσετε τον λογαριασμό περιοριστικού περιβάλλοντος %@ από αυτό το Apple TV;"
          }
        },
        "en": {
