          "stringUnit": {
            "state": "translated",
            "value": "Acest buton este deja utilizat. Încercați alt buton."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта кнопка уже используется. Попробуйте выбрать другую кнопку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto tlačidlo sa už používa. Skúste to s iným tlačidlom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta gumb je že v uporabi. Poskusite z drugim gumbom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här knappen används redan. Försök med en annan knapp."
          }
