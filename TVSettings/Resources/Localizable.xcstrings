    "WHASetupInstructions": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١.\tافتح قفل iPhone أو iPad.\n‏٢.\tشغل Bluetooth على جهازك.\n‏٣.\tقرّب الجهاز من هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueja l’iPhone o l’iPad.\n2.\tActiva el Bluetooth al dispositiu.\n3.\tMantén el dispositiu a prop de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdemkněte iPhone nebo iPad.\n2.\tZapněte na svém zařízení Bluetooth.\n3.\tPodržte zařízení u Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås din iPhone eller iPad op.\n2.\tSlå Bluetooth til på din enhed.\n3.\tHold enheden tæt på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tEntsperre dein iPhone oder iPad.\n2.\tAktiviere Bluetooth auf deinem Gerät.\n3.\tHalte das Gerät dicht an das Apple TV."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tΞεκλειδώστε το iPhone ή το iPad σας.\n2.\tΕνεργοποιήστε το Bluetooth στη συσκευή σας.\n3.\tΚρατήστε τη συσκευή κοντά σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tTurn on Bluetooth on your device.\n3.\tHold the device close to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tTurn on Bluetooth on your device.\n3.\tHold the device close to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock your iPhone or iPad.\n2.\tTurn on Bluetooth on your device.\n3.\tHold the device close to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tActiva Bluetooth en tu dispositivo.\n3.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tActiva Bluetooth en tu dispositivo.\n3.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea tu iPhone o iPad.\n2.\tActiva Bluetooth en tu dispositivo.\n3.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tAvaa iPhonesi tai iPadisi.\n2.\tLaita Bluetooth päälle laitteessa.\n3.\tPidä laitetta Apple TV:n lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tActivez le Bluetooth sur votre appareil.\n3.\tPlacez l’appareil près de cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez votre iPhone ou iPad.\n2.\tActivez Bluetooth sur votre appareil.\n3.\tTenez l’appareil à proximité de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tיש לבטל את נעילת ה-iPhone או ה-iPad.\n‏2.\tיש להפעיל את Bluetooth במכשיר.\n‏3.\tיש להחזיק את המכשיר קרוב ל-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tअपना iPhone या iPad अनलॉक करें।\n2.\tअपने डिवाइस पर Bluetooth चालू करें।\n3.\tडिवाइस को इस Apple TV के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOtključajte svoj iPhone ili iPad.\n2.\tUključite Bluetooth na svom uređaju.\n3.\tDržite uređaj blizu ovog Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOldja fel az iPhone-ját vagy az iPadjét.\n2.\tKapcsolja be a Bluetootht az eszközén.\n3.\tTartsa közel az eszközt az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka iPhone atau iPad Anda.\n2.\tNyalakan Bluetooth di perangkat Anda.\n3.\tDekatkan perangkat ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tSblocca iPhone o iPad.\n2.\tAttiva il Bluetooth sul dispositivo.\n3.\tAvvicina il dispositivo ad Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhoneまたはiPadをロック解除します。\n2.\tお使いのデバイスでBluetoothをオンにします。\n3.\tデバイスをこのApple TVに近付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone 또는 iPad를 잠금 해제하십시오.\n2.\t사용자의 기기에서 Bluetooth를 켜십시오.\n3.\t해당 기기를 이 Apple TV 가까이 들고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka kunci iPhone atau iPad anda.\n2.\tAktifkan Bluetooth pada peranti anda.\n3.\tPegang peranti berdekatan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås opp iPhonen eller iPaden.\n2.\tSlå på Bluetooth på enheten.\n3.\tHold enheten nær Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOntgrendel je iPhone of iPad.\n2.\tSchakel Bluetooth in op je apparaat.\n3.\tHoud het apparaat dicht bij deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdblokuj swojego iPhone’a lub iPada.\n2.\tWłącz Bluetooth na urządzeniu.\n3.\tZbliż urządzenie do Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o seu iPhone ou iPad.\n2.\tAtive o Bluetooth no dispositivo.\n3.\tAproxime o dispositivo desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o iPhone ou iPad.\n2.\tAtive o Bluetooth no dispositivo.\n3.\tMantenha o dispositivo perto desta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDeblocați‑vă iPhone‑ul sau iPad‑ul.\n2.\tActivați Bluetooth pe dispozitiv.\n3.\tȚineți dispozitivul aproape de acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tРазблокируйте свой iPhone или iPad.\n2.\tВключите Bluetooth на устройстве.\n3.\tДержите устройство вблизи этого Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdomknite svoj iPhone alebo iPad.\n2.\tZapnite Bluetooth na zariadení.\n3.\tPodržte zariadenie pri Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdklenite svoj iPhone ali iPad.\n2.\tVklopite Bluetooth v svoji napravi.\n3.\tNapravo približajte Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås upp iPhone eller iPad.\n2.\tSlå på Bluetooth på enheten.\n3.\tHåll enheten nära denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tปลดล็อค iPhone หรือ iPad ของคุณ\n2.\tเปิดบลูทูธบนอุปกรณ์ของคุณ\n3.\tถืออุปกรณ์ไว้ใกล้กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tiPhone’unuzun ya da iPad’inizin kilidini açın.\n2.\tAygıtınızda Bluetooth’u açın.\n3.\tAygıtı bu Apple TV’ye yakın tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tВідімкніть свій iPhone чи iPad.\n2.\tУвімкніть Bluetooth на пристрої.\n3.\tПіднесіть пристрій до цього Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tMở khóa iPhone hoặc iPad của bạn.\n2.\tBật Bluetooth trên thiết bị của bạn.\n3.\tGiữ thiết bị gần Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解锁你的iPhone或iPad。\n2.\t打开设备上的蓝牙。\n3.\t将设备靠近此Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t開啟你裝置上的藍牙。\n3.\t將裝置靠近此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t解鎖你的iPhone或iPad。\n2.\t在裝置上開啟藍牙。\n3.\t將裝置靠近此Apple TV。"
          }
        }
      }
    },
