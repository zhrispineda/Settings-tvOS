    "BluetoothDevicePoorBehaviorDescriptionFormat_WIFI": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤثر استخدام\" %@\" على اتصال Wi-Fi و Bluetooth. لمزيد من المعلومات، يرجى زيارة:\nhttps://support.apple.com/tv/bluetooth"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El fet d’utilitzar el dispositiu “%@” pot afectar la connectivitat Wi‑Fi o Bluetooth. Per obtenir més informació, ves a https://support.apple.com/tv/bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití zařízení „%@“ může mít negativní vliv na kvalitu připojení přes Wi‑Fi a Bluetooth. Další informace najdete na https://support.apple.com/tv/bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug af “%@” kan påvirke Wi-Fi- og Bluetooth-forbindelsen. Du kan finde flere oplysninger på https://support.apple.com/tv/bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verwendung von „%@“ kann WLAN- und Bluetooth-Verbindungen beeinflussen. Weitere Informationen erhältst du unter https://support.apple.com/tv/bluetooth."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χρήση του «%@» μπορεί να επηρεάσει τη συνδεσιμότητα Wi-Fi και Bluetooth. Για περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση https://support.apple.com/tv/bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using “%@” may affect Wi-Fi and Bluetooth connectivity. Visit https://support.apple.com/tv/bluetooth for more information."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Using “%@” may affect Wi-Fi and Bluetooth connectivity. For more information, go to support.apple.com/tv/bluetooth"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using “%@” may affect Wi-Fi and Bluetooth connectivity. Visit https://support.apple.com/tv/bluetooth for more information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas “%@”, puede que la conectividad Wi‑Fi y Bluetooth se vean afectadas. Visita https://support.apple.com/tv/bluetooth para obtener más información."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar “%@” podría afectar las conexiones Wi-Fi y Bluetooth. Para obtener más información, visita: https://support.apple.com/tv/bluetooth."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar “%@” podría afectar las conexiones Wi-Fi y Bluetooth. Para obtener más información, visita: https://support.apple.com/tv/bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saattaa haitata Wi‑Fi- ja Bluetooth-yhteyttä. Lisätietoja on osoitteessa https://support.apple.com/tv/bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation de « %@ » peut affecter les connexions Wi-Fi et Bluetooth. Consultez la page https://support.apple.com/tv/bluetooth pour en savoir plus."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation de « %@ » peut affecter les connectivités Wi‑Fi et Bluetooth. Rendez-vous sur https://support.apple.com/tv/bluetooth pour en savoir plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השימוש ב-״%@״ עשוי להשפיע על הקישוריות של רשתות אלחוטיות ו-Bluetooth. מידע נוסף זמין בכתובת: https://support.apple.com/tv/bluetooth."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” का इस्तेमाल वाई-फ़ाई और Bluetooth कनेक्टिविटी को प्रभावित कर सकता है। अधिक जानकारी के लिए https://support.apple.com/tv/bluetooth पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba uređaja “%@” može utjecati na povezivost Wi-Fija i Bluetootha. Posjetite https://support.apple.com/tv/bluetooth za više informacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” használata hatással lehet a Wi‑Fi- és a Bluetooth-kapcsolatra. További tudnivalókért látogasson el a https://support.apple.com/tv/bluetooth weboldalra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konektivitas Wi-Fi dan Bluetooth dapat terpengaruh jika “%@” digunakan. Kunjungi https://support.apple.com/tv/bluetooth untuk informasi lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilizzo di “%@” potrebbe influire sulla connettività di Wi‑Fi e Bluetooth. Per ulteriori informazioni, visita la pagina https://support.apple.com/tv/bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を使用するとWi‑FiとBluetooth接続に影響する可能性があります。詳しくは、https://support.apple.com/tv/bluetooth を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 사용하면 Wi-Fi 및 Bluetooth 연결에 영향을 줄 수 있습니다. 자세한 정보는 https://support.apple.com/tv/bluetooth 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan “%@” mungkin mempengaruhi ketersambungan Wi‑Fi dan Bluetooth. Lawati https://support.apple.com/en-my/HT211232?cid=mc-ols-appletv-article_ht208237-tvos_ui-08032020 untuk mendapatkan maklumat lanjut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk av «%@» kan påvirke Wi‑Fi- og Bluetooth-tilkoblingen. Se mer informasjon på https://support.apple.com/tv/bluetooth."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je '%@' gebruikt, kan dit je wifi- en Bluetooth-verbinding beïnvloeden. Ga naar https://support.apple.com/tv/bluetooth voor meer informatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używanie „%@” może zakłócać połączenia Wi‑Fi lub Bluetooth. Aby uzyskać więcej informacji, odwiedź stronę https://support.apple.com/tv/bluetooth."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso de “%@” pode afetar a conectividade Wi‑Fi e Bluetooth. Para saber mais, visite https://support.apple.com/tv/bluetooth."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A utilização de “%@” pode afetar a conectividade Wi‑Fi e Bluetooth. Encontrará informação adicional em https://support.apple.com/tv/bluetooth."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizarea „%@” poate afecta conectivitatea Wi‑Fi și Bluetooth. Vizitați https://support.apple.com/tv/bluetooth pentru informații suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование устройства «%@» может повлиять на подключение к Wi‑Fi и Bluetooth. Подробнее: https://support.apple.com/tv/bluetooth."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používanie „%@“ môže negatívne ovplyvniť Wi-Fi a Bluetooth pripojenie. Viac informácií nájdete na stránke https://support.apple.com/tv/bluetooth."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba naprave »%@« lahko vpliva na povezljivost Wi-Fi in Bluetooth. Obiščite https://support.apple.com/tv/bluetooth za več informacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du använder ”%@” kan det påverka Wi‑Fi- och Bluetooth-anslutningar. Besök https://support.apple.com/tv/bluetooth för mer information."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้ “%@” อาจมีผลต่อการเชื่อมต่อกับ Wi‑Fi และบลูทูธ ให้ไปที่ https://support.apple.com/tv/bluetooth สำหรับข้อมูลเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” aksesuarını kullanmak Wi-Fi ve Bluetooth bağlantılarını etkileyebilir. Daha fazla bilgi için https://support.apple.com/tv/bluetooth adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання «%@» може вплинути на якість зʼєднання через Wi‑Fi чи Bluetooth. Додаткову інформацію наведено на вебсторінці https://support.apple.com/tv/bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc sử dụng “%@” có thể ảnh hưởng đến khả năng kết nối Wi-Fi và Bluetooth. Hãy truy cập https://support.apple.com/tv/bluetooth để biết thêm thông tin."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“%@”可能会影响Wi-Fi和蓝牙连接性。若要了解更多信息，请访问https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「%@」可能會影響Wi-Fi和藍牙的連線能力。詳情請到訪：https://support.apple.com/tv/bluetooth。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「%@」可能會影響Wi-Fi和藍牙的連線。請參訪https://support.apple.com/tv/bluetooth以取得更多資訊。"
          }
        }
      }
    },
