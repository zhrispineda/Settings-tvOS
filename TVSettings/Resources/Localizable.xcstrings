    "LanguageAddNewLanguageMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يستخدم \"%@\" لغتك الأساسية. وستكون اللغات الإضافية متوفرة للوحات المفاتيح والتطبيقات غير المتوفرة بلغتك الأساسية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositiu “%@” utilitzarà l’idioma principal. Podràs fer servir altres idiomes al teclat i a les apps que no estiguin disponibles en l’idioma principal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bude používat váš primární jazyk. Pro klávesnici a aplikace, které nejsou v primárním jazyce dostupné, budou k dispozici jiné jazyky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” vil bruge dit primære sprog. Ekstra sprog vil være tilgængelige for dit tastatur og de apps, som ikke er tilgængelige på dit primære sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verwendet deine primäre Sprache. Zusätzliche Sprachen sind für deine Tastatur und Apps verfügbar, die eine andere als deine primäre Sprache verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» θα χρησιμοποιεί την κύρια γλώσσα σας. Οι πρόσθετες γλώσσες θα είναι διαθέσιμες για το πληκτρολόγιό σας και για εφαρμογές που δεν είναι διαθέσιμες στην κύρια γλώσσα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will use your primary language. Additional languages will be available for your keyboard and apps not available in your primary language."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will use your primary language. Additional languages will be available for your keyboard and apps not available in your primary language."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will use your primary language. Additional languages will be available for your keyboard and apps not available in your primary language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo “%@” usará tu idioma principal. Los demás idiomas estarán disponibles para el teclado y para las apps no compatibles con tu idioma principal."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” usará tu idioma principal. Habrá idiomas adicionales disponibles para tu teclado y para las apps que no estén disponibles en tu idioma principal."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” usará tu idioma principal. Habrá idiomas adicionales disponibles para tu teclado y para las apps que no estén disponibles en tu idioma principal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käyttää ensisijaista kieltä. Lisää kieliä on saatavilla näppäimistölle ja apeille, jotka eivät ole saatavilla ensisijaisella kielellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilisera votre langue principale. D’autres langues seront disponibles pour votre clavier et pour les apps non disponibles dans votre langue principale."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilisera votre langue principale. D’autres langues seront proposées pour votre clavier et pour les apps qui ne sont pas disponibles dans votre langue principale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השפה העיקרית שלך תשמש את ״%@״. שפות נוספות יהיו זמינות במקלדת וביישומים שאינם זמינים בשפה העיקרית שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” आपकी प्राथमिक भाषा का इस्तेमाल करेगा। आपकी प्राथमिक भाषा में अनुपलब्ध कीबोर्ड और ऐप्स के लिए अतिरिक्त भाषाएँ उपलब्ध होंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” će koristiti vaš primarni jezik. Dodatni jezici bit će dostupni za tipkovnicu i aplikacije koje nisu dostupne na vašem primarnom jeziku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” az Ön által választott elsődleges nyelvet fogja használni. A billentyűzethez és az Ön elsődleges nyelvén nem elérhető appokhoz további nyelvek állnak rendelkezésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” akan menggunakan bahasa utama Anda. Bahasa tambahan akan tersedia untuk papan ketik Anda dan app yang tidak tersedia di bahasa utama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” utilizzerà la lingua principale. Per la tastiera e le app che non la supportano saranno disponibili altre lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”では最優先の言語が使用されます。最優先の言語が使用できないキーボードとアプリでは、追加の言語が使用できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’이(가) 기본 언어를 사용합니다. 기본 언어로는 사용할 수 없는 키보드 및 앱에서는 추가 언어를 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” akan menggunakan bahasa utama anda. Bahasa tambahan akan tersedia untuk papan kekunci anda dan app yang tidak tersedia dalam bahasa utama anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» vil bruke hovedspråket ditt. Andre tilleggsspråk vil være tilgjengelige fra tastaturet og i apper som ikke er tilgjengelige på hovedspråket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' gebruikt je primaire taal. Er zijn extra talen beschikbaar voor je toetsenbord en apps die niet beschikbaar zijn in je primaire taal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” będzie używać Twojego języka podstawowego. Dodatkowe języki będą dostępne dla klawiatur i aplikacji niedostępnych w Twoim języku podstawowym."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” usará seu idioma principal. Idiomas adicionais estarão disponíveis para o seu teclado e para apps não disponíveis no idioma principal."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” usará o idioma principal. Serão disponibilizados idiomas adicionais para o teclado e as aplicações que não estiverem disponíveis no idioma principal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” va utiliza limba dvs. principală. Vor fi disponibile și alte limbi pentru tastatură și pentru aplicațiile care nu sunt disponibile în limba dvs. principală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство «%@» будет использовать Ваш основной язык. Дополнительные языки будут доступны для клавиатуры и приложений, не поддерживающих Ваш основной язык."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV „%@“ bude používať váš primárny jazyk. Pre klávesnicu a apky, ktoré nie sú dostupné v primárnom jazyku, budú k dispozícii iné jazyky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprava »%@« bo uporabljala vaš primarni jezik. Za tipkovnico in aplikacije, ki niso na voljo v primarnem jeziku, bodo na voljo dodatni jeziki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” använder ditt primära språk. Ytterligare språk finns tillgängliga för tangentbordet och appar som inte är tillgängliga på det primära språket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” จะใช้ภาษาหลักของคุณ ภาษาอื่นจะมีสำหรับแป้นพิมพ์และแอปที่ไม่มีในภาษาหลักของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” birincil dilinizi kullanır. Ek diller klavyeniz ve birincil dilinizde olmayan uygulamalar için kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» використовуватиме вашу основну мову. Додаткові мови будуть доступні для клавіатури та програм, недоступних основною мовою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sẽ sử dụng ngôn ngữ chính của bạn. Các ngôn ngữ bổ sung sẽ có sẵn cho bàn phím và các ứng dụng không có sẵn bằng ngôn ngữ chính của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将使用你的主要语言。键盘和未提供主要语言的App将可使用其他语言。"
          }
        },
        "zh_HK": {
          "stringUnit": {
