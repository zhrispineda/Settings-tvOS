        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV es un dispositivo supervisado, de modo que “%@” puede monitorizar el tráfico de internet que hay en él."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" supervisa este Apple TV y puede observar el tráfico de Internet."
