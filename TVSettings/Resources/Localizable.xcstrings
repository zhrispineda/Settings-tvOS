    "APCRDCustomMessageInstructionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر رسالتك المخصصة عندما يكون Apple TV في نمط شاشة عرض غرفة الاجتماعات. لإزالة الرسالة، امسح الحقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El missatge personalitzat apareix quan l’Apple TV està en mode de pantalla de sala de conferències. Per eliminar el missatge, esborra el camp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastní zpráva se zobrazí, když bude na Apple TV aktivní režim Konferenční místnost. Chcete‑li zprávu odstranit, obsah pole smažte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din specielle besked vises, når din Apple TV-enhed bruger funktionen Konferencerumsskærm. Ryd feltet for at fjerne beskeden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mitteilung wird angezeigt, wenn sich dein Apple TV im Modus „Konferenzraum-Display“ befindet. Lösche den Eintrag, um die Mitteilung zu entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προσαρμοσμένο σας μήνυμα εμφανίζεται όταν το Apple TV βρίσκεται στη λειτουργία Οθόνης αίθουσας διασκέψεων. Για αφαίρεση του μηνύματος, εκκαθαρίστε το πεδίο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your custom message appears when your Apple TV is in Conference Room Display mode. To remove the message, clear the field."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your custom message appears when your Apple TV is in Conference Room Display mode. To remove the message, clear the field."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your custom message appears when your Apple TV is in Conference Room Display mode. To remove the message, clear the field."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje personalizado aparecerá cuando el Apple TV se encuentre en el modo “Pantalla de sala de conferencias”. Para eliminar el mensaje, borra el campo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje personalizado se muestra cuando tu Apple TV está en el modo de pantalla de sala de conferencias. Para eliminar el mensaje, borra el campo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje personalizado se muestra cuando tu Apple TV está en el modo de pantalla de sala de conferencias. Para eliminar el mensaje, borra el campo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokattu viesti, joka näytetään, kun Apple TV on Neuvotteluhuoneen näyttö -tilassa. Poista viesti tyhjentämällä kenttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message personnalisé est affiché lorsque votre Apple TV est en mode « Affichage Salle de conférence ». Pour supprimer le message, effacez ce champ."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message personnalisé s’affiche lorsque votre Apple TV est en mode Affichage Salle de conférence. Pour supprimer le message, effacez ce champ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההודעה המותאמת באופן אישי מופיעה כאשר ה-Apple TV נמצא במצב ״תצוגת חדר ועידה״. כדי להסיר את ההודעה יש לנקות את השדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कस्टम संदेश तब प्रदर्शित होता है जब आपका Apple TV सम्मेलन कक्ष डिस्प्ले मोड में रहता है। संदेश हटाने के लिए फ़ील्ड साफ़ करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša prilagođena poruka prikazuje se kad je Apple TV u modu zaslona konferencijske sobe. Za uklanjanje poruke očistite polje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni üzenete akkor jelenik meg, amikor az Apple TV Konferenciaterem megjelenítési módban van. Az üzenet eltávolításához törölje a mező tartalmát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan khusus Anda akan muncul saat Apple TV Anda berada dalam mode Layar Ruang Konferensi. Untuk menghapus pesan, bersihkan bidang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio personalizzato compare quando Apple TV è in modalità “Schermo sala conferenze”. Per rimuoverlo, cancella il contenuto dal campo di testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVが会議室ディスプレイモードのときには、独自のメッセージが表示されます。メッセージを削除するには、フィールドを消去してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 회의실 디스플레이 모드인 경우 사용자 설정 메시지가 나타납니다. 메시지를 제거하려면 필드를 지우십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej tersuai anda kelihatan apabila Apple TV anda dalam mod Paparan Bilik Persidangan. Untuk mengeluarkan mesej, kosongkan medan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tilpassede meldingen vises når Apple TV er i møteromsskjermmodus. Tøm feltet for å fjerne meldingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aangepaste bericht wordt weergegeven wanneer je Apple TV de vergaderruimteweergavemodus gebruikt. Om het bericht te verwijderen, wis je het veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja własna wiadomość jest wyświetlana, gdy Apple TV działa w trybie pokazu w sali konferencyjnej. Aby usunąć tę wiadomość, wymaż pole."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem personalizada aparece quando a Apple TV está no modo de Tela de Sala de Conferência. Para remover a mensagem, deixe o campo em branco."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem personalizada é apresentada quando a Apple TV está no modo de ecrã sala de conferência. Para remover a mensagem, limpe o campo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajul dvs. personalizat apare atunci când Apple TV‑ul este în modul „Afișaj sală de conferințe”. Pentru a elimina mesajul, degajați câmpul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательское сообщение появится на экране Apple TV в режиме «Монитор в конференц‑зале». Чтобы удалить это сообщение, очистите экран."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastná správa sa na Apple TV zobrazí v režime Konferenčná miestnosť. Ak chcete odstrániť vlastnú správu, vymažte pole."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše prilagojeno sporočilo se prikaže, ko je Apple TV v načinu konferenčne sobe. Če želite odstraniti sporočilo, počistite polje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt anpassade meddelande visas när Apple TV är i läget Konferensrumsskärm. Ta bort meddelandet genom att rensa fältet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่กำหนดเองของคุณจะแสดงขึ้นมาเมื่อ Apple TV ของคุณอยู่ในโหมดจอแสดงผลห้องประชุม ให้ล้างช่องป้อนข้อความในการเอาข้อความออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel mesajınız, Apple TV’niz Konferans Odası Görüntüsü modundayken görünür. Mesajı kaldırmak için alanı temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власне повідомлення зʼявляється, коли Apple TV перебуває в режимі Конференц-дисплея. Щоб вилучити повідомлення, очистьте це поле."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo tùy chỉnh của bạn xuất hiện khi Apple TV của bạn ở chế độ Màn hình phòng hội nghị. Để xóa thông báo, hãy xóa trường này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV处于“会议室显示器”模式时会显示自定义信息。若要移除信息，请清除该栏。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的自訂訊息會於Apple TV「會議室顯示器」模式中顯示。如要移除訊息，請清除欄位。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當Apple TV處於「會議室顯示器」模式時，便會顯示你的自訂訊息。若要移除訊息，請清除該欄位。"
          }
        }
      }
    },
