    "iCloudBackupEnabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء نسخة احتياطية يدويًا لكل الإعدادات الشخصية التي تحتاج إليها عند استعادة Apple TV. ينشئ iCloud هذه النسخ الاحتياطية التلقائية عندما يكون Apple TV في وضع الإسبات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes una còpia de seguretat automàtica de la configuració personal per restaurar l’Apple TV. L’iCloud fa còpies de seguretat automàtiques quan l’Apple TV està en repòs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna osobní nastavení potřebná pro obnovení Apple TV budou zálohována automaticky. iCloud bude tyto automatické zálohy pořizovat, když bude Apple TV v režimu spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopier automatisk alle de personlige indstillinger, som du skal bruge til at gendanne din Apple TV-enhed. iCloud foretager disse automatiske sikkerhedskopieringer, når Apple TV er på vågeblus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein automatisches Backup aller persönlichen Einstellungen, die zum Wiederherstellen des Apple TV benötigt werden. iCloud erstellt diese automatischen Backups, wenn sich das Apple TV im Ruhezustand befindet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη δημιουργία εφεδρικού αντιγράφου όλων των προσωπικών ρυθμίσεων που απαιτούνται για επαναφορά του Apple TV σας. Το iCloud δημιουργεί αυτά τα εφεδρικά αντίγραφα όταν το Apple TV βρίσκεται σε κατάσταση ύπνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically back up all personal settings you need to restore your Apple TV. iCloud makes these automatic backups when Apple TV is sleeping."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically back up all personal settings you need to restore your Apple TV. iCloud makes these automatic backups when Apple TV is sleeping."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically back up all personal settings you need to restore your Apple TV. iCloud makes these automatic backups when Apple TV is sleeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realiza automáticamente una copia de seguridad de todos los ajustes personales necesarios para restaurar el Apple TV. iCloud guarda las copias de seguridad automáticas mientras el Apple TV está en reposo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura automáticamente la configuración personal que necesites para restaurar tu Apple TV. iCloud realiza estos respaldos automáticos cuando el Apple TV está en reposo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura automáticamente la configuración personal que necesites para restaurar tu Apple TV. iCloud realiza estos respaldos automáticos cuando el Apple TV está en reposo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopioi automaattisesti kaikki henkilökohtaiset asetukset, joita tarvitset Apple TV:n palauttamiseen. iCloud varmuuskopioi ne automaattisesti, kun Apple TV nukkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez automatiquement les réglages personnels dont vous avez besoin pour restaurer votre Apple TV. iCloud effectue ces sauvegardes automatiques quand l’Apple TV est en veille."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez automatiquement tous les réglages personnels dont vous avez besoin pour restaurer votre Apple TV. iCloud effectue ces sauvegardes automatiques lorsque l’Apple TV est en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לגבות באופן אוטומטי את כל ההגדרות האישיות הדרושות לשחזור ה-Apple TV. ‏iCloud מבצע גיבויים אוטומטיים אלו כאשר ה-Apple TV נמצא במצב ״שינה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple TV को रीस्टोर करने के लिए ज़रूरी अपनी सभी व्यक्तिगत सेटिंग का ऑटोमैटिकली बैकअप लें। iCloud ये ऑटोमैटिक बैकअप तब लेता है जब Apple TV स्लीपिंग मोड में हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko sigurnosno kopiranje svih osobnih postavki koje su potrebne za obnavljanje vašeg Apple TV-a. iCloud izrađuje te automatske sigurnosne kopije kad je Apple TV isključen u pripravno stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikus biztonsági mentés készítése a személyes beállításokról, amelyek az Apple TV-je visszaállításához szükségesek. Az iCloud akkor készíti ezeket az automatikus biztonsági mentéseket, amikor az Apple TV alszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan secara otomatis semua pengaturan pribadi yang Anda perlukan untuk memulihkan Apple TV Anda. iCloud membuat cadangan otomatis ini saat Apple TV tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua automaticamente il backup di tutte le impostazioni personali che vuoi ripristinare su Apple TV. iCloud esegue questi backup automatici quando Apple TV è in standby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVを復元するために必要なすべての個人設定を自動でバックアップします。iCloudを使用すると、Apple TVがスリープ状態のときにこれらのバックアップが自動で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV 복원에 필요한 사용자의 모든 개인 설정을 자동으로 백업합니다. iCloud는 Apple TV가 잠자기 상태일 때 자동 백업을 실행합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandarkan secara automatik semua seting peribadi yang anda perlukan untuk memulihkan Apple TV anda. iCloud membuat sandaran automatik ini semasa Apple TV tidur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopier automatisk alle personlige innstillinger du trenger før du gjenoppretter Apple TV. iCloud tar automatisk sikkerhetskopier når Apple TV er i dvale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak automatisch een back-up van alle persoonlijke instellingen die je nodig hebt om gegevens op je Apple TV terug te zetten. Deze automatische back-ups worden in iCloud gemaakt wanneer de Apple TV in de sluimerstand staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backupy wszystkich ustawień wymaganych do odtworzenia Apple TV mogą być tworzone automatycznie. iCloud robi to, gdy Apple TV jest w stanie uśpienia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um backup automático de todos os ajustes pessoais necessários para restaurar a Apple TV. O iCloud realiza esses backups automáticos quando a Apple TV está em repouso."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Efetuar automaticamente a cópia de segurança das definições pessoais necessárias para restaurar a Apple TV. iCloud faz estas cópias de segurança automáticas quando a Apple TV se encontra em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectuați automat backupul tuturor configurărilor personale de care aveți nevoie pentru a restaura Apple TV‑ul. iCloud realizează aceste backupuri automate atunci când Apple TV‑ul este în modul adormire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии всех персональных настроек, необходимых для восстановления Вашего Apple TV, создаются автоматически. Автоматическое резервное копирование выполняется в iCloud, пока Apple TV находится в режиме сна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky zálohuje všetky osobné nastavenia potrebné na obnovenie Apple TV. iCloud tieto automatické zálohy vytvára, keď Apple TV spí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno varnostno kopirajte vse osebne nastavitve, ki jih potrebujete za ponastavitev Apple TV-ja. iCloud izvede to samodejno varnostno kopiranje, ko je Apple TV v načinu spanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopiera automatiskt alla personliga inställningar som du behöver om du vill återskapa Apple TV. Säkerhetskopieringarna sker automatiskt via iCloud när Apple TV är i viloläge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรองข้อมูลการตั้งค่าส่วนตัวทั้งหมดที่คุณต้องใช้กู้คืน Apple TV ของคุณโดยอัตโนมัติ iCloud จะสำรองข้อมูลเหล่านี้โดยอัตโนมัติในตอนที่ Apple TV พักเครื่องอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nizi geri yüklemeniz gerekirse tüm kişisel ayarlarınız otomatik olarak yedeklenir. iCloud, bu otomatik yedeklemeleri Apple TV uyku modundayken yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично створюйте резервну копію всіх особистих параметрів, потрібних для відновлення вашого Apple TV. iCloud автоматично створює такі резервні копії під час сну Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động sao lưu tất cả các cài đặt cá nhân mà bạn cần để khôi phục Apple TV. iCloud tạo ra những bản sao lưu tự động này khi Apple TV đang ngủ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动备份恢复Apple TV时需要的所有个人设置。iCloud会在Apple TV处于睡眠状态时自动备份。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動備份所有還原此Apple TV時所需的個人設定。iCloud會在Apple TV睡眠期間自動進行備份。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動備份所有回復Apple TV時所需的個人設定。iCloud會在Apple TV進入睡眠時自動備份。"
          }
        }
      }
    },
