    "AVSDRColorMappingDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوصى باختيار YCbCr مع معظم التلفزيونات. ويجب أن تكون تنسيقات RGB مطابقة لإعدادات تلفزيونك، كما يجب استخدام كبل HDMI عالي السرعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espai de color YCbCr és el que sol utilitzar la majoria de televisors. Els formats RGB han de coincidir amb la configuració del televisor i cal un cable HDMI d’alta velocitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U většiny televizorů se preferuje YCbCr. RGB formáty by měly odpovídat nastavení televizoru a vyžadují vysokorychlostní HDMI kabel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr foretrækkes til de fleste fjernsyn. RGB-formater bør matches med dine tv-indstillinger og kræver et HDMI-højhastighedskabel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr wird für die meisten Fernsehgeräte bevorzugt. RGB-Formate müssen für die ordnungsgemäße Anzeige an die Einstellungen des Fernsehgeräts angepasst werden und benötigen HDMI-Hochgeschwindigkeitskabel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το YCbCr είναι η προτιμώμενη ρύθμιση για τις περισσότερες τηλεοράσεις. Οι μορφές RGB πρέπει να είναι ίδιες με τις ρυθμίσεις της τηλεόρασής σας και απαιτούν καλώδιο HDMI υψηλής ταχύτητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr is preferred for most TVs. RGB formats should be matched to your TV’s settings, and require a high-speed HDMI cable."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr is preferred for most TVs. RGB formats should be matched to your TV’s settings, and require a high-speed HDMI cable."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr is preferred for most TVs. RGB formats should be matched to your TV’s settings, and require a high-speed HDMI cable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr es el formato de preferencia en la mayoría de los televisores. Los formatos RGB deben ajustarse a la configuración del televisor y requieren un cable HDMI de alta velocidad."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato YCbCr es el más usado por la mayoría de las TV. Los formatos RGB deben ajustarse a la configuración de tu TV y requieren un cable HDMI de alta velocidad."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato YCbCr es el más usado por la mayoría de las TV. Los formatos RGB deben ajustarse a la configuración de tu TV y requieren un cable HDMI de alta velocidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr on sopivin useimmille televisioille. RGB-näyttötilan on vastattava television asetuksia. Lisäksi vaaditaan nopea HDMI-kaapeli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format YCbCr est recommandé pour la plupart des téléviseurs. Les formats RVB doivent être adaptés aux réglages de votre téléviseur et nécessitent un câble HDMI haut débit."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle YCbCr est recommandé pour la plupart des télévisions. Les formats RVB doivent correspondre aux réglages de votre télévision et requièrent un câble HDMI à haut débit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏YCbCr היא השיטה המועדפת עבור רוב הטלוויזיות. פורמטים של RGB מצריכים שימוש בכבל HDMI מהיר ויש להתאימם להגדרות הטלוויזיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr को अधिकतर टीवी के लिए बेहतर माना जाता है। RGB फ़ॉर्मैट आपके टीवी की सेटिंग के अनुरूप होने चाहिए और उनके लिए उच्च गति HDMI केबल की आवश्यकता होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr je preferirani mod za većinu TV prijemnika. RGB formati trebaju odgovarati postavkama vašeg TV prijemnika i zahtijevaju HDMI kabel visoke brzine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az YCbCr a javasolt a legtöbb tévékészülékhez. Az RGB-formátumoknak meg kell felelniük a tévékészüléke beállításainak, és nagysebességű HDMI-kábelt igényelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr lebih diprioritaskan untuk sebagian besar TV. Format RGB harus sama dengan pengaturan TV, dan memerlukan kabel HDMI berkecepatan tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la maggior parte dei televisori, la modalità YCbCr è l’opzione preferita. Per una visualizzazione corretta, è preferibile che i formati RGB siano compatibili con le impostazioni del tuo televisore. È richiesto un cavo HDMI a velocità elevata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどのテレビの場合YCbCrが推奨されます。RGBフォーマットはテレビの設定に合わせる必要がありハイスピードHDMIケーブルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 TV에 YCbCr이 선호됩니다. RGB 포맷은 사용자의 TV 설정과 일치해야 하고 고속 HDMI 케이블이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr diutamakan untuk kebanyakan TV. Format RGB patut dipadankan dengan seting TV anda dan memerlukan kabel HDMI kelajuan tinggi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr foretrekkes på de fleste TV-er. RGB-formater bør samsvare med innstillingene på TV-en, og krever en HDMI-kabel med høy hastighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr heeft de voorkeur voor de meeste tv's. RGB-structuren moeten overeenkomen met de instellingen van je tv en vereisen een HDMI-kabel voor hoge snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku większości telewizorów preferowany jest format YCbCr. Prawidłowe wyświetlanie obrazu wymaga dopasowania formatów RGB do ustawień telewizora oraz użycia kabla HDMI High Speed."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr é o formato preferencial para a maioria das TVs. Os formatos RGB devem corresponder aos ajustes da TV e necessitam de um cabo HDMI de alta velocidade."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr é preferível para a maioria das televisões. Os formatos RGB têm de corresponder às definições da sua televisão e requerem um cabo HDMI de alta velocidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatul YCbCr este preferat pentru majoritatea televizoarelor. Formatele RGB ar trebui să corespundă cu configurările televizorului și este necesar un cablu HDMI de mare viteză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочтительный формат для большинства телевизоров — YCbCr. Форматы RGB должны соответствовать настройкам телевизора. Также для них требуется высокоскоростной кабель HDMI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na väčšine televízorov sa preferuje formát YCbCr. RGB formáty by mali súhlasiť s nastaveniami televízora a vyžadujú vysokorýchlostný HDMI kábel."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr je priporočljiva nastavitev za večino televizorjev. Oblike zapisa RGB morajo biti usklajene z nastavitvami televizorja in zahtevajo visokohitrostni kabel HDMI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr är det bästa alternativet för de flesta TV-apparater. RGB-format bör matchas med dina TV-inställningar och en HDMI-höghastighetskabel krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr เป็นค่าที่ต้องการสำหรับทีวีส่วนใหญ่ รูปแบบ RGB ควรจะตรงกับการตั้งค่าของทีวีของคุณ และต้องใช้สาย HDMI แบบความเร็วสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu TV’de YCbCr tercih edilir. RGB biçimleri TV’nizin ayarlarına uymalıdır ve yüksek hızda HDMI kablosu gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для більшості телевізорів рекомендується використовувати YCbCr. RGB-формати необхідно підлаштовувати до параметрів вашого телевізора й використовувати для них високошвидкісний HDMI‑кабель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr được ưu tiên cho hầu hết các TV. Các định dạng RGB phải khớp với cài đặt của TV và yêu cầu cáp HDMI tốc độ cao."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "YCbCr是大部分电视的首选。RGB格式应与电视设置匹配，且需要高速HDMI线缆。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "大部份電視使用YCbCr。RGB格式需要與你的電視設定配合，並需要高速HDMI連接線。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "大部分的電視偏好YCbCr。RGB格式應該對應你的電視設定，且需要高速HDMI連接線。"
          }
        }
      }
    },
