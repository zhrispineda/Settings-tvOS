    "WHASetupFooter": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أنه قد تم تسجيل دخول جهاز iOS إلى حساب iCloud: ‏%@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que hagis iniciat sessió al dispositiu iOS amb el compte de l’iCloud “%@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte, zda je iOS zařízení přihlášené k účtu na iCloudu %@."
