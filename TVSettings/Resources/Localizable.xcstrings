    "RCRemoteAppInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تطبيق الريموت للتحكم في Apple TV باستخدام iPhone أو iPad أو Apple Watch.\n\nلمعرفة المزيد، انتقل إلى:\nsupport.apple.com/appletv/remote"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza l’app Comandament per controlar l’Apple TV amb l’iPhone, l’iPad o l’Apple Watch.\n\nPer obtenir més informació, ves a support.apple.com/appletv/remote."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV můžete ovládat z iPhonu, iPadu nebo Apple Watch pomocí aplikace Ovladač.\n\nDalší informace najdete na stránce support.apple.com/appletv/remote."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug appen Remote til at betjene din Apple TV-enhed med din iPhone, iPad eller dit Apple Watch.\n\nDer findes flere oplysninger på\nsupport.apple.com/appletv/remote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Remote-App auf deinem iPhone, iPad oder deiner Apple Watch zum Steuern des Apple TV.\n\nWeitere Infos sind unter support.apple.com/appletv/remote erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε την εφαρμογή Remote για έλεγχο του Apple TV με το iPhone, iPad ή Apple Watch σας.\n\nΓια να μάθετε περισσότερα, μεταβείτε στη διεύθυνση support.apple.com/appletv/remote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Remote app to control your Apple TV with your iPhone, iPad, or Apple Watch.\n\nTo learn more, go to support.apple.com/appletv/remote."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Remote app to control your Apple TV with your iPhone, iPad or Apple Watch.\n\nTo learn more, go to support.apple.com/appletv/remote"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Remote app to control your Apple TV with your iPhone, iPad or Apple Watch.\n\nTo learn more, go to support.apple.com/appletv/remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app Mando para controlar el Apple TV con el iPhone, iPad o Apple Watch.\n\nPara más información, visita support.apple.com/appletv/remote."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app Remote para controlar tu Apple TV mediante tu iPhone, iPad o Apple Watch.\n\nObtén detalles en support.apple.com/appletv/remote."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app Remote para controlar tu Apple TV mediante tu iPhone, iPad o Apple Watch.\n\nObtén detalles en support.apple.com/appletv/remote."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa Apple TV:tä iPhonella, iPadilla tai Apple Watchilla Kaukosäädin-apilla.\n\nLisätietoja on osoitteessa support.apple.com/appletv/remote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’app Remote pour contrôler votre Apple TV avec votre iPhone, iPad ou Apple Watch.\n\nPour en savoir plus, accédez à support.apple.com/appletv/remote."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’app Télécommande pour contrôler votre Apple TV avec votre iPhone, iPad ou Apple Watch.\n\nPour en savoir plus, rendez-vous sur support.apple.com/appletv/remote."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להשתמש ביישום ״שלט״ כדי לשלוט ב-Apple TV באמצעות ה-iPhone, ה-iPad או ה-Apple Watch.\n\nפרטים נוספים זמינים בכתובת: support.apple.com/appletv/remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple TV को iPhone, iPad या Apple Watch से नियंत्रित करने के लिए रिमोट ऐप का उपयोग करें।\n\nअधिक जानकारी के लिए support.apple.com/appletv/remote पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite aplikaciju Upravljač za upravljanje Apple TV-om pomoću iPhonea, iPada ili Apple Watcha.\n\nZa dodatne informacije posjetite support.apple.com/appletv/remote."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Remote app használatával az iPhone-jával, iPadjével vagy Apple Watchával vezérelheti az Apple TV-jét.\n\nTovábbi információkért keresse fel a support.apple.com/hu/appletv/remote weboldalt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan app Remote untuk mengontrol Apple TV dengan iPhone, iPad, atau Apple Watch Anda.\n\nUntuk mempelajari lebih lanjut, buka support.apple.com/id/appletv/remote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza l’app Remote per controllare Apple TV con iPhone, iPad o Apple Watch.\n\nPer ulteriori informazioni, vai alla pagina support.apple.com/it/appletv/remote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、またはApple WatchでApple TVを制御するには、リモコンアプリを使用します。\n\n詳しくは、support.apple.com/jp/appletv/remote を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리모컨 앱을 사용하여 iPhone, iPad 또는 Apple Watch로 Apple TV를 제어할 수 있습니다.\n\n더 알아보려면 support.apple.com/appletv/remote 사이트로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan app Remote untuk mengawal Apple TV anda dengan iPhone, iPad atau Apple Watch anda.\n\nUntuk mengetahui lebih lanjut, pergi ke support.apple.com/en-my/HT201664."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Fjernkontroll-appen til å styre Apple TV fra iPhone, iPad eller Apple Watch.\n\nFinn ut mer på support.apple.com/appletv/remote."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de Remote-app om je Apple TV te bedienen met je iPhone, iPad of Apple Watch.\n\nGa voor meer informatie naar support.apple.com/appletv/remote."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja Pilot pozwala sterować Apple TV z iPhone’a, iPada lub Apple Watch.\n\nWięcej informacji możesz znaleźć na stronie https://support.apple.com/pl-pl/HT201664."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o app Remote para controlar a Apple TV com o iPhone, iPad ou Apple Watch.\n\nPara saber mais, visite support.apple.com/appletv/remote."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a aplicação Comando para controlar a Apple TV com o iPhone, iPad ou Apple Watch.\n\nEncontrará informação adicional em support.apple.com/appletv/remote."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizați aplicația Remote pentru a controla Apple TV‑ul cu un iPhone, iPad sau Apple Watch.\n\nPentru mai multe detalii, accesați support.apple.com/appletv/remote."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте Apple TV с iPhone, iPad или Apple Watch с помощью приложения «Пульт».\n\nПодробнее: support.apple.com/appletv/remote."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apka Ovládač slúži na ovládanie Apple TV pomocou iPhonu, iPadu alebo Apple Watch.\n\nViac informácií nájdete na stránke support.apple.com/sk/appletv/remote."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za upravljanje Apple TV-ja uporabite aplikacijo Daljinec v iPhonu, iPadu ali uri Apple Watch.\n\nZa več informacij pojdite na support.apple.com/appletv/remote."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Via appen Fjärrkontroll kan du styra Apple TV med iPhone, iPad, eller Apple Watch.\n\nMer information hittar du på support.apple.com/appletv/remote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แอปรีโมทเพื่อควบคุม Apple TV ด้วย iPhone, iPad หรือ Apple Watch ของคุณ\n\nในการเรียนรู้เพิ่มเติม ให้ไปที่ support.apple.com/appletv/remote"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nizi iPhone’unuzla, iPad’inizle veya Apple Watch’unuzla denetlemek için Remote uygulamasını kullanın.\n\nDaha fazla bilgi için support.apple.com/appletv/remote adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З програмою «Пульт» можна керувати Apple TV за допомогою iPhone, iPad або Apple Watch.\n\nДокладну інформацію наведено на вебсторінці support.apple.com/appletv/remote."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng ứng dụng ĐK từ xa để điều khiển Apple TV bằng iPhone, iPad hoặc Apple Watch của bạn.\n\nĐể tìm hiểu thêm, hãy truy cập support.apple.com/appletv/remote."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“遥控器”App通过iPhone、iPad或Apple Watch来控制Apple TV。\n\n请访问support.apple.com/appletv/remote进一步了解。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「遙控器」App以透過iPhone、iPad或Apple Watch控制Apple TV。\n\n詳情請瀏覽support.apple.com/zh-hk/HT201664。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在iPhone、iPad或Apple Watch上使用「遙控器」App來控制Apple TV。\n\n若要瞭解更多資訊，請前往：support.apple.com/appletv/remote。"
          }
        }
      }
    },
