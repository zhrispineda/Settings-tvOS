            "state": "translated",
            "value": "Sanger vil bli lagt til i biblioteket ditt når du legger dem til i spillelister."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers worden in je bibliotheek gezet wanneer je ze in je afspeellijsten zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory dodawane do playlist będą także dodawane do biblioteki."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas serão adicionadas à biblioteca quando você adicioná‑las às suas playlists."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas serão adicionadas à biblioteca quando forem adicionadas a listas de reprodução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodiile vor fi adăugate în biblioteca dvs. atunci când le adăugați în listele de redare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При добавлении в плейлисты песни также будут сохраняться в медиатеке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby, ktoré pridáte do svojich playlistov, budú pridané do vašej knižnice."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladbe bodo dodane v knjižnico, ko jih dodate na sezname predvajanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar läggs till i biblioteket när du lägger till dem i spellistor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงจะถูกเพิ่มไปยังคลังของคุณเมื่อคุณเพิ่มเพลงไปยังเพลย์ลิสต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listelerinize eklediğiniz parçalar arşivinize de eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додані до підбірок пісні додаватимуться до вашої медіатеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài hát sẽ được thêm vào thư viện khi bạn thêm chúng vào playlist."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将歌曲添加到播放列表时，将同时添加到资料库。"
