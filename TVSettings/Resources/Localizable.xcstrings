    "ManageSubscriptionsAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحميل الاشتراكات. حاول مرة أخرى لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es poden carregar les subscripcions. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odběry nelze načíst. Zkuste to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer kan ikke indlæses. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements können nicht geladen werden. Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση συνδρομών. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions can’t be loaded. Try again later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions can’t be loaded. Try again later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions can’t be loaded. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar las suscripciones. Inténtalo de nuevo más tarde."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar las suscripciones. Intenta más tarde."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar las suscripciones. Intenta más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksia ei voida ladata. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les abonnements. Réessayez plus tard."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements ne peuvent pas être chargés. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את המינויים. נא לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन लोड नहीं किए जा सकते। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplate se ne mogu učitati. Pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések nem tölthetők be. Próbálja újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan tidak dapat dimuat. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il caricamento degli abbonamenti. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
