    "UIScaleDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة حجم العناصر التي تظهر على الشاشة. عند تحديد \"كبير\"، سيعرض الصف العلوي من الشاشة الرئيسية خمس أيقونات، بدلًا من ست."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenta la mida dels ítems en pantalla. Si selecciones la mida gran, es mostraran 5 icones a la fila superior de la pantalla d’inici en comptes de 6."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvětší položky na obrazovce. Když je vybraná volba Velké, zobrazí se v horním řádku plochy pět ikon místo šesti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forøg størrelsen af emnerne på skærmen. Når Stor er valgt, viser den øverste række på hjemmeskærmen fem symboler i stedet for seks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößere Objekte auf dem Bildschirm. Wenn „Groß“ ausgewählt ist, zeigt die oberste Reihe des Home-Bildschirms fünf anstelle von sechs Symbolen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυξάνει το μέγεθος των στοιχείων στην οθόνη. Όταν είναι επιλεγμένη η ρύθμιση «Μεγάλο», η πάνω σειρά της οθόνης Αφετηρίας θα εμφανίζει πέντε εικονίδια αντί για έξι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the size of items on screen. When Large is selected, the top row of the home screen will show five icons, instead of six."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the size of items on screen. When Large is selected, the top row of the Home Screen will show five icons instead of six."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the size of items onscreen. When Large is selected, the top row of the Home Screen will show five icons instead of six."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aumenta el tamaño de los ítems en pantalla. Si seleccionas la opción Grande, la fila superior de la pantalla de inicio mostrará cinco iconos en vez de seis."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el tamaño de los elementos en pantalla. Si seleccionas Grande, la fila superior de la pantalla de inicio mostrará cinco íconos en lugar de seis."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el tamaño de los elementos en pantalla. Si seleccionas Grande, la fila superior de la pantalla de inicio mostrará cinco íconos en lugar de seis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurenna näytöllä olevien kohteiden kokoa. Kun Suuri on valittu, Koti-valikon yläreunassa näkyy kuuden sijaan viisi kuvaketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmente la taille des éléments à l’écran. Lorsque Grand est sélectionné, le rang supérieur de l’écran d’accueil affichera cinq icônes plutôt que six."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez la taille des éléments à l’écran. Quand l’option « Grand » est sélectionnée, la rangée supérieure de l’écran d’accueil affiche cinq icônes au lieu de six."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להגדיל את תצוגת הפריטים במסך. כשהאפשרות ״גדולה״ נבחרת, השורה העליונה של מסך הבית תציג חמישה אייקונים במקום שישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर आइटम का आकार बढ़ाएँ। जब बड़ा चुना जाता है, तो होम स्क्रीन की शीर्ष पंक्ति में छह के बजाय पाँच आइकॉन दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povećajte veličinu stavki na zaslonu. Kad je odabrana opcija Veliko, u gornjem redu početnog zaslona prikazivat će se pet ikona umjesto šest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek méretének növelése a képernyőn. Ha a Nagy van kiválasztva, akkor a főképernyő felső sora hat helyett öt ikont fog megjeleníteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ukuran item pada layar. Jika Besar dipilih, baris atas layar utama akan menampilkan lima ikon, alih-alih enam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta le dimensioni degli elementi sullo schermo. Quando selezioni Grande, la riga superiore della schermata Home mostrerà cinque icone invece di sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の項目のサイズを大きくします。“大”が選択されているときは、ホーム画面の一番上のところに6個ではなく5個のアイコンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면상에 표시되는 항목의 크기를 늘립니다. ‘크게’를 선택하면 홈 화면 상단 행에 6개가 아닌 5개의 아이콘이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkatkan saiz item pada skrin. Apabila Besar dipilih, baris atas pada skrin utama akan menunjukkan lima ikon, berbanding enam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør objektene på skjermen større. Når stor er valgt, vil den øverste raden på Hjem-skjermen vise fem symboler i stedet for seks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak onderdelen op het scherm groter. Wanneer 'Groot' is geselecteerd, worden er in de bovenste rij van het beginscherm vijf symbolen, in plaats van zes, weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększ rzeczy na ekranie. Jeśli wybierzesz opcję Duży, górny wiersz ekranu głównego będzie zawierał pięć ikon zamiast sześciu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o tamanho dos itens na tela. Quando você seleciona Grande, a linha superior da tela de início mostra cinco ícones, em vez de seis."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar o tamanho dos elementos no ecrã. Quando a opção Grande está selecionada, a barra superior do ecrã principal mostra cinco ícones, em vez de seis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măriți dimensiunea articolelor de pe ecran. Când este selectată opțiunea „Mare”, rândul de sus al ecranului principal va afișa cinci pictograme, în loc de șase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивайте размер объектов на экране. Если выбран вариант «Крупно», в верхнем ряду на экране «Домой» будут отображаться пять значков, а не шесть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zväčší veľkosť položiek na obrazovke. Keď vyberiete možnosť Veľké, v hornom riadku na ploche sa zobrazí päť ikon namiesto šiestich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povečajte velikost elementov na zaslonu. Če je izbrana možnost Veliko, bo zgornja vrstica domačega zaslona prikazovala pet ikon namesto šest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öka storleken på objekt på skärmen. När Stor har valts får det plats fem symboler på översta raden på hemskärmen istället för sex."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มขนาดของรายการบนหน้าจอ เมื่อเลือกขนาดใหญ่ แถวด้านบนสุดของหน้าจอโฮมจะแสดงห้าไอคอนแทนหกไอคอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrandaki öğelerin büyüklüğünü artırın. Büyük seçildiğinde, ana sayfadaki en üst sırada altı yerine beş simge gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшення розміру елементів на екрані. Якщо вибрано варіант «Великий», у верхньому рядку початкового екрана буде пʼять іконок, а не шість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng kích cỡ của các mục trên màn hình. Khi tùy chọn To được chọn, hàng trên cùng của màn hình chính sẽ hiển thị 5 biểu tượng, thay vì 6 biểu tượng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "增加屏幕显示项目的大小。选择“大”时，主屏幕最顶行将显示五个图标，而非六个。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "增加螢幕上項目的大小。選擇「大」時，主畫面上方列會顯示五個圖像，而不是六個。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "增加螢幕上的項目大小。選取「大」後，主畫面的最上排會顯示五個圖像，而非六個圖像。"
          }
        }
      }
    },
