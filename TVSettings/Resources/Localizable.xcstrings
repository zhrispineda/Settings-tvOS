    "WHANoiCloudAlertDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب كل من البث السريع ٢ وتطبيق المنزل من Apple توفر حساب iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’AirPlay 2 i l’Apple Home requereixen un compte de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 a Domácnost Apple vyžadují účet na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 og Apple Hjem kræver en iCloud-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 und Apple Home erfordern einen iCloud-Account."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AirPlay 2 και η Οικία Apple απαιτούν λογαριασμό iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 and Apple Home require an iCloud account."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 and Apple Home require an iCloud account."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 and Apple Home require an iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 y Apple Home requieren una cuenta de iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 y la app Casa requieren una cuenta de iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 y la app Casa requieren una cuenta de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 ja Applen Koti vaativat iCloud-tilin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 2 et Apple Home requièrent un compte iCloud."
          }
