            "state": "translated",
            "value": "%1$@ is part of this Apple TV’s home. To remove %1$@ from this Apple TV, remove them from the home or change their settings using the Home app on iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ forma parte de la casa en la que se encuentra este Apple TV. Para eliminar %1$@ de este Apple TV, debes eliminarle de la casa o cambiar sus ajustes en la app Casa en iOS."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es parte de la casa de este Apple TV. Para quitar a %1$@ de este Apple TV, elimina su nombre de la casa o cambia su configuración mediante la app Casa en iOS."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es parte de la casa de este Apple TV. Para quitar a %1$@ de este Apple TV, elimina su nombre de la casa o cambia su configuración mediante la app Casa en iOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on Apple TV:n kodin jäsen. Jotta %1$@ voidaan poistaa tästä Apple TV:stä, hänet on poistettava kodista tai hänen asetuksiaan on muutettava iOS:n Koti-apin avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisateur %1$@ fait partie du domicile de cette Apple TV. Pour supprimer %1$@ de cette Apple TV, supprimez-le du domicile ou modifiez ses réglages à l’aide de l’app Maison sur iOS."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartient au domicile de cette Apple TV. Pour supprimer %1$@ de cette Apple TV, supprimez son nom de ce domicile ou modifiez ses réglages à partir de l’app Domicile sur iOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ מהווה חלק מהבית של Apple TV זה. כדי להסיר את %1$@ מ-Apple TV זה, יש להסיר את %1$@ מהבית או לשנות את ההגדרות באמצעות היישום ״הבית שלי״ במכשיר iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ इस Apple TV के घर के भाग हैं। इस Apple TV से %1$@ को हटाने के लिए, उन्हें घर से हटाएँ या iOS पर घर ऐप का उपयोग करके उनकी सेटिंग बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je dio doma ovog Apple TV-a. Kako biste uklonili %1$@ s ovog Apple TV-a, uklonite ih iz doma ili promijenite njihove postavke pomoću aplikacije Dom na iOS-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ nevű felhasználó ennek az Apple TV-hez tartozó otthonnak a része. A(z) %1$@ nevű felhasználó Apple TV-ről való eltávolításához távolítsa el az otthonból, vagy módosítsa a beállítását az iOS Otthon appjával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adalah bagian dari rumah Apple TV ini. Untuk menghapusnya dari Apple TV ini, hapus %1$@ dari rumah atau ubah pengaturannya menggunakan app Rumah di iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fa parte dell’abitazione associata a questa Apple TV. Per rimuovere %1$@ da questa Apple TV, rimuovi l’utente dall’abitazione o modifica le impostazioni associate tramite l’app Casa su iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$[tt]@さんはこのApple TVのホームの一部です。%1$[tt]@さんをこのApple TVから削除するには、ホームからそれらを削除するか、またはiOSのホームアプリを使用してそれらの設定を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님은 이 Apple TV 홈의 구성원입니다. 이 Apple TV에서 %1$@님을 삭제하려면 홈에서 삭제하거나, iOS의 홈 앱을 사용하여 설정을 변경하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adalah sebahagian daripada rumah Apple TV ini. Untuk mengeluarkan %1$@ daripada Apple TV ini, keluarkannya daripada rumah atau tukar setingnya menggunakan app Rumah pada iOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er del av dette Apple TV-hjemmet. Hvis du vil fjerne %1$@ fra Apple TV, må du fjerne dem fra hjemmet eller bruke Hjem-appen på iOS til å endre kontoinnstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hoort bij de woning van deze Apple TV. Om %1$@ uit deze Apple TV te verwijderen, verwijder je deze gebruiker uit de woning of wijzig je de instellingen via de Woning-app in iOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ należy do tego domu Apple TV. Aby usunąć użytkownika %1$@ z tego Apple TV, usuń go z domu lub zmień jego ustawienia w aplikacji Dom na urządzeniu iOS."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ faz parte da casa dessa Apple TV. Para remover %1$@ desta Apple TV, remova essa pessoa da casa ou use o app Casa no iOS para alterar os ajustes."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ faz parte da casa desta Apple TV. Para remover %1$@ desta Apple TV, remova também da casa ou altere as respetivas definições na aplicação Casa, no iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ face parte din locuința acestui Apple TV. Pentru a elimina utilizatorul %1$@ de pe acest Apple TV, eliminați‑l din locuință sau schimbați‑i configurările folosind aplicația Locuință pe iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ может управлять домом, в котором находится этот Apple TV. Чтобы удалить пользователя %1$@ с этого Apple TV, измените настройки в приложении «Дом» на устройстве iOS или удалите из него этого пользователя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je členom domácnosti, ktorej súčasťou je aj toto Apple TV. Ak chcete odstrániť užívateľa %1$@ z tohto Apple TV, odstráňte ho z domácnosti alebo upravte jeho nastavenia v apke Domácnosť v iOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je del doma tega Apple TV-ja. Če želite odstraniti uporabnika %1$@ iz tega Apple TV-ja, ga odstranite iz doma ali spremenite njegove nastavitve z aplikacijo Dom v napravi iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ är en del av hemmet för denna Apple TV. Om du vill ta bort %1$@ från denna Apple TV tar du bort användaren från hemmet eller ändrar användarens inställningar via appen Hem på iOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$[tt]@เป็นส่วนหนึ่งของ Apple TV ในบ้านเครื่องนี้ ในการเอา%1$[tt]@ออกจาก Apple TV เครื่องนี้ ให้เอาออกจากบ้านหรือเปลี่ยนการตั้งค่าของเขาโดยใช้แอปบ้านบน iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bu Apple TV’nin evinin bir parçası. %1$@ adlı kişiyi bu Apple TV’den silmek için evden silin veya iOS’teki Ev uygulamasını kullanarak ayarlarını değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ є частиною дому цього Apple TV. Щоб вилучити користувача %1$@ із цього Apple TV, вилучіть його з цього дому або змініть його параметри в програмі «Дім» в iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ là một thành viên trong nhà của Apple TV này. Để xóa %1$@ khỏi Apple TV này, hãy xóa họ khỏi nhà hoặc thay đổi cài đặt của họ bằng ứng dụng Nhà trên iOS."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@属于这台Apple TV的家庭。若要从这台Apple TV移除%1$@，请将它们从该家庭移除，或使用iOS上的“家庭”App更改其设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是此Apple TV之家居的一部份。如要從此Apple TV上移除%1$@，請將其從家居上移除，或在iOS上使用「家居」App更改其的設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是此Apple TV家庭的一部分。若要從這部Apple TV移除%1$@，請將它們從家庭中移除，或在iOS上使用「家庭」App更改其設定。"
          }
        }
      }
    },
