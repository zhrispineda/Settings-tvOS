    "WirelessAudioSyncSubTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يُشغل Apple TV صوتًا من خلال سماعات التلفزيون ويستخدم iPhone لقياس المدة التي يستغرقها التلفزيون في تشغيل الصوت والفيديو. يجب أن يكون متصلاً بنفس الشبكة المتصل بها Apple TV.\n\nقرّب iPhone من التلفزيون، واضغط على الإشعار للبدء.\n"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV emetrà un so als altaveus del televisor i utilitzarà l’iPhone per calcular el temps que el televisor tarda a reproduir l’àudio i el vídeo. L’iPhone i l’Apple TV han d’estar connectats a la mateixa xarxa.\n\nApropa l’iPhone al televisor i toca la notificació per començar.\n"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV přehraje na televizních reproduktorech zvuk a pomocí vašeho iPhonu změří, s jakým zpožděním váš televizor přehrává obrazový a zvukový signál. iPhone musí být připojený k téže síti jako Apple TV.\n\nPřibližte iPhone na dosah televizoru a začněte klepnutím na oznámení.\n"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil afspille en lyd gennem dine tv-højttalere og bruge din iPhone til at måle, hvor lang tid det tager, før dit fjernsyn afspiller lyd og video. Den skal være tilsluttet det samme netværk som dit Apple TV.\n\nHold din iPhone tæt på fjernsynet, og tryk på notifikationen for at starte.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV gibt über die TV-Lautsprecher einen Ton aus und misst mithilfe des iPhone, wie lange das TV-Gerät braucht, um Audio und Video wiederzugeben. Es muss sich im selben Netzwerk wie das Apple TV befinden.\n\nBringe das iPhone in die Nähe des TV-Geräts und tippe zum Starten auf die Mitteilung.\n"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα αναπαραγάγει έναν ήχο μέσω των ηχείων της τηλεόρασης και θα χρησιμοποιήσει το iPhone σας για να μετρήσει τον χρόνο που χρειάζεται η τηλεόρασή σας για την αναπαραγωγή ήχου και βίντεο. Πρέπει να βρίσκεται στο ίδιο δίκτυο με το Apple TV.\n\nΦέρτε το iPhone κοντά και αγγίξτε τη γνωστοποίηση για έναρξη.\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will play a sound through your TV speakers and use your iPhone to measure how long your TV takes to play audio and video. It must be on the same network as your Apple TV.\n\nBring your iPhone close to your television, and tap the notification to begin.\n"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will play a sound through your TV speakers and use your iPhone to measure how long your TV takes to play audio and video. It must be on the same network as your Apple TV.\n\nBring your iPhone close to your television, and tap the notification to begin.\n"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will play a sound through your TV speakers and use your iPhone to measure how long your TV takes to play audio and video. It must be on the same network as your Apple TV.\n\nBring your iPhone close to your television, then tap the notification to begin.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV reproducirá un sonido a través de los altavoces del televisor y usará el iPhone para medir el tiempo que tarda el televisor en reproducir audio y vídeo. Para ello, debe estar en la misma red que el Apple TV.\n\nAcerca el iPhone al televisor y toca la notificación para empezar.\n"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV emitirá un sonido mediante las bocinas de tu TV y usará tu iPhone para medir cuánto tarda la TV en reproducir audio y video. Asegúrate de que esté en la misma red que tu Apple TV.\n\nAcerca tu iPhone a la TV y toca la notificación para empezar.\n"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV emitirá un sonido mediante los altavoces de tu TV y usará tu iPhone para medir cuánto tarda la TV en reproducir audio y video. Asegúrate de que esté en la misma red que tu Apple TV.\n\nAcerca tu iPhone a la TV y toca la notificación para empezar.\n"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV toistaa äänen TV:n kaiuttimien kautta ja mittaa iPhonella, kuinka kauan TV:llä kestää toistaa ääntä ja videota. Sen on oltava samassa verkossa kuin Apple TV.\n\nTuo iPhone television lähelle ja aloita napauttamalla ilmoitusta.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV émettra un son via les haut-parleurs de votre téléviseur et utilisera votre iPhone afin de mesurer le temps nécessaire à votre téléviseur pour lire l’audio et la vidéo. Votre iPhone doit être connecté au même réseau que votre Apple TV.\n\nApprochez votre iPhone, puis touchez la notification pour commencer.\n"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV va diffuser un son sur les haut-parleurs de la télévision et utiliser votre iPhone pour mesurer le décalage audiovisuel. Votre iPhone et votre Apple TV doivent être connectés au même réseau.\n\nRapprochez votre iPhone de votre télévision, puis touchez la notification pour commencer.\n"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישמיע צליל דרך הרמקולים של הטלוויזיה וישתמש ב-iPhone כדי למדוד כמה זמן לוקח לטלוויזיה להפיק אותות וידאו ושמע. על ה-iPhone וה-Apple TV להיות מחוברים לאותה רשת.\n\nיש לקרב את ה-iPhone לטלוויזיה, ולהקיש על העדכון כדי להתחיל.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV आपके टीवी स्पीकर के ज़रिए ध्वनि बजाएगा और आपके iPhone का इस्तेमाल यह पता करने के लिए करेगा कि आपका टेलीविज़न ऑडियो और वीडियो चलाने में कितनी देर लगाता है। यह उसी नेटवर्क पर होना चाहिए जिस पर आपका Apple TV है।\n\nअपने iPhone को अपने टेलीविज़न के और पास लाएँ और शुरू करने के लिए सूचना पर टैप करें।\n"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV reproducirat će zvuk putem zvučnika TV-a i upotrijebiti iPhone za mjerenje koliko dugo vašem TV-u treba za reprodukciju audio i video zapisa. Uređaj treba biti na istoj mreži kao i vaš Apple TV.\n\nPribližite iPhone televizoru i dodirnite obavijest kako biste započeli.\n"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV hangot fog lejátszani a televíziója hangszóróin keresztül, és az iPhone segítségével megméri, mennyi ideig tart a televíziónak a hang és a videó lejátszása. Az iPhone-nak az Apple TV-vel azonos hálózaton kell lennie.\n\nTartsa közel az iPhone‑t a televízióhoz, és koppintson az értesítésre a kezdéshez.\n"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memutar bunyi melalui speaker TV dan menggunakan iPhone Anda untuk mengukur waktu yang diperlukan TV Anda untuk memutar audio dan video. Perangkat harus terhubung ke jaringan yang sama dengan Apple TV Anda.\n\nDekatkan iPhone ke televisi dan ketuk pemberitahuan untuk memulai.\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV riprodurrà un suono tramite gli altoparlanti del televisore e utilizzerà iPhone per calcolare il tempo necessario per riprodurre audio e video. iPhone deve essere connesso alla stessa rete di Apple TV.\n\nAvvicina iPhone al televisore, quindi tocca la notifica per iniziare.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVでは、テレビスピーカーからサウンドを再生し、iPhoneを使用してお使いのテレビでオーディオおよびビデオの再生にかかる時間を計測します。iPhoneはApple TVと同じネットワークに接続している必要があります。\n\n開始するには、iPhoneをテレビの近くに持ってきて、通知をタップしてください。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용자의 텔레비전 스피커를 통해 사운드를 재생하고, 사용자의 iPhone을 사용하여 텔레비전이 오디오 및 비디오를 재생하는 데 얼마나 걸리는지 측정합니다. 해당 기기는 Apple TV와 동일한 네트워크상에 있어야 합니다.\n\n시작하려면 iPhone을 텔레비전 가까이 가져온 다음 알림을 탭하십시오.\n"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memainkan bunyi menerusi speaker TV dan menggunakan iPhone anda untuk mengukur tempoh TV memainkan audio serta video. Ia mesti menggunakan rangkaian sama dengan Apple TV anda.\n\nBawa iPhone anda berdekatan TV anda dan ketik pemberitahuan untuk bermula.\n"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil spille av en lyd fra TV-høyttalerne og bruke iPhonen din til å måle hvor lang tid det tar for TV-en å spille av lyd og video. iPhonen og Apple TV må være på samme nettverk.\n\nHold iPhonen nær TV-en og trykk på varslingen for å begynne.\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV speelt een geluid af via je tv-luidsprekers en gebruikt je iPhone om te meten hoelang je tv erover doet om audio en video af te spelen. Je iPhone moet zich in hetzelfde netwerk als je Apple TV bevinden.\n\nHoud je iPhone dicht bij je televisie en tik op de melding om te beginnen.\n"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV odtworzy dźwięk przez głośniki telewizora i za pośrednictwem iPhone’a zmierzy opóźnienie odtwarzania audio i wideo przez telewizor. Musi on być połączony z tą samą siecią co Apple TV.\n\nAby zacząć, umieść iPhone’a blisko telewizora i stuknij w powiadomienie.\n"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV reproduzirá um som pelos alto‑falantes da TV e usará o seu iPhone para medir quanto tempo a TV leva para reproduzir áudio e vídeo. Ele deve estar na mesma rede que a Apple TV.\n\nAproxime o iPhone da televisão e toque na notificação para começar.\n"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV irá reproduzir um som através das colunas da televisão e utilizar o iPhone para medir o tempo que esta demora a reproduzir áudio e vídeo. O iPhone tem de estar ligado à mesma rede que a Apple TV.\n\nAproxime o iPhone da televisão e toque na notificação para começar.\n"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va reda un sunet prin difuzoarele televizorului și va utiliza iPhone‑ul dvs. pentru a măsura cât timp îi ia televizorului să redea audio și video. Acesta trebuie să fie în aceeași rețea ca Apple TV‑ul.\n\nPentru a începe, apropiați‑vă iPhone‑ul de televizor și apăsați pe notificare.\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV воспроизведет звук через динамики телевизора и по данным с iPhone определит время, необходимое телевизору для воспроизведения аудио и видео. iPhone и Apple TV должны быть подключены к одной сети.\n\nПоднесите iPhone к телевизору и коснитесь уведомления, чтобы начать.\n"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV prehrá zvuk v reproduktoroch televízora a pomocou vášho iPhonu odmeria, ako dlho trvá, než televízor prehrá obraz a zvuk. iPhone aj Apple TV musia byť pripojené k rovnakej sieti.\n\nAk chcete začať, umiestnite iPhone do blízkosti televízora a klepnite na hlásenie.\n"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo predvajal zvok prek zvočnikov televizorja in uporabil vaš iPhone, da izmeri, kako dolgo traja, da televizor predvaja zvok in video. Naprava mora biti v istem omrežju kot Apple TV.\n\nPribližajte iPhone televizorju in tapnite obvestilo, da začnete.\n"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV spelar upp ett ljud genom TV-högtalarna och använder iPhone till att mäta hur lång tid det tar för TV:n att spela upp ljud och bild. Den måste vara ansluten till samma nätverk som Apple TV.\n\nSe till att iPhone är nära TV:n och tryck på notisen när du vill börja.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะเล่นเสียงผ่านทางลำโพงทีวีและใช้ iPhone เพื่อวัดระยะเวลาเล่นเสียงและวิดีโอของทีวีของคุณ โดย iPhone ต้องอยู่บนเครือข่ายเดียวกันกับ Apple TV ของคุณ\n\nนำ iPhone เข้าใกล้กับโทรทัศน์ของคุณแล้วแตะการแจ้งเตือนเพื่อเริ่ม\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, TV hoparlörlerinizde bir ses çalar ve televizyonunuzun video oynatmasının ve ses çalmasının ne kadar sürdüğünü ölçmek için iPhone’unuzu kullanır. Aygıtınız Apple TV’niz ile aynı ağda olmalıdır.\n\nBaşlamak için iPhone’unuzu televizyonunuza yaklaştırın ve bildirime dokunun.\n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV відтворить звук через динаміки телевізора та використає ваш iPhone, щоб визначити, як швидко телевізор починає відтворення звуку й відео. Пристрої мають перебувати в одній мережі.\n\nЩоб почати, піднесіть iPhone ближче до телевізора й торкніть сповіщення.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ phát âm thanh thông qua các loa TV và sử dụng iPhone của bạn để đo thời gian cần thiết để TV phát âm thanh và video. Thiết bị phải được kết nối vào cùng mạng với Apple TV của bạn.\n\nHãy đưa iPhone của bạn tới gần tivi và chạm vào thông báo để bắt đầu.\n"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将通过电视扬声器播放声音，并使用iPhone估算电视需要多长时间才会播放音频和视频。它必须与Apple TV接入同一网络。\n\n将iPhone靠近电视，然后轻点通知开始。\n"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會透過你的電視喇叭播放聲音以及使用你的iPhone來估算你的電視播放音訊和影片所需的時間。它必須與Apple TV連接相同的網絡。\n\n將你的iPhone靠近電視，並點一下通知來開始。\n"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會透過電視揚聲器播放聲音，並使用iPhone來估算電視要花多長時間才能播放音訊和影片。電視必須連接與Apple TV相同的網路。\n\n請讓你的iPhone靠近電視，然後點一下通知來開始。\n"
          }
        }
      }
    },
