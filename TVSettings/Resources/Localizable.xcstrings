    "AXBoldTextRestartMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة تشغيل الـ Apple TV الآن لتطبيق هذه الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV es reiniciarà ara per aplicar aquesta configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV se nyní pro použití těchto nastavení restartuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple TV-enhed genstarter nu for at anvende disse indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV startet jetzt neu, um diese Einstellungen anzuwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα επανεκκινηθεί για να εφαρμοστούν αυτές οι ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will restart now to apply these settings."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will restart now to apply these settings."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will restart now to apply these settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV se reiniciará ahora para aplicar estos ajustes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV se reiniciará ahora para aplicar esta configuración."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV se reiniciará ahora para aplicar esta configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV käynnistyy nyt uudelleen ottaakseen asetukset käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV va redémarrer maintenant pour appliquer ces réglages."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV va redémarrer maintenant pour appliquer ces réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יבצע כעת הפעלה מחדש כדי להחיל הגדרות אלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन सेटिंग को लागू करने के लिए आपका Apple TV रीस्टार्ट होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV sad će se ponovno uključiti kako bi se primijenila ova podešenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV most újraindul a beállítások érvénybe léptetéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda akan dimulai ulang sekarang untuk menerapkan pengaturan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV verrà riavviata per applicare le impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定を適用するために、今すぐApple TVが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 적용하기 위해 Apple TV가 재시동됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda akan dimulakan semula sekarang untuk menggunakan seting ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV starter på nytt nå for å ta i bruk endringene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV wordt nu opnieuw opgestart om deze instellingen toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV zostanie teraz uruchomiony ponownie w celu zastosowania tych ustawień."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV será reiniciada para aplicar estes ajustes."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV será reiniciada para aplicar as definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul se va reporni acum pentru aplicarea acestor configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV сейчас перезагрузится для применения этих настроек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše Apple TV sa kvôli zavedeniu nastavení reštartuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo teh nastavitev se bo Apple TV znova zagnal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV startas nu om så att inställningarna börjar gälla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณจะเริ่มการทำงานเครื่องใหม่ตอนนี้เพื่อปรับใช้การตั้งค่าเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz bu ayarları uygulamak için şimdi yeniden başlayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV буде перезапущено для застосування цих налаштувань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn sẽ khởi động lại bây giờ để áp dụng những cài đặt này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV现在会重新启动来应用这些设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV現在會重新啟動以套用這些設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV現將重新啟動以套用這些設定。"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Your Apple TV will restart now to apply these settings.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Your Apple TV will restart now to apply these settings.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Apple TV starter på nytt nå for å ta i bruk endringene.",
            "state": "translated"
          }
        }
      }
    },
