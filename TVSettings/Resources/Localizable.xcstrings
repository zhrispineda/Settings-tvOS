            "state": "translated",
            "value": "Dolby Atmos va fi ignorat și va fi redat în schimb sunetul surround standard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos будет проигнорирован, вместо него будет использоваться обычный объемный звук."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Formát Dolby Atmos bude ignorovaný a namiesto toho bude použitý štandardný priestorový zvuk."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok Dolby Atmos ne bo upoštevan, namesto njega pa bo predvajan standardni prostorski zvok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos ignoreras och standardsurroundljud spelas istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos จะไม่ถูกใช้และจะเล่นแบบเสียงรอบทิศทางมาตรฐานแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos yok sayılır ve yerine standart surround ses çalınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos ігноруватиметься, і натомість лунатиме стандартний обʼємний звук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos sẽ được bỏ qua và âm thanh vòm tiêu chuẩn sẽ được phát thay thế."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略杜比全景声并播放标准环绕声。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "杜比全景聲會被忽略，並會改為播放標準環繞音效。"
