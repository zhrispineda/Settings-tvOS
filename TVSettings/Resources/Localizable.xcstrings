    "RCWakeAppleRemoteMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتغيير هذا الإعداد، يجب أن يكون لديك ريموت مقترن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per canviar aquesta opció has de tenir un comandament enllaçat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li toto nastavení změnit, musíte mít spárovaný ovladač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil ændre denne indstilling, skal du have en parret fjernbetjening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ändern dieser Einstellung ist eine gekoppelte Fernbedienung erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να αλλάξετε αυτήν τη ρύθμιση, πρέπει να έχετε ζευγοποιημένο τηλεχειριστήριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change this setting, you must have a paired Remote."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To change this setting, you must have a paired Remote."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To change this setting, you must have a paired Remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar este ajuste, debes haber enlazado el mando a distancia."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar esta configuración, debes tener un control remoto enlazado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar esta configuración, debes tener un control remoto enlazado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta tätä asetusta voidaan muuttaa, sinulla on oltava kaukosäädin, josta on muodostettu pari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour modifier ce réglage, vous devez posséder une télécommande jumelée."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour modifier ce réglage, vous devez disposer d’une télécommande jumelée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לשנות הגדרה זו, יש צורך בשלט מקושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सेटिंग को बदलने के लिए आपके पास पेयर किया हुआ रिमोट होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za promjenu ovog podešenja, trebate imati uparen upravljač."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítás módosításához párosított távirányító szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
