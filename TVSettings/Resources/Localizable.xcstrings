            "state": "translated",
            "value": "ניתן להוסיף הודעה בהתאמה אישית להנחיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशों में कस्टम संदेश जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte vlastitu poruku u upute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyéni üzenet hozzáadása az utasításokhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pesan khusus ke instruksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un messaggio personalizzato alle istruzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムメッセージを指示に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 설정 메시지를 설명에 추가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah mesej tersuai pada arahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en tilpasset melding i instruksjonene."
          }
        },
        "nl": {
