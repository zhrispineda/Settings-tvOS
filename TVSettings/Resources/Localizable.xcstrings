    "SpatialAudioInEarAlertTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى وضع \"%@\" في أذنيك لتجربة الصوت المكاني."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa’t els %@ per provar l’àudio espacial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li si vyzkoušet prostorový zvuk, vložte si %@ do uší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt “%@” i dine ører for at prøve rumlig lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die „%@“ in die Ohren ein, um 3D-Audio auszuprobieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να δοκιμάσετε τον χωρικό ήχο, τοποθετήστε τα «%@» στα αυτιά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place “%@” in your ears to try spatial audio."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Place “%@” in your ears to try spatial audio."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Place “%@” in your ears to try spatial audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los %@ y prueba el audio espacial."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte “%@” en los oídos para probar el audio espacial."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte “%@” en los oídos para probar el audio espacial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile tilaääntä asettamalla %[tt]@-kuulokkeet korviisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez les « %@ » dans vos oreilles pour essayer l’audio spatial."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérez les « %@ » dans vos oreilles pour essayer l’audio spatial."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להתנסות בחוויית השמע המרחבי יש להכניס את ״%@״ לאוזניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेशियल ऑडियो आज़माने के लिए “%@” को अपने कानों में लगाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavite slušalice “%@” u uši kako biste isprobali prostorni zvuk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegye „%@” fülhallgatóját a fülébe a térbeli hangzás kipróbálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang “%@” di telinga Anda untuk mencoba audio spasial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossa gli auricolari %@ per provare l’audio spaziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間オーディオを試すには、“%@”を耳に装着してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간 음향을 시험해 보려면 먼저 ‘%@’을(를) 양쪽 귀에 착용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai “%@” dalam telinga anda untuk mencuba audio ruang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett «%@» i ørene for å teste den romtilpassede lyden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop '%@' in je oren om ruimtelijke audio te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włóż słuchawki %@ do uszu, aby wypróbować dźwięk przestrzenny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os “%@” nos ouvidos para experimentar o áudio espacial."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os “%@” nos ouvidos para experimentar o áudio espacial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puneți căștile „%@” în urechi pentru a încerca audio spațial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите наушники «%@» в уши, чтобы послушать пространственное аудио."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete otestovať priestorový zvuk, vložte si do uší slúchadlá %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstavite napravo »%@« v ušesa, da preizkusite prostorski zvok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera ”%@” i öronen om du vill prova rumsligt ljud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ “%@” ในหูของคุณเพื่อลองฟังเสียงเชิงมิติพื้นที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzamsal sesi denemek için “%@” kulaklığını takın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помістіть «%@» у вуха, щоб прослухати просторове аудіо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đeo “%@” vào tai để thử nghe âm thanh không gian."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”放入双耳体验空间音频。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將「%@」放入耳中即可體驗空間音訊。"
