    "RestrictionsUserBypassWithDeviceAllowDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بإمكان %@ تجاوز القيود باستخدام جهاز شخصي بدلاً من إدخال رمز الدخول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pot ometre les restriccions amb un dispositiu personal, sense haver d’introduir el codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ může obejít omezení tak, že místo zadání kódu použije vlastní zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan tilsidesætte begrænsninger vha. en personlig enhed, i stedet for at koden skal indtastes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann Einschränkungen mit einem persönlichen Gerät umgehen, anstatt den Code einzugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χρήστης «%@» μπορεί να παρακάμψει τους περιορισμούς χρησιμοποιώντας μια προσωπική συσκευή αντί να εισαγάγει τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can bypass restrictions using a personal device instead of entering the passcode."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can bypass restrictions using a personal device instead of entering the passcode."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can bypass restrictions using a personal device instead of entering the passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede evitar las restricciones usando un dispositivo personal en vez de introduciendo el código."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede ignorar las restricciones al usar un dispositivo personal en vez de ingresar un código."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede ignorar las restricciones al usar un dispositivo personal en vez de ingresar un código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voi ohittaa rajoitukset käyttämällä henkilökohtaista laitetta pääsykoodin syöttämisen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut contourner les restrictions en utilisant un appareil plutôt qu’en saisissant le code."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut contourner les restrictions au moyen d’un appareil personnel au lieu d’entrer le code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרות %@ לעקוף הגבלות באמצעות שימוש במכשיר אישי במקום הזנת קוד גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकोड दर्ज करने के बजाय %@ व्यक्तिगत डिवाइस का उपयोग करके प्रतिबंधों से बच सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korisnik %@ može zaobići ograničenja osobnim uređajem umjesto šifrom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a jelkód bevitele helyett megkerülheti a korlátozásokat egy személyes eszköz használatával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dapat memintasi pembatasan menggunakan perangkat pribadi alih-alih memasukkan kode sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ può ignorare le restrizioni utilizzando un dispositivo personale invece di inserire il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを入力する代わりに個人用デバイスを使用することで、%@さんは制限を回避できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 암호를 입력하는 대신 개인용 기기를 사용하여 제한을 건너뛸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boleh memintas pengehadan menggunakan peranti peribadi berbanding memasukkan kod laluan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan omgå restriksjoner ved å bruke en personlig enhet i stedet for å oppgi koden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan beperkingen negeren via een persoonlijk apparaat in plaats van de toegangscode in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ może ominąć ograniczenia, używając urządzenia osobistego zamiast podawania kodu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode usar um dispositivo pessoal em vez de digitar o código para contornar as restrições."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode ignorar restrições usando um dispositivo pessoal em vez de digitar o código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poate ocoli restricțiile utilizând un dispozitiv personal, în loc să introducă un cod de acces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ может обходить ограничения, используя личное устройство вместо ввода код‑пароля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ môže namiesto zadávania kódu obísť obmedzenia použitím vlastného zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lahko zaobide omejitve z osebno napravo namesto vnosa kode za dostop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan förbigå begränsningar med en personlig enhet istället för att ange lösenkoden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@สามารถผ่านการจำกัดได้โดยใช้อุปกรณ์ส่วนบุคคลแทนที่จะป้อนรหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, parolayı girmek yerine kişisel bir aygıt kullanarak sınırlamaları atlayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зможе обходити обмеження без введення коду допуску, якщо використовує власний пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
