          "stringUnit": {
            "state": "translated",
            "value": "Vergewissere dich, dass sich dein iPhone in der Nähe befindet und dasselbe WLAN wie dieses Apple TV verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι το iPhone σας βρίσκεται κοντά και είναι συνδεδεμένο στο ίδιο δίκτυο WLAN με αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your iPhone is nearby and is on the same WLAN network as this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your iPhone is nearby and is on the same WLAN network as this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your iPhone is nearby and is on the same WLAN network as this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el iPhone está cerca y conectado a la misma red WLAN que este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu iPhone esté cerca y conectado a la misma red WLAN que este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu iPhone esté cerca y conectado a la misma red WLAN que este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että iPhonesi on lähellä ja samassa WLAN-verkossa kuin tämä Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre iPhone est à proximité et connecté au même réseau WLAN que cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre iPhone est à proximité et connecté au même réseau WLAN que cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שה-iPhone נמצא בסביבה ומחובר לאותה רשת WLAN שאליה מחובר ה‑Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि आपका iPhone आस-पास हो और उसी वाई-फ़ाई नेटवर्क पर हो जिस पर यह Apple TV है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite nalazi li se iPhone u blizini i je li spojen na istu WLAN mrežu kao i ovaj Apple TV."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződjön meg arról, hogy az iPhone‑ja a közelben van, és ugyanahhoz a WLAN-hálózathoz csatlakozik, mint ez az Apple TV."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan iPhone Anda berada di sekitar dan terhubung ke jaringan WLAN yang sama dengan Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che iPhone si trovi nelle vicinanze e sia connesso alla stessa rete WLAN di Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが近くにあり、このApple TVと同じWLANネットワークに接続されていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 근처에 있고 이 Apple TV와 동일한 WLAN 네트워크에 연결되어 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan iPhone anda berada berdekatan dan menggunakan rangkaian WLAN yang sama seperti Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller at iPhonen er i nærheten og at den er koblet til samme WLAN-nettverk som denne Apple TV-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat je iPhone zich in de buurt bevindt en hetzelfde WLAN-netwerk gebruikt als deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że Twój iPhone jest w pobliżu i ma połączenie z tą samą siecią WLAN co ten Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se o iPhone está por perto e conectado à mesma rede WLAN desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique‑se de que o iPhone está por perto e ligado à mesma rede WLAN que esta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone‑ul trebuie să se afle în apropiere și în aceeași rețea WLAN ca acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что iPhone находится рядом и подключен к той же сети WLAN, что и этот Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že je váš iPhone nablízku a pripojený k rovnakej WLAN sieti ako toto Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepričajte se, da je iPhone v bližini in povezan z istim omrežjem WLAN kot ta Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att iPhone är i närheten och ansluten till samma WLAN-nätverk som denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่า iPhone ของคุณอยู่ใกล้เคียงและอยู่บนเครือข่าย WLAN เดียวกับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzun yakında ve bu Apple TV ile aynı WLAN ağında olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упевніться, що iPhone поблизу й підʼєднаний до тої самої мережі WLAN, що й цей Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo iPhone của bạn ở gần và kết nối vào cùng một mạng WLAN như Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确保iPhone在附近且与此Apple TV接入同一无线局域网。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確定iPhone在附近並與此Apple TV在相同的WLAN網絡上。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請確定iPhone位於附近且和此Apple TV連接相同的WLAN網路。"
          }
        }
      }
    },
