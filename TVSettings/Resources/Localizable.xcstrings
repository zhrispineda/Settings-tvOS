    "DiagnosticSiriDataSharingDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد في تحسين Siri والإملاء بالسماح لـ Apple بتخزين ومراجعة صوت تفاعلاتك مع Siri والإملاء من هذا الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que Apple desi i analitzi l’àudio de les teves interaccions amb Siri i el dictat en aquest dispositiu per ajudar a millorar aquestes funcions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozte společnosti Apple s vylepšováním Siri a diktování tím, že jí umožníte ukládat a analyzovat zvukové záznamy vaší vzájemné komunikace na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp med at forbedre Siri og Diktering ved at tillade Apple at opbevare og gennemgå lyd fra dine interaktioner med Siri og Diktering på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf mit, Siri und die Diktierfunktion zu verbessern, indem du Apple erlaubst, Audioaufnahmen deiner Interaktion mit Siri und der Diktierfunktion von diesem Gerät zu speichern und auszuwerten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοηθήστε στη βελτίωση του Siri και της Υπαγόρευσης επιτρέποντας στην Apple την αποθήκευση και την ανασκόπηση των δεδομένων ήχου που προέρχονται από τις αλληλεπιδράσεις σας με το Siri και την Υπαγόρευση σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve Siri and Dictation by allowing Apple to store and review audio of your Siri and Dictation interactions from this device."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve Siri and Dictation by allowing Apple to store and review audio of your Siri and Dictation interactions from this device."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve Siri and Dictation by allowing Apple to store and review audio of your Siri and Dictation interactions from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar Siri y Dictado permitiendo a Apple almacenar y revisar el audio de tus interacciones con Siri y Dictado desde este dispositivo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar Siri y Dictado al permitir que Apple almacene y revise el audio de tus interacciones con Siri y Dictado de este dispositivo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar Siri y Dictado al permitir que Apple almacene y revise el audio de tus interacciones con Siri y Dictado de este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta parantamaan Siriä ja sanelua sallimalla Applen tallentaa ja tarkastella Sirin ja sanelun kanssa tällä laitteella käyttämääsi ääntä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez à améliorer Siri et Dictée en autorisant Apple à conserver et examiner le contenu audio de vos interactions avec Siri et Dictée sur cet appareil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuez à l’amélioration de Siri et de Dictée en autorisant Apple à stocker et à analyser le contenu audio de vos interactions avec Siri et Dictée à partir de cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לעזור לשפר את Siri ואת ״הכתבה״ על ידי מתן רשות ל-Apple לשמור ולבדוק את השמע של האינטראקציות שלך עם Siri ועם ״הכתבה״ במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से Siri और डिक्टेशन के साथ अपनी इंटरऐक्शन के ऑडियो को संग्रहित करने और उसकी समीक्षा करने का Apple को अधिकार देकर Siri और डिक्टेशन के सुधार में मदद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozite poboljšati Siri i Diktat tako da dozvolite Appleu pohranjivanje i analiziranje audio zapisa vaših interakcija sa Siri i Diktatom s ovog uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segíthet javítani Sirit és a Diktálást, ha engedélyezi az Apple-nek, hogy tárolja és áttekintse a Sirivel és a Diktálással ezen az eszközön végzett műveletek hanganyagát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan Siri dan Dikte dengan mengizinkan Apple untuk menyimpan dan meninjau audio interaksi Siri dan Dikte Anda dari perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutaci a migliorare Siri e Dettatura, consentendo ad Apple di archiviare e analizzare l’audio delle interazioni con Siri e Dettatura quando utilizzi questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriと音声入力に対する操作の音声をこのデバイスからオーディオ収録したものを、Appleが保存しレビューすることを許可することで、Siriと音声入力の改善にご協力いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 사용자가 Siri 및 받아쓰기와 상호 작용한 오디오를 Apple이 보관하고 검토하는 것을 허용하여 Siri 및 받아쓰기를 향상하는 데 도움을 줄 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu tingkatkan Siri dan Perencanaan dengan membenarkan Apple menyimpan serta menyemak audio interaksi Siri dan Perencanaan anda daripada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp oss å forbedre Siri og Diktering ved å tillate at Apple kan lagre og gå gjennom lyden fra din bruk av Siri og Diktering fra denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help bij het verbeteren van Siri en de dicteerfunctie door Apple toe te staan om audio van je interacties met Siri en de dicteerfunctie van dit apparaat te bewaren en te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomagaj udoskonalać Siri i funkcję Dyktowanie, pozwalając Apple na przechowywanie i odsłuchiwanie zapisów interakcji głosowych z Siri i funkcją Dyktowanie z tego urządzenia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar a Siri e o Ditado ao permitir que a Apple armazene e analise o áudio das interações com a Siri e o Ditado deste dispositivo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar Siri e o Ditado permitindo que a Apple armazene e analise o áudio das suas interações com Siri e o Ditado neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutați la îmbunătățirea funcționalităților Siri și Dictare permițând ca Apple să stocheze și să examineze conținutul audio al interacțiunilor dvs. care implică Siri și dictarea de pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите улучшить Siri и Диктовку, разрешив Apple хранить и анализировать аудиозаписи, созданные во время использования функций Siri и Диктовки на этом устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete pomôcť vylepšovať Siri a Diktovanie, môžete spoločnosti Apple povoliť ukladanie a analýzu vašej hlasovej interakcie so Siri a Diktovaním z tohto zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite družbi Apple, da shranjuje in pregleduje zvočni zapis vaših interakcij s Siri in funkcijo Narekovanje iz te naprave, ter tako pomagajte izboljšati Siri in funkcijo Narekovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp till att förbättra Siri och diktering genom att tillåta att Apple lagrar och granskar ljud från dina interaktioner med Siri och diktering från den här enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยปรับปรุง Siri และการป้อนตามคำบอกโดยการอนุญาตให้ Apple จัดเก็บและตรวจสอบเสียงของการโต้ตอบกับ Siri และการป้อนตามคำบอกจากอุปกรณ์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ın bu aygıttan Siri ve Dikte ile etkileşimlerinizin seslerini saklayıp gözden geçirmesine izin vererek Siri’nin ve Dikte’nin iyileştirilmesine yardımcı olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагайте вдосконалювати Siri й Диктування, дозволивши Apple зберігати й аналізувати аудіо ваших взаємодій із Siri й Диктуванням із цього пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp cải tiến Siri và Đọc chính tả bằng cách cho phép Apple lưu trữ và xem lại âm thanh của các tương tác Siri và Đọc chính tả của bạn từ thiết bị này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许Apple储存并查看来自这台设备的Siri和听写的交互音频，帮助改进Siri和听写。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許Apple儲存並檢視你在此裝置上與Siri和「聽寫」的互動音訊，以協助改進Siri和「聽寫」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許Apple儲存並檢視你在此裝置上與Siri和「聽寫」的互動音訊，以便協助改進Siri和「聽寫」。"
          }
        }
      }
    },
