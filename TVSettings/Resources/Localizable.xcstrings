    "MyPhotoStreamDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى صورك الحديثة التي تلتقطها باستخدام iPhone أو iPad."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedeix a les fotos més recents fetes amb l’iPhone o l’iPad."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde si můžete prohlížet nejnovější fotky, které jste pořídili na iPhonu nebo iPadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få adgang til de nyeste fotos, du har taget med din iPhone eller iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greife auf die neuesten Fotos zu, die du mit deinem iPhone oder iPad aufgenommen hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσπελάστε τις πρόσφατες φωτογραφίες που έχετε τραβήξει με το iPhone ή το iPad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access your recent photos that you take with your iPhone or iPad."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Access your recent photos that you take with your iPhone or iPad."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Access your recent photos that you take with your iPhone or iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a las fotos que has hecho recientemente con tu iPhone o iPad."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a fotos recientes tomadas con tu iPhone o iPad."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a fotos recientes tomadas con tu iPhone o iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kuvia, jotka olet äskettäin ottanut iPhonella tai iPadilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez aux photos prises récemment avec votre iPhone ou iPad."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez aux photos que vous avez récemment prises avec votre iPhone ou iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לגשת לתמונות האחרונות שצילמת ב-iPhone או ב-iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone या iPad से ली गई अपनी हालिया तस्वीरें ऐक्सेस करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupite nedavnim fotografijama koje ste snimili iPhoneom ili iPadom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáférhet az iPhone-jával vagy az iPadjével készített legutóbbi fotóihoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses foto terbaru yang Anda ambil dengan iPhone atau iPad Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi alle tue foto più recenti scattate con iPhone o iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneまたはiPadで撮影した最近の写真にアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad에서 찍은 최근 사진에 접근합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses foto terbaharu anda yang anda ambil dengan iPhone atau iPad anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få tilgang til bilder som er tatt nylig med iPhone eller iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot recente foto's die je maakt met je iPhone of iPad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do Twoich najnowszych zdjęć zrobionych iPhone’em lub iPadem."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesse as fotos recentes que você tirou com o iPhone ou iPad."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda às fotografias recentes que tirou com o seu iPhone ou iPad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesați‑vă pozele recente pe care le‑ați făcut cu iPhone‑ul sau iPad‑ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к недавним фото, снятым на iPhone или iPad."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupujte k svojim posledným fotkám zhotoveným na iPhone alebo iPade."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostopajte do svojih nedavnih fotografij, ki ste jih posneli z iPhonom ali iPadom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan komma åt de senaste bilderna som du har tagit med iPhone eller iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงรูปภาพล่าสุดที่คุณถ่ายด้วย iPhone หรือ iPad ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuz ya da iPad’iniz ile çektiğiniz son fotoğraflara erişin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривайте недавні фото, які ви зробили на iPhone чи iPad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập các ảnh gần đây mà bạn chụp bằng iPhone hoặc iPad."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "访问近期通过iPhone或iPad拍摄的照片。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取用最近使用iPhone或iPad拍攝的相片。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取用你最近使用iPhone或iPad拍攝的照片。"
          }
        }
      }
    },
