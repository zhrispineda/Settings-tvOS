            "value": "ข้อมูลการวิเคราะห์จะไม่ถูกส่งไปยัง Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz verileri Apple’a gönderilmeyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналітичні дані не надсилатимуться до Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu phân tích sẽ không được gửi tới Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "分析数据不会被发送给Apple。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "分析資料將不會傳送予Apple。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "分析資料將不會傳送給Apple。"
          }
        }
      }
    },
