    "AccountsUserProfilesAddGuestConfirmationMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إضافة ملف التعريف هذا كملف افتراضي على هذا الجهاز أو المتابعة في إضافته كملف تعريف جديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots afegir aquest perfil com a perfil per omissió, o bé afegir‑lo com a perfil nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento profil můžete na toto zařízení přidat jako výchozí nebo pokračovat v přidávání nového profilu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilføje denne profil som standardprofil på denne enhed eller fortsætte med at tilføje den som en ny profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dieses Profil als Standardprofil auf diesem Gerät hinzufügen oder fortfahren und es als neues Profil hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να προσθέσετε αυτό το προφίλ ως το προεπιλεγμένο προφίλ σε αυτήν τη συσκευή, ή να συνεχίσετε προσθέτοντάς το ως νέου προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add this profile as the default on this device or continue adding them as a new profile."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add this profile as the default on this device or continue adding them as a new profile."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add this profile as the default on this device or continue adding them as a new profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes añadir este perfil como el perfil por omisión de este dispositivo o bien como un perfil nuevo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes agregar este perfil como el predeterminado en este dispositivo o seguir agregándolo como uno nuevo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes agregar este perfil como el predeterminado en este dispositivo o seguir agregándolo como uno nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lisätä tämän profiilin tämän laitteen oletukseksi tai jatkaa sen lisäämistä uutena profiilina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter ce profil comme profil par défaut sur cet appareil ou continuer à l’ajouter comme nouveau profil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter ce profil comme profil par défaut sur cet appareil ou comme nouveau profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להוסיף פרופיל זה כפרופיל ברירת המחדל במכשיר זה, או להמשיך להוסיף אותו כפרופיל חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस प्रोफ़ाइल को इस डिवाइस पर डिफ़ॉल्ट के तौर पर जोड़ सकते हैं या उन्हें नए प्रोफ़ाइल के रूप में जोड़ना जारी रख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete dodati ovaj profil kao standardni na ovom uređaju ili ga nastaviti dodavati kao novi profil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáadhatja ezt a profilt alapértelmezettként ezen az eszközön, vagy folytathatja a hozzáadását új profilként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menambahkan profil ini sebagai default di perangkat ini atau terus menambahkannya sebagai profil baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aggiungere questo profilo come profilo di default sul dispositivo o continuare ad aggiungerlo come nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールをこのデバイスのデフォルトとして追加するか、新規のプロフィールとして追加を続けるかを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필을 이 기기의 기본 프로필로 추가하거나, 계속 진행하여 새로운 프로필로 추가할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menambahkan profil ini sebagai lalai pada peranti ini atau teruskan menambahnya sebagai profil baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan legge til profilen som standardprofil på denne enheten, eller fortsette å legge den til som en ny profil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit profiel toevoegen als standaardprofiel op dit apparaat of toevoegen als nieuw profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dodać ten profil jako domyślny na tym urządzeniu lub kontynuować dodawanie go jako nowego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode adicionar este perfil como padrão no dispositivo ou continuar e adicioná‑lo como um novo perfil."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode adicionar este perfil como predefinido neste dispositivo ou adicioná‑lo como um novo perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți adăuga acest profil drept profil implicit pe acest dispozitiv sau puteți continua să îl adăugați drept profil nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете сделать этот профиль выбором по умолчанию на устройстве либо добавить этого пользователя как новый профиль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento profil môžete pridať ako predvolený na tomto zariadení alebo ho pridať ako nový profil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta profil lahko dodate kot privzetega v tej napravi ali pa ga dodajte kot nov profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lägga till den här profilen som förval på den här enheten eller fortsätta lägga till den som en ny profil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเพิ่มโปรไฟล์นี้เป็นโปรไฟล์เริ่มต้นบนอุปกรณ์นี้หรือเพิ่มเป็นโปรไฟล์ใหม่ต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profili bu aygıtta saptanmış profil olarak ekleyebilir ya da yeni profil olarak eklemeyi sürdürebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна додати цей профіль як типовий на цьому пристрої або додати його як новий профіль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thêm hồ sơ này làm hồ sơ mặc định trên thiết bị này hoặc tiếp tục thêm làm hồ sơ mới."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在这台设备上将此个人资料添加为默认，或继续添加为新个人资料。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在此裝置上將此個人檔案加入為預設個人檔案，或繼續加入為新的個人檔案。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以將此個人檔案加入為此裝置上的預設個人檔案或繼續將其加入為新個人檔案。"
          }
        }
      }
    },
