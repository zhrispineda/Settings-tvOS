    "WirelessAudioSyncAlreadyAppliedAlertSubTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت مزامنة الصوت اللاسلكي لهذا التنسيق على هذا التلفزيون من قبل. يمكنك تكرار المعايرة أو إعادة تعيين النتائج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja s’ha sincronitzat l’àudio sense fil per a aquest format al televisor. Pots repetir el calibratge o restablir els resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace tohoto formátu bezdrátového zvuku na tomto televizoru je už nastavená. Můžete zopakovat kalibraci nebo resetovat výsledky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trådløs lyd er allerede synkroniseret til dette fjernsyns format. Du kan gentage kalibreringen eller nulstille resultaterne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drahtloses Audio ist für dieses Format auf diesem TV-Gerät bereits synchronisiert. Du kannst die Kalibrierung wiederholen oder deine Ergebnisse zurücksetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ασύρματος ήχος είναι ήδη συγχρονισμένος για αυτήν τη μορφή σε αυτήν την τηλεόραση. Μπορείτε να επαναλάβετε τη διακρίβωση ή να κάνετε επαναφορά των αποτελεσμάτων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wireless audio is already synchronized for this format on this television. You can repeat the calibration or reset your results."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Wireless audio is already synchronised for this format on this television. You can repeat the calibration or reset your results."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wireless audio is already synchronised for this format on this television. You can repeat the calibration or reset your results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio inalámbrico ya está sincronizado para este formato en este televisor. Puedes repetir la calibración o restablecer los resultados."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio inalámbrico ya está sincronizado para este formato en esta TV. Puedes repetir la calibración o restaurar los resultados."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio inalámbrico ya está sincronizado para este formato en esta TV. Puedes repetir la calibración o restaurar los resultados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Langaton ääni on jo synkronoitu tähän muotoon tässä televisiossa. Voit toistaa kalibroinnin tai nollata tulokset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio sans fil est déjà synchronisé pour ce format sur ce téléviseur. Vous pouvez recommencer l’étalonnage ou réinitialiser vos résultats."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format audio sans fil est déjà synchronisé avec cette télévision. Vous pouvez répéter l’étalonnage ou réinitialiser vos résultats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר בוצע סנכרון שמע אלחוטי עבור פורמט זה במכשיר הטלוויזיה. ניתן לבצע כיול מחדש או לאפס את התוצאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टेलीविज़न पर इस फ़ॉर्मैट के लिए वायरलेस ऑडियो पहले से सिंक्रोनाइज़ किया हुआ है। आप दोबारा कैलिब्रेशन कर सकते हैं या अपने परिणाम रीसेट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežični audio signal već je sinkroniziran za ovaj format na ovom TV-u. Možete ponoviti kalibraciju ili resetirati rezultate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vezeték nélküli hang már szinkronizálva van ehhez a formátumhoz a televízión. Megismételheti a kalibrációt, vagy alaphelyzetbe állíthatja az eredményeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio nirkabel telah diselaraskan untuk format ini di televisi ini. Anda dapat mengulangi kalibrasi atau mengatur ulang hasil Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio wireless è già sincronizzato per questo formato su questa TV. Puoi ripetere la calibrazione o inizializzare i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテレビでは、ワイヤレスオーディオはこのフォーマットに同期されています。調整を繰り返したり、結果をリセットすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 오디오가 이미 이 텔레비전에서 해당 포맷으로 동기화되었습니다. 보정을 반복하거나 결과를 재설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wayarles telah diselaraskan untuk format ini pada televisyen ini. Anda boleh mengulangi kalibrasi atau mereset keputusan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trådløs lyd for dette formatet er allerede synkronisert på denne TV-en. Du kan gjenta kalibreringen eller nullstille resultatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De draadloze audio is al gesynchroniseerd voor deze structuur op deze televisie. Je kunt de kalibratie herhalen of je resultaten herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezprzewodowy dźwięk jest już zsynchronizowany dla tego formatu na tym telewizorze. Możesz powtórzyć kalibrację lub wyzerować swoje wyniki."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio sem fio já está sincronizado para este formato nesta televisão. Você pode repetir a calibragem ou redefinir os resultados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio sem fios já está sincronizado para este formato nesta televisão. Pode repetir a calibragem ou repor os resultados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul wireless este deja sincronizat pentru acest format pe acest televizor. Puteți să repetați calibrarea sau să vă resetați rezultatele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телевизоре уже синхронизирована беспроводная передача аудио для этого формата. Вы можете повторить калибровку или выполнить сброс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezdrôtový zvuk v tomto formáte už je na tomto televízore synchronizovaný. Môžete zopakovať kalibráciu alebo resetovať výsledky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brezžični zvok je že sinhroniziran za to obliko zapisa v tem televizorju. Lahko znova izvedete umerjanje ali pa ponastavite rezultate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trådlöst ljud har redan synkroniserats för det här formatet på denna TV. Du kan upprepa kalibreringen eller nollställa resultaten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงแบบไร้สายถูกเชื่อมข้อมูลเรียบร้อยแล้วสำหรับรูปแบบนี้บนโทรทัศน์เครื่องนี้ คุณสามารถปรับเทียบอีกครั้งหรือรีเซ็ตผลการปรับเทียบของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kablosuz ses bu televizyonda bu biçimle zaten eşzamanlanmış. Kalibrasyonu yineleyebilir veya sonuçları sıfırlayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бездротову аудіосинхронізацію вже застосовано для цього формату на поточному телевізорі. Можна повторити калібрування чи скинути результати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh không dây đã được đồng bộ hóa cho định dạng này trên tivi này. Bạn có thể lặp lại quá trình hiệu chỉnh hoặc đặt lại các kết quả."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无线音频已针对这台电视上的此格式同步。你可以重复校准或还原结果。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此電視的無線音訊已同步為此格式。你可以重複校正或重設結果。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已在這台電視上同步此格式的無線音訊。你可以重複校正或重置結果。"
          }
        }
      }
    },
