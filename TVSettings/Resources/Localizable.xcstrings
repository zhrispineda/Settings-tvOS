    "RestrictionsSiriExplicitLanguageHideDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم التشويش على الكلمات غير اللائقة تلقائيًا في Siri."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El llenguatge explícit s’ocultarà automàticament a Siri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bude automaticky skrývat explicitní výrazy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstødelige ord skjules automatisk i Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstößige Ausdrücke werden in Siri automatisch verborgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ακατάλληλες λέξεις θα αποκρύπτονται αυτόματα στο Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit words will be automatically obscured in Siri."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit words will be automatically obscured in Siri."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit words will be automatically obscured in Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de lenguaje explícito se ocultarán automáticamente en Siri."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ocultará automáticamente el lenguaje explícito."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ocultará automáticamente el lenguaje explícito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapsille sopimattomat sanat kätketään Sirissä automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots explicites seront automatiquement obscurcis dans Siri."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots grossiers seront automatiquement dissimulés par Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים בוטות יוסתרו באופן אוטומטי ב-Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri द्वारा अश्लील शब्दों को ऑटोमैटिकली अस्पष्ट कर दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri će automatski sakriti eksplicitne riječi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szókimondó szavak automatikusan ki lesznek takarva Siriben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata eksplisit akan dikaburkan secara otomatis di Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole che presentano un linguaggio esplicito verranno automaticamente censurate su Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriの不適切な言葉が自動的に隠されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에서 비속어를 자동으로 가립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan eksplisit akan dilindungi secara automatik dalam Siri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplisitte ord vil automatisk bli sensurert i Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliciet taalgebruik wordt automatisch gecensureerd in Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wulgaryzmy w Siri będą automatycznie ukrywane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras explícitas serão automaticamente censuradas na Siri."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras obscenas serão automaticamente disfarçadas em Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele explicite vor fi ascunse automat în Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненормативные слова будут автоматически скрыты в Siri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bude automaticky skrývať nevhodné slová."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri bo samodejno skrila nazorno besedišče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fula ord döljs automatiskt i Siri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่ไม่เหมาะสมจะถูกกันอย่างอัตโนมัติโดย Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygunsuz sözcükler Siri’de otomatik olarak gizlenecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нецензурні слова будуть автоматично завуальовані у Siri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ thô tục sẽ được tự động che mờ trong Siri."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "儿童不宜用语在Siri中将自动隐藏。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會自動屏蔽兒童不宜的字詞。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri會自動隱藏兒少不宜的文字。"
          }
        }
      }
    },
