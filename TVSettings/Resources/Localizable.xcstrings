            "state": "translated",
            "value": "Czy chcesz zmienić system numerowania na tym Apple TV?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseja alterar o sistema de numeração da Apple TV?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de alterar o sistema de numeração da Apple TV?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doriți să schimbați sistemul de numerotare al acestui Apple TV?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите сменить систему счисления этого Apple TV?"
          }
        },
