    "LanguageRevertChangesMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي الإرجاع إلى التراجع عن تغييراتك. هل ترغب بالتأكيد في إرجاع تغييراتك وفقدانها؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si reverteixes els canvis que hagis fet, es desfaran i els perdràs. Confirmes que els vols revertir?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácením zrušíte změny, které jste provedli. Určitě chcete nastavení vrátit a přijít o provedené změny?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagestil fortryder dine ændringer. Er du sikker på, at du vil tilbagestille og miste dine ændringer?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zurücksetzen“ macht deine Änderungen rückgängig. Möchtest du die Änderungen wirklich zurücksetzen und verwerfen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επαναφορά θα αναιρέσει τις αλλαγές σας. Θέλετε σίγουρα να κάνετε επαναφορά και να χάσετε τις αλλαγές;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert will undo your changes. Are you sure you want to revert and lose your changes?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert will undo your changes. Are you sure you want to revert and lose your changes?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert will undo your changes. Are you sure you want to revert and lose your changes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opción deshará tus modificaciones. ¿Seguro que quieres restaurar los cambios?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revertir, se perderán los cambios realizados. ¿Quieres revertir?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revertir, se perderán los cambios realizados. ¿Quieres revertir?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaminen peruu muutokset. Palautetaanko, jolloin menetät muutokset?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous sélectionnez Rétablir, vos modifications seront annulées. Voulez-vous vraiment rétablir les réglages et annuler vos modifications ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’option Rétablir annulera vos modifications. Voulez-vous vraiment continuer et perdre vos modifications?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרה לגירסה האחרונה תבטל את השינויים שביצעת. האם ברצונך לחזור לגירסה האחרונה ולבטל את השינויים?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिवर्ट करने से आपके बदलाव पहले जैसे हो जाएँगे। क्या आप निश्चित हैं कि आप अपने बदलावों को रिवर्ट करना और खोना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćanjem će se vaše promjene poništiti. Sigurno se želite vratiti i izgubiti svoje promjene?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszaállítás visszavonja az Ön módosításait. Biztosan végrehajtja a visszaállítást, és elveszíti a módosításait?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan akan mengurungkan perubahan Anda. Apakah Anda yakin ingin mengembalikan dan kehilangan semua perubahan Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliendo Ripristina, annullerai tutte le modifiche. Confermi di voler procedere e di non volerle salvare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すと変更は取り消されます。元に戻して変更を破棄してもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘복귀’를 선택하면 변경 사항이 취소됩니다. 변경 전으로 복귀하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali akan membuat asal perubahan anda. Adakah anda pasti mahu kembali dan kehilangan perubahan anda?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestill vil angre endringene dine. Er du sikker på at du vil tilbakestille og forkaste endringene?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met 'Herstel' worden je wijzigingen ongedaan gemaakt. Weet je zeker dat je je wijzigingen wilt herstellen en verliezen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie spowoduje wycofanie zmian. Czy na pewno chcesz przywrócić i utracić zmiany?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você reverter, suas alterações serão desfeitas. Tem certeza de que deseja reverter e perder as alterações?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restabelecer, as alterações serão desfeitas. Tem a certeza de que pretende restabelecer e perder as alterações?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenirea va anula modificările. Sigur doriți să reveniți și să pierdeți modificările?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если нажать кнопку «Вернуть», изменения будут отменены. Вы действительно не хотите сохранять изменения?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátením odvoláte vykonané zmeny. Naozaj chcete vrátiť nastavenia a zahodiť zmeny, ktoré ste spravili?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če izberete možnost Povrni, razveljavite svoje spremembe. Ste prepričani, da želite povrniti in izgubiti svoje spremembe?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återgå innebär att ändringarna går förlorade. Är du säker på att du vill återgå och förlora ändringarna?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลงกลับจะยกเลิกการแก้ไขของคุณ คุณแน่ใจหรือไม่ว่าคุณต้องการแปลงกลับ\nและสูญเสียการแก้ไขของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Al’ı seçtiğinizde değişiklikleriniz geri alınır. Geri alıp değişikliklerinizin kaybolmasını istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо відновити попередні налаштування, зміни буде скасовано. Справді відновити й скасувати зміни?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sẽ hoàn tác thay đổi của bạn. Bạn có chắc chắn muốn khôi phục và mất các thay đổi không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "复原将撤销更改。确定要复原并丢弃更改吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "回復將會還原你的變更。你確定要回復並捨棄變更嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "回復將還原你的更動。確定要回復並捨棄你的更動嗎？"
          }
        }
      }
    },
