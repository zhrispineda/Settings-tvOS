    "AXVoiceOverDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "ينطق التعليق الصوتي العناصر الموجودة على الشاشة ويوفر تلميحات مفيدة.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "El VoiceOver llegeix en veu alta els ítems de la pantalla i et dona indicacions útils.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "VoiceOver čte položky na obrazovce a poskytuje užitečnou nápovědu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "VoiceOver læser emner på skærmen op og giver nyttige tips.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "VoiceOver liest Objekte auf dem Bildschirm vor und gibt nützliche Hinweise.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Το VoiceOver εκφωνεί τα στοιχεία στην οθόνη και παρέχει χρήσιμες υποδείξεις.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "VoiceOver speaks items on the screen and provides helpful hints.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "VoiceOver speaks items on the screen and provides helpful hints.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
