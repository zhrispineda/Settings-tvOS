    "NetworkSecureWiFiItemDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحميل ملف تعريف AppleSecureWiFi لتمكين الاتصال بالشبكة الآمنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega el perfil d’AppleSecureWiFi per activar la connexió amb la xarxa segura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li aktivovat připojení k zabezpečené síti, načtěte profil AppleSecureWiFi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæs AppleSecureWiFi-profilen for at slå forbindelse til det sikre netværk til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade das AppleSecureWiFi-Profil, um die Verbindung zum sicheren Netzwerk zu aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώστε το προφίλ AppleSecureWiFi για να καταστεί δυνατή η σύνδεση στο ασφαλές δίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the AppleSecureWiFi profile to enable connection to the secure network."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the AppleSecureWiFi profile to enable connection to the secure network."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the AppleSecureWiFi profile to enable connection to the secure network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el perfil de AppleSecureWiFi para permitir la conexión a la red segura."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el perfil AppleSecureWiFi para activar la conexión a la red segura."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el perfil AppleSecureWiFi para activar la conexión a la red segura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota käyttöön suojattu verkkoyhteys lataamalla AppleSecureWiFi-profiili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le profil AppleSecureWiFi pour activer la connexion au réseau sécurisé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le profil AppleSecureWiFi pour activer la connexion au réseau sécurisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לטעון את הפרופיל AppleSecureWiFi כדי לאפשר חיבור לרשת המאובטחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित नेटवर्क पर कनेक्शन सक्षम करने के लिए AppleSecureWiFi प्रोफ़ाइल को लोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitajte AppleSecureWiFi profil kako biste omogućili povezivanje sa sigurnom mrežom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töltse be az AppleSecureWiFi-profilt a védett hálózathoz való csatlakozáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat profil AppleSecureWiFi untuk mengaktifkan koneksi ke jaringan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica il profilo AppleSecureWiFi per consentire la connessione alla rete sicura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleSecureWiFiプロファイルを読み込んでセキュリティ保護されたネットワークへの接続を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 네트워크에 연결을 활성화하려면 AppleSecureWiFi 프로필을 로드하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muatkan profil AppleSecureWiFi untuk mendayakan sambungan ke rangkaian selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last inn AppleSecureWiFi-profilen for å kunne koble til det sikre nettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad het AppleSecureWiFi-profiel om verbinding met het beveiligde netwerk te kunnen maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby umożliwić łączenie się z siecią zabezpieczoną, wczytaj profil AppleSecureWiFi."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue o perfil AppleSecureWiFi para conectar à rede segura."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar o perfil AppleSecureWiFi para permitir estabelecer ligação à rede segura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcați profilul AppleSecureWiFi pentru a permite conexiunea la rețeaua securizată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить профиль AppleSecureWiFi, чтобы активировать подключение к безопасной сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete povoliť pripájanie k zabezpečenej sieti, načítajte profil AppleSecureWiFi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naložite profil AppleSecureWiFi, da omogočite povezavo z varnim omrežjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs in AppleSecureWiFi-profilen så att du kan ansluta till det säkra nätverket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดโปรไฟล์ AppleSecureWiFi เพื่อเปิดใช้งานการเชื่อมต่อกับเครือข่ายที่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
