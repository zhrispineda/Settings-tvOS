    "NotificationsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للتطبيقات إبلاغك بالإشعارات الجديدة عن طريق إظهار شارة على أيقونة التطبيق. يمكنك تشغيل ذلك أو إيقافه لكل تطبيق على حدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan hi hagi una notificació nova en una app, es mostrarà un globus a la icona. Pots activar o desactivar les notificacions de cada app de manera individual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace vás můžou informovat o nových oznámeních pomocí odznaků na ikonách. Zobrazování odznaků můžete zapnout nebo vypnout pro každou aplikaci samostatně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps kan informere dig om nye notifikationer ved at vise en etiket på appsymbolet. Du kan slå dem til eller fra for hver app enkeltvis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mithilfe von App-Symbolkennzeichen können Apps dich über neue Mitteilungen informieren. Sie können für jede App einzeln ein- oder ausgeschaltet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές μπορούν να σας ενημερώνουν για νέες γνωστοποιήσεις με εμφάνιση μιας ταμπέλας στο εικονίδιο εφαρμογής. Μπορείτε να ενεργοποιήσετε ή να απενεργοποιήσετε αυτήν την επιλογή για κάθε εφαρμογή ξεχωριστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps can let you know about new notifications by showing an app icon badge. You can turn them on or off for each app individually."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps can let you know about new notifications by showing an app icon badge. You can turn them on or off for each app individually."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps can let you know about new notifications by showing an app icon badge. You can turn them on or off for each app individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps te pueden avisar si hay notificaciones nuevas mostrando un globo en el icono de la app. Puedes activar o desactivar esta opción para cada app individualmente."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps pueden indicarte si tienes notificaciones nuevas mediante un contador en su ícono. Puedes activar o desactivar esta opción para cada app."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps pueden indicarte si tienes notificaciones nuevas mediante un contador en su ícono. Puedes activar o desactivar esta opción para cada app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit voivat ilmoittaa uusista ilmoituksista merkillä apin kuvakkeessa. Voit laittaa toiminnon päälle tai pois päältä jokaiselle apille erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps peuvent vous informer de nouvelles notifications en affichant une pastille sur leur icône. Activez ou désactivez-les pour chaque app."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps peuvent vous communiquer des notifications en affichant une pastille sur leur icône. Vous pouvez les activer ou les désactiver app par app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים יכולים ליידע אותך לגבי עדכונים חדשים על-ידי הצגת תג של אייקון היישום. ניתן להפעיל או לכבות את העדכונים האלו עבור כל יישום בנפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आइकॉन बैज दिखाकर ऐप्स आपको नई सूचनाओं के बारे में बता सकते हैं। आप उन्हें प्रत्येक ऐप के लिए अलग-अलग चालू या बंद कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije vas mogu informirati o novim obavijestima putem bedža na ikoni aplikacije. Možete ih uključiti ili isključiti za svaku aplikaciju pojedinačno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok egy appikon-jelvénnyel képesek jelezni az új értesítéseket. Ez a funkció apponként külön be- vagy kikapcsolható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App dapat memberi tahu Anda mengenai pemberitahuan baru dengan menampilkan tanda ikon app. Anda dapat menyalakan atau mematikannya untuk setiap app secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app ti informano della presenza di nuove notifiche tramite un badge sull’icona dell’app. Puoi attivare o disattivare i badge per ogni app individualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでは、アプリアイコンバッジを表示して新しい通知を知らせることができます。アプリごとに個別に通知のオン/オフを切り替えることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 앱 아이콘 배지를 표시하여 새로운 알림에 대해 알려줄 수 있습니다. 각각의 앱에서 알림을 개별적으로 켜거나 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App boleh memberitahu anda tentang pemberitahuan baharu dengan menunjukkan lencana ikon app. Anda boleh mengaktifkan atau menyahaktifkannya bagi setiap app secara individu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper kan indikere nye varslinger ved å vise et merke på appsymbolet. Du kan slå dem av og på for hver enkelt app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt apps een badge op het appsymbool laten weergeven als er nieuwe meldingen zijn. Dit kun je voor elke app afzonderlijk instellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje mogą informować o nowych powiadomieniach, wyświetlając plakietki na swoich ikonach. Funkcję tę możesz włączać i wyłączać dla każdej z aplikacji osobno."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps podem usar um ícone para informar sobre novas notificações. Você pode ativá‑las e desativá‑las para cada app individualmente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações podem avisar que tem notificações novas através de emblemas nos respetivos ícones. Pode ativar ou desativar esta opção individualmente, por aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile vă pot informa despre notificările noi prin afișarea unei insigne pe pictogramele lor. Puteți activa sau dezactiva notificările individual pentru fiecare aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклейка на значке приложения означает, что пришло новое уведомление. Вы можете включать и выключать наклейки по отдельности для каждого приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apky vás môžu informovať o nových hláseniach zobrazením odznaku na ikone apky. Odznak môžete zapnúť alebo vypnúť samostatne pre každú apku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije vas lahko obvestijo o novih obvestilih s prikazom znaka za ikono aplikacije. To lahko vklopite ali izklopite za vsako aplikacijo posebej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar kan berätta om nya meddelanden genom att visa en appsymbolbricka. Du kan slå av och på symbolbrickor för varje enskild app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปสามารถแสดงให้คุณทราบได้ว่ามีการแจ้งเตือนใหม่โดยการแสดงป้ายกำกับบนไอคอนของแอป คุณสามารถเปิดใช้หรือปิดใช้การแจ้งเตือนของแต่ละแอปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar, yeni bildirimler olduğunu bir uygulama işareti göstererek size haber verebilir. Bildirimleri, her bir uygulama için teker teker açabilir veya kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми можуть сигналізувати про нові сповіщення значками на своїх іконках. Значки можна вмикати й вимикати для кожної програми окремо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng có thể cho bạn biết về thông báo mới bằng cách hiển thị biểu tượng ứng dụng. Bạn có thể bật hoặc tắt thông báo cho từng ứng dụng riêng lẻ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "App可通过显示App图标标记来告知你新通知。你可以针对每个App单独打开或关闭通知。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "App透過顯示圖像標記讓你知道有新通知。你可以開啟或關閉個別App的有關選項。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "App會顯示圖像標記讓你知道有新的通知。你可以開啟或關閉個別App設定。"
          }
        }
      }
    },
