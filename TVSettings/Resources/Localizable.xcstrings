            "value": "Simulátor další profily nepodporuje. Použijte Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatoren understøtter ikke yderligere profiler. Brug en Apple TV-enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Simulator werden keine weiteren Profile unterstützt. Benutze ein Apple TV-Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υποστηρίζονται πρόσθετα προφίλ στον προσομοιωτή. Χρησιμοποιήστε μια συσκευή Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional profiles are not supported on the simulator. Please use an Apple TV device."
          }
        },
