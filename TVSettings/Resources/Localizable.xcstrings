    "AVRestoreDefaultDisplayModeAlertSubtitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تواجه مشكلات في الكبل أو الشاشة لديك،\nفسيتم إرجاع تلفزيونك إلى تنسيق متوافق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tens cap problema amb el cable o la pantalla,\nes canviarà el format del televisor per un de compatible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud máte problémy s kabelem nebo obrazem,\ntato volba přepne televizor zpět do kompatibilního formátu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har problemer med dit kabel eller din skærm,\nændrer denne funktion dit fjernsyn tilbage til et kompatibelt format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls bei deinem Kabel oder Display Probleme auftreten,\nwird hiermit dein Fernsehgerät auf ein kompatibles Format zurückgesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αντιμετωπίζετε προβλήματα με το καλώδιο ή την οθόνη,\nαυτή η ενέργεια θα επαναφέρει την τηλεόραση σε συμβατή μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re experiencing problems with your cable or display,\nthis will switch your TV back to a compatible format."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re experiencing problems with your cable or display,\nthis will switch your TV back to a compatible format."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re experiencing problems with your cable or display,\nthis will switch your TV back to a compatible format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con el cable o la pantalla,\nesta opción restaurará la configuración del televisor a un formato compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con tu cable \no pantalla, esta opción restaurará\ntu TV a un formato compatible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con tu cable \no pantalla, esta opción restaurará\ntu TV a un formato compatible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kaapelin tai näytön kanssa on ongelmia, \ntämä vaihtaa TV:n takaisin yhteensopivaan näyttötilaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez des problèmes de câble ou d’affichage, cette\noption permet de rétablir un format compatible sur votre téléviseur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez des problèmes avec votre câble ou l’affichage,\nceci rétablira l’affichage de votre télévision à un format compatible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם מתגלות בעיות הקשורות לכבל או לתצוגה,\nפעולה זו תחזיר את תצוגת הטלוויזיה שלך לפורמט תואם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपको अपनी केबल या डिस्प्ले के साथ समस्या हो रही है,\nतो यह आपके टीवी को वापस संगत फ़ॉर्मैट पर स्विच कर देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako imate problema s kabelom ili zaslonom,\novom opcijom će se vaš TV prebaciti natrag na kompatibilni format."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amennyiben problémákat tapasztal a kábelével vagy a megjelenítéssel kapcsolatban,\nezzel visszaállíthatja a tévékészülékét egy kompatibilis formátumra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mengalami masalah dengan kabel atau layar Anda,\nini akan mengalihkan TV Anda kembali ke format yang kompatibel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di problemi con il cavo o lo schermo,\nverrà utilizzato un formato compatibile sul tuo televisore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブルまたはディスプレイで問題が起きている場合は、\nテレビが互換性のあるフォーマットに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블 또는 화면에 문제가 있다면\nTV를 호환되는 포맷으로 다시 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda mengalami masalah dengan kabel atau paparan anda,\nini akan mengubah kembali TV anda kepada format yang serasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har problemer med kabelen eller skjermen,\nvil TV-en bytte tilbake til et kompatibelt format."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er zich problemen voordoen met je kabel of scherm,\nwordt hiermee je tv hersteld naar een compatibele structuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku problemów z kablem lub ekranem\ntelewizor zostanie ponownie przełączony na zgodny format."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tiver problemas com o cabo ou a tela,\na TV voltará a um formato compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso detete algum problema no funcionamento do cabo ou do ecrã,\nesta opção mudará a televisão para um formato compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă întâmpinați probleme legate de cablu sau de afișaj,\naceastă operație va comuta televizorul înapoi la un format compatibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При возникновении проблем с кабелем или дисплеем\nэто действие переключит телевизор обратно в совместимый формат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máte problémy s káblom alebo obrazom, týmto prepnete\ntelevízor späť do kompatibilného formátu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če imate težave s kablom ali zaslonom,\nboste s tem preklopili televizor nazaj v združljivo obliko zapisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det har uppstått problem med kabeln eller skärmen\nåterställer detta din TV till ett kompatibelt format."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณประสบปัญหากับสายหรือจอภาพของคุณ\nการทำงานนี้จะเปลี่ยนทีวีของคุณกลับเป็นรูปแบบที่ใช้งานร่วมกันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabloda ya da ekranda sorun yaşıyorsanız,\nTV’niz uyumlu bir biçime geri döndürülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо виникли проблеми з кабелем чи дисплеєм,\nця дія поверне ваш телевізор у сумісний формат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đang gặp sự cố với cáp hoặc màn hình,\nnút này sẽ chuyển TV của bạn trở lại định dạng tương thích."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的线缆或显示器出现问题，\n此操作会将电视切换回兼容格式。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如你的連接線或顯示器發生問題，\n這樣會將你的電視切回至相容的格式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若你的連接線或顯示器發生問題，\n這會將你的電視切回相容的格式。"
          }
        }
      }
    },
    "AVRestoreDefaultDisplayModeAlertTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إعادة تعيين إعدادات الفيديو؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols restablir la configuració de vídeo?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete nastavení obrazu resetovat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil nulstille dine videoindstillinger?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen die Videoeinstellungen wirklich zurückgesetzt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να επαναφέρετε τις ρυθμίσεις βίντεο;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your video settings?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your video settings?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your video settings?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres restablecer los ajustes de vídeo?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres restablecer la configuración de video?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres restablecer la configuración de video?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollataanko videoasetukset?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment réinitialiser vos réglages vidéo ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment réinitialiser vos réglages vidéo?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך לאפס את הגדרות הווידאו שלך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निश्चित हैं कि अपनी वीडियो सेटिंग को रीसेट करना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurno želite resetirati postavke slike?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztos benne, hogy alaphelyzetbe szeretné állítani a videóbeállításokat?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin mengatur ulang pengaturan video?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi di voler inizializzare le impostazioni video?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にビデオ設定をリセットしてもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 설정을 재설정하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu mereset seting video anda?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil nullstille videoinnstillingene?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je je video-instellingen wilt herstellen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz wyzerować ustawienia wideo?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja redefinir os seus ajustes de vídeo?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de repor as definições de vídeo?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți resetarea configurărilor video?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите сбросить свои настройки видео?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete resetovať nastavenia videa?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste prepričani, da želite ponastaviti nastavitve videa?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill nollställa dina videoinställningar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องการรีเซ็ตการตั้งค่าวิดีโอของคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video ayarlarınızı sıfırlamak istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справді скинути параметри відео?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn đặt lại cài đặt video không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要还原视频设置吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要重設你的影片設定嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要重置你的影像設定嗎？"
          }
        }
      }
    },
    "AVRestoreDefaultDisplayModeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تواجه مشكلات في شاشة العرض، يمكنك إعادة تعيين إعدادات الفيديو في Apple TV لجعلها متوافقة مع تلفزيونك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tens problemes amb la visualització de la pantalla, pots restablir la configuració de vídeo de l’Apple TV perquè sigui compatible amb el teu televisor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud máte problémy s displejem, můžete resetovat nastavení obrazu na Apple TV, čímž zajistíte jejich kompatibilitu s televizorem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har problemer med skærmen, kan du nulstille videoindstillingerne for dit Apple TV, så de er kompatible med dit fjernsyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Probleme mit dem Display hast, kannst du die Videoeinstellungen des Apple TV zurücksetzen, sodass sie mit deinem TV-Gerät kompatibel sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αντιμετωπίζετε ζητήματα με την οθόνη, μπορείτε να επαναφέρετε τις ρυθμίσεις βίντεο του Apple TV σας ώστε να είναι συμβατές με την τηλεόρασή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re having display issues, you can reset the video settings of your Apple TV to make them compatible with your TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re having display issues, you can reset the video settings of your Apple TV to make them compatible with your TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re having display issues, you can reset the video settings of your Apple TV to make them compatible with your TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con la visualización de la pantalla, puedes restablecer los ajustes de vídeo de tu Apple TV para que sean compatibles con tu televisor."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con la imagen, puedes restablecer\nla configuración de video de tu Apple TV para que sea\ncompatible con tu TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes problemas con la imagen, puedes restablecer\nla configuración de video de tu Apple TV para que sea\ncompatible con tu TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos näytön kanssa on ongelmia, voit nollata Apple TV:n videoasetukset ja käyttää videoasetuksia, jotka ovat yhteensopivia TV:si kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez des problèmes d’affichage, vous pouvez réinitialiser les réglages vidéo de votre Apple TV pour faire en sorte qu’ils soient compatibles avec votre téléviseur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous rencontrez des problèmes d’affichage, vous pouvez réinitialiser les réglages vidéo de votre Apple TV pour qu’ils soient compatibles avec votre télévision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם מתרחשות בעיות בתצוגה, באפשרותך לאפס את הגדרות הווידאו ב-Apple TV כדי שיהיו תואמות לטלוויזיה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको डिस्प्ले संबंधी समस्याएँ हो रही हैं, तो आप अपने टीवी से संगत बनाने के लिए अपने Apple TV पर वीडियो सेटिंग रीसेट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako imate problema s prikazom slike, možete resetirati video postavke Apple TV-a kako bi bile kompatibilne s vašim TV-om."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megjelenítési problémákat tapasztal, akkor az Apple TV videóbeállításainak alaphelyzetbe állításával kompatibilissé teheti azokat a televíziójával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda sedang mengalami masalah layar, Anda dapat mengatur ulang pengaturan video Apple TV untuk membuatnya kompatibel dengan TV Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di problemi di visualizzazione, puoi inizializzare le impostazioni video di Apple TV in modo tale da ottimizzare le opzioni in base alle caratteristiche del tuo televisore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面表示に問題がある場合は、Apple TVのビデオ設定をリセットするとお使いのテレビと互換性がある設定を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 문제가 있다면 Apple TV의 비디오 설정을 재설정하여 사용자의 TV와 호환되도록 할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menghadapi masalah paparan, anda boleh mereset seting video Apple TV anda untuk menjadikannya serasi dengan TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har problemer med skjermen, kan du nullstille videoinnstillingene på Apple TV for å gjøre dem kompatible med TV-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er zich problemen voordoen met de weergave, kun je de video-instellingen van je Apple TV herstellen, zodat ze compatibel zijn met je tv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli masz problemy z ekranem, możesz wyzerować ustawienia wideo Apple TV, aby były zgodne z Twoim TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver tendo problemas de exibição, você pode redefinir os ajustes de vídeo da Apple TV para torná-los compatíveis com a sua TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver a ter problemas com o ecrã, pode repor as definições de vídeo da Apple TV para as tornar compatíveis com a televisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă întâmpinați probleme de afișare, vă puteți reseta configurările video ale Apple TV‑ului pentru a le face compatibile cu televizorul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При возникновении проблем с дисплеем можно сбросить настройки видео на Apple TV, чтобы настройки были совместимы с Вашим телевизором."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máte problémy s displejom, môžete resetovať nastavenia videa Apple TV, aby boli opäť kompatibilné s televízorom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če imate težave s prikazom, lahko ponastavite nastavitve za video vašega Apple TV-ja, da bodo združljive z vašim televizorjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du har problem med bildskärmen kan du återställa bildinställningarna för Apple TV så att de blir kompatibla med denna TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าจอภาพของคุณมีปัญหา คุณสามารถรีเซ็ตการตั้งค่าวิดีโอ\nของ Apple TV ของคุณเพื่อให้ใช้งานร่วมกันได้กับทีวีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme sorunları yaşıyorsanız TV’nizle uyumlu hale getirmek için Apple TV’nizin video ayarlarını sıfırlayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас виникли проблеми з відображенням, ви можете скинути ці параметри відео свого Apple TV, щоб узгодити їх із вашим телевізором."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đang gặp sự cố hiển thị, bạn có thể đặt lại các cài đặt video của Apple TV để làm chúng tương thích với TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果遇到显示问题，你可以还原Apple TV的视频设置，使其与你的电视兼容。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如你的顯示器發生問題，你可以重設Apple TV的影片設定來使其與你的電視相容。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若你的顯示器發生問題，你可以重置Apple TV的影像設定，使其與你的電視相容。"
          }
        }
      }
    },
