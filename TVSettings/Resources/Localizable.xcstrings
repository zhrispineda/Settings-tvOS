    "iCloudPhotoLibraryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغل صور iCloud حتى يمكنك عرض الصور من \"%@\" أو استخدامها كشاشة توقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mirar les fotos que tens a %@ o utilitzar‑les com a estalvi de pantalla, activa les fotos a l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li si prohlížet fotky z „%@“ nebo je použít jako spořič obrazovky, zapněte službu Fotky na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå iCloud-fotos til, så du kan se fotos fra “%@“ eller bruge dem som skærmskåner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere iCloud-Fotos, um Fotos von „%@“ zu sehen oder sie als Bildschirmschoner zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις Φωτογραφίες iCloud για να μπορείτε να προβάλετε φωτογραφίες από «%@» ή να τις χρησιμοποιείτε ως προφύλαξη οθόνης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on iCloud Photos so you can view photos from “%@“ or use them as a screen saver."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on iCloud Photos so you can view photos from “%@“ or use them as a screen saver."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on iCloud Photos so you can view photos from “%@“ or use them as a screen saver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Fotos en iCloud para poder ver las fotos de %@ o usarlas como salvapantallas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Fotos en iCloud para poder ver fotos de “%@“ o para usarlas como protector de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Fotos en iCloud para poder ver fotos de “%@“ o para usarlas como protector de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita iCloud-kuvat päälle, jotta voit näyttää tilin %@ kuvia tai käyttää niitä näytönsäästäjänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Photos iCloud pour afficher des photos de « %@ » ou les utiliser comme économiseurs d’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Photos iCloud afin de pouvoir afficher des photos de « %@ » ou de les utiliser comme économiseurs d’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להפעיל את ״תמונות iCloud״ כדי להציג תמונות מ-״%@״ או להשתמש באחת מהן כשומר מסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud तस्वीर चालू करें, ताकि आप “%@“ से तस्वीरें देख सकें या उनका स्क्रीन सेवर के रूप में इस्तेमाल कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite iCloud fotografije kako biste mogli gledati fotografije iz računa “%@” ili ih koristiti kao zaštitu zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-fotók bekapcsolásával megtekintheti „%@” fotóit. Ezeket a fotókat képernyővédőként is felhasználhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Foto iCloud agar Anda dapat melihat foto dari “%@“ atau menggunakannya sebagai penghemat layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva “Foto di iCloud” per visualizzare le foto di “%@” o utilizzarle come salvaschermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud写真をオンにすると“%@”からの写真を表示したり、スクリーンセーバとして使用したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 사진을 켜서 ’%@’의 사진을 보거나 화면 보호기로 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Foto iCloud supaya anda boleh melihat foto daripada “%@“ atau gunakannya sebagai penyelamat skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på iCloud Bilder slik at du kan se bilder fra «%@» eller bruker dem som skjermsparer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel iCloud-foto's in, zodat je foto's van '%@' kunt bekijken of ze kunt gebruiken als schermbeveiliging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Zdjęcia w iCloud, aby móc wyświetlać zdjęcia z konta „%@” lub używać ich jako wygaszacza ekranu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as Fotos do iCloud para ver fotos de “%@“ ou usá‑las como protetor de tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Fotografias em iCloud para poder ver fotografias de “%@“ ou usá‑las como proteção de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Poze iCloud pentru a putea vedea pozele din contul „%@” sau pentru a le utiliza ca screensaver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать фото из медиатеки «%@» или использовать их в качестве заставки, включите Фото iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite službu iCloud Fotky a budete si môcť prezerať fotky z účtu %@ alebo ich používať ako šetrič obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite Fotografije iCloud, da si boste lahko ogledali fotografije računa »%@« ali pa jih uporabili kot ohranjevalnik zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera iCloud-bilder om du vill visa bilder från ”%@“ eller använda dem som skärmsläckare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้ “รูปภาพ iCloud” เพื่อให้คุณสามารถดูรูปภาพจาก “%@” หรือใช้เป็นภาพพักหน้าจอได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@“ fotoğraflarını görüntüleyebilmek ve onları ekran koruyucu olarak kullanabilmek için iCloud Fotoğrafları’nı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Фото iCloud, щоб переглядати знімки з «%@» чи використовувати їх як екранну заставку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Ảnh iCloud để bạn có thể xem ảnh từ “%@” hoặc sử dụng chúng làm trình bảo vệ màn hình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“iCloud照片”以便看到来自“%@”的照片或将其用作屏幕保护程序。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「iCloud相片」以便你可以從「%@」中查看相片，或將相片設定為螢幕保護程式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「iCloud照片」後你可以檢視來自「%@」的照片或將照片設為螢幕保護程式。"
          }
        }
      }
    },
