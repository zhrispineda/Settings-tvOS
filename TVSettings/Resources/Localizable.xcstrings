    "NetworkTestExpectedBandwidthDialogText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي سرعة التنزيل التي تتوقع الحصول عليها من اتصال الإنترنت لديك؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quina velocitat de descàrrega esperes de la teva connexió a internet?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakou rychlost stahování od svého internetového připojení očekáváte?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken overførselshastighed forventer du af din internetforbindelse?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Downloadgeschwindigkeit erwartest du von deiner Internetverbindung?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια ταχύτητα λήψης αναμένετε από τη σύνδεσή σας στο Διαδίκτυο;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What download speed do you expect from your internet connection?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "What download speed do you expect from your internet connection?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What download speed do you expect from your internet connection?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué velocidad de descarga debería proporcionarte tu conexión a internet?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué velocidad de descarga debería proporcionarte tu conexión a Internet?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué velocidad de descarga debería proporcionarte tu conexión a Internet?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä latausnopeutta odotat internet-yhteydeltäsi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle vitesse de téléchargement attendez-vous de votre connexion Internet ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle vitesse de téléchargement attendez-vous de votre connexion Internet?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איזו מהירות הורדה אמור חיבור האינטרנט שלך לספק?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इंटरनेट कनेक्शन की अपेक्षित डाउनलोड गति क्या है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koju brzinu preuzimanja očekujete od svoje internetske veze?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen letöltési sebességet vár az internetkapcsolatától?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa kecepatan pengunduhan yang Anda harapkan dari koneksi internet Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la velocità di download della tua connessione a internet?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのインターネット接続で利用できるはずのダウンロード速度はどれくらいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하는 인터넷의 다운로드 속도는 무엇입니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah kelajuan muat turun yang anda harapkan daripada sambungan Internet anda?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken nedlastingshastighet mener du er riktig for din internettforbindelse?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke downloadsnelheid verwacht je van je internetverbinding?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaką szybkość pobierania powinno zapewniać Twoje połączenie internetowe?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é a velocidade de download esperada da sua conexão à internet?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a ligação à internet de que dispõe, que velocidade de descarga espera obter?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce viteză de descărcare așteptați de la conexiunea dvs. la internet?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какую, на Ваш взгляд, скорость загрузки должно иметь Ваше интернет‑соединение?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akú rýchlosť sťahovania očakávate od svojho internetového pripojenia?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakšno hitrost prenosa pričakujete od svoje internetne povezave?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken hämtningshastighet förväntar du dig från din internetanslutning?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคิดว่าจะได้ความเร็วการดาวน์โหลดจากการเชื่อมต่อกับอินเทอร์เน็ตที่เท่าไหร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantınız için indirme hızının ne olmasını bekliyorsunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яку швидкість викачування ви очікуєте від свого інтернет-зʼєднання?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mong muốn tốc độ tải về nào từ kết nối internet của mình?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你期待你的互联网连接下载速度是多少？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你期望你的互聯網連線有多快的下載速度？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望可以從網際網路連線取得多快的下載速度？"
          }
        }
      }
    },
