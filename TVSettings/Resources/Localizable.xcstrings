        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć konto „piaskownicy” %@ z tego Apple TV?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja remover a conta sandbox %@ desta Apple TV?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende remover a conta sandbox “%@” desta Apple TV?"
          }
        },
        "ro": {
          "stringUnit": {
