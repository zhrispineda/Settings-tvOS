    "AVAccessibilityDisplayFiltersWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تمكين تسهيلات الشاشة.\nلتغيير تسهيلات الشاشة، انتقل إلى:\n الإعدادات > تسهيلات الاستخدام > شاشة العرض > تسهيلات الشاشة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les facilitats de visualització estan activades.\nPer canviar‑les, ves a l’app\n Configuració > Accessibilitat > Pantalla > Facilitats de visualització."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zapnuté přizpůsobení displeje.\nChcete‑li ho změnit, přejděte do:\n Nastavení > Zpřístupnění > Displej > Přizpůsobení displeje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasning af skærm er slået til.\nHvis du vil skifte tilpasning af skærm, skal du gå til:\n Indstillinger > Tilgængelighed > Skærm > Tilpasning af skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayanpassungen sind aktiviert.\nZum Ändern der Displayanpassungen gehe zu:\n „Einstellungen“ > „Bedienungshilfen“ > „Anzeige“ > „Displayanpassungen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Βοηθήματα οθόνης είναι ενεργοποιημένα.\nΓια αλλαγή των βοηθημάτων οθόνης, μεταβείτε στις\n «Ρυθμίσεις» > «Προσβασιμότητα» > «Οθόνη» > «Βοηθήματα οθόνης»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display accommodations are enabled.\nTo change display accommodations go to:\n Settings > Accessibility > Display > Display Accommodations."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Display accommodations are enabled.\nTo change display accommodations, go to:\n Settings > Accessibility > Display > Display Accommodations."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Display accommodations are enabled.\nTo change display accommodations, go to:\n Settings > Accessibility > Display > Display Accommodations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de visualización están activados.\nPara cambiarlos, ve a:\n Ajustes > Accesibilidad > Pantalla > Ajustes de visualización."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activaron las adaptaciones de pantalla.\nPara cambiar las adaptaciones de pantalla visita:\n Configuración > Accesibilidad > Pantalla >Adaptaciones de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activaron las adaptaciones de pantalla.\nPara cambiar las adaptaciones de pantalla visita:\n Configuración > Accesibilidad > Pantalla >Adaptaciones de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytön mukautukset ovat käytössä.\nMuuta näytön mukautuksia kohdassa\n Asetukset > Käyttöapu > Näyttö > Näytön mukautus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptation de l’affichage est activée.\nPour changer ceci, accédez à :\n Réglages > Accessibilité > Affichage > Adapter l’affichage."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adaptations d’affichage sont activées.\nPour les modifier, accédez à :\n Réglages > Accessibilité > Affichage > Adaptations d’affichage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאמות התצוגה מופעלות.\nלשינוי התאמות התצוגה יש לעבור אל:\n ״הגדרות״ > ״נגישות״ > ״תצוגה״ > ״התאמות תצוגה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्प्ले सुविधाएँ सक्षम हैं।\nडिस्प्ले सुविधाएँ बदलने के लिए यहाँ जाएँ :\n सेटिंग > ऐक्सेसिबिलिटी > डिस्प्ले > डिस्प्ले सुविधाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućene su prilagodbe zaslona.\nZa promjenu prilagodbi zaslona idite u:\n Postavke > Pristupačnost > Zaslon > Prilagodbe zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelzőbeállítások engedélyezve vannak.\nA kijelzőbeállítások módosításához válassza a következő menüpontot:\n Beállítások > Kisegítő lehetőségek > Megjelenítés > Kijelzőbeállítások."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akomodasi tampilan diaktifkan.\nUntuk mengubah akomodasi tampilan, buka:\n Pengaturan > Aksesibilitas > Layar > Akomodasi Tampilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opzione “Regolazioni schermo” è abilitata.\nPer modificare le impostazioni, seleziona:\n Impostazioni > Accessibilità > Schermo > Regolazioni schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示調整が有効になっています。\n表示調整を変更するには、次のように選択してください: \n “設定”＞“アクセシビリティ”＞“ディスプレイ”＞“表示調整”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 조절이 활성화되어 있습니다.\n디스플레이 조절을 변경하려면\n 설정 > 손쉬운 사용 > 디스플레이 > 디스플레이 조절로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyesuaian paparan didayakan.\nUntuk menukar penyesuaian paparan, pergi ke:\n Seting > Kebolehcapaian > Paparan > Penyesuaian Paparan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermtilpassing er på.\nEndre skjermtilpassing ved å gå til:\n Innstillinger > Tilgjengelighet > Skjerm > Skjermtilpassing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste weergave is ingeschakeld.\nOm de aangepaste weergave te wijzigen, ga je naar:\n 'Instellingen' > 'Toegankelijkheid' > 'Weergave' > 'Aangepaste weergave'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udogodnienia ekranu są włączone.\nAby je zmienić, przejdź do ekranu:\n Ustawienia > Dostępność > Ekran > Udogodnienia ekranu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As adaptações de tela estão ativadas.\nPara alterar as adaptações de tela, acesse:\n Ajustes > Acessibilidade > Tela > Adaptações de Tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de ecrã estão ativadas.\nPode alterá‑las em:\n Definições > Acessibilidade > Visualização > Opções de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptările afișajului sunt active.\nPentru a schimba adaptările afișajului, accesați:\n Configurări > Accesibilitate > Afișaj > Adaptări afișaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включена адаптация дисплея.\nЧтобы изменить адаптацию дисплея, откройте\n «Настройки» > «Универсальный доступ» > «Дисплей» > «Адаптация дисплея»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zapnuté prispôsobenie displeja.\nPrispôsobenie displeja môžete zmeniť v:\n Nastavenia > Prístupnosť > Displej > Prispôsobenie displeja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagoditve zaslona so omogočene.\nČe želite spremeniti prilagoditve zaslona, pojdite na:\n Nastavitve> Dostopnost > Zaslon > Prilagoditve zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmhjälpmedel har aktiverats.\nOm du vill ändra skärmhjälpmedel öppnar du:\n Inställningar > Hjälpmedel > Bildskärm > Skärmhjälpmedel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การช่วยปรับจอแสดงผลเปิดใช้งานอยู่\nในการเปลี่ยนการช่วยปรับจอแสดงผล ให้ไปที่:\n การตั้งค่า > การช่วยการเข้าถึง > จอภาพ > การช่วยปรับจอแสดงผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kolaylıkları etkinleştirildi.\nEkran kolaylıklarını değiştirmek için şuraya gidin:\n Ayarlar > Erişilebilirlik > Ekran Kolaylıkları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптації дисплея ввімкнено.\nЗмінюйте адаптації дисплея в меню\n Параметри > Доступність > Дисплей > Адаптації дисплея."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thích nghi màn hình được bật.\nĐể thay đổi thích nghi màn hình, hãy đi tới:\n Cài đặt > Trợ năng > Màn hình > Thích nghi màn hình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示调节已启用。\n若要更改显示调节，请前往：\n “设置”>“辅助功能”>“显示”>“显示调节”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用顯示器輔助。\n如要更改顯示器輔助，請前往：\n 「設定」>「輔助使用」>「顯示」>「顯示器輔助」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用「顯示器調節」。\n若要更改「顯示器調節」，請前往：\n 「設定」>「輔助使用」>「顯示」>「顯示器調節」。"
          }
        }
      }
    },
    "AVAdjustForOverscanDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تستخدم ميزة شاشة البث السريع على Mac وكانت الصورة على Apple TV مقتصة، فشغل \"شاشة البث السريع داخل إطار الشاشة\". وأوقفها إذا ظهرت لك أشرطة سوداء حول الصورة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilitzes la funció de pantalla AirPlay al Mac i la imatge a l’Apple TV es veu escapçada, activa l’opció “Subdimensiona la pantalla AirPlay”. Si veus barres negres al voltant de la imatge, desactiva‑la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud na Macu používáte funkci „AirPlay monitor“ a obraz na Apple TV je oříznutý, zapněte na AirPlay monitoru volbu Underscan. V případě, že na okrajích obrazu vidíte černé pruhy, tuto volbu vypněte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du bruger AirPlay-skærmfunktionen på din Mac, og billedet på Apple TV er beskåret, skal du slå Underscan på AirPlay-skærm til. Hvis du ser sorte rammer omkring billedet, skal du slå det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die AirPlay-Anzeigefunktion auf deinem Mac verwendest und das Bild auf dem Apple TV abgeschnitten wird, aktiviere die Option „AirPlay-Monitor: Underscan“. Werden um das Bild schwarze Balken angezeigt, deaktiviere die Option."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν χρησιμοποιείτε τη δυνατότητα οθόνης AirPlay στο Mac και η εικόνα στο Apple TV εμφανίζεται περικομμένη, ενεργοποιήστε την «Υποσάρωση οθόνης AirPlay». Αν εμφανίζονται μαύρες γραμμές γύρω από την εικόνα, απενεργοποιήστε τη ρύθμιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you use the AirPlay display feature on your Mac and the image on your Apple TV is cropped, turn on AirPlay Display Underscan. If you see black bars around the image, turn it off."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you use the AirPlay display feature on your Mac and the image on your Apple TV is cropped, turn on AirPlay Display Underscan. If you see black bars around the image, turn it off."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you use the AirPlay display feature on your Mac and the image on your Apple TV is cropped, turn on AirPlay Display Underscan. If you see black bars around the image, turn it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si utilizas la función de pantalla AirPlay del Mac y la imagen del Apple TV aparece recortada, activa la opción “Underscan de pantalla AirPlay”. Si se ven franjas negras alrededor de la imagen, desactívala."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas la función de pantalla AirPlay en tu Mac y la imagen del Apple TV se ve cortada, activa la opción Underscan de la pantalla AirPlay. Si ves bordes negros alrededor de la imagen, desactívala."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas la función de pantalla AirPlay en tu Mac y la imagen del Apple TV se ve cortada, activa la opción Underscan de la pantalla AirPlay. Si ves bordes negros alrededor de la imagen, desactívala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytät Macilla AirPlay-näyttöominaisuutta ja kuva Apple TV:ssä on rajautunut, laita päälle ”Underscan-rajaus AirPlay-näytössä”. Jos kuvan ympärillä näkyy mustat palkit, laita kyseinen asetus pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez la fonctionnalité de moniteur AirPlay sur votre Mac et que l’image sur votre Apple TV est rognée, activez « Sous-balayage du moniteur AirPlay ». Si l’image possède une bordure noire, désactivez le sous-balayage."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous utilisez la fonction d’affichage AirPlay sur votre Mac et que l’image de votre Apple TV est recadrée, activez Sous-balayage de l’affichage AirPlay. Si vous voyez des barres noires autour de l’image, désactivez ce réglage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם החלטת להשתמש במאפיין הצג של AirPlay ב-Mac והתמונה שמופיעה ב-Apple TV חתוכה, יש להפעיל את ״שוליים שחורים בצג AirPlay״. אם מופיעים פסים שחורים מסביב לתמונה, יש לבטל את ההגדרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अपने Mac पर AirPlay डिस्प्ले फ़ीचर का उपयोग करते हैं और आपके Apple TV पर इमेज कटी हुई दिखाई देती है, तो AirPlay डिस्प्ले अंडरस्कैन चालू करें। अगर आपको इमेज के आस-पास काले रंग के बार दिखते हैं, तो इसे बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako koristite značajku AirPlay prikaza na Macu i slika na Apple TV‑u je odrezana, uključite opciju Komprimiranje AirPlay slike. Ako vidite crne trake oko slike, isključite ovu opciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amennyiben az AirPlay-megjelenítés funkciót használja a Macjén, és a kép le van vágva az Apple TV‑n, akkor kapcsolja be az AirPlay-megjelenítés alulpásztázása funkciót. Ha fekete sávokat lát a kép körül, akkor kapcsolja ki a funkciót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda menggunakan fitur layar AirPlay di Mac Anda dan gambar di Apple TV Anda terpotong, nyalakan Pemindaian Kurang Layar AirPlay. Jika Anda melihat bilah hitam di sekitar gambar, matikan Pemindaian Kurang Layar AirPlay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usi la funzionalità “Schermo AirPlay” sul Mac e l’immagine su Apple TV appare ritagliata, attiva “Underscan schermo AirPlay”. Se intorno all’immagine compaiono delle bande nere, disattivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでAirPlayディスプレイ機能を使うとApple TVで画像の端が切れる場合は、“AirPlayディスプレイアンダースキャン”をオンにしてください。画像の周りに黒い帯が表示される場合は、オフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 AirPlay 디스플레이 기능을 사용할 때 Apple TV에서 이미지가 잘리면 AirPlay 디스플레이 언더스캔을 켜고, 이미지 주변으로 검은 막대가 보이면 끄십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menggunakan ciri paparan AirPlay pada Mac anda dan imej pada Apple TV anda terpangkas, aktifkan Kurang Imbas Paparan AirPlay. Jika anda melihat bar hitam di sekeliling imej, nyahaktifkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du bruker AirPlay fra en Mac og bildet kuttes på Apple TV, kan du slå på Underskanning av AirPlay-skjerm. Hvis du ser svarte kanter rundt bildet, slår du av funksjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de AirPlay-weergavefunctie op je Mac gebruikt en het beeld niet op je Apple TV past, schakel je 'Onderscan AirPlay-beeldscherm' in. Schakel deze optie uit als je zwarte balken om het beeld ziet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli obraz na Apple TV przesyłany z Maca przez AirPlay jest przycięty, włącz opcję Underscan. Jeśli wokół obrazu widoczna jest czarna ramka, wyłącz tę opcję."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você usar o AirPlay no Mac e a imagem da Apple TV estiver cortada, ative a opção Reduzir Tela do AirPlay. Se estiver vendo barras pretas ao redor da imagem, desative a opção."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa a funcionalidade do monitor AirPlay no Mac e a imagem na Apple TV parecer cortada, ative a opção Underscan no monitor AirPlay. Se vir barras pretas à volta da imagem, desative‑a."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă utilizați funcționalitatea de afișaj AirPlay pe Mac‑ul dvs., iar imaginea de pe Apple TV este decupată, activați opțiunea Subscanare afișaj AirPlay. Dacă vedeți bare negre în jurul imaginii, dezactivați‑o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если при использовании функции дисплея AirPlay на Mac изображение на Apple TV отображается урезанным, включите параметр «Сжатая развертка дисплея AirPlay». Если вокруг изображения появляются черные поля, выключите этот параметр."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak používate funkciu AirPlay displej na svojom Macu a obraz vášho Apple TV je orezaný, zapnite funkciu Underscan pre AirPlay displej. Ak sú na okrajoch obrazu čierne pruhy, vypnite underscan."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če uporabljate funkcijo prikaza AirPlay v svojem Macu in je slika v Apple TV-ju obrezana, vklopite možnost prikaza AirPlay s prilagajanjem zaslonu. Če okrog slike opazite črne črte, izklopite to možnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du använder funktionen för AirPlay-skärm på Mac och bilden på Apple TV är beskuren aktiverar du Underskanning för AirPlay-skärm. Om det visas svarta ränder runt bilden avaktiverar du alternativet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณใช้คุณสมบัติจอแสดงผล AirPlay บน Mac ของคุณ และภาพบน Apple TV ถูกตัด ให้เปิดใช้อันเดอร์สแกนของจอแสดงผล AirPlay ถ้าคุณเห็นแถบสีดำล้อมรอบภาพ ให้ปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde AirPlay ekran özelliğini kullanıyorsanız ve Apple TV’nizdeki görüntü kırpılıyorsa, AirPlay Ekranda Dar Tarama’yı açın. Görüntünün etrafında siyah çubuklar görüyorsanız bu seçeneği kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви використовуєте функцію дисплея AirPlay на Mac і зображення на Apple TV виглядає обітнутим, увімкніть опцію «Звуження дисплея AirPlay». Якщо навколо зображення видно чорні смуги, вимкніть цю опцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn sử dụng tính năng màn hình AirPlay trên máy Mac và hình ảnh trên Apple TV của bạn bị cắt xén, hãy bật Quét thiếu màn hình AirPlay. Nếu bạn thấy các thanh màu đen quanh hình ảnh, hãy tắt tính năng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在Mac上使用隔空播放显示功能而Apple TV上的画面被剪裁掉，请打开“隔空播放显示器欠扫描”。若看到画面四周有黑边，请选择“关闭”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你使用Mac的AirPlay顯示功能而Apple TV上的影像被裁剪，請開啟「AirPlay顯示非全畫面模式」。如果你看見影像周圍有黑邊，請將其關閉。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Mac上的AirPlay顯示器功能時，若Apple TV上的影像被裁切，請開啟「AirPlay顯示器非全畫面模式」。若你在影像周圍看到黑色長條，請關閉。"
          }
        }
      }
    },
