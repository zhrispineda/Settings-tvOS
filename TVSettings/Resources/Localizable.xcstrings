    "AppsAutoOffloadDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل التطبيقات غير المستخدمة تلقائيًا، مع الاحتفاظ بجميع مستنداتها وبياناتها. وعند إعادة تثبيت التطبيق، ستتم إعادة بياناتك إذا كان التطبيق لا يزال متوفرًا على App Store."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automàticament les apps que no utilitzes, però se’n conserven els documents i les dades. En tornar a instal·lar l’app, si està disponible a l’App Store, s’hi tornaran a posar les dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepoužívané aplikace budou automaticky mazány, dokumenty a data však zůstanou zachovány. Pokud bude aplikace dostupná v App Storu, získáte při její nové instalaci svoje data zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern automatisk apps, du ikke bruger, men behold alle dokumenter og data. Hvis du installerer appen igen, bliver dataene tilbageført, hvis appen fortsat er tilgængelig i App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht benutzte Apps werden automatisch entfernt, alle Dokumente und Daten bleiben jedoch erhalten. Bei der erneuten Installation der App werden deine Daten wiederhergestellt, vorausgesetzt, die App ist noch im App Store erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα αφαιρούνται αυτόματα αχρησιμοποίητες εφαρμογές, αλλά θα διατηρούνται όλα τα έγγραφα και τα δεδομένα τους. Αν επανεγκαταστήσετε τις εφαρμογές, θα επαναφερθούν όλα τα δεδομένα σας, αν διατίθενται ακόμη οι εφαρμογές στο App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically remove unused apps, but keep all documents and data. Reinstalling the app will place back your data, if the app is still available in the App Store."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically remove unused apps, but keep all documents and data. Reinstalling the app will reinstate your data if the app is still available in the App Store."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically remove unused apps, but keep all documents and data. Reinstalling the app will reinstate your data if the app is still available in the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automáticamente las apps que no uses, pero conserva todos los documentos y datos. Si reinstalas una app, sus datos se restablecerán siempre que siga disponible en App Store."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará automáticamente las apps sin usar conservando todos los documentos y datos. Si la app se reinstala, recuperará todos tus datos, si aún está disponible en App Store."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará automáticamente las apps sin usar conservando todos los documentos y datos. Si la app se reinstala, recuperará todos tus datos, si aún está disponible en App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista käyttämättömät apit, mutta säilytä kaikki dokumentit ja kaikki datan. Jos appi on edelleen saatavana App Storessa ja se asennetaan uudelleen, kaikki data palautetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime automatiquement les apps inutilisées tout en conservant l’ensemble des documents et données associés. Si l’app est toujours disponible dans l’App Store, sa réinstallation rétablira toutes vos données."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez automatiquement toute app inutilisée tout en conservant tous les documents et toutes les données qui lui sont associés. Si l’app est toujours disponible dans l’App Store, sa réinstallation rétablira toutes vos données."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שאינם בשימוש יוסרו באופן אוטומטי, אך המסמכים והנתונים שלהם יישמרו. התקנה מחדש של היישום תחזיר את הנתונים שלך אם היישום עדיין יהיה זמין ב-App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस्तेमाल न किए जाने वाले ऐप्स को ऑटोमैटिकली हटाएँ लेकिन सभी दस्तावेज़ों और डेटा को बनाए रखें। यदि ऐप App Store पर अभी भी उपलब्ध है, तो उसे फिर से इंस्टॉल करने पर आपका डेटा वापस आ जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko uklanjanje nekorištenih aplikacija uz očuvanje svih dokumenata i podataka. Ponovnim instaliranjem aplikacije vratit će se vaši podaci ako je aplikacija i dalje dostupna u App Storeu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan eltávolíthatja a nem használt appokat, de megőrizheti a dokumentumait és adatait. Az app újratelepítésével visszaállíthatja az adatokat, ha az app még elérhető az App Store-ban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus app yang tidak digunakan secara otomatis, tapi simpan semua dokumen dan datanya. Menginstal ulang app akan mengembalikan data Anda jika app masih tersedia di App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che non usi verranno automaticamente rimosse, mentre tutti i relativi documenti e dati non verranno eliminati. Se l’app è ancora disponibile su App Store e la installi nuovamente, i tuoi dati verranno recuperati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用していないアプリは自動的に取り除かれますが、すべての書類とデータは保持されます。アプリがApp Storeにまだある場合は再インストールするとデータは元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 앱이 자동으로 제거되지만 문서 및 데이터는 모두 유지됩니다. 해당 앱이 App Store에서 계속 제공되는 경우 다시 설치하면 모든 데이터를 다시 가져옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarkan app yang tidak digunakan secara automatik, namun simpan semua dokumen dan datanya. Memasang semula app akan mengembalikan data anda jika app masih tersedia dalam App Store."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern ubrukte apper automatisk, mens alle dokumenter og data blir beholdt. Hvis du installerer appen på nytt, blir dataene dine tilbakeført hvis appen fortsatt er tilgjengelig i App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder automatisch apps die niet gebruikt worden zonder dat de bijbehorende documenten en gegevens verloren gaan. Als je de app weer installeert, worden je gegevens teruggezet als de app nog beschikbaar is in de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieużywane aplikacje będą usuwane automatycznie, ale ich dokumenty i dane pozostaną bez zmian. Ponowne zainstalowanie aplikacji przywróci dane, jeśli aplikacja jest nadal dostępna w App Store."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova automaticamente os apps não usados, mantendo seus documentos e dados. Se o app for reinstalado e ainda estiver disponível na App Store, os dados serão restaurados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover automaticamente as aplicações não usadas, mas manter os respetivos documentos e dados. A reinstalação da aplicação permite recuperar os dados, desde que a aplicação ainda esteja disponível na App Store."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile neutilizate vor fi eliminate automat, dar toate documentele și datele vor fi păstrate. Dacă aplicația mai este disponibilă în App Store, datele dvs. vor fi restaurate la reinstalarea acesteia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически удалять неиспользуемые приложения, но сохранять все документы и данные. Если переустановить приложение, все его данные будут восстановлены — при условии, что на тот момент приложение будет доступно в App Store."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky odstráni nepoužívané apky, no zároveň zachová všetky ich dokumenty a dáta. Ak apku neskôr stiahnete a znovu nainštalujete z App Storu, jej uložené dáta budú opäť k dispozícii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno odstranite neuporabljene aplikacije, vendar ohranite vse dokumente in podatke. Ob ponovnem nameščanju aplikacije, ki je še vedno na voljo v trgovini App Store, bodo podatki povrnjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta automatiskt bort oanvända appar, men behåll alla dokument och data. Om du installerar en app på nytt återställs alla dina data om appen fortfarande är tillgänglig på App Store."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาแอปที่ไม่ได้ใช้ออกโดยอัตโนมัติแต่เอกสารและข้อมูลทั้งหมดจะถูกเก็บไว้ การติดตั้งแอปอีกครั้งจะดึงข้อมูลของคุณกลับมาใช้หากแอปยังมีอยู่ใน App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılmayan uygulamaları otomatik olarak siler ama tüm belgeleri ve verileri saklar. Uygulama hâlâ App Store’da ise onu yeniden yüklemek tüm verilerinizi yerine koyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично вилучати програми, якими не користуєтеся, але лишати всі їхні документи й дані. Переінсталяція програми поверне всі ваші дані, якщо ця програма ще доступна в App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động xóa các ứng dụng không sử dụng, nhưng vẫn giữ lại tất cả tài liệu và dữ liệu. Việc cài đặt lại ứng dụng sẽ khôi phục dữ liệu của bạn, nếu ứng dụng vẫn có sẵn trong App Store."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动移除未使用的App，但保留所有文稿和数据。若App Store仍提供该App，重新安装将还原你的数据。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動移除未使用的App，但保留其所有文件及資料。如App Store仍提供有關App，重新安裝App可還原你的資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動移除未使用的App，但保留所有文件和資料。重新安裝App可還原你的資料（若App Store仍提供此App）。"
          }
        }
      }
    },
