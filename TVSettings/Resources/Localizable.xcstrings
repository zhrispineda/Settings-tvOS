    "AVAudioSyncDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الصوت من التلفزيون مع سماعات البث السريع الأخرى في منزلك. إضافةً إلى ذلك، ضمان توازي تشغيل الفيديو مع إخراج الصوت من البث السريع أو Bluetooth."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronitza l’àudio del televisor amb altres altaveus AirPlay que tinguis a casa. A més, pots alinear la reproducció de vídeo amb l’AirPlay o una sortida d’àudio Bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizujte zvuk televizoru s ostatními AirPlay reproduktory v domácnosti. Přitom srovnejte přehrávání obrazu s přehráváním zvuku přes AirPlay nebo Bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniser lyd fra dit fjernsyn med andre AirPlay-højttalere i hjemmet. Du kan desuden tilpasse videoafspilning med lyd ud via AirPlay eller Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere Audio von deinem TV-Gerät mit anderen AirPlay-Lautsprechern in deinem Zuhause. Passe außerdem die Videowiedergabe an die AirPlay- oder Bluetooth-Audioausgabe an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγχρονίστε τον ήχο από την τηλεόρασή σας με άλλα ηχεία AirPlay στην οικία σας. Επιπλέον, εναρμονίστε την αναπαραγωγή βίντεο με την έξοδο ήχου AirPlay ή Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronize audio from your TV with other AirPlay speakers in your home. Plus, align video playback with AirPlay or Bluetooth audio output."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise audio from your TV with other AirPlay speakers in your home. Plus, align video playback with AirPlay or Bluetooth audio output."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise audio from your TV with other AirPlay speakers in your home. Plus, align video playback with AirPlay or Bluetooth audio output."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el audio de tu televisor con otros altavoces de AirPlay que tengas en casa. Ajusta también la reproducción de vídeo con la salida de audio de AirPlay o Bluetooth."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el audio de tu TV con otras bocinas AirPlay de tu casa y ajusta la reproducción de video a la salida de audio AirPlay o Bluetooth."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el audio de tu TV con otros altavoces AirPlay de tu casa. y ajusta la reproducción de video a la salida de audio AirPlay o Bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoi ääni televisiosta muihin kodin AirPlay-kaiuttimiin. Lisäksi voit kohdistaa videotoiston AirPlay- tai Bluetooth-äänilähtöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez l’audio de votre téléviseur avec les autres haut-parleurs AirPlay de votre domicile. Alignez également la lecture vidéo avec la sortie audio AirPlay ou Bluetooth."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez le son de votre télévision avec d’autres haut-parleurs AirPlay de votre domicile et la lecture vidéo avec la sortie audio AirPlay ou Bluetooth."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לבצע סנכרון שמע בין הטלוויזיה לרמקולים אחרים עם יכולות AirPlay שנמצאים אצלך בבית. ניתן גם לתאם בין אותות הווידאו והשמע דרך AirPlay או Bluetooth."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घर के अन्य AirPlay स्पीकर के साथ अपने TV का ऑडियो सिंक्रोनाइज़ करें। साथ ही, वीडियो प्लेबैक को AirPlay या Bluetooth ऑडियो आउटपुट के साथ अलाइन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizirajte audio signal TV-a s ostalim AirPlay zvučnicima u domu. Osim toga, možete uskladiti reprodukciju videozapisa s AirPlay ili Bluetooth audio izlazom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szinkronizálhatja a televízió hangját az otthonában lévő egyéb AirPlay-hangszórókkal. Ezenkívül a képi tartalom lejátszását az AirPlay- vagy Bluetooth-hangkimenethez igazíthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaraskan audio dari TV dengan speaker AirPlay lainnya di rumah Anda. Selain itu, selaraskan pemutaran video dengan AirPlay atau output audio Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza l’audio dalla TV con altri altoparlanti AirPlay in casa. Inoltre, allinea la riproduzione video con l’output audio AirPlay o Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TVのオーディオを、お使いのほかのAirPlayスピーカーと同期できます。さらに、ビデオ再生をAirPlayまたはBluetoothオーディオ出力に合わせることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV의 오디오를 홈에 있는 다른 AirPlay 스피커와 동기화합니다. 또한, 비디오 재생을 AirPlay 또는 Bluetooth 오디오 출력에 맞춰 조정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaraskan audio daripada TV anda dengan speaker AirPlay lain dalam rumah anda. Selain itu, jajarkan main balik video dengan output audio AirPlay atau Bluetooth."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniser lyden fra TV-en din til andre AirPlay-høyttalere i hjemmet. Du kan også samkjøre videoavspilling av lydinnhold over AirPlay eller Bluetooth."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer audio van je tv met andere AirPlay-luidsprekers in je woning. Je kunt ook de videoweergave aanpassen aan de audio-uitvoer via AirPlay of Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj dźwięk z telewizora z innymi głośnikami AirPlay w domu. Ponadto, wyrównaj odtwarzanie wideo z wyjściem audio AirPlay lub Bluetooth."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize o áudio da TV com outros alto‑falantes AirPlay da casa. Além disso, alinhe a reprodução de vídeo com a saída de áudio AirPlay ou Bluetooth."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize áudio da televisão com outras colunas AirPlay da sua casa. Alinhe também a reprodução de vídeo com a saída de áudio por AirPlay ou Bluetooth."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizați sunetul de pe televizor cu alte difuzoare AirPlay din locuință. În plus, aliniați redarea video cu ieșirea audio AirPlay sau Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте аудио с телевизора с другими колонками AirPlay в доме, а воспроизведение видео — с аудиовыходом (устройством AirPlay или Bluetooth)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zosynchronizujte zvuk televízora s ďalšími AirPlay reproduktormi v domácnosti. Zosúlaďte prehrávanie zvuku cez AirPlay alebo Bluetooth."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizirajte zvok televizije z drugimi zvočniki AirPlay v svojem domu. Lahko tudi poravnate predvajanje videoposnetka z izhodom zvoka AirPlay ali Bluetooth."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisera ljud från din TV med andra AirPlay-högtalare i hemmet. Du kan dessutom passa in videouppspelning med ljud via AirPlay eller Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมข้อมูลเสียงจากทีวีกับลำโพง AirPlay อื่นๆ ในบ้านของคุณ รวมทั้งปรับการเล่นวิดีโอด้วย AirPlay หรืออุปกรณ์เสียงผ่านบลูทูธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evinizdeki diğer AirPlay hoparlörleriyle TV’nizdeki sesleri eşzamanlayın. Ayrıca video oynatımlarını AirPlay veya Bluetooth ses çıkışlarıyla uyumlu hale getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізуйте звук із вашого телевізора з іншими AirPlay-динаміками у вашому домі. На додачу, вирівнюйте відтворення відео з виведенням звуку через AirPlay або Bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa âm thanh từ TV với các loa AirPlay khác trong nhà của bạn. Ngoài ra, căn chỉnh phát lại video với đầu ra âm thanh AirPlay hoặc Bluetooth."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将你电视的音频与你家中的其他隔空播放扬声器同步。另外，将视频播放与隔空播放或蓝牙音频输出对齐。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將電視的音訊與家中其他AirPlay喇叭同步。此外，將影片播放與AirPlay或藍牙音訊輸出對齊。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從電視同步音訊到家中的其他AirPlay揚聲器上。此外，讓影片的播放與AirPlay或藍牙音訊輸出同步。"
          }
        }
      }
    },
