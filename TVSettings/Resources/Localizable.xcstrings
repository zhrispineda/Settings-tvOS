    "AXVoiceOverSpeakDetectedTextDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تحديد ما إذا كان سيتم نطق النص المحدد تلقائيًا في عنصر التركيز أم لا.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Determina si cal llegir el text que s’ha detectat automàticament a l’ítem on hi ha el focus.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Nastavuje předčítání automaticky detekovaného textu v zaměřené položce.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Bestemmer, om automatisk registreret tekst i det fokuserede emne bliver læst op.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Bestimmt, ob automatisch erkannter Text im Fokusobjekt gesprochen wird.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Καθορίζει αν θα εκφωνείται το αυτόματα ανιχνευμένο κείμενο στο εστιασμένο στοιχείο.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Determines whether automatically detected text in the focused item is spoken.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Determines whether automatically detected text in the focussed item is spoken.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Determines whether automatically detected text in the focused item is spoken.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Determines whether automatically detected text in the focused item is spoken.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Determines whether automatically detected text in the focused item is spoken.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Determina si se lee el texto detectado automáticamente en el ítem resaltado.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Determina si se dice en voz alta el texto detectado automáticamente del elemento enfocado.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Determina si se dice en voz alta el texto detectado automáticamente del elemento enfocado.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Määrittää, puhutaanko kohdistetussa kohteessa automaattisesti havaittu teksti.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Détermine si le texte détecté automatiquement dans l’élément ciblé est énoncé.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Détermine si le texte détecté automatiquement dans l’élément ciblé est énoncé.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו קובעת האם המערכת תקריא בקול מלל שזוהה באופן אוטומטי בפריט שבמיקוד.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "निर्धारित करता है कि फ़ोकस किए गए आइटम में ऑटोमैटिकली पता किया गया टेक्स्ट बोला जाता है या नहीं।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Određuje hoće li se pročitati tekst koji je automatski detektiran u fokusiranoj stavki.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Meghatározza, hogy a fókuszban lévő elemben automatikusan észlelt szöveg fel legyen-e olvasva.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Menentukan apakah teks yang terdeteksi secara otomatis di item yang difokuskan akan diucapkan.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Determina se il testo rilevato automaticamente nell’elemento evidenziato viene letto ad alta voce.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "フォーカスされた項目で自動的に検出されたテキストを読み上げるかどうかを決めます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "이 옵션을 켜면 초점이 맞춰진 항목에서 자동으로 감지된 텍스트를 말합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Menentukan sama ada teks yang dikesan secara automatik dalam item yang difokus dituturkan.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Bepaalt of automatisch gedetecteerde tekst in het onderdeel in focus wordt uitgesproken.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Avgjør om tekst som registreres automatisk i et objekt i fokus, skal leses opp.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Określa, czy tekst automatycznie wykryty w wybranej rzeczy jest mówiony.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Determina se o texto detectado automaticamente no item em foco deve ser falado.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Determina se o texto detetado automaticamente no elemento focado é ou não enunciado.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Determină dacă textul detectat automat în articolul focalizat este enunțat.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Определяет, произносить ли текст, обнаруженный автоматически в объекте под фокусом.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Nastavenie predčítania automaticky detegovaného textu v zameranej položke.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Določite, ali se izgovori samodejno zaznano besedilo v elementu v fokusu.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Anger om automatiskt identifierad text i det fokuserade objektet ska läsas upp.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "กำหนดว่าต้องการออกเสียงอ่านข้อความที่ตรวจพบในรายการที่โฟกัสโดยอัตโนมัติหรือไม่",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Odaklanılan öğedeki algılanan metnin otomatik olarak seslendirilip seslendirilmeyeceğini belirler.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Визначає, чи озвучується текст, автоматично виявлений на обʼєкті у фокусі.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Xác định xem văn bản được phát hiện tự động trong mục có tiêu điểm có được đọc không.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "确定是否朗读在聚焦项中自动检测到的文本。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "決定是否朗讀在焦點內項目自動檢測到的文字。",
