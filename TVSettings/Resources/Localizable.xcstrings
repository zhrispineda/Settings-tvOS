    "NetworkEthernetInactiveItemDescription_WIFI": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Apple TV غير متصل بالإنترنت. لاستخدام Apple TV، يجب توصيله بالإنترنت باستخدام Wi-Fi أو الإيثرنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV no té connexió a internet. Per utilitzar l’Apple TV, connecta’t a internet per Wi‑Fi o Ethernet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV není připojena k internetu. Chcete‑li ji použít, připojte ji pomocí Wi‑Fi nebo Ethernetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er ikke forbundet med internettet. Hvis du vil bruge Apple TV, skal du oprette forbindelse til internettet vha. Wi‑Fi eller Ethernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ist nicht mit dem Internet verbunden. Stelle die Internetverbindung über WLAN oder Ethernet her, um Apple TV zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV δεν είναι συνδεδεμένο στο Διαδίκτυο. Για χρήση του Apple TV, συνδεθείτε στο Διαδίκτυο μέσω Wi-Fi ή Ethernet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect to the internet using Wi-Fi or Ethernet."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect to the internet using Wi-Fi or Ethernet."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. To use Apple TV, connect to the internet using Wi-Fi or Ethernet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no está conectado a internet. Para poder utilizar el Apple TV, conéctate a internet a través de una red Wi‑Fi o Ethernet."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no está conectado a Internet. Para usar el Apple TV, conéctalo a una red Wi‑Fi o a Ethernet."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no está conectado a Internet. Para usar el Apple TV, conéctalo a una red Wi‑Fi o a Ethernet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ei ole yhteydessä internetiin. Käytä Apple TV:tä yhdistämällä internetiin Wi‑Fillä tai ethernetillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Pour pouvoir l’utiliser, connectez-vous à Internet via Wi-Fi ou Ethernet."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Pour utiliser l’Apple TV, connectez-la à Internet au moyen d’une connexion Wi‑Fi ou Ethernet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV שלך אינו מחובר לאינטרנט. כדי להשתמש ב-Apple TV, יש להתחבר לאינטרנט באמצעות רשת אלחוטית או חיבור Ethernet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV इंटरनेट से कनेक्टेड नहीं है। Apple TV का उपयोग करने के लिए वाई-फ़ाई या इथरनेट का उपयोग कर इंटरनेट से कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV nije spojen na internet. Za uporabu Apple TV‑a spojite se na internet koristeći Wi-Fi ili Ethernet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV nem csatlakozik az internethez. Az Apple TV használatához csatlakozzon az internethez Wi‑Fi vagy Ethernet használatával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda tidak terhubung ke internet. Untuk menggunakan Apple TV, hubungkan ke internet menggunakan Wi-Fi atau Ethernet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV non è connessa a internet. Per utilizzare Apple TV, connettiti a internet utilizzando una rete Wi‑Fi o il cavo Ethernet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVはインターネットに接続していません。Apple TVを使用するには、Wi‑FiまたはEthernetを使用してインターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 인터넷에 연결되어 있지 않습니다. Apple TV를 사용하려면 Wi‑Fi 또는 이더넷을 통해 인터넷에 연결하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda tidak disambungkan ke Internet. Untuk menggunakan Apple TV, sambung ke internet menggunakan Wi‑Fi atau Ethernet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er ikke koblet til internett. Du må koble til internett med Wi‑Fi eller Ethernet for å bruke Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV is niet verbonden met het internet. Maak via wifi of ethernet verbinding met het internet om je Apple TV te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nie ma połączenia z Internetem. Aby używać Apple TV, połącz się z Internetem przez sieć Wi‑Fi lub Ethernet."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Apple TV não está conectada à internet. Para usar a Apple TV, conecte‑se à internet pela rede Wi‑Fi ou Ethernet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está ligada à internet. Para usar a Apple TV, estabeleça ligação à internet através de Wi-Fi ou Ethernet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-ul dvs. nu este conectat la internet. Pentru a utiliza Apple TV‑ul, conectați‑l la internet utilizând o rețea Wi‑Fi sau Ethernet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не подключен к интернету. Чтобы использовать Apple TV, подключите его к интернету через Wi‑Fi или Ethernet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše Apple TV nie je pripojené na internet. Ak chcete používať Apple TV, pripojte sa na internet prostredníctvom Wi-Fi alebo ethernetu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV nima vzpostavljene povezave z internetom. Če želite uporabljati Apple TV, vzpostavite povezavo z internetom prek omrežja Wi-Fi ali Ethernet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV är inte ansluten till internet. Om du vill använda Apple TV ansluter du den till internet via Wi-Fi eller Ethernet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณไม่ได้เชื่อมต่อกับอินเทอร์เน็ต ในการใช้ Apple TV ให้เชื่อมต่อกับอินเทอร์เน็ตโดยใช้ Wi‑Fi หรืออีเธอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz internete bağlı değil. Apple TV’yi kullanmak için Wi‑Fi’yi veya Ethernet’i kullanarak internete bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV не має інтернет-зʼєднання. Щоб використовувати Apple TV, установіть інтернет-зʼєднання через Wi‑Fi або Ethernet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn không được kết nối vào internet. Để sử dụng Apple TV, hãy kết nối vào internet bằng Wi-Fi hoặc Ethernet."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV尚未接入互联网。若要使用Apple TV，请使用Wi-Fi或以太网接入互联网。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV未連接互聯網。如要使用Apple TV，請使用Wi-Fi或乙太網絡連接互聯網。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV尚未連接網際網路。若要使用Apple TV，請使用Wi-Fi或乙太網路來連接網際網路。"
          }
        }
      }
    },
