    "SendDataDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد شركة Apple على تحسين منتجاتها وخدماتها عن طريق الإرسال التلقائي لبيانات التحليلات. قد تحتوي بيانات التحليلات على معلومات موقعك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia dades d’anàlisi a Apple automàticament per ajudar a millorar els productes i serveis. Les dades d’anàlisi poden incloure informació sobre la ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozte společnosti Apple s vylepšováním jejích produktů a služeb tím, že jí budete automaticky posílat analytická data. Analytická data můžou obsahovat vaše polohové údaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp Apple med at forbedre sine produkter og tjenester ved at sende analysedata automatisk. Analysedata kan inkludere dine lokalitetsoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Apple, Produkte und Dienste zu verbessern, indem du automatisch Analysedaten sendest. Analysedaten enthalten möglicherweise auch deine Standortdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοηθήστε την Apple να βελτιώσει τα προϊόντα και τις υπηρεσίες της μέσω αυτόματης αποστολής δεδομένων ανάλυσης. Τα δεδομένα ανάλυσης μπορεί να περιλαμβάνουν τα στοιχεία τοποθεσίας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Apple improve its products and services by automatically sending analytics data. Analytics data may include your location information."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Apple improve its products and services by automatically sending analytics data. Analytics data may include your location information."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Apple improve its products and services by automatically sending analytics data. Analytics data may include your location information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Apple a mejorar sus productos y servicios enviando automáticamente información de análisis. La información de análisis puede incluir información sobre tu ubicación."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Apple a mejorar sus productos y servicios enviando automáticamente información de análisis. Esta puede incluir datos sobre tu ubicación."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Apple a mejorar sus productos y servicios enviando automáticamente información de análisis. Esta puede incluir datos sobre tu ubicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auta Applea parantamaan tuotteitaan ja palvelujaan lähettämällä automaattisesti analyysitiedot. Analyysitiedot saattavat sisältää sijaintitietosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez Apple à améliorer ses produits et services en envoyant automatiquement les données d’analyse. Les données d’analyse peuvent inclure vos données de localisation."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez Apple à améliorer ses produits et services en envoyant automatiquement les données d’analyse. Celles-ci peuvent inclure vos données de localisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לעזור ל-Apple לשפר את המוצרים והשירותים שהיא מספקת על-ידי שליחה אוטומטית של פירוט ניתוח הנתונים. ניתוח הנתונים עשוי לכלול את פרטי המיקום שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐनालिटिक्स डेटा ऑटोमैटिकली भेजकर अपने उत्पादों और सेवाओं को बेहतर बनाने में Apple की सहायता करें। ऐनालिटिक्स डेटा में आपके स्थान की जानकारी शामिल हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomozite tvrtki Apple u poboljšanju proizvoda i usluga automatskim slanjem podataka analize. Podaci analize mogu sadržavati informacije o vašoj lokaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segítsen az Apple-nek termékei és szolgáltatásai továbbfejlesztésében az elemzési adatok automatikus elküldésével. Az elemzési adatok tartalmazhatják az Ön helyzetinformációit is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu Apple meningkatkan produk dan layanannya dengan mengirim data analisis secara otomatis. Data analisis dapat mencakup informasi lokasi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Apple a migliorare i propri prodotti e servizi inviando automaticamente i dati di analisi. Tali dati possono includere le informazioni relative alla posizione del tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析データを自動的に送信することで弊社の製品とサービスの品質向上にご協力いただけます。解析データにはあなたの位置情報が含まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 분석 데이터를 보내서 Apple의 제품 및 서비스 향상에 도움을 줄 수 있습니다. 분석 데이터에 사용자의 위치 정보가 포함될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu Apple meningkatkan produk dan perkhidmatannya dengan menghantar data analitis secara automatik. Data analitis mungkin termasuk maklumat lokasi anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp Apple med å forbedre produktene og tjenestene ved å automatisk sende analysedata. Analysedata kan inneholde din stedsinformasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Apple bij het verbeteren van zijn producten en diensten door automatisch analysegegevens naar Apple te sturen. Analysegegevens kunnen locatiegegevens bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż Apple ulepszać produkty i usługi, automatycznie wysyłając dane analiz. Mogą one obejmować informacje o Twoim położeniu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie dados de análise automaticamente para ajudar a Apple a melhorar seus produtos e serviços. Os dados de análise podem incluir as informações da sua localização."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a Apple a melhorar os produtos e serviços, enviando automaticamente dados de análise. É possível que os dados de análise incluam informação de localização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutați la îmbunătățirea produselor și serviciilor Apple trimițând automat date de analiză. Datele de analiză pot include informații despre localizarea dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите Apple совершенствовать продукты и сервисы, автоматически отправляя аналитические данные. Аналитические данные могут содержать информацию о Вашей геопозиции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomôžte spoločnosti Apple vylepšovať produkty a služby automatickým odosielaním analytických dát. Analytické dáta môžu zahŕňať informácie o vašej polohe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomagajte družbi Apple izboljšati izdelke in storitve s samodejnim pošiljanjem analitičnih podatkov. Analitični podatki lahko vsebujejo podatke o vaši lokaciji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp Apple att förbättra sina produkter och tjänster genom att automatiskt skicka analysdata. Analysdata kan innehålla platsinformation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วย Apple ปรับปรุงผลิตภัณฑ์และการบริการให้ดีขึ้นด้วยการส่งข้อมูลวิเคราะห์โดยอัตโนมัติ ข้อมูลวิเคราะห์อาจประกอบด้วยข้อมูลตำแหน่งที่ตั้งของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz verilerini otomatik olarak göndererek Apple’ın ürünlerini ve servislerini geliştirmesine yardım edin. Analiz verileri konum bilgilerinizi içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагайте Apple покращувати її продукти й сервіси, увімкнувши автоматичне надсилання даних аналітики. Дані аналітики можуть містити інформацію про вашу геопозицію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp Apple cải tiến các dịch vụ và sản phẩm bằng cách tự động gửi dữ liệu phân tích. Dữ liệu phân tích có thể bao gồm thông tin vị trí của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过自动发送分析数据帮助Apple改进产品和服务。分析数据可能包括你的位置信息。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動傳送分析資料協助Apple改善產品和服務。分析資料可能包括你的位置資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動傳送分析資料來協助Apple改進產品和服務。分析資料可能包含你的位置資訊。"
          }
        }
      }
    },
