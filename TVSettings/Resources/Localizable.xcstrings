            "value": "Carga el perfil VPN. Requiere credenciales válidas de AppleConnect."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el perfil de VPN, lo cual requiere credenciales de AppleConnect."
          }
        },
