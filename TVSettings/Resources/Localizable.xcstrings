    "BackgroundAppRefreshDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للتطبيقات التي ليست قيد الاستخدام بالتحقق من التحديثات والمحتوى الجديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que les apps que no estan en ús comprovin si hi ha actualitzacions i continguts nous."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní nepoužívaným aplikacím vyhledávat aktualizace a nový obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der ikke er i brug, må søge efter nye opdateringer og nyt indhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Apps, auch wenn sie gerade nicht benutzt werden, nach Updates und neuen Inhalten zu suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να επιτρέπεται σε εφαρμογές που δεν είναι σε χρήση να ελέγχουν για ενημερώσεις και νέο περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps that aren’t in use to check for updates and new content."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps that aren’t in use to check for updates and new content."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow apps that aren’t in use to check for updates and new content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps que no se estén utilizando puedan buscar actualizaciones y contenido nuevo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps que no estén en uso verifiquen si hay actualizaciones y contenido nuevo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps que no estén en uso verifiquen si hay actualizaciones y contenido nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli appien, joita ei käytetä, etsiä päivityksiä ja uutta sisältöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les apps qui ne sont pas en cours d’utilisation à rechercher les mises à jour et de nouveaux contenus."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les apps qui ne sont pas en cours d’utilisation à rechercher des mises à jour et de nouveaux contenus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר ליישומים שאינם בשימוש לחפש עדכונים ותכנים חדשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग नहीं किए जा रहे ऐप्स को अपडेट और नए कॉन्टेंट के लिए जाँच हेतु अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite trenutačno nekorištenim aplikacijama traženje ažuriranja i novog sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítések és új tartalmak keresésének engedélyezése a használatban nem lévő appok számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan app yang sedang tidak digunakan untuk memeriksa pembaruan dan konten baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alle app non in uso di verificare la presenza di aggiornamenti e di nuovi contenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中ではないアプリがアップデートおよび新規コンテンツをチェックできるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중이 아닌 앱이 업데이트 및 새로운 콘텐츠를 확인할 수 있도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan app yang tidak digunakan untuk menyemak kemas kini dan kandungan baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at apper som ikke er i bruk, kan se etter oppdateringer og nytt innhold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat apps die niet gebruikt worden naar updates en nieuw materiaal zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwalaj aplikacjom, których aktualnie nie używasz, sprawdzać dostępność uaktualnień i nowych treści."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que apps em segundo plano verifiquem atualizações e novo conteúdo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que as aplicações que não estão a ser usadas procurem atualizações e novo conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți‑le aplicațiilor care nu sunt în uz să caute actualizări și conținut nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить приложениям, не используемым в настоящий момент, проверять наличие обновлений и нового контента."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní nepoužívaným apkám hľadať aktualizácie a nový obsah."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacijam, ki niso v uporabi, dovolite, da preverjajo, ali so na voljo posodobitve in nova vsebina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att appar som inte används söker efter uppdateringar och nytt innehåll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตแอปที่ไม่ได้ใช้งานอยู่ให้อัปเดตแอปและเนื้อหาใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımda olmayan uygulamalar için güncellemelerin ve yeni içeriğin denetlenmesine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити неактивним програмам перевіряти наявність оновлень і нового контенту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép các ứng dụng đang không sử dụng kiểm tra bản cập nhật và nội dung mới."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许未在使用的App检查更新和新内容。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許並非正在使用的App檢查更新項目及新增內容。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許未使用的App檢查更新項目和新增內容。"
          }
        }
      }
    },
