        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett starkare lösenord med minst 6 tecken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเลือกรหัสผ่านที่ยากกว่านี้ที่มีอักขระอย่างน้อย 6 ตัว"
          }
