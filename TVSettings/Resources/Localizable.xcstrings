        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les apps à accéder à Siri. Elles apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שקיבלו ממך הרשאת גישה ל-Siri יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स को Siri ऐक्सेस करने की अनुमति दें और वे यहाँ दिखाए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite aplikacijama da pristupe Siri i one će se prikazati ovdje."
