    "AVEnableDolbyVisionDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على أفضل صورة مع ألوان أفضل وأكثر سطوعًا. سيتأكد Apple TV من توافق كبل HDMI لديك قبل تشغيل Dolby Vision."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona imatges de qualitat òptima amb colors més vius i lluminosos. Abans d’activar el format Dolby Vision, l’Apple TV comprovarà que el cable HDMI sigui compatible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získáte prvotřídní obraz s lepšími a jasnějšími barvami. Před zapnutím režimu Dolby Vision Apple TV zkontroluje, zda je s ním kompatibilní váš HDMI kabel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få det bedste billede med bedre og stærkere farver. Apple TV kontrollerer, at dit HDMI-kabel er kompatibelt, før det slår Dolby Vision til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlebe die beste Bildqualität mit besseren, helleren Farben. Apple TV stellt vor dem Aktivieren von Dolby Vision sicher, dass dein HDMI-Kabel kompatibel ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απολαύστε τη βέλτιστη εικόνα με καλύτερα, φωτεινότερα χρώματα. Το Apple TV θα διασφαλίσει ότι το καλώδιο HDMI είναι συμβατό, προτού ενεργοποιήσει το Dolby Vision."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colors. Apple TV will make sure your HDMI cable is compatible before it turns on Dolby Vision."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colours. Apple TV will make sure your HDMI cable is compatible before it turns on Dolby Vision."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colours. Apple TV will make sure your HDMI cable is compatible before it turns on Dolby Vision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de la mejor calidad de imagen con colores más vivos y realistas. Antes de activar Dolby Vision, el Apple TV se asegurará de que el cable HDMI es compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue la mejor calidad de imagen con colores más brillantes. El Apple TV verificará que tu cable HDMI sea compatible antes de activar Dolby Vision."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue la mejor calidad de imagen con colores más brillantes. El Apple TV verificará que tu cable HDMI sea compatible antes de activar Dolby Vision."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa paras kuva ja paremmat, kirkkaammat värit. Apple TV tarkastaa HDMI -kaapelin yhteensopivuuden ennen kuin Dolby Vision laitetaan päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d’une qualité d’image optimale avec des couleurs plus vives. L’Apple TV va vérifier que votre câble HDMI est compatible avant d’activer le Dolby Vision."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez la meilleure image possible avec les couleurs les plus claires. L’Apple TV s’assurera que votre câble HDMI est compatible avant d’activer Dolby Vision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לקבל את איכות התמונה הטובה ביותר עם צבעים בהירים ואיכותיים יותר. ה-Apple TV יוודא שכבל ה-HDMI שלך תואם ל-Dolby Vision לפני ההפעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर और चमकीले रंगो के साथ सबसे अच्छी तस्वीर पाएँ। Dolby Vision चालू करने के पहले Apple TV सुनिश्चित करेगा कि आपका HDMI केबल संगत है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledajte najbolju moguću sliku s poboljšanim i jarkim bojama. Apple TV provjerit će je li vaš HDMI kabel kompatibilan prije uključenja Dolby Visiona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élvezze a jobb, élénkebb színeknek köszönhető legjobb képminőséget. A Dolby Vision bekapcsolása előtt az Apple TV meggyőződik arról, hogy a HDMI-kábel kompatibilis-e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan gambar terbaik dengan warna yang lebih cerah dan lebih baik. Apple TV akan memastikan kabel HDMI Anda kompatibel sebelum menyalakan Dolby Vision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni la migliore qualità delle immagini e i colori più vividi. Prima di attivare la modalità Dolby Vision, Apple TV verificherà che il tuo cavo HDMI sia compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より鮮やかな色で最高の画像を表示しましょう。Apple TVは、HDMIケーブルに互換性があることを確認してから、ドルビービジョンをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 밝고 선명한 색상이 담긴 최고 화질의 영상으로 봅니다. Apple TV가 Dolby Vision을 켜기 전에 사용자의 HDMI 케이블이 호환 가능한지 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan gambar yang terbaik dengan warna yang lebih baik dan lebih cerah. Apple TV akan memastikan kabel HDMI anda serasi sebelum mengaktifkan Dolby Vision."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få det beste bildet med bedre og sterkere farger. Apple TV kontrollerer at HDMI-kabelen din er kompatibel, før Dolby Vision slås på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg het beste beeld met betere en scherpere kleuren. Apple TV controleert of je HDMI-kabel compatibel is voordat Dolby Vision wordt ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb Dolby Vision to optymalny obraz o lepszych, jaśniejszych kolorach. Przed włączeniem go Apple TV sprawdzi, czy Twój kabel HDMI jest z nim zgodny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha a melhor imagem, com cores melhores e mais brilhantes. Antes de ativar o Dolby Vision, a Apple TV conferirá se o cabo HDMI é compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha a melhor imagem, com cores fortes e mais brilhantes. Antes de mudar para Dolby Vision, a Apple TV certificar‑se‑á de que o cabo HDMI é compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obțineți cea mai bună imagine, prin culori mai performante și mai strălucitoare. Înainte de a activa Dolby Vision, Apple TV-ul va testa compatibilitatea cablului dvs. HDMI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наилучшее изображение с более яркими цветами. Apple TV проверит кабель HDMI на совместимость перед переключением на формат Dolby Vision."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Získajte špičkový obraz s lepšími a žiarivejšími farbami. Apple TV pred zapnutím formátu Dolby Vision overí kompatibilitu HDMI kábla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagotovite si najboljšo sliko z boljšimi, svetlejšimi barvami. Apple TV bo preveril združljivost vašega kabla HDMI, preden vklopi Dolby Vision."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få bästa möjliga bild med bättre och mer intensiva färger. Apple TV kontrollerar att HDMI-kabeln är kompatibel innan Dolby Vision aktiveras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อการรับชมภาพที่ดีที่สุดด้วยสีสันที่สว่างขึ้น Apple TV จะตรวจสอบให้แน่ใจว่าสาย HDMI ของคุณสามารถใช้งานร่วมกันได้ก่อนที่จะเปิดใช้ Dolby Vision"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi, daha parlak renklerle en iyi görüntüyü alın. Apple TV, HDMI kablonuzun uyumlu olduğundan emin olduktan sonra Dolby Vision özelliğini açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте взірцеве зображення з кращими, яскравішими кольорами. Apple TV перевірить сумісність вашого HDMI-кабелю, перш ніж вмикати Dolby Vision."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận được hình ảnh tốt nhất với màu sắc đẹp hơn, sáng hơn. Apple TV sẽ đảm bảo rằng cáp HDMI của bạn tương thích trước khi bật Dolby Vision."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "获取品质更佳、色彩更鲜明的画面。Apple TV确保你的HDMI线缆兼容后，才会打开“杜比视界”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取得更鮮艷出色的影像。開啟「杜比視界」之前Apple TV將會確認你的HDMI接線是否相容。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取得色彩更鮮艷出色的最佳影像。開啟「杜比視界」前，Apple TV會先確認你的HDMI連接線是否相容。"
          }
        }
      }
    },
