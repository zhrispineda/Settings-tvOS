    "LocalStorageQuotaExceededMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة كافية على هذا الجهاز. لتثبيت التطبيقات وتحديثها، يرجى حذف تطبيق أو أكثر أو إدارة سعة التخزين في الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha prou espai disponible al dispositiu. Per instal·lar i actualitzar apps, elimina’n d’altres o gestiona l’emmagatzematge a la configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V zařízení není dostatek místa. Chcete‑li nainstalovat a aktualizovat aplikace, smažte některé jiné aplikace nebo použijte správu úložiště v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke nok plads på denne enhed. Hvis du vil installere og opdatere apps, skal du slette en eller flere apps eller administrere din lagringsplads i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist nicht genügend Speicherplatz vorhanden. Lösche eine bzw. mehrere Apps oder verwalte deinen Speicher in den Einstellungen, um Apps zu installieren oder zu aktualisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός χώρος σε αυτήν τη συσκευή. Για εγκατάσταση και ενημέρωση εφαρμογών, διαγράψτε μία ή περισσότερες εφαρμογές ή διαχειριστείτε τον χώρο αποθήκευσης στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn’t enough space on this device. To install and update apps, delete one or more apps or manage your storage in Settings."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn’t enough space on this device. To install and update apps, delete one or more apps or manage your storage in Settings."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn’t enough space on this device. To install and update apps, delete one or more apps or manage your storage in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio en este dispositivo. Para instalar y actualizar apps, elimina una o varias apps o gestiona tu espacio de almacenamiento en Ajustes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en este dispositivo. Para instalar y actualizar apps, debes eliminar una o más apps, o administrar tu almacenamiento en Configuración."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en este dispositivo. Para instalar y actualizar apps, debes eliminar una o más apps, o administrar tu almacenamiento en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteen tila ei riitä. Jotta voit asentaa ja päivittää appeja, poista yksi tai useampi appi tai hallitse tallennustilaa Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de stockage sur cet appareil est insuffisant. Pour installer et mettre à jour des apps, supprimez-en une ou plusieurs, ou gérez votre stockage dans Réglages."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas suffisamment d’espace sur cet appareil. Pour installer et mettre à jour des apps, supprimez une ou plusieurs apps, ou gérez votre stockage dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק מקום פנוי במכשיר. כדי להתקין ולעדכן יישומים, יש למחוק לפחות יישום אחד או לנהל את האחסון ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस में पर्याप्त जगह नहीं है। ऐप्स इंस्टॉल और अपडेट करने के लिए एक या अधिक ऐप्स डिलीट करें या सेटिंग में जाकर अपनी स्टोरेज का प्रबंधन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na uređaju nema dovoljno memorije. Za instaliranje i ažuriranje aplikacija obrišite jednu ili više aplikacija ili podesite memoriju u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég tárhely ezen az eszközön. Az appok telepítéséhez és frissítéséhez töröljön egy vagy több appot, vagy módosítsa a tárhelyet a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada cukup ruang di perangkat ini. Untuk menginstal dan memperbarui app, hapus satu app atau lebih atau kelola penyimpanan Anda di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio libero sul dispositivo non è sufficiente. Per installare e aggiornare app, eliminane alcune o gestisci lo spazio in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに十分な空き領域がありません。アプリをインストールおよびアップデートするには、1個以上のアプリを削除するか、“設定”でストレージを管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 공간이 충분하지 않습니다. 앱을 설치하고 업데이트하려면 한 개 이상의 앱을 삭제하거나 설정에서 저장 공간을 관리하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang tidak mencukupi pada peranti ini. Untuk memasang dan mengemas kini app, padamkan satu atau lebih app, atau urus storan anda dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke nok ledig plass på enheten. Slett en eller flere apper, eller administrer lagringsplassen i Innstillinger, for å installere eller oppdatere apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg ruimte vrij op dit apparaat. Verwijder een of meer apps of beheer de opslagruimte in Instellingen om apps te installeren en bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało miejsca na urządzeniu. Aby móc instalować i uaktualniać aplikacje, usuń jedną lub więcej aplikacji — lub przejdź do zarządzania dyskiem w Ustawieniach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente neste dispositivo. Para instalar e atualizar apps, apague um ou mais apps ou gerencie o armazenamento nos Ajustes."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não dispõe de espaço suficiente. Para poder instalar e atualizar aplicações, apague uma ou mais aplicações ou gira o armazenamento nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest dispozitiv nu există suficient spațiu. Pentru a instala și actualiza aplicații, ștergeți una sau mai multe aplicații sau gestionați spațiul de stocare în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве недостаточно свободного места. Для установки и обновления приложений удалите одно или несколько уже установленных приложений либо перейдите в Настройки для управления хранилищем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zariadení nemáte dostatok voľného miesta. Ak chcete inštalovať a aktualizovať apky, vymažte jednu alebo viacero apiek, prípadne spravujte úložisko v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V tej napravi ni dovolj prostora. Če želite namestiti ali posodobiti aplikacije, izbrišite eno ali več aplikacij ali upravljajte shrambo v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det saknas ledigt utrymme på enheten. Radera en eller flera appar, eller hantera lagringen i Inställningar, om du vill installera och uppdatera appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีพื้นที่จัดเก็บข้อมูลไม่เพียงพอในอุปกรณ์เครื่องนี้ ในการติดตั้งและอัปเดตแอป ให้ลบอย่างน้อยหนึ่งแอปหรือจัดการพื้นที่จัดเก็บข้อมูลของคุณในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta yeterli yer yok. Uygulamaları yüklemek ve güncellemek için bir veya daha fazla uygulamayı silin ya da Ayarlar’da saklama alanınızı yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої бракує вільного місця. Щоб інсталювати й оновлювати програми, видаліть одну чи кілька програм або керуйте сховищем у Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có đủ dung lượng trên thiết bị này. Để cài đặt và cập nhật ứng dụng, hãy xóa một hoặc nhiều ứng dụng hay quản lý dung lượng của bạn trong Cài đặt."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备空间不足。若要安装并更新App，请删除一个或多个App或在“设置”中管理储存空间。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有足夠的儲存空間。如要安裝和更新App，請先刪除一個或多個App，或前往「設定」管理儲存空間。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的儲存空間不足。若要安裝和更新App，請刪除一或多個App，或在「設定」中管理你的儲存空間。"
          }
        }
      }
    },
