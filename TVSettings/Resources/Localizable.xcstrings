    "SaverBackdropAblumsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر صور iCloud. يمكنك اختيار ألبومات محددة أو نشاط حديث أو المفضلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les fotos a l’iCloud. Selecciona un àlbum, l’activitat recent o les fotos favorites."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje fotky na iCloudu. Vyberte album, nedávnou aktivitu nebo oblíbené položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser iCloud-fotos. Vælg et bestemt album, seneste aktivitet eller favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt iCloud-Fotos an. Wähle ein bestimmtes Album, eine der letzten Aktivitäten oder Favoriten aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προβάλετε τις Φωτογραφίες iCloud και επιλέξτε ένα συγκεκριμένο άλμπουμ, πρόσφατη δραστηριότητα ή Αγαπημένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows iCloud Photos. Choose a specific album, recent activity, or favorites."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows iCloud Photos. Choose a specific album, recent activity or favourites."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows iCloud Photos. Choose a specific album, recent activity or favourites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Fotos en iCloud. Selecciona un álbum concreto, la actividad reciente o tus favoritos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Fotos en iCloud. Elige álbumes específicos, actividad reciente o Favoritos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Fotos en iCloud. Elige álbumes específicos, actividad reciente o Favoritos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää iCloud-kuvat. Valitse tietty albumi, äskeinen toiminta tai suosikit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les photos contenues sur iCloud. Choisissez un album spécifique, une activité récente ou des favoris."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le contenu de Photos iCloud. Choisissez un album précis, vos activités récentes ou les favoris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג את ״תמונות iCloud״ ולבחור אלבומים מסוימים, פעילות אחרונה או מועדפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud तस्वीरें दिखाता है। कोई विशिष्ट ऐल्बम, हाल की ऐक्टिविटी या पसंदीदा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje iCloud fotografije. Odaberite određeni album, nedavnu aktivnost ili omiljene stavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti az iCloud-fotókat. Választhat egy adott albumot, mostanában végzett tevékenységet vagy kedvenceket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan Foto iCloud. Pilih album secara spesifik, aktivitas terbaru, atau favorit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le foto di iCloud. Scegli un album specifico, le attività recenti o i preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud写真を表示します。特定のアルバム、最近のアクティビティ、またはお気に入りを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 사진을 보여줍니다. 특정 앨범, 최근 활동 또는 즐겨찾는 사진을 선택할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan Foto iCloud. Pilih album tertentu, aktiviti terbaharu atau kegemaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser iCloud Bilder. Velg et bestemt album, nylig aktivitet eller favoritter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont iCloud-foto's. Kies een specifiek album, recente activiteit of favorieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla Zdjęcia w iCloud. Wybierz określony album, ostatnią aktywność lub ulubione."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as Fotos do iCloud. Escolha um álbum específico, atividades recentes ou favoritas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as Fotografias em iCloud. Escolha um álbum específico, atividade recente ou favoritos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează Poze iCloud. Alegeți un anumit album, activități recente sau favorite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут показаны Фото iCloud. Можно выбрать определенный альбом, недавние события или избранные фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí iCloud Fotky. Môžete vybrať konkrétny album, nedávnu aktivitu alebo obľúbené položky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV prikaže Fotografije iCloud. Izberite določen album, nedavno dejavnost ali pa priljubljene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar iCloud-bilder. Välj ett specifikt album, senaste aktivitet eller favoriter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง “รูปภาพ iCloud” เลือกอัลบั้มเฉพาะ กิจกรรมล่าสุด หรือรายการโปรด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Fotoğrafları’nı gösterir. Belirli bir albüm, yakın zamanda yapılan bir aktivite veya favori seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати Фото iCloud. Обирайте певний альбом, недавні чи улюблені знімки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị Ảnh iCloud. Hãy chọn một album cụ thể, hoạt động gần đây hoặc mục ưa thích."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示iCloud照片。选取特定相簿、最近活动或个人收藏。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示「iCloud相片」。選擇一個特定的相簿、最近活動，或喜好項目。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示「iCloud照片」。選擇特定的相簿、最近活動或喜好項目。"
          }
        }
      }
    },
    "SaverBackdropAerialsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار الصور الجوية المراد رؤيتها، من مشاهد مناظر المدينة إلى المشاهد تحت الماء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona les vistes aèries que vulguis que s’hi mostrin, com ara paisatges urbans o imatges submarines."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte letecké záběry, které se mají zobrazovat – od městských panoramat po podvodní scenérie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de luftfotos, du vil se, fra bylandskaber til undervandsscener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Aufnahmen aus, die du sehen möchtest, von Stadtlandschaften bis zu Unterwasseraufnahmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τα αεροβίντεο που θέλετε να εμφανίζονται, από αστικά τοπία έως υποθαλάσσιες σκηνές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you want to see, from cityscapes to underwater scenes."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you want to see, from cityscapes to underwater scenes."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you want to see, from cityscapes to underwater scenes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona las vistas aéreas que quieras ver, desde paisajes urbanos hasta escenas subacuáticas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las vistas aéreas que quieres ver, desde rascacielos hasta escenas submarinas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las vistas aéreas que quieres ver, desde rascacielos hasta escenas submarinas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ilmakuvat, jotka haluat nähdä, kaupunkimaisemista vedenalaisiin näkymiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes que vous souhaitez afficher parmi des paysages urbains, des scènes sous-marines et plus encore."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes que vous voulez afficher, notamment parmi des paysages urbains et des scènes sous-marines."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את צילומי האוויר הרצויים, מנופים עירוניים ועד צילומים תת-מימיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहर के नज़ारों से लेकर अंडरवॉटर सीन तक, वे एरियल दृश्य चुनें जिन्हें आप देखना चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite zračne snimke koje želite vidjeti, od panorama grada do podvodnih scena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja a légi felvételeket – a városképektől a víz alatti jelenetekig –, amelyeket látni szeretne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Aerial yang ingin Anda lihat, dari panorama kota hingga pemandangan bawah air."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le viste aeree che preferisci, dai paesaggi urbani a scene del mondo sottomarino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市の景観から水中のシーンまで、お好きな空撮を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도시 풍경부터 수중 장면까지 보고 싶은 항공 사진을 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Tema Udara yang anda mahu lihat, dari pemandangan bandar hingga adegan bawah air."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg skjermsparerne du vil se, fra bylandskap til undervannsscener."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de schermbeveiligingen die je wilt zien, van stadsgezichten tot onderwaterscènes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ulubione wygaszacze Z lotu ptaka — od pejzaży miejskich po sceny podwodne."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais vistas Aéreas você quer ver, de paisagens urbanas a cenas submarinas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as vistas aéreas que prefere, de paisagens urbanas a cenários subaquáticos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți vederile aeriene care doriți să fie afișate, de la peisaje urbane la scene subacvatice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите аэрозаставки, которые Вы хотите видеть, среди множества доступных вариантов — от городских пейзажей до подводных сцен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte letecké zábery, ktoré sa budú zobrazovať, od panorám miest až po podvodné scenérie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite posnetke iz zraka, ki jih želite prikazati, od mestnih pokrajin do podvodnih prizorov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka flygfoton du vill se, från stadsbilder till scener under vattnet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาพมุมสูงที่คุณต้องการดูตั้งแต่ทิวทัศน์ของเมืองไปจนถึงมุมมองโลกใต้ทะเล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir manzaralarından su altı ortamlara varıncaya kadar görmek istediğiniz havadan öğeleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, які види з повітря показувати — від міських краєвидів до підводних світів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tùy chọn Không trung mà bạn muốn xem, từ khung cảnh thành phố đến cảnh dưới nước."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从城市风光到水底景观，选取要显示的航拍。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從城市天際到海底場景，選擇你想觀看的「航拍」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從城市風光到水底世界，選擇想要觀看的空照圖。"
          }
        }
      }
    },
