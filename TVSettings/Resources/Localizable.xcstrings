    "DevicesPageDescriptionFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإقران الجهاز، قرّبه من Apple TV.\n\nلمعرفة المزيد عن الإقران، يرجى زيارة:\nsupport.apple.com/appletv/pairing"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per enllaçar un dispositiu, apropa’l a l’Apple TV.\n\nPer obtenir informació sobre com enllaçar dispositius, ves a support.apple.com/appletv/pairing."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení, které chcete spárovat, podržte v blízkosti této Apple TV.\n\nInformace o párování najdete na stránce support.apple.com/appletv/pairing."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold enheden tæt på dette Apple TV for at danne par.\n\nLæs mere om pardannelse på support.apple.com/appletv/pairing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein Gerät zu koppeln, halte es in die Nähe des Apple TV.\n\nWeitere Informationen zum Koppeln sind unter support.apple.com/appletv/pairing erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για ζευγοποίηση μιας συσκευής, κρατήστε την κοντά σε αυτό το Apple TV.\n\nΓια πληροφορίες σχετικά με τη ζευγοποίηση, μεταβείτε στη διεύθυνση support.apple.com/appletv/pairing."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To pair a device, hold it close to this Apple TV.\n\nTo learn about pairing, go to support.apple.com/appletv/pairing."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To pair a device, hold it close to this Apple TV.\n\nTo learn about pairing, go to support.apple.com/appletv/pairing"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To pair a device, hold it close to this Apple TV.\n\nTo learn about pairing, go to support.apple.com/appletv/pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enlazar un dispositivo, acércalo a este Apple TV.\n\nPara más información sobre cómo enlazarlo, visita support.apple.com/appletv/pairing."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enlazar un dispositivo, acércalo a este Apple TV.\n\nPara obtener detalles sobre cómo enlazar dispositivos, visita support.apple.com/appletv/pairing."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enlazar un dispositivo, acércalo a este Apple TV.\n\nPara obtener detalles sobre cómo enlazar dispositivos, visita support.apple.com/appletv/pairing."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun haluat muodostaa laiteparin, pidä laitetta tämän Apple TV:n lähellä.\n\nLisätietoja parinmuodostuksesta on osoitteessa support.apple.com/appletv/pairing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour jumeler un appareil, tenez-le à proximité de cette Apple TV.\n\nPour en savoir plus sur le jumelage, accédez à support.apple.com/appletv/pairing."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour jumeler un appareil, approchez-le de cette Apple TV.\n\nPour en apprendre plus sur le jumelage, rendez-vous sur support.apple.com/appletv/pairing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקשר מכשיר, יש להחזיק אותו קרוב ל-Apple TV.\n\nמידע נוסף בנושא קישור זמין בכתובת: support.apple.com/appletv/pairing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस को पेयर करने के लिए उसे इस Apple TV के पास रखें।\n\nपेयरिंग के बारे में जानने के लिए support.apple.com/appletv/pairing पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uparivanje uređaja držite ga blizu ovog Apple TV-a.\n\nZa dodatne informacije o uparivanju posjetite support.apple.com/hr-hr/appletv/pairing."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszköz párosításához tartsa közel az eszközt ehhez az Apple TV-hez.\n\nA párosításról további információkat a support.apple.com/hu-hu/appletv/pairing weboldalon talál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memasangkan perangkat, dekatkan ke Apple TV ini.\n\nUntuk mempelajari pemasangan, buka support.apple.com/id-id/appletv/pairing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per abbinare un dispositivo, avvicinalo ad Apple TV.\n\nPer ulteriori informazioni sull’operazione di abbinamento, vai alla pagina support.apple.com/it-it/appletv/pairing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスをペアリングするには、このApple TVに近付けてください。\n\nペアリングについて詳しくは、support.apple.com/appletv/pairing を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 페어링하려면 해당 기기를 이 Apple TV 가까이 들고 있으십시오.\n\n페어링과 관련된 자세한 사항은 support.apple.com/appletv/pairing 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memasangkan peranti, pegangnya berdekatan Apple TV ini.\n\nUntuk mengetahui tentang berpasangan, pergi ke support.apple.com/en-my/HT208088."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold enheten nær Apple TV for å koble dem sammen.\n\nFinn ut mer om sammenkobling på support.apple.com/appletv/pairing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om een apparaat te koppelen, houd je het in de buurt van deze Apple TV.\n\nGa voor meer informatie over koppelen naar support.apple.com/nl-nl/appletv/pairing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby połączyć urządzenie w parę, zbliż je do tego Apple TV.\n\nAby uzyskać więcej informacji na temat łączenia urządzeń w parę, odwiedź stronę support.apple.com/appletv/pairing."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para emparelhar um dispositivo, aproxime‑o da Apple TV.\n\nPara saber sobre emparelhamento, acesse support.apple.com/appletv/pairing."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para emparelhar um dispositivo, mantenha‑o perto da Apple TV.\n\nEncontrará informação adicional acerca do emparelhamento em support.apple.com/appletv/pairing."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a asocia un dispozitiv, țineți‑l aproape de acest Apple TV.\n\nPentru informații despre asociere, accesați support.apple.com/appletv/pairing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы создать пару с этим устройством, держите устройство вблизи этого Apple TV.\n\nПодробнее о создании пар: support.apple.com/appletv/pairing."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete spárovať zariadenie, podržte ho pri Apple TV.\n\nViac informácií o párovaní nájdete na stránke support.apple.com/appletv/pairing."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite seznaniti napravo, jo približajte Apple TV-ju.\n\nZa več informacij o seznanjanju pojdite na support.apple.com/appletv/pairing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkoppla en enhet genom att hålla den nära denna Apple TV.\n\nMer information om parkoppling hittar du på support.apple.com/appletv/pairing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการจับคู่กับอุปกรณ์ ให้ถืออุปกรณ์ไว้ใกล้กับ Apple TV เครื่องนี้\n\nในการเรียนรู้เกี่ยวกับการจับคู่ ให้ไปที่ support.apple.com/appletv/pairing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıtı eşlemek için aygıtı bu Apple TV’ye yakın tutun.\n\nEşleme hakkında daha fazla bilgi için support.apple.com/tr-tr/appletv/pairing adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для створення пари піднесіть пристрій до цього Apple TV.\n\nДокладну інформацію про створення пари наведено на вебсторінці support.apple.com/appletv/pairing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ghép đôi thiết bị, hãy giữ thiết bị gần Apple TV này.\n\nĐể tìm hiểu về ghép đôi, hãy truy cập support.apple.com/appletv/pairing."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要配对设备，请将它靠近此Apple TV。\n\n若要了解有关配对的更多信息，请访问support.apple.com/appletv/pairing。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要配對裝置，請將裝置靠近此Apple TV。\n\n如要了解配對，請前往support.apple.com/appletv/pairing。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要配對裝置，請將裝置靠近此Apple TV。\n\n若要瞭解配對，請前往：https://support.apple.com/zh-tw/HT208088。"
          }
        }
      }
    },
