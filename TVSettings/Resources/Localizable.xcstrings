    "AVDolbySurroundSoundConvertFormatWithAtmosAvailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغيّر Apple TV تنسيق الصوت بحيث يكون\nمتوافقًا مع جهازك.\n\nيمكنك إيقاف هذا الإعداد ليتم استخدام أفضل تنسيق صوت متاح\nبشكل تلقائي، بما في ذلك Dolby Atmos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es canviarà el format d’àudio de l’Apple TV perquè\nsigui compatible amb l’equip.\n\nDesactiva aquesta opció per utilitzar automàticament\nel millor format d’àudio disponible, inclòs Dolby Atmos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV změní formát zvuku tak, aby byl\nkompatibilní se zvukovou soustavou.\n\nKdyž tuto funkci vypnete, automaticky se použije nejlepší dostupný formát zvuku\nvčetně Dolby Atmos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV ændrer lydformatet, for at være\nkompatibelt med dit udstyr.\n\nSlå dette fra for automatisk at bruge det bedst tilgængelige\nlydformat, inklusive Dolby Atmos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV ändert das Audioformat, damit es\nmit deinem Equipment kompatibel ist.\n\nDeaktiviere diese Option, um automatisch das bestmögliche Audioformat\nzu verwenden, einschließlich Dolby Atmos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα αλλάξει τη μορφή ήχου ώστε να είναι\nσυμβατή με τον εξοπλισμό σας.\n\nΑπενεργοποιήστε αυτήν τη ρύθμιση για αυτόματη χρήση της βέλτιστης διαθέσιμης μορφής ήχου,\nσυμπεριλαμβανομένου του Dolby Atmos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format\navailable, including Dolby Atmos."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format\navailable, including Dolby Atmos."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format\navailable, including Dolby Atmos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV cambiará el formato de audio para que\nsea compatible con tu equipo.\n\nDesactiva esta opción para usar automáticamente\nel mejor formato de audio disponible, incluido Dolby Atmos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cambiará el formato de audio para que sea\ncompatible con tu equipo.\n\nDesactiva esto para usar automáticamente el mejor formato de audio\nincluyendo Dolby Atmos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cambiará el formato de audio para que sea\ncompatible con tu equipo.\n\nDesactiva esto para usar automáticamente el mejor formato de audio\nincluyendo Dolby Atmos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV muuttaa äänimuotoa, jotta se on\nyhteensopiva laitteesi kanssa.\n\nJos laitat tämän pois päältä, käytetään parasta äänimuotoa,\njoka on saatavilla, mukaan lukien Dolby Atmos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV changera le format audio pour quʼil soit\ncompatible avec votre équipement.\n\nDésactivez cette option pour utiliser automatiquement le meilleur format audio\ndisponible, y compris Dolby Atmos."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV modifiera le format audio pour le rendre\ncompatible avec votre équipement.\n\nDésactivez cette fonction pour utiliser automatiquement le meilleur format audio\ndisponible, y compris Dolby Atmos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישנה את פורמט השמע כך שיהיה\nתואם לציוד שלך.\n\nניתן לבטל הגדרה זו כדי להשתמש באופן אוטומטי בפורמט השמע הטוב ביותר\nהזמין, כולל Dolby Atmos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV ऑडियो फ़ॉर्मैट को इस तरह बदल देगा जिससे\nकि वो आपके उपकरण के साथ संगत हो।\n\nDolby Atmos सहित सर्वोत्तम उपलब्ध ऑडियो फ़ॉर्मैट का\nऑटोमैटिकली इस्तेमाल करने के लिए इसे बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV promijenit će audio format kako bi bio\nkompatibilan s vašom opremom.\n\nMožete to isključiti kako bi se automatski koristio najbolji dostupni audio format,\nuključujući Dolby Atmos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV-je módosítani fogja a hangformátumot, hogy az\nkompatibilis legyen a berendezésével.\n\nKapcsolja ki az elérhető legjobb formátum automatikus használatához,\na Dolby Atmost is beleértve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda akan mengubah format audio agar\nkompatibel dengan perlengkapan Anda.\n\nMatikan ini untuk menggunakan format audio terbaik\nyang tersedia, termasuk Dolby Atmos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV modificherà il formato audio in modo tale da\nrenderlo compatibile con il tuo impianto.\n\nDisattiva l’opzione per utilizzare automaticamente il miglior formato audio\ndisponibile, tecnologia Dolby Atmos inclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのApple TVでは、オーディオフォーマットが\nお使いの機器と互換性のあるものに自動的に変更されます。\n\nドルビーアトモスを含む、使用可能な最高品質のフォーマット\nを自動的に使用するには、これをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용자의 장비와 호환되도록\n오디오 포맷을 변경합니다.\n\nDolby Atmos 등 사용 가능한 최고의 오디오 음질을\n자동으로 사용하려면 이 기능을 끄십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda akan menukar format audio supaya\nserasi dengan peralatan anda.\n\nNyahaktifkannya untuk menggunakan format audio terbaik\nyang tersedia secara automatik, termasuk Dolby Atmos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil bytte til et lydformat som er\nkompatibelt med utstyret ditt.\n\nSlå av innstillingen for å automatisk bruke det beste\ntilgjengelige lydformatet, inkludert Dolby Atmos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV wijzigt de audiostructuur\nzodat deze compatibel is met je apparatuur.\n\nSchakel dit uit om automatisch de best beschikbare audiostructuur\nte gebruiken, waaronder Dolby Atmos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie zmieniać format audio\nna zgodny ze sprzętem.\n\nWyłącz tę opcję, aby automatycznie używać najlepszego\ndostępnego formatu, w tym Dolby Atmos."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV mudará o formato de áudio para que\nfique compatível com seu equipamento.\n\nDesative essa opção para usar automaticamente o melhor formato de áudio\ndisponível, incluindo o Dolby Atmos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de áudio será alterado para ser\ncompatível com o equipamento.\n\nDesative esta opção para usar automaticamente o melhor\nformato de áudio disponível, incluindo Dolby Atmos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul dvs. va schimba formatul audio pentru a fi\ncompatibil cu echipamentul dvs.\n\nDezactivați această opțiune pentru a utiliza automat cel mai bun format audio\ndisponibil, inclusiv Dolby Atmos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет изменен аудиоформат, чтобы повысить\nсовместимость с Вашим аудиооборудованием.\n\nВыключите этот параметр, чтобы автоматически использовать наилучший\nиз доступных аудиоформатов, включая Dolby Atmos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV zmení formát audia tak, aby bol\nkompatibilný s vašou zvukovou aparatúrou.\n\nAk chcete automaticky použiť najlepší dostupný formát audia\nvrátane formátu Dolby Atmos, vypnite túto možnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo spremenil obliko zvočnega zapisa, da bo\nzdružljiva z vašo opremo.\n\nIzklopite to možnost, da bo samodejno uporabljena najboljša oblika zvočnega zapisa, ki\nje na voljo, vključno z zvokom Dolby Atmos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV ändrar ljudformat så att det blir\nkompatibelt med din utrustning.\n\nAvaktivera det här alternativet om du automatiskt vill använda\ndet bästa tillgängliga ljudformatet, inklusive Dolby Atmos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณจะเปลี่ยนรูปแบบเสียง\nให้สามารถใช้งานร่วมกับอุปกรณ์ของคุณได้\n\nปิดใช้การตั้งค่านี้เพื่อใช้รูปแบบเสียงที่ดีที่สุดที่มีโดยอัตโนมัติ\nรวมทั้ง Dolby Atmos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz ses biçimini\nekipmanınızla uyumlu olacak şekilde değiştirir.\n\nDolby Atmos da dahil olmak üzere var olan en iyi ses biçimini\notomatik olarak kullanmak için bunu kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV змінюватиме формат звуку\nдля забезпечення сумісності з обладнанням.\n\nВимкніть цей параметр, щоб найкращий наявний формат\nзастосовувавсь автоматично, зокрема Dolby Atmos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn sẽ thay đổi định dạng âm thanh để\ntương thích với thiết bị của bạn.\n\nHãy tắt tính năng này để tự động sử dụng định dạng âm thanh tốt nhất\ncó sẵn, bao gồm Dolby Atmos."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将更改音频格式以\n与你的设备兼容。\n\n关闭此选项来自动使用最佳可用\n音频格式，包括杜比全景声。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會將音訊格式改為\n與你的設備相容的格式。\n\n關閉此功能以自動使用可用的最佳音訊格式，\n包括杜比全景聲。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV將會更改音訊格式，與設備更為\n相容。\n\n關閉此功能會自動使用最佳的音訊格式，包含\n杜比全景聲。"
          }
        }
      }
    },
    "AVDolbySurroundSoundDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Apple TV تلقائيًا أفضل تنسيق\nصوت متاح.\n\nإذا كنت تواجه مشكلات في إعادة التشغيل، يمكنك\nتجربة تنسيق مختلف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilitza automàticament el millor format\nd’àudio disponible.\n\nSi tens cap problema per reproduir l’àudio, pots provar\nd’utilitzar un altre format."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automaticky použije nejlepší dostupný\nformát zvuku.\n\nPokud máte se zvukem problémy, můžete\nzkusit jiný formát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV bruger automatisk det bedst tilgængelige\nlydformat.\n\nHvis du har problemer med afspilning, kan du\nprøve med et andet format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV verwendet automatisch das\nbestmögliche Audioformat.\n\nWenn es bei der Wiedergabe Probleme gibt, versuche es\nmit einem anderen Format."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV χρησιμοποιεί αυτόματα τη βέλτιστη\nδιαθέσιμη μορφή ήχου.\n\nΑν αντιμετωπίζετε προβλήματα αναπαραγωγής,\nμπορείτε να δοκιμάσετε μια διαφορετική μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV utiliza automáticamente el mejor\nformato de audio disponible.\n\nSi encuentras problemas con la reproducción,\npuedes probar con otro formato."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV usa automáticamente el mejor formato de audio disponible,\ndisponible.\n\nSi tienes problemas para reproducir el audio, puedes\nprobar con otro formato."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV usa automáticamente el mejor formato de audio disponible,\ndisponible.\n\nSi tienes problemas para reproducir el audio, puedes\nprobar con otro formato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV käyttää automaattisesti parasta äänimuotoa,\njoka on saatavilla.\n\nJos toistossa on ongelmia, voit\nkokeilla toista muotoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV utilise automatiquement le meilleur format\naudio disponible.\n\nEn cas de problèmes de lecture, vous pouvez\nessayer un autre format."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV utilise automatiquement le meilleur format\naudio disponible.\n\nEn cas de problèmes de lecture, vous pouvez\nessayer un format différent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV משתמש באופן אוטומטי בפורמט השמע הטוב ביותר\nהזמין.\n\nבמקרה של בעיות בהפעלה, ניתן\nלנסות פורמט אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV ऑटोमैटिकली सबसे बढ़िया ऑडियो का इस्तेमाल करता है\nफ़ॉर्मैट का इस्तेमाल करता है।\n\nअगर आपको प्लेबैक में समस्या हो रही है, तो आप\nकोई और फ़ॉर्मैट आज़मा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatski koristi najbolji dostupan\naudio format.\n\nAko imate problema s reprodukcijom, možete pokušati\ns drugim formatom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV-je automatikusan az elérhető legjobb\nhangformátumot használja.\n\nAmennyiben problémákat tapasztal a lejátszással kapcsolatban,\npróbáljon másik formátumot használni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda akan secara otomatis menggunakan format audio terbaik\nyang tersedia.\n\nJika Anda mengalami masalah pada pemutaran, Anda dapat\nmencoba format lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV utilizza in automatico il miglior formato\naudio disponibile.\n\nSe riscontri problemi di riproduzione,\nprova con un formato differente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのApple TVでは使用可能な最高品質のオーディオ\nフォーマットが自動的に使用されます。\n\n再生に問題がある場合は、\n別のフォーマットをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용 가능한\n최고의 오디오 음질을 자동으로 사용합니다.\n\n재생에 문제가 발생하면\n다른 포맷을 시도할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda menggunakan format audio terbaik\nyang tersedia secara automatik.\n\nJika anda mengalami masalah dengan main balik, anda boleh\nmencuba format berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bruker automatisk beste\ntilgjengelige lydformat.\n\nHvis du har problemer med avspillingen, kan du\nprøve med et annet format."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV gebruikt automatisch de best\nbeschikbare audiostructuur.\n\nAls je problemen ondervindt met afspelen, kun je\neen andere structuur proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatycznie używa najlepszego\ndostępnego formatu.\n\nJeśli występują problemy z odtwarzaniem, możesz\nspróbować użyć innego formatu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usa automaticamente o melhor formato\nde áudio disponível.\n\nSe tiver problemas com a reprodução, você pode\nexperimentar um formato diferente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usa automaticamente o melhor formato\nde áudio disponível.\n\nCaso detete algum problema com a reprodução,\npode experimentar usar um formato diferente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul utilizează automat cel mai bun format audio\ndisponibil.\n\nDacă întâmpinați probleme legate de redare, puteți\nîncerca un format diferit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет автоматически использован наилучший\nиз доступных аудиоформатов.\n\nПри возникновении проблем с воспроизведением\nпопробуйте использовать другой формат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automaticky použije najlepší dostupný\nformát audia.\n\nAk máte problémy s prehrávaním, môžete skúsiť\npoužiť iný formát."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV samodejno uporabi najboljšo obliko zvočnega zapisa,\nki je na voljo.\n\nČe imate težave s predvajanjem,\nlahko poskusite drugo obliko zapisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV använder automatiskt det bästa\ntillgängliga ljudformatet.\n\nOm du upplever problem med uppspelningen\nkan du prova ett annat format."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณจะใช้รูปแบบเสียงดีที่สุดที่มี\nโดยอัตโนมัติ\n\nถ้าคุณประสบปัญหากับการเล่น คุณสามารถ\nลองรูปแบบอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz en iyi ses biçimini\notomatik olarak kullanır.\n\nOynatmayla ilgili bir sorun yaşıyorsanız\nbaşka bir biçim deneyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV автоматично застосовує найкращий\nіз доступних форматів звуку.\n\nЯкщо з відтворенням виникають проблеми, можна\nспробувати інший формат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn tự động sử dụng định dạng âm thanh\ntốt nhất có sẵn.\n\nNếu đang gặp phải sự cố phát lại thì bạn có thể\nthử một định dạng khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV自动使用最佳可用的\n音频格式。\n\n如果播放出现问题，你可以尝试\n其他格式。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會自動使用可用的\n最佳音訊格式。\n\n如你遇到播放問題，可以\n嘗試使用另一種格式。"
