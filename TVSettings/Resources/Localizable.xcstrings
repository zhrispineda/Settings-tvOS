            "value": "Değişikliklerden Vazgeç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхилити зміни"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bỏ thay đổi"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃更改"
          }
        },
        "zh_HK": {
          "stringUnit": {
