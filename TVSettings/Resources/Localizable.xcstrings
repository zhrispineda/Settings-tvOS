    "SystemAppearanceAutomaticLocationServicesDisabledMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يتغير مظهر الـ Apple TV تلقائيًا إلى داكن في وقت الغروب، وفاتح في وقت الشروق. ويُستخدم موقعك لتحديد الأوقات المحلية للشروق والغروب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aspecte de l’Apple TV pot canviar automàticament i enfosquir‑se quan es pon el sol i aclarir‑se quan es fa de dia. S’utilitza la ubicació per determinar l’hora de la sortida i de la posta de sol."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhled Apple TV se může při západu slunce automaticky změnit na tmavý a při východu slunce na světlý. Východ a západ slunce se určuje podle vaší polohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udseendet på Apple TV kan automatisk ændres til Mørk ved solnedgang og Lys ved solopgang. Din lokalitet afgør det lokale tidspunkt for solopgang og solnedgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erscheinungsbild deines Apple TV kann automatisch bei Sonnenuntergang zu „Dunkel“ und bei Sonnenaufgang zu „Hell“ wechseln. Dazu wird dein Standort verwendet, um zu ermitteln, wann die Sonne auf- und untergeht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εμφάνιση του Apple TV μπορεί να αλλάζει αυτόματα σε «Σκούρα» όταν βραδιάζει και σε «Ανοιχτόχρωμη» όταν ξημερώνει. Η τοποθεσία σας θα χρησιμοποιείται για προσδιορισμό της τοπικής ώρας ανατολής και δύσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The appearance of your Apple TV can change automatically to Dark at sunset, and Light at sunrise. Your location is used to determine the local times for sunrise and sunset."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The appearance of your Apple TV can change automatically to Dark at sunset and Light at sunrise. Your location is used to determine the local times for sunrise and sunset."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The appearance of your Apple TV can change automatically to Dark at sunset, and Light at sunrise. Your location is used to determine the local times for sunrise and sunset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste de aspecto del Apple TV puede cambiar automáticamente a Oscuro al anochecer y a Claro al amanecer. Se utilizará tu ubicación para determinar la hora de salida y puesta de sol de donde estés."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El aspecto de tu Apple TV puede cambiar automáticamente a Obscuro al atardecer y Claro al amanecer. Se utilizará tu ubicación para determinar cuándo amanece y atardece."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El aspecto de tu Apple TV puede cambiar automáticamente a Oscuro al atardecer y Claro al amanecer. Se utilizará tu ubicación para determinar cuándo amanece y atardece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV:n ulkoasu voi muuttua automaattisesti tummaksi auringonlaskun aikaan ja vaaleaksi auringonnousun aikaan. Sijaintiasi käytetään paikallisten auringonnousu- ja auringonlaskuaikojen määrittämiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence de votre Apple TV peut automatiquement passer à Sombre au coucher du soleil et à Clair au lever du soleil. Votre emplacement est utilisé pour déterminer à quelle heure le soleil se couche et se lève chez vous."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image de votre Apple TV peut être réglée automatiquement à Sombre au coucher du soleil et à Claire au lever du soleil. Votre position géographique permet de déterminer l’heure locale du lever et du coucher du soleil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מראה ה-Apple TV יכול להתחלף באופן אוטומטי ל״כהה״ בשעת השקיעה, ול״בהיר״ בשעת הזריחה. שעות השקיעה והזריחה באזורך ייקבעו לפי המיקום שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple TV का प्रकटन ऑटोमैटिकली सूर्यास्त के समय “गहरा” और सूर्योदय के समय “हल्का” में बदल सकता है। आपके स्थान का उपयोग सूर्योदय और सूर्यास्त के लिए स्थानीय समय निर्धारित करने के लिए किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgled vašeg Apple TV-a može se automatski promijeniti u Tamno za vrijeme zalaska Sunca i Svijetlo za vrijeme izlaska. Vaša lokacija upotrijebit će se za utvrđivanje točnog vremena izlaska i zalaska Sunca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV megjelenését automatikusan módosíthatja Sötétre naplementekor, illetve Világosra napfelkeltekor. Az Ön helyzete lesz a napfelkelte és a naplemente helyi idejének meghatározásához felhasználva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan Apple TV Anda dapat diubah secara otomatis menjadi Gelap saat matahari terbenam dan Terang saat matahari terbit. Lokasi Anda digunakan untuk menentukan waktu lokal saat matahari terbit dan terbenam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aspetto di Apple TV può cambiare automaticamente, diventando chiaro all’alba e scuro al tramonto. La tua posizione verrà utilizzata per determinare a che ora sorge e tramonta il sole nella zona in cui ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVの外観は日が暮れると自動的に暗く、日が昇ると自動的に明るくなります。現在地の位置情報が日の入りと日の出の時刻を決めるのに使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV의 화면 모드를 해가 지면 다크 모드로, 해가 뜨면 라이트 모드로 자동 변경할 수 있습니다. 현지의 일몰 및 일출 시간은 사용자의 위치를 이용하여 파악합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penampilan Apple TV anda boleh bertukar secara automatik kepada Gelap sewaktu matahari terbenam dan Cerah sewaktu matahari terbit. Lokasi anda digunakan untuk menentukan masa tempatan bagi matahari terbit dan matahari terbenam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan endre utseendet automatisk til Mørkt ved solnedgang og Lyst ved soloppgang. Posisjonen din brukes for å vise når solen står opp og går ned der du befinner deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De weergave van je Apple TV kan automatisch worden ingesteld op 'Donker' bij zonsondergang en op 'Licht' bij zonsopgang. Je locatie wordt gebruikt om de lokale tijden voor zonsopgang en zonsondergang te bepalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląd interfejsu Apple TV może zmieniać się na Ciemny po zachodzie słońca oraz na Jasny po wschodzie słońca. Godziny wschodu i zachodu słońca są ustalane na podstawie Twojego położenia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência da Apple TV pode ser alterada automaticamente para Escura após o pôr do sol e Clara após o nascer do sol. Sua localização e seu fuso horário são usados para determinar a hora local do pôr do sol e do nascer do sol."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode programar a Apple TV para, automaticamente, alternar entre os modos de apresentação em tons claros e tons escuros. A sua localização é usada para determinar as horas do nascer e do pôr do Sol."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspectul Apple TV‑ului dvs. se poate schimba automat, devenind întunecat la apus și luminos la răsărit. Localizarea dvs. este utilizată pentru a determina orele locale la care răsare și apune soarele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета интерфейса Apple TV могут автоматически становиться темнее после захода солнца и светлее с восходом солнца. Ваша геопозиция и данные о часовом поясе используются для того, чтобы определять время восхода и захода солнца."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhľad vášho Apple TV sa môže automaticky meniť na Tmavý pri západe slnka a Svetlý pri východe slnka. Miestny čas východu a západu slnka je stanovený na základe vašej polohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videz Apple TV-ja se lahko ob sončnem zahodu samodejno spremeni v način Temno, ob sončnem vzhodu pa v način Svetlo. Na podlagi vaše lokacije se določijo lokalni časi sončnega vzhoda in zahoda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utseendet på Apple TV kan ändras automatiskt till Mörkt vid solnedgången och Ljust när solen går upp. Din plats används till att avgöra den lokala tidpunkten för solens uppgång och nedgång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบของ Apple TV สามารถเปลี่ยนเป็นแบบมืดเมื่อดวงอาทิตย์ตก และแบบสว่างเมื่อดวงอาทิตย์ขึ้นได้ ตำแหน่งที่ตั้งของคุณจะถูกใช้เพื่อกำหนดเวลาที่ดวงอาทิตย์ขึ้นหรือตกภายในท้องถิ่นนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nizin görünümü gün batımında Koyu Renk ve gün doğumunda Açık Renk olacak şekilde otomatik olarak değişebilir. Konumunuz, gün batımı ve gün doğumu saatinin belirlenmesinde kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигляд вашого Apple TV може автоматично змінюватись із заходом сонця на «Темний», а зі сходом — на «Світлий». Ваша геопозиція використовується для визначення місцевого часу сходу і заходу сонця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện của Apple TV có thể thay đổi tự động thành Tối vào lúc mặt trời lặn và Sáng vào lúc mặt trời mọc. Vị trí của bạn được sử dụng để xác định giờ địa phương cho thời điểm mặt trời mọc và mặt trời lặn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV的外观可自动在日落时更改为“深色”，日出时更改为“浅色”。你的位置会用于确定当地日出和日落的时间。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV的外觀可以在日落時自動轉為「深色」，在日出時轉為「淺色」。你的位置會用於確定當地日出和日落的時間。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV的外觀可在日落時自動更改為「深色」，並在日出時更改為「淺色」。你的位置會用來判斷當地的日出和日落時間。"
          }
        }
      }
    },
