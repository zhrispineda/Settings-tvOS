    "AccountsUserGroupRecommendationsUpsellDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تشغيل \"للجميع\"، تظهر توصيات ببرامج تلفزيون وأفلام لعدة ملفات تعريف على هذا الـ Apple TV. وإذا أخفيت هذا الخيار للتوصيات الجماعية، فسيقدم توصيات لملف تعريف واحد فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La funció “Per a tothom” recomana sèries i pel·lícules als diversos perfils que fan servir l’Apple TV. Si ocultes l’opció de les recomanacions grupals, només se n’oferiran a un perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na řádku „Pro celou skupinu“ se zobrazují seriály a filmy doporučené pro více profilů z této Apple TV. Pokud doporučení pro skupinu skryjete, budou se zobrazovat doporučení jen pro jeden profil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til jer alle anbefaler tv-udsendelser og film til flere profiler på dette Apple TV. Hvis du skjuler gruppeanbefalinger, vises der kun anbefalinger for en enkelt profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Für euch alle“ empfiehlt TV-Sendungen und Filme für mehrere Profile auf diesem Apple TV. Wenn du diese Option für Gruppenempfehlungen ausblendest, werden nur Empfehlungen für ein Profil angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τμήμα «Για όλους» προτείνει τηλεοπτικές εκπομπές και ταινίες για πολλά προφίλ σε αυτό το Apple TV. Αν αποκρύψετε αυτήν την επιλογή για τις συστάσεις ομάδας, θα παρέχονται συστάσεις μόνο για ένα προφίλ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For All of You recommends TV shows and movies for multiple profiles on this Apple TV. If you hide this option for group recommendations, it will offer recommendations for just one profile."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "For All of You recommends TV shows and movies for multiple profiles on this Apple TV. If you hide this option for group recommendations, it will offer recommendations for just one profile."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For All of You recommends TV shows and movies for multiple profiles on this Apple TV. If you hide this option for group recommendations, it will offer recommendations for just one profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En “Para todos los usuarios” se recomiendan series y películas para los distintos perfiles de este Apple TV. Si ocultas esta opción de recomendaciones de grupo, solo se ofrecerán recomendaciones para un perfil."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todo el mundo recomendará programas de TV y películas para varios perfiles de este Apple TV. Si ocultas esta opción para las recomendaciones del grupo, se mostrarán recomendaciones para un solo perfil."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todo el mundo recomendará programas de TV y películas para varios perfiles de este Apple TV. Si ocultas esta opción para las recomendaciones del grupo, se mostrarán recomendaciones para un solo perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teille kaikille -osiossa suositellaan TV-ohjelmia ja elokuvia useille tämän Apple TV:n profiileille. Jos kätket tämän vaihtoehdon ryhmäsuosituksille, se tarjoaa suosituksia vain yhdelle profiilille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pour tout le monde » recommandera des séries TV et des films à tous les profils de cette Apple TV. Si vous masquez cette option pour les recommandations de groupe, les recommandations seront émises pour un seul profil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pour vous tous » recommande des émissions de télévision et des films à plusieurs profils de cette Apple TV. Si vous masquez cette option pour les recommandations de groupe, un seul profil recevra des recommandations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאפיין ״עבור כולכם״ מציע תוכניות טלוויזיה וסרטים לפרופילים מרובים ב‑Apple TV זה. הסתרת אפשרות זו להמלצות קבוצתיות תוביל לקבלת המלצות עבור פרופיל אחד בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“आप सभी के लिए” इस Apple TV पर कई प्रोफ़ाइल के लिए टीवी कार्यक्रम और फ़िल्मों की अनुशंसा करता है। अगर आप सामूहिक अनुशंसाओं के लिए इस विकल्प को छिपा देते हैं, तो यह केवल एक प्रोफ़ाइल के लिए अनुशंसाएँ देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U kategoriji “Za sve vas” naći ćete preporučene TV emisije i filmove za više profila na ovom Apple TV-u. Ako sakrijete ovu opciju za grupne preporuke, nudit će se preporuke samo za jedan profil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mindenki számára szakasz tv-műsorokat és filmeket ajánl több profil számára ezen az Apple TV‑n. Ha elrejti ezt a csoportajánlásokra vonatkozó lehetőséget, akkor csak egy profilra vonatkozóan fognak megjelenni ajánlások."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk Kalian merekomendasikan acara TV dan film untuk beberapa profil di Apple TV ini. Jika Anda sembunyikan untuk rekomendasi grup, pilihan ini hanya akan menawarkan rekomendasi untuk satu profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionando “Scelti per voi”, su Apple TV verranno suggeriti programmi TV e film per più profili. Nascondendo i suggerimenti di gruppo, verranno suggeriti contenuti solo per un singolo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“メンバー全員”では、このApple TV上の複数のプロフィールに合わせて、おすすめのテレビ番組や映画が表示されます。グループへのおすすめを非表示にした場合、おすすめが行われるのは1つのプロフィールだけになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘모두를 위한 추천’은 이 Apple TV의 여러 프로필에게 TV 프로그램 및 영화를 추천합니다. 그룹 추천에 대해 이 옵션을 가리면 하나의 프로필만을 위해 추천 항목이 제공됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk Anda Semua mengesyorkan rancangan TV dan filem untuk berbilang profil pada Apple TV ini. Jika anda menyembunyikan pilihan ini untuk pengesyoran kumpulan, ia akan menawarkan pengesyoran untuk hanya satu profil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«For alle sammen» anbefaler filmer og TV-programmer for flere profiler på Apple TV. Hvis du skjuler dette valget for gruppeanbefalinger, blir det kun vist anbefalinger for én profil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met 'Voor iedereen' worden tv-programma's en films aanbevolen voor meerdere profielen op deze Apple TV. Als je deze optie verbergt voor groeps­aanbevelingen, worden er aanbevelingen voor één profiel gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Dla wszystkich poleca programy TV i filmy dla wielu profili tego Apple TV. Jeśli nie używasz rekomendacji dla całej grupy, polecane rzeczy dotyczą tylko jednego profilu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso Para Vocês recomenda programas de TV e filmes para vários perfis desta Apple TV. Se você ocultar essa opção para recomendações em grupo, elas serão oferecidas apenas para um perfil."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Para todos” apresenta recomendações de programas de TV e filmes para vários perfis desta Apple TV. Se ocultar esta opção para o grupo, serão feitas recomendações apenas para um perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pentru toți utilizatorii” recomandă emisiuni TV și filme pentru mai multe profiluri de pe acest Apple TV. Dacă ascundeți această opțiune pentru recomandările de grup, veți primi recomandări pentru un singur profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Для всех» собраны сериалы, фильмы и телешоу, которые могут подойти сразу нескольким профилям на этом Apple TV. Если выключить рекомендации контента для группы, они будут составляться только для одного профиля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V riadku „Pre vás všetkých“ sa zobrazujú odporúčané seriály a filmy pre viaceré profily tohto Apple TV. Ak túto možnosť pre skupinové odporúčania skryjete, ponúkané budú odporúčania len pre jeden profil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V razdelku Za vse vas so priporočila TV-oddaj in filmov za več profilov v tem Apple TV-ju. Če to možnost za skupinska priporočila skrijete, bodo prikazana priporočila samo za en profil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För er alla rekommenderar TV-program och filmer för flera profiler på denna Apple TV. Om du gömmer det här alternativet för grupprekommendationer visas bara rekommendationer för en profil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“สำหรับทุกคน” แนะนำรายการทีวีและภาพยนตร์สำหรับหลายโปรไฟล์บน Apple TV เครื่องนี้ ถ้าคุณซ่อนตัวเลือกนี้สำหรับคำแนะนำกลุ่ม “สำหรับทุกคน” จะเสนอคำแนะนำสำหรับหนึ่งโปรไฟล์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepiniz İçin, bu Apple TV’de birden fazla profile TV şovu ve film önerir. Grup önerileri için bu seçeneği gizlerseniz yalnızca bir profil için öneriler sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У розділі «Для всіх вас» зʼявляються фільми й телешоу, рекомендовані для кількох профілів цього Apple TV. Якщо приховати цей параметр для групових рекомендацій, рекомендації пропонуватимуться тільки для одного профілю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn Dành cho tất cả đề xuất các chương trình TV và phim cho nhiều hồ sơ trên Apple TV này. Nếu bạn ẩn tùy chọn này cho các đề xuất nhóm thì tùy chọn sẽ chỉ đưa ra các đề xuất cho một hồ sơ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“为所有人推荐”会为这台Apple TV上的多个个人资料推荐电视节目和电影。如果你隐藏此群组推荐选项，将只为一个个人资料提供推荐内容。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「為所有人推薦」會為此Apple TV上的多個個人檔案推薦電視節目和電影。如你為群組推薦項目隱藏此選項，其將只為一個個人檔案提供推薦。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「為所有人推薦」會為此Apple TV上的多個個人檔案推薦電視節目和電影。若你對群組推薦項目隱藏此選項，則只會提供推薦項目給單一個人檔案。"
          }
        }
      }
    },
    "AccountsUserIncomingCallsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بإمكان Apple TV أن يعرض لك من يتصل بك على iPhone ويسمح لك بتعليق المكالمة إلى أن تتمكن من الرد، أو الرد إذا كنت قد وصَّلت HomePods."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV et pot mostrar qui t’està trucant a l’iPhone i posar la trucada en espera fins que puguis respondre. També pots respondre des del HomePod."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple TV se může ukazovat, kdo vám volá na iPhone, a vy na ní můžete hovor přidržet, dokud ho nebudete moct přijmout. Pokud máte připojené HomePody, můžete ho na Apple TV i přijmout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV kan vise, hvem der ringer til din iPhone, og du kan sætte opkaldet på hold, indtil du kan besvare det, eller du kan besvare opkaldet, hvis du har nogen tilsluttede HomePod-enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV kann dir anzeigen, wer auf deinem iPhone anruft, und den Anruf halten, bis du antworten kannst, oder ihn annehmen, wenn HomePods verbunden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV μπορεί να εμφανίζει ποιο άτομο σάς καλεί στο iPhone σας και σας επιτρέπει είτε να θέσετε την κλήση σε αναμονή έως ότου μπορέσετε να απαντήσετε είτε να απαντήσετε στην κλήση αν έχετε συνδεδεμένα HomePod."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer or answer if you have connected HomePods."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer, or answer if you have connected HomePod speakers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer, or answer if you have connected HomePods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrar quién te llama al iPhone y poner la llamada en espera hasta que puedas contestar, o bien permitirte contestar si tienes algún HomePod conectado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrarte quién te llama al iPhone y permitirte poner la llamada en espera hasta que puedas contestar. También puedes contestarla si tienes algún HomePod conectado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrarte quién te llama al iPhone y permitirte poner la llamada en espera hasta que puedas contestar. También puedes contestarla si tienes algún HomePod conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV voi näyttää, kuka soittaa iPhoneesi, ja asettaa puhelun pitoon, kunnes voit vastata. Voit myös vastata, jos sinulla on yhdistetty HomePod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV peut vous indiquer qui appelle votre iPhone et vous permettre de mettre l’appel en attente jusqu’à ce que vous puissiez y répondre ou de répondre si vous avez connecté un HomePod."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV peut afficher qui appelle votre iPhone et vous permettre de mettre l’appel en attente ou d’y répondre si des HomePod sont connectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יכול להראות לך מי מתקשר ל-iPhone שלך ולהעביר את השיחה למצב המתנה עד שיתאפשר לך לענות בטלפון או דרך מכשירי HomePods מחוברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV आपको दिखा सकता है कि आपके iPhone पर कौन कॉल कर रहा है और जब तक आप कॉल का जवाब नहीं दे सकते हैं तब तक कॉल को होल्ड पर रखने या अगर आपके पास कनेक्टेड HomePod हैं, तो जवाब देने की सुविधा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV može prikazati dolazne pozive na vašem iPhoneu i omogućiti vam stavljanje poziva na čekanje dok se ne javite ili omogućiti javljanje ako imate spojene HomePod zvučnike."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV‑je meg tudja jeleníteni, hogy ki hívja Önt az iPhone‑ján, és lehetővé teszi, hogy Ön várakoztassa a hívást, amíg készen áll a hívás fogadására, vagy fogadja a hívást, ha HomePodok vannak csatlakoztatva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda dapat menampilkan siapa yang sedang menelepon di iPhone Anda dan memungkinkan Anda untuk menahan panggilan hingga diangkat atau mengangkatnya jika Anda telah menghubungkan HomePods."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV può mostrarti chi ti sta chiamando su iPhone e consentirti di mettere in attesa la chiamata finché non puoi rispondere, oppure di rispondere se hai connesso un HomePod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVで、iPhoneにかかってきた電話の発信元を表示し、応答するまで通話を保留にすることができます。HomePodを接続している場合は、Apple TVで直接応答することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV에서 iPhone으로 걸려오는 전화의 발신자를 확인하고, 전화를 받을 수 있는 시점까지 통화를 대기할 수 있습니다. HomePod을 연결한 경우에는 전화를 받을 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda boleh menunjukkan kepada anda pemanggil pada iPhone anda dan membolehkan anda menahan panggilan sehingga anda boleh menjawab atau menjawab jika anda mempunyai HomePod bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-en din kan vise deg hvem som ringer til iPhonen din, og la deg sette samtalen på vent til du kan svare eller svare hvis du har tilkoblede HomePoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV kan je laten zien door wie je op je iPhone wordt gebeld en kan het gesprek in de wacht plaatsen totdat je de oproep kunt beantwoorden of het gesprek beantwoorden als je HomePods hebt gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV może pokazywać połączenia przychodzące na Twojego iPhone’a i wstrzymywać je, aby dać Ci czas na odebranie ich na telefonie lub na połączonych HomePodach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode mostrar quem está ligando para o seu iPhone e permitir que você mantenha a ligação em espera até que possa atender, ou permitir que você atenda se tiver HomePods conectados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode mostrar quem está a ligar para o seu iPhone e permitir‑lhe colocar a chamada em espera até que a possa atender, ou pode atender a chamada se tiver HomePods ligados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul poate afișa cine vă apelează pe iPhone și vă poate permite să rețineți apelul până când puteți răspunde sau să răspundeți dacă aveți HomePod‑uri conectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если подключить устройства HomePod к Apple TV, на нем можно будет просматривать уведомления о входящих вызовах на iPhone, отвечать на них или ставить на удержание, когда нет возможности ответить сразу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vám niekto volá na iPhone, Apple TV môže zobraziť volajúceho a umožní vám hovor podržať, kým sa nedostanete k telefónu, prípadne prijať hovor na pripojenom HomePode."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Apple TV-ju je lahko prikazano, čigav klic ste prejeli v iPhone, pri čemer lahko klic postavite na čakanje, dokler ga ne morete sprejeti, ali pa ga sprejmete, če imate povezane zvočnike HomePod."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan visa vem som ringer till iPhone och låta dig parkera samtalet tills du kan svara, eller så kan du svara om du har anslutna HomePod-enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณสามารถแสดงให้คุณดูได้ว่าใครกำลังโทรมาบน iPhone ของคุณและช่วยให้คุณพักสายไว้จนกว่าคุณจะสามารถรับสายได้หรือรับสายหากคุณมี HomePod ที่เชื่อมต่ออยู่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz, iPhone’unuzda kimin aradığını gösterip yanıtlayabileceğiniz zamana kadar aramayı beklemeye almanızı veya bağlı HomePod’larınız varsa yanıtlamanızı sağlayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV може показувати, хто телефонує вам на iPhone, і давати змогу призупиняти виклик, доки ви не зможете відповісти, або відповідати, якщо підʼєднано HomePod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV có thể hiển thị ai đang gọi đến iPhone của bạn và cho phép bạn giữ cuộc gọi đến khi có thể trả lời hoặc trả lời nếu bạn đã kết nối các HomePod."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可显示iPhone上的来电者，并保留通话直至你方便接听，或在已连接的HomePod上接听。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV可以顯示iPhone上的來電者，並讓你保留通話直到你可以接聽，或在已連接的HomePod上接聽。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可以顯示iPhone上的來電者，並讓你在可接聽前保留通話，或在有已連接的HomePods時接聽。"
          }
        }
      }
    },
