    "VPNOTAWarningDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تفشل تحديثات برامج Apple TV عندما يكون \"%@\" هو تكوين VPN النشط.\n\nحدد \"AppleConnect\" على أنه تكوين VPN للسماح بتحديثات البرامج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la configuració de VPN activa és “%@”, és possible que les actualitzacions de programari de l’Apple TV fallin.\n\nPer permetre les actualitzacions de programari, selecciona la configuració de VPN “AppleConnect”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při aktivní konfiguraci VPN „%@“ může aktualizace softwaru Apple TV selhat.\n\nChcete‑li umožnit aktualizaci softwaru, vyberte konfiguraci VPN „AppleConnect“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-softwareopdateringer kan mislykkes, når “%@” er den aktive VPN-konfiguration.\n\nVælg VPN-konfigurationen “AppleConnect” for at tillade softwareopdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softwareupdates für Apple TV können fehlschlagen, wenn die aktive VPN-Konfiguration „%@“ ist.\n\nWähle die VPN-Konfiguration „AppleConnect“ aus, um Softwareupdates zu ermöglichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ενημερώσεις λογισμικού του Apple TV ενδέχεται να αποτύχουν, ενόσω το «%@» είναι η ενεργή διαμόρφωση VPN.\n\nΕπιλέξτε τη διαμόρφωση VPN «AppleConnect» για να επιτρέπονται οι ενημερώσεις λογισμικού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Software Updates may fail while “%@” is the active VPN configuration.\n\nSelect the “AppleConnect” VPN configuration to allow Software Updates."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Software Updates may fail while “%@” is the active VPN configuration.\n\nSelect the “AppleConnect” VPN configuration to allow Software Updates."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Software Updates may fail while “%@” is the active VPN configuration.\n\nSelect the AppleConnect VPN configuration to allow Software Updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que las actualizaciones de software del Apple TV no funcionen si la configuración VPN activa es “%@”.\n\nSelecciona la configuración de VPN “AppleConnect” para permitir las actualizaciones de software."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la configuración VPN activa es “%@”, podría ocurrir un error en las actualizaciones de software del Apple TV.\n\nSelecciona la configuración VPN “AppleConnect” para permitir las actualizaciones de software."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la configuración VPN activa es “%@”, podría ocurrir un error en las actualizaciones de software del Apple TV.\n\nSelecciona la configuración VPN “AppleConnect” para permitir las actualizaciones de software."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV -ohjelmistopäivitys saattaa epäonnistua, kun %@ on aktiivinen VPN-määritys.\n\nSalli ohjelmistopäivitykset valitsemalla VPN-määritykseksi AppleConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour du logiciel de l’Apple TV peuvent échouer lorsque « %@ » est la configuration VPN active.\n\nSélectionnez la configuration VPN « AppleConnect » pour autoriser les mises à jour du logiciel."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour logicielles de l’Apple TV peuvent échouer lorsque la configuration VPN active est « %@ ».\n\nSélectionnez la configuration VPN « AppleConnect » pour autoriser les mises à jour logicielles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכוני תוכנת ה-Apple TV עלולים להיכשל כל עוד ״%@״ היא תצורת ה-VPN הפעילה.\n\nיש לבחור את תצורת ה-VPN‏ AppleConnect כדי לאפשר עדכוני תוכנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” के सक्रिय VPN कॉन्फ़िगरेशन होने पर हो सकता है कि Apple TV सॉफ़्टवेयर अपडेट विफल हो जाएँ।\n\nसॉफ़्टवेयर अपडेट करने की अनुमति देने के लिए “AppleConnect” VPN कॉन्फ़िगरेशन चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranja softvera Apple TV-a možda se neće moći instalirati dok je “%@” aktivna VPN konfiguracija.\n\nOdaberite VPN konfiguraciju “AppleConnect” kako biste dozvolili ažuriranja softvera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfordulhat, hogy az Apple TV szoftverfrissítései meghiúsulnak, amikor a(z) „%@” az aktív VPN-konfiguráció.\n\nHa lehetővé szeretné tenni a szoftverfrissítéseket, válassza ki az „AppleConnect” VPN-konfigurációt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan Perangkat Lunak Apple TV mungkin gagal saat “%@” merupakan konfigurasi VPN yang aktif.\n\nPilih konfigurasi VPN “AppleConnect” untuk mengizinkan Pembaruan Perangkat Lunak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti software per Apple TV potrebbero non riuscire quando è attiva la configurazione VPN “%@”.\n\nSeleziona la configurazione VPN AppleConnect per consentire gli aggiornamenti software."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN構成で“%@”が動作中になっているとApple TVのソフトウェアアップデートを実行できない可能性があります。\n\nソフトウェアアップデートを許可するには“AppleConnect”というVPN構成を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’이(가) 활성화된 VPN 구성인 경우 Apple TV 소프트웨어 업데이트에 실패할 수 있습니다.\n\n소프트웨어 업데이트를 허용하려면 ‘AppleConnect’ VPN 구성을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas Kini Perisian Apple TV mungkin gagal semasa “%@” menjadi konfigurasi VPN aktif.\n\nPilih konfigurasi VPN “AppleConnect” untuk membenarkan Kemas Kini Perisian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-programvaren vil kanskje ikke kunne oppdateres så lenge «%@» er den aktive VPN-konfigurasjonen.\n\nVelg VPN-konfigurasjonen «AppleConnect» for å tillate oppdateringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-updates voor de Apple TV worden mogelijk niet geïnstalleerd wanneer '%@' de actieve VPN-configuratie is.\n\nSelecteer de VPN-configuratie 'AppleConnect' om software-updates toe te staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnianie oprogramowania Apple TV może być niemożliwe, gdy aktywna konfiguracja VPN to „%@”.\n\nAby pozwolić na uaktualnianie oprogramowania, wybierz konfigurację VPN „AppleConnect”."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Atualizações de Software da Apple TV podem falhar quando “%@” for a configuração de VPN ativa.\n\nPara permitir Atualizações de Software, selecione a configuração de VPN “AppleConnect”."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações de software da Apple TV poderão falhar enquanto “%@” for a configuração de VPN ativa.\n\nSelecione a configuração de VPN “AppleConnect” para permitir atualizações de software."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil ca actualizările software pentru Apple TV să nu reușească în timp ce configurația VPN activă este „%@”.\n\nPentru a permite actualizările software, selectați configurația VPN „AppleConnect”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда активна конфигурация VPN «%@», при обновлении Apple TV может произойти сбой.\n\nЧтобы разрешить обновления ПО, выберите конфигурацию VPN «AppleConnect»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri aktívnej konfigurácii VPN „%@“ môže aktualizácia softvéru Apple TV zlyhať.\n\nAk chcete povoliť aktualizácie softvéru, vyberte konfiguráciu VPN „AppleConnect“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posodobitve programske opreme Apple TV morda ne bodo uspele, če je »%@« aktivna konfiguracija VPN.\n\nIzberite konfiguracijo VPN »AppleConnect«, da dovolite posodobitve programske opreme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-programuppdateringar kan misslyckas när ”%@” är den aktiva VPN-konfigurationen.\n\nTillåt programuppdateringar genom att välja VPN-konfigurationen ”AppleConnect”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการอัปเดตซอฟต์แวร์ Apple TV อาจไม่สำเร็จในระหว่างที่การกำหนดค่า VPN “%@” ทำงานอยู่\n\nเลือกการกำหนดค่า VPN “AppleConnect” เพื่ออนุญาตรายการอัปเดตซอฟต์แวร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” etkin VPN konfigürasyonuyken Apple TV Yazılım Güncellemeleri başarısız olabilir.\n\nYazılım Güncellemeleri’ne izin vermek için “AppleConnect” VPN konfigürasyonunu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення ПЗ Apple TV можуть не працювати, якщо «%@» є активною VPN-конфігурацією.\n\nЩоб дозволити оновлення ПЗ, виберіть VPN-конфігурацію «AppleConnect»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật phần mềm Apple TV có thể không thực hiện được trong khi “%@” là cấu hình VPN đang hoạt động.\n\nHãy chọn cấu hình VPN “AppleConnect” để cho phép cập nhật phần mềm."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”为活跃VPN配置时，Apple TV软件更新可能失败。\n\n选择“AppleConnect” VPN配置以允许软件更新。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」為已啟用的VPN設定期間，Apple TV軟件更新可能會失敗。\n\n選擇「AppleConnect」VPN設定以允許「軟件更新」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV軟體更新可能失敗，因為「%@」為現用的VPN設定。\n\n選取「AppleConnect」VPN設定來允許「軟體更新」。"
          }
        }
      }
    },
