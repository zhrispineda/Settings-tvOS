    "AXSubtitlesWhenMutedDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تشغيل الترجمة تلقائيًا عند كتم مستوى الصوت أو خفضه إلى أدنى مستوى.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Activa els subtítols automàticament si el volum està al mínim o en silenci.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Automaticky zapne titulky, když vypnete nebo úplně zeslabíte zvuk.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Slå automatisk undertekster til, når lyden er slået fra, eller der er skruet helt ned for lydstyrken.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Untertitel werden automatisch aktiviert, wenn die Lautstärke stummgeschaltet oder ganz leise gestellt ist.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αυτόματη ενεργοποίηση υπότιτλων όταν η ένταση του ήχου έχει μειωθεί πλήρως ή είναι σε σίγαση.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Automatically turn on subtitles when the volume is muted or turned all the way down.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Automatically turn on subtitles when the volume is muted or turned all the way down.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Automatically turn on subtitles when the volume is muted or turned all the way down.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Automatically turn on subtitles when the volume is muted or turned all the way down.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Automatically turn on subtitles when the volume is muted or turned all the way down.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Los subtítulos se activarán automáticamente cuando el volumen se baje al mínimo o se silencie.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Activa automáticamente los subtítulos cuando el volumen está silenciado o al mínimo.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Activa automáticamente los subtítulos cuando el volumen está silenciado o al mínimo.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Laita tekstitys päälle automaattisesti, kun ääni on mykistetty tai hiljennetty kokonaan.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Activez automatiquement les sous-titres lorsque le son est coupé ou que le volume est baissé au minimum.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Active automatiquement les sous-titres lorsque le son est coupé ou au minimum.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להפעיל כתוביות באופן אוטומטי כשהשמע מושתק או כשהעוצמה שלו מונמכת עד הסוף.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "जब वॉल्यूम को म्यूट किया जाता है या पूरी तरह से कम किया जाता है, तो सबटाइटल ऑटोमैटिकली चालू हो जाते हैं।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Automatsko uključenje titlova kad je glasnoća isključena ili sasvim stišana.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Automatikusan bekapcsolja a feliratokat, amikor a hangerő némítva van, vagy teljesen le van halkítva.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Nyalakan subtitle secara otomatis saat volume dibisukan atau dikecilkan sepenuhnya.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Attiva automaticamente i sottotitoli quando l’audio è disattivato o il volume è al minimo.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "消音時または音量がゼロに下げられているときに自動的に字幕をオンにします。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "소리가 꺼져 있거나 음량이 최소인 경우 자동으로 자막을 켭니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Aktifkan sari kata secara automatik apabila kelantangan disenyapkan atau diturunkan sepenuhnya.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Ondertiteling wordt automatisch ingeschakeld wanneer het volume is gedempt of helemaal uit staat.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Slå automatisk på undertekster når lyden slås av eller skrus helt ned.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Automatycznie włączaj napisy, gdy dźwięk jest wyciszony lub maksymalnie ściszony.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Ative automaticamente as legendas quando o volume for silenciado ou estiver no mínimo.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Ativar as legendas automaticamente quando o volume estiver desativado ou no mínimo.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Subtitrările vor fi activate automat când volumul sunetului este tăiat sau dat complet la minim.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Субтитры включаются автоматически, если звук выключен или громкость уменьшена до нуля.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Automaticky zapne titulky pri vypnutí alebo úplnom zoslabení zvuku.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Omogočite samodejen prikaz podnapisov, ko je zvok izklopljen ali povsem utišan.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Slå på undertexter automatiskt när volymen är avstängd eller på lägsta möjliga nivå.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เปิดใช้คำบรรยายโดยอัตโนมัติเมื่อระดับเสียงถูกปิดหรือถูกลดระดับลงทั้งหมด",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Ses kapalıyken veya tamamen kısıkken altyazıları otomatik olarak açar.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Автоматично вмикати субтитри, якщо гучність вимкнено або зведено до мінімуму.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Tự động bật phụ đề khi tắt tiếng hoặc âm lượng được giảm hết mức.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "静音或音量调到最低时自动打开字幕。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "當音量為靜音或已調到最低時，自動開啟字幕。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
