    "APSecurityHomeInvalidPasswordAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى اختيار كلمة سر أقوى تتكون من ٦ أحرف على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una contrasenya més difícil d’endevinar que tingui almenys 6 caràcters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte silnější heslo o délce alespoň 6 znaků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en stærkere adgangskode på mindst 6 tegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein sichereres Passwort mit mindestens 6 Zeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα ισχυρότερο συνθηματικό που περιέχει τουλάχιστον 6 χαρακτήρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select a stronger password of at least 6 characters."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select a stronger password of at least six characters."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select a stronger password of at least 6 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una contraseña más segura con un mínimo de 6 caracteres."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una contraseña más segura de por lo menos 6 caracteres."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una contraseña más segura de por lo menos 6 caracteres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse vahvempi salasana, jossa on vähintään 6 merkkiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez choisir un mot de passe plus complexe comportant au moins 6 caractères."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez choisir un mot de passe plus robuste comportant au moins 6 caractères."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נא לבחור סיסמה חזקה יותר שמכילה לפחות 6 תווים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया कम से कम 6 वर्णों का मज़बूत पासवर्ड चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite snažniju lozinku od najmanje 6 znakova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, válasszon erősebb jelszót, amely legalább 6 karakterből áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata sandi yang lebih kuat dengan jumlah karakter setidaknya 6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una password più sicura e includi almeno 6 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半角英数字6文字以上の強力なパスワードを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어도 6자 이상의 더 강력한 암호를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila pilih kata laluan yang lebih kukuh dengan sekurang-kurangnya 6 aksara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et sterkere passord på minst 6 tegn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een sterker wachtwoord dat minimaal 6 tekens bevat."
