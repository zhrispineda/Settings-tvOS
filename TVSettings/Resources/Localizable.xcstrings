          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã yêu cầu truy cập ảnh của bạn sẽ xuất hiện tại đây."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此处会显示要求访问照片的App。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此處會顯示曾要求使用相片的App。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
