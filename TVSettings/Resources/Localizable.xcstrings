    "LanguageUnsavedChangesWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك تغييرات لم يتم حفظها. هل ترغب بالتأكيد في استبعادها دون حفظها؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has fet canvis que no s’han desat. Confirmes que vols descartar‑los sense desar‑los?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuložili jste provedené změny. Určitě je chcete zahodit bez uložení?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ændringer, der ikke er blevet gemt. Er du sikker på, at du vil slette dem uden at gemme dem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast nicht gesicherte Änderungen. Möchtest du sie wirklich verwerfen, ohne sie zu sichern?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε μη αποθηκευμένες αλλαγές. Θέλετε σίγουρα να απορριφθούν χωρίς αποθήκευση;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved changes. Are you sure you want to discard them without saving them?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved changes. Are you sure you want to discard them without saving them?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved changes. Are you sure you want to discard them without saving?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cambios sin guardar. ¿Seguro que quieres descartarlos?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cambios sin guardar. ¿Quieres descartarlos sin haberlos guardado?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cambios sin guardar. ¿Quieres descartarlos sin haberlos guardado?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on tallentamattomia muutoksia. Hylätäänkö ne tallentamatta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications n’ont pas été enregistrées. Voulez-vous vraiment les annuler sans les enregistrer ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications n’ont pas été enregistrées. Voulez-vous vraiment les annuler sans les enregistrer?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש שינויים שלא נשמרו. האם ברצונך לבטל את השינויים בלי לשמור אותם?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास सहेजे नहीं गए बदलाव हैं। क्या आप निश्चित हैं कि आप उन्हें सहेजे बिना ही ख़ारिज करना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imate nespremljene promjene. Sigurno ih želite odbaciti bez spremanja?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vannak nem mentett módosításai. Biztosan elveti a módosításokat anélkül, hogy mentené őket?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memiliki perubahan yang belum disimpan. Apakah Anda yakin ingin membuangnya tanpa menyimpannya?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune modifiche non sono state salvate. Confermi di non volerle salvare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない変更があります。保存せずに変更内容を破棄してもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 변경 사항이 있습니다. 변경 사항을 저장하지 않고 폐기하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mempunyai perubahan yang belum disimpan. Adakah anda pasti mahu membuangnya tanpa menyimpan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endringer som ikke er arkivert. Er du sikker på at du vil forkaste dem?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt niet-bewaarde wijzigingen. Weet je zeker dat je deze wilt verwijderen zonder ze te bewaren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz niezachowane zmiany. Czy na pewno chcesz je odrzucić bez zachowywania?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem alterações não salvas. Tem certeza de que quer descartá-las sem salvar?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem alterações por guardar. Tem a certeza de que pretende eliminar as alterações sem as guardar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aveți modificări nesalvate. Sigur doriți să le abandonați fără a le salva?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения не были сохранены. Вы действительно хотите отменить их без сохранения?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte neuložené zmeny. Naozaj ich chcete zahodiť bez uloženia?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imate neshranjene spremembe. Ste prepričani, da jih želite zavreči, ne da bi jih shranili?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ändringar som inte har sparats. Är du säker på att du vill radera dem utan att spara dem?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมีการแก้ไขที่ไม่ได้บันทึก คุณแน่ใจหรือไม่ว่าคุณต้องการทิ้งการแก้ไขเหล่านั้นโดยไม่ต้องบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş değişiklikleriniz var. Bunları kaydetmeden vazgeçmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є незбережені зміни. Справді відхилити їх без збереження?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có các thay đổi chưa lưu. Bạn có chắc chắn muốn hủy bỏ mà không lưu chúng không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你有未保存的更改。确定不保存并放弃更改吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你有未儲存的變更。你確定不儲存並捨棄這些變更嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你有未儲存的更動。確定不儲存並捨棄這些更動嗎？"
          }
        }
      }
    },
