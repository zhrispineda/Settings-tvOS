    "AccountsAddAdditionalUserProfileDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ملف تعريف جديد إلى هذا الـ Apple TV ليتمكن من الوصول إلى ما يخصه من البرامج والأفلام و\"متابعة المشاهدة\" وبيانات التطبيقات في iCloud وحساب Game Center."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un perfil nou a l’Apple TV per accedir a les seves sèries i pel·lícules, al contingut de la llista “Continua mirant”, a les dades de les apps desades a l’iCloud i al compte del Game Center."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když do Apple TV přidáte nový profil, budete mít přístup k jeho seriálům, filmům, k seznamu Pokračovat ve sledování, k datům aplikací na iCloudu a k účtu v Game Centru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Føj en ny profil til dette Apple TV for at få adgang til udsendelser, film, Se videre og appdata i brugerens iCloud og Game Center-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein neues Profil zu diesem Apple TV hinzu, damit Personen auf die zugehörigen Sendungen, Filme, „Weiter ansehen“-Listen, App-Daten in iCloud und Game Center-Account zugreifen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα νέο προφίλ σε αυτό το Apple TV για πρόσβαση στις εκπομπές, τις ταινίες, τη Συνέχιση παρακολούθησης, τα δεδομένα εφαρμογών στο iCloud και τον λογαριασμό Game Center του χρήστη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new profile to this Apple TV to access their shows, movies, Continue Watching, app data in iCloud, and Game Center account."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new profile to this Apple TV to access their shows, movies, Continue Watching, app data in iCloud and Game Center account."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new profile to this Apple TV to access their shows, movies, Continue Watching, app data in iCloud and Game Center account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un nuevo perfil a este Apple TV para acceder a sus series y películas, al contenido de su lista “Seguir viendo”, a los datos de sus apps en iCloud y a su cuenta de Game Center."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un nuevo perfil a este Apple TV para acceder a sus programas, películas, lista Seguir viendo, datos de apps en iCloud y cuenta de Game Center."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un nuevo perfil a este Apple TV para acceder a sus programas, películas, lista Seguir viendo, datos de apps en iCloud y cuenta de Game Center."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tähän Apple TV:hen uusi profiili, jotta voit käyttää sen ohjelmia, elokuvia, Jatka katsomista -sisältöä, iCloudissa olevaa appidataa ja Game Center -tiliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un nouveau profil à cette Apple TV pour accéder à ses séries, ses films, sa liste « Continuer à regarder », ses données d’apps stockées sur iCloud, et son compte Game Center."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un nouveau profil à cette Apple TV pour accéder à ses émissions, à ses films, à sa liste « Continuer à regarder », aux données d’apps provenant d’iCloud, et à son compte Game Center."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להוסיף פרופיל חדש ל-Apple TV זה כדי לאפשר למשתמשים לגשת לתוכניות, לסרטים, לתכנים ב״המשך הצפייה״, לנתוני היישומים ב-iCloud ולחשבון ה-Game Center שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV पर नई प्रोफ़ाइल जोड़ें ताकि उनके कार्यक्रम, फ़िल्में, देखना जारी रखें, iCloud में ऐप डेटा और Game Center खाता ऐक्सेस किए जा सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte novi profil na ovaj Apple TV za pristup njegovim emisijama, filmovima, odjeljku Nastavite gledati, podacima aplikacija u iCloudu i Game Center računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáadhat egy új felhasználót ehhez az Apple TV-hez, hogy hozzá tudjon férni a műsoraihoz, filmjeihez, Továbbnézés listájához, iCloudban tárolt appadataihoz és Game Center-fiókjához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan profil baru ke Apple TV ini untuk mengakses acara, film, Lanjutkan Menonton, data app di iCloud, dan akun Game Center mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un nuovo profilo a questa Apple TV per accedere ai suoi programmi, film, contenuti in “Continua a guardare”, dati delle app su iCloud e al suo account di Game Center."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVに新規プロフィールを追加すると、そのユーザの番組、映画、“続きを観る”、iCloudのアプリデータ、Game Centerのアカウントにアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV에 새로운 프로필을 추가하여, 해당 프로필의 프로그램, 영화, ‘계속 보기’, iCloud에 있는 앱 데이터 및 Game Center 계정에 접근할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah profil baharu ke Apple TV ini untuk mengakses rancangan, filem, Teruskan Menonton, data app dalam iCloud dan akaun Game Center mereka."
          }
