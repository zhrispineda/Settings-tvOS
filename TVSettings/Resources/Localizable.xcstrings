    "AccountsAddPrimaryUserBodyText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستخدمون الآخرون على هذا الـ Apple TV سيمكنهم رؤية معلومات الحساب الخاصة بالمستخدم الافتراضي على هذا الجهاز، بما في ذلك الوسائط و Game Center وحساب iCloud المستخدَم لتطبيق الصور و\"تسجيل الدخول باستخدام Apple\" و\"شاشة One الرئيسية\" وتطبيق المنزل من Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La resta d’usuaris de l’Apple TV veuran la informació del compte de l’usuari per omissió al dispositiu, inclosos el contingut multimèdia, el compte del Game Center i el compte de l’iCloud que s’utilitza amb l’app Fotos, l’inici de la sessió amb Apple, l’opció “Una pantalla d’inici” i l’Apple Home."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní uživatelé Apple TV uvidí data na účtu výchozího uživatele zařízení. Tato data zahrnují média, Game Center a účet na iCloudu, který se používá pro aplikaci Fotky a pro funkce Přihlášení přes Apple, Společná plocha a Domácnost Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre brugere på dette Apple TV kan se kontooplysningerne for standardbrugeren på enheden, herunder medier, Game Center og iCloud-kontoen, der bruges til Fotos, Log ind med Apple, Samme hjemmeskærm og Apple Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Benutzer:innen dieses Apple TV sehen die Accountinfos des:der Standardbenutzer:in auf diesem Gerät, einschließlich Medien, Game Center und iCloud-Account, der für „Fotos“, „Mit Apple anmelden“, „Gleicher Home-Bildschirm“ und Apple Home verwendet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άλλοι χρήστες αυτού του Apple TV θα μπορούν να δουν τα στοιχεία λογαριασμού του προεπιλεγμένου χρήστη σε αυτήν τη συσκευή, συμπεριλαμβανομένων των πολυμέσων, του Game Center, και του λογαριασμού iCloud που χρησιμοποιείται για τις Φωτογραφίες, τη Σύνδεση μέσω Apple, τη Μία οθόνη Αφετηρίας και την Οικία Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other users on this Apple TV will see the default user’s account information on this device, including media, Game Center, and the iCloud account used for Photos, Sign in with Apple, One Home Screen, and Apple Home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Other users on this Apple TV will see the default user’s account information on this device, including media, Game Center, and the iCloud account used for Photos, Sign in with Apple, One Home Screen and Apple Home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Other users on this Apple TV will see the default user’s account information on this device, including media, Game Center, and the iCloud account used for Photos, Sign in with Apple, One Home Screen and Apple Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros usuarios del Apple TV verán la información de la cuenta del usuario por omisión en este dispositivo, incluido el contenido multimedia, las cuentas de Game Center y la cuenta de iCloud utilizada para la app Fotos, el inicio de sesión con Apple, la opción “Una pantalla de inicio” y Apple Home."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los otros usuarios de este Apple TV podrán ver la información de la cuenta del usuario predeterminado de este dispositivo incluyendo los contenidos multimedia, Game Center y la cuenta de iCloud que se usa para Fotos, Iniciar sesión con Apple, la pantalla de inicio única y Casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los otros usuarios de este Apple TV podrán ver la información de la cuenta del usuario predeterminado de este dispositivo incluyendo los contenidos multimedia, Game Center y la cuenta de iCloud que se usa para Fotos, Iniciar sesión con Apple, la pantalla de inicio única y Casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut tämän Apple TV:n käyttäjät näkevät oletuskäyttäjän tilitiedot tässä laitteessa, mukaan lukien median, Game Centerin sekä iCloud-tilin, jota käytetään Kuville, Kirjaudu sisään Applella -ominaisuudelle, Yksi Koti-valikko -ominaisuudelle ja Applen Kodille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres utilisateurs de cette Apple TV auront accès aux informations du compte de l’utilisateur par défaut sur cet appareil, y compris ses contenus multimédias, son compte Game Center ainsi que le compte iCloud utilisé pour Photos, « Se connecter avec Apple », « Écran d’accueil unique » et Apple Home."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres utilisateurs de cette Apple TV verront les informations du compte de l’utilisateur par défaut sur cet appareil, y compris le contenu multimédia, les données Game Center et le compte iCloud utilisé avec Photos, Connexion avec Apple, Mon écran d’accueil et Apple Home."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמשים אחרים ב-Apple TV זה יראו את פרטי החשבון של משתמש ברירת המחדל במכשיר זה, כולל נתוני המדיה, נתוני Game Center וחשבון ה-iCloud המשמש עבור ״תמונות״, ״התחברות באמצעות Apple״, ״מסך בית יחיד״ ו-Apple Home."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV के अन्य यूज़र को इस डिवाइस पर डिफ़ॉल्ट यूज़र की खाता जानकारी दिखाई देगी जिसमें मीडिया, Game Center और तस्वीर, Apple से साइन इन करें, एक होम स्क्रीन और Apple Home के लिए इस्तेमाल किया गया iCloud खाता शामिल हो सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi korisnici na ovom Apple TV-u vidjet će informacije o računu standardnog korisnika na ovom uređaju, uključujući medije, Game Center i iCloud račun korišten za fotografije, Prijavu s Appleom, Jedan početni zaslon i Apple Dom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV többi felhasználója látni fogja az alapértelmezett felhasználó fiókadatait ezen az eszközön, többek között a médiatartalmakat, a Game Centert, továbbá a Fotókhoz, a Bejelentkezés az Apple-lel funkcióhoz, az Egy Főképernyő funkcióhoz és az Apple Otthonhoz használt iCloud-fiókot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna lainnya di Apple TV ini akan melihat informasi akun pengguna default di perangkat ini, termasuk media, Game Center, dan akun iCloud pengguna default yang digunakan untuk Foto, Masuk dengan Apple, Satu Layar Utama, dan Rumah Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri utenti su questa Apple TV vedranno le informazioni relative agli account dell’utente di default sul dispositivo, inclusi i file multimediali, Game Center e l’account iCloud utilizzato per Foto, “Accedi con Apple”, Apple Home e la schermata Home unica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVのほかのユーザには、このデバイスのデフォルトユーザのアカウント情報（メディアやGame Center、および、“写真”、“Appleでサインイン”、“1つのホーム画面”、Apple Homeで使用されるiCloudアカウントを含む）が表示されるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV의 다른 사용자가 이 기기에서 미디어, Game Center 등과 같은 기본 사용자의 계정 정보를 볼 수 있습니다. 이 계정 정보에는 사진, ‘Apple로 로그인’, ‘하나의 홈 화면’ 및 Apple 홈에 사용된 iCloud 계정도 포함됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna lain pada Apple TV ini akan melihat maklumat akaun pengguna lalai pada peranti ini, termasuk media, Game Center dan akaun iCloud yang digunakan untuk Foto, Daftar masuk dengan Apple, Satu Skrin Utama serta Apple Home."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre brukere på Apple TV vil se kontoinformasjonen til standardbrukeren på enheten, inkludert medier, Game Center og iCloud-kontoen som brukes for Bilder, Logg på med Apple, Felles Hjem-skjerm og Hjem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere gebruikers op deze Apple TV zien de accountinformatie van de standaardgebruiker op dit apparaat, waaronder media, Game Center en de iCloud-account die wordt gebruikt voor Foto's, 'Log in met Apple', 'Eén beginscherm' en Apple Woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inni użytkownicy tego Apple TV będą widzieli zawartość konta użytkownika domyślnego, w tym jego multimedia, konta Game Center i konto iCloud używane przez aplikację Zdjęcia, funkcję logowania się przy użyciu konta Apple, funkcję jednego ekranu głównego i platformę Apple Home."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros usuários desta Apple TV verão as informações da conta do usuário padrão neste dispositivo, incluindo o conteúdo, a conta do Game Center e a conta do iCloud usada para o app Fotos, o Início de Sessão com a Apple, a opção Uma Tela de Início e o Apple Home."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros utilizadores desta Apple TV poderão ver a informação da conta do utilizador predefinido neste dispositivo, incluindo conteúdos multimédia, Game Center e a conta iCloud usada para Fotografias, Iniciar sessão com a Apple, ecrã principal e Apple Home."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alți utilizatori de pe acest Apple TV vor vedea informațiile corespunzătoare contului utilizatorului implicit, inclusiv conținutul multimedia, Game Center și contul de iCloud utilizat pentru Poze, Autentificare cu Apple, Un ecran principal și Locuință Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие пользователи этого Apple TV смогут просматривать сведения учетной записи пользователя по умолчанию на этом устройстве, в том числе медиаконтент, Game Center и учетную запись iCloud, которая используется для функций «Вход с Apple» и «Один экран “Домой”», а также для доступа к приложениям «Фото» и «Дом» от Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní užívatelia Apple TV uvidia informácie z účtu predvoleného užívateľa na tomto zariadení vrátane médií, Game Center a iCloud účtu používaného pre Fotky, Prihlásenie cez Apple, Zjednotenú plochu a Apple Domácnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi uporabniki tega Apple TV-ja bodo videli podatke privzetega uporabniškega računa v tej napravi, vključno s predstavnostno vsebino, računom Game Center in računom iCloud, ki se uporablja za aplikacijo Fotografije, funkciji Vpiši se z računom Apple in En domači zaslon ter Dom Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra användare på denna Apple TV kan se den förvalda användarens kontoinformation på den här enheten, inklusive medier, Game Center och iCloud-kontot som används för Bilder, Logga in med Apple, Samma hemskärm och Hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้อื่นบน Apple TV เครื่องนี้จะเห็นข้อมูลบัญชีของผู้ใช้เริ่มต้นบนอุปกรณ์เครื่องนี้รวมทั้งสื่อ บัญชี Game Center และบัญชี iCloud ที่ใช้สำหรับรูปภาพ การลงชื่อเข้าด้วย Apple หน้าจอโฮมเดียวกัน และ Apple Home"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’deki diğer kullanıcılar, bu aygıtta Fotoğraflar, Apple ile Giriş Yap, Bir Ana Ekran ve Apple Ev için kullanılan iCloud hesabı, Game Center ve ortamlar da dahil olmak üzere saptanmış kullanıcının hesap bilgilerini görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші користувачі цього Apple TV бачитимуть інформацію про обліковий запис типового користувача на цьому пристрої, зокрема медіафайли, дані облікових записів Game Center і облікового запису iCloud, який використовується для Фотографій, Входу з Apple, Єдиного початкового екрана та програми «Дім» від Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người dùng khác trên Apple TV này sẽ nhìn thấy thông tin tài khoản của người dùng mặc định trên thiết bị này, bao gồm phương tiện, Game Center và tài khoản iCloud được sử dụng cho Ảnh, Đăng nhập bằng Apple, Một màn hình chính cũng như Nhà Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这台Apple TV上的其他用户会看到默认用户在此设备上的的账户信息，包括媒体、Game Center以及用于“照片”、“通过Apple登录”、“一个主屏幕”和Apple家庭的iCloud账户。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV的其他用户會在此裝置上看到預設用户的帳户資料，包括媒體、Game Center、以及用於「相片」、「使用Apple登入」、「單一主畫面」和「Apple家居」的iCloud帳户。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV上的其他使用者將可查看此裝置上預設使用者的帳號資訊，包含媒體、Game Center以及用於「照片」、「使用Apple登入」、「單一主畫面」和「Apple家庭」的iCloud帳號。"
          }
        }
      }
    },
