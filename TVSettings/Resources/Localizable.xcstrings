    "AccountsEditUserTapToRepairInstructionsFooter": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تظهر لك رسالة على جهاز iOS أو iPadOS، يرجى إقفال جهازك والمحاولة مرة أخرى. يتطلب ذلك iOS 16 أو iPadOS 16 أو أحدث."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no veus un missatge al dispositiu iOS o iPadOS, bloqueja’l i torna‑ho a provar. Calen com a mínim l’iOS 16 o l’iPadOS 16."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud na svém iOS nebo iPadOS zařízení nevidíte žádnou zprávu, zamkněte ho a zkuste to znovu. Tato funkce vyžaduje iOS 16 či iPadOS 16 nebo novější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ikke ser en besked på din iOS- eller iPadOS-enhed, skal du låse enheden og prøve igen. Kræver iOS 16 eller iPadOS 16 eller en nyere version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn auf deinem iOS- oder iPadOS-Gerät keine Meldung angezeigt wird, sperre dein Gerät und versuche es erneut. Erfordert iOS 16 oder iPadOS 16 oder neuer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν δεν εμφανιστεί μήνυμα στη συσκευή iOS ή iPadOS σας, κλειδώστε τη συσκευή και προσπαθήστε πάλι. Απαιτείται iOS 16 ή iPadOS 16 ή μεταγενέστερη έκδοση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don’t see a message on your iOS or iPadOS device, lock your device and try again. Requires iOS 16 or iPadOS 16 or later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don’t see a message on your iOS or iPadOS device, lock your device and try again. Requires iOS 16 or iPadOS 16 or later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don’t see a message on your iOS or iPadOS device, lock your device and try again. Requires iOS 16 or iPadOS 16 or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no ves un mensaje en tu dispositivo iOS o iPadOS, bloquéalo y vuelve a intentarlo. Se requiere iOS 16, iPadOS 16 o una versión posterior."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se muestra un mensaje en tu dispositivo iOS o iPadOS, bloquéalo y reintenta. Se requiere de iOS 16 o iPadOS 16, o versiones posteriores."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se muestra un mensaje en tu dispositivo iOS o iPadOS, bloquéalo y reintenta. Se requiere de iOS 16 o iPadOS 16, o versiones posteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos et näe viestiä iOS- tai iPadOS -laitteessa, lukitse laite ja yritä uudelleen. Vaatii iOS 16:n tai iPadOS 16:n tai uudemman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun message n’apparaît sur votre appareil iOS ou iPadOS, verrouillez-le et réessayez. iOS 16 ou iPadOS 16 ou ultérieur est nécessaire."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun message ne s’est affiché sur votre appareil iOS ou iPadOS, verrouillez votre appareil, puis réessayez. Cette fonctionnalité requiert iOS 16 ou iPadOS 16, ou une version ultérieure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם לא קיבלת הודעה במכשיר ה-iOS או ה-iPadOS, ניתן לנעול את המכשיר ולנסות שוב. נדרשת גירסת iOS 16 או iPadOS 16 ואילך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको अपने iOS या iPadOS डिवाइस पर कोई संदेश नहीं दिखाई दे रहा है, तो अपना डिवाइस लॉक करें और फिर कोशिश करें। iOS 16 या iPadOS 16 या बाद का संस्करण आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ne vidite poruku na iOS ili iPadOS uređaju, zaključajte uređaj i pokušajte ponovno. Zahtijeva iOS 16 ili iPadOS 16 ili noviji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az iOS- vagy iPadOS-eszközén nem jelenik meg egy üzenet, akkor zárolja az eszközét, majd próbálja újra. A funkcióhoz iOS 16, illetve iPadOS 16 vagy újabb rendszer szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda tidak melihat pesan di perangkat iOS atau iPadOS Anda, kunci perangkat dan coba lagi. Memerlukan iOS 16 atau iPadOS 16 atau lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non visualizzi un messaggio sul tuo dispositivo iOS o iPadOS, bloccalo e riprova. Richiede iOS 16 o iPadOS 16 o versioni successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSまたはiPadOSデバイスにメッセージが表示されない場合は、デバイスをロックしてやり直してみてください。iOS 16以降またはiPadOS 16以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 iOS 또는 iPadOS 기기에 메시지가 보이지 않으면 기기를 잠근 후 다시 시도하십시오. 이 동작은 iOS 16 또는 iPadOS 16 이상이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda tidak melihat mesej pada peranti iOS atau iPadOS anda, kunci peranti anda dan cuba lagi. Memerlukan iOS 16 atau iPadOS 16 atau lebih baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ikke ser noen melding på iOS- eller iPadOS-enheten din, kan du låse enheten og prøve igjen. Krever iOS 16 eller iPadOS 16 eller nyere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je geen bericht op je iOS- of iPadOS-apparaat ziet, vergrendel je je apparaat en probeer je het opnieuw. Hiervoor is iOS 16, iPadOS 16 of nieuwer vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie widzisz wiadomości na urządzeniu iOS lub iPadOS, zablokuj je i spróbuj ponownie. Wymaga systemu iOS 16 lub iPadOS 16 albo nowszego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não vir uma mensagem no dispositivo iOS ou iPadOS, bloqueie o dispositivo e tente novamente. Requer o iOS 16, iPadOS 16 ou versões posteriores."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não vir uma mensagem no seu dispositivo iOS ou iPadOS, bloqueie‑o e volte a tentar. Requer o iOS 16 ou iPadOS 16 ou uma versão posterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă nu vedeți un mesaj pe dispozitivul dvs. iOS sau iPadOS, blocați dispozitivul și reîncercați. Necesită iOS 16 sau iPadOS 16 (sau o versiune ulterioară)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сообщения нет на устройстве iOS или iPadOS, заблокируйте устройство и повторите попытку. Требуется iOS 16 или iPadOS 16 либо более новые версии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa vám na iOS alebo iPadOS zariadení nezobrazila správa, zamknite ho a skúste to znovu. Vyžaduje iOS 16 alebo iPadOS 16, prípadne novší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če ne vidite sporočila v svoji napravi iOS ali iPadOS, jo zaklenite in poskusite znova. Zahtevan je operacijski sistem iOS 16 ali iPadOS 16 oziroma novejša različica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du inte ser något meddelande på din enhet med iOS eller iPadOS låser du den och försöker igen. iOS 16 eller iPadOS 16 eller senare krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณไม่เห็นข้อความบนอุปกรณ์ iOS หรือ iPadOS ของคุณ ให้ล็อคอุปกรณ์ของคุณแล้วลองอีกครั้ง ต้องใช้ iOS 16 หรือ iPadOS 16 ขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS veya iPadOS aygıtınızda bir mesaj görmediyseniz aygıtınızı kilitleyin ve yeniden deneyin. iOS 16 veya iPadOS 16 ya da daha yenisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо повідомлення не зʼявляється на пристрої iOS або iPadOS, замкніть пристрій і спробуйте ще раз. Потрібна iOS 16, iPadOS 16 чи новіших версій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn không thấy thông báo trên thiết bị iOS hoặc iPadOS, hãy khóa thiết bị của bạn và thử lại. Yêu cầu iOS 16 hoặc iPadOS 16 trở lên."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在iOS或iPadOS设备上未看见信息，请锁定设备并重试。要求iOS 16、iPadOS 16或更高版本。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如在iOS或iPadOS裝置上看不到訊息，請鎖上裝置並再試。需要iOS 16或iPadOS 16或以上版本。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若你沒有在iOS或iPadOS裝置上看到訊息，請將你的裝置鎖定並再試一次。需要iOS 16或iPadOS 16或以上版本。"
          }
        }
      }
    },
