    "LanguageInputMethodRequiredMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب طريقة إدخال واحدة على الأقل من أجل %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fer servir aquest idioma (%@), cal com a mínim un mètode d’entrada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro jazyk %@ je požadována aspoň jedna vstupní metoda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kræves mindst en indtastningsmetode til %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ ist mindestens eine Eingabemethode erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται τουλάχιστον μία μέθοδος εισόδου για τα %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one input method is required for %@."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one input method is required for %@."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one input method is required for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere al menos un método de entrada para %@."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere por lo menos un método de entrada para %@."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere por lo menos un método de entrada para %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vaatii vähintään yhden syöttötavan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une méthode de saisie est requise pour cette langue (%@)."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une méthode de saisie est requise pour %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת לפחות שיטת קלט אחת עבור %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए कम से कम एक इनपुट विधि आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban je barem jedan način unosa za %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább egy beviteli mód szükséges a következőhöz: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setidaknya satu metode input diperlukan untuk %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È richiesto almeno un metodo di input per %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で少なくとも1つの入力プログラムが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 사용하려면 최소 하나의 입력기가 필요함"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekurang-kurangnya satu kaedah input diperlukan untuk %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kreves minst én inndatametode for %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is ten minste één invoermethode vereist voor %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język %@ wymaga co najmniej jednej metody wprowadzania."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos um layout de teclado é necessário para %@."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário, pelo menos, um método de escrita para %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru %@ este necesară cel puțin o metodă de introducere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого языка (%@) требуется как минимум один способ ввода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre jazyk %@ sa vyžaduje aspoň jedna metóda vstupu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za jezik »%@« je potreben najmanj en način vnosa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst en inmatningsmetod krävs för %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้วิธีการป้อนข้อมูลอย่างน้อยหนึ่งวิธีสำหรับ%[tt]@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için en az bir giriş yöntemi gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ потребує хоча б одного методу вводу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu có tối thiểu một phương thức nhập liệu cho %@."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一个%@输入方式。"
          }
        },
