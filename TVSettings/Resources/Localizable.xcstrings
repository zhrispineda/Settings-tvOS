    "AXVoiceOverFocusEverywhereDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "السماح لميزة التعليق الصوتي بالتركيز على كل العناصر الموجودة على الشاشة، بما في ذلك العناصر غير التفاعلية",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Permet que el VoiceOver seleccioni tots els ítems de la pantalla, inclosos els que no siguin interactius.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Umožňuje VoiceOveru zaměřit kterýkoli prvek na obrazovce včetně těch, s nimiž není možná žádná interakce.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Tillader VoiceOver at fokusere på alle elementer på skærmen, herunder elementer, der ikke er interaktive",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Hiermit kann VoiceOver alle Elemente auf dem Bildschirm fokussieren, einschließlich derer, die keine Interaktion erlauben.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Επιτρέπεται η εστίαση του VoiceOver σε όλα τα στοιχεία της οθόνης, συμπεριλαμβανομένων αυτών που δεν έχουν δυνατότητα αλληλεπίδρασης",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Allows VoiceOver to focus all elements on the screen including non-interactable elements",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Allows VoiceOver to focus all elements on the screen including non-interactable elements",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Allows VoiceOver to focus all elements on the screen including non-interactable elements",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Allows VoiceOver to focus all elements on the screen including non-interactable elements",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Allows VoiceOver to focus all elements on the screen including non-interactable elements",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Permite que VoiceOver seleccione todos los elementos de la pantalla, incluidos los que no son interactivos.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Permite que VoiceOver enfoque todos los elementos de la pantalla, incluidos los que no son interactivos.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Permite que VoiceOver enfoque todos los elementos de la pantalla, incluidos los que no son interactivos.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Sallii VoiceOverin kohdistaa kaikki näytöllä olevat elementit, myös sellaiset, joita ei voi käsitellä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Autorise VoiceOver à cibler tous les éléments à l’écran, y compris les éléments non interactifs.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Autorise VoiceOver à cibler tous les éléments à l’écran, y compris les éléments non interactifs.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו מאפשרת ל-VoiceOver להתמקד בכל הרכיבים במסך כולל ברכיבים שלא ניתן ליצור איתם אינטראקציה.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver को नॉन-इंटरऐक्टेबल एलिमेंट सहित स्क्रीन पर मौजूद सभी एलिमेंट पर फ़ोकस करने की अनुमति देता है",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Dozvoljava VoiceOveru fokusiranje svih elemenata na zaslonu, uključujući elemente s kojima se ne može stupiti u interakciju",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Lehetővé teszi a VoiceOver számára, hogy fókuszba helyezze a képernyőn szereplő összes elemet, beleértve az interakcióra nem alkalmas elemeket is.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Izinkan VoiceOver untuk memfokuskan semua elemen di layar termasuk elemen yang tidak dapat berinteraksi",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Consente a VoiceOver di selezionare tutti gli elementi sullo schermo, inclusi quelli non interattivi.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverが、操作できない要素を含む画面上のすべての要素にフォーカスするのを許可",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "상호 작용이 불가능한 요소를 포함하여, VoiceOver가 화면에 있는 모든 요소에 초점을 맞출 수 있도록 허용합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Benarkan VoiceOver memfokus semua elemen pada skrin termasuk elemen tidak boleh diinteraksi",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Hiermee kan VoiceOver alle elementen op het scherm, waaronder elementen waarmee niet kan worden gewerkt, focus geven",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "La VoiceOver fokusere på alle elementer på skjermen, inkludert ikke-interaktive elementer",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Pozwala VoiceOver przenosić fokus do dowolnych, w tym nieinteraktywnych, elementów na ekranie",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Permite que o VoiceOver selecione todos os elementos da tela, incluindo os não interativos",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Permite ao VoiceOver focar todos os elementos no ecrã, incluindo elementos não interativos.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Permiteți focalizarea VoiceOver pe toate elementele de pe ecran, inclusiv cele cu care nu se poate interacționa",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Разрешить функции VoiceOver фокусироваться на всех элементах, имеющихся на экране, в том числе на тех, с которыми невозможно взаимодействовать.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Umožňuje VoiceOveru zamerať sa na ľubovoľný prvok na obrazovke vrátane prvkov, s ktorými nie je možné interagovať.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Omogočite funkciji VoiceOver, da usmeri fokus na vse elemente na zaslonu, tudi na tiste z onemogočeno interakcijo.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Tillåter att VoiceOver fokuserar på alla element på skärmen, inklusive icke-interaktiva element",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "อนุญาตให้ VoiceOver โฟกัสองค์ประกอบทั้งหมดบนหน้าจอรวมถึงองค์ประกอบที่โต้ตอบไม่ได้",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver’ın etkileşimde bulunulamayan öğeler de dahil olmak üzere ekrandaki tüm öğelere odaklanmasına izin verir",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Дає змогу VoiceOver фокусуватися на всіх елементах, присутніх на екрані — навіть на тих, з якими не можна взаємодіяти.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Cho phép VoiceOver tập trung vào tất cả các thành phần trên màn hình, bao gồm các thành phần không thể tương tác",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "允许旁白聚焦于屏幕上的所有元素，包括不可交互元素",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "允許「旁白」將焦點集中在螢幕上的所有元件，包括非互動元件",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "允許「旁白」聚焦在螢幕上的所有元件，包含非互動元件",
            "state": "translated"
          }
        }
      }
    },
