    "RestrictionsPasscodeSetConfirmedPrompt": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التأكد من حفظ رمز الدخول في مكانٍ آمن. وفي حالة نسيان رمز الدخول، يمكنك إعادة تعيين جميع الإعدادات في الإعدادات > النظام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegura’t que desis el codi en un lloc segur. Si l’oblides, pots restablir tots els paràmetres a l’app Configuració > Sistema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód uložte na bezpečné místo. Pokud ho zapomenete, můžete celé nastavení resetovat v Nastavení > Systém."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at opbevare din kode på et sikkert sted. Hvis du glemmer koden, kan du nulstille alle indstillinger i Indstillinger > System."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre deinen Code an einem sicheren Ort auf. Falls du deinen Code vergisst, kannst du alle Einstellungen zurücksetzen, indem du „Einstellungen“ > „System“ wählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φροντίστε να διατηρείτε τον κωδικό σας σε ασφαλή τοποθεσία. Αν ξεχάσετε τον κωδικό, μπορείτε να επαναφέρετε όλες τις ρυθμίσεις στις «Ρυθμίσεις» > «Σύστημα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you keep your passcode in a safe place. If you forget your passcode, you can reset all settings in Settings > System."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you keep your passcode in a safe place. If you forget your passcode, you can reset all settings in Settings > System."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you keep your passcode in a safe place. If you forget your passcode, you can reset all settings in Settings > System."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu código está guardado en un lugar seguro. Si lo olvidas, puedes restablecer todos los ajustes en Ajustes > Sistema."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu código está guardado en un lugar seguro. Si lo olvidas, puedes restablecer toda la configuración en Configuración > Sistema."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que tu código está guardado en un lugar seguro. Si lo olvidas, puedes restablecer toda la configuración en Configuración > Sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä pääsykoodi turvallisessa paikassa. Jos unohdat pääsykoodin, voit nollata kaikki asetukset valitsemalla Asetukset > Järjestelmä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous de conserver votre mot de passe en lieu sûr. Si vous l’oubliez, vous pouvez réinitialiser tous les réglages dans Réglages > Système."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous de conserver votre code en lieu sûr. Si vous l’oubliez, vous pouvez réinitialiser tous les réglages dans Réglages > Système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שקוד הגישה שמור במקום בטוח. אם שכחת את קוד הגישה, באפשרותך לאפס את כל ההגדרות דרך ״הגדרות״ > ״מערכת״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पासकोड किसी सुरक्षित स्थान पर रखें। अगर आप अपना पासकोड भूल जाते हैं, तो सेटिंग > सिस्टम में जाकर सभी सेटिंग को रीसेट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifru držite na sigurnom mjestu. Ako zaboravite šifru, možete resetirati sve postavke u Postavke > Sustav."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződjön meg róla, hogy a jelkódját biztonságos helyen őrzi. Ha elfelejti a jelkódját, az összes beállítást alaphelyzetbe állíthatja a Beállítások > Rendszer menüpontban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan Anda menyimpan kode sandi di tempat yang aman. Jika lupa kode sandi, Anda dapat mengatur ulang semua pengaturan di Pengaturan > Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati di mantenere il codice in un posto sicuro. Se lo dimentichi, puoi ripristinare tutte le impostazioni in Impostazioni > Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードは安全な場所に保管してください。パスコードを忘れた場合は、“設定”＞“システム”ですべての設定をリセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호를 안전한 곳에 보관하십시오. 암호를 잊어버리면, 설정 > 시스템에서 모든 설정을 재설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan anda menyimpan kod laluan anda di tempat yang selamat. Jika anda terlupa kod laluan, anda boleh mereset semua seting dalam Seting > Sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppbevar koden på et sikkert sted. Hvis du glemmer koden, kan du nullstille alle innstillinger under Innstillinger > System."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat je je toegangscode op een veilige plaats bewaart. Als je je toegangscode vergeet, kun je alle instellingen herstellen via 'Systeem' in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj, aby przechowywać swój kod w bezpiecznym miejscu. Jeśli go zapomnisz, możesz wyzerować wszystkie ustawienia na ekranie Ustawienia > System."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o seu código em um local seguro. Se você esquecer o código, poderá redefinir todos os ajustes em Ajustes > Sistema."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique‑se de que guarda o seu código em lugar seguro. Se se esquecer do código, pode repor todas as definições em Definições > Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați codul de acces într‑un loc sigur. Dacă uitați codul de acces, puteți reseta toate configurările accesând Configurări > Sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что Ваш код‑пароль хранится в надежном месте. Если Вы забыли код‑пароль, можно сбросить все настройки в разделе «Настройки» > «Система»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovajte svoj kód na bezpečnom mieste. Ak zabudnete kód, môžete resetovať všetky nastavenia v Nastavenia > Systém."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepričajte se, da je vaša koda za dostop na varnem mestu. Če pozabite kodo za dostop, lahko ponastavite vse nastavitve v razdelku Nastavitve > Sistem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att spara din lösenkod på ett säkert ställe. Om du glömmer bort lösenkoden kan du nollställa alla inställningar via Inställningar > System."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่าคุณเก็บรหัสของคุณในที่ปลอดภัย ถ้าคุณลืมรหัสของคุณ คุณสามารถรีเซ็ตการตั้งค่าทั้งหมดได้ในการตั้งค่า > ระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodunuzu güvenli bir yerde tuttuğunuzdan emin olun. Kodunuzu unutursanız Ayarlar > Sistem bölümünde tüm ayarları sıfırlayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обовʼязково зберігайте свій код допуску в безпечному місці. Якщо ви забули свій код допуску, можна скинути всі параметри в меню Параметри > Система."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo rằng bạn giữ mật mã của mình ở một nơi an toàn. Nếu bạn quên mật mã thì bạn có thể đặt lại tất cả cài đặt trong Cài đặt > Hệ thống."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请务必将口令保存在安全的地方。如果忘记口令，你可以在“设置”>“系统”中还原所有设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確定將密碼放在安全的地方。如果你忘記密碼，你可在「設定」>「系統」中重設所有設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請確定你將密碼保存在安全的地方。若你忘記密碼，可以在「設定」>「系統」中重置所有設定。"
          }
        }
      }
    },
