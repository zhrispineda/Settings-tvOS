    "VPNSectionDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إعداد تكوينات VPN للتحكم في حركة مرور شبكة معينة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per controlar com s’encamina determinat trànsit de xarxa, pots configurar una VPN."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí nastavených VPN je možné řídit směrování určitých typů datového provozu v síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-forbindelser kan indstilles til at styre, hvordan bestemt netværkstrafik sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN können konfiguriert werden, um die Weiterleitung von bestimmtem Netzwerkverkehr zu steuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δίκτυα VPN μπορούν να διαμορφωθούν για έλεγχο της δρομολόγησης συγκεκριμένης δικτυακής κίνησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNs can be set up to control the routing of certain network traffic."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNs can be set up to control the routing of certain network traffic."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNs can be set up to control the routing of certain network traffic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden configurar redes VPN para controlar el direccionamiento de una parte del tráfico de red."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden configurar redes VPN para controlar el direccionamiento de cierto tráfico de red."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden configurar redes VPN para controlar el direccionamiento de cierto tráfico de red."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietyn verkkoliikenteen ohjaamista varten voidaan ottaa käyttöön VPN:iä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des VPN peuvent être configurés pour contrôler le routage d’une partie de votre trafic réseau."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les VPN peuvent être configurés pour contrôler l’acheminement d’une partie du trafic réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להגדיר רשתות VPN כדי לשלוט בניתוב של תעבורת רשת מסוימת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नेटवर्क ट्रैफ़िक के राउटिंग को नियंत्रित करने के लिए VPN सेटअप किए जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete podesiti VPN-ove za upravljanje usmjeravanjem određenog mrežnog prometa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-hálózat beállításával szabályozható a hálózati forgalom egy részének átirányítása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN dapat diatur untuk mengontrol perutean lalu lintas jaringan tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile configurare le VPN per controllare l’instradamento di determinati elementi del traffico di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNを設定して、特定のネットワークトラフィックのルーティングを制御することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 네트워크 트래픽의 라우팅을 제어하도록 VPN을 설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN boleh disediakan untuk mengawal penghalaan trafik rangkaian tertentu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-forbindelser kan konfigureres for å dirigere enkelte typer nettverkstrafikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN's kunnen worden geconfigureerd om de routing van bepaald netwerkverkeer te beheren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieci VPN można konfigurować tak, aby zapewniały kontrolę nad kierowaniem ruchem sieciowym."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As redes VPN podem ser configuradas para controlar o roteamento de determinado tráfego de rede."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As redes VPN podem ser configuradas para controlar o direcionamento de determinado tráfego de rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN‑urile pot fi configurate pentru a controla dirijarea unei părți din traficul de rețea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для управления маршрутизацией определенного сетевого трафика можно настроить VPN."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavené VPN siete slúžia na ovládanie smerovania určitých dát prenášaných cez sieť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežja VPN lahko nastavite za upravljanje usmerjanja določenega omrežnega prometa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-anslutningar kan konfigureras för dirigering av viss nätverkstrafik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN สามารถถูกตั้งค่าเพื่อให้ควบคุมการกำหนดเส้นทางของการรับส่งข้อมูลเครือข่ายบางอย่างได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN’ler belirli bir ağ trafiğinin yönlendirilmesini denetleyecek şekilde ayarlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережі VPN можна налаштовувати для спрямування певного мережевого трафіку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN có thể được thiết lập để điều khiển việc định tuyến của lưu lượng truy cập mạng nhất định."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN可设置用于控制某些网络流量的路由。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可以設定VPN以控制某些網絡流量的路由。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN可以設定來控制特定網路流量的路由。"
          }
        }
      }
    },
