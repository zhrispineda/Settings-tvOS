    "CrossAppTrackingAppDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لهذا التطبيق بتتبع نشاطك باستخدام معرّف\nيمكن استخدامه لجمع نشاطك في جميع التطبيقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que l’app rastregi l’activitat amb un identificador\nque es pot utilitzar per combinar l’activitat a les apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace bude moct sledovat vaši aktivitu pomocí identifikátoru,\nkterý slouží k souhrnnému sledování aktivity ve všech aplikacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne app må spore din aktivitet vha. et id,\nder kombinerer din aktivitet på tværs af apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dieser App, deine Aktivität mit einer ID zu verfolgen,\ndie verwendet werden kann, um deine Aktivitäten appübergreifend zu kombinieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε σε αυτήν την εφαρμογή να ανιχνεύει τη δραστηριότητά σας με ένα αναγνωριστικό\nπου μπορεί να χρησιμοποιηθεί για συνδυασμό της δραστηριότητάς σας σε εφαρμογές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this app to track your activity with an identifier\nthat can be used to combine your activity across apps."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this app to track your activity with an identifier\nthat can be used to combine your activity across apps."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this app to track your activity with an identifier\nthat can be used to combine your activity across apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que esta app rastree tu actividad con un identificador que\nse pueda utilizar para combinar tu actividad en las diferentes apps."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a esta app rastrear tu actividad con un identificador\nque pueda usarse para integrar tu actividad en diversas apps."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a esta app rastrear tu actividad con un identificador\nque pueda usarse para integrar tu actividad en diversas apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli tämän apin seurata toimintaasi tunnistimella,\njota voidaan käyttää yhdistämään toimintasi appien välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez cette app à suivre votre activité via un identifiant\npouvant regrouper votre activité sur l’ensemble des apps."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez cette app à suivre votre activité au moyen d’un\nidentifiant pour l’ensemble de votre activité sur les apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר ליישום זה לעקוב אחר הפעילות שלך באמצעות מזהה\nשיכול לשמש כדי לשלב מידע לגבי הפעילות שלך בין יישומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप को आइडेंटिफ़ायर के ज़रिए आपकी ऐक्टिविटी ट्रैक करने की अनुमति दें\nकरने की अनुमति दें जिसका उपयोग सारे ऐप्स पर आपकी ऐक्टिविटी को एक साथ जोड़ने के लिए किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite ovoj aplikaciji praćenje vaše aktivnosti pomoću identifikatora\nkoji se može upotrijebiti za kombiniranje vaše aktivnosti u više aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tevékenysége követésének engedélyezése az app számára egy\nolyan azonosítóval, amelynek használatával egyesíthető az Ön appokon keresztüli tevékenysége."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan app ini untuk melacak aktivitas Anda dengan pengenal\nyang dapat digunakan untuk menggabungkan aktivitas Anda di seluruh app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti all’app di tracciarti tramite un identificativo\nche può essere utilizzato per combinare le attività che svolgi sulle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ間のアクティビティを組み合わせるために使用可能な識別子を使用して、\nこのアプリがあなたのアクティビティをトラッキングできるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 여러 앱에 걸친 사용자의 활동 내용을 결합하는 데 사용될 수 있는 식별자로\n사용자의 활동을 추적하도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan app ini menjejak aktiviti anda menggunakan pengecam\nyang boleh digunakan untuk menggabungkan aktiviti anda merentas app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at appen kan spore aktiviteten din med en identifikator\nsom kombinerer aktiviteten din på tvers av apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat deze app je activiteit bijhoudt met een ID\ndie kan worden gebruikt om je activiteiten in apps te combineren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tej aplikacji śledzić Twoją aktywność za pomocą ID,\nktóry może agregować Twoją aktywność w wielu aplikacjach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que este app rastreie as suas atividades com um identificador\nque pode ser usado para combinar sua atividade em apps."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que esta aplicação siga a sua atividade com um identificador\nque pode ser usado para combinar dados sobre a sua atividade em várias aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți ca această aplicație să vă urmărească activitatea cu un identificator\ncare poate fi utilizat pentru a combina activitatea dvs. din multiple aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите этому приложению отслеживать Ваши действия с помощью идентификатора,\nкоторый может быть использован для объединения Вашей активности в разных приложениях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolí tejto apke sledovať vaše aktivity pomocou identifikátora,\npod ktorým budú zlúčené vaše aktivity v apkách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite tej aplikaciji, da sledi vaši aktivnosti z identifikatorjem, ki\nse ga lahko uporablja za združevanje vaše aktivnosti v aplikacijah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att den här appen spårar din aktivitet med ett ID\nsom kan användas till att kombinera din aktivitet över appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้แอปนี้ติดตามกิจกรรมของคุณด้วยข้อมูลประจำตัว\nที่สามารถใช้รวบรวมกิจกรรมของคุณบนแอปแต่ละแอปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, uygulamalardaki eylemlerinizi birleştirmek için kullanılan\nbir tanıtıcı ile eylemlerinizi takip etme izni isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити цій програмі відстежувати вашу активність за допомогою ідентифікатора,\nякий може використовуватися для поєднання даних про вашу активність у програмах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng này theo dõi hoạt động của bạn bằng một mã định danh\ncó thể được sử dụng để kết hợp hoạt động của bạn trên các ứng dụng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此App使用标识符跟踪你的活动，该标识符\n可用于跨App结合你的活动。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許此App透過識別碼追蹤你的活動，\n此識別碼可用於結合你在App之間的活動。"
          }
        },
        "zh_TW": {
