    "AccountSignInAlertReason": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان لديك حساب Apple، فأدخله هنا. وإذا لم يكن لديك، أو إذا نسيت كلمة السر، فانتقل إلى account.apple.com."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tens un compte d’Apple, introdueix‑lo aquí. Si no en tens, o bé no en recordes la contrasenya, ves a account.apple.com."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte‑li účet Apple, zadejte jeho název. Pokud účet nemáte nebo jste zapomněli heslo, navštivte stránku account.apple.com/cz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har en Apple-konto, skal du skrive den her. Hvis ikke, eller hvis du har glemt din adgangskode, skal du gå til account.apple.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen Apple Account hier ein. Falls du keinen hast oder dein Passwort vergessen hast, besuche die Website „account.apple.com“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν διαθέτετε λογαριασμό Apple, εισαγάγετέ τον εδώ. Αν δεν έχετε συνθηματικό ή το έχετε ξεχάσει, μεταβείτε στη διεύθυνση account.apple.com."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have an Apple Account, enter it here. If you don’t, or forgot your password, go to account.apple.com."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have an Apple Account, enter it here. If you don’t, or forgot your password, go to account.apple.com."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have an Apple Account, enter it here. If you don’t, or forgot your password, go to account.apple.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una cuenta de Apple, introdúcela aquí. Si no tienes o has olvidado la contraseña, ve a account.apple.com."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una cuenta de Apple, ingrésala aquí. Si no la tienes o si olvidaste tu contraseña, visita account.apple.com."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una cuenta de Apple, ingrésala aquí. Si no la tienes o si olvidaste tu contraseña, visita account.apple.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sinulla on Apple-tili, syötä se tähän. Jos ei ole tai unohdit salasanasi, mene osoitteeseen account.apple.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez un compte Apple, saisissez ses identifiants ici. Si vous n’en avez pas ou si vous avez oublié votre mot de passe, rendez-vous sur account.apple.com."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez votre compte Apple ici. Si vous n’en avez pas ou si vous avez oublié votre mot de passe, rendez-vous sur account.apple.com."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יש לך חשבון Apple, באפשרותך להזין אותו כאן. אם אין לך חשבון Apple או ששכחת את הסיסמה שלך, באפשרותך לעבור אל account.apple.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपके पास Apple खाता है, तो उसे यहाँ दर्ज करें। अगर आपके पास पासवर्ड नहीं है या आप भूल गए हैं, तो account.apple.com पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako imate Apple račun, unesite ga ovdje. Ako nemate ili ste zaboravili svoju lozinku, idite na account.apple.com."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha rendelkezik Apple-fiókkal, adja meg itt. Ha még nem, vagy ha elfelejtette a jelszavát, akkor látogasson el az account.apple.com weboldalra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda memiliki Akun Apple, masukkan di sini. Jika tidak, atau Anda lupa kata sandi Anda, buka account.apple.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci qui il tuo Apple Account. Se non ne possiedi uno oppure non ne ricordi la password o il nome utente, vai alla pagina account.apple.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Accountをお持ちの場合は、ここに入力してください。お持ちでない場合や、またはパスワードを忘れた場合は、account.apple.com にアクセスしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정이 있는 경우 여기에 입력하십시오. Apple 계정이 없거나 암호를 잊어버린 경우 account.apple.com으로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda mempunyai Akaun Apple, masukkannya di sini. Jika tidak atau anda terlupa kata laluan anda, pergi ke account.apple.com/my."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har en Apple-konto, oppgir du den her. Hvis du ikke har et passord, eller du har glemt det, går du til account.apple.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een Apple Account hebt, voer je die hier in. Als je je wachtwoord vergeten bent, ga je naar account.apple.com."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli masz konto Apple, podaj je tutaj. Jeśli nie (lub nie pamiętasz hasła), odwiedź stronę account.apple.com."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tiver uma Conta Apple, digite‑a aqui. Se não tiver ou tiver esquecido sua senha, acesse account.apple.com."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tiver uma conta Apple, digite‑a aqui. Se não tiver ou caso se tenha esquecido da palavra‑passe, aceda a account.apple.com."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă aveți un cont Apple, introduceți‑l aici. Dacă nu aveți sau v‑ați uitat parola, accesați account.apple.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у Вас есть Аккаунт Apple, укажите его здесь. Если у Вас нет учетной записи или Вы не помните пароль, посетите сайт account.apple.com."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máte Apple účet, zadajte ho tu. Ak ho nemáte alebo ste zabudli svoje heslo, navštívte account.apple.com."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če imate račun Apple, ga vnesite tukaj. Če ga nimate ali ste pozabili geslo, pojdite na account.apple.com."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du har ett Apple‑konto anger du det här. Om du inte har ett, eller har glömt ditt Apple‑konto eller lösenord, besöker du account.apple.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณมีบัญชี Apple ให้ป้อนที่นี่ ถ้าคุณไม่มีหรือลืมรหัสผ่านของคุณ ให้ไปที่ account.apple.com/th"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabı’nız varsa burada girin. Hesabınız yoksa veya parolanızı unuttuysanız account.apple.com/tr/ adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас є обліковий запис Apple, введіть його тут. Якщо у вас його немає або ви забули свій пароль, зайдіть на account.apple.com."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn có Tài khoản Apple, hãy nhập tại đây. Nếu bạn không có hoặc đã quên mật khẩu, hãy truy cập account.apple.com/vn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若已有Apple账户，请在此输入。若没有，或者忘记密码，请前往account.apple.com。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如你擁有Apple帳户，請在此處輸入。如你沒有或忘記密碼，請前往account.apple.com/hk/。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若有「Apple帳號」，請在此輸入。若沒有「Apple帳號」或忘記密碼，請前往account.apple.com。"
          }
        }
      }
    },
