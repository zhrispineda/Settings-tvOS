            "value": "Для создания пары введите 4‑значный код, показанный на экране устройства «%@»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte 4-ciferný párovací kód zobrazený na zariadení „%@“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite štirimestno kodo za seznanjanje, ki je prikazana v napravi »%@«."
          }
        },
        "sv": {
          "stringUnit": {
