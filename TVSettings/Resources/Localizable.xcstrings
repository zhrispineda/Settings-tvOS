    "AVTapToZoomDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين على سطح اللمس في ريموت Apple TV لتكبير الفيديو بحيث يملأ الشاشة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes dos tocs a la superfície tàctil del comandament de l’Apple TV per ampliar el vídeo a tota la pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poklepáním na dotykový povrch ovladače Apple TV Remote zvětšíte video na celou obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk to gange på Touch-overfladen på Apple TV-fjernbetjeningen for at zoome på videoen, så den fylder hele skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippe auf die Berührungsoberfläche der Apple TV Remote, um ein Video so zu vergrößern, dass es das Display füllt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε δύο φορές την επιφάνεια αφής του Apple TV Remote για μεγέθυνση του βίντεο ώστε να εμφανιστεί σε πλήρη οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap the Apple TV Remote touch surface to zoom video to fill the screen."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap the Apple TV Remote touch surface to zoom video to fill the screen."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap the Apple TV Remote touch surface to zoom video to fill the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces la superficie táctil del mando del Apple TV para ampliar el vídeo a pantalla completa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces la superficie táctil del Apple TV Remote para ampliar el video hasta llenar la pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces la superficie táctil del Apple TV Remote para ampliar el video hasta llenar la pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomaa video täyttämään koko näyttö kaksoisnapauttamalla Apple TV -kaukosäätimen kosketuspintaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois la surface tactile de la télécommande Apple TV pour zoomer sur la vidéo afin qu’elle occupe tout l’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois la surface tactile de la télécommande de l’Apple TV pour agrandir la vidéo de sorte qu’elle remplisse l’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להקיש פעמיים על משטח המגע של ה-Apple TV Remote כדי להגדיל את הווידאו כך שימלא את המסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो को बड़ा करके पूरी स्क्रीन भरने के लिए Apple TV रिमोट टच सर्फ़ेस पर डबल टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirnite dodirnu površinu upravljača Apple TV Remote za zumiranje videozapisa kako bi ispunjavao zaslon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson duplán az Apple TV Remote érintőfelületére a videó képernyőt kitöltő méretre való nagyításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali permukaan sentuh Apple TV Remote untuk memperbesar video hingga mengisi layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte la superficie touch di Apple TV Remote per ingrandire il video fino a riempire lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを全画面にズームするにはApple TV Remoteのタッチサーフェスをダブルタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오를 전체 화면으로 확대하려면 Apple TV 리모컨의 터치 표면을 두 번 탭하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwiketik pada permukaan sentuh Apple TV Remote untuk mengezum video bagi mengisi skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk på styreflaten til Apple TV-fjernkontrollen for å zoome videoen til å fylle skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik dubbel op de touchpad van de Apple TV Remote om video te zoomen om het scherm te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwukrotne stuknięcie w powierzchnię dotykową pilota Apple TV Remote powiększa wideo, wypełniając ekran."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes na superfície de toque do Apple TV Remote para ampliar o vídeo e preencher a tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê dois toques na superfície táctil do Apple TV Remote para ampliar o vídeo e preencher o ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați dublu pe suprafața tactilă de pe telecomanda Apple TV‑ului pentru a efectua zoom în video și a umple ecranul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь сенсорной поверхности пульта Apple TV, чтобы подстроить масштаб видео под размер экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím na dotykovom povrchu ovládača Apple TV Remote zväčšíte video na celú obrazovku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvotapnite sledilno ploščico daljinca Apple TV Remote, da povečate video do zapolnitve zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck snabbt två gånger på tryckområdet på Apple TV Remote om du vill zooma videon så att den fyller hela skärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะพื้นผิวสัมผัสบน Apple TV Remote สองครั้งเพื่อซูมวิดีโอให้เต็มหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoyu ekranı dolduracak şekilde büyütmek için Apple TV Remote dokunma yüzeyine çift dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкніть сенсорну поверхню пульта Apple TV Remote, щоб масштабувати відео до розмірів екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hai lần vào bề mặt cảm ứng của Apple TV Remote để thu phóng video phủ kín màn hình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下Apple TV遥控器触控表面以放大视频填充屏幕。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下Apple TV遙控器觸控表面來將影片放大以填滿螢幕。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下Apple TV遙控器的觸控表面來將影片放大以填滿螢幕。"
          }
        }
      }
    },
