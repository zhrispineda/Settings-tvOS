            "value": "Offload Unused Apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar apps no usadas"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstalar apps sin usar"
          }
        },
