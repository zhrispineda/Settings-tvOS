          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть цей формат, щоб перевірити його на сумісність із вашим телевізором. Після підтвердження сумісності Apple TV може застосовувати його автоматично.\nЧастота %@ точно відповідає вмісту, записаному з %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
