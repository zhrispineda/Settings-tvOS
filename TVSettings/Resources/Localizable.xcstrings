    "iTMSAddPlaylistSongsOffDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تضاف الأغاني إلى مكتبتك عندما تضاف إلى قوائم التشغيل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cançons que afegeixis a les llistes de reproducció no s’afegiran a la biblioteca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby, které si přidáte do playlistů, se nebudou zároveň přidávat do vaší knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange bliver ikke føjet til dit bibliotek, når du føjer dem til dine playlister."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel werden nicht zu deiner Mediathek hinzugefügt, wenn du sie zu Playlists hinzufügst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραγούδια δεν θα προστίθενται στη Βιβλιοθήκη σας όταν τα προσθέτετε στις λίστες αναπαραγωγής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs will not be added to your library when you add them to your playlists."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs will not be added to your library when you add them to your playlists."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs will not be added to your library when you add them to your playlists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones no se añadirán a tu biblioteca cuando las añadas a tus playlists."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones que agregues a tus playlists no se agregarán a tu biblioteca."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones que agregues a tus playlists no se agregarán a tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleita ei lisätä kirjastoon, kun lisäät niitä soittolistoihisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux ajoutés à vos playlists ne seront pas ajoutés à votre bibliothèque."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chansons ne sont pas ajoutées à votre bibliothèque lorsque vous les ajoutez à vos listes de lecture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירים לא יתווספו לספריה בעת הוספתם לפלייליסטים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप गीतों को अपनी प्लेलिस्ट में जोड़ेंगे, तो वे आपकी लाइब्रेरी में नहीं जुड़ेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesme se neće dodati u vašu medijateku kad ih dodate u svoje liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dalok nem lesznek hozzáadva a könyvtárához, amikor hozzáadja őket a lejátszási listáihoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu tidak akan ditambahkan ke perpustakaan Anda saat Anda menambahkannya ke daftar putar Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani non verranno aggiunti alla libreria quando li aggiungi alle playlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲をプレイリストに追加しても、ライブラリには追加されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이리스트에 노래를 추가해도 보관함에는 추가되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu tidak akan ditambahkan ke pustaka anda apabila anda menambahnya ke senarai main anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger vil ikke bli lagt til i biblioteket ditt når du legger dem til i spillelister."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers worden niet in je bibliotheek gezet wanneer je ze in je afspeellijsten zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory dodawane do playlist nie będą dodawane do biblioteki."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas não serão adicionadas à biblioteca quando você adicioná‑las às suas playlists."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas não serão adicionadas à biblioteca quando forem adicionadas a listas de reprodução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodiile nu vor fi adăugate în biblioteca dvs. atunci când le adăugați în listele de redare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При добавлении в плейлисты песни не будут сохраняться в медиатеке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby, ktoré pridáte do svojich playlistov, nebudú pridané do vašej knižnice."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladbe ne bodo dodane v knjižnico, ko jih dodate na sezname predvajanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar läggs inte till i biblioteket när du lägger till dem i spellistor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงจะไม่ถูกเพิ่มไปยังคลังของคุณเมื่อคุณเพิ่มเพลงไปยังเพลย์ลิสต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listelerinize eklediğiniz parçalar arşivinize eklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додані до підбірок пісні не додаватимуться до вашої медіатеки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài hát sẽ không được thêm vào thư viện khi bạn thêm chúng vào playlist."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将歌曲添加到播放列表时，将不会添加到资料库。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你將歌曲加至播放清單時，歌曲不會加至你的資料庫。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加入播放列表的歌曲將不會加入資料庫。"
          }
        }
      }
    },
