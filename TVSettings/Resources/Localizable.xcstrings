    "TVShowsAppVisibilityDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار إظهار برامج iTunes التلفزيونية على الشاشة الرئيسية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria si vols que es mostrin les sèries de l’iTunes a la pantalla d’inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, pokud chcete na ploše zobrazit aplikaci Seriály v iTunes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, at tv-udsendelser i iTunes skal vises på hjemmeskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, ob iTunes-TV-Sendungen auf dem Home-Bildschirm angezeigt werden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε να εμφανίζονται οι τηλεοπτικές εκπομπές iTunes στην οθόνη Αφετηρίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to show iTunes TV Shows on the Home screen."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
