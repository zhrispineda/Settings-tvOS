    "AXAudioDescriptionsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تشغيل السرد التوضيحي للتفاصيل المرئية الرئيسية في الوسائط تلقائيًا، عند توفره.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Es descriuran els detalls visuals més importants del contingut multimèdia automàticament, sempre que les descripcions estiguin disponibles.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Pokud je k dispozici mluvený popis klíčových vizuálních detailů v médiích, bude se automaticky přehrávat.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Når det er muligt, afspil automatisk en lydbeskrivelse af vigtige visuelle detaljer i medier.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Wenn verfügbar, werden Audiobeschreibungen von wichtigen visuellen Details in Medien automatisch wiedergegeben.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αυτόματη αναπαραγωγή αφήγησης βασικών οπτικών λεπτομερειών σε πολυμέσα, όταν διατίθεται.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "When available, automatically play narration of key visual details in media.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "When available, automatically play narration of key visual details in media.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "When available, automatically play narration of key visual details in media.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "When available, automatically play narration of key visual details in media.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "When available, automatically play narration of key visual details in media.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Cuando haya una descripción de los detalles visuales más importantes del contenido multimedia, se reproducirá automáticamente.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Cuando esté disponible, reproduce automáticamente las descripciones de los detalles visuales más relevantes en el contenido multimedia.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Cuando esté disponible, reproduce automáticamente las descripciones de los detalles visuales más relevantes en el contenido multimedia.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Kun saatavilla, toista median tärkeiden elementtien selostus automaattisesti.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Lorsque cela est possible, écoutez automatiquement la narration des détails visuels clés des contenus multimédias.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Lit automatiquement la description des détails visuels clés du contenu multimédia lorsqu’elle est disponible.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להשמיע באופן אוטומטי קריינות שמספקת מידע על פרטים ויזואליים מרכזיים בתוכני מדיה, בהתאם לזמינות.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "यदि उपलब्ध हो, तो मीडिया में प्रमुख विज़ुअल विवरण का ऑडियो वर्णन ऑटोमैटिकली चलाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Kada je to dostupno, automatski će se reproducirati naracija ključnih vizualnih detalja u medijima.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Ha elérhető, automatikusan lejátszhatja a médiatartalom kulcsfontosságú vizuális részleteinek hangos leírását.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Saat tersedia, putar narasi detail visual utama pada media secara otomatis.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Quando disponibile, riproduci automaticamente la narrazione dei dettagli visivi principali nei contenuti multimediali.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "メディア内の重要な視覚的情報のナレーションが利用できる場合は自動的に再生します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "가능한 경우 미디어 내에서 시각적으로 나타나는 주요 내용에 대한 내레이션이 자동으로 재생됩니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Apabila tersedia, mainkan pengisahan butiran visual utama dalam media secara automatik.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Speel automatisch een gesproken beschrijving af van belangrijke visuele details in media, indien beschikbaar.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Spill automatisk av en beskrivelse av hovedmotiver i medier når det er tilgjengelig.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Gdy jest dostępna, automatycznie odtwarza narrację kluczowych szczegółów wizualnych w multimediach.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Quando disponível, reproduz automaticamente a narração dos detalhes visuais mais importantes do conteúdo.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Sempre que possível, reproduzir automaticamente a narração dos detalhes visuais mais importantes do conteúdo multimédia.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Când este disponibilă, redați automat descrierea enunțată a detaliilor vizuale cheie din conținutul multimedia.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Автоматически воспроизводить доступные описания ключевых визуальных деталей в медиаконтенте.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Automaticky prehrá hovorený popis kľúčových vizuálnych detailov v médiách, ak je k dispozícii.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Samodejno predvajanje pripovedovanja, ki opiše ključne vizualne podrobnosti v predstavnostni vsebini, če je ta možnost na voljo.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Spela automatiskt upp talade beskrivningar av viktiga visuella detaljer i medier om de är tillgängliga.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เล่นคำบรรยายรายละเอียดสำคัญของภาพในสื่อโดยอัตโนมัติหากมี",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Kullanılabilir olduğunda, ortamdaki önemli görsel ayrıntıların anlatımını otomatik olarak çalar.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Автоматично відтворювати опис ключових візуальних деталей у медіаматеріалах, коли він доступний.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Tự động phát lời dẫn về các chi tiết hình ảnh chính trong phương tiện khi có sẵn.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "可用时，自动播放媒体中关键视觉细节的解说。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "在可用時自動播放媒體中關鍵視覺細節的旁白。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "自動播放媒體中關鍵視覺細節的敘述（若有提供）。",
            "state": "translated"
          }
        }
      }
    },
