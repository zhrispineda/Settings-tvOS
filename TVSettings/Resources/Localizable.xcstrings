    "HomeKitUpdateOSDialogSubtitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم منزلك إصدارًا أحدث من تطبيق المنزل من Apple. يرجى تحديث Apple TV إلى آخر إصدار من tvOS للانضمام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La casa fa servir una versió més recent de l’Apple Home. Actualitza l’Apple TV a l’última versió del tvOS per afegir‑l’hi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše domácnost používá novější verzi aplikace Domácnost. Chcete‑li tuto Apple TV přidat, aktualizujte ji na nejnovější verzi tvOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjem bruger en nyere version af Apple Hjem. Opdater dit Apple TV til den nyeste version af tvOS for at oprette forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zuhause verwendet eine neuere Version von Apple Home. Zum Beitritt aktualisiere dein Apple TV auf die neueste Version von tvOS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Οικία σας χρησιμοποιεί μια νεότερη έκδοση της Οικίας Apple. Για προσθήκη, ενημερώστε το Apple TV σας στην πιο πρόσφατη έκδοση του tvOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home is using a newer version of Apple Home. Update your Apple TV to the latest version of tvOS to join."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home is using a newer version of Apple Home. Update your Apple TV to the latest version of tvOS to join."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home is using a newer version of Apple Home. Update your Apple TV to the latest version of tvOS to join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu casa está usando una versión más reciente de Apple Home. Actualiza el Apple TV a la última versión de tvOS para unirte."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu casa utiliza una versión más reciente de la app Casa. Actualiza tu Apple TV a la versión más reciente de tvOS para acceder."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu casa utiliza una versión más reciente de la app Casa. Actualiza tu Apple TV a la versión más reciente de tvOS para acceder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koti käyttää uudempaa Applen Kodin versiota. Päivitä Apple TV uusimpaan tvOS-versioon, jotta voit liittyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre domicile utilise une version d’Apple Home plus récente. Mettez à jour votre Apple TV vers la dernière version de tvOS pour rejoindre votre domicile."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre domicile utilise une version plus récente d’Apple Home. Mettez à jour votre Apple TV vers la dernière version de tvOS pour y accéder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבית שלך משתמש בגירסה חדשה יותר של ארכיטקטורת Apple Home. כדי להצטרף יש לעדכן את ה‑Apple TV לגירסה העדכנית ביותר של tvOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका घर Apple Home के एक नए संस्करण का इस्तेमाल कर रहा है। शामिल होने के लिए अपने Apple TV को tvOS के नवीनतम संस्करण पर अपडेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Dom koristi noviju verziju Apple Doma. Ažurirajte Apple TV na najnoviju verziju tvOS-a za pristupanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Otthon az Apple Otthon újabb verzióját használja. Ha csatlakozni szeretne, frissítse az Apple TV-jét a tvOS legújabb verziójára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rumah Anda menggunakan versi Rumah Apple yang lebih baru. Perbarui Apple TV Anda ke tvOS versi terbaru untuk bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abitazione utilizza una versione più recente di Apple Home. Per unirti all’abitazione, aggiorna Apple TV all’ultima versione di tvOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームで新しいバージョンのApple Homeが使用されています。追加するにはApple TVを最新版のtvOSにアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈이 새로운 버전의 Apple 홈을 사용하고 있습니다. 홈에 연결하려면 Apple TV를 최신 버전의 tvOS로 업데이트하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rumah anda menggunakan versi Apple Home lebih baharu. Kemas kini Apple TV anda kepada versi terkini tvOS untuk menyertai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjemmet bruker en nyere versjon av Hjem-appen. Oppdater Apple TV til nyeste versjon av tvOS for å koble til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je woning gebruikt een nieuwere versie van Apple Woning. Werk je Apple TV bij naar de nieuwste tvOS-versie om er verbinding mee te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twoim domu jest używana nowsza wersja platformy Apple Home. Aby przyłączyć się do niego, zainstaluj na Apple TV najnowszą wersję systemu tvOS."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Casa está usando uma versão mais recente do Apple Home. Para entrar, atualize a Apple TV para a versão mais recente do tvOS."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa está a usar uma versão mais recente de Apple Home. Para aceder, atualize a Apple TV com a versão mais recente do tvOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locuința dvs. utilizează o versiune mai nouă de Locuință Apple. Pentru a‑l adăuga, actualizați Apple TV‑ul la cea mai recentă versiune de tvOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш дом использует более новую версию приложения «Дом» от Apple. Чтобы добавить Apple TV, обновите его до новейшей версии tvOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša domácnosť používa novšiu verziu Apple Domácnosti. Ak sa chcete pripojiť, aktualizujte Apple TV na najnovšiu verziu tvOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dom uporablja novo različico Doma Apple. Če se želite pridružiti, posodobite Apple TV na najnovejšo različico tvOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hem använder en nyare version av Hem. Uppdatera Apple TV med den senaste versionen av tvOS om du vill ansluta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บ้านของคุณใช้เวอร์ชั่นที่ใหม่กว่าของ Apple Home อยู่ อัปเดต Apple TV ของคุณเป็น tvOS เวอร์ชั่นล่าสุดเพื่อเข้าร่วม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev’iniz Apple Ev’in daha yeni bir sürümünü kullanıyor. Katılmak için Apple TV’nizi en son tvOS sürümüne güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш дім використовує новішу версію програми «Дім» від Apple. Щоб приєднатися, оновіть Apple TV до найновішої версії tvOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà của bạn đang sử dụng phiên bản Nhà Apple mới hơn. Hãy cập nhật Apple TV của bạn lên phiên bản tvOS mới nhất để kết nối."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“家庭”正在使用更高版本的Apple家庭。请将Apple TV更新到最新版本的Apple tvOS以加入。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的「家居」正在使用較新版本的「Apple家居」。請將Apple TV更新至最新版本的tvOS以加入。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的「家庭」正使用較新版本的「Apple家庭」。請將Apple TV更新到最新版本的tvOS來加入。"
          }
        }
      }
    },
