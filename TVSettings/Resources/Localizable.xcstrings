    "MusicSoundCheckOFF": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتم تعديل الصوت لكل أغنية، حيث سيتم تشغيل بعض الأغاني على مستوى صوت أعلى من الأخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El volum no s’ajustarà per a cada cançó; pot ser que algunes cançons sonin més alt que d’altres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitost skladeb nebude upravena. Je možné, že některé skladby budou hlasitější než ostatní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydstyrken justeres ikke for hver enkelt sang, så nogle sange lyder muligvis højere end andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke wird nicht für jeden Titel angepasst, sodass manche evtl. lauter gespielt werden als andere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ένταση ήχου δεν θα προσαρμόζεται για κάθε τραγούδι, συνεπώς κάποια τραγούδια μπορεί να αναπαράγονται σε υψηλότερη ένταση από άλλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume won’t be adjusted for each song, so some songs may play louder than others."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume won’t be adjusted for each song, so some songs may play louder than others."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume won’t be adjusted for each song, so some songs may play louder than others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ajustará el volumen para cada canción, por lo que algunas podrían reproducirse con más volumen que otras."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen no se ajustará para cada canción, de modo que el volumen puede variar de una canción a otra."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen no se ajustará para cada canción, de modo que el volumen puede variar de una canción a otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänenvoimakkuutta ei säädetä erikseen jokaiselle kappaleelle, joten joitakin kappaleita voidaan toistaa muita kovempaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume ne sera pas ajusté pour chaque morceau ; certains pourront donc être lus à un volume plus élevé que d’autres."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume de chaque chanson ne sera pas ajusté. Le volume de certaines chansons pourrait être plus élevé que d’autres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת השמע לא תותאם עבור כל שיר, כך שייתכן ששירים מסוימים יושמעו בעוצמה גבוהה יותר מאחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम को हर गीत के साथ ऐडजस्ट नहीं किया जाएगा जिसके कारण हो सकता है कि कुछ गीत दूसरे की बनिस्बत तेज़ बजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnoća se neće prilagoditi za svaku pjesmu, pa će se neke pjesme možda reproducirati glasnije od drugih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangerő nem lesz hozzáigazítva az egyes dalokhoz, ezért előfordulhat, hogy néhány dal a többihez képest hangosabban lesz lejátszva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume tidak akan disesuaikan untuk setiap lagu sehingga volume mungkin akan lebih kencang di sebagian lagu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume non verrà regolato automaticamente; alcuni brani potrebbero essere riprodotti a un livello più alto di altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量は各曲毎には調整されません。大きな音量で再生される曲がある場合もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음량이 각각의 음악에 따라 조절되지 않아서 일부 음악이 다른 음악에 비해 더 크게 재생될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelantangan tidak akan dilaraskan untuk setiap lagu, jadi sesetengah lagu mungkin dimainkan lebih kuat berbanding lagu lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumet blir ikke justert for hver sang, og noen sanger kan derfor spilles høyere enn andre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volume wordt niet voor elk nummer aangepast, waardoor sommige nummers luider worden afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głośność nie będzie ustawiana i niektóre utwory mogą brzmieć głośniej niż inne."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume não será ajustado para cada música, então pode ser que algumas músicas sejam reproduzidas em um volume mais alto do que outras."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume não será ajustado para cada música e, portanto, é possível que o som de algumas músicas seja mais alto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul nu va fi ajustat pentru fiecare melodie, prin urmare unele melodii pot fi redate mai tare decât altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость не будет скорректирована для каждой песни, поэтому некоторые песни могут воспроизводиться громче, чем другие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitosť skladieb nebude upravená, takže niektoré skladby môžu hrať hlasnejšie ako iné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnost ne bo prilagojena za vsako skladbo posebej, zato se lahko nekatere skladbe predvajajo glasneje kot druge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymen justeras inte för varje låt, så vissa låtar kanske spelas upp med högre volym än andra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับเสียงของแต่ละเพลงจะไม่ถูกปรับ\nดังนั้นเพลงบางเพลงอาจดังกว่าเพลงอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses her parça için ayarlanmaz, bazı parçalar diğerlerinden daha yüksek seste çalabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гучність не коригуватиметься для кожної пісні, тому деякі пісні можуть звучати гучніше за інші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm lượng sẽ không được điều chỉnh cho từng bài hát, do đó một số bài hát có thể phát lớn hơn những bài khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音量不会针对每首歌曲进行调整，因此部分歌曲可能以比其他歌曲更高的音量播放。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將不會為每首歌調整音量，所以部份歌曲播放時可能會比其他歌曲大聲。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將不會為每首歌調整音量，所以部分歌曲的播放音量會比較大聲。"
          }
        }
      }
    },
    "MusicSoundCheckON": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تعديل الصوت تلقائيًا بحيث يتم تشغيل جميع الأغاني على نفس مستوى الصوت."
