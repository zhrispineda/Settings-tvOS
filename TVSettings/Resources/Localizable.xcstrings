    "HomeKitUnlockSecureAccessoriesNotAllowedDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكن Apple TV من التحكم في الملحقات الأمنية. يمكنك التحكم فيها باستخدام أحد أجهزة المنزل الأخرى بدلاً من ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV no podrà controlar els accessoris de seguretat. Podràs controlar‑los amb un altre dispositiu de casa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nebude smět ovládat bezpečnostní příslušenství. Toto příslušenství bude možné ovládat pomocí jiného zařízení v domácnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan ikke betjene sikkerhedstilbehør. Du kan i stedet betjene dem med en anden enhed, der er kompatibel med Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV wird Sicherheitszubehör nicht steuern können. Du kannst sie stattdessen mit anderen Home-Geräten steuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV δεν θα είναι δυνατό να χειρίζεται αξεσουάρ ασφαλείας. Μπορείτε να τα χειρίζεστε χρησιμοποιώντας αντ’ αυτού μια άλλη συσκευή Οικίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV won’t be able to control security accessories. You can control them using another Home device instead."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV won’t be able to control security accessories. You can control them using another Home device instead."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV won’t be able to control security accessories. You can control them using another Home device instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no podrá controlar los accesorios de seguridad. No obstante, puedes controlarlos mediante otro dispositivo de la app Casa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no podrá controlar los accesorios de seguridad. En su lugar, puedes controlarlos mediante otro dispositivo de Casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no podrá controlar los accesorios de seguridad. En su lugar, puedes controlarlos mediante otro dispositivo de Casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ei pysty ohjaamaan turvalisälaitteita. Voit ohjata niitä sen sijaan toisella Kotiin liitetyllä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV ne pourra pas contrôler les accessoires de sécurité. Vous devrez utiliser un autre appareil Maison pour les contrôler."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV ne pourra pas contrôler les accessoires de sécurité. Vous pouvez les contrôler en utilisant un autre appareil Domicile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה‑Apple TV לא יוכל לשלוט באביזרי אבטחה. ניתן לשלוט בהם באמצעות מכשיר אחר ביישום ״הבית שלי״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV सुरक्षा ऐक्सेसरी को नियंत्रित नहीं कर पाएगा। इसके बजाए घर के अन्य डिवाइस का उपयोग करके आप उन्हें नियंत्रित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV neće moći upravljati sigurnosnim priborima. Umjesto toga, njima možete upravljati putem drugog uređaja Doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV nem lesz képes vezérelni a biztonsági kiegészítőket. Használjon másik Otthon-eszközt a kiegészítők vezérléséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV tidak akan dapat mengontrol aksesori keamanan. Anda dapat mengontrolnya menggunakan perangkat Rumah lain sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV non sarà in grado di controllare gli accessori di sicurezza. Puoi controllarli utilizzando un altro dispositivo nell’app Casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVでセキュリティアクセサリをコントロールできません。その代わり、別の“ホーム”デバイスを使用してアクセサリをコントロールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV는 보안 액세서리를 제어할 수 없지만, 대신 다른 홈 기기를 사용하여 보안 액세서리를 제어할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV tidak akan dapat mengawal aksesori keselamatan. Anda boleh mengawalnya menggunakan peranti Rumah lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil ikke kunne styre sikkerhetstilbehør. Du kan styre dem med en annen Hjem-enhet i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV kan geen beveiligingsaccessoires bedienen. Je kunt ze bedienen via een ander apparaat in je woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterowanie akcesoriami systemu zabezpieczeń przy użyciu Apple TV nie będzie możliwe. Użyj w tym celu innego urządzenia w aplikacji Dom."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não poderá controlar acessórios de segurança. Você pode controlá‑los usando outro dispositivo do app Casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não poderá controlar os acessórios de segurança. Pode controlá‑los através de outro dispositivo com a aplicação Casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul nu va putea să controleze accesoriile de securitate. Le puteți controla utilizând în schimb un alt dispozitiv compatibil cu aplicația Locuință."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не сможет управлять системами защиты дома, но ими можно будет управлять с другого устройства в доме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nebude môcť ovládať bezpečnostné príslušenstvo. Namiesto toho ho môžete ovládať pomocou iných zariadení v domácnosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ne bo mogel upravljati varnostne dodatne opreme. Namesto tega jo lahko upravljate z drugo napravo za Dom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan inte styra säkerhetstillbehör. Du kan istället styra dem med en annan Hem-enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะไม่สามารถควบคุมอุปกรณ์เสริมความปลอดภัยได้ คุณสามารถควบคุมอุปกรณ์เสริมความปลอดภัยได้โดยใช้อุปกรณ์บ้านอื่นแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV güvenlik aksesuarlarını denetleyemez. Aksesuarları başka Ev aygıtlarını kullanarak denetleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не зможе керувати приладами безпеки. Натомість керуйте ними з іншого пристрою в Домі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ không thể điều khiển các phụ kiện an ninh. Thay vào đó, bạn có thể điều khiển chúng bằng một thiết bị Nhà khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将无法控制安全配件。你可以改用另一台家居设备控制它们。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV無法控制保安配件。你可以改用其他「家居」裝置來控制。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV將無法控制安全性配件。你可以改用另一部「家庭」裝置來控制。"
          }
        }
      }
    },
