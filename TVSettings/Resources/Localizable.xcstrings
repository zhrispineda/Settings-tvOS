    "AVEnhanceDialogueLevelEnhanceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبراز صوت الحوار مع أقل تأثير على المزيج الصوتي الأصلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es destaca el diàleg, però sense modificar la combinació d’àudio original."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogy jsou zvýrazněné s minimálním dopadem na původní zvukový mix."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen fremhæves med minimal påvirkning af det originale lydmiks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog wird mit minimaler Auswirkung auf den ursprünglichen Audiomix hervorgehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διάλογος γίνεται περισσότερο διακριτός και έχει ελάχιστο αντίκτυπο στην αρχική μείξη ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is made more prominent with minimal impact to the original audio mix."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is made more prominent with minimal impact to the original audio mix."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is made more prominent with minimal impact to the original audio mix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se amplifica el diálogo sin afectar prácticamente a la mezcla de audio original."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se resaltan casi sin afectar la mezcla de audio original."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se resaltan casi sin afectar la mezcla de audio original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogia korostetaan, mutta alkuperäiseen äänimiksaukseen tehdään vain minimaalisia muutoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues seront mis en avant sans impacter le mix audio original de façon significative."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues sont plus faciles à distinguer avec un effet minimal sur le mix audio original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדיבור יובלט יותר עם השפעה מינימלית על השמע המשולב המקורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल ऑडियो मिक्स पर न्यूनतम प्रभाव डालते हुए डायलॉग को और भी प्रमुखता प्रदान कर दी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijalog je istaknutiji uz minimalan utjecaj na izvorni audio miks."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd jobban ki van emelve, és ez minimális hatással van az eredeti keverés audiomixre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog dibuat lebih menonjol dengan dampak minimal terhadap mixing audio aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dialoghi vengono potenziati con modifiche minime al mix audio originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルのオーディオミックスへの影響を最小限に抑えつつ、対話をより強調します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 오디오 믹스에 미치는 영향은 최소화하면서 대화를 더욱 또렷하게 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog dijadikan lebih menonjol dengan kesan minimum pada campuran audio asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen gjøres tydeligere, men den opprinnelige lydmiksen endres minimalt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen worden prominenter gemaakt met minimale impact op de originele audiomix."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogi są uwydatnione z minimalnym wpływem na inne składniki oryginalnego materiału audio."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diálogo fica mais proeminente, com impacto mínimo sobre o mix de áudio original."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diálogos são mais destacados, com um impacto mínimo na mistura de áudio original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogurile sunt scoase în evidență cu impact minim asupra mixajul audio original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четкость диалогов повышается без значительного изменения оригинального аудиомикса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialógy sú zosilnené s minimálnym vplyvom na originálny mix audia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog je bolj razločen in malo vpliva na prvotno zvočno sliko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen framhävs med minimal påverkan på den ursprungliga ljudmixningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับให้เสียงสนทนาดังขึ้นโดยมีผลต่อเสียงที่ผสมกันในต้นฉบับน้อยที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyaloglar, özgün ses miksine minimum etki ederek daha belirgin hâle getirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діалоги підсилюються з мінімальним впливом на оригінальну аудіодоріжку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hội thoại được làm cho nổi bật hơn với tác động tối thiểu đến âm thanh tổng hợp gốc."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对原始混音影响最低，同时更加突显对话。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對話以最小的影響提升，保留原始混音。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會更加突顯對白，對原有混音的影響最小。"
          }
        }
      }
    },
