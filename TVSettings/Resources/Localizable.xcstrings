        "fr_CA": {
          "stringUnit": {
            "value": "Les apps prenant en charge le format dynamique s’adapteront à votre taille de lecture préférée.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "יישומים שתומכים בכתב דינמי יתאימו את עצמם\nלגודל המלל המועדף שבחרת למטה.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "ऐसे ऐप्स जो डाइनैमिक टाइप का समर्थन करते हैं, आपके निम्न पसंदीदा पठन\nआकार के अनुसार ऐडजस्ट हो जाएँगे।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Aplikacije koje podržavaju Dinamična slova prilagodit će se vašoj\npreferiranoj veličini za čitanje, navedenoj ispod.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A dinamikus betűtípusokat támogató appok az Ön által az alábbiakban\nbeállított olvasási mérethez fognak igazodni.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "App yang mendukung Pengetikan Dinamis akan\ndiatur sesuai ukuran bacaan pilihan Anda\ndi bawah ini.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Le app che supportano il font dinamico\nsi adatteranno alle dimensioni del testo indicate sotto.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "ダイナミックタイプ機能に対応しているアプリでは、下のスライダで指定したサイズでテキストが表示されます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "유동적 글자 크기 조절을 지원하는 앱에서는\n아래 지정된 글자 크기로 텍스트를 표시합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "App yang menyokong Taip Dinamik akan dilaraskan kepada\nsaiz bacaan pilihan anda di bawah.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Apps die dynamische tekst ondersteunen worden aangepast\naan de hieronder ingestelde lettergrootte.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Apper som støtter Dynamisk skrift, justerer seg etter\nskriftstørrelsen du foretrekker.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Aplikacje używające czcionki dynamicznej dostosują\nwielkość tekstu poniżej.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Os apps compatíveis com Fonte Dinâmica se ajustarão ao tamanho de leitura preferido abaixo.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "As aplicações que suportam tipo de letra dinâmico ajustarão o tamanho da letra de acordo com o tamanho definido abaixo.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Aplicațiile compatibile cu funcția „Font dinamic” își vor ajusta dimensiunea textului pe baza configurării dvs. de mai jos.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "В приложениях, поддерживающих функцию «Динамический шрифт»,\nшрифт будет меняться в соответствии с выбранным ниже размером.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Apky podporujúce Dynamické písmo budú používať nižšie špecifikovanú veľkosť písma.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Aplikacije, ki podpirajo dinamično pisavo, se prilagodijo\nspodaj navedeni prednostni bralni velikosti.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Appar med stöd för dynamisk text kommer att\njusteras till lässtorleken nedan.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แอปที่รองรับการปรับข้อความอย่างยืดหยุ่นจะปรับขนาดข้อความ\nตามที่คุณต้องการด้านล่าง",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Dinamik Font’u destekleyen uygulamalar, tercih\nettiğiniz aşağıdaki okuma puntosuna göre ayarlanır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Програми, які підтримують Динамічний шрифт,\nадаптуватимуться до розміру шрифту, заданого нижче.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Các ứng dụng hỗ trợ Kiểu động sẽ điều chỉnh theo kích cỡ đọc ưu tiên của bạn ở bên dưới.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "支持动态字体的App将会调整为\n下方你首选的阅读字体大小。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "支援「動態字體」的App會把文字調整到以下你偏好的字體大小。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "支援「動態字級」的App會把文字調整到下列你偏好的字體大小。",
            "state": "translated"
          }
        }
      }
    },
    "AXVoiceOverPracticeDetails": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يمكنك تنفيذ الإيماءات على ريموت Apple TV للتعرُّف على التعليق الصوتي.\n • قلّب لأعلى أو لأسفل أو يمينًا أو يسارًا لنقل التركيز.\n • قم بتدوير إصبعين لتغيير دوّار التعليق الصوتي.\n",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Fes gestos amb el comandament de l’Apple TV per obtenir informació sobre el VoiceOver.\n • Llisca amunt, avall, a l’esquerra o a la dreta per moure el focus.\n • Gira dos dits per canviar el rotor del VoiceOver.\n",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Funkce VoiceOveru můžete využívat pomocí gest na ovladači Apple TV.\n • Švihnutím nahoru, dolů, doleva nebo doprava přesunete zaměření\n • Otáčením dvěma prsty změníte rotor VoiceOveru\n",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Udfør bevægelser på din Apple TV-fjernbetjening for at lære VoiceOver at kende.\n • Svirp op, ned, til venstre eller højre for at flytte fokus.\n • Roter to fingre for at ændre VoiceOver-rotoren.\n",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Erfahre mehr über VoiceOver, indem du Gesten auf der Apple TV-Fernbedienung ausführst.\n • Streiche nach oben, unten, links oder rechts, um den Fokus zu bewegen.\n • Ändere den VoiceOver-Rotor durch Drehen mit 2 Fingern.\n",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Κάντε χειρονομίες στο Apple TV Remote για εξάσκηση VoiceOver.\n • Τινάξτε πάνω, κάτω, αριστερά, δεξιά για μεταφορά εστίασης.\n • Περιστρέψτε με 2 δάχτυλα για αλλαγή του ρότορα VoiceOver.\n",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Perform gestures on your Apple TV remote to learn about VoiceOver.\n • Flick up, down, left or right to move focus.\n • Rotate two fingers to change the VoiceOver rotor.\n",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Perform gestures on your Apple TV remote to learn about VoiceOver.\n • Flick up, down, left or right to move focus.\n • Rotate two fingers to change the VoiceOver rotor.\n",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Perform gestures on your Apple TV remote to learn about VoiceOver.\n • Flick up, down, left or right to move focus.\n • Rotate two fingers to change the VoiceOver rotor.\n",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Perform gestures on your Apple TV remote to learn about VoiceOver.\n • Flick up, down, left or right to move focus.\n • Rotate two fingers to change the VoiceOver rotor.\n",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Perform gestures on your Apple TV remote to learn about VoiceOver.\n • Flick up, down, left or right to move focus.\n • Rotate two fingers to change the VoiceOver rotor.\n",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Haz gestos en el mando del Apple TV para obtener información sobre VoiceOver.\n • Desliza hacia arriba, abajo, la izquierda o la derecha para mover el enfoque.\n • Gira con dos dedos para cambiar el rotor de VoiceOver.\n",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Haz gestos en el control de tu Apple TV para aprender sobre VoiceOver.\n • Desliza hacia arriba, abajo, izquierda o derecha para mover el enfoque.\n • Gira con 2 dedos para cambiar el rotor de VoiceOver.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Haz gestos en el control de tu Apple TV para aprender sobre VoiceOver.\n • Desliza hacia arriba, abajo, izquierda o derecha para mover el enfoque.\n • Gira con 2 dedos para cambiar el rotor de VoiceOver.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Opi käyttämään VoiceOveria tekemällä eleitä Apple TV -kaukosäätimellä.\n • Siirrä kohdistinta pyyhkäisemällä ylös, alas, vasemmalle tai oikealle.\n • Pyöritä kahdella sormella vaihtaaksesi VoiceOver-roottoria.\n",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Les gestes sur votre télécommande Apple TV vous en disent plus sur VoiceOver.\n • Faites glisser le doigt dans tous les sens pour déplacer la cible.\n • Faites pivoter 2 doigts pour modifier le rotor VoiceOver.\n",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Effectuez des gestes sur la télécommande de votre Apple TV pour découvrir VoiceOver.\n • Effleurez vers le haut, le bas, la gauche ou la droite pour déplacer la mise au point.\n • Pivotez avec deux doigts pour changer le rotor.\n",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן לבצע מחוות בשלט ה-Apple TV כדי ללמוד עוד בנושא VoiceOver.\n • יש להחליק מעלה, מטה, שמאלה או ימינה כדי להזיז את המיקוד.\n • יש לסובב שתי אצבעות כדי לשנות את החוגה של VoiceOver.\n",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver के बारे में जानने के लिए Apple TV रिमोट पर जेस्चर बनाएँ।\n • फ़ोकस को एक स्थान से दूसरे पर ले जाने के लिए ऊपर, नीचे, बाएँ या दाएँ फ़्लिक करें।\n • VoiceOver रोटर को बदलने के लिए दो उँगलियाँ घुमाएँ।\n",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Za dodatne informacije o VoiceOveru, napravite geste na upravljaču Apple TV Remote.\n • Prelazite prstom prema gore, dolje, lijevo ili desno za pomicanje fokusa.\n • Rotirajte s dva prsta za promjenu VoiceOver rotora.\n",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Végezzen kézmozdulatokat az Apple TV távirányítón a VoiceOver megismeréséhez.\n • Pöccintsen felfelé, lefelé, balra vagy jobbra a fókusz mozgatásához.\n • Forgassa két ujját a VoiceOver-rotor módosításához.\n",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Lakukan gerakan di remote Apple TV Anda untuk mempelajari VoiceOver.\n • Gesek ke atas, bawah, kiri, atau kanan untuk memindahkan fokus.\n • Putar dengan dua jari untuk mengubah rotor VoiceOver.\n",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Esegui le azioni sul telecomando per Apple TV per imparare a usare VoiceOver.\n • Scorri verso l’alto, verso il basso, verso destra o verso sinistra per spostare la selezione.\n • Ruota con due dita per modificare il rotore di VoiceOver.\n",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "Apple TVのリモコンでジェスチャを実行して、VoiceOverについて学習します。\n • フォーカスを移動するには、上下左右にフリックします。\n • VoiceOverローターを変更するには、2本指を回転させます。\n",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "Apple TV 리모컨에서 동작을 수행하여 VoiceOver에 관하여 배우십시오.\n • 상하좌우로 휙 넘겨서 초점 이동하기.\n • 두 손가락으로 회전해서 VoiceOver 로터 변경하기.\n",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Lakukan gerak isyarat pada kawalan jauh Apple TV anda untuk mengetahui tentang VoiceOver.\n • Kuis ke atas, bawah, kiri atau kanan untuk mengalihkan fokus.\n • Putar dua jari untuk menukar rotor VoiceOver.\n",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Gebruik gebaren op de afstands­bediening van je Apple TV voor meer informatie over VoiceOver.\n • Veeg omhoog, omlaag, naar links of naar rechts om de focus te verplaatsen.\n • Draai met 2 vingers om de VoiceOver-rotor te wijzigen.\n",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Utfør bevegelser på Apple TV-fjernkontrollen for å lære mer om VoiceOver.\n • Sveip opp, ned, mot høyre eller venstre for å flytte fokus.\n • Vri med to fingre for å endre VoiceOver-rotoren.\n",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Aby dowiedzieć się, jak używać VoiceOver, wykonuj gesty na pilocie Apple TV.\n • Przesuń w górę, w dół, w lewo lub w prawo, aby przechodzić między elementami.\n • Przekręć dwa palce, aby przestawić pokrętło VoiceOver.\n",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Faça gestos no controle remoto da Apple TV para aprender sobre o VoiceOver.\n • Passe o dedo para cima, para baixo, para a esquerda ou para a direita para mover o foco.\n • Gire dois dedos para alterar o rotor do VoiceOver.\n",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Para aprender a usar o VoiceOver, faça gestos no comando da Apple TV.\n • Passe o dedo rapidamente para cima, para baixo, para a esquerda ou para a direita para mover o foco.\n • Rode com dois dedos para alterar o rotor do VoiceOver.\n",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Efectuați gesturi pe telecomanda Apple TV‑ului pentru a învăța despre VoiceOver.\n • Glisați în sus, în jos, la stânga sau la dreapta pentru a muta focalizarea.\n • Rotiți două degete pentru a modifica rotorul VoiceOver.\n",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Для ознакомления с VoiceOver выполните следующие жесты на пульте Apple TV:\n • Проведите пальцем вверх, вниз, влево или вправо, чтобы переместить фокус.\n • Переместите ротор VoiceOver, покрутив его двумя пальцами.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Pomocou gest na ovládači Apple TV sa dozviete viac o funkcii VoiceOver.\n • Rýchlym potiahnutím nahor, nadol alebo do strán presúvate zameranie.\n • Otočením dvoch prstov zmeníte rotor funkcie VoiceOver.\n",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Izvedite kretnje na daljincu Apple TV Remote, da se seznanite s funkcijo VoiceOver.\n • Za premikanje fokusa frcnite navzgor, navzdol, levo ali desno.\n • Za spreminjanje rotorja funkcije VoiceOver zasukajte prsta.\n",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Utför gester på Apple TV-fjärrkontrollen om du vill lära dig mer om VoiceOver.\n • Flytta fokus genom att dra snabbt uppåt, nedåt, åt vänster eller åt höger.\n • Ändra VoiceOver-rotorn genom att rotera med två fingrar.\n",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ทำคำสั่งนิ้วบน Apple TV Remote ของคุณเพื่อเรียนรู้เกี่ยวกับ VoiceOver\n • ตวัดขึ้น ตวัดลง ตวัดซ้าย ตวัดขวาเพื่อเลื่อนโฟกัส\n • ใช้สองนิ้วหมุนไปมาเพื่อเปลี่ยนตัวหมุน VoiceOver\n",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver hakkında bilgi edinmek için Apple TV kumandanızda hareketler gerçekleştirin.\n • Odağı taşımak için yukarı, aşağı, sola veya sağa itin.\n • VoiceOver rotorunu değiştirmek için iki parmağınızı döndürün.\n",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Жести на пульті Apple TV для знайомства з VoiceOver.\n • Посувайте вгору, вниз, вліво чи вправо, щоб рухати фокус.\n • Обертайте двома пальцями, щоб крутити ротор VoiceOver.\n",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Thực hiện các cử chỉ trên Apple TV Remote để tìm hiểu về VoiceOver.\n • Vuốt lên, xuống, sang trái hoặc phải để di chuyển tiêu điểm.\n • Xoay hai ngón tay để thay đổi rô-to VoiceOver.\n",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "在Apple TV遥控器上练习手势来学习“旁白”。\n • 上下左右滑动来移动焦点。\n • 旋转双指更改“旁白”转子。\n",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "在Apple TV遙控器上運用手勢以了解「旁白」的功能。\n• 向上，向下，向左或向右掃以移動焦點。\n• 用兩隻手指旋轉以更改「旁白」的轉輪。\n",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "在Apple TV遙控器上執行手勢來瞭解「旁白」。\n • 上下左右滑動來移動焦點。\n • 用兩指旋轉來更改「旁白」轉輪。\n",
            "state": "translated"
          }
        }
      }
    },
