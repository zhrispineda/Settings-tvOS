          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV usará el formato de visualización que tenías seleccionado para reproducir contenido sin modificarlo. También puede cambiar el formato automáticamente para ajustarlo a la frecuencia de fotogramas del contenido."
          }
        },
        "es_419": {
