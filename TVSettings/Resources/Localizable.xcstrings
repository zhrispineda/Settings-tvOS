    "AVEnhanceDialogueLevelEnhanceMoreDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة تضخيم صوت الحوار، لكن قد يتغير المزيج الصوتي الأصلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’amplifica més el diàleg, però pot alterar la combinació d’àudio original."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogy jsou zvýrazněné ještě víc, ale může dojít ke změně původního zvukového mixu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen forstærkes yderligere, men det kan forandre det originale lydmiks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog wird weiter verstärkt, der ursprüngliche Audiomix kann sich dadurch allerdings verändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διάλογος ενισχύεται περαιτέρω αλλά ενδέχεται να αλλοιώσει την αρχική μείξη ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is further amplified, but may alter the original audio mix."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is further amplified, but may alter the original audio mix."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue is further amplified, but may alter the original audio mix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se amplifica el diálogo, pero afecta a la mezcla de audio original."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se escucharán amplificados y eso podría alterar la mezcla de audio original."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diálogos se escucharán amplificados y eso podría alterar la mezcla de audio original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogia korostetaan edelleen, mutta alkuperäistä äänimiksausta saatetaan muuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues seront davantage amplifiés, toutefois, ce réglage pourra affecter le mix audio original."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues sont davantage amplifiés, mais le mix audio original pourrait être altéré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדיבור יובלט עוד יותר, אך עלול לשנות את השמע המשולב המקורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायलॉग को और भी ऐंप्लिफ़ाई कर दिया जाता है, लेकिन इससे मूल ऑडियो मिक्स में बदलाव हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijalog se dodatno pojačava, ali može promijeniti izvorni audio miks."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd jobban fel van erősítve, ez azonban hatással lehet az eredeti audiomixre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog semakin ditingkatkan, tapi dapat mengubah mixing audio aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dialoghi vengono ulteriormente amplificati, ma il mix audio originale potrebbe risultare alterato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対話がさらに強調されますが、オリジナルのオーディオミックスが変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 더욱 증폭되지만, 원본 오디오 믹스가 변경될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog dikuatkan selanjutnya, tetapi mungkin mengubah campuran audio asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen forsterkes ytterligere, og kan endre den opprinnelige lydmiksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen worden verder versterkt, maar de originele audiomix kan veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogi będą wzmacniane jeszcze bardziej, ale może to wpłynąć na inne składniki oryginalnego materiału audio."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diálogo é mais amplificado, mas isso pode alterar o mix de áudio original."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diálogos são ainda mais reforçados, podendo alterar a mistura de áudio original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogurile sunt amplificate suplimentar, dar mixajul audio original poate fi alterat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалоги дополнительно усиляются, что может изменить оригинальное звучание аудиомикса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialógy sú o niečo viac zosilnené, čo môže ovplyvniť originálny mix audia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialog je dodatno ojačan, vendar lahko spremeni prvotno zvočno sliko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogen framhävs ytterligare, men den ursprungliga ljudmixningen kan ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเสียงสนทนาให้ดังขึ้น โดยอาจทำให้เสียงที่ผสมกันในต้นฉบับเปลี่ยนไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyalogların sesi daha da artırılır ama özgün ses miksi değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діалоги значно підсилюються, але це може вплинути на оригінальну аудіодоріжку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hội thoại được khuếch đại thêm, nhưng có thể làm thay đổi âm thanh tổng hợp gốc."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "进一步放大对话声音，但可能会改变原始混音。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "進一步放大對話的音量，但可能會改變原始混音。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "對白會進一步擴大，但可能會改變原有混音。"
          }
        }
      }
    },
