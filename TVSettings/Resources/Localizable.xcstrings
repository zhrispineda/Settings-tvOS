    "RemoteAppUnpairInstructions": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إزالة هذا الريموت، لن تتمكن من استخدامه للتحكم في هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan eliminis aquest comandament ja no el podràs utilitzar per controlar l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud tento ovladač odstraníte, nebudete jej moci používat k ovládání Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du fjerner denne fjernbetjening, kan du ikke bruge den til at betjene dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diese Fernbedienung entfernst, kannst du sie nicht mehr zum Steuern dieses Apple TV verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αφαιρέσετε αυτό το τηλεχειριστήριο, δεν μπορείτε μετά να το χρησιμοποιήσετε για έλεγχο αυτού του Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you remove this remote, you won’t be able to use it to control this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "When you remove this remote, you won’t be able to use it to control this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you remove this remote, you won’t be able to use it to control this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliminas este mando a distancia, no podrás utilizarlo para controlar este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar este control, no podrás usarlo para controlar este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar este control, no podrás usarlo para controlar este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos poistat tämän kaukosäätimen, et voi käyttää sitä tämän Apple TV:n ohjaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous supprimez cette télécommande, vous ne pourrez plus l’utiliser pour contrôler cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous supprimez cette télécommande, vous ne serez plus en mesure de contrôler cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרה של שלט זה לא תאפשר לך להשתמש בו כדי לשלוט ב-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिमोट को हटाने पर आप इस Apple TV को उसके माध्यम से नियंत्रित नहीं कर पाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon što uklonite ovaj upravljač, više ga nećete moći koristiti za upravljanje ovim Apple TV‑om."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha eltávolítja ezt a távirányítót, nem fogja tudni használni ennek az Apple TV-nek a vezérlésére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda menghapus remote ini, Anda tidak akan dapat menggunakannya untuk mengontrol Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rimuovi questo telecomando, non sarai in grado di utilizzarlo per controllare Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリモコンを削除すると、そのリモコンを使ってApple TVを操作できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리모컨을 제거하면 Apple TV를 이 리모컨으로 제어할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda mengeluarkan kawalan jauh ini, anda tidak akan dapat menggunakannya untuk mengawal Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du fjerner denne fjernkontrollen, kan du ikke bruke den til å styre Apple TV lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je deze afstandsbediening verwijdert, kun je deze Apple TV er niet meer mee bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po usunięciu tego pilota nie będzie można go używać do sterowania Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se remover este controle remoto, você não poderá usá-lo para controlar esta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se remover este comando, deixará de poder controlar esta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă eliminați această telecomandă, nu o veți mai putea utiliza pentru a controla acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалив этот пульт, Вы не сможете использовать его для управления данным Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento ovládač nebude po odstránení možné používať na ovládanie tohto Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko odstranite ta daljinec, ga ne boste mogli več uporabljati za upravljanje tega Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tar bort den här fjärrkontrollen kan du inte använda den till att styra denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณเอารีโมทนี้ออก คุณจะไม่สามารถใช้รีโมทนี้ควบคุม Apple TV เครื่องนี้ได้อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kumandayı silerseniz, bu Apple TV’yi denetlemek için onu kullanamazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви вилучите цей пульт, ви не зможете використовувати його для керування цим Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn xóa điều khiển từ xa này, bạn sẽ không thể sử dụng thiết bị để điều khiển Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此遥控器后，你将无法用其控制这台Apple TV。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當移除此遙控器時，你將無法使用它控制此Apple TV。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當你移除此遙控器時，你將無法用它來控制此Apple TV。"
          }
        }
      }
