    "SaverStartDelayDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبدأ شاشة التوقف عندما يكون التلفزيون في وضع خمول للفترة الزمنية التي تختارها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’iniciarà l’estalvi de pantalla quan el televisor hagi estat inactiu durant el temps seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spořič obrazovky se spustí, když bude televizor po vámi zvolenou dobu neaktivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmskåneren starter, når dit fjernsyn har været passivt i det valgte tidsrum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirmschoner wird aktiviert, wenn das TV-Gerät für die von dir festgelegte Zeit inaktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προφύλαξη οθόνης ξεκινά όταν η τηλεόραση είναι ανενεργή για το χρονικό διάστημα που έχετε επιλέξει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver will start when your TV is inactive for the amount of time you choose."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver will start when your TV is inactive for the amount of time you choose."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen saver will start when your TV is inactive for the amount of time you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El salvapantallas se iniciará cuando el televisor lleve inactivo el periodo de tiempo que hayas seleccionado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El protector de pantalla se iniciará cuando la TV permanezca inactiva el periodo de tiempo que selecciones."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El protector de pantalla se iniciará cuando la TV permanezca inactiva el periodo de tiempo que selecciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytönsäästäjä käynnistyy, kun TV on käyttämättä valitsemasi ajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran se lancera lorsque votre téléviseur sera inactif pendant la durée que vous avez choisie."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’économiseur d’écran s’affichera sur votre télévision après la période d’inactivité de votre choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר המסך מוצג כשהטלוויזיה אינה פעילה למשך פרק הזמן שבחרת מראש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन सेवर शुरू हो जाएगा जब आपका TV उतने समय के लिए निष्क्रिय रहता है जो आपने चुना है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaštita zaslona pokrenut će se kada je vaš TV neaktivan za vrijeme koje ste odabrali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyővédő elindul, miután a TV a megadott időtartamon át inaktív."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghemat layar akan dimulai saat TV Anda tidak aktif selama waktu yang Anda pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvaschermo si avvierà quando Apple TV rimane inattiva per il periodo di tempo da te scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンセーバは、TVが使用されていない状態が選択した時間続いたときに開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간 동안 TV가 비활성 상태인 경우 화면 보호기가 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelamat skrin akan bermula apabila TV anda tidak aktif selama tempoh masa yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermspareren starter når Apple TV har vært inaktiv i den angitte mengden med tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermbeveiliging wordt gestart wanneer je tv gedurende de opgegeven tijd inactief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygaszacz ekranu będzie uruchamiany po upłynięciu wskazanego czasu braku aktywności telewizora."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O protetor de tela será iniciado quando a TV estiver inativa pelo tempo que você definir."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção de ecrã será iniciada quando a televisão estiver inativa pelo período de tempo que selecionou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Screensaverul va porni dacă TV‑ul este inactiv pe o perioadă aleasă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставка будет запускаться после выбранного Вами времени бездействия телевизора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šetrič obrazovky sa spustí, keď bude televízor nečinný po dobu, ktorú vyberiete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohranjevalnik zaslona se zažene po nastavljenem času nedejavnosti Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmsläckaren startar när TV:n har varit inaktiv under den tidslängd som du har valt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพพักหน้าจอจะเริ่มต้นเมื่อทีวีของคุณไม่ได้ใช้งานตามระยะเวลาที่คุณเลือกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV’niz seçtiğiniz süre boyunca kullanılmazsa ekran koruyucu otomatik olarak başlatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранна заставка зʼявлятиметься, якщо телевізор не використовується протягом заданого часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình bảo vệ màn hình sẽ bắt đầu khi TV không hoạt động trong khoảng thời gian mà bạn chọn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "电视闲置达到所选时长时，将启动屏幕保护程序。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當電視閒置達到你所選擇的時間時，螢幕保護程式將會啟動。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當電視達到你選擇的閒置時間，螢幕保護程式便會啟動。"
          }
        }
      }
    },
