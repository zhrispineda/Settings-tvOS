    "NetworkConfigureEthernetDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على معظم الشبكات، يمكنك تحديد \"تلقائي\". إذا كنت تستخدم شبكة مخصصة مع عناوين IP معينة، فحدد \"يدوي\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En el cas de la majoria de xarxes pots seleccionar “Automàtic”. Si ets en una xarxa personalitzada amb adreces IP assignades, selecciona “Manual”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro většinu sítí můžete vybrat volbu Automaticky. V případě, že jste připojení k síti s přiřazenou IP adresou, vyberte volbu Ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan vælge Automatisk til de fleste netværk. Hvis du er på et specielt netværk med bestemte IP-adresser, skal du vælge Manuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die meisten Netzwerke kannst du „Automatisch“ auswählen. Wenn du ein angepasstes Netzwerk mit speziell zugewiesenen IP-Adressen verwendest, wähle „Manuell“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τα περισσότερα δίκτυα, μπορείτε να επιλέξετε «Αυτόματα». Αν συνδέεστε σε προσαρμοσμένο δίκτυο με εκχωρημένες διευθύνσεις IP, επιλέξτε «Χειροκίνητα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you’re on a custom network with assigned IP addresses, select Manual."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you’re on a custom network with assigned IP addresses, select Manual."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you’re on a custom network with assigned IP addresses, select Manual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar la opción Automática. Si te has conectado a una red personalizada con direcciones IP asignadas, selecciona Manual."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar Automática. Si usas una red personalizada con direcciones IP asignadas, selecciona Manual."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar Automática. Si usas una red personalizada con direcciones IP asignadas, selecciona Manual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit valita useimmille verkoille Automaattisesti. Jos verkko on asetettu käyttämään kiinteitä IP-osoitteita, valitse Käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez sélectionner Automatique pour la plupart des réseaux. Si vous êtes sur un réseau personnalisé avec adresses IP attribuées spécifiquement, sélectionnez Manuelle."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez sélectionner Automatique pour la plupart des réseaux. Si votre appareil est connecté à un réseau personnalisé dont les adresses IP sont attribuées de façon spécifique, sélectionnez Manuel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוב הרשתות ניתן לבחור באפשרות ״אוטומטית״. אם התחברת לרשת המותאמת באופן אישי שהוקצו בה כתובות IP, יש לבחור ״ידנית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकांश नेटवर्क के लिए आप “ऑटोमैटिक” चुन सकते हैं। अगर आप असाइन किए गए IP पतों वाले कस्टम नेटवर्क पर हैं, तो “मैनुअल” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za većinu mreža možete odabrati Automatski. Ako imate prilagođenu mrežu s pridruženim IP adresama, odaberite Ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbb hálózat esetén választhatja az Automatikus beállítást. Ha egyéni hálózattal és külön hozzárendelt IP-címekkel rendelkezik, válassza a Kézi lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sebagian besar jaringan, Anda dapat memilih Otomatis. Jika Anda menggunakan jaringan khusus dengan alamat IP yang ditentukan, pilih Manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la maggior parte delle reti, puoi selezionare Automatico. Se la tua è una rete personalizzata con indirizzi IP assegnati, seleziona Manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのネットワークでは“自動”を選択できます。IPアドレスを割り当てたカスタムネットワークの場合は“手動”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 네트워크는 자동을 선택하면 됩니다. IP 주소가 할당된 사용자 설정 네트워크를 사용하는 경우에는 수동을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kebanyakan rangkaian, anda boleh memilih Automatik. Jika anda menggunakan rangkaian tersuai dengan alamat IP yang ditetapkan, pilih Manual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På de fleste nettverk kan du velge Automatisk. Hvis du er på et tilpasset nettverk med tilordnede IP-adresser, velger du Manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de meeste netwerken kun je 'Automatisch' selecteren. Als je een aangepast netwerk met toegewezen IP-adressen hebt, selecteer je 'Handmatig'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku większości sieci możesz wybrać opcję Automatycznie. Jeśli masz sieć ze stałymi adresami IP, wybierz opcję Ręcznie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na maioria das redes, você pode selecionar Automático. Se você estiver em uma rede personalizada com endereços IP atribuídos, selecione Manual."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a maioria das redes, pode selecionar Automaticamente. Se estiver numa rede personalizada com endereços IP atribuídos, selecione Manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru majoritatea rețelelor, puteți selecta Automat. Dacă vă aflați într‑o rețea personalizată cu adrese IP alocate, selectați Manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для большинства сетей можно выбрать значение «Автоматически». Если у Вас собственная сеть с назначенными IP‑адресами, выберите вариант «Вручную»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre väčšinu sietí stačí zvoliť Automatické. Ak máte vlastnú sieť s pridelenými IP adresami, vyberte Manuálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri večini omrežij lahko izberete možnost Samodejno. Če uporabljate omrežje po meri z dodeljenimi naslovi IP, izberite možnost Ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För de flesta nätverk kan du välja Automatiskt. Om du har ett specialanpassat nätverk med tilldelade IP-adresser väljer du Manuellt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเลือกอัตโนมัติเพื่อใช้งานกับเครือข่ายส่วนใหญ่ได้ ถ้าคุณใช้เครือข่ายที่กำหนดที่อยู่ IP เอง ให้เลือกกำหนดเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu ağ için Otomatik’i seçebilirsiniz. Atanmış IP adreslerine sahip özel bir ağdaysanız Elle’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для більшості мереж можна вибрати варіант «Автоматично». Для власної мережі з призначеними IP‑адресами оберіть варіант «Вручну»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối với hầu hết các mạng, bạn có thể chọn Tự động. Nếu bạn đang sử dụng mạng tùy chỉnh với địa chỉ IP được gán, hãy chọn Thủ công."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "大部分网络选用“自动”即可。但是如果你使用指定IP地址的自定义网络，请选择“手动”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對於大部份網絡，你可以選擇「自動」。如你有已指定IP位址的自訂網絡，請選擇「手動」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "對大部分的網路而言，你可以選取「自動」。若你位於具有指定IP位址的自訂網路，請選取「手動」。"
          }
        }
      }
    },
    "NetworkConfigureEthernetDNSDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على معظم الشبكات، يمكنك تحديد \"تلقائي\". إذا كنت بحاجة إلى تحديد خادم DNS مخصص، فحدد \"يدوي\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En el cas de la majoria de xarxes pots seleccionar “Automàtic”. Si has de seleccionar un servidor DNS personalitzat, selecciona “Manual”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro většinu sítí můžete vybrat volbu Automaticky. V případě, že používáte vlastní DNS server, vyberte volbu Ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan vælge Automatisk til de fleste netværk. Hvis du skal vælge en speciel DNS-server, skal du vælge Manuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die meisten Netzwerke kannst du „Automatisch“ auswählen. Wenn du einen eigenen DNS-Server auswählen musst, wähle „Manuell“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τα περισσότερα δίκτυα, μπορείτε να επιλέξετε «Αυτόματα». Αν θέλετε να επιλέξετε έναν προσαρμοσμένο διακομιστή DNS, επιλέξτε «Χειροκίνητα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you need to select a custom DNS server, select Manual."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you need to select a custom DNS server, select Manual."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For most networks, you can select Automatic. If you need to select a custom DNS server, select Manual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar la opción Automática. Si tienes que elegir un servidor DNS personalizado, selecciona Manual."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar Automática. Si tienes que elegir un servidor DNS personalizado, selecciona Manual."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la mayoría de las redes, puedes seleccionar Automática. Si tienes que elegir un servidor DNS personalizado, selecciona Manual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit valita useimmille verkoille Automaattisesti. Jos sinun on valittava muokattu DNS-palvelin, valitse Käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez sélectionner Automatique pour la plupart des réseaux. Si vous devez sélectionner un serveur DNS personnalisé, sélectionnez Manuelle."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez sélectionner Automatique pour la plupart des réseaux. Si vous devez sélectionner un serveur DNS personnalisé, sélectionnez Manuel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוב הרשתות ניתן לבחור באפשרות ״אוטומטית״. אם יש צורך לבחור שרת DNS המותאם באופן אישי, יש לבחור ״ידנית״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकांश नेटवर्क के लिए आप “ऑटोमैटिक” चुन सकते हैं। अगर आपको कस्टम DNS सर्वर चुनने की आवश्यकता है, तो “मैनुअल” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za većinu mreža možete odabrati Automatski. Ako trebate odabrati prilagođeni DNS server, odaberite Ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbb hálózat esetén választhatja az Automatikus beállítást. Ha egyéni DNS-kiszolgálót kell választania, válassza a Kézi lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sebagian besar jaringan, Anda dapat memilih Otomatis. Jika Anda ingin memilih server DNS khusus, pilih Manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la maggior parte delle reti, puoi selezionare Automatico. Se è necessario selezionare un server DNS personalizzato, scegli Manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのネットワークでは“自動”を選択できます。カスタムDNSサーバを選択する必要がある場合は“手動”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 네트워크는 자동을 선택하면 됩니다. 사용자 설정 DNS 서버를 선택해야 하는 경우에는 수동을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kebanyakan rangkaian, anda boleh memilih Automatik. Jika anda perlu memilih pelayan DNS tersuai, pilih Manual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På de fleste nettverk kan du velge Automatisk. Hvis du må selv angi en DNS-tjener, velger du Manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de meeste netwerken kun je 'Automatisch' selecteren. Als je een aangepaste DNS-server moet selecteren, selecteer je 'Handmatig'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku większości sieci możesz wybrać opcję Automatycznie. Jeśli musisz użyć własnego serwera DNS, wybierz opcję Ręcznie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na maioria das redes, você pode selecionar Automático. Se você tiver que selecionar um servidor DNS personalizado, selecione Manual."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a maioria das redes, pode selecionar Automaticamente. Se tiver de escolher um servidor DNS personalizado, selecione Manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru majoritatea rețelelor, puteți selecta Automat. Dacă trebuie să selectați un server DNS personalizat, selectați Manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для большинства сетей можно выбрать значение «Автоматически». Если Вам нужно указать собственный DNS‑сервер, выберите вариант «Вручную»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre väčšinu sietí stačí zvoliť Automatické. Ak potrebujete nastaviť vlastný DNS server, vyberte Manuálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri večini omrežij lahko izberete možnost Samodejno. Če želite izbrati strežnik DNS po meri, izberite možnost Ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För de flesta nätverk kan du välja Automatiskt. Om du måste välja en anpassad DNS-server väljer du Manuellt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเลือกอัตโนมัติเพื่อใช้งานกับเครือข่ายส่วนใหญ่ได้ ถ้าคุณต้องเลือกเซิร์ฟเวอร์ DNS แบบกำหนดเอง ให้เลือกกำหนดเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu ağ için Otomatik’i seçebilirsiniz. Özel bir DNS sunucu seçmeniz gerekiyorsa Elle’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для більшості мереж можна вибрати варіант «Автоматично». Якщо потрібно вибрати власний сервер DNS, оберіть варіант «Вручну»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối với hầu hết các mạng, bạn có thể chọn Tự động. Nếu bạn cần chọn một máy chủ DNS tùy chỉnh, hãy chọn Thủ công."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "大部分网络选用“自动”即可。但是如果你需要选择自定义DNS服务器，请选择“手动”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對於大部份網絡，你可以選擇「自動」。如你需要選擇自訂的DNS伺服器，請選擇「手動」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "對大部分的網路而言，你可以選取「自動」。若你需要選擇自訂DNS伺服器，請選取「手動」。"
          }
        }
      }
    },
