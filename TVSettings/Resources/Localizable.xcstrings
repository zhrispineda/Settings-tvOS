    "APNameDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تسمية Apple TV الخاص بك للتعرف عليه بسهولة عند استخدام البث السريع والمشاركة المنزلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots posar un nom a l’Apple TV per reconèixer‑lo més fàcilment quan utilitzis l’AirPlay o l’ús compartit a casa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svou Apple TV můžete pojmenovat, takže ji při práci s AirPlay a domácím sdílením snadno poznáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan give Apple TV et navn, så det bliver lettere at genkende enheden, når du bruger AirPlay og Deling i hjemmet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dein Apple TV benennen, damit es einfacher erkannt wird, wenn du AirPlay und die Privatfreigabe verwendest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να ονομάσετε το Apple TV για να είναι ευκολότερο να το αναγνωρίζετε όταν χρησιμοποιείτε το AirPlay και την Οικιακή κοινή χρήση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can name your Apple TV to make it easy to recognize when you use AirPlay and Home Sharing."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can name your Apple TV to make it easy to recognise when you use AirPlay and Home Sharing."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can name your Apple TV to make it easy to recognise when you use AirPlay and Home Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes asignar un nombre al Apple TV para que sea más fácil de reconocer al utilizar AirPlay y “Compartir en casa”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes darle un nombre a tu Apple TV para que sea más fácil reconocerlo al usar AirPlay y Compartir en casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes darle un nombre a tu Apple TV para que sea más fácil reconocerlo al usar AirPlay y Compartir en casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nimetä Apple TV:n, jotta se on helppo tunnistaa käytettäessä AirPlayta ja Kotijakoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un nom à votre Apple TV pour la reconnaître plus facilement lorsque vous utilisez AirPlay et Partage à domicile."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez nommer votre Apple TV pour la reconnaître plus facilement lorsque vous utilisez AirPlay et le partage à domicile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להעניק ל-Apple TV שם כדי לזהות אותו בקלות רבה יותר במהלך שימוש ב-AirPlay וב״שיתוף ביתי״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay और होम शेयरिंग का उपयोग करते समय अपने Apple TV को पहचानने के लिए आप उसे कोई नाम दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete dodijeliti naziv vašem Apple TV‑u kako biste ga lakše prepoznali kad koristite AirPlay i Dijeljenje unutar doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevet adhat az Apple TV-jének, hogy egyszerűbben felismerje az AirPlay és az Otthoni megosztás használatakor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menamai Apple TV agar mudah dikenali saat Anda menggunakan AirPlay dan Berbagi Rumah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi assegnare un nome ad Apple TV e fare in modo che sia più facilmente riconoscibile quando utilizzi AirPlay e l’opzione “In casa”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVに名前を付けると、AirPlayおよびホームシェアリングを使用するときに見つけやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 및 홈 공유를 사용할 때 더 쉽게 인식할 수 있도록 Apple TV의 이름을 지정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menamakan Apple TV anda untuk memudahkan ia dikenali apabila anda menggunakan AirPlay dan Perkongsian Rumah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gi et navn til Apple TV så det er lettere å kjenne igjen enheten når du bruker AirPlay og Hjemmedeling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je Apple TV een naam zodat deze eenvoudiger te herkennen is wanneer je AirPlay en thuisdeling gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby Apple TV był łatwo rozpoznawalny, gdy korzystasz z AirPlay i Kolekcji domowej, możesz mu nadać nazwę."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode dar um nome a esta Apple TV para reconhecê-la quando usar o AirPlay e o Compartilhamento Pessoal."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode atribuir um nome à Apple TV para ser mais fácil de reconhecer quando usa AirPlay e a Partilha doméstica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți să denumiți Apple TV‑ul dvs. pentru a‑l recunoaște cu ușurință atunci când utilizați AirPlay și Partajare casnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете присвоить своему Apple TV имя, чтобы легче узнавать устройство при использовании AirPlay и Домашней коллекции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Svoje Apple TV môžete pomenovať, takže bude ľahko rozpoznateľné pri používaní AirPlay a Domáceho zdieľania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV lahko poimenujete, da ga boste lažje prepoznali, ko uporabljate funkciji AirPlay in Souporaba doma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ge din Apple TV ett namn så att den blir lättare att känna igen när du använder AirPlay och Hemmadelning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถตั้งชื่อ Apple TV ของคุณเพื่อจะได้เลือกถูกเครื่องเมื่อคุณใช้ AirPlay และการแชร์ภายในพื้นที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay’i ve Ev Paylaşımı’nı kullanırken daha kolay tanıyabilmek için Apple TV’nize bir ad verebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна дати своєму Apple TV нетипову назву, щоб його було легше знайти, коли ви користуєтесь AirPlay і Домашньою колекцією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đặt tên cho Apple TV để dễ nhận biết khi bạn sử dụng AirPlay và Home Sharing."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以给Apple TV命名以在使用隔空播放和“家庭共享”时更易辨识。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以為你的Apple TV命名，以便使用AirPlay及「家庭共享」時更容易辨認有關裝置。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以為Apple TV命名，方便你在使用AirPlay和「家庭共享」時進行識別。"
          }
        }
      }
    },
