    "ResetConfirmationText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إعادة تعيين Apple TV إلى إعدادات المصنع ومسح جميع الإعدادات والمعلومات؟ سيلزم إعداد Apple TV مرة أخرى.\n\nيرجى التأكد من إبقاء Apple TV متصلاً بالطاقة أثناء إعادة التعيين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols restaurar la configuració de fàbrica de l’Apple TV i esborrar‑ne els paràmetres i tota la informació? Hauràs de tornar a configurar l’Apple TV.\n\nMentre restableixis l’Apple TV, vigila que no es desconnecti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete resetovat nastavení Apple TV a smazat všechna svoje nastavení a data? Apple TV bude nutné nastavit znovu.\n\nV průběhu resetování musí být Apple TV připojená ke zdroji napájení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil nulstille Apple TV til fabriksindstillinger og slette alle indstillinger og oplysninger? Du vil skulle indstille Apple TV igen.\n\nSørg for, at Apple TV forbliver sluttet til en stikkontakt, mens det nulstilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du dein Apple TV wirklich auf die Werkseinstellungen zurücksetzen und alle Einstellungen und Informationen löschen? Du musst das Apple TV dann erneut konfigurieren.\n\nStelle sicher, dass dein Apple TV während des Zurücksetzens am Stromnetz angeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να γίνει επαναφορά του Apple TV στις εργοστασιακές ρυθμίσεις και να σβηστούν όλες οι ρυθμίσεις και οι πληροφορίες; Θα χρειαστεί να διαμορφώσετε εκ νέου το Apple TV σας.\n\nΒεβαιωθείτε ότι το Apple TV είναι συνδεδεμένο στο ρεύμα κατά τη διάρκεια της επαναφοράς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your Apple TV to factory settings and erase all settings and information? You’ll need to set up your Apple TV again.\n\nMake sure your Apple TV stays plugged in while it resets."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your Apple TV to factory settings and erase all settings and information? You’ll need to set up your Apple TV again.\n\nMake sure your Apple TV stays plugged in while it resets."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset your Apple TV to factory settings and erase all settings and information? You’ll need to set up your Apple TV again.\n\nMake sure your Apple TV stays plugged in while it resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres restablecer los ajustes originales del Apple TV y borrar todos los ajustes y los datos? Deberás configurar el Apple TV de nuevo.\n\nAsegúrate de que el Apple TV permanece enchufado durante este proceso."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres restablecer tu Apple TV a la configuración predeterminada y borrar toda su configuración y datos? Tendrás que configurarlo de nuevo.\n\nAsegúrate de que esté conectado mientras se restablece."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres restablecer tu Apple TV a la configuración predeterminada y borrar toda su configuración y datos? Tendrás que configurarlo de nuevo.\n\nAsegúrate de que esté conectado mientras se restablece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko nollata Apple TV:n tehdasasetuksiin ja tyhjentää kaikki asetukset ja tiedot? Apple TV on otettava käyttöön uudelleen.\n\nVarmista, että Apple TV pysyy liitettynä virtalähteeseen nollauksen aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment réinitialiser tous les réglages de votre Apple TV et effacer toutes les données ? Vous devrez à nouveau configurer votre Apple TV.\n\nAssurez-vous que votre Apple TV reste branchée tout au long de sa réinitialisation."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment rétablir les réglages d’origine de votre Apple TV et réinitialiser tous les réglages et les informations? Votre Apple TV devra être reconfigurée.\n\nAssurez-vous que l’Apple TV est branchée lors de sa réinitialisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך לאפס את ה-Apple TV להגדרות היצרן ולמחוק את כל ההגדרות והמידע? הפעולה תדרוש הגדרה מחדש של ה-Apple TV.\n\nיש לוודא שה-Apple TV נשאר מחובר למקור חשמל במהלך האיפוס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाक़ई अपने Apple TV को फ़ैक्ट्री सेटिंग पर रीसेट करना और सभी सेटिंग और जानकारी को मिटाना चाहते हैं? आपको अपना Apple TV फिर से सेटअप करना होगा।\n\nयह पक्का करें कि आपका Apple TV रीसेट करते समय प्लग-इन रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurno želite resetirati Apple TV na tvorničke postavke i obrisati sve postavke i informacije? Trebat ćete ponovno podesiti Apple TV.\n\nPripazite da Apple TV ostane spojen na napajanje tijekom resetiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan visszaállítja az Apple TV‑t a gyári beállításokra, és töröl minden beállítást és információt? A művelet elvégzése után ismét be kell állítani az Apple TV‑t.\n\nAz alaphelyzetbe állítás alatt az Apple TV-nek áramforráshoz kell csatlakoznia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin mengatur ulang Apple TV Anda ke pengaturan pabrik serta menghapus semua pengaturan dan informasi? Anda harus mengatur Apple TV Anda lagi.\n\nPastikan Apple TV Anda tetap tersambung saat diatur ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi di voler ripristinare le impostazioni di fabbrica su Apple TV e inizializzare tutte le informazioni e le impostazioni? Dovrai configurare nuovamente Apple TV.\n\nAssicurati che il dispositivo sia collegato a una sorgente di alimentazione durante il processo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVを工場出荷時の設定にリセットしてすべての設定と情報を消去してもよろしいですか?  Apple TVを再度設定する必要があります。\n\nリセット中は必ずApple TVの電源をコンセントに差し込んだままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV를 초기 설정으로 재설정하고 모든 설정 및 정보를 지우겠습니까? 이렇게 하면 Apple TV를 다시 설정해야 합니다.\n\n재설정하는 동안 Apple TV가 전원에 연결되어 있어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu mereset Apple TV anda kepada seting kilang dan memadamkan semua seting serta maklumat? Anda perlu menyediakan Apple TV anda sekali lagi.\n\nPastikan Apple TV anda kekal dipalam semasa direset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil nullstille Apple TV til fabrikkinnstillingene og slette alle innstillinger og data? Du må konfigurere Apple TV-enheten på nytt etterpå.\n\nApple TV-enheten må være koblet til strøm mens nullstillingen pågår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je de fabrieksinstellingen van je Apple TV wilt herstellen en alle instellingen en informatie wilt wissen? Hierdoor moet je je Apple TV opnieuw configureren.\n\nKoppel tijdens het herstellen van de fabrieksinstellingen het netsnoer van de Apple TV niet los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz wyzerować Apple TV do ustawień fabrycznych oraz usunąć wszystkie ustawienia i dane? Będzie to wymagało ponownego skonfigurowania Apple TV.\n\nApple TV musi być podłączony do źródła zasilania przez cały czas trwania zerowania."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja redefinir a Apple TV aos ajustes de fábrica e apagar todos os ajustes e informações? Você deverá configurar a Apple TV novamente.\n\nMantenha a Apple TV conectada enquanto ela é redefinida."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende repor as definições de fábrica na Apple TV e apagar todas as outras definições e informação? Necessitará de voltar a configurar o dispositivo.\n\nCertifique‑se de que a Apple TV permanece ligada à corrente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți să resetați Apple TV‑ul dvs. la configurările din fabrică și să îi ștergeți toate configurările și informațiile? Va trebui să vă reconfigurați Apple TV‑ul.\n\nAsigurați‑vă că Apple TV‑ul rămâne cuplat la alimentare în timpul resetării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите сбросить Apple TV до заводских настроек и стереть все настройки и информацию? После этого придется настроить Apple TV заново.\n\nНе отключайте Apple TV во время сброса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete resetovať Apple TV na pôvodné nastavenia a vymazať všetky nastavenia a informácie? Apple TV bude potrebné znovu nastaviť.\n\nPočas resetovania by Apple TV malo ostať pripojené k napájaniu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste prepričani, da želite ponastaviti Apple TV na tovarniške nastavitve ter izbrisati vse nastavitve in informacije? Znova boste morali nastaviti Apple TV.\n\nPrepričajte se, da je Apple TV med ponastavitvijo ves čas priključen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill återställa Apple TV till fabriksinställningarna och radera alla inställningar och all information? Du kommer att behöva ställa in Apple TV igen.\n\nSe till att strömmen till Apple TV inte bryts medan den nollställs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าคุณต้องการรีเซ็ต Apple TV ของคุณให้กลับเป็นการตั้งค่าจากโรงงานและลบการตั้งค่าและข้อมูลทั้งหมด คุณจะต้องตั้งค่า Apple TV ของคุณอีกครั้ง\n\nตรวจสอบให้แน่ใจว่า Apple TV ของคุณเสียบปลั๊กอยู่ขณะที่รีเซ็ตเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nizi fabrika ayarlarına sıfırlayıp tüm ayarları ve bilgileri silmek istediğinizden emin misiniz? Apple TV’nizi yeniden ayarlamanız gerekir.\n\nApple TV'niz sıfırlanırken fişinin takılı olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справді скинути Apple TV до заводських параметрів і стерти всі параметри й дані? Вам доведеться налаштувати Apple TV знову.\n\nУ жодному разі не відʼєднуйте Apple TV від живлення під час скидання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn đặt lại Apple TV về cài đặt gốc, đồng thời xóa tất cả các cài đặt và thông tin không? Bạn sẽ cần thiết lập lại Apple TV của mình.\n\nĐảm bảo rằng Apple TV của bạn vẫn được cắm điện trong khi đặt lại."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要将Apple TV还原为出厂设置并抹掉所有设置和信息吗？你将需要重新设置Apple TV。\n\n还原过程中，请确保Apple TV的电源连接。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要將Apple TV重設為出廠預設值，並清除所有設定及資料嗎？你將需要重新設定Apple TV。\n\n請確定Apple TV在重設期間接上電源。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要將Apple TV重置成原廠設定，並清除所有設定和資訊嗎？你需要重新設定Apple TV。\n\n請確定Apple TV在重置期間已接上電源。"
          }
        }
      }
    },
