          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Toca en lugar de presionar para navegar con el control del Apple TV.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Navigoi Apple TV -kaukosäätimellä käyttämällä painallusten sijaan napautuksia.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Touchez au lieu d’appuyer pour naviguer avec la télécommande Apple TV.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Touchez les boutons au lieu d’appuyer dessus pour naviguer avec la télécommande de l’Apple TV.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להשתמש בהקשות במקום בלחיצות כדי לנווט באמצעות שלט ה-Apple TV.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "Apple TV रिमोट से नैविगेट करने के लिए दबाने के बजाए टैप करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Upotrijebite dodire umjesto pritisaka za navigiranje upravljačem Apple TV Remote.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Megnyomás helyett használhat koppintásokat az Apple TV távirányítóval való navigáláshoz.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Ketuk alih-alih tekan untuk menavigasi dengan remote Apple TV.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Usa il tocco anziché la pressione per navigare con il telecomando per Apple TV.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "Apple TVのリモコンで操作するには、押す代わりにタップしてください。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "Apple TV 리모컨에서 누르기 대신 탭을 사용하여 탐색합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Gunakan ketikan berbanding menekan untuk menavigasi dengan kawalan jauh Apple TV.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Navigeer met de afstands­bediening voor de Apple TV door te tikken in plaats van te drukken.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Naviger med lette i stedet for harde trykk på Apple TV-fjernkontrollen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Do nawigacji używaj na pilocie Apple TV stuknięć zamiast naciśnięć.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Toque em vez de pressionar para navegar com o controle remoto da Apple TV.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Usar toques em vez de premir para navegar com o comando da Apple TV.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Utilizați atingeri în loc de apăsări pentru a naviga cu telecomanda Apple TV‑ului.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Используйте касания вместо нажатий для перемещения по экрану с помощью пульта Apple TV.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Umožňuje používať klepnutia namiesto stlačení pri navigácii s ovládačom Apple TV.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Za krmarjenje z daljincem Apple TV Remote uporabljajte tape namesto pritiskov.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Tryck lätt istället för att trycka ned när du navigerar med Apple TV-fjärrkontrollen.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ใช้การแตะแทนที่การกดเพื่อนำทางด้วย Apple TV Remote",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Apple TV kumandası ile dolaşmak için basma yerine dokunmayı kullanır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Торкайте замість натискань для навігації з пультом Apple TV.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Sử dụng tác vụ chạm thay vì nhấn để điều hướng với Apple TV Remote.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "在Apple TV遥控器上使用轻点而非按下动作进行导览。",
            "state": "translated"
          }
        },
        "zh_HK": {
