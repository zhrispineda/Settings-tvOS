    "AccountsUserAccountsAlreadyInUseErrorMessageFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Apple هذا مرتبط من قبل بحساب iCloud أو Game Center باسم \"⁨%1$@⁩\" على هذا الـ Apple TV.\n\nيمكنك تعديل هذا في الإعدادات > ملفات التعريف والحسابات > %2$@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El compte d’Apple ja està associat al compte que %1$@ utilitza per connectar‑se a l’iCloud o al Game Center a l’Apple TV.\n\nPots editar‑lo a l’app Configuració > Perfils i comptes > %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet Apple už je na této Apple TV propojený s iCloudem nebo Game Centrem uživatele %1$@.\n\nPředvolby účtů můžete upravit v Nastavení > Profily a účty > %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Apple-konto er allerede forbundet med iCloud eller Game Center for “%1$@” på dette Apple TV.\n\nDu kan ændre dette i Indstillinger > Profiler og konti > %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account ist auf diesem Apple TV bereits mit iCloud oder Game Center für „%1$@“ verknüpft.\n\nDu kannst dies in „Einstellungen“ > „Profile und Accounts“ > „%2$@“ ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός Apple είναι ήδη συσχετισμένος με το iCloud ή το Game Center για «%1$@» σε αυτό το Apple TV.\n\nΑλλάξτε αυτήν τη ρύθμιση στις «Ρυθμίσεις» > «Προφίλ και λογαριασμοί» > «%2$@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account is already associated with iCloud or Game Center for “%1$@” on this Apple TV.\n\nEdit this in Settings > Profiles and Accounts > %2$@."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account is already associated with iCloud or Game Center for “%1$@” on this Apple TV.\n\nEdit this in Settings > Profiles and Accounts > %2$@."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account is already associated with iCloud or Game Center for “%1$@” on this Apple TV.\n\nEdit this in Settings > Profiles and Accounts > %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple ya está asociada a iCloud o a Game Center para %1$@ en este Apple TV.\n\nPuedes realizar cambios en Ajustes > Perfiles y cuentas > %2$@."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple ya está asociada con el servicio de iCloud o Game Center de “%1$@” en este Apple TV.\n\nPuedes editar esto en Configuración > Perfiles y cuentas > %2$@."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple ya está asociada con el servicio de iCloud o Game Center de “%1$@” en este Apple TV.\n\nPuedes editar esto en Configuración > Perfiles y cuentas > %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-tili (%1$@), on jo liitetty iCloudiin tai Game Centeriin tässä Apple TV:ssä.\n\nMuokkaa tätä kohdassa Asetukset > Profiilit ja tilit > %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple est déjà associé à iCloud ou Game Center pour « %1$@ » sur cette Apple TV.\n\nVous pouvez modifier ceci dans Réglages > Profils et comptes > %2$@."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple est déjà associé à iCloud ou à Game Center pour « %1$@ » sur cette Apple TV.\n\nModifiez ceci dans Réglages > Profils et comptes > %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון Apple זה כבר מקושר ל-iCloud או ל-Game Center של ״%1$@״ ב‑Apple TV זה.\n\nניתן לשנות זאת דרך ״הגדרות״ > ״פרופילים וחשבונות״ > ‏״%2$@״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV पर “%1$@” के लिए iCloud या Game Center के साथ यह Apple खाता पहले से संबद्ध है।\n\nइसे सेटिंग > प्रोफ़ाइल और खाते > %2$@ में जाकर संपादित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Apple račun već je povezan s iCloudom ili Game Centerom za “%1$@” na ovom Apple TV-u.\n\nTo možete urediti u Postavkama > Profili i računi > %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az Apple-fiók már társítva van „%1$@” iCloud- vagy Game Center-fiókjával ezen az Apple TV‑n.\n\nEzt a Beállítások > Profilok és Fiókok > %2$@ menüpontban szerkesztheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Apple ini telah dikaitkan dengan iCloud atau Game Center untuk “%1$@” di Apple TV ini.\n\nEdit ini di Pengaturan > Profil dan Akun > %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple Account è già associato ad iCloud o a Game Center per “%1$@” su questa Apple TV.\n\nPuoi modificarlo in Impostazioni > Profili e account > %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Accountは、このApple TVの“%1$@”ですでにiCloudまたはGame Centerに関連付けられています。\n\nこれは“設定”＞“プロフィールとアカウント”＞“%2$@”で編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정은 이 Apple TV에서 이미 ‘%1$@’님의 iCloud 또는 Game Center와 연결되어 있습니다.\n\n이 옵션은 설정 > 프로필 및 계정 > ‘%2$@’에서 편집할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun Apple ini sudah dikaitkan dengan iCloud atau Game Center untuk “%1$@” pada Apple TV ini.\n\nEditnya dalam Seting > Profil dan Akaun > %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Apple-kontoen er allerede knyttet til iCloud eller Game Center for «%1$@» på Apple TV.\n\nDu kan endre dette i Innstillinger > Profiler og kontoer > %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Apple Account is voor %1$@ al geassocieerd met iCloud of Game Center op deze Apple TV.\n\nWijzig dit in Instellingen door naar 'Profielen en accounts' > '%2$@' te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto Apple jest już powiązane z kontem iCloud lub Game Center „%1$@” na tym Apple TV.\n\nMożesz to edytować na ekranie Ustawienia > Profile i konta > %2$@."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple já está associada ao iCloud ou Game Center de %1$@ nesta Apple TV.\n\nVocê pode editá‑la em Ajustes > Perfis e Contas > %2$@."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta Apple já está associada a iCloud ou ao Game Center para “%1$@” nesta Apple TV.\n\nEsta opção pode ser editada em Definições > Perfis e contas > %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont Apple este deja asociat cu iCloud sau Game Center pentru „%1$@” pe acest Apple TV.\n\nEditați această opțiune în Configurări > Profiluri și conturi > %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Аккаунт Apple уже связан с iCloud или Game Center для пользователя %1$@ на этом Apple TV.\n\nЧтобы внести изменения, откройте «Настройки» > «Профили и учетные записи» > «%2$@»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Apple účet už je prepojený s iCloud alebo Game Center účtom užívateľa Apple TV „%1$@”.\n\nUpraviť to môžete v Nastavenia > Profily a účty > %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta račun Apple je že povezan s storitvijo iCloud ali omrežjem Game Center za uporabnika »%1$@« tega Apple TV-ja.\n\nTo lahko uredite v razdelku Nastavitve > Profili in računi > %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta Apple‑konto är redan kopplat till iCloud eller Game Center för ”%1$@” på denna Apple TV.\n\nÄndra detta under Inställningar > Profiler och konton > %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Apple นี้ผูกอยู่กับ iCloud หรือ Game Center สำหรับ “%1$@” บน Apple TV เครื่องนี้อยู่แล้ว\n\nแก้ไขการทำงานนี้ในการตั้งค่า > โปรไฟล์และบัญชี > %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı, bu Apple TV’de “%1$@” için iCloud veya Game Center ile zaten ilişkili.\n\nBunu Ayarlar > Profiller ve Hesaplar > %2$@ bölümünde düzenleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис Apple уже повʼязано з iCloud або Game Center для «%1$@» на цьому Apple TV.\n\nЗмінити це можна в меню Параметри > Профілі й облікові записи > %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple này đã được liên kết với iCloud hoặc Game Center cho “%1$@” trên Apple TV này.\n\nHãy sửa mục này trong Cài đặt > Hồ sơ và Tài khoản > %2$@."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple账户在这台Apple TV上已经与“%1$@”的iCloud或Game Center关联。\n\n若要编辑，请前往“设置”>“个人资料和账户”>“%2$@”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple帳户已經連繫至此Apple TV上「%1$@」的iCloud或Game Center。\n\n請在「設定」>「個人檔案和帳户」>「%2$@」編輯此設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此「Apple帳號」在Apple TV上已與「%1$@」的iCloud或Game Center產生關聯。\n\n請在「設定」>「個人檔案和帳號」> %2$@中編輯此設定。"
          }
        }
      }
    },
