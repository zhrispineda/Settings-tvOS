    "GameCenterAboutFriendsAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإدارة الأصدقاء أو إضافتهم في Game Center، انتقل إلى الإعدادات على iPhone أو iPad أو انتقل إلى تفضيلات النظام على Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gestionar o afegir amistats del Game Center, ves a la configuració en un iPhone o iPad, o a la configuració del sistema en un Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li spravovat nebo přidat přátele v Game Centru, přejděte do Nastavení na iPhonu či iPadu nebo do Nastavení systému na Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du administrerer eller tilføjer Game Center-venner ved at gå til Indstillinger på en iPhone eller iPad eller Systemindstillinger på en Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Game Center-Freund:innen zu verwalten und hinzuzufügen, öffne „Einstellungen“ auf einem iPhone oder iPad oder „Systemeinstellungen“ auf einem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για διαχείριση ή προσθήκη φίλων στο Game Center, μεταβείτε στις «Ρυθμίσεις» σε iPhone ή iPad, ή μεταβείτε στις «Ρυθμίσεις συστήματος» σε Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage or add Game Center friends, go to Settings on an iPhone or iPad or go to System Settings on a Mac."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage or add Game Center friends, go to Settings on an iPhone or iPad or go to System Settings on a Mac."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage or add Game Center friends, go to Settings on an iPhone or iPad, or go to System Settings on a Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gestionar tus amigos de Game Center o añadir nuevos, ve a Ajustes en un iPhone o iPad, o a Ajustes del Sistema en un Mac."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar amigos a Game Center o administrarlos, ve a Configuración en un iPhone o iPad, o a Configuración del Sistema en una Mac."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar amigos a Game Center o administrarlos, ve a Configuración en un iPhone o iPad, o a Configuración del Sistema en una Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse ja lisää Game Center -kavereita iPadin tai iPhonen Asetuksissa tai Macin Järjestelmäasetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour gérer ou ajouter des amis Game Center, accédez à Réglages sur un iPhone ou un iPad, ou à Réglages Système sur un Mac."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour gérer ou ajouter des amis dans Game Center, accédez à Réglages sur un iPhone ou un iPad, ou à Réglages système sur un Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לנהל או להוסיף חברים ל-Game Center יש לעבור אל ״הגדרות״ ב-iPhone או ב-iPad, או לעבור אל ״הגדרות המערכת״ ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center दोस्तों को प्रबंधित करने या जोड़ने के लिए iPhone या iPad पर सेटिंग में या Mac पर सिस्टम सेटिंग में जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za upravljanje ili dodavanje Game Center prijatelja idite u Postavke na iPhone ili iPad uređaju ili otvorite Postavke sustava na Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-barátok kezeléséhez vagy hozzáadásához iPhone-on vagy iPaden nyissa meg a Beállításokat, Macen pedig a Rendszerbeállításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengelola atau menambah teman Game Center, buka Pengaturan di iPhone atau iPad atau buka Pengaturan Sistem di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere o gestire gli amici su Game Center, vai in Impostazioni su un iPhone o iPad oppure in Impostazioni di Sistema su un Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerの友達を管理/追加するには、iPhoneまたはiPadでは“設定”に、Macではシステム設定に移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 친구를 관리하거나 추가하려면 iPhone 또는 iPad에서 설정으로 이동하거나, Mac에서 시스템 설정으로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengurus atau menambah rakan Game Center, pergi ke Seting pada iPhone atau iPad atau pergi ke Seting Sistem pada Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan administrere eller legge til Game Center-venner i Innstillinger på en iPhone eller iPad eller Systeminnstillinger på en Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Game Center-vrienden te beheren of toe te voegen, ga je naar Instellingen op een iPhone of iPad of naar Systeeminstellingen op een Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zarządzać znajomymi w Game Center i dodawać nowych, przejdź do Ustawień na iPhonie lub iPadzie albo do Ustawień systemowych na Macu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gerenciar ou adicionar suas amizades do Game Center, abra os Ajustes em um iPhone ou iPad ou os Ajustes do Sistema em um Mac."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gerir ou adicionar amigos no Game Center, aceda às Definições num iPhone ou iPad ou às Definições do Sistema num Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a gestiona sau adăuga prieteni în Game Center, accesați Configurări pe un iPhone sau iPad sau accesați Configurări sistem pe un Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы управлять списком друзей в Game Center или добавить новых друзей, откройте Настройки на iPhone или iPad либо перейдите в Системные настройки на Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priateľov v Game Center môžete spravovať alebo pridávať v Nastaveniach na iPhone alebo iPade, prípadne v Systémových nastaveniach na Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite upravljati ali dodajati prijatelje v omrežju Game Center, odprite Nastavitve v iPhonu ali iPadu, ali pa Nastavitve sistema v Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill hantera eller lägga till Game Center-vänner öppnar du Inställningar på en iPhone eller iPad eller Systeminställningar på en Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการจัดการหรือเพิ่มเพื่อนๆ จาก Game Center ให้ไปที่การตั้งค่าบน iPhone หรือ iPad หรือไปที่การตั้งค่าระบบบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center arkadaşı eklemek veya onları yönetmek için iPhone’da veya iPad’de Ayarlar’a ya da Mac’te Sistem Ayarları’na gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавати друзів у Game Center і керувати ними можна в Параметрах на iPhone чи iPad або в Системних параметрах на Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để quản lý hoặc thêm bạn bè Game Center, hãy đi tới Cài đặt trên iPhone hay iPad hoặc đi tới Cài đặt hệ thống trên máy Mac."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要管理或添加Game Center朋友，请前往iPhone或iPad上的“设置”，或Mac上的“系统设置”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要管理或加入Game Center上的朋友，請前往iPhone或iPad上的「設定」或Mac上的「系統設定」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要管理或加入Game Center朋友，請前往iPhone或iPad上的「設定」，或Mac上的「系統設定」。"
          }
        }
      }
    },
