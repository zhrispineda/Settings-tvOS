    "BTErrorLinkKey": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد Apple TV متصلاً بجهاز Bluetooth.\nلاستعادة الاتصال، يرجى إلغاء اقتران \"%@\" من Apple TV وتجربة الاتصال مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV ja no està connectat al dispositiu Bluetooth.\nPer restaurar la connexió, desenllaça “%@” de l’Apple TV i prova de tornar a connectar‑lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV už není k vašemu Bluetooth zařízení připojená.\nChcete‑li připojení obnovit, zrušte spárování zařízení „%@“ s Apple TV a zkuste se připojit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV har ikke længere forbindelse til Bluetooth-enheden.\nFor at genoprette forbindelsen skal du ophæve pardannelsen mellem “%@” og dit Apple TV og prøve at oprette forbindelse igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ist nicht mehr mit deinem Bluetooth-Gerät verbunden.\nUm die Verbindung wiederherzustellen, entkoppele „%@“ von dem Apple TV und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV δεν είναι πλέον συνδεδεμένο με τη συσκευή Bluetooth σας.\nΓια επαναφορά της σύνδεσης, καταργήστε τη ζευγοποίηση του «%@» με το Apple TV και κάντε σύνδεση εκ νέου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV is no longer connected to your Bluetooth device.\nTo restore the connection, unpair “%@” from your Apple TV and try connecting again."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV is no longer connected to your Bluetooth device.\nTo restore the connection, unpair “%@” from your Apple TV and try connecting again."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV is no longer connected to your Bluetooth device.\nTo restore the connection, unpair “%@” from your Apple TV and try connecting again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV ya no está conectado a tu dispositivo Bluetooth.\nPara restaurar la conexión, desenlaza el dispositivo “%@” del Apple TV y vuelve a intentar conectarte."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV ya no está conectado a tu dispositivo Bluetooth.\nPara restaurar la conexión, desenlaza “%@” de tu Apple TV e intenta conectarlo otra vez."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV ya no está conectado a tu dispositivo Bluetooth.\nPara restaurar la conexión, desenlaza “%@” de tu Apple TV e intenta conectarlo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ei ole enää yhdistettynä Bluetooth-laitteeseen.\nJos haluat palauttaa yhteyden, poista ”%@” Apple TV:n laitepareista ja yritä yhdistää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV n’est plus connectée à cet appareil Bluetooth.\nPour restaurer la connexion, déjumelez « %@ » de votre Apple TV et réessayez de procéder à la connexion."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV n’est plus connectée à votre appareil Bluetooth.\nPour rétablir la connexion, déjumelez « %@ » de votre Apple TV, puis établissez de nouveau la connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV אינו מחובר עוד למכשיר ה-Bluetooth שלך.\nכדי לשחזר את החיבור, יש לבטל את הקישור של ״%@״ ל-Apple TV ולנסות להתחבר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV अब आपके Bluetooth डिवाइस से कनेक्टेड नहीं है।\nकनेक्शन रीस्टोर करने के लिए अपने Apple TV से “%@” को अनपेयर करें और फिर से कनेक्ट करने की कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV više nije spojen na vaš Bluetooth uređaj.\nZa obnavljanje veze rasparite Apple TV i “%@” te ih ponovno povežite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV már nem csatlakozik a Bluetooth-eszközhöz.\nA csatlakozás visszaállításához törölje a(z) „%@” Apple TV-vel való párosítását, majd próbáljon meg ismét csatlakozni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV tidak lagi terhubung ke perangkat Bluetooth Anda.\nUntuk memulihkan koneksi, lepas “%@” dari Apple TV Anda dan coba hubungkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV non è più connessa al dispositivo Bluetooth.\nPer ripristinare la connessione, annulla l’abbinamento di “%@” con Apple TV e prova a connetterli nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVとこのBluetoothデバイスはもう接続されていません。\n接続を復元するには、Apple TVから“%@”のペアリングを解除して、再度接続してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 Bluetooth 기기에 더 이상 연결되어 있지 않습니다.\n다시 연결하려면 Apple TV에서 ‘%@’의 페어링을 해제한 다음 다시 연결하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV tidak lagi disambungkan ke peranti Bluetooth anda.\nUntuk memulihkan sambungan, batalkan berpasangan “%@” daripada Apple TV anda dan cuba sambung sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er ikke lenger koblet til Bluetooth-enheten.\nKoble «%@» fra Apple TV og koble til på nytt for å gjenopprette forbindelsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV is niet meer verbonden met je Bluetooth-apparaat.\nOm de verbinding te herstellen, koppel je '%@' los van je Apple TV en probeer je opnieuw te verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nie ma połączenia z urządzeniem Bluetooth.\nAby przywrócić połączenie, rozłącz parę „%@” i Apple TV, a następnie spróbuj nawiązać połączenie ponownie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está mais conectada ao dispositivo Bluetooth.\nPara restaurar a conexão, desemparelhe “%@” da Apple TV e tente conectar novamente."
