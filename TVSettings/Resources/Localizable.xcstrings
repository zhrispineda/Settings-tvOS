    "PreviouslyUsedEmailClearAllMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إزالة جميع عناوين البريد الإلكتروني المستخدمة سابقًا؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols eliminar totes les adreces electròniques utilitzades anteriorment?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete odstranit všechny dříve použité e‑mailové adresy?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil fjerne alle tidligere benyttede e-mailadresser?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du wirklich alle zuvor benutzten E-Mail-Adressen löschen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να αφαιρέσετε όλες τις διευθύνσεις email που χρησιμοποιήθηκαν στο παρελθόν;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove all previously-used email addresses?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove all previously-used email addresses?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove all previously used email addresses?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar todas las direcciones de correo electrónico utilizadas anteriormente?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres eliminar todos los correos usados previamente?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres eliminar todos los correos usados previamente?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko kaikki aiemmin käytetyt sähköpostiosoitteet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer toutes les adresses e-mail précédemment utilisées ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer toutes les adresses courriel utilisées précédemment?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך להסיר את כל כתובות הדוא״ל שהיו בשימוש בעבר?"
          }
        },
        "hi": {
