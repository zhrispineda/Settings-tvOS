    "SaverSelectionDescriptionAerials": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فيديوهات مذهلة للقطات مواقع من جميع أنحاء العالم، ومن تحت الماء، بل ومن الفضاء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaudeix de vídeos espectaculars de llocs d’arreu del món, de paisatges submarins i, fins i tot, de l’espai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úchvatné záběry natočené na různých místech po celém světě, v mořských hlubinách a dokonce i ve vesmíru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spektakulære videoer fra forskellige lokaliteter i verden, fra havets bund – og endda fra det ydre rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atemberaubende Videos, die an Orten auf der ganzen Welt aufgenommen wurden – unter Wasser oder sogar aus dem Weltraum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντυπωσιακά βίντεο τοποθεσιών από όλο τον κόσμο, υποθαλάσσιων σκηνών, ακόμη και από το διάστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathtaking videos of locations shot from all over the world, underwater, and even space."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathtaking videos of locations shot from all over the world, underwater and even space."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathtaking videos of locations shot from all over the world, underwater and even space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos espectaculares de lugares de todo el mundo, paisajes submarinos e incluso tomas espaciales."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de videos asombrosos de lugares de todo el planeta, del mundo submarino e incluso del espacio."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de videos asombrosos de lugares de todo el planeta, del mundo submarino e incluso del espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkeäsalpaavia videoita maisemista eri puolilta maailmaa, veden alta ja jopa avaruudesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des vidéos époustouflantes de vues aériennes filmées à travers le monde, sous l’eau et dans l’espace."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos spectaculaires de lieux filmés à travers le monde, sous l’eau et même dans l’espace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה סרטונים עוצרי נשימה שצולמו במקומות שונים ברחבי העולם, מתחת למים ואפילו בחלל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनियाभर की जगहों पर, पानी के नीचे और यहाँ तक कि अंतरिक्ष में शूट किए गए अद्भुत वीडियो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadivljujući videozapisi lokacija diljem svijeta, pod vodom te čak i u svemiru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lélegzetelállító videók a világ minden tájáról, víz alatti világról, de még az űrből is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video memukau yang menampilkan lokasi di seluruh dunia, bawah air, dan bahkan luar angkasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video mozzafiato di località da tutto il mondo, di panorami subacquei e addirittura dello spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界各地、水中、そして宇宙から撮影された息をのむようなロケーションの映像です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계, 수중, 심지어 우주에서 촬영한 숨이 막힐 듯 아름다운 영상입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Video mengagumkan lokasi yang dirakam dari seluruh dunia, bawah air, malah angkasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spektakulære videoer fra ulike steder i verden, under vann, eller til og med fra verdensrommet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adembenemende video's van locaties van over de hele wereld, onder water en zelfs de ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapierające dech w piersiach wideo nagrane w pięknych miejscach na całym świecie, pod wodą, a nawet w kosmosie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos espetaculares feitos em locais do mundo todo, sob a água e até no espaço."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos espetaculares de lugares de todo o mundo, paisagens subaquáticas e até do espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipuri video uluitoare cu locuri filmate din toate colțurile lumii, de sub apă și chiar din spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захватывающие видео, снятые в разных уголках Земли, под водой и даже в космосе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dychberúce videá natočené na rôznych miestach na celom svete, pod vodou a dokonca aj vo vesmíre."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osupljivi videi, posneti z lokacij po vsem svetu, pod vodo in celo v vesolju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spektakulära videor från olika platser runtom i världen, under vattenytan och till och med från rymden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอที่สวยสะกดใจซึ่งถ่ายจากทั่วทุกมุมโลก โลกใต้ทะเล และแม้แต่ในอวกาศ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumların, dünyanın her yerinden, su altından ve hatta uzaydan çekilmiş nefes kesen videoları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захопливі відео мальовничих краєвидів із різних куточків Землі, підводного світу та навіть космосу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các video ngoạn mục về những địa điểm được quay từ khắp nơi trên thế giới, dưới nước và thậm chí là trong không gian."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "令人叹为观止的视频，拍摄于世界各地、水下，甚至是太空。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "來自世界各地、水底，甚至是外太空等地方的壯觀影片。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "令人驚嘆，來自全球各地、水下，甚至是太空景緻的影片。"
          }
        }
      }
    },
    "SaverSelectionDescriptionPhotos": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور المفضلة أو الذكريات أو غلاف ألبوم الموسيقى. يمكنك أيضًا المشاركة من شبكتك المنزلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots fer servir les fotos, els records o les il·lustracions dels àlbums de música que més t’agradin. També pots compartir contingut de la xarxa local."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše oblíbené fotky, vzpomínky nebo grafika hudebních alb. K dispozici je také sdílení z domácí sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine yndlingsfotos, minder eller albumbilleder. Du kan også dele fra dit hjemmenetværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lieblingsfotos, Rückblicke oder Albencover von „Musik“, sowie im Netzwerk des Zuhauses geteilte Medien."
