    "AVShowOnSkipBackDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الترجمة مؤقتًا عند التخطي للخلف، لحد ٣٠ ثانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa els subtítols temporalment en fer retrocedir la reproducció fins a 30 segons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasně zapne titulky, když se vrátíte nejvýše o 30 sekund zpátky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå midlertidigt undertekster til, når du spoler tilbage – op til 30 sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel werden vorübergehend aktiviert, wenn du bis zu 30 Sekunden zurückspringst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσωρινή ενεργοποίηση υπότιτλων κατά τη μετάβαση πίσω έως και 30 δευτερόλεπτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily turn on subtitles when you skip back, up to 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activan temporalmente los subtítulos al retroceder en el contenido hasta 30 segundos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa temporalmente los subtítulos cuando retrocedes hasta por 30 segundos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa temporalmente los subtítulos cuando retrocedes hasta por 30 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita tekstitys päälle tilapäisesti, kun siirryt taaksepäin enintään 30 sekuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez temporairement les sous-titres lorsque vous revenez en arrière, jusqu’à 30 secondes."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active temporairement les sous-titres lorsque vous effectuez un saut vers l’arrière, pendant 30 secondes au maximum."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להפעיל כתוביות באופן זמני בעת דילוג אחורה, עד פרק זמן של 30 שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 सेकंड तक पीछे स्किप करने पर सबटाइटल अस्थायी रूप से चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privremeno uključenje titlova kad preskočite do 30 sekundi unatrag."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideiglenesen bekapcsolja a feliratokat, amikor legfeljebb 30 másodpercet visszaléptet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan subtitle saat Anda melewati mundur untuk sementara, hingga 30 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva temporaneamente i sottotitoli quando vai indietro, fino a 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前にスキップするときに字幕が一時的にオンになります（最大30秒）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 30초 뒤로 건너뛰면 일시적으로 자막을 켭니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan sari kata buat sementara apabila anda melangkau ke belakang, sehingga 30 saat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå midlertidig på undertekster når du hopper tilbake i videoer, opptil 30 sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel ondertiteling tijdelijk in wanneer je terugspringt, maximaal 30 seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowo włączaj napisy po przejściu w tył (o maksymalnie 30 sekund)."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative temporariamente as legendas ao retroceder até 30 segundos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar as legendas temporariamente ao retroceder até 30 segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitrările vor fi activate temporar atunci când săriți înapoi până la 30 de secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры отображаются временно при перемотке назад до 30 секунд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasne zobrazí titulky, keď preskočíte dozadu najviac o 30 sekúnd."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno vklopite podnapise ob preskoku nazaj za največ 30 sekund."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på undertexter tillfälligt (upp till 30 sekunder) när du hoppar bakåt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้คำบรรยายชั่วคราวเมื่อคุณข้ามไปข้างหลัง ซึ่งข้ามได้สูงสุด 30 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 30 saniye geri atladığınızda altyazıları geçici olarak açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасово вмикати субтитри, якщо виконано перехід назад на 30 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm thời bật phụ đề khi bạn lùi về sau, tối đa 30 giây."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "快退时，暂时打开字幕最长30秒钟。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "回帶時暫時開啟字幕（最多30秒）。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "倒轉時暫時開啟字幕，最多顯示30秒。"
          }
        }
      }
    },
