    "SaverBackdropPortraitClockDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك اختيار الصور التي تريد استخدامها للبورتريه، بما في ذلك الأشخاص والحيوانات الأليفة ومعدل التكرار الذي تريده لتغييرها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria les fotos que vulguis que surtin a la categoria de retrats, incloses les persones i les mascotes, i la freqüència amb què vulguis que canviïn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte fotky lidí nebo zvířat, které chcete ve spořiči Portréty používat, a určete, jak často se mají obměňovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de fotos, du vil bruge til Portrætter, herunder personer og kæledyr, og hvor ofte fotoet skifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Fotos aus, die du für „Porträts“ verwenden möchtest (einschließlich Personen und Haustiere), und bestimme, wie oft sie geändert werden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τις φωτογραφίες που θέλετε να χρησιμοποιούνται για τα Πορτρέτα, συμπεριλαμβανομένων ατόμων και κατοικίδιων, και πόσο συχνά θέλετε να αλλάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the photos you want to use for Portraits, including people and pets, and how often you want them to change."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the photos you want to use for Portraits, including people and pets, and how often you want them to change."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the photos you want to use for Portraits, including people and pets, and how often you want them to change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona las fotos que quieras usar en el salvapantallas Retratos, incluidas personas y mascotas, y con qué frecuencia quieres que cambien."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las fotos que quieres usar en Retratos, incluyendo personas y mascotas, y decide qué tan seguido quieres que cambien."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las fotos que quieres usar en Retratos, incluyendo personas y mascotas, y decide qué tan seguido quieres que cambien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Muotokuvat-näytönsäästäjään ihmisten ja lemmikkien kuvat, joita haluat käyttää, ja kuinka usein haluat niiden vaihtuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les photos que vous voulez utiliser pour Portraits, y compris les photos de personnes ou d’animaux, et la fréquence à laquelle vous souhaitez changer de photo."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les photos que vous voulez afficher dans l’économiseur d’écran Portraits, y compris les photos de personnes ou d’animaux de compagnie, et la fréquence à laquelle vous voulez changer de photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לבחור את התמונות שברצונך להשתמש בהן ב״תמונות פורטרט״, כולל תמונות של אנשים וחיות מחמד, ואת התדירות שבה יתחלפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन तस्वीरों को चुनें जिन्हें आप पोर्ट्रेट के लिए उपयोग करना चाहते हैं, जिनमें लोग और पालतू जानवर शामिल हैं और चुनें कि आप उन्हें कितनी बार बदलना चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite fotografije koje želite koristiti za Portrete, uključujući osobe i kućne ljubimce, te koliko često želite da se mijenjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja a Portrékhoz használni kívánt fotókat (többek közt személyeket és háziállatokat), valamint hogy ezek milyen gyakran váltakozzanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto yang ingin Anda gunakan untuk Potret, termasuk orang dan peliharaan, dan seberapa sering Anda ingin foto berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le foto dei soggetti, tra cui persone e animali domestici, da usare per il salvaschermo Ritratti, oltre alla frequenza di aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物やペットなど、“ポートレート”に使用する写真を選択します。また、それらの写真の表示をどのくらい頻度で切り替えるかも選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들 및 반려동물 등 인물 사진에 사용하려는 사진을 선택하고, 해당 사진을 변경할 빈도를 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto yang anda mahu gunakan untuk Potret, termasuk orang dan haiwan peliharaan, serta kekerapan anda mahu ia berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bildene du vil bruke med Portretter, inkludert personer og kjæledyr, og hvor ofte du vil at bildet skal endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de foto's die je wilt gebruiken voor portretten, waaronder personen en huisdieren, en hoe vaak je wilt dat deze worden gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcia (na przykład osób i zwierząt), których chcesz używać jako portretów, oraz określ, jak często mają być zmieniane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as fotos que você quer usar como Retratos, incluindo pessoas e pets, e a frequência que deseja alterá‑las."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as fotografias que pretende usar para a proteção de ecrã Retratos, incluindo pessoas e animais de estimação, e com que regularidade devem ser alteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți pozele pe care doriți să le utilizați pentru Portrete, inclusiv persoane și animale de companie, și frecvența cu care doriți să se schimbe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото людей и питомцев для отображения в заставке «Портреты», а также частоту, с которой они будут сменяться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte fotky ľudí alebo domácich miláčikov, ktoré chcete používať v šetriči Portréty, a nastavte, ako často sa majú meniť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite fotografije, ki jih želite uporabiti za Portrete, vključno s fotografijami oseb in hišnih ljubljenčkov, ter določite, kako pogosto naj se menjavajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bilderna du vill använda för porträtt, inklusive personer och husdjur, och hur ofta du vill att de ska ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปภาพที่คุณต้องการใช้สำหรับภาพถ่ายบุคคลรวมทั้งผู้คน\nและสัตว์เลี้ยง และเลือกว่าคุณต้องการให้เปลี่ยนรูปภาพบ่อยแค่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiler ve evcil hayvanlar da dahil olmak üzere Portreler için kullanmak istediğiniz fotoğrafları ve bunların hangi sıklıkta değişmesini istediğinizi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, які фотографії людей і домашніх улюбленців використовувати в Портретах та як часто їх змінювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh mà bạn muốn sử dụng cho Chân dung, bao gồm người và thú cưng, cũng như tần suất thay đổi mà bạn muốn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取要用于“人像”的照片（包括人物和宠物）及其更改频率。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你要用於「人像」的相片，包括人物和寵物，以及你要的相片更改頻率。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇想要用於「人像」的照片，包含人物和寵物，以及要多久更換一次。"
          }
        }
      }
    },
