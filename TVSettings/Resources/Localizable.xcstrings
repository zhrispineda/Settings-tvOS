            "value": "iTunes TV Şovları’nı ana ekranda göstermek için bunu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, чи показувати телешоу iTunes на екрані «Домівка»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn để hiển thị Chương trình TV iTunes trên Màn hình chính."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在主屏幕上显示iTunes电视节目。"
          }
        },
        "zh_HK": {
          "stringUnit": {
