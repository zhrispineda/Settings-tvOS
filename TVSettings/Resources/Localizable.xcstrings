    "TimeZoneAutomaticUnavailableInternetDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتعيين النطاق الزمني الخاص بك تلقائيًا، يجب أن تكون متصلاً بالإنترنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per definir automàticament la zona horària cal tenir connexió a internet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li automaticky nastavit časové pásmo, připojte se k internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil indstille din tidszone automatisk, skal du have oprettet forbindelse til internettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum automatischen Festlegen der Zeitzone musst du mit dem Internet verbunden sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για αυτόματο καθορισμό της ζώνης ώρας, πρέπει να είστε συνδεδεμένοι στο Διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To automatically set your time zone, you need to be connected to the internet."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To automatically set your time zone, you need to be connected to the internet."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To automatically set your time zone, you need to be connected to the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para establecer la zona horaria automáticamente, debes tener conexión a internet."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes tener conexión a Internet para establecer automáticamente tu zona horaria."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes tener conexión a Internet para establecer automáticamente tu zona horaria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta voit asettaa aikavyöhykkeen automaattisesti, sinun on oltava yhteydessä internetiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour définir automatiquement votre fuseau horaire, connectez-vous à Internet."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour régler automatiquement votre fuseau horaire, vous devez être connecté à Internet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להגדרת השעון המקומי באופן אוטומטי, יש להתחבר לאינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोमैटिकली समय क्षेत्र सेट करने के लिए आपको इंटरनेट से कनेक्ट करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za automatsko podešavanje vaše vremenske zone trebate biti spojeni na internet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzóna automatikus beállításához kapcsolódnia kell az internetre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengatur zona waktu Anda secara otomatis, Anda harus terhubung ke internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostare automaticamente il fuso orario, il tuo dispositivo deve essere connesso a internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯を自動設定するには、インターネットに接続する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대를 자동으로 설정하려면 인터넷에 연결되어 있어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengesetkan zon waktu anda secara automatik, anda perlu disambungkan ke Internet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må være koblet til internett for at tidssonen din skal angis automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je tijdzone automatisch in te stellen, moet je zijn verbonden met het internet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby automatycznie ustawić strefę czasową, musisz mieć połączenie z Internetem."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para definir o fuso horário automaticamente, deve haver uma conexão à internet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para definir automaticamente o fuso horário, tem de ter ligação à internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a configura automat fusul dvs. orar, trebuie să vă conectați la internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматической настройки часового пояса необходимо подключение к интернету."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre automatické nastavenie časového pásma musíte byť pripojení na internet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za samodejno nastavljanje časovnega pasu morate biti povezani z internetom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill ställa in tidszon automatiskt måste du vara ansluten till internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการตั้งค่าไทม์โซนของคุณโดยอัตโนมัติ คุณจะต้องเชื่อมต่อกับอินเทอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat diliminizi otomatik olarak ayarlamak için internete bağlı olmanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб задати часовий пояс автоматично, ви маєте встановити інтернет-зʼєднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tự động đặt múi giờ của bạn, bạn cần được kết nối vào internet."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要自动设置时区，你的电脑需要接入互联网。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要自動設定時區，你需要連接互聯網。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要自動設定時區，你需要連接網際網路。"
          }
        }
      }
    },
