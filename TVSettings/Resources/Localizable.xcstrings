    "WHASetupTitleDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن استخدام البث السريع مع الموسيقى والبودكاست ومحطات الراديو في كل غرفة داخل منزلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara pots reproduir música, pòdcasts i emissores de ràdio a totes les habitacions de casa teva amb l’AirPlay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní můžete přes AirPlay streamovat hudbu, podcasty a stanice rádia do kterékoli místnosti v domácnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du afspille musik, podcasts og radiostationer via AirPlay til alle værelser i dit Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt können Musik, Podcasts und Radiosender in jedem Raum deines Zuhauses über AirPlay gestreamt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε τώρα να αναπαράγετε μουσική, podcast και ραδιοφωνικούς σταθμούς μέσω AirPlay σε οποιοδήποτε δωμάτιο της οικίας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now AirPlay music, podcasts, and radio stations to every room in your home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now AirPlay music, podcasts and radio stations to every room in your home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now AirPlay music, podcasts and radio stations to every room in your home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes reproducir música, podcasts y emisoras de radio con AirPlay en todas las habitaciones de tu casa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes reproducir música, podcasts y estaciones de radio con AirPlay en todas las habitaciones de tu casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes reproducir música, podcasts y estaciones de radio con AirPlay en todas las habitaciones de tu casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt käyttää AirPlayta musiikin, podcastien ja radioasemien kuunteluun kotisi jokaisessa huoneessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais utiliser AirPlay pour diffuser de la musique, des podcasts et des stations de radio dans chaque pièce de votre domicile."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez dorénavant utiliser AirPlay pour écouter de la musique, des balados et des stations de radio dans toutes les pièces de votre maison."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כעת ניתן לשדר ב-AirPlay מוזיקה, פודקאסטים ותחנות רדיו לכל החדרים בבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अब संगीत, पॉडकास्ट और रेडियो स्टेशन को अपने घर के हर कमरे में AirPlay कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsad možete pokrenuti AirPlay reprodukciju glazbe, podcasta i radio postaja u svakoj prostoriji vašeg doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AirPlay használatával zenét, podcastokat és rádióállomásokat játszhat le az otthona minden szobájában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menggunakan AirPlay untuk musik, podcast, dan stasiun radio di setiap ruangan di rumah Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza AirPlay per ascoltare musica, podcast e stazioni radio in ogni stanza di casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージック、ポッドキャスト、ラジオステーションを各部屋にAirPlayをすることができるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 음악, 팟캐스트 및 라디오 스테이션을 집 안의 모든 방으로 AirPlay할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini boleh AirPlay muzik, podcast dan stesen radio ke setiap bilik dalam rumah anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nå bruke AirPlay til å spille av musikk, podkaster og radiostasjoner hvor som helst i hjemmet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu via AirPlay in elke kamer van je woning luisteren naar muziek, podcasts en radiostations."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz możesz również przesyłać muzykę, podcasty i programy stacji radiowych przez AirPlay do dowolnego pokoju w domu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode usar o AirPlay para reproduzir músicas, podcasts e estações de rádio em qualquer cômodo da sua casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já pode usar AirPlay para ouvir música, podcasts e estações de rádio em todas as divisões da casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum puteți să difuzați prin AirPlay muzică, podcasturi și posturi radio în toate camerele din locuința dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете передавать музыку, подкасты и радиостанции по AirPlay в каждую комнату своего дома."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odteraz môžete pomocou AirPlay prehrávať hudbu, podcasty a stanice rádia v ľubovoľnej miestnosti v domácnosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S funkcijo AirPlay lahko zdaj predvajate glasbo, podkaste in radijske postaje v vsak prostor svojega doma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du spela musik, poddar och radiostationer via AirPlay till alla rum i hemmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถใช้ AirPlay กับเพลง พ็อดคาสท์ และสถานีวิทยุเพื่อส่งไปยังทุกๆ ห้องในบ้านของคุณได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziklerinizi, podcast’lerinizi ve radyo istasyonlarınızı artık evinizin her odasında AirPlay ile dinleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер ви можете транслювати через AirPlay музику, подкасти й радіостанції в кожну кімнату дому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ bạn có thể phát nhạc, podcast và đài phát radio qua AirPlay đến mọi phòng trong nhà."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，你在家中的每个房间均可隔空播放音乐、播客和广播电台。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以將音樂、Podcast和廣播電台AirPlay至家中所有房間。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你現可將音樂、Podcast和廣播電台AirPlay到家中所有房間。"
          }
        }
      }
    },
