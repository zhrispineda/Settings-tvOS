    "SaverBackdropFilterDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار الصور الجوية المراد رؤيتها، بما في ذلك المنظر الطبيعي ومناظر المدينة وتحت الماء والأرض. يتم تنزيل الصور الجوية بشكل دوري."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona les vistes aèries que vulguis veure, com ara paisatges naturals i urbans o imatges submarines o de la Terra. Les vistes aèries es descarreguen periòdicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte letecké záběry, které se mají zobrazovat. K dispozici jsou krajiny, městská panoramata, podvodní scenérie a planeta Země. Pravidelně se stahují nové letecké záběry."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de luftfotos, du vil se, herunder landskab, bylandskab, under vandet og jorden. Luftfotos hentes med jævne mellemrum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Luftaufnahmen aus, die du sehen möchtest, darunter Landschaften, Stadtlandschaften, Unterwasseraufnahmen und Aufnahmen der Erde. Luftaufnahmen werden regelmäßig heruntergeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τα αεροβίντεο που θέλετε να εμφανίζονται, συμπεριλαμβανομένων τοπίων, αστικών τοπίων, υποθαλάσσιων σκηνών και σκηνών της Γης. Τα αεροβίντεο λαμβάνονται περιοδικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you'd like to see, including landscape, cityscape, underwater, and Earth. Aerials are downloaded periodically."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you'd like to see, including landscape, cityscape, underwater and Earth. Aerials are downloaded periodically."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Aerials you’d like to see, including landscape, cityscape, underwater and Earth. Aerials are downloaded periodically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona las vistas aéreas que quieras ver, por ejemplo, de la naturaleza, de paisajes urbanos, de las profundidades marinas o de la Tierra. Las vistas aéreas se descargan periódicamente."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las vistas aéreas que te gustaría que se muestren, ya sea paisajes, rascacielos, escenas submarinas o de la Tierra. Las vistas aéreas se descargan periódicamente."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las vistas aéreas que te gustaría que se muestren, ya sea paisajes, rascacielos, escenas submarinas o de la Tierra. Las vistas aéreas se descargan periódicamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ilmakuvat, jotka haluat nähdä, mm. maisemat, kaupunkimaisemat, vedenalaiset näkymät ja Maa. Ilmakuvia ladataan ajoittain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes que vous souhaitez afficher, comme des paysages naturels ou urbains, ou encore des vues sous-marines ou terrestres. De nouvelles vues aériennes sont téléchargées régulièrement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les vues aériennes que vous aimeriez voir, y compris des paysages naturels, des paysages urbains, des paysages sous-marins et des vues de la Terre. Les vues aériennes sont téléchargées régulièrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לבחור את צילומי האוויר שברצונך לראות, כולל נופים ציוריים, נופים עירוניים, צילומים תת-מימיים וצילומי לוויין של כדור הארץ. ההורדה של צילומי האוויר מתבצעת בפרקי זמן קבועים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूदृश्य, शहरी नज़ारे, अधोजलीय और धरती सहित उन एरियल का चुनाव करें जिन्हें आप देखना चाहते हैं। विहंगम दृश्यों को समय-समय पर डाउनलोड किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite zračne snimke koje želite vidjeti, uključujući krajolike, panorame gradova, podvodne snimke i snimke Zemlje. Zračne snimke periodično se preuzimaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja a megjeleníteni kívánt légi felvételeket, többek között tájakat, városképeket, illetve víz alatti és a Földről készült képeket. A légi felvételek bizonyos időközönként vannak letöltve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Aerial yang ingin Anda lihat, termasuk lanskap, panorama kota, bawah air, dan Bumi. Aerial diunduh secara berkala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le viste aeree che vuoi vedere, inclusi paesaggi, panorami urbani, ambienti sottomarini e viste della Terra. Le viste aeree vengono scaricate periodicamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風景、都市の景観、水中、地球など、お好きな空撮を選択してください。空撮は定期的にダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풍경, 도시 풍경, 수중 사진 및 지구 등 보고 싶은 항공 사진을 선택합니다. 항공 사진이 주기적으로 다운로드됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Tema Udara yang anda mahu lihat, termasuk landskap, pemandangan bandar, bawah air dan Bumi. Tema Udara dimuat turun secara berkala."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilke luftfoto du vil se, fra landskap via bylandskap til undervannsscener og Jorden. Luftfoto lastes ned regelmessig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de schermbeveiliging die je wilt zien, zoals landschap, stadsgezicht, onder water en aarde. Schermbeveiligingen worden periodiek gedownload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ulubione wygaszacze Z lotu ptaka, na przykład pejzaże naturalne lub miejskie, sceny podwodne albo widoki Ziemi z kosmosu. Wygaszacze są pobierane co pewien czas."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais Vistas Aéreas você gostaria de ver, incluindo opções de paisagem, paisagem urbana, submarina e terrestre. As Vistas Aéreas são baixadas periodicamente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as vistas aéreas que prefere, incluindo paisagens naturais ou urbanas, cenários subaquáticos e vistas da Terra. As vistas aéreas são descarregadas periodicamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți vederile aeriene care ați doriți să fie afișate, inclusiv peisaje naturale sau urbane, scene subacvatice și Pământul văzut din spațiu. Vederile aeriene sunt descărcate periodic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите аэрозаставки, которые Вы хотите видеть, например пейзажи, города, виды из космоса или подводные сцены. Аэрозаставки периодически загружают новый контент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte letecké zábery, ktoré sa majú zobrazovať. K dispozícii máte krajiny, panorámy miest, podvodné scenérie a planétu Zem. Letecké zábery sa pravidelne sťahujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite zračne posnetke, ki jih želite prikazati, vključno s pokrajino, urbano pokrajino, podvodnimi posnetki ter posnetki Zemlje. Zračni posnetki se prenašajo redno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka flygfoton du vill se, till exempel landskap, stadsbilder, bilder under vattenytan och jorden. Flygfoton hämtas regelbundet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาพมุมสูงที่คุณต้องการดูรวมถึงภาพทิวทัศน์ ทิวทัศน์ของเมือง มุมมองโลกใต้ทะเล และโลก จะดาวน์โหลดภาพมุมสูงเป็นระยะๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manzara, şehir manzarası, su altı ve yeryüzü dahil olmak üzere görmek istediğiniz havadan öğeleri seçin. Havadan öğeler düzenli aralıklarla indirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, які види з повітря показувати — від пейзажів і міських краєвидів до підводних світів та Землі з космосу. Час від часу викачуються нові види з повітря."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn video Không trung mà bạn muốn xem, bao gồm phong cảnh, khung cảnh thành phố, dưới nước và Trái Đất. Video Không trung được tải về định kỳ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从风景、城市风光、水下和地球景观中，选取要显示的航拍。航拍会定期下载。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你想觀看的「航拍」，包括風景、城市風光、水底和地球。系統會定期下載「航拍」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你想看到的「空照圖」，包含風景、城市風光、水中世界和地球。系統會定期下載「空照圖」。"
          }
        }
      }
    },
