    "SleepDelayEUWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة الوقت الذي يستغرقه Apple TV حتى يدخل في نمط الإسبات قد تؤدي إلى زيادة استهلاك الطاقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el temps perquè l’Apple TV entri en repòs és massa llarg, pot ser que també augmenti el consum d’energia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodloužením doby, po jejímž uplynutí se Apple TV uspí, můžete zvýšit spotřebu energie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du forlænger den tid, det tager for Apple TV at gå på vågeblus, kan det øge strømforbruget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Zeit verlängert wird, bis das Apple TV in den Ruhezustand geht, steigt möglicherweise der Energieverbrauch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αυξηθεί το χρονικό διάστημα μετάβασης του Apple TV σε κατάσταση ύπνου, ενδέχεται να αυξηθεί και η κατανάλωση ενέργειας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increasing the time Apple TV takes to go to sleep may increase energy consumption."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Increasing the time Apple TV takes to go to sleep may increase energy consumption."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Increasing the time Apple TV takes to go to sleep may increase energy consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar el tiempo que el Apple TV tarda en entrar en reposo puede aumentar el consumo de energía."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Incrementar el tiempo en el que el Apple TV entra en reposo podría incrementar también el consumo de energía."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Incrementar el tiempo en el que el Apple TV entra en reposo podría incrementar también el consumo de energía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähkönkulutus voi kasvaa lisättäessä aikaa, joka kestää ennen kuin Apple TV menee nukkumaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’augmentation du délai de mise en veille de l’Apple TV peut augmenter votre consommation d’électricité."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’augmentation du délai de mise en veille de l’Apple TV peut augmenter votre consommation d’électricité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארכת משך הזמן שחולף עד שה-Apple TV עובר למצב שינה עלולה להגביר את צריכת האנרגיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV को स्लीप मोड में जाने में लगने वाला समय बढ़ाने से ऊर्जा की खपत बढ़ सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povećanje vremena za prijelaz Apple TV-a u pripravno stanje može povećati potrošnju energije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha növeli azt az időt, amelyet követően az Apple TV alvó módba vált, azzal megnövekedhet az energiafelhasználás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah waktu yang diperlukan Apple TV untuk tidur dapat meningkatkan konsumsi energi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estendi l’attesa prima che Apple TV vada in standby, il consumo di energia potrebbe aumentare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVがスリープ状態になるまでの時間を長くすると、電力消費が増加する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 잠자기 상태로 전환될 때까지 걸리는 시간이 증가하면 에너지 소비가 늘어날 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningkatkan masa yang diambil Apple TV untuk tidur mungkin meningkatkan penggunaan tenaga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du forlenger tiden det tar før Apple TV går i dvale, kan det øke strømforbruket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je instelt dat het langer duurt voordat de Apple TV in de sluimerstand wordt gezet, kan het energieverbruik toenemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydłużenie czasu oczekiwania na uśpienie Apple TV może zwiększyć zużycie energii."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você aumentar o tempo para a Apple TV entrar em repouso, é possível que o consumo de energia também aumente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar o tempo que demora para a Apple TV entrar no modo de pausa pode também aumentar o consumo de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creșterea perioadei după care Apple TV‑ul intră în modul adormire poate spori consumul de energie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем дольше Apple TV не переходит в режим сна, тем больше энергии потребляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predĺženie času, po ktorom sa Apple TV uspí, môže zvýšiť spotrebu energie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če podaljšate čas, po katerem Apple TV preklopi v spanje, bo poraba energije morda večja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ökar tidsperioden innan Apple TV försätts i viloläge kan det öka energianvändningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเพิ่มเวลาที่ Apple TV ต้องใช้เพื่อพักเครื่องอาจเพิ่มการใช้พลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nin uyku durumuna geçme süresini artırmak enerji tüketimini artırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшення проміжку часу перед засинанням Apple TV може збільшити енергоспоживання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tăng thời gian cần thiết để Apple TV chuyển sang chế độ ngủ có thể làm tăng mức tiêu thụ năng lượng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "延长Apple TV进入睡眠状态所需的时间可能会增加能耗。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "延長Apple TV進入睡眠前的時間可能會增加耗電量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "增加Apple TV需要進入睡眠的時間可能會增加電力消耗。"
          }
        }
      }
    },
    "SleepNeverEUWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم السماح لـ Apple TV بالدخول في نمط الإسبات مطلقًا قد يؤدي إلى تقصير عمره وزيادة استهلاك الطاقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no permets mai que l’Apple TV entri en repòs, pot ser que se n’escurci la vida útil i augmenti el consum d’energia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když nebudete Apple TV uspávat, může se zkrátit její životnost a zvýšit spotřeba energie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis Apple TV aldrig sættes på vågeblus, kan det muligvis forkorte enhedens levetid og øge strømforbruget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Apple TV niemals in den Ruhezustand geht, kann dessen Lebensdauer sinken und der Energieverbrauch steigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το Apple TV δεν μεταβαίνει ποτέ σε κατάσταση ύπνου, ενδέχεται να μειωθεί η διάρκεια ζωής του και να αυξηθεί η κατανάλωση ενέργειας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never letting Apple TV go to sleep may shorten its life and increase energy consumption."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Never letting Apple TV go to sleep may shorten its life and increase energy consumption."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Never letting Apple TV go to sleep may shorten its life and increase energy consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitir que el Apple TV entre en reposo puede acortar su vida útil y aumentar el consumo de energía."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitir que el Apple TV entre en reposo puede acortar su vida útil e incrementar su consumo de energía."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitir que el Apple TV entre en reposo puede acortar su vida útil e incrementar su consumo de energía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos Apple TV:n ei anneta koskaan mennä nukkumaan, sen käyttöikä voi lyhentyä ja sähkönkulutus kasvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais mettre l’Apple TV en veille risque de réduire sa longévité et d’augmenter votre consommation d’électricité."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais mettre l’Apple TV en veille pourrait réduire sa durée de vie et augmenter votre consommation d’électricité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מניעה קבועה של מעבר ה‑Apple TV למצב שינה עלולה לקצר את חייו ולהגביר את צריכת האנרגיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV को कभी भी स्लीप मोड में न जाने देने से उसका जीवनकाल कम हो सकता है और ऊर्जा की खपत बढ़ सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odaberete da Apple TV nikad ne prelazi u pripravno stanje, može se skratiti njegov radni vijek i povećati potrošnja energije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amennyiben sosem hagyja alvó módba váltani az Apple TV‑t, megrövidülhet annak élettartama, és megnövekedhet az energiafogyasztása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pernah membiarkan Apple TV tidur dapat memperpendek masa pakainya dan meningkatkan konsumsi energi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consentire mai che Apple TV vada in standby può ridurne il ciclo di vita e aumentare il consumo di energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVをオフにさせないとディスプレイの寿命が短くなり、電力消費が増加する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 잠자기 상태로 전환되도록 설정하지 않으면 Apple TV의 수명이 단축되고 에너지 소비가 늘어날 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak membiarkan Apple TV tidur mungkin memendekkan hayatnya dan meningkatkan penggunaan tenaga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du aldri lar Apple TV gå i dvale, kan det forkorte enhetens levetid og øke strømforbruket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je instelt dat de Apple TV nooit in de sluimerstand wordt gezet, kan de levensduur achteruitgaan en kan het energieverbruik toenemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieusypianie Apple TV może skrócić jego żywotność oraz zwiększyć zużycie energii."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a Apple TV nunca entrar em repouso, é possível que sua vida útil seja reduzida e que o consumo de energia aumente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca colocar a Apple TV em pausa pode diminuir a vida útil da mesma e aumentar o consumo de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepermiterea intrării Apple TV‑ului în modul adormire îi poate scurta durata de viață și poate spori consumul de energie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если никогда не переводить Apple TV в режим сна, срок службы устройства может сократиться, а количество потребляемой энергии — увеличиться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úplné vypnutie spánku Apple TV môže skrátiť jeho životnosť a zvýšiť spotrebu energie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če Apple TV-ju nikoli ne omogočite, da preklopi v spanje, lahko skrajšate njegovo življenjsko dobo in povečate porabo energije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Apple TV aldrig försätts i viloläge kan dess livslängd förkortas och energianvändningen kan öka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การไม่พักเครื่อง Apple TV เลยอาจทำให้อายุการใช้งานสั้นลง\nและเพิ่มการใช้พลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’yi asla uyku durumuna geçirmemek onun ömrünü kısaltabilir ve enerji tüketimini artırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без режиму сну період експлуатації Apple TV може скоротитися, а енергоспоживання — зрости."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc không bao giờ để Apple TV chuyển sang chế độ ngủ có thể làm giảm tuổi thọ của thiết bị và làm tăng mức tiêu thụ năng lượng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV永不进入睡眠状态可能会缩短其使用寿命并增加能耗。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠不讓Apple TV進入睡眠可能會縮短其壽命和增加耗電量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從不讓Apple TV進入睡眠狀態可能會減短其壽命並增加電力消耗。"
          }
        }
      }
    },
    "SleepTimeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إيقاف تشغيل Apple TV تلقائيًا بعد مرور فترة من عدم النشاط. سيؤدي اختيار مؤقت إسبات من مركز التحكم إلى تجاوز هذا الإعداد مؤقتًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV es pot apagar automàticament al cap d’un període d’inactivitat. Si inicies un temporitzador de repòs al centre de control, s’ometrà aquesta configuració temporalment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV se může po určité době nečinnosti automaticky vypnout. Toto nastavení můžete dočasně přepsat tak, že v Ovládacím centru nastavíte časovač spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan slukke automatisk efter en vis periode med passivitet. Hvis du vælger en nedtælling til vågeblus i Kontrolcenter, tilsidesættes denne indstilling midlertidigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple TV kann sich nach einer gewissen Zeit der Inaktivität abschalten. Durch die Auswahl eines Ruhezustandstimers im Kontrollzentrum, wird diese Einstellung vorübergehend überschrieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV μπορεί να απενεργοποιείται αυτόματα μετά από κάποια περίοδο αδράνειας. Η επιλογή ενός χρονοδιακόπτη από το Κέντρο ελέγχου θα παρακάμψει προσωρινά αυτήν τη ρύθμιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically turn off after a period of inactivity. Choosing a sleep timer from Control Center will temporarily override this setting."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically turn off after a period of inactivity. Choosing a sleep timer from Control Centre will temporarily override this setting."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically turn off after a period of inactivity. Choosing a sleep timer from Control Centre will temporarily override this setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede apagarse automáticamente tras un periodo de inactividad. Si eliges un temporizador de reposo en el centro de control, se omitirá este ajuste temporalmente."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV puede desactivarse tras un periodo de inactividad. Seleccionar el temporizador de reposo en el centro de control reemplazará temporalmente esta configuración."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV puede desactivarse tras un periodo de inactividad. Seleccionar el timer de reposo en el centro de control reemplazará temporalmente esta configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV voi sammua automaattisesti oltuaan tietyn ajan toimettomana. Uniajastimen valitseminen Ohjauskeskuksesta ohittaa tämän asetuksen tilapäisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV peut s’éteindre automatiquement après une période d’inactivité. La sélection d’une mise en veille depuis le centre de contrôle remplacera temporairement ce réglage."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV peut s’éteindre automatiquement après une période d’inactivité. La définition d’un minuteur de veille dans le centre de contrôle contournera temporairement ce réglage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להגדיר כיבוי של ה-Apple TV לאחר פרק זמן של חוסר פעילות. בחירת שעון שינה מ״מרכז הבקרה״ תעקוף זמנית את ההגדרה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV एक अवधि तक निष्क्रिय रहने के बाद ऑटोमैटिकली बंद हो सकता है। कंट्रोल सेंटर से स्लीप टाइमर चुनने पर यह सेटिंग अस्थायी रूप से ओवरराइड हो जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV može se automatski isključiti nakon perioda neaktivnosti. Odabirom brojača do isključenja iz Kontrolnog centra privremeno će se nadjačati ova postavka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV képes bizonyos idejű tétlenséget követően automatikusan kikapcsolni. Ha kiválaszt egy alvási időzítőt a Vezérlőközpontban, azzal ideiglenesen felülbírálja ezt a beállítást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV dapat mati secara otomatis setelah beberapa lama tidak aktif. Memilih timer tidur dari Pusat Kontrol akan mengabaikan pengaturan ini untuk sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV può spegnersi automaticamente dopo un periodo di inattività. Se scegli un timer di standby in Centro di Controllo, questa impostazione verrà temporaneamente ignorata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一定の待機時間が経過すると、Apple TVは自動的にオフになります。コントロールセンターからスリープタイマーを選択すると、一時的にこの設定を無効化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 일정 시간 동안 비활성 상태이면 자동으로 꺼지게 할 수 있습니다. 제어 센터에서 잠자기 타이머를 선택하면 이 설정을 일시적으로 덮어씁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV boleh dinyahaktifkan secara automatik selepas suatu tempoh tiada aktiviti. Memilih pemasa tidur daripada Pusat Kawalan akan menggantikan seting ini buat sementara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan slås av automatisk etter en periode med inaktivitet. Hvis du velger en dvalenedtelling fra kontrollsenteret, blir denne innstillingen midlertidig overstyrt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV kan automatisch worden uitgeschakeld na een periode van inactiviteit. Wanneer je een timer voor de sluimerstand kiest uit het bedieningspaneel, wordt deze instelling tijdelijk overschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV może wyłączać się automatycznie po pewnym okresie braku aktywności. To ustawienie jest ignorowane, jeśli czas usypiania został wybrany w centrum sterowania."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode ser desativada automaticamente depois de um período de inatividade. Se você escolher um timer na Central de Controle, este ajuste será temporariamente substituído."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode ser desligada automaticamente após um período de inatividade. Se escolher um temporizador de pausa na central de controlo, esta definição será ignorada temporariamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul se poate opri automat după o perioadă de inactivitate. Alegerea unui temporizator de adormire din centrul de control va supraregla temporar această opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV может переходить в режим сна после определенного периода бездействия. Таймер сна, заданный в Центре управления, временно заменит эту настройку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sa môže po určitej dobe nečinnosti automaticky vypnúť. Výberom časovača spánku v Ovládacom centre dočasne obídete toto nastavenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV se lahko samodejno izklopi po določenem času neaktivnosti. Z izbiro časovnika za spanje v Nadzornem središču bo ta nastavitev začasno razveljavljena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan stängas av automatiskt efter en tids overksamhet. Om du väljer en vilotimer från Kontrollcenter förbigås den här inställningen tillfälligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV สามารถปิดเครื่องโดยอัตโนมัติหลังจากไม่ได้ใช้งานเป็นระยะเวลาหนึ่งได้ การเลือกการตั้งเวลาพักเครื่องจากศูนย์ควบคุมจะข้ามการตั้งค่านี้ชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bir süre boş kaldıktan sonra otomatik olarak kapanabilir. Denetim Merkezi’nden bir uyku sayacı seçmek bu ayarı geçici olarak geçersiz kılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV може автоматично вимикатися після неактивності. Цей параметр можна тимчасово обійти, задавши таймер сну в Центрі керування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV có thể tự động tắt sau một khoảng thời gian không hoạt động. Việc chọn một hẹn giờ tắt từ Trung tâm điều khiển sẽ tạm thời ghi đè cài đặt này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "闲置一段时间后，Apple TV可自动关闭。从“控制中心”选取睡眠定时将暂时覆盖此设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可以在閒置一段時間後自動關閉。從「控制中心」選擇睡眠計時器將會暫時覆蓋此設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可在閒置一段時間後自動關閉。從「控制中心」選擇睡眠計時器會暫時覆蓋掉此設定。"
          }
        }
      }
    },
