    "AVLateNightDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستمتاع بالأفلام والموسيقى دون إزعاج الآخرين. استمتع بالموسيقى والمؤثرات الصوتية الناعمة، مع الاحتفاظ بكل تفاصيل مستوى الصوت الأصلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaudeix de les pel·lícules i de la música sense molestar ningú. Notaràs que la música i els efectes se sentiran més suaus, però no et perdràs cap detall del so original."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Užívejte si filmy a hudbu bez toho, že byste rušili ostatní. Zvukové efekty a hudba budou tišší, všechny detaily původní hlasitosti však zůstanou zachovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se film og lyt til musik uden at forstyrre andre. Dæmper lydeffekter og musik, men bevarer alle detaljerne i det originale lydniveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genieße Filme und Musik, ohne andere zu stören. Geräuscheffekte und Musik werden zwar leiser, aber mit allen Details der Originallautstärke wiedergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απολαύστε ταινίες και μουσική χωρίς να ενοχλείτε άλλα άτομα. Απολαύστε απαλότερα ηχητικά εφέ και μουσική, αλλά παράλληλα όλες τις λεπτομέρειες του αρχικού επιπέδου ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy movies and music without disturbing others. Experience softer sound effects and music, but keep all the detail of the original sound level."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy movies and music without disturbing others. Experience softer sound effects and music, but keep all the detail of the original sound level."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy movies and music without disturbing others. Experience softer sound effects and music, but keep all the detail of the original sound level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de las películas y la música sin molestar a los demás. Escucha los efectos de sonido y la música a un volumen más bajo, pero con la misma calidad de sonido que la del volumen original."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de películas y música sin molestar a otras personas. Podrás escuchar los efectos de sonido y la música con un volumen más bajo, pero con la misma calidad que el nivel de sonido original."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de películas y música sin molestar a otras personas. Podrás escuchar los efectos de sonido y la música con un volumen más bajo, pero con la misma calidad que el nivel de sonido original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauti elokuvista ja musiikista häiritsemättä muita. Kuulet äänitehosteet ja musiikin pehmeämmin, mutta yleinen äänen taso pysyy alkuperäisenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez des films et de la musique sans déranger les autres. La musique et les effets sonores sont atténués, mais vous conservez tous les détails du volume sonore original."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez des films ou écoutez de la musique sans déranger les autres. Profitez d’effets sonores et d’un niveau musical plus doux, tout en conservant tous les détails du niveau sonore original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה זו מאפשרת לך ליהנות מסרטים וממוזיקה בלי להפריע לאחרים. ניתן לחוות אפקטים קוליים ומוזיקה בעוצמה נמוכה יותר, תוך שמירה על כל הפרטים שבעוצמת הצליל המקורית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य लोगों को परेशान किए बिना फ़िल्मों और संगीत का आनंद लें। ध्वनि प्रभाव व संगीत की तीव्रता कम कर दी जाएगी लेकिन ध्वनि का मूल स्तर व गुणवत्ता बनाई रखी जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživajte u filmovima i glazbi bez uznemiravanja ostalih. Doživite tiše zvučne efekte i glazbu uz zadržavanje svih detalja iz izvorne razine glasnoće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmeket nézhet, és zenét hallgathat anélkül, hogy másokat zavarna. A hangeffektek és a zene halkabb lesz, de az eredeti hangszint minden részlete megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikmati film dan musik tanpa mengganggu orang lain. Rasakan efek bunyi dan musik yang lebih lembut tanpa mengurangi detail level bunyi asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goditi i film e ascolta musica senza disturbare chi hai vicino. Il volume di effetti sonori e musica viene abbassato, ma le caratteristiche del suono originale vengono mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人の迷惑にならずに映画やミュージックを楽しめます。サウンドエフェクトとミュージックは、元のサウンドレベルのディテールを完全に保ったまま、控えめに再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람에게 방해가 되지 않게 영화 및 음악을 즐길 수 있습니다. 원음의 정교함은 놓치지 않으면서 더 부드러운 사운드 효과 및 음악을 경험할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikmati filem dan muzik tanpa mengganggu orang lain. Alami kesan bunyi dan muzik yang lebih lembut, namun kekalkan semua butiran paras bunyi asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill filmer og musikk uten å forstyrre andre. Lydeffekter og musikk spilles med lavere lyd, uten at du mister detaljene i originallyden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk films en luister naar muziek zonder anderen te storen. Het volume van geluidseffecten en muziek wordt verlaagd, met behoud van de details van het originele geluidsniveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj filmy i muzykę, nie przeszkadzając innym. Używaj tłumienia efektów dźwiękowych i muzyki, zachowując wszystkie oryginalne szczegóły dźwięku."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curta filmes e músicas sem incomodar outras pessoas. Os efeitos sonoros e as músicas serão suavizados, mas manterão todos os detalhes do nível de som original."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja filmes e ouça música sem perturbar ninguém. Os efeitos sonoros e a música serão mais suaves, mas será mantido todo o detalhe do volume de som original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucurați‑vă de filme și muzică fără a‑i deranja pe alții. Muzica și efectele sonore vor fi atenuate, însă detaliile nivelului de sunet original vor fi păstrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите фильмы и слушайте музыку, не беспокоя окружающих. Звуковые эффекты и музыка станут мягче, однако исходный уровень громкости сохранится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychutnajte si filmy a hudbu bez toho, aby ste tým rušili ostatných. Tento režim zjemní zvukové efekty a hudbu a zároveň zachová všetky detaily pôvodnej úrovne hlasitosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživajte v filmih in glasbi, ne da bi motili druge. Izkusite mehkejše zvočne učinke in glasbo, vendar ohranite vse podrobnosti izvirne ravni zvoka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på film och lyssna på musik utan att störa andra. Ljudet sänks för ljudeffekter och musik, men alla detaljer från den ursprungliga ljudnivån bevaras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลิดเพลินกับภาพยนตร์และเพลงโดยไม่รบกวนผู้อื่น สัมผัสประสบการณ์เสียงประกอบและเพลงที่นุ่มนวลขี้น แต่ยังคงเก็บรายละเอียดทุกอย่างของเสียงต้นฉบับไว้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer kişileri rahatsız etmeden filmlerin ve müziklerin keyfini çıkarın. Ses efektlerini ve müzikleri daha alçak sesli duyarken, özgün ses düzeyinin tüm ayrıntılarını koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насолоджуйтесь фільмами й музикою, не турбуючи інших. Тіштеся лагіднішими звуковими ефектами й музикою без втрати жодних деталей оригінального рівня гучності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thưởng thức phim và nhạc mà không làm ảnh hưởng đến người khác. Trải nghiệm hiệu ứng âm thanh và nhạc nhẹ hơn, nhưng vẫn giữ tất cả chi tiết của mức âm thanh gốc."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "欣赏电影和音乐的同时，不会干扰他人。你将体验到更柔和的声效和音乐，但原音量时的全部细节均会保留。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在不打擾別人的情況下享受電影及音樂。保持原聲所有細節的同時感受一下較柔和的音效及音樂。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自在享受電影和音樂且不打擾他人。體驗較為柔和的音效和音樂，但仍會維持原始音量的細節。"
          }
        }
      }
    },
