        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar um novo perfil a esta Apple TV para aceder aos respetivos programas, filmes, Continuar a ver, dados de aplicações em iCloud e conta do Game Center."
