    "AXFacetimeCaptionsDetails": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يمكن أن يستخدم Apple TV الذكاء المتضمن في الجهاز لعرض محادثة فيس تايم على الشاشة. قد تتفاوت دقة التعليقات المصاحبة المباشرة؛ لذا لا ينبغي الاعتماد عليها في حالات الخطورة العالية أو الطوارئ.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "L’Apple TV farà servir la intel·ligència local del dispositiu per mostrar la conversa del FaceTime en pantalla. La precisió pot variar i no s’hi ha de confiar en situacions d’emergència o d’alt risc.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Apple TV může s využitím vlastní inteligence zařízení zobrazovat konverzaci z FaceTimu na obrazovce. Přesnost živých titulků může kolísat, takže byste se na ně neměli spoléhat ve vysoce rizikových a krizových situacích.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Apple TV kan bruge intelligens på enheden til at vise din FaceTime-samtale på skærmen. Nøjagtigheden af liveundertekster kan variere, og du bør ikke stole på dem i risikobetonede situationer eller nødsituationer.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Das Apple TV kann mithilfe integrierter künstlicher Intelligenz deine FaceTime-Konversationen auf dem TV-Gerät anzeigen. Die Genauigkeit von Live-Untertiteln kann variieren und sollte in Risikosituationen oder Notfällen nicht als zuverlässige Quelle genutzt werden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Το Apple TV μπορεί να χρησιμοποιεί νοημοσύνη επί της συσκευής για εμφάνιση των συζητήσεών σας στο FaceTime επί της οθόνης. Η ακρίβεια των Ζωντανών λεζαντών ενδέχεται να ποικίλλει και δεν πρέπει να βασίζεστε σε αυτές σε καταστάσεις υψηλού κινδύνου ή έκτακτης ανάγκης.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Apple TV can use on-device intelligence to display your FaceTime conversation on-screen. Accuracy of Live Captions may vary and should not be relied upon in high-risk or emergency situations.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Apple TV can use on-device intelligence to display your FaceTime conversation onscreen. Accuracy of Live Captions may vary and should not be relied upon in high-risk or emergency situations.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Apple TV can use on-device intelligence to display your FaceTime conversation on-screen. Accuracy of Live Captions may vary and should not be relied upon in high-risk or emergency situations.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Apple TV can use on-device intelligence to display your FaceTime conversation onscreen. Accuracy of Live Captions may vary and should not be relied upon in high-risk or emergency situations.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Apple TV can use on-device intelligence to display your FaceTime conversation on-screen. Accuracy of Live Captions may vary and should not be relied upon in high-risk or emergency situations.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El Apple TV puede utilizar la inteligencia local del dispositivo para mostrar en pantalla tu conversación de FaceTime. La precisión de los subtítulos en vivo puede variar y no debe considerarse como un recurso fiable en situaciones de alto riesgo o de emergencia.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El Apple TV usará la inteligencia en el dispositivo para mostrar tus conversaciones de FaceTime en la pantalla. La precisión de los subtítulos en vivo puede variar y, por lo tanto, no se recomienda confiar en ellos en situaciones de alto riesgo.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "El Apple TV usará la inteligencia en el dispositivo para mostrar tus conversaciones de FaceTime en la pantalla. La precisión de los subtítulos en vivo puede variar y, por lo tanto, no se recomienda confiar en ellos en situaciones de alto riesgo.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Apple TV voi tekstittää FaceTime-keskustelun laiteälyn avulla. Live-tekstityksen tarkkuus voi vaihdella, eikä siihen tule luottaa riskialttiissa tai hätätilanteissa.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "L’Apple TV peut utiliser une technologie exécutée sur l’appareil pour afficher votre conversation FaceTime à l’écran. La précision des sous-titres en direct peut varier et ceux-ci ne doivent pas être utilisés dans des situations à haut risque ou d’urgence.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "L’Apple TV peut utiliser les fonctions d’intelligence de l’appareil pour afficher votre conversation FaceTime à l’écran. L’exactitude des sous-titres en direct pouvant varier, ne vous y fiez pas dans des situations à haut risque ou d’urgence.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ה-Apple TV יכול להשתמש בטכנולוגיית בינה מלאכותית כדי להציג תמלול של שיחת ה-FaceTime שלך על המסך. רמת הדיוק של ״כתוביות בזמן אמת״ עשויה להשתנות ואין להסתמך עליה במצבי סיכון גבוה או מקרי חירום.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "Apple TV स्क्रीन पर आपकी FaceTime वार्तालाप दिखाने के लिए ऑन-डिवाइस इंटेलीजेंस का इस्तेमाल कर सकता है। लाइव कैप्शन की सटीकता में अंतर हो सकता है और उच्च जोखिम वाली या आपातकालीन स्थितियों में उन पर भरोसा नहीं करना चाहिए।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Apple TV može koristiti inteligenciju na uređaju za prikazivanje vašeg FaceTime razgovora na zaslonu. Točnost Opisa uživo može varirati i na njih se ne biste trebali oslanjati u situacijama visokog rizika ili hitnim situacijama.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Az Apple TV az eszközön való feldolgozás segítségével automatikusan megjeleníti a FaceTime-beszélgetéseit a képernyőn. Az Élő feliratok pontossága változó lehet, és magas kockázatú helyzetekben vagy vészhelyzetben nem szabad rájuk támaszkodni.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Apple TV dapat menggunakan kecerdasan pada perangkat untuk menampilkan percakapan FaceTime Anda pada layar. Akurasi Teks Langsung dapat berbeda-beda dan tidak boleh diandalkan dalam situasi berisiko tinggi atau darurat.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Apple TV può utilizzare l’intelligenza artificiale presente sul dispositivo per mostrare le conversazioni FaceTime sullo schermo. L’accuratezza delle trascrizioni in tempo reale potrebbe variare e non è consigliabile fare affidamento sulla funzionalità in situazioni ad alto rischio o di emergenza.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "デバイス上の人工知能機能を使用して、Apple TVでFaceTimeの会話が画面が表示されます。ライブキャプションの精度は一定ではなく、危険性の高い状況または緊急時にはライブキャプションを信頼すべきではありません。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "Apple TV는 온디바이스 지능형 기능을 사용하여 FaceTime의 대화를 화면상에 표시합니다. 실시간 자막의 정확성은 때에 따라 다를 수 있으며, 위험이 큰 상황 또는 긴급 상황에서 이 기능에 의존해서는 안 됩니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Apple TV boleh menggunakan kecerdasan pada peranti untuk memaparkan perbualan FaceTime anda atas skrin. Ketepatan Kapsyen Langsung mungkin berbeza-beza dan tidak sepatutnya digunakan dalam situasi berisiko tinggi atau kecemasan.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "De Apple TV kan intelligentie op het apparaat gebruiken om je FaceTime-gesprek op het scherm weer te geven. De nauwkeurigheid van live bijschriften kan variëren. Vertrouw er niet op in situaties met een hoog risico of in noodgevallen.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Apple TV kan bruke kunstig intelligens på enheten til å tekste en FaceTime-samtale på skjermen. Direkteteksting er ikke alltid like nøyaktig, og bør ikke stoles på i nød- eller risikosituasjoner.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Apple TV może wyświetlać napisy podczas połączeń FaceTime, używając wbudowanej sztucznej inteligencji. Dokładność napisów na żywo nie jest gwarantowana i nie należy na nich polegać w sytuacjach wysokiego ryzyka ani awaryjnych.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "A Apple TV pode usar a inteligência no dispositivo para mostrar suas conversas do FaceTime na tela. A precisão das Legendas ao Vivo pode variar e você não deve contar com elas em situações de alto risco ou de emergência.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "A Apple TV pode usar a tecnologia de inteligência no dispositivo para mostrar conversas do FaceTime no ecrã. A precisão das legendas em tempo real pode variar e não deve ser considerada fiável em situações de alto risco ou de emergência.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Apple TV‑ul poate utiliza procesare inteligentă pe dispozitiv pentru a afișa conversația dvs. FaceTime pe ecran. Precizia subtitrărilor live ar putea varia și nu trebuie să vă bazați pe această funcționalitate în situații de urgență sau cu risc ridicat.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Apple TV будет отображать на экране текст Вашего разговора в FaceTime, используя искусственный интеллект на устройстве. Точность субтитров не гарантируется, и на них не следует полагаться в ситуациях высокого риска и экстренных случаях.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Apple TV môže využitím umelej inteligencie na zariadení zobrazovať vaše FaceTime konverzácie na obrazovke. Presnosť živých titulkov môže kolísať a nemali by ste sa na ne spoliehať v rizikových ani krízových situáciách.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Apple TV lahko uporablja inteligenco v napravi za prikaz pogovorov FaceTime na zaslonu. Možna so odstopanja v točnosti napisov v živo, zato se nanje ne bi smeli zanašati v primerih visokega tveganja ali v izrednih razmerah.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Apple TV kan använda intelligenta funktioner på enheten till att texta dina FaceTime-samtal på skärmen. Hur korrekt direkttextning är kan variera och du bör inte förlita dig på funktionen i nödsituationer eller situationer med hög risk.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "Apple TV สามารถใช้ความฉลาดของอุปกรณ์เพื่อแสดงการสนทนา FaceTime ของคุณบนหน้าจอได้ ความแม่นยำของคำบรรยายเสียงสดอาจแตกต่างกันไปและไม่ควรพึ่งพาคำบรรยายเสียงสดเพียงอย่างเดียวในสถานการณ์ที่มีความเสี่ยงสูงหรือฉุกเฉิน",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Apple TV, FaceTime görüşmenizi ekranda görüntülemek için aygıttaki yapay zekâyı kullanabilir. Canlı Altyazı doğruluğu değişkenlik gösterebilir ve yüksek riskli veya acil durumlarda canlı altyazıya güvenilmemelidir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Apple TV може автоматично показувати субтитри у FaceTime за допомогою вбудованих інтелектуальних алгоритмів. Точність Субтитрів наживо може бути різною, тому на неї не варто покладатися в ризикованих або екстрених ситуаціях.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Apple TV có thể sử dụng công nghệ thông minh trên thiết bị để hiển thị cuộc hội thoại FaceTime của bạn trên màn hình. Độ chính xác của Chú thích trực tiếp có thể thay đổi và bạn không nên dựa vào tính năng này trong các tình huống khẩn cấp hoặc có tính rủi ro cao.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "Apple TV可使用设备端智能技术在屏幕上显示FaceTime对话。实时字幕的准确度可能会有所不同，在高风险情况或紧急情况下不应依赖实时字幕。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "Apple TV會使用裝置端智能技術在螢幕上顯示FaceTime對話。「即時字幕」的準確性可能會有所不同，在高風險或緊急情況下不應依賴「即時字幕」。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "Apple TV會使用裝置端的智慧技術在螢幕上顯示你的FaceTime對話。「即時字幕」的準確度可能不同，在高風險或緊急情況下不應該仰賴「即時字幕」功能。",
            "state": "translated"
          }
        }
      }
    },
