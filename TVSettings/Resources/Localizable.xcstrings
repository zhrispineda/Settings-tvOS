    "BluetoothServiceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات التي طلبت التمكّن من استخدام Bluetooth ستظهر هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que hagin sol·licitat permís per utilitzar el Bluetooth apareixeran aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí aplikace, které si vyžádaly přístup k rozhraní Bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der har bedt om mulighed for at bruge Bluetooth, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Apps angezeigt, die die Möglichkeit zur Verwendung von Bluetooth angefordert haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ θα εμφανίζονται οι εφαρμογές που έχουν ζητήσει άδεια για χρήση του Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested the ability to use Bluetooth will appear here."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested the ability to use Bluetooth will appear here."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested the ability to use Bluetooth will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que han solicitado poder usar Bluetooth aparecerán aquí."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí estarán las apps que solicitaron usar Bluetooth."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí estarán las apps que solicitaron usar Bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit, jotka ovat pyytäneet lupaa käyttää Bluetoothia, näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ayant demandé à pouvoir utiliser le Bluetooth figureront ici."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications qui ont demandé à pouvoir utiliser Bluetooth s’afficheront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שביקשו להשתמש ב-Bluetooth יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth उपयोग करने की क्षमता का अनुरोध करने वाले ऐप्लिकेशन यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se prikazati aplikacije koje su zatražile mogućnost uporabe Bluetootha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg a Bluetooth használatát kérelmező appok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta kemampuan untuk menggunakan Bluetooth akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che hanno richiesto la possibilità di utilizzare il Bluetooth verranno visualizzate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothの使用を要求したアプリがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 사용을 요청한 앱이 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta keupayaan untuk menggunakan Bluetooth akan kelihatan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmer som har bedt om muligheten til å bruke Bluetooth, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staan de apps die hebben gevraagd om Bluetooth te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu pojawiają się aplikacje, które proszą o możliwości używania Bluetooth."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que solicitarem o uso de Bluetooth aparecerão aqui."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que pediram para usar Bluetooth aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care au solicitat permisiunea de a utiliza Bluetooth vor fi afișate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся приложения, запросившие разрешение использовать Bluetooth."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia apky, ktoré žiadali o prístup k rozhraniu Bluetooth."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki so zahtevale možnost uporabe povezave Bluetooth, bodo prikazane tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som har begärt att få använda Bluetooth visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ได้ขอใช้บลูทูธจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kullanmak isteyen uygulamalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут зʼявлятимуться програми, що запитують дозвіл на використання Bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã yêu cầu khả năng sử dụng Bluetooth sẽ xuất hiện tại đây."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此处将显示请求使用蓝牙的App。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求使用藍牙的App會在此顯示。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "之前要求使用藍牙的App會顯示在此處。"
          }
        }
      }
    },
