    "AVDisplayModeRefreshRateDescriptionFilm24": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ هو المعدل القياسي لمحتوى الأفلام على أجهزة التلفزيون في أمريكا الشمالية والمناطق الأخرى التي تستخدم NTSC."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A l’Amèrica del Nord i altres regions on s’utilitza el sistema NTSC, la freqüència estàndard per a pel·lícules en televisors és %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je standardní frekvence filmového obsahu na televizorech v Severní Americe a dalších oblastech, kde se používá standard NTSC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er standard for filmindhold på fjernsyn i Nordamerika og andre områder, der bruger NTSC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in Nordamerika und anderen Regionen, die NTSC verwenden, der Standard für Filminhalte auf Fernsehgeräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συχνότητα %@ είναι η τυπική συχνότητα για κινηματογραφικό περιεχόμενο σε τηλεοράσεις στη Βόρεια Αμερική και άλλες περιοχές όπου χρησιμοποιείται το πρότυπο NTSC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is standard for film content on televisions in North America and other regions using NTSC."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is standard for film content on televisions in North America and other regions using NTSC."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is standard for film content on televisions in North America and other regions using NTSC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es la frecuencia de actualización estándar de los contenidos cinematográficos en los televisores de Norteamérica y otras regiones que usan el sistema NTSC."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El estándar para el contenido cinematográfico en TV en América del Norte y otras regiones que usan NTSC es %@."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El estándar para el contenido cinematográfico en TV en América del Norte y otras regiones que usan NTSC es %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on elokuvasisällön standardi televisioissa Pohjois-Amerikassa ja muilla alueilla, jotka käyttävät NTSC:tä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est une fréquence standard pour les films sur les téléviseurs en Amérique du Nord et dans les autres régions utilisant le format NTSC."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est la valeur standard pour les films diffusés sur une télévision en Amérique du Nord et dans d’autres régions utilisant la norme NTSC."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ הוא תדר סטנדרטי לסרטים בטלוויזיות בצפון אמריקה ובאזורים אחרים שמשתמשים ב-NTSC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ उत्तरी अमेरिका और NTSC का उपयोग करने वाले अन्य क्षेत्रों में टेलीविज़न पर फ़िल्म कॉन्टेंट के लिए मानक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je standard za filmski sadržaj na televizorima u Sjevernoj Americi i drugim regijama koje koriste NTSC."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ az Észak-Amerika és más, NTSC‑t használó régiók területén használatos televíziók filmes tartalmai esetében szabványos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ standar untuk konten film di televisi di Amerika Utara dan wilayah lainnya yang menggunakan NTSC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è lo standard per i contenuti dei film sui televisori in America del Nord e altre zone che utilizzano NTSC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は北アメリカおよびNTSCを使用しているその他の地域のテレビにおける映画コンテンツの標準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 북미 및 NTSC를 사용하는 기타 지역의 텔레비전 영화 콘텐츠에 대한 표준입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah standard untuk kandungan filem pada televisyen di Amerika Utara dan rantau lain yang menggunakan NTSC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er standard for filminnhold på TV-er i Nord-Amerika og andre områder som bruker NTSC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is standaard voor filmmateriaal op televisies in Noord-Amerika en andere regio's die NTSC gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to standardowa wartość w przypadku materiałów filmowych na telewizorach w Ameryce Północnej i innych regionach używających standardu NTSC."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é o padrão para conteúdo de filme em televisões na América do Norte e outras regiões que usam NTSC."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é o padrão para conteúdo cinematográfico nas televisões da América do Norte e de outras regiões que usem NTSC."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este valoarea standard pentru conținutul filmelor redate la televizor în America de Nord și în alte regiuni care utilizează NTSC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота %@ используется на телевизорах в Северной Америке и других регионах, где действует стандарт NTSC."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je štandard pre filmový obsah na televízoroch v Severnej Amerike a ďalších regiónoch, v ktorých sa používa formát NTSC."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je standard za filmsko vsebino v televizorjih v Severni Ameriki in drugih regijah, ki uporabljajo NTSC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är standard för filminnehåll på TV-apparater i Nordamerika och andra regioner som använder NTSC."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@เป็นความถี่มาตรฐานสำหรับเนื้อหาภาพยนตร์ทางโทรทัศน์ในอเมริกาเหนือและภูมิภาคอื่นที่ใช้ NTSC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Kuzey Amerika’daki ve NTSC kullanan diğer bölgelerdeki televizyonlarda film içeriği standardıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота %@ використовується на телевізорах у Північній Америці та інших регіонах, де використовується стандарт NTSC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là tốc độ tiêu chuẩn cho nội dung phim trên các tivi tại Bắc Mỹ và các vùng khác đang sử dụng NTSC."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用NTSC的北美和其他地区，%@是电视影片内容的标准。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是北美和其他使用NTSC地區電視的影片內容標準。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用NTSC的北美和其他地區，%@為電視的影片內容標準。"
          }
        }
      }
    },
