    "ProvesionalDEPEnrollment": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز يخضع للإدارة عن بُعد. يمكنك إيقاف الإدارة عن بُعد من الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositiu està gestionat remotament. Pots desactivar la gestió remota a l’app Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení je spravováno na dálku. Vzdálenou správu můžete vypnout v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed er administreret eksternt. Du kan slå Ekstern administration fra i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wird entfernt verwaltet. Du kannst die entfernte Verwaltung in den Einstellungen deaktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαχείριση αυτής της συσκευής γίνεται εξ αποστάσεως. Μπορείτε να απενεργοποιήσετε την απομακρυσμένη διαχείριση στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is managed remotely. You can turn off remote management in Settings."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is managed remotely. You can turn off remote management in Settings."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is managed remotely. You can turn off remote management in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se gestiona remotamente. Puedes desactivar la gestión remota desde Ajustes."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se administra de manera remota; puedes cambiar eso en Configuración."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se administra de manera remota; puedes cambiar eso en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä laitetta etähallitaan. Voit laittaa etähallinnan pois päältä Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est géré à distance. Vous pouvez désactiver la gestion à distance dans Réglages."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est géré à distance. Vous pouvez désactiver la gestion à distance dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן זה מנוהל מרחוק. ניתן לכבות את הניהול המרוחק דרך ״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस रिमोट रूप से प्रबंधित किया जाता है। आप सेटिंग में जाकर रिमोट प्रबंधन बंद कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim uređajem upravlja se daljinski. Možete isključiti daljinsko upravljanje u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az eszközt távolról felügyelik. A Távoli felügyeletet a Beállításokban kapcsolhatja ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini dikelola dari jauh. Anda dapat mematikan manajemen jarak jauh di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo è gestito in remoto. Vai in Impostazioni per disattivare l’opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはリモート管理されています。“設定”でリモート管理をオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 원격으로 관리되고 있습니다. 설정에서 원격 관리를 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini diurus secara jauh. Anda boleh menyahaktifkan pengurusan jauh dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten administreres eksternt. Du kan slå av ekstern administrering i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat wordt op afstand beheerd. Je kunt 'Extern beheer' uitschakelen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie jest zarządzane zdalnie. Aby wyłączyć zarządzanie zdalne, przejdź do Ustawień."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo é gerenciado remotamente. Você pode desativar o gerenciamento remoto nos Ajustes."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo é gerido remotamente. Pode desativar a gestão remota nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv este gestionat de la distanță. Puteți dezactiva gestionarea de la distanță din Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство управляется удаленно. Вы можете выключить удаленное управление в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie je spravované na diaľku. Vzdialenú správu môžete vypnúť v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava je oddaljeno upravljana. Oddaljeno upravljanje lahko izklopite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten fjärrhanteras. Du kan stänga av fjärrhanteringen via Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ถูกจัดการระยะไกล คุณสามารถปิดใช้การจัดการระยะไกลได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt uzaktan yönetiliyor. Uzaktan yönetimi Ayarlar’da kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цим пристроєм керують віддалено. Ви можете вимкнути віддалене керування в Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này được quản lý từ xa. Bạn có thể tắt quản lý từ xa trong Cài đặt."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备正由远程管理。你可以在“设置”中关闭远程管理。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置為遙距管理。你可以在「設定」關閉遙距管理。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置從遠端管理。你可以在「設定」中關閉遠端管理。"
          }
        }
      }
    },
    "RCAddManualVolumeControlFinishedDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن التحكم في مستوى الصوت باستخدام الريموت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara pots ajustar el volum des del comandament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď můžete nastavovat hlasitost pomocí ovladače."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nu kontrollere lydstyrken vha. din fjernbetjening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke kann jetzt mit der Fernbedienung gesteuert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα θα μπορείτε να ελέγχετε την ένταση ήχου με το τηλεχειριστήριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now control the volume using your remote."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now control the volume using your remote."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now control the volume using your remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes controlar el volumen con el mando a distancia."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes controlar el volumen con tu control remoto."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes controlar el volumen con tu control remoto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt säätää äänenvoimakkuutta kaukosäätimellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais contrôler le volume grâce à votre télécommande."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais contrôler le volume avec votre télécommande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כעת ניתן לשלוט בעוצמת הקול באמצעות השלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप अपने रिमोट से वॉल्यूम नियंत्रित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada možete regulirati glasnoću pomoću vašeg upravljača."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már vezérelheti a hangerőt a távirányítóval."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini Anda dapat mengontrol volume menggunakan remote Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora è possibile regolare il volume con il telecomando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのリモコンを使って音量をコントロールできるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리모컨을 사용하여 음량을 제어할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kini boleh mengawal kelantangan menggunakan kawalan jauh anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nå styre volumet ved hjelp av fjernkontrollen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu het volume regelen met je afstandsbediening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz możesz sterować głośnością, używając pilota."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode controlar o volume usando o controle remoto."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora pode controlar o volume através do comando à distância."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum puteți controla volumul utilizând telecomanda dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Вы можете регулировать громкость с помощью своего пульта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitosť môžete teraz meniť pomocou ovládača."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj lahko z daljincem upravljate glasnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du justera volymen med fjärrkontrollen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณสามารถควบคุมระดับเสียงโดยใช้รีโมทของคุณได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık ses yüksekliğini kumandanızı kullanarak denetleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете змінювати гучність своїм пультом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ, bạn có thể điều khiển âm lượng bằng điều khiển từ xa."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在可以使用遥控器控制音量。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以使用遙控器控制音量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可使用遙控器來控制音量。"
          }
        }
      }
    },
