    "AppsAllowAccessMSODescriptionAllow": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن %@ من الوصول إلى معلومات\nالاشتراك الخاصة بالتلفزيون."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ podrà accedir a la teva\ninformació de subscripció de TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace %@ bude mít přístup\nk informacím o vašem odběru TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil få adgang til oplysninger\nom dit tv-abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird Zugriff auf deine\nTV-Abo-Informationen haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή «%@» θα έχει πρόσβαση στις\nπληροφορίες τηλεοπτικής συνδρομής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be able to access your\nTV subscription information."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be able to access your\nPay TV subscription information."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be able to access your\nTV subscription information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ podrá acceder a la información\nde tu suscripción de TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ podrá acceder a la información\nde tu suscripción de TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ podrá acceder a la información\nde tu suscripción de TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voi käyttää\nTV-tilauksesi tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pourra accéder aux informations\nrelatives à votre abonnement TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pourra accéder aux informations\nde votre abonnement de télévision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏״⁨%@⁩״ יוכל לגשת אל\nפרטי מינוי שירותי הטלוויזיה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आपकी टीवी सब्सक्रिप्शन जानकारी\nऐक्सेस करने में सक्षम होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ će moći pristupiti informacijama\no vašoj TV pretplati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ hozzá fog férni az Ön\ntelevízió-előfizetési információihoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dapat mengakses\ninformasi langganan TV Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ potrà accedere ai dati\nassociati al tuo abbonamento TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はTVサブスクリプション情報に\nアクセスすることができるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 사용자의 TV 구독 정보에\n접근할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dapat mengakses\nmaklumat langganan TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil få tilgang til informasjon om\nTV-abonnementet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft toegang tot de gegevens\nvan je tv-abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %@ będzie miała dostęp\ndo informacji o Twojej subskrypcji TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poderá acessar as informações\nda sua assinatura de TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terá acesso à informação\nrelativa à sua assinatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ va putea accesa informații\ndespre abonamentul dvs. TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» будет иметь доступ к данным телевизионной подписки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apka %@ bude môcť pristupovať k informáciám o odbere TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %@ bo imela dostop do podatkov\no vaši naročnini na televizijske storitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får tillgång till information om ditt\nTV-abonnemang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะสามารถเข้าถึงข้อมูลการสมัครสมาชิกทีวีของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, TV aboneliği bilgilerinize\nerişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ матиме доступ до даних\nвашої ТБ‑підписки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ có thể truy cập thông tin\nđăng ký TV của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@将可访问你的电视订阅信息。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@將可以取用你的\n電視訂閲項目資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@將可取用你的電視\n訂閱項目資訊。"
