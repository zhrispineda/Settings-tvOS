        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos, souvenirs et illustrations d’albums que vous préférez. Vous pouvez également partager du contenu à partir du réseau de votre domicile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה עטיפות האלבומים שלך מ״מוזיקה״, התמונות או הזיכרונות המועדפים שלך. ניתן גם לשתף פריטים מהרשת הביתית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पसंदीदा तस्वीरें, यादें या संगीत ऐल्बम कलाकृति। आप अपने होम नेटवर्क से भी शेयर कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše omiljene fotografije, uspomene ili omoti glazbenih albuma. Također možete dijeliti sa svoje kućne mreže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvenc fotói, emlékei és a Zenében tárolt albumborítói. A megosztást elvégezheti az otthoni hálózatából is."
