    "APCRDEveryTimeCodeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم طلب رمز PIN في كل مرة تود استخدام البث السريع على Apple TV هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demana un PIN cada vegada que vols reproduir contingut per l’AirPlay a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při každém použití AirPlay bude Apple TV požadovat PIN."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv pinkode, hver gang du vil streame med AirPlay til dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Senden mit AirPlay an dieses Apple TV einen PIN anfordern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαίτηση κωδικού PIN κάθε φορά που επιθυμείτε αναπαραγωγή μέσω AirPlay σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require a PIN every time you want to AirPlay to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Require a PIN every time you want to AirPlay to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Require a PIN every time you want to AirPlay to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un código PIN cada vez que quieras enviar contenido por AirPlay a este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un PIN cada vez que se quiera transmitir por AirPlay a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un PIN cada vez que se quiera transmitir por AirPlay a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadi PIN-koodia joka kerta, kun haluat käyttää AirPlayta tämän Apple TV:n kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigez un code PIN à chaque fois que vous souhaitez diffuser du contenu sur cette Apple TV via AirPlay."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un NIP est requis chaque fois que vous voulez utiliser AirPlay sur cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יידרש קוד PIN עבור כל העברה באמצעות AirPlay ל-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV पर AirPlay के लिए हर बार PIN आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatraživanje PIN-a za svaki AirPlay na ovom Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-kód kérése minden alkalommal, amikor AirPlayjel szeretne lejátszani tartalmat ezen az Apple TV-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlukan PIN setiap kali Anda ingin menggunakan AirPlay ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi un codice PIN ogni volta che vuoi utilizzare AirPlay su Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVにAirPlayするときに毎回PINの入力が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV로 AirPlay할 때마다 PIN을 요구합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlukan PIN setiap kali anda mahu AirPlay ke Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krev en PIN-kode hver gang du vil bruke AirPlay med Apple TV-enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag altijd om een pincode wanneer je AirPlay wilt gebruiken op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumieniowanie przez AirPlay na ten Apple TV każdorazowo wymaga podania kodu PIN."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir um PIN sempre que você quiser usar o AirPlay nesta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir um PIN sempre que quiser usar AirPlay nesta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitați un PIN de fiecare dată când doriți să utilizați AirPlay pe acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз при трансляции через AirPlay на этот Apple TV нужно будет вводить PIN‑код."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri každom pokuse o prehranie obsahu na Apple TV cez AirPlay bude vyžadovaný PIN kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevajte kodo PIN vsakič, ko želite predvajati vsebino prek funkcije AirPlay v tem Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv en PIN-kod varje gång du vill använda AirPlay med denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้รหัส PIN ทุกครั้งที่คุณต้องการเชื่อมต่อผ่าน AirPlay ไปที่ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’ye AirPlay ile bağlanmak istediğiniz her zaman PIN gereksin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати PIN-код щоразу, коли ви хочете транслювати з AirPlay на цей Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu mã PIN mỗi lần bạn muốn phát AirPlay đến Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过这台Apple TV隔空播放时每次都需要PIN码。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次AirPlay至此Apple TV時要求輸入PIN。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每次想要AirPlay到此Apple TV時都須輸入PIN。"
          }
        }
      }
