    "RCLearnRemoteSubInstructionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في الضغط على زر %@ حتى يمتلئ شريط التقدم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut el botó %@ fins que la barra de progrés estigui plena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítko %@ podržte až do zaplnění průběhového indikátoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv ved med at holde knappen %@ nede, indtil statuslinjen er fyldt ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Taste gedrückt halten, bis der Vorgang abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε να κρατάτε πατημένο το κουμπί «%@» μέχρι να γεμίσει η γραμμή προόδου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to hold the %@ button until the progress bar is full."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to hold the %@ button until the progress bar is full."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to hold the %@ button until the progress bar is full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón “%@” hasta que la barra de estado esté llena."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No sueltes el botón %@ hasta que la barra de progreso esté llena."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No sueltes el botón %@ hasta que la barra de progreso esté llena."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä %@painiketta painettuna kunnes edistymispalkki on täynnä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton %@ enfoncé jusqu’à ce que la barre de progression soit pleine."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton %@ enfoncé jusqu’à ce que la barre de progression soit pleine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להמשיך ללחוץ ולהחזיק את הכפתור ״%@״ עד שפס ההתקדמות יתמלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रगति बार के पूरी तरह से भरने तक “%@” बटन होल्ड किए रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite pritisnutu tipku %@ sve dok se traka napretka ne popuni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folyamatosan tartsa lenyomva a(z) %@ gombot, amíg a folyamatsáv végig nem fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus tahan tombol %@ hingga bar kemajuan penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a tenere premuto il tasto %@ fino al completamento della barra di avanzamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行状況バーがいっぱいになるまで“%@”ボタンを押し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 막대가 완료될 때까지 %@ 버튼을 계속 누르고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan menahan butang %@ sehingga bar kemajuan penuh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede %@-knappen til framdriftslinjen er full."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf de knop '%@' ingedrukt houden totdat de voortgangsbalk vol is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj naciśnięty przycisk %@, aż pasek postępu dojdzie do końca."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue mantendo pressionado o botão %@ até que a barra de progresso esteja completa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue a manter premido o botão %@ até a barra de progresso estar completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuați să țineți apăsat butonul %@ până când bara de evoluție se umple."
