    "SiriTCCNoAppsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للتطبيقات بالوصول إلى Siri لتظهر هنا."
          }
        },
        "ca": {
