        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal mengambil daftar train dari server. Periksa VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare l’elenco di train dal server. Controlla la VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバからトレインを取得できませんでした。VPNを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 트레인을 가져오지 못했습니다. VPN을 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal mengambil senarai train daripada pelayan. Semak VPN."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke hente byggtog-liste fra tjeneren. Kontroller VPN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen lijst met trains ophalen van de server. Controleer VPN."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista trains nie została pobrana z serwera. Sprawdź połączenie VPN."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao obter a lista de trens do servidor. Verifique a VPN."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a lista de trains do servidor. Verifique a VPN."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a putut fi accesată lista trenurilor de pe server. Verificați conexiunea VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить список трейнов с сервера. Проверьте VPN."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam verzií sa nepodarilo načítať zo servera. Skontrolujte VPN."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bilo mogoče pridobiti seznama sklopov od strežnika. Preverite VPN."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att hämta train-listan från servern. Kontrollera VPN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงรายการ Train จากเซิร์ฟเวอร์ไม่สำเร็จ ให้ตรวจสอบ VPN"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudan bir dizi listesi alınamadı. VPN’i denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалось отримати список гілок ПЗ із сервера. Перевірте VPN‑зʼєднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tìm nạp danh sách phiên bản từ máy chủ. Hãy kiểm tra VPN."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从服务器抓取序列列表。请检查VPN。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從伺服器取得Train列表。請檢查VPN。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從伺服器擷取系列列表。請檢查VPN。"
          }
        }
      }
