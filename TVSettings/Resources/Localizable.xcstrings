    "AXCaptionsAndSDHDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "استخدام الشرح المكتوب لأحداث العرض أو الترجمة للصم وضعاف السمع (SDH)، في حالة توفرهما.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Quan estan disponibles, utilitza els subtítols descriptius o els subtítols per a persones sordes o amb dificultats auditives.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Použít skryté titulky nebo titulky pro sluchově postižené a neslyšící (SDH), jsou-li k dispozici.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Brug closed captions eller undertekster til døve og hørehæmmede (TH), når de er tilgængelige.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Wenn verfügbar, erweiterte Untertitel oder Untertitel für Taube oder Hörgeschädigte (UT) verwenden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Όταν διατίθενται, να χρησιμοποιούνται οι κλειστές λεζάντες ή οι υπότιτλοι για κωφούς και άτομα με δυσκολίες ακοής (SDH).",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "When available, use closed captions or subtitles for the deaf and hard of hearing (SDH).",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "When available, use closed captions or subtitles for the deaf and hard of hearing (SDH).",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "When available, use closed captions or subtitles for the deaf and hard of hearing (SDH).",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "When available, use closed captions or subtitles for the deaf and hard of hearing (SDH).",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "When available, use closed captions or subtitles for the deaf and hard of hearing (SDH).",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Se usan los subtítulos descriptivos o para sordos cuando estén disponibles.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Si se activa, se usarán los subtítulos opcionales y para sordera cuando estén disponibles.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Si se activa, se usarán los subtítulos opcionales y para sordera cuando estén disponibles.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Käytä kuvailevaa tai ohjelmatekstitystä, kun sellainen on saatavilla.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Utilisez les sous-titres codés et les sous-titres pour sourds et malentendants (SM) si ceux-ci sont disponibles.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Si disponibles, utilisez les sous-titres codés pour sourds et malentendants (SM).",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להשתמש בתרגום או כתוביות לכבדי שמיעה (SDH) בהתאם לזמינות.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "उपलब्ध होने पर क्लोज़्ड कैप्शन या बधिर और कम सुनने वाले लोगों के लिए सबटाइटल (SDH) का उपयोग करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Kad su dostupni, koristit će se prošireni titlovi ili titlovi za gluhe i osobe s oštećenim sluhom (SDH).",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Amikor elérhető, szöveges átiratok vagy siketek és nagyothallók számára készült feliratok (SDH) használata.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Jika tersedia, gunakan teks tertulis atau subtitle untuk penderita tuna rungu dan kesulitan mendengar (SDH).",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Quando disponibili, usa i sottotitoli per non udenti o i sottotitoli per persone con problemi di udito (SDH).",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "使用可能な場合は、クローズドキャプションまたは耳の不自由な方向けの字幕（SDH）を使用します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "사용 가능한 경우 청각 장애인용 자막 또는 청각 장애가 있거나 난청이 있는 사람들을 위한 자막(SDH)을 사용합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Apabila tersedia, gunakan kapsyen tertutup atau sari kata untuk pengguna pekak dan kurang pendengaran (SDH).",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Gebruik bijschriften voor spraak en geluiden of ondertiteling voor doven en slechthorenden (O.D.S.), indien beschikbaar.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Bruk skjult tekst eller teksting for døve og tunghørte (SDH) når det er tilgjengelig.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Używaj napisów dla niesłyszących, jeśli są dostępne.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Quando disponível, usar legendas ocultas ou legendas para pessoas surdas ou com dificuldades auditivas (SDH).",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Se disponível, usar legendagem opcional ou legendas para pessoas com dificuldades auditivas.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "În funcție de disponibilitate, utilizați subtitrările complexe sau subtitrările pentru deficiențe auditive (SDH).",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Использовать субтитры или скрытые субтитры (если доступно) для людей с нарушениями слуха (SDH).",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Ak sú dostupné, použiť skryté titulky alebo titulky pre nepočujúcich či osoby s poruchami sluchu (SDH).",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Ko je mogoče, bodo uporabljeni podnapisi ali podnaslovi za gluhe in naglušne.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Dold textning eller undertextning för döva och hörselskadade (SDH) används om tillgängligt.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ถ้ามี ให้ใช้คำบรรยายภาพหรือคำบรรยายสำหรับผู้ฟังที่หูหนวกหรือมีปัญหาทางการได้ยิน (SDH)",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Varsa, açıklamalı altyazıları veya işitme engelliler ve işitme güçlüğü çekenler için altyazıları (SDH) kullan.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Використовувати приховані субтитри (CC) або субтитри для людей з вадами слуху (SDH), коли вони є.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Khi có sẵn, sử dụng chú thích chi tiết hoặc phụ đề cho người điếc hoặc khiếm thính (SDH).",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "可用时，使用隐藏式字幕或失聪及听障者字幕(SDH)。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "如有提供，使用隱藏式字幕或失聰與聽障人士用字幕（SDH）。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "若有提供，使用隱藏式字幕或失聰與聽障人士用字幕（SDH）。",
            "state": "translated"
          }
        }
      }
    },
