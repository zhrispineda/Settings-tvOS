    "SaverSelectionDescriptionSyncing": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستكون شاشة التوقف هذه متاحة بعد مزامنة الصور من iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estalvi de pantalla estarà disponible un cop s’hagin sincronitzat les fotos de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento spořič bude k dispozici, až se vaše fotky sesynchronizují s iCloudem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skærmskåner vil være tilgængelig, efter at dine fotos er blevet synkroniseret fra iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirmschoner ist verfügbar, nachdem deine Fotos von iCloud synchronisiert wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
