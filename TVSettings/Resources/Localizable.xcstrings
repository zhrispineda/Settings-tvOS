    "RCVCInstructionalTextNoRemote": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد التحكم في مستوى الصوت.\nتم التعطيل نظًرا لعدم توصيل أي ريموت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el control del volum.\nEstà desactivat perquè no hi ha cap comandament connectat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte ovládání hlasitosti.\nVypnuto, protože není připojený žádný ovladač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurer din lydstyrkejustering.\nSlået fra, fordi der ikke er tilsluttet en fjernbetjening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärkeregelung konfigurieren.\nDeaktiviert, weil keine Fernbedienung angeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαμορφώστε τον έλεγχο έντασης ήχου.\nΑπενεργοποιήθηκε διότι δεν υπάρχει συνδεδεμένο τηλεχειριστήριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure your volume control.\nDisabled because no remote is connected."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure your volume control.\nDisabled because no remote is connected."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure your volume control.\nDisabled because no remote is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el control de volumen.\nDesactivado porque no hay ningún mando a distancia conectado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el control del volumen.\nDesactivado debido a que no hay un control remoto conectado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el control del volumen.\nDesactivado debido a que no hay un control remoto conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä äänenvoimakkuuden säätö.\nEi käytettävissä, koska kaukosäädintä ei ole yhdistetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez la commande de volume.\nElle est désactivée car aucune télécommande n’est connectée."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le contrôle du volume.\nDésactivé, car il n’y a aucune télécommande de connectée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להגדיר את בקרת עוצמת השמע.\nהאפשרות כבויה משום שלא חיברת שלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम कंट्रोल कॉन्फ़िगर करें।\nअभी अक्षम है क्योंकि कोई रिमोट कनेक्टेड नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurirajte postavke glasnoće.\nOnemogućeno jer nije spojen nijedan daljinski upravljač."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangerőszabályzó konfigurálása.\nLe van tiltva, mert nem csatlakozik távirányító."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi kontrol volume Anda.\nDinonaktifkan karena tidak ada remote yang terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura il controllo del volume.\nL’opzione è disabilitata perché non ci sono telecomandi connessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量コントロールを構成してください。\nリモコンが接続されていないため無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 음량 조절을 구성합니다.\n연결된 리모컨이 없기 때문에 비활성화되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi kawalan kelantangan anda.\nDinyahdayakan kerana tiada kawalan jauh disambungkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurer volumkontrollen.\nDeaktivert fordi ingen fjernkontroll er koblet til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumeregeling configureren.\nUitgeschakeld omdat er geen afstandsbediening is aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj sterowanie głośnością.\nWyłączone — nie połączono pilota."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o controle de volume.\nDesativado porque não há um controle remoto conectado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o controlo do volume.\nEste foi desativado porque não está ligado nenhum comando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurați controlul volumului.\nOpțiune dezactivată, deoarece nu este conectată nicio telecomandă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте регулятор громкости.\nФункция недоступна, если пульт не подключен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte ovládanie hlasitosti.\nNeaktívne, pretože nie je pripojený žiadny ovládač."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurirajte upravljanje glasnosti.\nOnemogočeno, ker ni povezan noben daljinec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurera volymreglaget.\nAvaktiverat eftersom ingen fjärrkontroll är ansluten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดค่าการควบคุมระดับเสียงของคุณ\nเลือกปิดใช้งานถ้าไม่มีรีโมทเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyi denetiminizi ayarlayın.\nHiçbir kumanda bağlı olmadığı için etkin değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сконфігуруйте керування гучністю.\nВимкнено, бо не підʼєднано пульт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định cấu hình điều khiển âm lượng của bạn.\nĐã bị tắt vì không có điều khiển từ xa nào được kết nối."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "配置音量控制。\n因为未与遥控器连接，现已停用。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設置你的音量控制。\n由於未有連接遙控器，現已停用。"
