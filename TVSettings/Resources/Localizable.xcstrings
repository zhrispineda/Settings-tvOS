        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto, i ricordi o le illustrazioni degli album di Musica che ami. Puoi anche condividere contenuti dalla tua rete domestica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの写真、メモリー、または“ミュージック”のアルバムアートです。ホームネットワークから共有することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 사진, 추억 또는 음악 앨범 표지입니다. 홈 네트워크에서 공유할 수도 있습니다."
          }
