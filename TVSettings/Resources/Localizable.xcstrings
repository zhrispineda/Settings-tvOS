    "WHAAccessoryRemoveFailedDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المحاولة مرة أخرى لاحقًا، أو إزالته باستخدام تطبيق المنزل على جهاز iOS الذي يستخدم حساب iCloud: ‏%@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots tornar‑ho a provar més tard o eliminar‑lo des de l’app Casa d’un dispositiu iOS que utilitzi el compte de l’iCloud “%@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to znovu později nebo Apple TV odstraňte v aplikaci Domácnost na iOS zařízení, které používá účet na iCloudu %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prøve igen senere, eller fjerne det med appen Hjem på en iOS‑enhed vha. iCloud‑kontoen %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es später erneut versuchen oder das Gerät mit der Home-App auf dem iOS-Gerät entfernen, das den iCloud-Account „%@“ verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να δοκιμάσετε πάλι αργότερα ή να το αφαιρέσετε με την εφαρμογή «Οικία» σε μια συσκευή iOS που χρησιμοποιεί τον λογαριασμό iCloud %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try again later, or remove it with the Home app on an iOS device using the iCloud account %@"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try again later, or remove it with the Home app on an iOS device using the iCloud account %@"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try again later, or remove it with the Home app on an iOS device using the iCloud account %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes intentarlo de nuevo más tarde o eliminarlo con la app Casa desde un dispositivo iOS con la cuenta de iCloud %@."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a intentarlo más tarde o eliminarlo desde la app Casa en un dispositivo iOS que use la cuenta de iCloud %@"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a intentarlo más tarde o eliminarlo desde la app Casa en un dispositivo iOS que use la cuenta de iCloud %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit yrittää myöhemmin uudelleen tai poistaa sen sillä iOS-laitteen Koti-apilla käyttäen iCloud-tiliä %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez ultérieurement ou supprimez-la avec l’app Maison sur un appareil iOS utilisant le compte iCloud %@"
