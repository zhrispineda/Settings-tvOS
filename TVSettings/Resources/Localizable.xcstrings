        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos vil bli ignorert og standard surroundlyd spilles i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos wordt genegeerd en in plaats daarvan wordt surround sound standaard afgespeeld."
          }
        },
        "pl": {
