            "value": "स्क्रीन पर मौजूद VoiceOver स्पीच परिणामों को कैप्शन पैनल में दिखाएँ",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Prikazuje VoiceOver glasovni izlaz na zaslonu u prozoru s titlovima",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A VoiceOver beszédkimenetének megjelenítése a képernyőn egy feliratpanelben",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tampilkan output ucapan VoiceOver pada layar di panel teks",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Mostra sullo schermo l’output della lettura di VoiceOver in un pannello di sottotitoli.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverの読み上げの出力をオンスクリーンのキャプションパネルに表示",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "자막 패널에 VoiceOver 음성 출력 화면을 표시합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tunjukkan output pertuturan VoiceOver atas skrin dalam panel kapsyen",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Toon VoiceOver-spraakuitvoer op het scherm in een bijschriftenpaneel",
