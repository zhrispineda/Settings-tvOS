    "AVDolbySurroundSoundWithAtmosDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Apple TV تلقائيًا أفضل تنسيق\nصوت متاح، بما في ذلك Dolby Atmos.\n\nإذا كنت تواجه مشكلات في إعادة التشغيل، يمكنك\nتجربة تنسيق مختلف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilitza automàticament el millor format\nd’àudio disponible, inclòs Dolby Atmos.\n\nSi tens cap problema per reproduir l’àudio, pots provar\nd’utilitzar un altre format."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automaticky použije nejlepší dostupný\nformát zvuku včetně Dolby Atmos.\n\nPokud máte se zvukem problémy, můžete\nzkusit jiný formát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV bruger automatisk det bedst tilgængelige\nlydformat, inklusive Dolby Atmos.\n\nHvis du har problemer med afspilning, kan du\nprøve med et andet format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV verwendet automatisch das bestmögliche\nAudioformat, einschließlich Dolby Atmos.\n\nWenn es bei der Wiedergabe Probleme gibt, versuche es\nmit einem anderen Format."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV χρησιμοποιεί αυτόματα τη βέλτιστη διαθέσιμη\nμορφή ήχου, συμπεριλαμβανομένου του Dolby Atmos.\n\nΑν αντιμετωπίζετε προβλήματα αναπαραγωγής,\nμπορείτε να δοκιμάσετε μια διαφορετική μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available, including Dolby Atmos.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available, including Dolby Atmos.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV automatically uses the best audio\nformat available, including Dolby Atmos.\n\nIf you’re experiencing problems with playback, you can\ntry a different format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV utiliza automáticamente el mejor\nformato de audio disponible, incluido Dolby Atmos.\n\nSi encuentras problemas con la reproducción,\npuedes probar con otro formato."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV usa automáticamente el mejor formato de audio\ndisponible incluyendo Dolby Atmos.\n\nSi tienes problemas para reproducir el audio, puedes\nprobar con otro formato."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV usa automáticamente el mejor formato de audio\ndisponible incluyendo Dolby Atmos.\n\nSi tienes problemas para reproducir el audio, puedes\nprobar con otro formato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV käyttää automaattisesti parasta äänimuotoa,\njoka on saatavilla, mukaan lukien Dolby Atmos.\n\nJos toistossa on ongelmia, voit\nkokeilla toista muotoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV utilise automatiquement le meilleur\nformat disponible, y compris Dolby Atmos.\n\nEn cas de problèmes de lecture, vous pouvez\nessayer un autre format."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV utilise automatiquement le meilleur format\ndisponible, y compris Dolby Atmos.\n\nEn cas de problèmes de lecture, vous pouvez\nessayer un format différent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV משתמש באופן אוטומטי בפורמט השמע הטוב ביותר\nהזמין, כולל Dolby Atmos.\n\nבמקרה של בעיות בהפעלה, ניתן\nלנסות פורמט אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV ऑटोमैटिकली सबसे बढ़िया ऑडियो का इस्तेमाल करता है\nऑडियो फ़ॉर्मैट का ऑटोमैटिकली इस्तेमाल करता है।\n\nअगर आपको प्लेबैक में समस्या हो रही है, तो आप\nकोई और फ़ॉर्मैट आज़मा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatski koristi najbolji dostupan\naudio format, uključujući Dolby Atmos.\n\nAko imate problema s reprodukcijom, možete pokušati\ns drugim formatom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV-je automatikusan az elérhető legjobb\nhangformátumot használja, a Dolby Atmost is beleértve.\n\nAmennyiben problémákat tapasztal a lejátszással kapcsolatban,\npróbáljon másik formátumot használni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda akan secara otomatis menggunakan format audio terbaik\nyang tersedia, termasuk Dolby Atmos.\n\nJika Anda mengalami masalah pada pemutaran, Anda dapat\nmencoba format lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV utilizza in automatico il miglior formato\naudio disponibile, tecnologia Dolby Atmos inclusa.\n\nSe riscontri problemi di riproduzione,\nprova con un formato differente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのApple TVでは、利用可能な最高品質のオーディオ\nフォーマット（ドルビーアトモスを含む）が自動的に使用されます。\n\n再生に問題がある場合は、\n別のフォーマットをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 Dolby Atmos 등 사용 가능한\n최고의 오디오 음질을 자동으로 사용합니다.\n\n재생에 문제가 발생하면\n다른 포맷을 시도할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda menggunakan format audio terbaik\nyang tersedia secara automatik, termasuk Dolby Atmos.\n\nJika anda mengalami masalah dengan main balik, anda boleh\nmencuba format berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bruker automatisk beste\ntilgjengelige lydformatet, inkludert Dolby Atmos.\n\nHvis du har problemer med avspillingen, kan du\nprøve med et annet format."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV gebruikt automatisch de best\nbeschikbare audiostructuur, inclusief Dolby Atmos.\n\nAls je problemen ondervindt met afspelen, kun je\neen andere structuur proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatycznie używa najlepszego\ndostępnego formatu, w tym Dolby Atmos.\n\nJeśli występują problemy z odtwarzaniem, możesz\nspróbować użyć innego formatu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usa automaticamente o melhor formato\nde áudio disponível, incluindo o Dolby Atmos.\n\nSe tiver problemas com a reprodução, você pode\nexperimentar um formato diferente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV usa automaticamente o melhor formato\nde áudio disponível, incluindo Dolby Atmos.\n\nCaso detete algum problema com a reprodução,\npode experimentar usar um formato diferente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul utilizează automat cel mai bun format audio\ndisponibil, inclusiv Dolby Atmos.\n\nDacă întâmpinați probleme legate de redare, puteți\nîncerca un format diferit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет автоматически использован наилучший\nиз доступных аудиоформатов, включая Dolby Atmos.\n\nПри возникновении проблем с воспроизведением\nпопробуйте использовать другой формат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automaticky použije najlepší dostupný\nformát audia vrátane formátu Dolby Atmos.\n\nAk máte problémy s prehrávaním, môžete skúsiť\npoužiť iný formát."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV samodejno uporabi najboljšo obliko zvočnega zapisa, ki\nje na voljo, vključno z zvokom Dolby Atmos.\n\nČe imate težave s predvajanjem, lahko\nposkusite drugo obliko zapisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV använder automatiskt det bästa\ntillgängliga ljudformatet, inklusive Dolby Atmos.\n\nOm du upplever problem med uppspelningen\nkan du prova ett annat format."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณจะใช้รูปแบบเสียงดีที่สุดที่มี\nโดยอัตโนมัติ รวมทั้ง Dolby Atmos\n\nถ้าคุณประสบปัญหากับการเล่น คุณสามารถ\nลองรูปแบบอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz, Dolby Atmos da dahil olmak üzere en iyi ses biçimini\notomatik olarak kullanmak için bunu kapatın.\n\nOynatmayla ilgili bir sorun yaşıyorsanız\nbaşka bir biçim deneyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV автоматично застосовує найкращий\nіз доступних форматів звуку, зокрема Dolby Atmos.\n\nЯкщо з відтворенням виникають проблеми, можна\nспробувати інший формат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn tự động sử dụng định dạng âm thanh\ntốt nhất có sẵn, bao gồm Dolby Atmos.\n\nNếu đang gặp phải sự cố phát lại thì bạn có thể\nthử một định dạng khác."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV自动使用最佳可用的\n音频格式，包括杜比全景声。\n\n如果播放出现问题，你可以尝试\n其他格式。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會自動使用可用的最佳音訊\n格式，包括杜比全景聲。\n\n如你遇到播放問題，可以\n嘗試使用另一種格式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會自動使用最佳的音訊格式，\n包含杜比全景聲。\n\n若你遇到播放的問題，可嘗試不同的\n格式。"
          }
        }
      }
    },
    "AVDolbySurroundSoundWithConvertFormatDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغيّر Apple TV تنسيق الصوت بحيث يكون\nمتوافقًا مع جهازك.\n\nيمكنك إيقاف هذا الإعداد ليتم استخدام أفضل تنسيق صوت متاح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es canviarà el format d’àudio de l’Apple TV perquè\nsigui compatible amb l’equip.\n\nDesactiva aquesta opció per utilitzar automàticament el millor format d’àudio disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV změní formát zvuku tak, aby byl\nkompatibilní se zvukovou soustavou.\n\nKdyž tuto funkci vypnete, automaticky se použije nejlepší dostupný formát zvuku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV ændrer lydformatet, for at være\nkompatibelt med dit udstyr.\n\nSlå dette fra for automatisk at bruge det bedst tilgængelige lydformat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV ändert das Audioformat, damit es\nmit deinem Equipment kompatibel ist.\n\nDeaktiviere diese Option, um automatisch das bestmögliche Audioformat zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα αλλάξει τη μορφή ήχου ώστε να είναι\nσυμβατή με τον εξοπλισμό σας.\n\nΑπενεργοποιήστε αυτήν τη ρύθμιση για αυτόματη χρήση της βέλτιστης διαθέσιμης μορφής ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format available."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format available."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV will change the audio format to be\ncompatible with your equipment.\n\nTurn this off to automatically use the best audio format available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV cambiará el formato de audio para que\nsea compatible con tu equipo.\n\nDesactiva esta opción para usar automáticamente el mejor formato de audio disponible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cambiará el formato de audio para que sea\ncompatible con tu equipo.\n\nDesactiva esto para usar automáticamente el mejor formato de audio disponible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV cambiará el formato de audio para que sea\ncompatible con tu equipo.\n\nDesactiva esto para usar automáticamente el mejor formato de audio disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV muuttaa äänimuotoa, jotta se on\nyhteensopiva laitteesi kanssa.\n\nJos laitat tämän pois päältä, käytetään parasta saatavilla olevaa äänimuotoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV changera le format audio pour quʼil soit\ncompatible avec votre équipement.\n\nDésactivez cette option pour utiliser automatiquement le meilleur format audio disponible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV modifiera le format audio pour le rendre\ncompatible avec votre équipement.\n\nDésactivez cette fonction pour utiliser automatiquement le meilleur format audio disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישנה את פורמט השמע כך שיהיה\nתואם לציוד שלך.\n\nניתן לבטל הגדרה זו כדי להשתמש באופן אוטומטי בפורמט השמע הטוב ביותר הזמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV ऑडियो फ़ॉर्मैट को इस तरह बदल देगा जिससे\nकि वो आपके उपकरण के साथ संगत हो।\n\nसर्वोत्तम उपलब्ध ऑडियो फ़ॉर्मैट का ऑटोमैटिकली इस्तेमाल करने के लिए इसे बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV promijenit će audio format kako bi bio\nkompatibilan s vašom opremom.\n\nMožete to isključiti kako bi se automatski koristio najbolji dostupni audio format."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV-je módosítja a hangformátumot, hogy az\nkompatibilis legyen a berendezésével.\n\nKapcsolja ki az elérhető legjobb hangformátum automatikus használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda akan mengubah format audio agar\nkompatibel dengan perlengkapan Anda.\n\nMatikan ini untuk menggunakan format audio terbaik yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV modificherà il formato audio in modo tale da\nrenderlo compatibile con il tuo impianto.\n\nDisattiva l’opzione per utilizzare automaticamente il miglior formato audio disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのApple TVでは、オーディオフォーマットが\nお使いの機器と互換性のあるものに自動的に変更されます。\n\n使用可能な最高品質のフォーマットを自動的に使用するには、これをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용자의 장비와 호환되도록\n오디오 포맷을 변경합니다.\n\n사용 가능한 최고의 오디오 음질을 자동으로 사용하려면 이 기능을 끄십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda akan menukar format audio supaya\nserasi dengan peralatan anda.\n\nNyahaktifkannya untuk menggunakan format audio terbaik yang tersedia secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil bytte til et lydformat som er\nkompatibelt med utstyret ditt.\n\nSlå av innstillingen for å automatisk bruke det beste tilgjengelige lydformatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV wijzigt de audiostructuur\nzodat deze compatibel is met je apparatuur.\n\nSchakel dit uit om automatisch de best beschikbare audiostructuur te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie zmieniać format audio\nna zgodny ze sprzętem.\n\nWyłącz tę opcję, aby automatycznie używać najlepszego dostępnego formatu dźwięku."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV mudará o formato de áudio para que\nfique compatível com seu equipamento.\n\nDesative essa opção para usar automaticamente o melhor formato de áudio disponível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de áudio será alterado para ser\ncompatível com o equipamento.\n\nDesative esta opção para usar automaticamente\no melhor formato de áudio disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul dvs. va schimba formatul audio pentru a fi\ncompatibil cu echipamentul dvs.\n\nDezactivați această opțiune pentru a utiliza automat cel mai bun format audio disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет изменен аудиоформат, чтобы повысить\nсовместимость с Вашим аудиооборудованием.\n\nВыключите этот параметр, чтобы автоматически использовать наилучший из доступных аудиоформатов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV zmení formát audia tak, aby bol\nkompatibilný s vašou zvukovou aparatúrou.\n\nAk chcete automaticky použiť najlepší dostupný formát audia, vypnite túto možnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo spremenil obliko zvočnega zapisa, da bo\nzdružljiva z vašo opremo.\n\nIzklopite to možnost, da bo samodejno uporabljena najboljša oblika zvočnega zapisa, ki je na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV ändrar ljudformat så att det blir\nkompatibelt med din utrustning.\n\nAvaktivera det här alternativet om du automatiskt vill använda det bästa tillgängliga ljudformatet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณจะเปลี่ยนรูปแบบเสียง\nให้สามารถใช้งานร่วมกับอุปกรณ์ของคุณได้\n\nปิดใช้การตั้งค่านี้เพื่อใช้รูปแบบเสียงที่ดีที่สุดที่มีโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz ses biçimini\nekipmanınızla uyumlu olacak şekilde değiştirir.\n\nVar olan en iyi ses biçimini otomatik olarak kullanmak için bunu kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV змінюватиме формат звуку\nдля забезпечення сумісності з обладнанням.\n\nВимкніть цей параметр, щоб найкращий із доступних форматів застосовувавсь автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn sẽ thay đổi định dạng âm thanh để\ntương thích với thiết bị của bạn.\n\nHãy tắt tính năng này để tự động sử dụng định dạng âm thanh tốt nhất có sẵn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将更改音频格式以\n与你的设备兼容。\n\n关闭此选项来自动使用最佳可用的音频格式。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV會將音訊格式改為\n與你的設備相容的格式。\n\n關閉此功能以自動使用可用的最佳音訊格式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV將會更改音訊格式，與設備更為\n相容。\n\n關閉此功能會自動使用最佳的音訊格式。"
          }
        }
      }
    },
