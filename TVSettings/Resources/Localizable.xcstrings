          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign in manually?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres iniciar sesión manualmente?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres iniciar sesión de forma manual?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres iniciar sesión de forma manual?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudutaanko sisään käsin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment vous connecter manuellement ?"
          }
        },
        "fr_CA": {
