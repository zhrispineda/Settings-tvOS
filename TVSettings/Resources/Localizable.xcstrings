    "AVSurroundOdeonDolbyAtmosDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرسل Apple TV تلقائيًا الصوت المحيطي وصوت استريو إلى HomePod mini كسماعات مسرح منزلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV enviarà automàticament el so envoltant i l’àudio estèreo als altaveus HomePod mini de cinema domèstic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícekanálový a stereofonní zvuk bude Apple TV automaticky směrovat do HomePodů mini ve vašem domácím kině."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sender automatisk surroundsound- og stereolyd til HomePod mini-højttalerne i din hjemmebiograf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sendet automatisch Surround-Sound- und Stereoaudio an die HomePod mini-Lautsprecher deines Heimkinos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα αποστέλλει αυτόματα τον ήχο surround και τον στερεοφωνικό ήχο στα ηχεία HomePod mini του οικιακού σινεμά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send surround sound and stereo audio to your home theater HomePod mini speakers."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send surround sound and stereo audio to your home cinema HomePod mini speakers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send surround sound and stereo audio to your home cinema HomePod mini speakers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio estéreo y el sonido envolvente a los altavoces HomePod mini que hayas configurado como sistema de sala de cine."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio estéreo y surround a las bocinas HomePod mini de tu cine en casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio estéreo y surround a los altavoces HomePod mini de tu cine en casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV lähettää surround- ja stereoäänen automaattisesti kotiteatterisi HomePod mini -kaiuttimiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV transférera automatiquement le son surround et stéréo sur les HomePod mini de votre home cinéma."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV transmettra automatiquement le son Atmos, ambiophonique et stéréo à vos HomePod mini en mode cinéma maison."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישלח באופן אוטומטי שמע מסוג Atmos, צליל היקפי וצליל סטריאו לרמקולי ה-HomePod mini של הקולנוע הביתי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV आपके होम थिएटर HomePod mini स्पीकर पर सराउंड साउंड और स्टीरियो ऑडियो ऑटोमैटिकली भेजेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatski će poslati surround i stereo zvuk na HomePod mini zvučnike vašeg kućnog kina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A térhangzású és a sztereó hangot az Apple TV automatikusan fogja sugározni a házimozirendszere HomePod mini-hangszóróira."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan secara otomatis mengirimkan bunyi lingkup dan audio stereo ke speaker HomePod mini home theater Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV invierà automaticamente audio surround e stereo agli altoparlanti HomePod mini del sistema home theater."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVは、サラウンドサウンドおよびステレオのオーディオをホームシアターのHomePod miniスピーカーから自動的に再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 서라운드 사운드 및 스테레오 오디오를 자동으로 홈 시어터 HomePod mini 스피커에 전송합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan menghantar audio bunyi keliling dan stereo secara automatik ke speaker teater rumah HomePod mini anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sender automatisk Atmos-, surround- og stereolyd til HomePod mini-høyttalerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV stuurt automatisch surround sound- en stereogeluid naar de HomePod mini-luidsprekers van je thuisbioscoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie automatycznie wysyłać dźwięk przestrzenny i stereo do HomePodów mini skonfigurowanych jako głośniki kina domowego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV enviará automaticamente o áudio Atmos, som surround e estéreo para os HomePods mini do seu home theater."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV enviará automaticamente som envolvente e áudio estéreo para as colunas HomePod mini de sala de cinema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va trimite automat sunetul surround și stereo pe difuzoarele home theater HomePod mini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV будет перенаправлять объемный звук и стереозвук на колонки HomePod mini домашнего кинотеатра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude automaticky posielať priestorový a stereo zvuk do HomePodov mini domáceho kina."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo samodejno poslal prostorski in stereo zvok v zvočnike HomePod mini vašega domačega kina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV skickar automatiskt surroundljud och stereoljud till din hemmabios HomePod mini-högtalare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะส่งเสียงรอบทิศทางและเสียงสเตอริโอไปยังลำโพงโฮมเธียเตอร์บน HomePod mini ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV; Surround ve stereo sesleri otomatik olarak ev sinema sistemi HomePod mini hoparlörlerinize gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV автоматично спрямовуватиме звук форматів «Обʼємний звук» і «Стерео» на динаміки HomePod mini домашнього кінозалу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ tự động gửi âm thanh vòm và âm thanh stereo đến các loa HomePod mini rạp hát gia đình của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV会自动将环绕声和立体声音频发送至家庭影院HomePod mini扬声器。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會將環繞音效和立體音訊自動傳送到你的家庭影院HomePod mini喇叭。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會自動傳送環繞音效和立體聲音訊到家庭劇院HomePod mini揚聲器。"
          }
        }
      }
    },
    "AVSurroundOdeonDolbyAtmosEnabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرسل Apple TV تلقائيًا صوت Atmos والصوت المحيطي وصوت استريو إلى HomePod كسماعات مسرح منزلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV enviarà automàticament l’àudio Atmos, el so envoltant i l’àudio estèreo als altaveus HomePod de cinema domèstic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk ve formátu Atmos, vícekanálový a stereofonní zvuk bude Apple TV automaticky směrovat do HomePodů ve vašem domácím kině."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sender automatisk Atmos-, surroundsound- og stereolyd til HomePod-højttalerne i din hjemmebiograf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sendet automatisch Atmos-, Surround-Sound- und Stereoaudio an deine Heimkino-HomePod-Lautsprecher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα αποστέλλει αυτόματα τον ήχο Atmos, surround και στερεοφωνικό ήχο στα ηχεία HomePod του οικιακού σινεμά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send Atmos, surround sound, and stereo audio to your home theater HomePod speakers."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send Atmos, surround sound and stereo audio to your home cinema HomePod speakers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will automatically send Atmos, surround sound and stereo audio to your home cinema HomePod speakers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio Atmos, el audio estéreo y el sonido envolvente a los altavoces HomePod que hayas configurado como sistema de sala de cine."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio estéreo, surround y Atmos a las bocinas HomePod de tu cine en casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV enviará automáticamente el audio estéreo, surround y Atmos a los altavoces HomePod de tu cine en casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV lähettää Atmos-, surround- ja stereoäänen automaattisesti kotiteatterisi HomePod-kaiuttimiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV transférera automatiquement le son Atmos, surround et stéréo sur les HomePod de votre home cinéma."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV transmettra automatiquement le son Atmos, ambiophonique et stéréo à vos HomePod en mode cinéma maison."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV ישלח באופן אוטומטי שמע מסוג Atmos, צליל היקפי וצליל סטריאו לרמקולי ה-HomePod של הקולנוע הביתי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV आपके होम थिएटर HomePod स्पीकर पर Atmos, सराउंड साउंड और स्टीरियो ऑडियो ऑटोमैटिकली भेजेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV automatski će poslati Atmos, surround zvuk i stereo zvuk na HomePod zvučnike vašeg kućnog kina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Atmos-, a térhangzású és a sztereó hangot az Apple TV automatikusan fogja sugározni a házimozirendszere HomePod-hangszóróira."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan secara otomatis mengirimkan audio Atmos, bunyi lingkup, dan stereo ke speaker HomePod home theater Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV invierà automaticamente audio Atmos, surround e stereo agli altoparlanti HomePod del sistema home theater."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVはドルビーアトモス、サラウンドサウンド、およびステレオのオーディオをホームシアターのHomePodスピーカーから再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 Atmos, 서라운드 사운드 및 스테레오 오디오를 자동으로 홈 시어터 HomePod 스피커에 전송합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan menghantar audio Atmos, bunyi keliling dan stereo secara automatik ke speaker teater rumah HomePod anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sender automatisk Atmos-, surround- og stereolyd til HomePod-høyttalerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV stuurt automatisch Atmos-, surround sound- en stereogeluid naar de HomePod-luidsprekers van je thuisbioscoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV będzie automatycznie wysyłać dźwięk Atmos, przestrzenny i stereo do HomePodów skonfigurowanych jako głośniki kina domowego."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV enviará automaticamente o áudio Atmos, som surround e estéreo para os HomePods do seu home theater."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV enviará automaticamente áudio estéreo, Atmos e som envolvente para as colunas HomePod de sala de cinema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va trimite automat sunetul Atmos, surround și stereo pe difuzoarele home theater HomePod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV будет перенаправлять звук Atmos, объемный звук и стереозвук на колонки HomePod домашнего кинотеатра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude automaticky posielať zvuk vo formáte Atmos, priestorový a stereo zvuk do HomePodov domáceho kina."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo samodejno poslal zvok Atmos ter prostorski in stereo zvok v zvočnike HomePod vašega domačega kina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV skickar automatiskt Atmos-, surround- och stereoljud till din hemmabios HomePod-högtalare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะส่งเสียง Atmos, เสียงรอบทิศทาง และเสียงสเตอริโอไปยังลำโพงโฮมเธียเตอร์บน HomePod ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV; Atmos, Surround ve stereo sesleri otomatik olarak Ev Sinema Sistemi HomePod hoparlörlerinize gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV автоматично спрямовуватиме звук форматів Atmos, «Обʼємний звук» і «Стерео» на динаміки HomePod домашнього кінозалу."
