    "SaverShowDuringMusicDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بظهور شاشة التوقف أثناء الاستماع إلى الموسيقى أو البودكاست."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que s’iniciï l’estalvi de pantalla en escoltar música o pòdcasts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje zobrazit spořič obrazovky při poslechu hudby a podcastů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmskåneren må vises, når du lytter til musik eller podcasts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirmschoner kann angezeigt werden, wenn du Musik oder Podcasts anhörst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει την εμφάνιση προφύλαξης οθόνης όταν ακούτε μουσική ή podcast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the screen saver to appear when you’re listening to Music or Podcasts."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the screen saver to appear when you’re listening to Music or Podcasts."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the screen saver to appear when you’re listening to Music or Podcasts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite mostrar el salvapantallas cuando estés escuchando música o podcasts."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite mostrar el protector de pantalla al escuchar contenido en Música o Podcasts."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite mostrar el protector de pantalla al escuchar contenido en Música o Podcasts."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallii näytönsäästäjän käynnistymisen, kun käytät Musiikkia tai Podcasteja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’économiseur d’écran lorsque vous écoutez du contenu dans Musique ou Podcasts."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’affichage de l’économiseur d’écran lorsque vous écoutez du contenu dans les apps Musique et Balados."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה זו מאפשרת לשומר המסך להופיע בעת האזנה למוזיקה או פודקאסטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप संगीत या पॉडकास्ट सुन रहे होते हैं, तो स्क्रीन सेवर को दिखाई देने की अनुमति देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje pojavljivanje zaštite zaslona dok slušate glazbu ili podcaste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy megjelenjen a képernyővédő, amikor Ön a Zene vagy a Podcastok appot hallgatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan penghemat layar untuk muncul saat Anda mendengarkan Musik atau Podcast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di visualizzare il salvaschermo quando stai riproducendo contenuti di Musica o Podcast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックやポッドキャストの再生中にスクリーンセーバを表示できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 또는 팟캐스트를 들을 때 화면 보호기가 나타나도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan penyelamat skrin kelihatan apabila anda mendengar Muzik atau Podcast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillater at skjermspareren vises når du lytter til Musikk eller Podkaster."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de schermbeveiliging weergegeven als je naar Muziek of Podcasts luistert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala wyświetlać wygaszacz ekranu podczas słuchania w aplikacji Muzyka lub Podcasty."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o protetor de tela apareça quando você estiver usando os apps Música ou Podcasts."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que a proteção de ecrã seja ativada ao ouvir música ou podcasts."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite afișarea screensaverului în timp ce ascultați muzică sau podcasturi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставка сможет запускаться, когда Вы слушаете Музыку и Подкасты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje zobraziť šetrič obrazovky pri počúvaní hudby alebo podcastov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogočite prikazovanje ohranjevalnika zaslona med poslušanjem vsebin iz aplikacije Glasba ali Podkasti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter skärmsläckaren visas när du lyssnar på Musik eller Podcaster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ภาพพักหน้าจอแสดงเมื่อคุณฟังเพลงหรือพ็อดคาสท์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik veya podcast dinlerken ekran koruyucunun görünmesine izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранна заставка може зʼявлятися під час прослуховування музики чи подкастів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép trình bảo vệ màn hình xuất hiện khi bạn đang nghe nhạc hoặc podcast."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "聆听音乐或播客时，允许屏幕保护程序显示。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽「音樂」或Podcast時，允許顯示螢幕保護程式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽「音樂」或Podcast時允許顯示螢幕保護程式。"
          }
        }
      }
