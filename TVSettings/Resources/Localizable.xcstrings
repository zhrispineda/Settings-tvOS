    "HomeKitServiceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات التي طلبت الوصول إلى بيانات تطبيق المنزل من Apple ستظهر هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que hagin sol·licitat accedir a les dades de l’Apple Home es mostraran aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí aplikace, které si vyžádaly přístup k datům domácnosti Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der har bedt om adgang til Apple Hjem-data, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden Apps angezeigt, die auf die Daten von Apple Home zugreifen möchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ θα εμφανίζονται οι εφαρμογές που έχουν ζητήσει πρόσβαση στα δεδομένα της Οικίας Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Home data will appear here."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Home data will appear here."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that have requested access to Apple Home data will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que han solicitado acceso a los datos de Apple Home aparecerán aquí."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que solicitaron acceso a los datos de Casa aparecerán aquí."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que solicitaron acceso a los datos de Casa aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit, jotka ovat pyytäneet lupaa käyttää Applen Kodin tietoja, näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ayant demandé l’accès aux données Apple Home apparaîtront ici."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ayant demandé l’accès aux données Apple Home s’affichent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שביקשו גישה לנתוני Apple Home יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन ऐप्स ने Apple Home डेटा ऐक्सेस करने के लिए अनुरोध किया है, वे यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se prikazati aplikacije koje su zatražile pristup podacima Apple Doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg az Apple Otthon-adatokhoz hozzáférést kérelmező appok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta akses ke data Rumah Apple akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che hanno richiesto l’accesso ai dati di Apple Home verranno visualizzate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Homeのデータへのアクセスを要求したアプリがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 홈 데이터에 접근을 요청한 앱이 여기에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang telah meminta akses kepada data Apple Home akan kelihatan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper som har bedt om tilgang til data fra Hjem, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staan de apps die om toegang tot gegevens uit Apple Woning hebben gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu pojawiają się aplikacje, które proszą o dostęp do Apple Home."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que tiverem solicitado acesso aos dados do Apple Home aparecerão aqui."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que pediram acesso aos dados de Apple Home aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care au solicitat acces la datele Locuință Apple vor fi afișate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся приложения, запросившие доступ к данным Дома Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia apky, ktoré žiadali o prístup k dátam Apple Domácnosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki so zahtevale dostop do podatkov Doma Apple, bodo prikazane tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som har begärt åtkomst till Hem-data visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ได้ขอการเข้าถึงข้อมูล Apple Home จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Ev verilerine erişmek isteyen uygulamalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут зʼявлятимуться програми, які зробили запит на доступ до даних програми «Дім» від Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã yêu cầu truy cập dữ liệu Nhà Apple sẽ xuất hiện tại đây."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要求访问Apple家庭数据的App将在此处显示。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此處會顯示曾要求使用「Apple家居」資料的App。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "之前要求取用「Apple家庭」資料的App會顯示在此處。"
          }
        }
      }
    },
