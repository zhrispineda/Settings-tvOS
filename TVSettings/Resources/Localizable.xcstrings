    "BluetoothUnpairMagicPairedDeviceMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة %@ أيضًا من أي أجهزة تم تسجيل الدخول عليها إلى حساب iCloud الخاص بك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També s’eliminarà el dispositiu “%@” de qualsevol altre dispositiu en què hagis iniciat la sessió amb el compte de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení %@ bude odebráno také ze všech ostatních zařízení přihlášených k vašemu účtu na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernes også fra enheder, der er logget ind med din iCloud-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird auch von allen Geräten entfernt, die bei deinem iCloud-Account angemeldet sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: θα αφαιρεθεί επίσης από συσκευές που είναι συνδεδεμένες στον λογαριασμό iCloud σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will also be removed from any devices that are signed in to your iCloud account."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will also be removed from any devices that are signed in to your iCloud account."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will also be removed from any devices that are signed in to your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” también se eliminará de los dispositivos en los que hayas iniciado sesión con tu cuenta de iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo “%@” también se eliminará de los otros dispositivos en los que hayas iniciado sesión con tu cuenta de iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo “%@” también se eliminará de los otros dispositivos en los que hayas iniciado sesión con tu cuenta de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poistetaan myös kaikista laitteista, jotka ovat kirjautuneina iCloud-tilillesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil « %@ » sera également supprimé de tous les appareils connectés à votre compte iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le périphérique « %@ » sera également supprimé de tout appareil connecté à votre compte iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏״%@״ יוסר גם מכל המכשירים שמחוברים לחשבון ה-iCloud שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iCloud खाते में साइन इन किए हुए डिवाइस से %@ को भी हटा दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ će se također ukloniti sa svih uređaja koji su prijavljeni na vaš iCloud račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ továbbá el lesz távolítva minden olyan eszközről, amelyre Ön be van jelentkezve az iCloud-fiókjával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juga akan dihapus dari semua perangkat yang masuk ke akun iCloud Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuoverai %@ anche dagli altri dispositivi connessi all’account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は、iCloudアカウントにサインインしているすべてのデバイスからも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 iCloud 계정으로 로그인한 모든 기기에서도 %@이(가) 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juga akan dikeluarkan daripada sebarang peranti yang didaftar masuk ke akaun iCloud anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fjernes også fra alle andre enheter som er logget på med iCloud-kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt ook verwijderd van alle apparaten die zijn ingelogd bij je iCloud-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %@ zostanie również usunięte z innych urządzeń zalogowanych na Twoim koncie iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo %@ também será removido de qualquer dispositivo onde você tenha iniciado uma sessão com a conta do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo %@ também será removido de outros dispositivos com sessão iniciada na sua conta iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul „%@” va fi eliminat și de pe orice dispozitive care sunt autentificate în contul dvs. de iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные (%@) также будут удалены со всех устройств, на которых выполнен вход в Вашу учетную запись iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenie %@ bude odstránené aj zo všetkých ostatných zariadení prihlásených do vášho iCloud účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« se prav tako odstrani iz vseh naprav, vpisanih v vaš račun iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tas också bort från alla enheter som är inloggade på ditt iCloud-konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%[tt]@จะถูกเอาออกจากอุปกรณ์ทุกเครื่องที่ลงชื่อเข้าบัญชี iCloud ของคุณด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, iCloud hesabınıza giriş yapmış diğer aygıtlardan da silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде вилучено й на інших пристроях, на яких здійснено вхід у ваш обліковий запис iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cũng sẽ bị gỡ bỏ khỏi bất kỳ thiết bị nào được đăng nhập vào tài khoản iCloud của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@也将从已登录你iCloud账户的所有设备上移除。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "也將會從已登入iCloud帳户的裝置移除%@。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@將會從任何已登入你iCloud帳號的裝置上移除。"
          }
        }
      }
    },
