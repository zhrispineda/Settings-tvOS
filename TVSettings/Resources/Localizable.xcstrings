    "iCloudPhotoMemoryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بظهور الذكريات في تطبيق الصور وتوفرها كشاشة توقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que es mostrin records a l’app Fotos i que es puguin utilitzar com a estalvi de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolí zobrazování vzpomínek v aplikaci Fotky a spořiči obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad, at minder vises i appen Fotos og kan bruges som skærmskåner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube, dass Rückblicke in der Fotos-App angezeigt werden und als Bildschirmschoner verfügbar sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να επιτρέπεται στις αναμνήσεις να εμφανίζονται αυτόματα στην εφαρμογή «Φωτογραφίες» και να είναι διαθέσιμες ως προφύλαξη οθόνης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Memories to appear in the Photos app and be available as a screen saver."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Memories to appear in the Photos app and be available as a screen saver."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Memories to appear in the Photos app and be available as a screen saver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los recuerdos aparezcan en la app Fotos y se puedan usar como salvapantallas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Recuerdos se muestre en la app Fotos y esté disponible como protector de pantalla."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Recuerdos se muestre en la app Fotos y esté disponible como protector de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli muistojen näkyä Kuvat-apissa ja olla käytettävissä näytönsäästäjänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’affichage des souvenirs dans l’app Photos et leur utilisation comme économiseurs d’écran."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’affichage des souvenirs dans l’app Photos et leur utilisation comme économiseurs d’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאפשר הצגה של זיכרונות ביישום ״תמונות״ ולהשתמש באחד מהם כשומר מסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यादें को तस्वीर ऐप में दिखाई देने और स्क्रीन सेवर के रूप में उपलब्ध रहने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite prikazivanje Uspomena u aplikaciji Foto i njihovu uporabu za zaštitu zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy az emlékek megjelenjenek a Fotók appban, és rendelkezésre álljanak képernyővédőként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Memori untuk muncul di app Foto dan tersedia sebagai penghemat layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la visualizzazione dei ricordi nell’app Foto e il loro utilizzo come salvaschermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“メモリー”が写真アプリに表示され、スクリーンセーバーとして使用可能になるのを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 ‘추억’을 표시하고 화면 보호기로 사용할 수 있도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Memori kelihatan dalam app Foto dan tersedia sebagai penyelamat skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at Minner kan vises i Bilder-appen og være tilgjengelig som skjermsparer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat terugblikken worden weergegeven in de Foto's-app en beschikbaar zijn als schermbeveiliging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól na wyświetlanie wspomnień w aplikacji Zdjęcia i używanie ich jako wygaszacza ekranu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que as Memórias apareçam no app Fotos e fiquem disponíveis como protetor de tela."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que as recordações apareçam na aplicação Fotografias e que estejam disponíveis como proteção de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți ca amintirile să apară în aplicația Poze și să fie disponibile ca screensaver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспоминания будут появляться в приложении «Фото», и их можно будет использовать в качестве заставки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spomienky sa budú zobrazovať v apke Fotky a budú k dispozícii pre šetrič obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite, da se spomini prikažejo v aplikaciji Fotografije in da jih lahko nastavite kot ohranjevalnik zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att minnen visas i appen Bilder och är tillgängliga som skärmsläckare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ความทรงจำแสดงในแอปรูปภาพและใช้งานเป็นภาพพักหน้าจอได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anılar’ın, Fotoğraflar uygulamasında görünmesine ve ekran koruyucu olarak kullanılmasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити показ спогадів у програмі «Фотографії» та використання їх як екранної заставки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép các kỷ niệm xuất hiện trong ứng dụng Ảnh và khả dụng dưới dạng trình bảo vệ màn hình."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“回忆”显示在“照片”App中并可用作屏幕保护程序。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許在「相片」App中顯示「回憶」，並可將「回憶」用於螢幕保護程式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「回憶」顯示於「照片」App並可用於螢幕保護程式。"
          }
        }
      }
    },
