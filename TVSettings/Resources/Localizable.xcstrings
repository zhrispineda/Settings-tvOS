    "AXVoiceOverAudioDuckingOnlySpeakingFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "سيتم خفض مستوى صوت الوسائط والمكالمات أثناء نطق التعليق الصوتي.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Només s’abaixarà el volum de les trucades i del contingut multimèdia quan el VoiceOver llegeixi alguna cosa.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Hlasitost médií a hovorů se sníží, když bude VoiceOver mluvit.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Lydstyrken på medier og opkald bliver skruet ned, når VoiceOver læser op.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Die Lautstärke von Medien und Anrufen wird reduziert, wenn VoiceOver spricht.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Η ένταση ήχου πολυμέσων και κλήσεων θα μειώνεται όταν το VoiceOver πραγματοποιεί εκφώνηση.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "The volume of media and calls will be reduced when VoiceOver is speaking.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "The volume of media and calls will be reduced when VoiceOver is speaking.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "The volume of media and calls will be reduced when VoiceOver is speaking.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "The volume of media and calls will be reduced when VoiceOver is speaking.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "The volume of media and calls will be reduced when VoiceOver is speaking.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El volumen del contenido multimedia y las llamadas se reducirá cuando VoiceOver esté hablando.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El volumen del contenido y las llamadas se reducirá cuando VoiceOver lea en voz alta.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "El volumen del contenido y las llamadas se reducirá cuando VoiceOver lea en voz alta.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Median ja puhelujen äänenvoimakkuutta lasketaan, kun VoiceOver puhuu.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Le volume des contenus multimédias et des appels sera baissé pendant l’énonciation de VoiceOver.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Le volume du contenu multimédia et des appels sera réduit pendant l’énonciation de VoiceOver.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "עוצמת השמע של מדיה ושיחות תופחת בעת הקראה של VoiceOver.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver के बोलने के दौरान मीडिया और कॉल का वॉल्यूम कम किया जाएगा।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Glasnoća medija i poziva stišat će se kad VoiceOver čita.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A média és a hívások hangereje csökkentve lesz, amikor a VoiceOver beszél.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Volume media dan panggilan akan dikurangi saat VoiceOver berbicara.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Il volume dei contenuti multimediali e delle chiamate verrà ridotto durante la lettura di VoiceOver.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverが読み上げるときにメディアと通話の音量は下がります。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "VoiceOver가 말하는 동안 미디어 및 통화 음량을 줄입니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Kelantangan media dan panggilan akan dikurangkan apabila VoiceOver sedang bercakap.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Het volume van media en oproepen wordt verlaagd wanneer VoiceOver spreekt.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Volumet i medieavspilling og samtaler vil bli redusert mens VoiceOver snakker.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Głośność multimediów i połączeń będzie obniżana, gdy funkcja VoiceOver odczytuje rzeczy.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "O volume de chamadas e mídias será reduzido quando o VoiceOver estiver falando.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "O volume do conteúdo multimédia e das chamadas é reduzido quando o VoiceOver está a falar.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Volumul conținutului multimedia și al apelurilor va fi redus în timpul enunțării VoiceOver.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Громкость медиаконтента и вызовов будет уменьшаться, когда VoiceOver говорит.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Keď VoiceOver rozpráva, hlasitosť médií a hovorov sa zníži.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Med predvajanjem govora s funkcijo VoiceOver bo glasnost predstavnostne vsebine in klicev zmanjšana.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Volymen för medier och samtal sänks när VoiceOver läser upp.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ระดับเสียงของสื่อและสายโทรจะลดลงเมื่อ VoiceOver อ่านออกเสียงอยู่",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver konuşurken ortamların ve aramaların ses yüksekliği azaltılır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Гучність викликів і медіавмісту знижуватиметься під час мовлення VoiceOver.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Âm lượng của phương tiện và cuộc gọi sẽ được giảm xuống khi VoiceOver đang nói.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "“旁白”朗读时，降低媒体和通话音量。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "「旁白」朗讀期間，媒體和通話的音量將會降低。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "媒體和通話音量會在「旁白」朗讀時降低。",
            "state": "translated"
          }
        }
      }
    },
