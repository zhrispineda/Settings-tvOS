    "WHAProblemAlertDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغل تطبيق المنزل على جهاز iOS لمعالجة المشكلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre l’app Casa del dispositiu iOS per intentar solucionar el problema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte na svém iOS zařízení aplikaci Domácnost a zkuste problém opravit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn appen Hjem på din iOS-enhed for at forsøge at løse problemet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte die App „Home“ auf deinem iOS-Gerät und versuche, das Problem zu beheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκινήστε την εφαρμογή «Οικία» στη συσκευή iOS σας για επιδιόρθωση του προβλήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch the Home app on your iOS device to try to fix the problem."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch the Home app on your iOS device to try to fix the problem."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch the Home app on your iOS device to try to fix the problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app Casa de tu dispositivo iOS para intentar solucionar el problema."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Casa en tu dispositivo iOS para intentar solucionar el problema."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Casa en tu dispositivo iOS para intentar solucionar el problema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä Koti-appi iOS-laitteessa ja yritä korjata ongelma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Maison sur votre appareil iOS pour tenter de corriger le problème."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez l’app Domicile sur votre appareil iOS pour essayer de résoudre le problème."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את היישום ״הבית שלי״ במכשיר ה-iOS כדי לנסות לתקן את הבעיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समस्या को सुधारने की कोशिश करने के लिए घर ऐप अपने iOS डिवाइस पर लॉन्च करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite aplikaciju Dom na iOS uređaju kako biste pokušali ispraviti problem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítsa el az Otthon appot az iOS-eszközén a probléma kijavításának megkísérléséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Luncurkan app Rumah di perangkat iOS Anda untuk mencoba memperbaiki masalah tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per risolvere il problema, apri l’app Casa sul tuo dispositivo iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題の解決を試みるには、iOSデバイスのホームアプリを起動してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 해결해보려면 iOS 기기에서 홈 앱을 실행하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancarkan app Rumah pada peranti iOS anda untuk cuba membetulkan masalah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Hjem-appen på iOS-enheten for å prøve å løse problemet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de Woning-app op je iOS-apparaat om te proberen het probleem op te lossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby spróbować usunąć problem, uruchom aplikację Dom na urządzeniu iOS."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app Casa no seu dispositivo iOS para tentar solucionar o problema."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a aplicação Casa no seu dispositivo iOS para tentar resolver o problema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lansați aplicația Locuință pe dispozitivul dvs. iOS pentru a încerca să rezolvați problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите приложение «Дом» на устройстве iOS, чтобы попытаться устранить проблему."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Problém sa môžete pokúsiť opraviť spustením apky Domácnosť na iOS zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaženite aplikacijo Dom v napravi iOS, da poskusite odpraviti težavo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta appen Hem på din iOS-enhet om du vill försöka lösa problemet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้แอปบ้านบนอุปกรณ์ iOS ของคุณเพื่อลองพยายามแก้ไขปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu çözmeyi denemek için iOS aygıtınızda Ev uygulamasını açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть програму «Дім» на своєму пристрої iOS, щоб спробувати усунути проблему."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy ứng dụng Nhà trên thiết bị iOS của bạn để tìm cách khắc phục sự cố."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在你的iOS设备上开启“家庭”App来修复该问题。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動你的iOS裝置上的「家居」App以嘗試修正問題。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的iOS裝置上啟動「家庭」App來嘗試修復問題。"
          }
        }
      }
    },
