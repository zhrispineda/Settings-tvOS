    "HomeKitSpecificMotionRecordingOffAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتلقي الإشعارات، شغّل تسجيل \"حركة محددة\" لهذه الكاميرا في تطبيق المنزل على iPhone أو iPad أو Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rebre notificacions, activa les gravacions de moviments concrets en aquesta càmera des de l’app Casa del teu iPhone, iPad o Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud chcete dostávat oznámení, zapněte pro tuto kameru nahrávání specifického pohybu v aplikaci Domácnost na iPhonu, iPadu nebo Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil modtage notifikationer, skal du slå optagelse af specifikke bevægelser til for dette kamera i appen Hjem på din iPhone, iPad eller Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mitteilungen zu erhalten, aktiviere für diese Kamera die Aufnahme bestimmter Bewegungen in der Home-App auf deinem iPhone, iPad oder Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για λήψη γνωστοποιήσεων, ενεργοποιήστε τη «Συγκεκριμένη κίνηση» για αυτήν την κάμερα στην εφαρμογή «Οικία» στο iPhone, iPad ή Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on Specific Motion recording for this camera in the Home app on your iPhone, iPad, or Mac."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on Specific Motion recording for this camera in the Home app on your iPhone, iPad or Mac."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on Specific Motion recording for this camera in the Home app on your iPhone, iPad or Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación de esta cámara para cierto tipo de movimiento en la app Casa de tu iPhone, iPad o Mac."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación de movimientos específicos para esta cámara desde la app Casa en tu iPhone, iPad o Mac."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación de movimientos específicos para esta cámara desde la app Casa en tu iPhone, iPad o Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat ilmoituksia tietyistä liikkeistä, laita tallennus päälle tälle kameralle iPhonen, iPadin tai Macin Koti-apissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez l’enregistrement de mouvements spécifiques pour cette caméra dans l’app Maison de votre iPhone, iPad ou Mac."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez l’enregistrement pour « Mouvement spécifique » sur cette caméra dans l’app Domicile de votre iPhone, de votre iPad ou de votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקבל עדכונים, יש להפעיל צילום של ״תנועה ספציפית״ במצלמה זו ביישום ״הבית שלי״ ב-iPhone, ב-iPad או ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ पाने के लिए अपने iPhone, iPad या Mac पर घर ऐप में इस कैमरा के लिए विशेष मोशन चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za primanje obavijesti uključite snimanje određenog kretanja za ovu kameru u aplikaciji Dom na iPhoneu, iPadu ili Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha értesítéseket szeretne kapni, kapcsolja be a Meghatározott mozgás rögzítését ehhez a kamerához az iPhone-ján, iPadjén vagy Macjén lévő Otthon appban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima pemberitahuan, nyalakan perekaman Gerakan Tertentu untuk kamera ini di app Rumah di iPhone, iPad, atau Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere le notifiche, attiva la registrazione “Movimenti specifici” per questa videocamera nell’app Casa su iPhone, su iPad o sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受信するには、iPhone、iPad、またはMacのホームアプリで“特定の動き”のカメラの収録をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 iPhone, iPad 또는 Mac의 홈 앱에서 이 카메라의 특정 움직임 녹화 기능을 켜십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima pemberitahuan, aktifkan rakaman Pergerakan Khusus bagi kamera ini dalam app Rumah pada iPhone, iPad atau Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varslinger må du slå på opptak av en bestemt type bevegelse for dette kameraet i Hjem-appen på iPhone, iPad eller Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om meldingen te ontvangen, schakel je opnamen voor 'Specifieke beweging' in voor deze camera in de Woning-app op je iPhone, iPad of Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otrzymywać powiadomienia, włącz dla tej kamery opcję Określony ruch w aplikacji Dom na iPhonie, iPadzie lub Macu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative Movimento Específico para esta câmera no app Casa no iPhone, iPad ou Mac."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative a gravação de movimentos específicos com esta câmara na aplicação Casa no seu iPhone, iPad ou Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a primi notificări, activați înregistrarea mișcărilor specifice pentru această cameră în aplicația Locuință de pe iPhone, iPad sau Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для получения уведомлений включите параметр «Определенный вид движения» для этой камеры в приложении «Дом» на iPhone, iPad или Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete dostávať hlásenia, zapnite nahrávanie špecifického pohybu pre túto kameru v apke Domácnosť na iPhone, iPade alebo Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite prejemati obvestila, vklopite snemanje določenega gibanja za to kamero v aplikaciji Dom v iPhonu, iPadu ali Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill få notiser aktiverar du inspelning av specifik rörelse för den här kameran i appen Hem på iPhone, iPad eller Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการรับการแจ้งเตือน ให้เปิดใช้การบันทึกการเคลื่อนไหวเฉพาะสำหรับกล้องนี้ในแอปบ้านบน iPhone, iPad หรือ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim almak için iPhone’unuzdaki, iPad’inizdeki veya Mac’inizdeki Ev uygulamasında bu kamera için Belirli Bir Hareket kaydını açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримувати сповіщення, увімкніть записування певного руху для цієї камери в програмі «Дім» на iPhone, iPad або Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận thông báo, hãy bật tính năng ghi Chuyển động cụ thể cho camera này trong ứng dụng Nhà trên iPhone, iPad hoặc máy Mac của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接收通知，请在iPhone、iPad或Mac上的“家庭”App中打开此摄像头的特定动作录制功能。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要收到通知，請在iPhone、iPad或Mac上的「家居」App中為此攝影機開啟「特定動作」錄影。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接收通知，請在iPhone、iPad或Mac上的「家庭」App中開啟此攝影機的「特定動作」錄影功能。"
          }
        }
      }
    },
    "HomeKitSpecificMotionRecordingOffAlertTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعيين هذه الكاميرا لتسجيل حركة محددة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta càmera no està configurada per gravar moviments concrets"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kamera není nastavená na nahrávání specifického pohybu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet er ikke indstillet til at optage specifikke bevægelser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kamera ist nicht für das Aufnehmen bestimmter Bewegungen konfiguriert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η κάμερα δεν έχει οριστεί για εγγραφή συγκεκριμένης κίνησης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Camera is Not Set to Record Specific Motion"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Camera is Not Set to Record Specific Motion"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Camera is Not Set to Record Specific Motion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no está configurada para grabar cierto tipo de movimiento"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no se configuró para grabar movimientos específicos"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no se configuró para grabar movimientos específicos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kameraa ei ole asetettu tallentamaan tiettyjä liikkeitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette caméra n’est pas réglée pour enregistrer des mouvements spécifiques."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette caméra n’est pas configurée pour enregistrer des mouvements spécifiques"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה זו לא הוגדרה לצילום תנועה ספציפית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैमरा विशेष मोशन को रिकॉर्ड करने के लिए सेट नहीं किया गया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kamera nije podešena za snimanje određenog kretanja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kamera nincs beállítva meghatározott mozgás rögzítésére"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera Ini Tidak Diatur untuk Merekam Gerakan Tertentu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La videocamera non è impostata per la registrazione di movimenti specifici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラは特定の動きを収録するように設定されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카메라가 특정 움직임을 녹화하도록 설정되지 않음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera Ini Tidak Disetkan untuk Merakam Pergerakan Khusus"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet er ikke satt til å ta opp en bestemt type bevegelse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze camera is niet ingesteld om specifieke beweging op te nemen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kamera nie ma nagrywać określonego ruchu"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Câmera Não Está Configurada para Gravar Movimento Específico"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta câmara não está configurada para gravar movimentos específicos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această cameră nu este configurată pentru a înregistra mișcări specifice"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта камера не настроена на запись определенного вида движения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto kamera nie je nastavená na nahrávanie špecifického pohybu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kamera ni nastavljena, da bi snemala določeno gibanje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här kameran är inte inställd på inspelning av specifik rörelse"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ตั้งค่ากล้องนี้ให้บันทึกการเคลื่อนไหวเฉพาะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kamera Belirli Bir Hareketin Kaydedilmesi İçin Ayarlanmamış"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю камеру не налаштовано на запис певного руху"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera này không được cài đặt để ghi hình chuyển động cụ thể"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此摄像头未设置为可录制特定动作"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此攝影機未設定為可錄影特定動作"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此攝影機未設定為錄製特定動作"
          }
        }
      }
    },
    "HomeKitUnlockSecureAccessoriesAllRemotesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم في الملحقات الأمنية باستخدام أي ريموت أو جهاز مقترن يدعم Bluetooth، إضافة إلى أذرع التحكم في الألعاب وريموتات IR. ينبغي التأكد من وجود Apple TV في موقع لا يمكن التحكم فيه من خارج منزلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla els accessoris de seguretat amb qualsevol dispositiu o comandament Bluetooth enllaçat, i també d’infrarojos i de joc. Assegura’t que l’Apple TV, a la ubicació on sigui, no es pugui controlar des de fora de casa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní příslušenství bude možné ovládat všemi spárovanými Bluetooth ovladači nebo zařízeními a také herními a infračervenými ovladači. Ujistěte se, že máte Apple TV umístěnou tak, aby ji nebylo možné ovládat zvenku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betjen sikkerhedstilbehør med en parret Bluetooth-fjernbetjening eller -enhed samt controllere og IR-fjernbetjeninger. Sørg for, at Apple TV er placeret, så det ikke kan betjenes af andre personer uden for dit hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere Sicherheitszubehör mit beliebigen gekoppelten Bluetooth-Fernbedienungen oder -Geräten sowie Spielecontrollern und IR-Fernbedienungen. Stelle sicher, dass sich dein Apple TV an einem Ort befindet, an dem es nicht von außerhalb deines Zuhauses gesteuert werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειριστείτε αξεσουάρ ασφαλείας με οποιοδήποτε ζευγοποιημένο τηλεχειριστήριο ή συσκευή Bluetooth, ή με χειριστήρια παιχνιδιών και τηλεχειριστήρια υπέρυθρων. Φροντίστε το Apple TV σας να βρίσκεται σε θέση όπου δεν θα είναι δυνατός ο χειρισμός του εκτός της οικίας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with any paired Bluetooth remote or device, plus game controllers and IR remotes. Ensure your Apple TV is in a location that can’t be controlled from outside your home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with any paired Bluetooth remote or device, plus gaming controllers and IR remotes. Ensure your Apple TV is in a location that can’t be controlled from outside your home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Control security accessories with any paired Bluetooth remote or device, plus game controllers and IR remotes. Ensure your Apple TV is in a location that can’t be controlled from outside your home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los accesorios de seguridad con cualquier dispositivo o mando a distancia Bluetooth enlazado, así como con mandos de videojuegos o controles remotos por infrarrojos. Según donde esté el Apple TV, asegúrate de que no pueda controlarse desde fuera de la casa."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla tus accesorios de seguridad mediante cualquier control o dispositivo Bluetooth enlazado, además de con controles de videojuegos y controles remotos universales. Asegúrate de que tu Apple TV esté en una ubicación adecuada para que nadie lo pueda controlar desde fuera de tu casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla tus accesorios de seguridad mediante cualquier control o dispositivo Bluetooth enlazado, además de con controles de videojuegos y controles remotos universales. Asegúrate de que tu Apple TV esté en una ubicación adecuada para que nadie lo pueda controlar desde fuera de tu casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa turvalisälaitteita millä tahansa pariksi liitetyllä Bluetooth-kaukosäätimellä tai laitteella, sekä peliohjaimilla ja IR-kaukosäätimillä. Varmista, että Apple TV on paikassa, jossa sitä ei voida ohjata kodin ulkopuolelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez les accessoires de sécurité avec les appareils ou télécommandes Bluetooth jumelés, ainsi qu’avec les manettes de jeu et les télécommandes infrarouges. Veillez à placer votre Apple TV de sorte qu’elle ne puisse pas être contrôlée depuis l’extérieur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez les accessoires de sécurité avec n’importe quelle télécommande Bluetooth jumelée ou avec votre appareil, ainsi qu’avec des manettes de jeu et des télécommandes infrarouges. Vérifiez que votre Apple TV se trouve dans un endroit où elle ne peut pas être contrôlée à partir de l’extérieur de votre domicile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשלוט באביזרי אבטחה באמצעות כל מכשיר או שלט Bluetooth מקושר, וכן באמצעות שלטי משחק או שלטי IR. יש לוודא שה-Apple TV נמצא במיקום שלא מאפשר שליטה בו מחוץ לבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा ऐक्सेसरी को पेयर किए गए किसी भी Bluetooth रिमोट या डिवाइस के साथ ही गेम कंट्रोलर और IR रिमोट से नियंत्रित करें। सुनिश्चित करें कि आपका Apple TV ऐसे स्थान पर हो जहाँ उसे आपके घर के बाहर से नियंत्रित न किया जा सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljajte sigurnosnim priborima bilo kojim uparenim Bluetooth upravljačem ili uređajem, igraćim kontrolerima i IC upravljačima. Osigurajte da Apple TV bude na mjestu koje onemogućava da se njime upravlja izvan doma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonsági kiegészítőket vezérelhet bármilyen párosított Bluetooth-távirányítóval vagy -eszközzel, ezenkívül játékvezérlőkkel és infravörös távirányítókkal is. Ügyeljen arra, hogy az Apple TV‑je olyan helyen legyen elhelyezve, ahol az otthonán kívülről nem vezérelhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol aksesori keamanan dengan remote atau perangkat Bluetooth mana pun yang dipasangkan, serta pengontrol game dan remote IR. Pastikan Apple TV Anda berada di lokasi yang tidak dapat dikontrol dari luar rumah Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli accessori di sicurezza con qualsiasi dispositivo o telecomando Bluetooth abbinato, nonché con i controller di gioco e i telecomandi IR. Assicurati che Apple TV si trovi in una posizione in cui non può essere controllata dall’esterno dell’abitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングされたBluetoothリモコンやデバイス、ゲームコントローラ、赤外線リモコンを使用してセキュリティアクセサリをコントロールできます。家の外からコントロールされないような場所にApple TVを設置してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Bluetooth 리모컨 또는 기기, 게임 컨트롤러 및 IR 리모컨으로 보안 액세서리를 제어할 수 있습니다. Apple TV가 집 밖에서 제어할 수 없는 위치에 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawal aksesori keselamatan dengan sebarang kawalan jauh atau peranti Bluetooth berpasangan, termasuk pengawal permainan dan kawalan jauh IR. Pastikan Apple TV anda berada di lokasi yang tidak boleh dikawal dari luar rumah anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr sikkerhetstilbehør med en sammenkoblet Bluetooth-fjernkontroll eller enhet, eller med spillkontroller og IR-fjernkontroller. Pass på at Apple TV er plassert på et sted der den ikke kan styres fra utsiden av boligen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedien beveiligingsaccessoires met via Bluetooth gekoppelde afstands­bedieningen of apparaten, en met game­controllers en infrarood­afstands­bedieningen. Zorg ervoor dat je Apple TV zich op een locatie bevindt die niet van buiten je woning kan worden bediend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcesoriami systemu zabezpieczeń możesz sterować przy użyciu dowolnego pilota lub urządzenia połączonego w parę przez Bluetooth, kontrolera do gier lub pilota na podczerwień. Upewnij się, że Apple TV znajduje się w miejscu, w którym nie może być sterowane spoza domu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle acessórios de segurança com qualquer controle remoto ou dispositivo Bluetooth emparelhado, além de controles de videogame e infravermelhos. Mantenha a Apple TV em um local em que ela não possa ser controlada de fora de casa."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlar os acessórios de segurança com qualquer comando Bluetooth emparelhado ou dispositivo, assim como comandos de jogos e comandos infravermelhos. A Apple TV deve estar num local onde não possa ser controlada a partir do exterior da casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlați accesoriile de securitate cu orice telecomandă sau dispozitiv Bluetooth asociat, plus controllere pentru jocuri și telecomenzi IR. Asigurați‑vă că Apple TV‑ul se află într‑un loc care nu poate fi controlat din afara locuinței."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте системами защиты дома с любого объединенного в пару пульта ДУ или другого устройства с поддержкой Bluetooth, а также с игровых контроллеров и ИК‑пультов. Убедитесь, что Apple TV находится в таком месте, где им невозможно управлять не из дома."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostné príslušenstvo bude možné ovládať pomocou ľubovoľných spárovaných Bluetooth ovládačov alebo zariadení, herných ovládačov a IR ovládačov. Apple TV by ste mali umiestniť tak, aby ho nebolo možné ovládať zvonka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostno dodatno opremo lahko upravljate s katerimkoli seznanjenim daljincem ali napravo Bluetooth, pa tudi z igralnimi kontrolerji in IR-daljinci. Prepričajte se, da je Apple TV na takšni lokaciji, da ga ni mogoče upravljati izven doma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr säkerhetstillbehör med en valfri parkopplad Bluetooth-fjärrkontroll eller Bluetooth-enhet, samt spelkontroller och IR-fjärrkontroller. Se till att Apple TV finns på en plats där den inte kan styras från någon som är utanför hemmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมอุปกรณ์เสริมความปลอดภัยด้วยรีโมทบลูทูธหรืออุปกรณ์ที่จับคู่ด้วย รวมทั้งอุปกรณ์ควบคุมเกมและรีโมท IR ตรวจสอบให้แน่ใจว่า Apple TV ของคุณอยู่ในตำแหน่งที่ตั้งที่ไม่สามารถถูกควบคุมจากนอกบ้านของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik aksesuarlarını, eşlenmiş Bluetooth kumandalarının veya aygıtlarının yanı sıra oyun kumandaları ve kızılötesi kumandalarla da denetleyin. Apple TV’nizin evinizin dışından denetlenemeyecek bir konumda olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте приладами безпеки зі спарених Bluetooth-пультів чи пристроїв, а також ігрових контролерів та ІЧ‑пультів. Apple TV має бути розташовано так, щоб ним не можна було керувати з‑поза меж вашого дому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển các phụ kiện an ninh bằng bất kỳ điều khiển từ xa Bluetooth hoặc thiết bị nào được ghép đôi, cũng như bộ điều khiển trò chơi và điều khiển từ xa IR. Đảm bảo rằng Apple TV ở vị trí không thể điều khiển được từ bên ngoài nhà của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用任何配对的蓝牙遥控器或设备，以及游戏控制器和红外线遥控器来控制安全配件。请确保Apple TV摆放在无法从家外被控制的位置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通過任何已配對的藍牙遙控器或裝置，以及遊戲控制器和紅外線遙控器控制保安配件。請確定Apple TV放在無法從家居以外地方控制的位置。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過任何配對的藍牙遙控器或裝置，還有遊戲控制器和紅外線遙控器來控制安全性配件。請確定Apple TV放在無法從你住家以外之處控制的位置。"
          }
        }
      }
    },
