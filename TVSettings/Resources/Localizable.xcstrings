    "AVEnableHDRDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على أفضل صورة مع ألوان أفضل وأكثر سطوعًا. سيتأكد Apple TV من توافق تلفزيونك قبل تشغيل HDR."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona imatges de qualitat òptima amb colors més vius i lluminosos. Abans d’activar el format HDR, l’Apple TV comprovarà que el televisor sigui compatible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získáte prvotřídní obraz s lepšími a jasnějšími barvami. Před zapnutím režimu HDR Apple TV zkontroluje, zda je s ním váš televizor kompatibilní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få det bedste billede med bedre og stærkere farver. Apple TV kontrollerer, at dit fjernsyn er kompatibelt, før det slår HDR til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlebe die beste Bildqualität mit besseren, helleren Farben. Apple TV stellt vor dem Aktivieren von HDR sicher, dass dein Fernsehgerät kompatibel ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απολαύστε τη βέλτιστη εικόνα με καλύτερα, φωτεινότερα χρώματα. Το Apple TV θα διασφαλίσει ότι η τηλεόρασή σας είναι συμβατή, προτού ενεργοποιήσει το HDR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colors. Apple TV will make sure your TV is compatible before it turns on HDR."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colours. Apple TV will make sure your TV is compatible before it turns on HDR."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the best picture with better, brighter colours. Apple TV will make sure your TV is compatible before it turns on HDR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de la mejor calidad de imagen con colores más vivos y realistas. Antes de activar HDR, el Apple TV se asegurará de que el televisor es compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue la mejor calidad de imagen con colores más brillantes. El Apple TV verificará que tu TV sea compatible antes de activar HDR."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue la mejor calidad de imagen con colores más brillantes. El Apple TV verificará que tu TV sea compatible antes de activar HDR."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa paras kuva ja paremmat, kirkkaammat värit. Apple TV tarkastaa TV:n yhteensopivuuden ennen kuin HDR laitetaan päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d’une qualité d’image optimale avec des couleurs plus vives. L’Apple TV va vérifier que votre téléviseur est compatible avant d’activer la HDR."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez la meilleure image possible avec les couleurs les plus claires. L’Apple TV s’assurera que votre télévision est compatible avant d’activer HDR."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לקבל את איכות התמונה הטובה ביותר עם צבעים בהירים ואיכותיים יותר. ה-Apple TV יוודא שהטלוויזיה שלך תואמת ל-HDR לפני ההפעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर और चमकीले रंगों के साथ सबसे अच्छी तस्वीर पाएँ। HDR चालू करने के पहले Apple TV सुनिश्चित करेगा कि आपका टीवी संगत है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledajte najbolju moguću sliku s poboljšanim i jarkim bojama. Apple TV provjerit će je li vaš TV kompatibilan prije uključenja značajke HDR."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élvezze a jobb, élénkebb színeknek köszönhető legjobb képminőséget. A HDR bekapcsolása előtt az Apple TV meggyőződik arról, hogy a televíziókészüléke kompatibilis-e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan gambar terbaik dengan warna yang lebih cerah dan lebih baik. Apple TV akan memastikan TV Anda kompatibel sebelum menyalakan HDR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni la migliore qualità delle immagini e i colori più vividi. Prima di attivare la modalità HDR, Apple TV verificherà che il tuo televisore sia compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より鮮やかな色で最高の画像を表示しましょう。Apple TVは、テレビに互換性があることを確認してから、HDRをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 밝고 선명한 색상이 담긴 최고 화질의 영상으로 봅니다. Apple TV가 HDR을 켜기 전에 사용자의 TV가 호환 가능한지 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan gambar yang terbaik dengan warna yang lebih baik dan lebih cerah. Apple TV akan memastikan TV anda serasi sebelum mengaktifkan HDR."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få det beste bildet med bedre og sterkere farger. Apple TV kontrollerer at TV-en din er kompatibel, før HDR slås på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg het beste beeld met betere en scherpere kleuren. Apple TV controleert of je tv compatibel is voordat HDR wordt ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb HDR to optymalny obraz o lepszych, jaśniejszych kolorach. Przed włączeniem go Apple TV sprawdzi, czy Twój telewizor jest z nim zgodny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha a melhor imagem, com cores melhores e mais brilhantes. Antes de ativar o HDR, a Apple TV conferirá se a TV é compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha a melhor imagem, com cores fortes e mais brilhantes. Antes de mudar para HDR, a Apple TV certificar‑se‑á de que a televisão é compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obțineți cea mai bună imagine, prin culori mai performante și mai strălucitoare. Înainte de a activa HDR, Apple TV-ul va testa compatibilitatea televizorului dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наилучшее изображение с более яркими цветами. Apple TV проверит телевизор на совместимость перед переключением на HDR."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Získajte špičkový obraz s lepšími a žiarivejšími farbami. Apple TV pred zapnutím formátu HDR overí kompatibilitu televízora."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagotovite si najboljšo sliko z boljšimi, svetlejšimi barvami. Apple TV bo preveril združljivost vašega televizorja, preden vklopi HDR."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få bästa möjliga bild med bättre och mer intensiva färger. Apple TV kontrollerar att din TV är kompatibel innan HDR aktiveras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อการรับชมภาพที่ดีที่สุดจากสีสันและความสว่างที่มากขึ้น Apple TV จะตรวจสอบให้แน่ใจว่าทีวีของคุณสามารถใช้งานร่วมกันได้ก่อนที่จะเปิดใช้ HDR"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi, daha parlak renklerle en iyi görüntüyü alın. Apple TV, TV’nizin uyumlu olduğundan emin olduktan sonra HDR özelliğini açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте взірцеве зображення з кращими, яскравішими кольорами. Apple TV перевірить сумісність вашого телевізора, перш ніж вмикати HDR."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận được hình ảnh tốt nhất với màu sắc đẹp hơn, sáng hơn. Apple TV sẽ đảm bảo rằng TV của bạn tương thích trước khi bật HDR."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "获取品质更佳、画面更鲜明的画面。Apple TV确保你的电视兼容后，才会打开HDR。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取得更鮮艷出色的影像。開啟HDR之前Apple TV將會確認你的電視是否相容。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取得色彩更鮮艷出色的最佳影像。開啟HDR前，Apple TV會先確認你的電視是否相容。"
          }
        }
      }
    },
    "AVEnhanceDialogueDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة وضوح الكلام في الامتزاجات الصوتية لزيادة سهولة سماع الحوار وفهمه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca la veu per sobre d’altres sons perquè els diàlegs se sentin i s’entenguin millor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýrazní ve zvukových mixech mluvené slovo, aby byly dialogy lépe slyšitelné a srozumitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør tale mere fremtrædende i lydmiks, så det er lettere at høre og forstå dialog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe Sprache in Audiomixen hervor, damit Dialoge besser zu hören und zu verstehen sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ομιλία γίνεται περισσότερο διακριτή στις μείξεις ήχου, έτσι ώστε να μπορείτε να ακούτε και να καταλαβαίνετε πιο εύκολα τους διαλόγους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make speech more prominent in audio mixes so dialogue is easier to hear and understand."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make speech more prominent in audio mixes so dialogue is easier to hear and understand."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make speech more prominent in audio mixes so dialogue is easier to hear and understand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca la voz en las mezclas de audio para que los diálogos sean más fáciles de oír y entender."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que la lectura en voz alta se destaque en las mezclas de audio para que los diálogos sean fáciles de escuchar y de entender."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que la lectura en voz alta se destaque en las mezclas de audio para que los diálogos sean fáciles de escuchar y de entender."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korosta puhetta äänimiksauksissa, jotta dialogi on helpompi kuulla ja ymmärtää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez les voix au premier plan dans les mix audio de manière à ce que les dialogues soient plus faciles à entendre et à comprendre."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez la priorité à la parole dans les mixages audio pour que les dialogues soient plus faciles à entendre et à comprendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרה זו מאפשרת לך להבליט ולחדד את הדיבור ברצועות שמע כדי שיהיה קל יותר לשמוע ולהבין את הנאמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो मिक्स में स्पीच को अधिक प्रमुख बनाएँ, ताकि डायलॉग सुनने और समझने में आसान हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglašavanje govora u audio miksevima kako bi se dijalog lakše mogao čuti i razumjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszéd kiemelése az audiomixben, hogy a párbeszéd jobban hallható és érthető legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjelas ucapan di mixing audio agar dialog lebih mudah didengar dan dipahami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai priorità alle voci nel mix audio per rendere i dialoghi più udibili e comprensibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いろいろな音が混合しているオーディオの中から会話を目立たせることで、台詞を聞き取りやすくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼합된 여러 오디오 속에서 말소리를 더욱 부각하여 대화를 쉽게 듣고 이해할 수 있도록 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadikan pertuturan lebih menonjol dalam campuran audio supaya dialog lebih mudah didengari dan difahami."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør talen mer framtredende i lydmikser slik at det er lettere å høre og forstå dialogen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak spraak duidelijker in audiomixes, zodat gesprekken gemakkelijker te horen en te begrijpen zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwydatniaj mowę w mieszanych materiałach audio, aby łatwiej słyszeć i rozumieć dialogi."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque a fala nos mixes de áudio para facilitar a audição e a compreensão dos diálogos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reforçando as vozes em misturas de música é mais fácil ouvir e compreender os diálogos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordați prioritate părților vorbite din mixajele audio, pentru ca dialogurile să fie mai ușor de ascultat și de înțeles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь будет выделяться из фоновых звуков, чтобы Вам было проще расслышать и понять диалоги."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýrazní reč v zvukových mixoch tak, aby boli dialógy zrozumiteľnejšie a lepšie počuteľné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povečajte razločnost govora v mešanicah zvoka, da boste lažje slišali in razumeli dialoge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framhäv talet i ljudmixar så att dialogen blir enklare att höra och förstå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเสียงพูดในเสียงที่ผสมกันให้ชัดขึ้น\nเพื่อให้ได้ยินและเข้าใจบทสนทนาได้ง่ายขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karışık seslerin olduğu ortamda diyaloğun duyulmasını ve anlaşılmasını kolaylaştırmak için konuşmayı daha belirgin hâle getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовлення звучатиме чіткіше, щоб діалоги було легше чути й розуміти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho lời nói nổi bật hơn trong các bản hòa âm sao cho phần hội thoại dễ nghe và dễ hiểu hơn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频混杂时突显语音，使对话更易听到和理解。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在音訊混合中令語音更加突出，這樣對話就更容易被聽見和理解。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "突顯音訊混音中的語音讓對話變得更容易聆聽和理解。"
          }
        }
      }
    },
