    "BTErrorGenericFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد بأن \"%@\" قد تم تشغيله وأنه ضمن النطاق."
