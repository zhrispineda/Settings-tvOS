    "AccountsUserSignOutLastAccountConfirmationMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي تسجيل الخروج من آخر حساب Apple لملف التعريف هذا إلى إزالة ملف التعريف بالكامل. هل ترغب بالتأكيد في إزالة ملف التعريف؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tanques la sessió de l’últim compte d’Apple del perfil, s’eliminarà el perfil per complet. Confirmes que vols eliminar el perfil?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po odhlášení od posledního účtu Apple tohoto profilu bude profil úplně odstraněn. Určitě ho chcete odstranit?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du logger ud af den sidste Apple-konto for denne profil, fjernes profilen fuldstændigt. Er du sikker på, at du vil fjerne profilen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Abmelden bei dem letzten Apple-Account dieses Profils wird das Profil vollständig entfernt. Soll das Profil wirklich entfernt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποσύνδεση από τον πιο πρόσφατο λογαριασμό Apple για αυτό το προφίλ θα αφαιρέσει πλήρως το προφίλ. Θέλετε σίγουρα να αφαιρεθεί το προφίλ;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out of the last Apple Account for this profile will remove the profile entirely. Are you sure you want to remove the profile?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out of the last Apple Account for this profile will remove the profile entirely. Are you sure you want to remove the profile?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out of the last Apple Account for this profile will remove the profile entirely. Are you sure you want to remove the profile?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras la sesión de la última cuenta de Apple de este perfil, se eliminará el perfil por completo. ¿Seguro que quieres eliminar este perfil?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se cierra la sesión de la última cuenta de Apple de este perfil, se eliminará el perfil por completo. ¿Quieres eliminar el perfil?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se cierra la sesión de la última cuenta de Apple de este perfil, se eliminará el perfil por completo. ¿Quieres eliminar el perfil?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tämän profiilin viimeiseltä Apple-tililtä kirjaudutaan ulos, profiili poistetaan kokonaan. Poistetaanko tämä profiili?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion du dernier compte Apple de ce profil supprimera complètement ce dernier. Voulez-vous vraiment supprimer le profil ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion du dernier compte Apple pour ce profil supprimera entièrement ce dernier. Voulez-vous vraiment supprimer le profil?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקות מחשבון ה-Apple האחרון של פרופיל זה תסיר את הפרופיל לחלוטין. האם ברצונך להסיר את הפרופיל?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल के लिए पिछले Apple खाते से साइन आउट करने से प्रोफ़ाइल को पूरी तरह से हटा दिया जाएगा। क्या आप वाक़ई इस प्रोफ़ाइल को हटाना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odjavite posljednji Apple račun za ovaj profil, profil će se u potpunosti ukloniti. Sigurno želite ukloniti profil?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha kijelentkezik a profil utolsó Apple-fiókjából, akkor azzal teljesen eltávolítja a profilt. Biztosan eltávolítja a profilt?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika keluar dari Akun Apple terakhirnya, profil ini akan dihapus secara keseluruhan. Apakah Anda yakin ingin menghapus profil?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguendo l’uscita dall’ultimo Apple Account, il profilo verrà completamente rimosso. Confermi di volerlo eliminare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールで使用している最後のApple Accountからサインアウトすると、プロフィールは完全に削除されます。このプロフィールを削除してもよろしいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 마지막 Apple 계정에서 로그아웃하면 해당 프로필이 완전히 제거됩니다. 프로필을 제거하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendaftar keluar daripada Akaun Apple terakhir untuk profil ini akan mengeluarkan profil sepenuhnya. Adakah anda pasti mahu mengeluarkan profil?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du logger av siste Apple-konto knyttet til denne profilen, fjernes profilen fullstendig. Er du sikker på at du vil fjerne profilen?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je bij de laatste Apple Account voor dit profiel uitlogt, wordt het profiel helemaal verwijderd. Weet je zeker dat je het profiel wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie się z ostatniego konta Apple profilu spowoduje całkowite usunięcie tego profilu. Czy na pewno chcesz usunąć ten profil?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você finalizar a sessão da última Conta Apple deste perfil, ele será removido completamente. Tem certeza de que deseja remover este perfil?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão da última conta Apple deste perfil removerá o perfil completamente. Tem a certeza de que pretende remover o perfil?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieșirea din ultimul cont Apple pentru acest profil va elimina complet profilul. Sigur doriți să eliminați profilul?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выйти из последнего Аккаунта Apple в этом профиле, профиль будет полностью удален. Вы действительно хотите удалить этот профиль?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásením sa z posledného Apple účtu v tomto profile úplne odstránite tento profil. Naozaj chcete profil odstrániť?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z izpisom iz zadnjega računa Apple za ta profil boste profil v celoti odstranili. Ste prepričani, da želite odstraniti profil?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du loggar ut från det senaste Apple‑kontot för den här profilen tas profilen bort helt och hållet. Är du säker på att du vill ta bort profilen?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อออกจากบัญชี Apple ล่าสุดสำหรับโปรไฟล์นี้จะเอาโปรไฟล์นี้ออก คุณแน่ใจหรือไม่ว่าคุณต้องการเอาโปรไฟล์ออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilde son Apple Hesabı’ndan çıkış yapıldığında profil tamamen silinir. Profili silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід з останнього облікового запису Apple для цього профілю повністю вилучить його. Справді вилучити профіль?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đăng xuất khỏi Tài khoản Apple gần đây nhất cho hồ sơ này sẽ xóa hoàn toàn hồ sơ. Bạn có chắc chắn muốn xóa hồ sơ không?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录此个人资料的最后一个Apple账户将完全移除该个人资料。确定要移除个人资料吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "登出此個人檔案的最後一個Apple帳户將會完全移除此個人檔案。確定要移除個人檔案嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "登出此個人檔案的最後一個「Apple帳號」會將個人檔案整個移除。確定要移除個人檔案嗎？"
          }
        }
      }
    },
