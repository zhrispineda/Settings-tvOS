    "AXAccessibilityMenuDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "للوصول إلى خيارات تسهيلات الاستخدام، اضغط على رجوع ثلاث مرات.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Per accedir a les opcions d’accessibilitat, prem el botó d’enrere tres vegades.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Chcete‑li otevřít volby zpřístupnění, stiskněte třikrát tlačítko Zpět.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Tryk tre gange på Tilbage for at få adgang til Tilgængeligheds­indstillinger.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Drücke dreimal „Zurück“, um auf die Optionen für die Bedienungshilfen zuzugreifen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Για πρόσβαση στις επιλογές Προσβασιμότητας, πατήστε «Πίσω» τρεις φορές.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "To access Accessibility options, press Back three times.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "To access Accessibility options, press Back three times.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "To access Accessibility options, press Back three times.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "To access Accessibility options, press Back three times.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "To access Accessibility options, press Back three times.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Pulsa Atrás tres veces para acceder a las opciones de accesibilidad.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Presiona el botón Atrás tres veces para acceder a las opciones de accesibilidad.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Presiona el botón Atrás tres veces para acceder a las opciones de accesibilidad.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Pääset Käyttöapu-valintoihin painamalla Takaisin kolme kertaa.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Pour accéder aux options d’accessibilité, appuyez trois fois sur Retour.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Appuyez trois fois sur Retour pour accéder aux options d’accessibilité.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "כדי לגשת לאפשרויות של ״נגישות״ יש ללחוץ על ״אחורה״ שלוש פעמים.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "ऐक्सेसिबिलिटी विकल्पों को ऐक्सेस करने के लिए “वापस” पर तीन बार दबाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Triput pritisnite tipku Natrag za pristup opcijama pristupačnosti.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Kisegítő lehetőségek megnyitása a Vissza gomb háromszori megnyomásával.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Untuk mengakses pilihan Aksesibilitas, tekan Kembali tiga kali.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Per accedere alle opzioni di accessibilità, premi tre volte Indietro.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "アクセシビリティオプションを表示するには、“戻る”を3回押します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "손쉬운 사용 옵션에 빠르게 접근하려면 ‘뒤로’를 세 번 누르십시오.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Untuk mengakses pilihan Kebolehcapaian, tekan Balik tiga kali.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Druk driemaal op 'Terug' voor toegankelijkheidsopties.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Trykk på Tilbake tre ganger for å åpne tilgjengelighetsvalgene.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Aby przejść do opcji dostępności, naciśnij trzykrotnie przycisk powrotu.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Para acessar as opções de Acessibilidade, pressione Voltar três vezes.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Para aceder às opções de acessibilidade, prima três vezes o botão de retroceder.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Pentru a accesa opțiunile de accesibilitate, apăsați butonul Înapoi de trei ori.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Чтобы перейти к настройкам Универсального доступа, трижды нажмите кнопку «Назад».",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Ak chcete pristupovať k možnostiam prístupnosti, trikrát stlačte tlačidlo Späť.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Za dostop do možnosti dostopnosti trikrat pritisnite gumb Nazaj.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Öppna ett hjälpmedelsalternativ genom att trycka tre gånger på bakåtknappen.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ในการเข้าถึงตัวเลือกการช่วยการเข้าถึง ให้กดปุ่ม Back สามครั้ง",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Erişilebilirlik seçeneklerine erişmek için Geri düğmesine üç kez basın.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Щоб відкрити опції Доступності, тричі натисніть кнопку «Назад».",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Để truy cập các tùy chọn Trợ năng, hãy nhấn Quay lại ba lần.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "若要访问“无障碍”选项，请连按三次“返回”按钮。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "如要取得「輔助使用」選項，請按「返回」按鈕三次。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "若要取用「輔助使用」選項，請按下「返回」按鈕三次。",
            "state": "translated"
          }
        }
      }
    },
