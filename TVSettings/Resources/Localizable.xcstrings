    "LocationServicesMasterDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح خدمات الموقع لـ Siri والتطبيقات الأخرى بجمع واستخدام البيانات التي تشير إلى موقع Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La localització permet que Siri i altres apps recopilin i utilitzin dades que indiquin la ubicació de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Polohové služby umožňují Siri a dalším aplikacím shromažďovat a využívat data udávající polohu vaší Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalitetstjenester giver Siri og andre apps tilladelse til at indsamle og bruge oplysninger, der angiver lokaliteten af dit Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhand der Ortungsdienste können Siri und andere Apps Daten erfassen und verwenden, die auf den Standort deines Apple TV verweisen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι Υπηρεσίες τοποθεσίας επιτρέπουν στο Siri και σε άλλες εφαρμογές να συλλέγουν και να χρησιμοποιούν δεδομένα που υποδεικνύουν την τοποθεσία του Apple TV σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services allows Siri and other apps to gather and use data indicating the location of your Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services allows Siri and other apps to gather and use data indicating the location of your Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services allows Siri and other apps to gather and use data indicating the location of your Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La localización permite que Siri y otras apps recopilen y usen datos acerca de la ubicación del Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Localización permite que Siri y otras apps recopilen y usen datos que indican la ubicación de tu Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Localización permite que Siri y otras apps recopilen y usen datos que indican la ubicación de tu Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintipalvelujen avulla Siri ja muut apit voivat kerätä ja käyttää dataa, jonka avulla voidaan näyttää Apple TV:n sijainti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de localisation permet à certaines apps, dont Siri, d’obtenir et d’utiliser les coordonnées géographiques de votre Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de localisation permet à Siri et à d’autres apps d’obtenir et d’utiliser la position de votre Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאפיין ״שירותי מיקום״ מאפשר ל-Siri וליישומים אחרים לאסוף נתונים המצביעים על מיקומו של ה-Apple TV שלך ולהשתמש בהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri और अन्य ऐप्स को स्थान सेवा द्वारा आपके Apple TV के स्थान को दर्शाने वाले डेटा इकट्ठा करने और उपयोग करने की अनुमति दी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacijske usluge omogućavaju Siri i drugim aplikacijama prikupljanje i uporabu podataka koji označavaju lokaciju vašeg Apple TV‑a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Helymeghatározás lehetővé teszi, hogy Siri és más appok összegyűjtsék és felhasználják az Apple TV tartózkodási helyét jelző adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan Lokasi mengizinkan Siri dan app lainnya untuk mengumpulkan dan menggunakan data yang menunjukkan lokasi Apple TV Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La localizzazione consente a Siri e ad altre app di raccogliere e utilizzare i dati che indicano la posizione di Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“位置情報サービス”を使用すると、Siriやその他のアプリが、Apple TVの場所を示すデータを収集および使用できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 서비스는 Siri 및 다른 앱에서 Apple TV의 위치를 알리는 데이터를 수집하고 사용할 수 있도록 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan Lokasi membenarkan Siri dan app lain mengumpulkan serta menggunakan data yang menunjukkan lokasi Apple TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med stedstjenester kan Siri og andre apper samle inn og bruke data basert på Apple TV-enhetens plassering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Via 'Locatievoorzieningen' kunnen Siri en andere apps gegevens verzamelen en gebruiken die de locatie van je Apple TV aangeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługi lokalizacji pozwalają Siri i innym aplikacjom uzyskiwać położenie Twojego Apple TV i używać go."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Serviços de Localização permitem que a Siri e outros apps obtenham e usem dados que indicam a localização da sua Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços de localização permitem que Siri e outras aplicações recolham e usem informação relativa à localização da sua Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciile de localizare permit ca Siri și alte aplicații să colecteze și să utilizeze date indicând localizarea Apple TV‑ului dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Службы геолокации позволяют Siri и различным приложениям собирать и использовать данные о местонахождении Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizačné služby umožňujú Siri a ďalším apkám zhromažďovať a používať dáta stanovujúce polohu vášho Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacijske storitve omogočajo Siri in drugim aplikacijam, da zbirajo in uporabljajo podatke o lokaciji Apple TV-ja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Platstjänster tillåter att Siri och andra appar samlar in och använder data som visar platsen för din Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการหาตำแหน่งที่ตั้งจะอนุญาต Siri และแอปอื่นๆ เก็บรวบรวมและใช้ข้อมูลซึ่งระบุถึงตำแหน่งที่ตั้งของ Apple TV ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum Servisleri, Siri ve diğer uygulamaların Apple TV’nizin konumunu belirten verileri toplamasını ve kullanmasını sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Служби локації дають Siri та іншим програмам змогу збирати та використовувати дані, що вказують на приблизну геопозицію вашого Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ định vị cho phép Siri và các ứng dụng khác thu thập và sử dụng dữ liệu chỉ ra vị trí của Apple TV của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“定位服务”可让Siri以及其他App收集并使用能指明你Apple TV位置的数据。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「定位服務」允許Siri及其他App服務收集並使用Apple TV位置的資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「定位服務」可讓Siri和其他App收集和使用指出你Apple TV位置的資料。"
          }
        }
      }
    },
