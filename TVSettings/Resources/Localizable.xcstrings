    "OSUpdateRestoreCancelText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في إلغاء هذه الاستعادة؟ إذا قمت بالإلغاء الآن، يمكنك إعادة المحاولة لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols cancel·lar la restauració? Si cancel·les ara, podràs tornar-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě chcete obnovu zrušit? Pokud obnovu zrušíte, můžete to zkusit znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil annullere gendannelsen? Hvis du annullerer nu, kan du prøve igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll diese Wiederherstellung wirklich abgebrochen werden? Du kannst es dann später erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να ακυρώσετε αυτήν την επαναφορά; Αν την ακυρώσετε τώρα, μπορείτε να δοκιμάσετε πάλι αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this restore? If you cancel now, you can try again later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this restore? If you cancel now, you can try again later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to cancel this restore? If you cancel now, you can try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres cancelar esta restauración? Si cancelas el proceso ahora, podrás intentarlo de nuevo más tarde."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cancelar esta restauración? Si la cancelas, puedes volver a intentarlo más tarde."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cancelar esta restauración? Si la cancelas, puedes volver a intentarlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumotaanko palautus? Jos lopetat nyt, voit yrittää myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment annuler cette restauration ? Si vous annulez, vous pourrez réessayer ultérieurement."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment annuler cette restauration? Si vous annulez, vous pourrez réessayer plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך לבטל שחזור זה? אם בחרת לבטל, יהיה באפשרותך לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निश्चित हैं कि आप इस रीस्टोर को रद्द करना चाहते हैं? यदि आप इसे अभी रद्द कर देते हैं, तो बाद में फिर कोशिश कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurno želite poništiti ovo obnavljanje? Poništite li sada, možete ponovno pokušati kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan megszakítja a visszaállítást? Ha most megszakítja, később ismét megpróbálhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin membatalkan pemulihan ini? Jika Anda membatalkannya sekarang, maka Anda dapat mencoba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi di voler annullare la procedura di ripristino? Se annulli ora, puoi riprovare in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この復元をキャンセルしますか? キャンセルしても、あとでやり直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복원을 취소하겠습니까? 지금 취소해도 나중에 다시 시도할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu membatalkan pemulihan ini? Jika anda membatalkan sekarang, anda boleh mencuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil avbryte gjenopprettingen? Hvis du avbryter nå, kan du prøve igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je het terugzetten wilt annuleren? Als je nu annuleert, kun je het terugzetten later alsnog uitvoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz anulować to odtwarzanie? Jeśli anulujesz teraz, możesz spróbować ponownie później."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja cancelar esta restauração? Se você cancelar agora, será possível tentar outra vez mais tarde."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende cancelar este restauro? Se cancelar agora, pode voltar a tentar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți să anulați această restaurare? Dacă anulați acum, puteți reîncerca mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите отменить восстановление? Можно отменить и повторить попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete zrušiť túto obnovu? Ak ju zrušíte, môžete to znovu skúsiť neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste prepričani, da želite preklicati to obnovitev? Če prekličete zdaj, lahko znova poskusite pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill avbryta den här återställningen? Om du avbryter nu kan du försöka igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าคุณต้องการยกเลิกการกู้คืนนี้ ถ้าคุณยกเลิกตอนนี้ คุณสามารถลองอีกครั้งได้ในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri yükleme işleminden vazgeçmek istediğinizden emin misiniz? Şimdi vazgeçerseniz, daha sonra tekrar deneyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати це відновлення? Якщо ви скасуєте зараз, то можете спробувати пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn hủy quá trình khôi phục này không? Nếu bạn hủy bây giờ, bạn có thể thử lại sau."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要取消此恢复操作吗？若现在取消，你可稍后再试。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要取消還原嗎？如現在取消，你可以稍後再試。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要取消回復嗎？若現在取消，你可以稍後再試。"
          }
        }
      }
    },
