          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to show iTunes TV Shows on the Home Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si mostrar la app Series de iTunes en la pantalla de inicio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres mostrar Programas de TV en iTunes en la pantalla de inicio."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres mostrar Programas de TV en iTunes en la pantalla de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä iTunes TV -ohjelmat Koti-valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si les séries TV iTunes doivent être affichées sur l’écran d’accueil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’afficher l’app Émissions iTunes sur l’écran d’accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור להציג את ״תוכניות טלוויזיה״ של iTunes במסך הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iTunes टीवी कार्यक्रम होम स्क्रीन पर दिखाने का विकल्प चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite za prikaz iTunes emisija na početnom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja, hogy az iTunes-tv-műsorok megjelenjenek‑e a Főképernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih untuk menampilkan Acara TV iTunes di layar Utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se vuoi mostrare i programmi TV di iTunes sulla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面にiTunesのテレビ番組を表示するかどうかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에 iTunes TV 프로그램을 표시할지 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
