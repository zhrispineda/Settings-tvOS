    "AVSurroundNewFormatDolbyDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة ترميز الصوت بتنسيق Dolby Digital 5.1.\nأوقف \"تغيير التنسيق\" لتحسين جودة الصوت.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recodificarà l’àudio com a Dolby Digital 5.1.\nSi vols millorar‑ne la qualitat, desactiva “Canvia el format”.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk bude znovu kódován jako Dolby Digital 5.1.\nChcete‑li zlepšit kvalitu zvuku, vypněte volbu Změnit formát.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd bliver omkodet til Dolby Digital 5.1.\nSlå Skift format fra for at forbedre lydkvaliteten.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird als Dolby Digital 5.1 neu codiert.\nSchalte „Format ändern“ aus, um die Audioqualität zu verbessern.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος θα κωδικοποιηθεί εκ νέου ως Dolby Digital 5.1.\nΑπενεργοποιήστε την «Αλλαγή μορφής» για βελτίωση της ποιότητας ήχου.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se recodificará como Dolby Digital 5.1.\nDesactiva “Cambiar formato” para mejorar la calidad del audio.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en formato Dolby Digital 5.1.\nDesactiva Cambiar el formato para mejorar la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en formato Dolby Digital 5.1.\nDesactiva Cambiar el formato para mejorar la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni koodataan uudelleen Dolby Digital 5.1:ksi.\nParanna äänenlaatua laittamalla ”Vaihda muotoa” pois päältä.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé en Dolby Digital 5.1.\nDésactivez « Changer de format » pour améliorer la qualité audio.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé en format Dolby Digital 5.1.\nDésactivez Modifier le format pour améliorer la qualité audio.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע יקודד מחדש כ-Dolby Digital 5.1.\nלאיכות שמע משופרת, יש לכבות את ״שינוי פורמט״.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो को Dolby Digital 5.1 के रूप में फिर से एनकोड किया जाएगा।\nऑडियो गुणवत्ता को बेहतर करने के लिए “फ़ॉर्मैट बदलें” बंद करें।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio će se ponovno kodirati kao Dolby Digital 5.1.\nIsključite opciju “Promijeni format” za poboljšanje kvalitete zvuka.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang újra lesz kódolva Dolby Digital 5.1-es hangként.\nA hangminőség javítása érdekében kapcsolja ki a Formátum módosítása beállítást.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodekan ulang sebagai Dolby Digital 5.1.\nMatikan Ubah Format untuk meningkatkan kualitas audio.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio verrà ricodificato come Dolby Digital 5.1.\nDisattiva l’opzione “Modifica formato” per migliorare la qualità audio.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオはドルビーデジタル5.1に再エンコードされます。\nオーディオ品質を改善するには“フォーマットを変換”をオフにしてください。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 Dolby Digital 5.1로 다시 인코딩됩니다.\n오디오 음질을 향상하려면 포맷 변경을 끄십시오.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodkan semula sebagai Dolby Digital 5.1.\nNyahaktifkan Tukar Format untuk meningkatkan kualiti audio.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd vil bli kodet på nytt som Dolby Digital 5.1.\nSlå av Bytt format hvis du vil ha bedre lydkvalitet.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt opnieuw gecodeerd in Dolby Digital 5.1.\nSchakel 'Wijzig structuur' uit om de audiokwaliteit te verbeteren.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk będzie kodowany ponownie jako Dolby Digital 5.1.\nAby poprawić jakość, wyłącz opcję Zmień format.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado como Dolby Digital 5.1.\nDesative a opção Alterar Formato para melhorar a qualidade de áudio.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado como Dolby Digital 5.1.\nPara melhorar a qualidade do áudio, desative a opção Alterar formato.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul va fi recodat drept Dolby Digital 5.1.\nDezactivați opțiunea „Schimbare format” pentru a îmbunătăți calitatea audio.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет перекодирован в Dolby Digital 5.1.\nВыключите параметр «Изменить формат», чтобы улучшить качество звука.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bude prekódované do formátu Dolby Digital 5.1.\nAk chcete vylepšiť kvalitu audia, vypnite funkciu Zmeniť formát.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok bo znova kodiran v obliko zapisa Dolby Digital 5.1.\nIzklopite možnost Spremeni obliko zapisa, da izboljšate kakovost zvoka.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet kodas om till Dolby Digital 5.1.\nStäng av Ändra format om du vill förbättra ljudkvaliteten.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกเข้ารหัสอีกครั้งเป็น Dolby Digital 5.1\nปิดใช้การเปลี่ยนรูปแบบเพื่อปรับปรุงคุณภาพเสียง\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, Dolby Digital 5.1 olarak yeniden kodlanır.\nSes kalitesini iyileştirmek için Biçimi Değiştir’i kapatın.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук перекодовуватиметься у формат Dolby Digital 5.1.\nЩоб покращити якість звуку, вимкніть параметр «Зміна формату».\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh sẽ được mã hóa lại dưới dạng Dolby Digital 5.1.\nHãy tắt Thay đổi định dạng để cải thiện chất lượng âm thanh.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被重新编码为杜比数字5.1。\n关闭“更改格式”以提高音频质量。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將重新編碼為Dolby Digital 5.1。\n請關閉「更改格式」以改善音訊品質。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被重新編碼為杜比數位5.1。\n請關閉「更改格式」以改進音訊品質。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundNewFormatDolbyWithAtmosAvailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة ترميز الصوت بتنسيق Dolby Digital 5.1.\nأوقف \"تغيير التنسيق\" لتحسين\nجودة الصوت وتمكين Dolby Atmos.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recodificarà l’àudio com a Dolby Digital 5.1.\nSi vols millorar‑ne la qualitat i utilitzar\nDolby Atmos, desactiva “Canvia el format”.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk bude znovu kódován jako Dolby Digital 5.1.\nChcete‑li zlepšit kvalitu zvuku a zapnout\nDolby Atmos, vypněte volbu Změnit formát.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd bliver omkodet til Dolby Digital 5.1.\nSlå Skift format fra for at forbedre\nlydkvaliteten og aktivere Dolby Atmos.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird als Dolby Digital 5.1 neu codiert.\nSchalte „Format ändern“ aus, um die Audioqualität\nzu verbessern und Dolby Atmos zu aktivieren.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος θα κωδικοποιηθεί εκ νέου ως Dolby Digital 5.1.\nΑπενεργοποιήστε την «Αλλαγή μορφής» για βελτίωση\nτης ποιότητας ήχου και ενεργοποίηση του Dolby Atmos.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve\naudio quality and enable Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve\naudio quality and enable Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded as Dolby Digital 5.1.\nTurn off Change Format to improve\naudio quality and enable Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se recodificará como Dolby Digital 5.1.\nDesactiva “Cambiar formato” para mejorar\nla calidad del audio y activar Dolby Atmos.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en formato Dolby Digital 5.1.\nDesactiva Cambiar el formato para mejorar\nla calidad del audio y activa Dolby Atmos.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en formato Dolby Digital 5.1.\nDesactiva Cambiar el formato para mejorar\nla calidad del audio y activa Dolby Atmos.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni koodataan uudelleen Dolby Digital 5.1:ksi.\nParanna äänenlaatua laittamalla\n”Vaihda muotoa” pois päältä ja ottamalla Dolby Atmos käyttöön.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé en Dolby Digital 5.1.\nDésactivez « Changer de format » pour améliorer\nla qualité audio et activer le Dolby Atmos.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé en format Dolby Digital 5.1.\nDésactivez Modifier le format pour améliorer\nla qualité audio et activer Dolby Atmos.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע יקודד מחדש כ-Dolby Digital 5.1.\nיש לכבות את ״שינוי פורמט״ כדי לשפר את\nאיכות השמע ולהפעיל את Dolby Atmos.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो को Dolby Digital 5.1 के रूप में फिर से एनकोड किया जाएगा।\nऑडियो गुणवत्ता को बेहतर करने और Dolby Atmos\nसक्षम करने के लिए “फ़ॉर्मैट बदलें” बंद करें।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio će se ponovno kodirati kao Dolby Digital 5.1.\nIsključite opciju “Promijeni format”\nza poboljšanje kvalitete zvuka i omogućavanje Dolby Atmosa.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang újra lesz kódolva Dolby Digital 5.1-es hangként.\nA hangminőség javítása érdekében és a Dolby Atmos engedélyezéséhez\nkapcsolja ki a Formátum módosítása beállítást.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodekan ulang sebagai Dolby Digital 5.1.\nMatikan Ubah Format untuk meningkatkan\nkualitas audio dan mengaktifkan Dolby Atmos.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio verrà ricodificato come Dolby Digital 5.1.\nDisattiva l’opzione “Modifica formato” per migliorare\nla qualità audio e abilitare Dolby Atmos.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオはドルビーデジタル5.1に再エンコードされます。\nオーディオ品質を改善およびドルビーアトモスを有効にするには\n“フォーマットを変換”をオフにしてください。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 Dolby Digital 5.1로 다시 인코딩됩니다.\n오디오 음질을 향상하고 Dolby Atmos를 활성화하려면\n포맷 변경을 끄십시오.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodkan semula sebagai Dolby Digital 5.1.\nNyahaktifkan Tukar Format untuk meningkatkan\nkualiti audio dan mendayakan Dolby Atmos.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd vil bli kodet på nytt som Dolby Digital 5.1.\nSlå av Bytt format hvis du vil ha bedre\nlydkvalitet og aktivere Dolby Atmos.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt opnieuw gecodeerd in Dolby Digital 5.1.\nSchakel 'Wijzig structuur' uit om de audiokwaliteit\nte verbeteren en Dolby Atmos in te schakelen.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk będzie kodowany ponownie jako Dolby Digital 5.1.\nAby poprawić jakość i włączyć Dolby Atmos,\nwyłącz opcję Zmień format.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado como Dolby Digital 5.1.\nDesative a opção Alterar Formato para melhorar\na qualidade de áudio e ativar o Dolby Atmos.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado como Dolby Digital 5.1.\nDesative a opção Alterar formato para melhorar\na qualidade do áudio e ativar Dolby Atmos.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul va fi recodat drept Dolby Digital 5.1.\nDezactivați opțiunea „Schimbare format” pentru a îmbunătăți\ncalitatea audio și a activa Dolby Atmos.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет перекодирован в Dolby Digital 5.1.\nВыключите параметр «Изменить формат», чтобы улучшить\nкачество звука и включить Dolby Atmos.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bude prekódované do formátu Dolby Digital 5.1.\nAk chcete vylepšiť kvalitu audia a povoliť Dolby Atmos,\nvypnite funkciu Zmeniť formát.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok bo znova kodiran v obliko zapisa Dolby Digital 5.1.\nIzklopite možnost Spremeni obliko zapisa, da izboljšate\nkakovost zvoka in omogočite Dolby Atmos.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet kodas om till Dolby Digital 5.1.\nStäng av Ändra format om du vill förbättra\nljudkvaliteten och aktivera Dolby Atmos.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกเข้ารหัสอีกครั้งเป็น Dolby Digital 5.1\nปิดใช้การเปลี่ยนรูปแบบเพื่อปรับปรุง\nคุณภาพเสียงและเปิดใช้งาน Dolby Atmos\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, Dolby Digital 5.1 olarak yeniden kodlanır.\nSes kalitesini iyileştirmek için Biçimi Değiştir’i kapatın\nve Dolby Atmos’u etkinleştirin.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук перекодовуватиметься у формат Dolby Digital 5.1.\nВимкніть параметр «Зміна формату»,\nщоб покращити якість звуку й увімкнути Dolby Atmos.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh sẽ được mã hóa lại dưới dạng Dolby Digital 5.1.\nHãy tắt Thay đổi định dạng để cải thiện\nchất lượng âm thanh và bật Dolby Atmos.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被重新编码为杜比数字5.1。\n关闭“更改格式”以提高音频质量\n并启用杜比全景声。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將重新編碼為Dolby Digital 5.1。\n請關閉「更改格式」以改善\n音訊品質並啟用杜比全景聲。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被重新編碼為杜比數位5.1。\n請關閉「更改格式」以改進音訊品質\n並啟用杜比全景聲。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundNewFormatStereoDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تجاهل الصوت المحيطي، وسيتم\nتشغيل الاستريو بدلاً منه.\nأوقف \"تغيير التنسيق\" لتمكين الصوت المحيطي.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ignorarà el so envoltant i es reproduirà\nl’àudio en format estèreo.\nSi vols utilitzar el so envoltant, desactiva “Canvia el format”.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícekanálový zvuk bude ignorován a místo\nněj se použije stereofonní zvuk.\nChcete‑li vícekanálový zvuk zapnout, vypněte volbu Změnit formát.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundsound bliver ignoreret, og\nder afspilles stereo i stedet.\nSlå Skift format fra for at aktivere surroundsound.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround-Sound wird ignoriert und stattdessen\nwird Stereo abgespielt.\nSchalte „Format ändern“ aus, um Surround-Sound zu aktivieren.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος surround θα αγνοηθεί και θα\nαναπαράγεται στερεοφωνικός ήχος αντ’ αυτού.\nΑπενεργοποιήστε την «Αλλαγή μορφής» για ενεργοποίηση του ήχου surround.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored, and\nstereo will be played instead.\nTurn off Change Format to enable surround sound.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored, and\nstereo will be played instead.\nTurn off Change Format to enable surround sound.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored, and\nstereo will be played instead.\nTurn off Change Format to enable surround sound.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido envolvente y, en su lugar,\nel audio se reproducirá en estéreo.\nDesactiva “Cambiar formato” para activar el sonido envolvente.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido surround y\nen su lugar se reproducirá sonido estéreo.\nDesactiva Cambiar el formato para activar el sonido surround.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido surround y\nen su lugar se reproducirá sonido estéreo.\nDesactiva Cambiar el formato para activar el sonido surround.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround-ääntä ei huomioida ja\ntoistoon käytetään stereota.\nOta surround-ääni käyttöön laittamalla ”Vaihda muotoa” pois päältä.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son surround sera ignoré et\nremplacé par le son stéréo.\nDésactivez « Changer de format » pour activer le son surround.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son stéréo remplacera\nle son ambiophonique.\nDésactivez Modifier le format pour activer le son ambiophonique.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצליל ההיקפי לא יושמע,\nובמקומו יופעל סטריאו.\nכדי לאפשר צליל היקפי, יש לכבות את ״שינוי פורמט״.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सराउंड साउंड को नज़रअंदाज़ किया जाएगा और\nउसकी जगह स्टीरियो चलाया जाएगा।\nसराउंड साउंड सक्षम करने के लिए “फ़ॉर्मैट बदलें” बंद करें।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround zvuk će se ignorirati\ni umjesto njega reproducirat će se stereo zvuk.\nIsključite opciju “Promijeni format” kako biste omogućili surround zvuk.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A térhatású hang figyelmen kívül lesz hagyva, és\nsztereó hang lesz lejátszva helyette.\nA térhatású hang engedélyezéséhez kapcsolja ki a Formátum módosítása beállítást.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi lingkup akan diabaikan dan\nstereo akan diputar sebagai gantinya.\nMatikan Ubah Format untuk mengaktifkan bunyi lingkup.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio surround verrà ignorato e il suono\nverrà riprodotto in modalità stereo.\nDisattiva l’opzione “Modifica formato” per abilitare l’audio surround.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サラウンドサウンドは無視され、\nステレオが代わりに再生されます。\nサラウンドサウンドを有効にするには“フォーマットを変換”をオフにしてください。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서라운드 사운드를 무시하고\n스테레오를 대신 재생합니다.\n서라운드 사운드를 활성화하려면 포맷 변경을 끄십시오.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi keliling akan diabaikan dan stereo akan\ndimainkan.\nNyahaktifkan Tukar Format untuk mendayakan bunyi keliling.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundlyd vil bli ignorert og\nstereolyd vil bli spilt i stedet.\nSlå av Bytt format hvis du vil aktivere surroundlyd.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound wordt genegeerd en\nin plaats daarvan wordt in stereo afgespeeld.\nSchakel 'Wijzig structuur' uit om surround sound in te schakelen.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk przestrzenny będzie ignorowany\ni odtwarzany będzie dźwięk stereo.\nAby włączyć dźwięk przestrzenny, wyłącz opcję Zmień format.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som surround será ignorado e\no estéreo será reproduzido.\nDesative a opção Alterar Formato para ativar o som surround.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som envolvente será ignorado e será reproduzido\nsom estéreo.\nPara ativar som envolvente, desative Alterar formato.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul surround va fi ignorat și\nva fi redat în schimb sunet stereo.\nDezactivați opțiunea „Schimbare format” pentru a activa sunetul surround.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет воспроизведен не как объемный,\nа как стерео.\nВыключите параметр «Изменить формат», чтобы включить объемный звук.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priestorový zvuk bude ignorovaný a namiesto\ntoho bude použité stereo.\nAk chcete povoliť priestorový zvuk, vypnite funkciu Zmeniť formát.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostorski zvok ne bo upoštevan, namesto tega pa bo\npredvajan zvok stereo.\nIzklopite možnost Spremeni obliko zapisa, da omogočite prostorski zvok.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundljud kommer att ignoreras\noch stereoljud spelas upp istället.\nStäng av Ändra format om du vill aktivera surroundljud.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงรอบทิศทางจะไม่ถูกสนใจและ\nจะเล่นเสียงสเตอริโอแทน\nปิดใช้การเปลี่ยนรูปแบบเพื่อเปิดใช้งานเสียงรอบทิศทาง\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround ses yok sayılır ve\nyerine stereo çalınır.\nSurround sesi etkinleştirmek için Biçimi Değiştir’i kapatın.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обʼємний звук ігноруватиметься,\nнатомість відтворюватиметься стерео.\nВимкніть параметр «Зміна формату», щоб увімкнути обʼємний звук.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh vòm sẽ được bỏ qua và\nstereo sẽ được phát thay thế.\nHãy tắt Thay đổi định dạng để bật âm thanh vòm.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将忽略环绕声，并播放\n立体声。\n关闭“更改格式”以启用环绕声。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "環繞音效會被忽略，\n並改為以立體聲播放。\n請關閉「更改格式」以啟用環繞音效。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將忽略環繞音效，並改為播放\n立體聲。\n請關閉「更改格式」以啟用環繞音效。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundNewFormatStereoWithAtmosAvailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تجاهل الصوت المحيطي، وسيتم تشغيل الاستريو بدلاً منه. أوقف \"تغيير التنسيق\" لتمكين الصوت المحيطي\nو Dolby Atmos.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ignorarà el so envoltant i es reproduirà l’àudio en format estèreo. Si vols utilitzar el so envoltant i Dolby Atmos,\ndesactiva “Canvia el format”.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícekanálový zvuk bude ignorován a místo něj se použije stereofonní zvuk. Chcete‑li zapnout vícekanálový zvuk a Dolby Atmos,\nvypněte volbu Změnit formát.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundsound bliver ignoreret, og der afspilles stereo i stedet. Slå Skift format fra for at aktivere surroundsound\nog Dolby Atmos.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround-Sound wird ignoriert und stattdessen wird Stereo abgespielt. Schalte „Format ändern“ aus, um Surround-Sound\nund Dolby Atmos zu aktivieren.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος surround θα αγνοηθεί και θα αναπαράγεται στερεοφωνικός ήχος αντ’ αυτού. Απενεργοποιήστε την «Αλλαγή μορφής» για ενεργοποίηση του ήχου surround\nκαι του Dolby Atmos.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored, and stereo will be played instead. Turn off Change Format to enable surround sound\nand Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored and stereo will be played instead. Turn off Change Format to enable surround sound\nand Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound will be ignored, and stereo will be played instead. Turn off Change Format to enable surround sound\nand Dolby Atmos.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido envolvente y, en su lugar, el audio se reproducirá en estéreo. Desactiva “Cambiar formato”\npara activar el sonido envolvente y Dolby Atmos.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido surround y en su lugar se reproducirá sonido estéreo. Desactiva Cambiar el formato para activar el sonido surround\ny Dolby Atmos.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignorará el sonido surround y en su lugar se reproducirá sonido estéreo. Desactiva Cambiar el formato para activar el sonido surround\ny Dolby Atmos.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround-ääntä ei huomioida ja toistoon käytetään stereota. Ota surround-ääni ja Dolby Atmos käyttöön laittamalla\n”Vaihda muotoa” pois päältä.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son surround sera ignoré et remplacé par le son stéréo. Désactivez « Changer de format » pour activer le son surround\net Dolby Atmos.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son stéréo remplacera le son ambiophonique. Désactivez Modifier le format pour activer le son ambiophonique\net Dolby Atmos.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצליל ההיקפי לא יושמע, ובמקומו יופעל סטריאו. יש לכבות את ״שינוי פורמט״ כדי לאפשר צליל היקפי\nו-Dolby Atmos.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सराउंड साउंड को नज़रअंदाज़ किया जाएगा और उसकी जगह स्टीरियो चलाया जाएगा। सराउंड साउंड और Dolby Atmos सक्षम करने\nके लिए “फ़ॉर्मैट बदलें” बंद करें।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround zvuk će se ignorirati i umjesto njega reproducirat će se stereo zvuk. Isključite opciju “Promijeni format” kako biste omogućili surround zvuk\ni Dolby Atmos.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A térhatású hang figyelmen kívül lesz hagyva, és sztereó hang lesz lejátszva helyette. A térhatású hang és a Dolby Atmos engedélyezéséhez kapcsolja ki a\nFormátum módosítása beállítást.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi lingkup akan diabaikan dan stereo akan diputar sebagai gantinya. Matikan Ubah Format untuk mengaktifkan bunyi lingkup\ndan Dolby Atmos.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio surround verrà ignorato e il suono verrà riprodotto in modalità stereo. Disattiva l’opzione “Modifica formato” per abilitare l’audio surround\ne Dolby Atmos.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サラウンドサウンドは無視され、ステレオが代わりに再生されます。サラウンドサウンドおよびドルビーアトモスを有効にするには\n“フォーマットを変換”をオフにしてください。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서라운드 사운드를 무시하고 스테레오를 대신 재생합니다. 서라운드 사운드 및 Dolby Atmos를 활성화하려면\n포맷 변경을 끄십시오.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi keliling akan diabaikan dan stereo akan dimainkan. Nyahaktifkan Tukar Format untuk mendayakan bunyi keliling\ndan Dolby Atmos.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundlyd vil bli ignorert og stereolyd vil bli spilt i stedet. Slå av Bytt format hvis du vil aktivere surroundlyd\nog Dolby Atmos.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround sound wordt genegeerd en in plaats daarvan wordt in stereo afgespeeld. Schakel 'Wijzig structuur' uit om surround sound\nen Dolby Atmos in te schakelen.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk przestrzenny będzie ignorowany i odtwarzany będzie dźwięk stereo. Aby włączyć dźwięk przestrzenny i Dolby Atmos,\nwyłącz opcję Zmień format.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som surround será ignorado e o estéreo será reproduzido. Desative a opção Alterar Formato para ativar o som surround\ne o Dolby Atmos.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som envolvente será ignorado e será reproduzido som estéreo. Para ativar som envolvente e Dolby Atmos,\ndesative Alterar formato.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul surround va fi ignorat și va fi redat în schimb sunet stereo. Dezactivați opțiunea „Schimbare format” pentru a activa sunetul surround\nși Dolby Atmos.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет воспроизведен не как объемный, а как стерео. Выключите параметр «Изменить формат», чтобы включить объемный звук\nи Dolby Atmos.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priestorový zvuk bude ignorovaný a namiesto toho bude použité stereo. Ak chcete povoliť priestorový zvuk a Dolby Atmos,\nvypnite funkciu Zmeniť formát.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostorski zvok ne bo upoštevan, namesto njega pa bo predvajan zvok stereo. Izklopite možnost Spremeni obliko zapisa, da omogočite prostorski zvok\nin Dolby Atmos.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Surroundljud kommer att ignoreras och stereoljud spelas upp istället. Stäng av Ändra format om du vill aktivera surroundljud\noch Dolby Atmos.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงรอบทิศทางจะไม่ถูกสนใจและจะเล่นเสียงสเตอริโอแทน ปิดใช้การเปลี่ยนรูปแบบเพื่อเปิดใช้งานเสียงรอบทิศทาง\nและ Dolby Atmos\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surround ses yok sayılır ve yerine stereo çalınır. Surround sesi ve Dolby Atmos’u etkinleştirmek için\nBiçimi Değiştir’i kapatın.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обʼємний звук ігноруватиметься, натомість відтворюватиметься стерео. Вимкніть параметр «Зміна формату», щоб увімкнути обʼємний звук\nі Dolby Atmos.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh vòm sẽ được bỏ qua và stereo sẽ được phát thay thế. Hãy tắt Thay đổi định dạng để bật âm thanh vòm\nvà Dolby Atmos.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将忽略环绕声，并播放立体声。关闭“更改格式”以启用环绕声\n和杜比全景声。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "環繞音效會被忽略，並改為以立體聲播放。請關閉「更改格式」以啟用環繞音效\n和杜比全景聲。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將忽略環繞音效，並改為播放立體聲。請關閉「更改格式」以啟用環繞音效和\n杜比全景聲。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundNoConvertFormatDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم بشكل افتراضي فك ترميز الصوت وإرساله إلى السماعات\nبتنسيق LPCM غير مضغوط متعدد القنوات.\nإذا كانت هناك مشكلة في التشغيل،\nيرجى اختيار التنسيق الصحيح لسماعاتك.\nيمكنك معرفة المزيد على الرابط: support.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per omissió, es descodifica l’àudio i s’envia als altaveus\ncom a LPCM multicanal sense comprimir.\nEn cas que hi hagi algun problema amb la reproducció,\nselecciona el format adequat per als altaveus.\nTrobaràs més informació a support.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk se standardně dekóduje a odesílá do reproduktorů\nv nekomprimovaném vícekanálovém formátu LPCM.\nPokud máte s přehráváním potíže,\nvyberte formát vhodný pro vaše reproduktory.\nDalší informace najdete na stránce support.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som standard bliver lyd afkodet og sendt til dine højttalere\nsom ukomprimeret multikanal-LPCM.\nHvis der er et problem med afspilning,\nskal du vælge det rette format til dine højttalere.\nLæs mere på support.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird standardmäßig decodiert und als unkomprimierte\nMehrkanal-LPCM an deine Lautsprecher gesendet.\nFalls Probleme bei der Wiedergabe auftreten,\nwähle das korrekte Format für deine Lautsprecher aus.\nWeitere Informationen findest du unter: support.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από προεπιλογή, ο ήχος αποκωδικοποιείται και αποστέλλεται στα ηχεία σας\nως ασυμπίεστο πολυκάναλο LPCM.\nΑν υπάρχει πρόβλημα με την αναπαραγωγή,\nεπιλέξτε τη σωστή μορφή για τα ηχεία σας.\nΜάθετε περισσότερα στη διεύθυνση support.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, audio is decoded and sent to your speakers\nas uncompressed multichannel LPCM.\nIf there’s a problem with playback,\nchoose the correct format for your speakers.\nLearn more at support.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, audio is decoded and sent to your speakers\nas uncompressed multichannel LPCM.\nIf there’s a problem with playback,\nchoose the correct format for your speakers.\nLearn more at support.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, audio is decoded and sent to your speakers\nas uncompressed multichannel LPCM.\nIf there’s a problem with playback,\nchoose the correct format for your speakers.\nLearn more at support.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por omisión, el audio se descodifica y se envía a tus altavoces\nen formato LPCM multicanal sin comprimir.\nSi experimentas problemas con la reproducción,\nselecciona el formato adecuado para tus altavoces.\nMás información en support.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma predeterminada, el audio se decodifica y se envía\na tus bocinas como LCPM multicanal sin comprimir.\nSi hay algún problema con la reproducción,\nelige el formato adecuado para tus bocinas.\nObtén detalles en support.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma predeterminada, el audio se decodifica y se envía\na tus altavoces como LCPM multicanal sin comprimir.\nSi hay algún problema con la reproducción,\nelige el formato adecuado para tus bocinas.\nObtén detalles en support.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuksena ääni puretaan ja lähetetään kaiuttimiin\npakkaamattomana monikanavaisena LPCM:nä.\nJos toistossa on ongelma,\nvalitse oikea muoto, joka sopii kaiuttimillesi.\nLisätietoja on osoitteessa support.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, le son est décodé et dirigé vers vos haut-parleurs\nau format LPCM multicanal sans compression.\nEn cas de problème de lecture,\nchoisissez le format correct pour vos haut-parleurs.\nPour en savoir plus, accédez à la page support.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, le son est décodé et transmis à vos haut-parleurs\nau format LPCM multicanal sans compression.\nEn cas de problème de lecture,\nchoisissez un format compatible avec vos haut-parleurs.\nPour en savoir plus, rendez-vous sur support.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כברירת מחדל, השמע מפוענח ונשלח אל הרמקולים\nכ-LPCM מרובה ערוצים ולא מכווץ.\nאם יש בעיה בהפעלה,\nיש לבחור את המבנה הנכון לרמקולים.\nפרטים נוספים בכתובת: support.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से, ऑडियो को डिकोड किया गया और आपके स्पीकर पर भेजा गया\nअनकंप्रेस्ड मल्टीचैनल LPCM के रूप में।\nयदि प्लेबैक के साथ कोई समस्या है,\nअपने स्पीकर के लिए सही फ़ॉर्मैट चुनें।\nsupport.apple.com/appletv/audio पर जाकर अधिक जानें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardno, audio se dekodira i šalje na vaše zvučnike\nkao nekomprimirani višekanalni LPCM.\nAko dođe do problema s reprodukcijom,\nodaberite točan format za svoje zvučnike.\nSaznajte više na support.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezésben a hang dekódolva lesz, és tömörítetlen többcsatornás\nLPCM formátumban lesz elküldve a hangszórójára.\nHa probléma adódik a lejátszással,\nválassza ki a hangszóróihoz megfelelő formátumot.\nBővebben: support.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara default, audio didekode dan dikirimkan ke speaker Anda\nsebagai LPCM multisaluran yang tidak diringkas.\nJika ada masalah pada pemutaran,\npilih format yang benar untuk speaker Anda.\nLebih lanjut di support.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di default, l’audio viene decodificato e inviato agli altoparlanti\nin formato LPCM multicanale non compresso.\nSe si verificano problemi con la riproduzione,\nscegli il formato corretto per i tuoi altoparlanti.\nScopri di più alla pagina support.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、オーディオはデコードされ非圧縮マルチチャネルLPCMとして\nお使いのスピーカーに送信されます。\n再生に問題がある場合は、\nスピーカーに適したフォーマットを選択してください。\n詳しい情報は support.apple.com/appletv/audio をご覧ください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로, 오디오가 비압축 멀티채널 LPCM으로\n디코딩되어 사용자의 스피커에 전송됩니다.\n재생에 문제가 있는 경우\n스피커에 올바른 포맷을 선택하십시오.\n더 알아보려면 support.apple.com/appletv/audio 사이트로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara lalai, audio dinyahkodkan dan dihantar ke speaker anda\nsebagai LPCM berbilang saluran yang tidak dimampatkan.\nJika terdapat masalah dengan main balik,\npilih format yang betul untuk speaker anda.\nKetahui lebih lanjut di support.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som standard vil lyd bli dekodet og sendt til høyttalerne dine\nsom ukomprimert LPCM med flere kanaler.\nHvis det oppstår problemer med avspillingen,\nmå du velge riktig format for høyttalerne.\nFinn ut mer på support.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard wordt audio gedecodeerd en naar je luidsprekers verstuurd\nin een ongecomprimeerde LPCM-structuur met meerdere kanalen.\nAls er een probleem is met afspelen,\nkies je de juiste structuur voor je luidsprekers.\nMeer informatie vind je op support.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk jest domyślnie rozkodowywany i wysyłany do głośników\njako nieskompresowany, wielokanałowy LPCM.\nJeśli wystąpił problem z odtwarzaniem,\nwybierz format właściwy dla Twoich głośników.\nWięcej informacji: support.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, o áudio é decodificado e enviado para os seus alto‑falantes\ncomo LPCM multicanal não comprimido.\nSe houver algum problema com a reprodução,\nescolha o formato dos alto‑falantes.\nSaiba mais em support.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por predefinição, o áudio é descodificado e enviado para as colunas\ncomo LPCM multicanal não comprimido.\nSe detetar algum problema na reprodução,\nescolha o formato correto para as colunas.\nSaiba mais em support.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Implicit, sunetul este decodat și trimis către difuzoare\ndrept LCPM multicanal necomprimat.\nDacă survine vreo problemă la redare,\nalegeți formatul corect pentru difuzoarele dvs.\nAflați mai multe la support.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию звук декодируется и отправляется на Вашу аудиосистему\nв многоканальном формате LPCM без сжатия.\nЕсли возникнет проблема с воспроизведением,\nвыберите формат, совместимый с Вашей аудиосистемой.\nПодробнее: support.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio je štandardne dekódované a odosielané do reproduktorov\nako nekomprimované viackanálové LPCM.\nAk máte problémy s prehrávaním,\nvyberte správny formát pre vaše reproduktory.\nViac informácií nájdete na support.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privzeto je zvok dekodiran in poslan v vaše zvočnike\nkot nestisnjen večkanalni LPCM.\nČe je prišlo do težave s predvajanjem,\nizberite pravilno obliko zapisa za zvočnike.\nVeč informacij je na voljo na support.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som förval avkodas ljudet och skickas till dina högtalare\nsom okomprimerat flerkanals-LPCM.\nOm ett fel uppstår med uppspelningen\nväljer du rätt format för dina högtalare.\nLäs mer på support.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยปกติแล้วเสียงจะถูกถอดรหัสและส่งไปยังลำโพงของคุณ\nในรูปแบบ LPCM แบบหลายช่องทางเสียงที่ไม่บีบอัด\nถ้ามีปัญหากับการเล่น\nเลือกรูปแบบที่ถูกต้องสำหรับลำโพงของคุณ\nเรียนรู้เพิ่มเติมที่ support.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış olarak sesin kodu çözülür ve sıkıştırılmamış çok kanallı LPCM olarak\nhoparlörlerinize gönderilir.\nSes çalma ile ilgili bir sorun varsa\nhoparlörleriniz için doğru biçimi seçin.\nDaha fazla bilgi: support.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартний формат декодування звуку для відтворення\nна динаміках — нестиснений багатоканальний LPCM.\nЯкщо виникають проблеми з відтворенням,\nоберіть формат, необхідний для ваших динаміків.\nДокладніше на вебсторінці support.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo mặc định, âm thanh được giải mã và gửi đến các loa của bạn\ndưới dạng LPCM đa kênh chưa nén.\nNếu có sự cố với quá trình phát lại,\nhãy chọn đúng định dạng cho các loa của bạn.\nTìm hiểu thêm tại support.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，音频会被解码并以未压缩多声道LPCM\n发送至扬声器。\n若播放出现问题，\n请为扬声器选择正确格式。\n若要进一步了解，请前往support.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按照預設，音訊會被解碼並傳送至你的喇叭\n（以未壓縮多聲道LPCM格式）。\n如有播放問題，\n請為喇叭選擇正確的格式。\n詳情請瀏覽support.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "依照預設，音訊會被解碼並以未壓縮多聲道LPCM格式\n傳送到你的揚聲器。\n若發生播放問題，\n請為揚聲器選擇正確的格式。\n更多內容請見：support.apple.com/appletv/audio"
          }
        }
      }
    },
