    "iTMSPasswordSettingsDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إجراء عملية الشراء باستخدام %@، هل ترغب في المطالبة بإدخال كلمة السر لإجراء عمليات شراء إضافية على هذا الجهاز؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de fer una compra amb %@, vols sol·licitar la contrasenya per fer més compres en aquest dispositiu?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete po provedení nákupu pomocí „%@“ požadovat pro další nákupy z tohoto zařízení heslo?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv adgangskode til flere køb på denne enhed efter, at der er foretaget et køb med %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll nach einem Kauf mit %@ für weitere Käufe auf diesem Gerät ein Passwort angefordert werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την πραγματοποίηση αγοράς με το %@, να απαιτείται συνθηματικό για πρόσθετες αγορές σε αυτήν τη συσκευή;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with %@, require password for additional purchases on this device?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with %@, require password for additional purchases on this device?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with %@, require password for additional purchases on this device?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras comprar con %@, ¿solicitar la contraseña para realizar más compras en este dispositivo?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Solicitar la contraseña para realizar más compras en este dispositivo después de haber comprado con %@?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Solicitar la contraseña para realizar más compras en este dispositivo después de haber comprado con %@?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaaditaanko lisäostoille salasana tällä laitteella, kun olet ostanut tunnuksella %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un premier achat effectué sur cet appareil avec %@, exiger le mot de passe pour tout achat supplémentaire ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger le mot de passe pour effectuer d’autres achats sur cet appareil après avoir effectué un achat avec %@?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר ביצוע רכישה באמצעות %@, האם לדרוש סיסמה עבור רכישות נוספות במכשיר זה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से ख़रीदारी करने के बाद इस डिवाइस पर अतिरिक्त ख़रीदारी करने के लिए पासवर्ड आवश्यक है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon obavljanja kupnje s računom \"%@\" zatražiti lozinku za dodatne kupnje na ovom uređaju?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja, hogy a következővel végzett vásárlás után jelszót kelljen megadni az ezen az eszközön végzett további vásárlásokhoz: %@?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah melakukan pembelian dengan %@, apakah kata sandi akan diperlukan untuk pembelian tambahan di perangkat ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver effettuato un acquisto con %@, vuoi che ti venga richiesta la password anche per gli eventuali altri acquisti su questo dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で購入したあと、このデバイスで追加で購入するときにパスワードを要求しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 %@ 계정으로 추가 항목 구입 시, 암호를 입력하도록 설정하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas membuat pembelian dengan %@, perlukan kata laluan untuk pembelian tambahan pada peranti ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du kreve passord for ytterligere kjøp på enheten etter at du har gjort et kjøp med %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet na het doen van een aankoop met %@ een wachtwoord worden ingevoerd voor aanvullende aankopen op dit apparaat?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy wymagać hasła przy kolejnych zakupach użytkownika %@ dokonywanych na tym urządzeniu?"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após fazer uma compra com %@, exigir senha para compras adicionais com este dispositivo?"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após efetuar uma compra com %@, pedir palavra‑passe para fazer compras adicionais neste dispositivo?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doriți solicitarea parolei pentru cumpărăturile suplimentare de pe acest dispozitiv după efectuarea unei achiziții cu %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивать на этом устройстве пароль для дополнительных покупок после совершения покупки с использованием %@?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete po zakúpení položky pomocou Apple ID %@ vyžadovať heslo pre ďalšie nákupy na tomto zariadení?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite, da je po nakupu z računom Apple ID %@ v tej napravi vedno potrebno geslo za dodatne nakupe?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du kräva ett lösenord för fler köp på den här enheten när du har köpt något med %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากที่ใช้ %@ ซื้อสินค้าแล้ว คุณต้องการให้ใส่รหัสผ่านสำหรับซื้อสินค้าเพิ่มเติมบนอุปกรณ์เครื่องนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile alışveriş yaptıktan sonra bu aygıttaki diğer alışverişler için parola gereksin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати пароль для додаткових покупок на цьому пристрої після здійснення покупки із %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi thực hiện giao dịch mua với %@, yêu cầu mật khẩu cho các giao dịch mua khác trên thiết bị này?"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过%@完成一次购买后，在此设备上继续购买还需要输入密码吗？"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%@在此裝置上購物後，再次購買時需要重新輸入密碼嗎？"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%@進行購買後，在此裝置上購買其他項目時是否要求輸入密碼？"
          }
        }
      }
    },
