    "NetworkTestPerformanceDialogText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل بث الفيديو لديك بطيء أو يقوم بالتحميل بشكل مستمر؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducció de vídeo va lenta o està carregant-se constantment?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je váš stream videa pomalý nebo se neustále načítá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er din videostream langsom eller indlæser konstant?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dein Videostream langsam oder lädt ständig?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναπαραγωγή ροής βίντεο είναι αργή ή δείχνει να φορτώνει συνεχώς;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is your video stream slow or constantly loading?"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Is your video stream slow or constantly loading?"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Is your video stream slow or constantly loading?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La transmisión del vídeo es muy lenta o no para de cargarse?"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La transmisión de video es lenta o está cargando constantemente?"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La transmisión de video es lenta o está cargando constantemente?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko videovirta hidas tai lataako se jatkuvasti?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre flux vidéo est-il lent ou toujours en chargement ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre flux vidéo est-il lent ou en chargement constant?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם זרם הווידאו שלך איטי או נקטע שוב ושוב לצורך טעינה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपका वीडियो धीरे स्ट्रीम हो रहा है या लगातार लोड हो रहा है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je li vaš video stream spor ili se neprestano učitava?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassú a videostream, vagy állandóan tölt?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah stream video Anda lambat atau terus-menerus memuat?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo streaming video è lento o non smette di caricare?"
          }
        },
