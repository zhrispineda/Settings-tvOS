    "RCVCAutoMenuItemDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختيار التلقائي لأكثر عناصر تحكم مستوى الصوت توافقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona els controls de volum més adequats automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky zvolí nejkompatibilnější způsob ovládání hlasitosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg automatisk den mest kompatible lydstyrkejustering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle automatisch die Lautstärkeregelung mit der höchsten Kompatibilität."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέγει αυτόματα τον πιο συμβατό έλεγχο της έντασης ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pick the most compatible volume control."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pick the most compatible volume control."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pick the most compatible volume control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige automáticamente el control de volumen más compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige automáticamente el control del volumen más compatible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige automáticamente el control del volumen más compatible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yhteensopivin äänenvoimakkuuden säädin automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir automatiquement la commande de volume la plus compatible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez automatiquement le mode de contrôle du volume le plus compatible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור באופן אוטומטי את בקרת עוצמת השמע המתאימה ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वाधिक संगत वॉल्यूम कंट्रोल ऑटोमैटिकली चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski odabir najkompatibilnije postavke glasnoće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan kiválasztja a leginkább kompatibilis hangerővezérlőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kontrol volume yang paling kompatibel secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli automaticamente il controllo del volume più compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も互換性が高い音量コントロールを自動的に選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환성이 가장 높은 음량 조절을 자동으로 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kawalan kelantangan yang paling serasi secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg automatisk den mest kompatible volumkontrollen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies automatisch de meest compatibele volumeregeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wybieraj najbardziej zgodne sterowanie głośnością."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona automaticamente o controle de volume mais compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar automaticamente o controlo de volume mais compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai compatibil control al volumului va fi selectat în mod automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически выбирать наиболее подходящий способ регулировки громкости."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vyberie najkompatibilnejší ovládač hlasitosti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno izberite najbolj združljivo upravljanje glasnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det mest kompatibla ljudreglaget automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการควบคุมระดับเสียงที่ใช้งานร่วมกันได้มากที่สุดโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En uyumlu ses yüksekliği denetimini otomatik olarak seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично вибирайте найсумісніший пульт керування гучністю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chọn điều khiển âm lượng tương thích nhất."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择最兼容的音量控制。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動選擇最相容的音量控制。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動挑選最相容的音量控制。"
          }
        }
      }
