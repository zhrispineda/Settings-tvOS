    "WirelessAudioSyncCantHearSubTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن الغرفة هادئة، قرِّب iPhone من التلفزيون، واضبط مستوى صوت السماعة إذا لزم الأمر. يجب استخدام iOS 18.4 أو أحدث على iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegura’t que a l’habitació no hi hagi soroll, apropa l’iPhone al televisor i, si cal, ajusta el volum de l’altaveu. L’iPhone ha de tenir com a mínim l’iOS 18.4."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že je v místnosti ticho, podržte iPhone u televizoru a v případě potřeby upravte hlasitost reproduktorů. Na iPhonu musí být nainstalovaný systém iOS 18.4 nebo novější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at der er stille i rummet, hold din iPhone tæt på fjernsynet, og juster højttalerlydstyrken om nødvendigt. Din iPhone skal bruge iOS 18.4 eller en nyere version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass es im Raum still ist, bringe dein iPhone in die Nähe des TV-Geräts und passe die Lautstärke bei Bedarf an. Auf dem iPhone muss iOS 18.4 oder neuer installiert sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι δεν υπάρχει θόρυβος στο δωμάτιο που βρίσκεστε, κρατήστε το iPhone σας κοντά στην τηλεόραση και προσαρμόστε την ένταση ήχου των ηχείων, αν χρειαστεί. Το iPhone πρέπει να διαθέτει το iOS 18.4 ή μεταγενέστερη έκδοση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your room is quiet, hold your iPhone close to your television, and adjust your speaker volume if needed. Your iPhone must have iOS 18.4 or later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your room is quiet, hold your iPhone close to your television, and adjust your speaker volume if needed. Your iPhone must have iOS 18.4 or later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your room is quiet, hold your iPhone close to your television, and adjust your speaker volume if needed. Your iPhone must have iOS 18.4 or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la habitación esté silenciosa, acerca el iPhone al televisor y ajusta el volumen del altavoz si es necesario. El iPhone debe disponer de iOS 18.4 o posterior."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la habitación esté en silencio, acerca tu iPhone a la TV y ajusta el volumen de ser necesario. Tu iPhone debe tener iOS 18.4 o posterior."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la habitación esté en silencio, acerca tu iPhone a la TV y ajusta el volumen de ser necesario. Tu iPhone debe tener iOS 18.4 o posterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että huone on hiljainen, pidä iPhonea television lähellä ja säädä kaiuttimien äänenvoimakkuutta tarvittaessa. iPhonessa on oltava iOS 18.4 tai uudempi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous qu’il n’y a pas de bruit dans la pièce, tenez votre iPhone près de votre téléviseur et réglez le volume des haut-parleurs si nécessaire. Votre iPhone doit exécuter iOS 18.4 ou ultérieur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que la pièce est silencieuse, tenez votre iPhone à proximité de votre télévision et réglez le volume de votre haut-parleur si nécessaire. Votre iPhone doit fonctionner sous iOS 18.4 ou une version ultérieure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שהחדר שקט, לקרב את ה-iPhone לטלוויזיה ולשנות את עוצמת הרמקול במידת הצורך. נדרשת התקנה של גירסת iOS 18.4 ואילך ב-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करें कि आपका कमरा शांत हो, अपने iPhone को अपने टेलीविज़न के नज़दीक रखें और ज़रूरत पड़ने पर स्पीकर का वॉल्यूम ऐडजस्ट करें। आपके iPhone पर iOS 18.4 या बाद का संस्करण होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite da je u sobi tiho, držite iPhone blizu televizora i podesite glasnoću zvučnika ako je potrebno. Na iPhoneu treba biti instaliran iOS 18.4 ili noviji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ügyeljen arra, hogy az adott helyiség zajmentes legyen, tartsa közel az iPhone‑t a televíziójához, és módosítsa a hangszóró hangerejét, ha szükséges. Az iPhone‑on iOS 18.4 vagy újabb rendszernek kell futnia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan ruangan Anda dalam keadaan hening, dekatkan iPhone Anda ke televisi, dan sesuaikan volume speaker jika perlu. iPhone Anda harus memiliki iOS 18.4 atau lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che la stanza sia silenziosa, tieni iPhone vicino al televisore e regola il volume dell’altoparlante, se necessario. Su iPhone deve essere installato iOS 18.4 o versioni successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋が静かであることを確認し、iPhoneをテレビの近くにかざして、必要に応じてスピーカーの音量を調整します。iPhoneにiOS 18.4以降が搭載されている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내가 조용한 상태인지 확인한 다음, 사용자의 iPhone을 텔레비전 가까이 들고 필요한 경우 스피커 음량을 조절하십시오. 사용자의 iPhone이 iOS 18.4 이상이어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan bilik anda senyap, pegang iPhone anda berdekatan televisyen anda dan laraskan kelantangan speaker anda jika perlu. iPhone anda mesti mempunyai iOS 18.4 atau lebih baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass på at det er stille i rommet, hold iPhonen nær TV-en og juster høyttalervolumet hvis nødvendig. iPhonen må ha iOS 18.4 eller nyere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat je kamer stil is, houd je iPhone dicht bij je televisie en pas zo nodig het luidsprekervolume aan. Voor je iPhone is iOS 18.4 of nieuwer vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj, aby w pokoju było cicho, umieść iPhone’a blisko telewizora i wyreguluj głośność głośnika, jeśli to konieczne. iPhone musi mieć system iOS 18.4 lub nowszy."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que o cômodo esteja em silêncio, aproxime o iPhone da televisão e ajuste o volume do alto‑falante, se necessário. Seu iPhone deve ter o iOS 18.4 ou posterior."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique‑se de que não há ruído na divisão, aproxime o iPhone da televisão e, se for necessário, ajuste o volume da coluna. O iPhone tem de ter o iOS 18.4 ou posterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurați‑vă că este liniște în cameră, țineți‑vă iPhone‑ul aproape de televizor și ajustați volumul difuzorului, dacă este necesar. iPhone‑ul trebuie să aibă iOS 18.4 sau o versiune ulterioară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что вокруг тихо. Поднесите iPhone к телевизору и скорректируйте громкость динамиков, если потребуется. Требуется iPhone с iOS 18.4 или новее."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že je v miestnosti ticho, podržte iPhone pri televízore a ak je to potrebné, upravte hlasitosť reproduktorov. Na iPhone musí byť nainštalovaný systém iOS 18.4 alebo novší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskrbite, da bo v prostoru tišina, iPhone držite blizu televizorja in po potrebi prilagodite glasnost zvočnika. V iPhonu mora biti nameščen operacijski sistem iOS 18.4 ali novejši."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att det är tyst i rummet, håll iPhone nära TV-apparaten och justera högtalarvolymen om det behövs. iPhone måste använda iOS 18.4 eller senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบให้แน่ใจว่าห้องของคุณเงียบ ถือ iPhone ใกล้กับโทรทัศน์ของคุณ แล้วปรับระดับเสียงลำโพงของคุณหากต้องการ iPhone ของคุณต้องมี iOS 18.4 ขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odanın sessiz olduğundan emin olun, iPhone’unuzu televizyonunuza yaklaştırın ve gerekiyorsa hoparlörünüzün ses yüksekliğini ayarlayın. iPhone’unuzda iOS 18.4 veya daha yenisi yüklü olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упевніться, що у приміщенні тихо, тримайте iPhone біля телевізора й за потреби відрегулюйте гучність динаміка. На iPhone має бути інстальовано iOS 18.4 чи новішої версії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo phòng của bạn yên tĩnh, giữ iPhone gần tivi của bạn và điều chỉnh âm lượng loa nếu cần. iPhone của bạn phải có iOS 18.4 trở lên."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确保房间安静，握住iPhone靠近电视，然后按需调整扬声器音量。iPhone必须运行iOS 18.4或更高版本。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確保房間安靜，然後將你的iPhone靠近電視，並按需要調節喇叭的音量。你的iPhone必須是iOS 18.4或較新版本。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持室內安靜，讓你的iPhone靠近電視，並且調整揚聲器的音量（如有需要）。你的iPhone必須安裝iOS 18.4或以上版本。"
          }
        }
      }
    },
