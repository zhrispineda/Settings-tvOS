    "NLCNameRequiredMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "يرجى إدخال اسم لملف التعريف أو تحديد \"إلغاء\" لاستبعاد التغييرات",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Posa un nom al perfil o selecciona “Cancel·la” per descartar els canvis.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Zadejte název profilu. Pokud provedené změny použít nechcete, vyberte volbu Zrušit.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Skriv et navn til profilen, eller vælg Annuller, hvis du vil slette ændringerne",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Gib einen Namen für das Profil ein oder wähle „Abbrechen“, um die Änderungen zu verwerfen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Εισαγάγετε ένα όνομα για το προφίλ ή επιλέξτε «Ακύρωση» για απόρριψη των αλλαγών",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Please enter a name for the profile or select Cancel to discard changes",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Please enter a name for the profile or select Cancel to discard changes",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Please enter a name for the profile or select Cancel to discard changes",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Please enter a name for the profile or select Cancel to discard changes",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Introduce un nombre para el perfil o selecciona Cancelar para descartar los cambios.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Ingresa un nombre para el perfil o selecciona Cancelar para descartar los cambios",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Syötä profiilille nimi tai hylkää muutokset valitsemalla Kumoa",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Saisissez un nom pour le profil ou sélectionnez Annuler pour annuler les modifications.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Veuillez entrer un nom pour le profil ou sélectionner Annuler pour annuler les modifications.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "נא להזין שם עבור הפרופיל או לבחור ב״ביטול״ כדי לבטל את השינויים",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "कृपया प्रोफ़ाइल के लिए कोई नाम चुनें या परिवर्तन ख़ारिज करने के लिए “रद्द करें” चुनें",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Unesite naziv za profil ili odaberite Poništi za odbacivanje promjena",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Adja meg a profil nevét, vagy válassza a Mégsem lehetőséget a módosítások elvetéséhez",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Masukkan nama untuk profil atau pilih Batalkan untuk membuang perubahan",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
