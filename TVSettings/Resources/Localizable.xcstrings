    "LanguagePreferredLanguagesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم التطبيقات أول لغة مدعومة في القائمة. وستظهر لوحات المفاتيح بترتيب اللغات المفضل لديك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps utilitzaran el primer idioma compatible de la llista i els teclats es mostraran segons l’ordre que hagis establert."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace budou používat první zvolený jazyk, který je podporován. Klávesnice se budou zobrazovat v pořadí vašich preferovaných jazyků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps bruger det først angivne sprog, som understøttes. Tastaturer vises i din foretrukne sprogrækkefølge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps verwenden die erste unterstützte Sprache der Liste. Tastaturen werden in der Reihenfolge deiner bevorzugten Sprachen angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές θα χρησιμοποιούν την πρώτη γλώσσα που υποστηρίζεται από τη λίστα. Τα πληκτρολόγια θα εμφανίζονται με την προτιμώμενη σειρά γλωσσών σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps will use the first language listed that is supported. Keyboards will appear in your preferred language order."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps will use the first language listed that is supported. Keyboards will appear in your preferred language order."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps will use the first language listed that is supported. Keyboards will appear in your preferred language order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps usarán el primer idioma compatible que figure en la lista. Los teclados aparecerán ordenados por idioma según tus preferencias."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps usarán el primer idioma compatible de esta lista. Los teclados se mostrarán según el orden de idiomas preferidos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps usarán el primer idioma compatible de esta lista. Los teclados se mostrarán según el orden de idiomas preferidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit käyttävät luettelon ensimmäistä tuettua kieltä. Näppäimistöt näytetään valitsemassasi kielijärjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps utiliseront la première langue prise en charge de la liste. Les claviers apparaîtront dans l’ordre de vos langues préférées."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps utiliseront la première langue prise en charge de la liste. Les claviers s’afficheront dans l’ordre de vos langues préférées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים ישתמשו בשפה הראשונה הנתמכת ברשימה. מקלדות יופיעו לפי סדר השפות המועדף שבחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स सूची की उस पहली भाषा का उपयोग करेंगे जो समर्थित है। कीबोर्ड आपके पसंदीदा भाषा क्रम में दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije će koristiti prvi podržani jezik iz popisa. Tipkovnice će se prikazivati vašim preferiranim redoslijedom jezika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok a felsorolt nyelvek közül az első támogatottat fogják használni. A billentyűzetek a nyelvek Ön által előnyben részesített sorrendjében fognak megjelenni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App akan menggunakan bahasa pertama yang tercantum yang didukung. Papan ketik akan muncul dalam urutan bahasa pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app useranno la prima lingua supportata dell’elenco. Le tastiere verranno visualizzate nell’ordine di lingue preferito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは、対応する言語のリストの1番目の言語を使用します。キーボードは優先言語の順番で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 지원하는 언어 중 나열된 첫 번째 언어를 사용합니다. 키보드에는 사용자가 선호하는 언어 순서로 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App akan menggunakan bahasa pertama disenaraikan yang disokong. Papan kekunci akan kelihatan dalam tertib bahasa pilihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper vil bruke det første språket i listen som de støtter. Tastaturer vises etter din ønskede språkrekkefølge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps gebruiken de eerste taal in de lijst die wordt ondersteund. Toetsenborden worden weergegeven op volgorde van je voorkeurstaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje będą używały pierwszego obsługiwanego języka z listy. Klawiatury będą wyświetlane zgodnie z preferowaną kolejnością języków."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps usarão o primeiro idioma compatível da lista. Os teclados aparecerão na ordem de idiomas da sua preferência."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações usarão o primeiro idioma suportado da lista. Os teclados aparecerão pela ordem de idiomas preferida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile vor utiliza prima limbă compatibilă din listă. Tastaturile vor apărea în ordinea preferată a limbilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения будут использовать первый поддерживаемый язык из списка. Раскладки клавиатуры будут отображаться в порядке Вашего предпочтения языков."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apky budú používať prvý podporovaný jazyk v zozname. Klávesnice sa zobrazia v poradí podľa vašich preferovaných jazykov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije bodo uporabile prvi jezik na seznamu, ki je podprt. Tipkovnice se bodo prikazale v vašem izbranem vrstnem redu jezikov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar använder det första stödda språket som visas. Tangentbord visas i den föredragna språkordningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะใช้ภาษาแรกที่แสดงและรองรับ แป้นพิมพ์จะแสดงตามลำดับภาษาที่ต้องการของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar ilk sıradaki desteklenen dili kullanır. Klavyeler, tercih ettiğiniz dil sırasına göre görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми використовуватимуть першу підтримувану мову у списку. Клавіатури відображатимуться за заданим пріоритетом мов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng sẽ sử dụng ngôn ngữ đầu tiên được liệt kê được hỗ trợ. Các bàn phím sẽ xuất hiện theo thứ tự ngôn ngữ ưu tiên của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "App将使用列表中受支持的第一个语言。键盘将以首选语言顺序显示。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "App會使用列出且受支援的第一種語言。鍵盤會按你偏好的語言順序顯示。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "App將使用列表中所支援的第一個語言。鍵盤會根據你偏好的語言順序來顯示。"
          }
        }
      }
    },
