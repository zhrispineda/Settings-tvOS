          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "VoiceOver speaks items on the screen and provides helpful hints.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "VoiceOver lee en voz alta los ítems en pantalla y ofrece indicaciones útiles.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "VoiceOver lee en voz alta los elementos que aparecen en pantalla y te ofrece consejos útiles.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "VoiceOver lee en voz alta los elementos que aparecen en pantalla y te ofrece consejos útiles.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "VoiceOver puhuu näytön kohteet ja antaa hyödyllisiä vinkkejä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "VoiceOver énonce les éléments figurant à l’écran et fournit des conseils pratiques.",
