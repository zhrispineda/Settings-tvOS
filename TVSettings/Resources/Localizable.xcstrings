    "iCloudBackupManualDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل نسخة احتياطية يدويًا لكل الإعدادات الشخصية التي تحتاج إليها عند استعادة الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes una còpia de seguretat manual de la teva configuració personal per restaurar l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna osobní nastavení potřebná pro obnovení Apple TV budou zálohována ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopier manuelt alle de personlige indstillinger, som du skal bruge til at gendanne din Apple TV-enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein manuelles Backup aller persönlichen Einstellungen, die zum Wiederherstellen des Apple TV benötigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειροκίνητη δημιουργία εφεδρικού αντιγράφου όλων των προσωπικών ρυθμίσεων που απαιτούνται για επαναφορά του Apple TV σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually back up all personal settings you need to restore your Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually back up all personal settings you need to restore your Apple TV."
