        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code de jumelage de « %@ », puis appuyez sur la touche Entrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין את קוד הקישור ב-״%@״ ולאחר מכן ללחוץ על מקש Return או Enter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” पर पेयरिंग कोड दर्ज करें, फिर रिटर्न-की या एंटर-की दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite kôd za uparivanje na “%@“, zatim pritisnite tipku Return ili Enter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a párosítási kódot a következőn, majd nyomja meg a Return vagy Enter billentyűt: „%@”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode pemasangan pada “%@”, lalu tekan tombol Return atau Enter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di abbinamento su “%@”, quindi premi il tasto Invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”でペアリングコードを入力して、ReturnまたはEnterキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 페어링 코드를 입력한 다음 Return 또는 Enter 키를 누르십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kod berpasangan pada “%@”, kemudian tekan kekunci Return atau Enter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi sammenkoblingskoden på «%@», og trykk på retur- eller entertasten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de koppelingscode in op '%@' en druk op Return of Enter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj kod łączenia w parę na urządzeniu „%@”, a następnie naciśnij klawisz Return lub Enter."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de emparelhamento em “%@” e depois pressione a tecla Retorno ou Enter."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de emparelhamento em “%@” e prima a tecla return ou enter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți codul de asociere pe tastatura „%@”, apoi apăsați tasta Retur sau Enter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите код на «%@», а затем нажмите клавишу Return или Enter."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zariadení „%@“ zadajte párovací kód a stlačte kláves Return alebo Enter."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite kodo za seznanjanje v napravo »%@«, nato pa pritisnite tipko Return ali Enter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange parkopplingskoden på ”%@” och tryck sedan på retur- eller enter-tangenten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนรหัสจับคู่บน “%@” แล้วกดปุ่ม Return หรือปุ่ม Enter"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” üzerinde eşleme kodunu girin, sonra Return veya Enter tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть код спарення на «%@», потім тисніть клавішу вводу Return чи Enter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã ghép đôi trên “%@”, sau đó nhấn phím Return hoặc Enter."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在“%@”上输入配对码，然后按下Return或Enter键。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「%@」上輸入配對碼，然後按下Return或Enter鍵。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「%@」上輸入配對碼，然後按下Return或Enter鍵。"
          }
        }
      }
    },
