    "AVNativeModeSwitchingFormatToMatchVideoNoHDRDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستخدم Apple TV تنسيق العرض المحدد لديك لتشغيل المحتوى دون تعديل. يمكن لـ Apple TV أيضًا تبديل التنسيقات تلقائيًا لتتوافق مع معدل إطارات المحتوى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV utilitzarà el format de pantalla que has seleccionat per reproduir el contingut sense alteracions. També pot canviar de format automàticament per adequar‑se a la freqüència de fotogrames del contingut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude přehrávat obsah beze změn v obrazovém formátu, který jste vybrali. Formát se také může přepínat automaticky podle snímkové frekvence obrazového signálu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bruger det valgte skærmformat, så indhold afspilles uden ændringer. Apple TV kan også ændre formatet automatisk, så det matcher indholdets billedfrekvens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV verwendet das gewählte Anzeigeformat, um Inhalte ohne Änderungen zu übertragen. Apple TV kann auch automatisch Formate wechseln, sodass sie der Bildrate des Inhalts entsprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα χρησιμοποιεί την επιλεγμένη μορφή οθόνης για αναπαραγωγή περιεχομένου χωρίς μεταβολή. Το Apple TV μπορεί επίσης να αλλάζει αυτόματα τη μορφή ώστε να αντιστοιχεί στον ρυθμό καρέ του περιεχομένου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will use your selected display format to play content without alteration. Apple TV can also switch formats automatically to match the content’s frame rate."
          }
        },
        "en_AU": {
