    "SettingsVPNExpiredText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية ملف تعريف VPN في %@.\nيرجى إزالة ملف التعريف من الإعدادات > عام > ملفات التعريف، ثم إعادة تحميله لإعادة تمكين VPN."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil de VPN va caducar el dia %@.\nPer reactivar la VPN, ves a l’app Configuració > General > Perfils, elimina’l i torna’l a carregar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profil vypršel %@.\nChcete‑li VPN znovu aktivovat, odstraňte profil v Nastavení > Obecné > Profily a znovu ho načtěte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN‑profilen udløb den %@.\nFjern profilen i Indstillinger > Generelt > Profiler, og indlæs den på ny for at aktivere VPN igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das VPN-Profil ist am %@ abgelaufen.\nEntferne das Profil in „Einstellungen“ > „Allgemein“ > „Profile“ und lade es noch einmal, um VPN erneut zu aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το προφίλ VPN έληξε %@.\nΑφαιρέστε το προφίλ στις «Ρυθμίσεις» > «Γενικά» > «Προφίλ» και επαναφορτώστε το για εκ νέου ενεργοποίηση του VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile expired on %@.\nRemove the profile in Settings > General > Profiles and reload it to re-enable VPN."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile expired on %@.\nRemove the profile in Settings > General > Profiles and reload it to re-enable VPN."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile expired on %@.\nRemove the profile in Settings > General > Profiles and reload it to re-enable VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil VPN caducó el %@.\nElimina el perfil desde Ajustes > General > Perfiles y vuelve a cargarlo para reactivar la conexión VPN."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil de VPN venció el %@.\nElimínalo en Configuración > General > Perfiles y vuelve a cargarlo para restituir la VPN."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil de VPN venció el %@.\nElimínalo en Configuración > General > Perfiles y vuelve a cargarlo para restituir la VPN."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile expired on %@.\nRemove the profile in Settings > General > Profiles and reload it to re-enable VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil VPN a expiré le %@.\nSupprimez le profil sous Réglages > Général > Profils, puis rechargez-le pour réactiver le VPN."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil VPN expire le %@.\nSupprimez le profil dans Réglages > Général > Profils, puis rechargez-le pour réactiver le VPN."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוקף של פרופיל ה-VPN יפוג ב: %@.\nיש להסיר את הפרופיל דרך ״הגדרות״ > ״כללי״ > ״פרופילים״ ולטעון אותו מחדש כדי להפעיל שוב את ה-VPN."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN प्रोफ़ाइल की समय सीमा %@ को समाप्त हो गई।\nसेटिंग > सामान्य > प्रोफ़ाइल में जाकर प्रोफ़ाइल हटाएँ और VPN फिर सक्षम करने के लिए इसे फिर लोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profil istekao je %@.\nUklonite profil u Postavkama > Općenito > Profili te ga ponovno učitajte kako biste omogućili VPN."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN-profil lejárt ekkor: %@.\nTávolítsa el a profilt a Beállítások > Általános > Profilok menüpontban, majd töltse be újra a VPN újraengedélyezéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil VPN kedaluwarsa pada %@.\nHapus profil di Pengaturan > Umum > Profil dan muat ulang untuk mengaktifkan kembali VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo VPN è scaduto in data %@.\nPer abilitare di nuovo il VPN, rimuovi il profilo in Impostazioni > Generali > Profili e ricaricalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNは%@に期限が切れます。\nVPNを再び有効にするには、“設定”＞“一般”＞“プロファイル”へ移動してプロファイルを削除して再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 프로필이 %@에 만료되었습니다.\nVPN을 다시 활성화하려면 설정 > 일반 > 프로필에서 프로필을 제거한 다음 다시 로드하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil VPN tamat tempoh pada %@.\nKeluarkan profil dalam Seting > Umum > Profil dan muat semula profil untuk mendayakan semula VPN."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-profilen utløp %@.\nFjern profilen fra Innstillinger > Generelt > Profiler og last den inn på nytt for å aktivere VPN igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het VPN-profiel is op %@ verlopen.\nVerwijder het profiel in Instellingen onder 'Algemeen' > 'Profielen' en laad het opnieuw om VPN opnieuw in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil VPN wygasł %@.\nAby ponownie włączyć sieć VPN, usuń profil na ekranie Ustawienia > Ogólne > Profile i wczytaj go jeszcze raz."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil de VPN foi expirado em %@.\nRemova o perfil em Ajustes > Geral > Perfis e recarregue‑o para reativar a VPN."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil da VPN caducou a %@.\nRemova este perfil em Definições > Geral > Perfis e volte a carregá‑lo para reativar a VPN."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilul VPN a expirat pe %@.\nEliminați profilul din Configurări > General > Profiluri și reîncărcați‑l pentru a reactiva conexiunea VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия профиля VPN истек %@.\nУдалите профиль. Для этого откройте «Настройки» > «Основные» > «Профили» и перезагрузите профиль, чтобы повторно включить VPN."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profil vypršal %@.\nAk chcete znovu povoliť VPN, odstráňte profil v Nastavenia > Všeobecné > Profily a potom ho znovu načítajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil VPN poteče dne %@.\nOdstranite profil v razdelku Nastavitve > Splošno > Profili in ga znova naložite, da ponovno omogočite VPN."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-profilen upphörde att gälla den %@.\nTa bort profilen under Inställningar > Allmänt > Profiler och läs in den på nytt så att VPN aktiveras igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ VPN หมดอายุแล้วเมื่อ %@\nเอาโปรไฟล์ออกได้ในการตั้งค่า > ทั่วไป > โปรไฟล์ แล้วโหลดโปรไฟล์ใหม่เพื่อเปิดใช้งาน VPN อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profilinin süresi %@ tarihinde doldu.\nAyarlar > Genel > Profiller’de profili silin ve VPN’i yeniden etkinleştirmek için yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль VPN застарів %@.\nВилучіть цей профіль у меню Параметри > Загальні > Профілі й завантажте його ще раз, щоб повторно ввімкнути VPN."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ VPN đã hết hạn vào %@.\nHãy xóa hồ sơ trong Cài đặt > Cài đặt chung > Hồ sơ và tải lại để bật lại VPN."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN描述文件已于%@过期。\n前往“设置”>“通用”>“描述文件”将其移除并重新载入，以重新启用VPN。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN描述檔已於%@到期。\n請在「設定」>「一般」>「描述檔」中移除描述檔並重新載入來重新啟用VPN。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 描述檔已於%@到期。\n請在「設定」>「一般」>「描述檔」中移除此描述檔並再次載入來重新啟用 VPN。"
          }
        }
      }
    },
