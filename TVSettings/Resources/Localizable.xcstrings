    "HomeKitRecordingOffAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتلقي الإشعارات، شغّل التسجيل لهذه الكاميرا في تطبيق المنزل على iPhone أو iPad أو Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rebre notificacions, activa les gravacions d’aquesta càmera a l’app Casa del teu iPhone, iPad o Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud chcete dostávat oznámení, zapněte pro tuto kameru nahrávání v aplikaci Domácnost na iPhonu, iPadu nebo Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil modtage notifikationer, skal du slå optagelse til for dette kamera i appen Hjem på din iPhone, iPad eller Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mitteilungen zu erhalten, aktiviere Aufnahmen für diese Kamera in der Home-App auf deinem iPhone, iPad oder Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για λήψη γνωστοποιήσεων, ενεργοποιήστε την εγγραφή για αυτήν την κάμερα στην εφαρμογή «Οικία» στο iPhone, iPad ή Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on recording for this camera in the Home app on your iPhone, iPad, or Mac."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on recording for this camera in the Home app on your iPhone, iPad or Mac."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive notifications, turn on recording for this camera in the Home app on your iPhone, iPad or Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación de esta cámara en la app Casa de tu iPhone, iPad o Mac."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación para esta cámara desde la app Casa en tu iPhone, iPad o Mac."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones, activa la grabación para esta cámara desde la app Casa en tu iPhone, iPad o Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat ilmoituksia, laita tallennus päälle tälle kameralle iPhonen, iPadin tai Macin Koti-apissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez l’enregistrement de cette caméra dans l’app Maison de votre iPhone, iPad ou Mac."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications, activez l’enregistrement sur cette caméra dans l’app Domicile de votre iPhone, de votre iPad ou de votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקבל עדכונים, יש להפעיל את הצילום במצלמה זו ביישום ״הבית שלי״ ב-iPhone, ב-iPad או ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ पाने के लिए अपने iPhone, iPad या Mac पर घर ऐप में इस कैमरा के लिए रिकॉर्डिंग चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za primanje obavijesti uključite snimanje za ovu kameru u aplikaciji Dom na iPhoneu, iPadu ili Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha értesítéseket szeretne kapni, kapcsolja be a felvételkészítést ehhez a kamerához az iPhone-ján, iPadjén vagy Macjén lévő Otthon appban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima pemberitahuan, nyalakan perekaman untuk kamera ini di app Rumah di iPhone, iPad, atau Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere le notifiche, attiva la registrazione per questa videocamera nell’app Casa su iPhone, su iPad o sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受信するには、iPhone、iPad、またはMacのホームアプリでカメラの収録をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 iPhone, iPad 또는 Mac의 홈 앱에서 이 카메라의 녹화 기능을 켜십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima pemberitahuan, aktifkan rakaman bagi kamera ini dalam app Rumah pada iPhone, iPad atau Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å motta varslinger må du slå på opptak for dette kameraet i Hjem-appen på iPhone, iPad eller Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om meldingen te ontvangen, schakel je opnamen in voor deze camera in de Woning-app op je iPhone, iPad of Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otrzymywać powiadomienia, włącz nagrywanie obrazu z tej kamery w aplikacji Dom na iPhonie, iPadzie lub Macu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative a gravação para esta câmera no app Casa no iPhone, iPad ou Mac."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações, ative a gravação com esta câmara na aplicação Casa no seu iPhone, iPad ou Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a primi notificări, activați înregistrarea pentru această cameră în aplicația Locuință de pe iPhone, iPad sau Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для получения уведомлений включите запись для этой камеры в приложении «Дом» на iPhone, iPad или Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete dostávať hlásenia, zapnite nahrávanie pre túto kameru v apke Domácnosť na iPhone, iPade alebo Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite prejemati obvestila, vklopite snemanje za to kamero v aplikaciji Dom v iPhonu, iPadu ali Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill få notiser aktiverar du inspelning för den här kameran i appen Hem på iPhone, iPad eller Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการรับการแจ้งเตือน ให้เปิดใช้การบันทึกสำหรับกล้องนี้ในแอปบ้านบน iPhone, iPad หรือ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim almak için iPhone’unuzdaki, iPad’inizdeki veya Mac’inizdeki Ev uygulamasında bu kamera için kaydı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримувати сповіщення, увімкніть записування для цієї камери в програмі «Дім» на iPhone, iPad або Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận thông báo, hãy bật tính năng ghi cho camera này trong ứng dụng Nhà trên iPhone, iPad hoặc máy Mac của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接收通知，请在iPhone、iPad或Mac上的“家庭”App中打开此摄像头的录制功能。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要收到通知，請在iPhone、iPad或Mac上的「家居」App中為此攝影機開啟錄影。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接收通知，請在iPhone、iPad或Mac上的「家庭」App中開啟此攝影機的錄影功能。"
          }
        }
      }
    },
