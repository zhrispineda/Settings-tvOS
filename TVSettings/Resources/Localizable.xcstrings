          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg å vise iTunes-TV-programmer på Hjem-skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ervoor om tv-programma's in iTunes op het beginscherm weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy ikona Programy TV iTunes ma być widoczna na ekranie głównym."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se os Programas de TV do iTunes aparecem na tela de Início."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se pretende mostrar Programas de TV do iTunes no ecrã principal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Optați să afișați Emisiuni TV iTunes pe ecranul principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, показывать ли сериалы и телешоу из iTunes на Главной странице."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výberom tejto možnosti zobrazíte apku TV seriály z iTunes na ploche."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, da so TV-oddaje iTunes prikazane na domačem zaslonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj att visa iTunes-TV-program på hemskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเพื่อแสดงรายการทีวี iTunes บนหน้าจอโฮม"
