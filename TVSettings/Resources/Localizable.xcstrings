      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تعرف قناع الشبكة الفرعية الخاص بك، فأدخله ثم حدد \"تم\"."
