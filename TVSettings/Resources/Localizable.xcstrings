    "APCRDCustomMessageDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإضافة رسالة مخصصة إلى التعليمات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un missatge personalitzat a les instruccions."
          }
        },
        "cs": {
