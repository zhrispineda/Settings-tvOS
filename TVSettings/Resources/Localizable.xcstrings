        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper som har bedt om tilgang til bildene dine, vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staan de apps die om toegang tot je foto's hebben gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu pojawiają się aplikacje, które proszą o dostęp do zdjęć."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que tenham solicitado acesso às suas fotos aparecerão aqui."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que pediram acesso às suas fotografias aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care au solicitat acces la pozele dvs. vor fi afișate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся приложения, запросившие доступ к Вашим фотографиям."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia apky, ktoré žiadali o prístup k vašim fotkám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki so zahtevale dostop do vaših fotografij, bodo prikazane tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som har begärt tillgång till dina bilder visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ได้ขอเข้าถึงรูปภาพของคุณจะแสดงที่นี่"
