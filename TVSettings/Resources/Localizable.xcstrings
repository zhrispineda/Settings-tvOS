    "AVChromaSubsampling422Description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفر 4:2:0 صورة عالية الجودة ومتوافقة مع معظم أجهزة التلفزيون وكبلات HDMI، بينما يركز 4:2:2 على مستوى الوضوح ولكنه يحتاج كبلات عالية السرعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El submostratge 4:2:0 proporciona una imatge d’alta qualitat que és compatible amb la majoria de televisors i cables HDMI. El submostratge 4:2:2 augmenta la nitidesa, però necessita cables d’alta velocitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 poskytuje vysoce kvalitní obraz kompatibilní s většinou televizorů a HDMI kabelů. 4:2:2 zlepšuje prokreslení obrazu, vyžaduje však vysokorychlostní kabely."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 giver et billede i høj kvalitet, som er kompatibel med de fleste tv’er og HDMI-kabler. 4:2:2 forbedrer klarheden, men kræver højhastighedskabler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 bietet ein Bild in hochwertiger Qualität, das mit den meisten Fernsehgeräten und HDMI-Kabeln kompatibel ist. 4:2:2 verbessert die Klarheit, erfordert jedoch Hochgeschwindigkeitskabel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μορφή 4:2:0 παρέχει εικόνα υψηλής ποιότητας που είναι συμβατή με τις περισσότερες τηλεοράσεις και καλώδια HDMI. Η μορφή 4:2:2 βελτιώνει την καθαρότητα, όμως απαιτεί καλώδια υψηλής ταχύτητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 provides a high-quality picture that is compatible with most TVs and HDMI cables. 4:2:2 improves clarity, but requires high-speed cables."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 provides a high-quality picture that is compatible with most TVs and HDMI cables. 4:2:2 improves clarity, but requires high-speed cables."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 provides a high-quality picture that is compatible with most TVs and HDMI cables. 4:2:2 improves clarity, but requires high-speed cables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El submuestreo 4:2:0 produce una imagen de alta calidad que es compatible con la mayoría de televisores y cables HDMI. El submuestreo 4:2:2 mejora la claridad, pero requiere cables de alta velocidad."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 ofrece una imagen de alta calidad compatible con la mayoría de cables HDMI y televisiones. 4:2:2 mejora la nitidez, pero requiere cables de alta velocidad."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 ofrece una imagen de alta calidad compatible con la mayoría de cables HDMI y televisiones. 4:2:2 mejora la nitidez, pero requiere cables de alta velocidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 antaa korkealaatuisen kuvan, joka on yhteensopiva useimpien TV:iden ja HDMI-kaapeleiden kanssa. 4:2:2 parantaa selkeyttä, mutta vaatii nopeat kaapelit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échantillonnage 4:2:0 offre une image de qualité supérieure compatible avec la plupart des téléviseurs et câbles HDMI. L’échantillonnage 4:2:2 améliore la clarté, mais requiert des câbles haut débit."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure 4:2:0 permet de produire des images de haute qualité, compatibles avec la plupart des télévisions et des câbles HDMI. La structure 4:2:2 améliore la clarté, mais requiert des câbles à haut débit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 מספק תמונה באיכות גבוהה התואמת למרבית מכשירי הטלוויזיה וכבלי ה-HDMI. ‏4:2:2 משפר את הבהירות, אך מצריך שימוש בכבלים בעלי יכולת העברת נתונים מהירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 उच्च गुणवत्ता की तस्वीर प्रदान करता है जो अधिकतर टीवी और HDMI केबल के साथ संगत है। 4:2:2 स्पष्टता में सुधार लाता है, लेकिन उच्च गति केबल की आवश्यकता होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 pruža visokokvalitetnu sliku koja je kompatibilna s većinom TV prijemnika i HDMI kabela. 4:2:2 poboljšava jasnoću, ali zahtijeva kabele koji podržavaju visoke brzine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 4:2:0 kiváló minőségű képet biztosít, amely kompatibilis a legtöbb televízióval és HDMI-kábellel. A 4:2:2 növeli a kép tisztaságát, de nagysebességű kábelt igényel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 menyediakan gambar berkualitas tinggi yang kompatibel dengan sebagian besar TV dan kabel HDMI. 4:2:2 menyediakan gambar yang jernih, tapi memerlukan kabel berkecepatan tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato 4:2:0 fornisce un’immagine di alta qualità compatibile con la maggior parte dei televisori e dei cavi HDMI. Il formato 4:2:2 migliora la nitidezza, ma richiede cavi ad alta velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0は、ほとんどのテレビとHDMIケーブルとの互換性がある高品質画像を提供します。4:2:2は、画像がより鮮明になりますが、ハイスピードケーブルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0은 대부분의 TV 및 HDMI 케이블과 호환 가능한 고화질의 영상을 제공합니다. 4:2:2는 선명도를 향상하지만 고속 케이블이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 menyediakan gambar berkualiti tinggi yang serasi dengan kebanyakan TV dan kabel HDMI. 4:2:2 meningkatkan kejelasan, namun memerlukan kabel kelajuan tinggi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 gir et bilde i høy kvalitet som er kompatibelt med de fleste TV-er og HDMI-kabler. 4:2:2 gjør bildet klarere, men krever kabler med høy hastighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 biedt een hoge beeldkwaliteit die compatibel is met de meeste tv's en HDMI-kabels. 4:2:2 verbetert de beeldscherpte, maar vereist kabels voor hoge snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Format 4:2:0 oferuje obraz o wysokiej jakości, zgodny z większością kabli TV i HDMI. Format 4:2:2 poprawia czystość obrazu, ale wymaga kabli szybkoprzesyłowych."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 oferece uma imagem de alta qualidade que é compatível com a maioria das TVs e cabos HDMI. 4:2:2 melhora a claridade, mas requer cabos de alta velocidade."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 proporciona uma imagem de alta qualidade compatível com a maioria das televisões e cabos HDMI. 4:2:2 melhora a nitidez, mas requer cabos de alta velocidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 furnizează o imagine de înaltă calitate, compatibilă cu majoritatea televizoarelor și cablurilor HDMI. 4:2:2 sporește claritatea, dar necesită cabluri de mare viteză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат 4:2:0 предлагает высококачественное изображение, совместимое с большинством телевизионных и HDMI-кабелей. Формат 4:2:2 повышает четкость изображения, но для него требуются высокоскоростные кабели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 poskytuje obraz vo vysokej kvalite kompatibilný s väčšinou televízorov a HDMI káblov. 4:2:2 vylepší čistotu obrazu, no vyžaduje vysokorýchlostné káble."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 zagotavlja visokokakovostno sliko, ki je združljiva z večino televizorjev in kablov HDMI. 4:2:2 izboljša jasnost, vendar zahteva visokohitrostne kable."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 ger en bild i hög kvalitet som är kompatibel med de flesta TV-apparater och HDMI-kablar. 4:2:2 har en bättre skärpa men kräver höghastighetskablar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 จะให้ภาพที่มีคุณภาพสูงที่ใช้งานร่วมกันได้กับทีวีและสาย HDMI ทั่วไป 4:2:2 จะเพิ่มความชัดแต่ต้องใช้กับสายที่มีความเร็วสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 birçok TV ve HDMI kablo ile uyumlu yüksek kalitede görüntü sağlar. 4:2:2 berraklığı iyileştirir ancak yüksek hızda kablolar gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат 4:2:0 забезпечує високу якість зображення, що підтримується більшістю телевізорів і HDMI-кабелів. Формат 4:2:2 покращує чіткість, але вимагає застосовувати високошвидкісні кабелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 cung cấp hình ảnh chất lượng cao tương thích với hầu hết các TV và cáp HDMI. 4:2:2 cải thiện độ rõ nét, nhưng yêu cầu cáp tốc độ cao."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0提供兼容大多数电视和HDMI线缆的高画质。4:2:2提高清晰度，但需要高速线缆。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0提供與大多數電視和HDMI接線相容的高畫質。4:2:2提高清晰度，但需要高速接線。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0提供與大部分電視和HDMI連接線都相容的高畫質影像。4:2:2會改進清晰度，但需要高速連接線。"
          }
        }
      }
    },
