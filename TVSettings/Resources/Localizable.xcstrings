    "PortraitClockAllCategoriesHiddenAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإخفاء هذه الفئة، يجب أولًا اختيار فئة أخرى لإظهارها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ocultar aquesta categoria, cal que en seleccionis una altra perquè es mostri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li tuto kategorii skrýt, nejdřív vyberte jinou, která se má zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal først vælge en anden kategori, der skal vises, før du kan skjule denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diese Kategorie auszublenden, wähle zuerst eine andere zum Einblenden aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για απόκρυψη αυτής της κατηγορίας, επιλέξτε πρώτα μία άλλη για εμφάνιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hide this category, first choose another one to show."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To hide this category, first choose another one to show."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To hide this category, first choose another one to show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ocultar esta categoría, primero debes elegir cuál se mostrará."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder ocultar esta categoría, primero elige otra para mostrar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder ocultar esta categoría, primero elige otra para mostrar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta voit kätkeä tämän kategorian, valitse ensin toinen näytettäväksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour masquer cette catégorie, choisissez d’abord une autre catégorie à afficher."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour masquer cette catégorie, vous devez d’abord en choisir une autre à afficher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להסתיר קטגוריה זו, יש לבחור תחילה קטגוריה אחרת להצגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह श्रेणी तभी छिपाई जा सकती है अगर दिखाने के लिए कोई अन्य श्रेणी पहले चुन ली जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za skrivanje ove kategorije prvo odaberite jednu za prikazivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a kategóriának az elrejtéséhez először válasszon ki egy másikat, amelyet meg kíván jeleníteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyembunyikan kategori ini, pertama-tama pilih kategori lain untuk ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per nascondere questa categoria, scegline prima un’altra da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリを非表示にするには、まず表示する別のカテゴリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카테고리를 가리려면 먼저 표시할 다른 카테고리를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyembunyikan kategori ini, pilih satu lagi untuk ditunjukkan terlebih dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må velge en annen kategori å vise før du kan skjule denne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je deze categorie wilt verbergen, kies je eerst een andere categorie om weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ukryć tę kategorię, wybierz najpierw inną, która będzie wyświetlana."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ocultar esta categoria, primeiro escolha uma para mostrar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ocultar esta categoria, primeiro escolha outra para mostrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a ascunde această categorie, alegeți mai întâi alta care să fie afișată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы скрыть эту категорию, сначала выберите другую категорию для показа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete skryť túto kategóriu, najskôr vyberte inú, ktorá sa zobrazí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite to kategorijo skriti, najprej izberite drugo kategorijo za prikazovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill gömma den här kategorin måste du först välja en annan kategori som ska visas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการซ่อนหมวดหมู่นี้ ก่อนอื่นเลือกหมวดหมู่อื่นเพื่อให้แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategoriyi gizlemek için önce gösterilecek bir kategori seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб сховати цю категорію, спочатку оберіть іншу категорію для показу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ẩn danh mục này, trước tiên hãy chọn một danh mục khác để hiển thị."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要隐藏此类别，请先选取要显示的另一个类别。"
