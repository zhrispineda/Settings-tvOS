    "iCloudHomeScreenSyncAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على تحديث تطبيقاتك وشاشاتك الرئيسية على كل\n جهاز Apple TV يستخدم حساب iCloud هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén les apps i les pantalles d’inici actualitzades\nen tots els Apple TV que utilitzin aquest compte de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte svoje aplikace a plochy aktuální na všech Apple TV, které využívají tento účet na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold dine apps og hjemmeskærme ajour på tværs af alle\n dine Apple TV-enheder vha. denne iCloud-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deine Apps und Home-Bildschirme auf jedem Apple TV, das diesen iCloud-Account verwendet, auf dem neuesten Stand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε ενημερωμένες τις εφαρμογές και τις οθόνες Αφετηρίας σας σε οποιοδήποτε Apple TV που χρησιμοποιεί αυτόν τον λογαριασμό iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your apps and Home screens up to date across every\nApple TV using this iCloud account."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your apps and Home screens up to date across every\nApple TV using this iCloud account."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your apps and Home screens up to date across every\nApple TV using this iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus apps y pantallas de inicio sincronizadas en todos\nlos Apple TV que utilicen esta cuenta de iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus apps y pantallas de inicio sincronizadas en cualquier Apple TV que use esta cuenta iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus apps y pantallas de inicio sincronizadas en cualquier Apple TV que use esta cuenta iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä apit ja Koti-valikot ajan tasalla jokaisessa\nApple TV:ssä, joka käyttää tätä iCloud-tiliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez vos apps et vos écrans d’accueil à jour sur toutes\nles Apple TV qui utilisent ce compte iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez vos apps et écrans d’accueil à jour sur\ntoutes les Apple TV qui utilisent ce compte iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לשמור על היישומים ומסכי הבית שלך מעודכנים בכל\nמכשירי ה-Apple TV שמשתמשים בחשבון iCloud זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iCloud खाते के उपयोग से अपने\nसभी Apple TV पर ऐप्स और होम स्क्रीन अप-टू-डेट रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Održavajte svoje aplikacije i početne zaslone ažurnim\nna svim Apple TV uređajima koji koriste ovaj iCloud račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprakészen tarthatja az appjait és Főképernyőit\naz összes olyan Apple TV-n, amely ezt az iCloud-fiókot használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga agar app dan layar Utama Anda tetap terbaru\ndi semua Apple TV yang menggunakan akun iCloud ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sempre aggiornate le app e le schermate Home\nsu ogni Apple TV che utilizza questo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiCloudアカウントを使用しているすべてのApple TVでアプリとホーム画面を常に最新に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iCloud 계정을 사용하는 모든 Apple TV에서\n사용자의 앱과 홈 화면을 최신으로 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan app dan skrin Utama anda dikemas kini merentas setiap\nApple TV yang menggunakan akaun iCloud ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold appene og Hjem-skjermene oppdatert på hver Apple TV som bruker denne iCloud-kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je apps en beginschermen up-to-date op elke\nApple TV die deze iCloud-account gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualniaj aplikacje i ekrany główne na wszystkich\nApple TV używających tego konta iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seus apps e telas de Início atualizados em qualquer\nApple TV que use esta conta do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as suas aplicações e ecrãs principais atualizados em todas as Apple TV que usem esta conta iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți‑vă aplicațiile și ecranele principale\nactualizate pe toate Apple TV‑urile care utilizează\nacest cont de iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте приложения и экраны «Домой» в актуальном состоянии\nна всех Apple TV, используя эту учетную запись iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizujte apky a plochu na všetkých Apple TV použitím tohto iCloud účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagotovite, da bodo vaše aplikacije in domači zasloni posodobljeni v vseh Apple TV-jih, ki uporabljajo ta račun iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll dina appar och hemskärmar uppdaterade på alla\nApple TV-enheter som använder det här iCloud-kontot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอโฮมและแอปต่างๆ ของคุณจะเหมือนกันหมดบน\nApple TV ทุกเครื่องที่ใช้บัญชี iCloud นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iCloud hesabını kullanan Apple TV’lerde\nuygulamaları ve Ana ekranları güncel tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізуйте програми і початкові екрани на всіх\nApple TV, що використовують цей обліковий запис iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật các ứng dụng và Màn hình chính trên mọi\nApple TV sử dụng tài khoản iCloud này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用此iCloud账户的所有Apple TV上\n保持App和主屏幕为最新状态。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有使用此iCloud帳户的Apple TV上，\n保持你的App和主畫面為最新狀態。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有使用此iCloud帳號的Apple TV上，讓你的 \nApp和主畫面保持最新狀態。"
          }
        }
      }
    },
