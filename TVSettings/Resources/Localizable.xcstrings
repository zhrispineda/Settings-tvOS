    "SaverBackdropLibraryEnabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الذكريات من المكتبة الشخصية أو المكتبة المشتركة أو كلتيهما"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els records de la fototeca personal, de la compartida o de totes dues."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje vzpomínky z vaší osobní knihovny, sdílené knihovny nebo obou knihoven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser minder fra dit personlige bibliotek, det delte bibliotek eller begge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückblicke aus deiner persönlichen Mediathek, der geteilten Mediathek oder beiden anzeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση αναμνήσεων από την προσωπική βιβλιοθήκη, την κοινόχρηστη βιβλιοθήκη, ή και τις δύο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library, or both"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library or both"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library, or both"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, la fototeca compartida o ambas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, compartida o ambas."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, compartida o ambas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää muistoja omasta kirjastosta, jaetusta kirjastosta tai molemmista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les souvenirs de votre photothèque personnelle, de votre photothèque partagée ou des deux."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les souvenirs de votre photothèque personnelle, de la photothèque partagée ou des deux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג זיכרונות מהספריה האישית, מהספריה המשותפת או משתיהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी व्यक्तिगत लाइब्रेरी, शेयर की गई लाइब्रेरी या दोनों से यादें दिखाई जाती हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje uspomene iz osobne medijateke, dijeljene medijateke ili oboje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeket jelenít meg a személyes könyvtárából, a megosztott könyvtárából vagy mindkettőből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan Memori dari Perpustakaan Pribadi Anda, Perpustakaan Bersama, atau keduanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i ricordi dalla libreria personale, da quella condivisa o da entrambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人用ライブラリ、共有ライブラリ、または両方のライブラリからメモリーを表示できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 보관함 또는 공유 보관함의 추억을 보여주거나, 두 보관함의 추억을 함께 보여줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan Memori daripada Pustaka Peribadi, Pustaka Dikongsi anda atau kedua-duanya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser minner fra det personlige biblioteket ditt, fellesbiblioteket, eller begge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont terugblikken uit je persoonlijke bibliotheek, gedeelde bibliotheek of beide."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać wspomnienia tylko z biblioteki osobistej, tylko z biblioteki udostępnianej lub z obu bibliotek."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Memórias da sua Fototeca Pessoal, Fototeca Compartilhada ou ambas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra recordações da sua biblioteca pessoal, biblioteca partilhada ou ambas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați amintiri din biblioteca personală, din biblioteca partajată sau din ambele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются воспоминания из Вашей личной, из общей или сразу из обеих медиатек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí spomienky z vašej osobnej knižnice, zdieľanej knižnice alebo z oboch knižníc."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže spomine iz osebne knjižnice, deljene knjižnice ali obeh knjižnic"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar minnen från ditt personliga bibliotek, delade bibliotek eller båda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงความทรงจำจากคลังส่วนตัวของคุณ คลังที่แชร์ หรือทั้งคู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel Arşiv’inizden, Paylaşılan Arşiv’den veya her ikisinden de Anılar gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати спогади з вашої особистої фототеки, зі спільної фототеки чи з обох."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các kỷ niệm từ Thư viện cá nhân, Thư viện được chia sẻ của bạn hoặc cả hai"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示个人图库、共享图库或这两个图库中的“回忆”"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示來自你的「個人圖庫」、「共享圖庫」或兩個圖庫的「回憶」"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示來自「個人圖庫」、「共享的圖庫」或兩個圖庫的「回憶」"
          }
        }
      }
    },
    "SaverBackdropLibraryNotSetupDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الذكريات من المكتبة الشخصية أو المكتبة المشتركة أو كلتيهما. لإعداد مكتبة مشتركة، انتقل إلى إعدادات الصور على iPhone أو iPad أو Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els records de la fototeca personal, de la compartida o de totes dues. Per crear una fototeca compartida, ves a la configuració de l’app Fotos de l’iPhone, de l’iPad del Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje vzpomínky z vaší osobní knihovny, sdílené knihovny nebo obou knihoven. Chcete‑li nastavit sdílenou knihovnu, přejděte do nastavení Fotek na iPhonu, iPadu nebo Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser minder fra dit personlige bibliotek, det delte bibliotek eller begge. Gå til indstillingerne til Fotos på din iPhone, iPad eller Mac for at oprette et delt bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit werden Rückblicke aus deiner persönlichen Mediathek, der geteilten Mediathek oder beiden angezeigt. Um eine geteilte Mediathek zu konfigurieren, öffne die Einstellungen von „Fotos“ auf deinem iPhone, iPad oder Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση αναμνήσεων από την προσωπική βιβλιοθήκη, την κοινόχρηστη βιβλιοθήκη, ή και τις δύο. Για διαμόρφωση μιας κοινόχρηστης βιβλιοθήκης, μεταβείτε στις Ρυθμίσεις των Φωτογραφιών στο iPhone, iPad ή Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library, or both. To set up a Shared Library, go to Photos settings on your iPhone, iPad, or Mac."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library or both. To set up a Shared Library, go to Photos settings on your iPhone, iPad or Mac."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Memories from your Personal Library, Shared Library, or both. To set up a Shared Library, go to Photos settings on your iPhone, iPad or Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, la fototeca compartida o ambas. Para configurar una fototeca compartida, ve a los ajustes de Fotos del iPhone, iPad o Mac."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, compartida o ambas. Para configurar una fototeca compartida, ve a la configuración de Fotos en tu iPhone, iPad o Mac."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recuerdos de tu fototeca personal, compartida o ambas. Para configurar una fototeca compartida, ve a la configuración de Fotos en tu iPhone, iPad o Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää muistoja omasta kirjastosta, jaetusta kirjastosta tai molemmista. Voit ottaa jaetun kirjaston käyttöön iPhonen, iPadin tai Macin Kuvat-asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les souvenirs de votre photothèque personnelle, de votre photothèque partagée ou des deux. Pour configurer une photothèque partagée, accédez aux réglages Photos sur votre iPhone, iPad ou Mac."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les souvenirs de votre photothèque personnelle, de la photothèque partagée ou des deux. Pour configurer une photothèque partagée, accédez aux réglages de Photos sur votre iPhone, iPad ou Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להציג זיכרונות מהספריה האישית, מהספריה המשותפת או משתיהן. כדי להגדיר ספריה משותפת, יש לעבור להגדרות ״תמונות״ ב-iPhone, ב-iPad או ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी व्यक्तिगत लाइब्रेरी, शेयर की गई लाइब्रेरी या दोनों से यादें दिखाई जाती हैं। शेयर की गई लाइब्रेरी सेटअप करने के लिए अपने iPhone, iPad या Mac पर तस्वीर सेटिंग पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje uspomene iz osobne medijateke, dijeljene medijateke ili obje. Za podešavanje dijeljene medijateke idite u postavke aplikacije Foto na iPhoneu, iPadu ili Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeket jelenít meg a személyes könyvtárából, a megosztott könyvtárából vagy mindkettőből. Megosztott könyvtár beállításához nyissa meg a Fotók beállításait az iPhone-ján, iPadjén vagy Macjén."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan Memori dari Perpustakaan Pribadi Anda, Perpustakaan Bersama, atau keduanya. Untuk mengatur Perpustakaan Bersama, buka pengaturan Foto di iPhone, iPad, atau Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i ricordi dalla libreria personale, da quella condivisa o da entrambe. Per configurare una libreria condivisa, vai alle impostazioni di Foto su iPhone, su iPad o sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人用ライブラリ、共有ライブラリ、または両方のライブラリからメモリーを表示できます。共有ライブラリを設定するには、iPhone、iPad、またはMacの“写真”設定に移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 보관함 또는 공유 보관함의 추억을 보여주거나, 두 보관함의 추억을 함께 보여줍니다. 공유 보관함을 설정하려면 iPhone, iPad 또는 Mac에서 사진 설정으로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan Memori daripada Pustaka Peribadi, Pustaka Dikongsi anda atau kedua-duanya. Untuk menyediakan Pustaka Dikongsi, pergi ke seting Foto pada iPhone, iPad atau Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser minner fra det personlige biblioteket ditt, fellesbiblioteket, eller begge. Du kan konfigurere et fellesbibliotek ved å gå til Bilder-innstillingene på iPhone, iPad eller Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont terugblikken uit je persoonlijke bibliotheek, gedeelde bibliotheek of beide. Om een gedeelde bibliotheek te configureren, ga je naar de instellingen voor Foto's op je iPhone, iPad of Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać wspomnienia tylko z biblioteki osobistej, tylko z biblioteki udostępnianej lub z obu bibliotek. Aby skonfigurować bibliotekę udostępnianą, przejdź do ustawień Zdjęć na iPhonie, iPadzie lub Macu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Memórias da sua Fototeca Pessoal, Fototeca Compartilhada ou ambas. Para configurar uma Fototeca Compartilhada, acesse os ajustes do app Fotos no iPhone, iPad ou Mac."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra recordações da sua biblioteca pessoal, biblioteca partilhada ou ambas. Pode configurar uma biblioteca partilhada nas definições da aplicação Fotografias, no iPhone, iPad ou Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați amintiri din biblioteca personală, din biblioteca partajată sau din ambele. Pentru a configura o bibliotecă partajată, accesați configurările Poze pe iPhone, iPad sau Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются воспоминания из Вашей личной, из общей или сразу из обеих медиатек. Чтобы настроить общую медиатеку, откройте настройки Фото на iPhone, iPad или Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí spomienky z vašej osobnej knižnice, zdieľanej knižnice alebo z oboch knižníc. Ak chcete nastaviť zdieľanú knižnicu, prejdite do nastavení apky Fotky na iPhone, iPade alebo Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže spomine iz osebne knjižnice, deljene knjižnice ali obeh knjižnic. Če želite nastaviti deljeno knjižnico, pojdite na nastavitve aplikacije Fotografije v iPhonu, iPadu ali Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar minnen från ditt personliga bibliotek, delade bibliotek eller båda. Öppna Bilder-inställningarna på en iPhone, iPad eller Mac om du vill skapa ett delat bibliotek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงความทรงจำจากคลังส่วนตัวของคุณ คลังที่แชร์ หรือทั้งคู่ ในการตั้งค่าคลังที่แชร์ ให้ไปที่การตั้งค่ารูปภาพบน iPhone, iPad หรือ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel Arşiv’inizden, Paylaşılan Arşiv’den veya her ikisinden de Anılar gösterir. Bir Paylaşılan Arşiv ayarlamak için iPhone’unuzda, iPad’inizde ya da Mac’inizde Fotoğraflar ayarlarına gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати спогади з вашої особистої фототеки, зі спільної фототеки чи з обох. Налаштуйте спільну фототеку в параметрах Фотографій на iPhone, iPad чи Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các kỷ niệm từ Thư viện cá nhân, Thư viện được chia sẻ của bạn hoặc cả hai. Để thiết lập Thư viện được chia sẻ, hãy đi tới cài đặt Ảnh trên iPhone, iPad hoặc máy Mac của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "显示个人图库、共享图库或这两个图库中的“回忆”。若要设置共享图库，请前往iPhone、iPad或Mac上的“照片”设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示來自你的「個人圖庫」、「共享圖庫」或兩個圖庫的「回憶」。如要設定「共享圖庫」，請前往iPhone、iPad或Mac上的「相片」設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示來自「個人圖庫」、「共享的圖庫」或兩個圖庫的「回憶」。若要設定「共享的圖庫」，請前往iPhone、iPad或Mac上的「照片」設定。"
          }
        }
      }
    },
