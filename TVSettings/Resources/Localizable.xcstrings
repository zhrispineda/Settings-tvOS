    "AccountsTapToAddSuggestedUserInstructions_WIFI": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "١.\tافتح قفل iPhone أو iPad الخاص بـ \"%@\".\n‏٢.\tاتصل بشبكة Wi-Fi.\n‏٣.\tشغل Bluetooth.\n‏٤.\tقرّب الجهاز من هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueja l’iPhone o l’iPad que fa servir %@.\n2.\tConnecta’t a una xarxa Wi‑Fi.\n3.\tActiva el Bluetooth.\n4.\tMantén el dispositiu a prop de l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdemkněte iPhone nebo iPad uživatele %@.\n2.\tPřipojte se k Wi‑Fi síti.\n3.\tZapněte Bluetooth.\n4.\tPodržte zařízení u Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås iPhone eller iPad tilhørende %@ op.\n2.\tOpret forbindelse til et Wi-Fi-netværk.\n3.\tSlå Bluetooth til.\n4.\tHold enheden tæt på dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tEntsperre das iPhone oder iPad von %@.\n2.\tStelle eine WLAN-Verbindung her.\n3.\tAktiviere Bluetooth.\n4.\tHalte das Gerät dicht an das Apple TV."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tΞεκλειδώστε το iPhone ή το iPad του χρήστη «%@».\n2.\tΣυνδεθείτε σε δίκτυο Wi-Fi.\n3.\tΕνεργοποιήστε το Bluetooth.\n4.\tΚρατήστε τη συσκευή κοντά σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock %@’s iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock %@’s iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tUnlock %@’s iPhone or iPad.\n2.\tConnect to a Wi-Fi network.\n3.\tTurn on Bluetooth.\n4.\tHold the device close to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea el iPhone o iPad de %@.\n2.\tConéctate a una red Wi‑Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea el iPhone o iPad de %@.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloquea el iPhone o iPad de %@.\n2.\tConéctate a una red Wi-Fi.\n3.\tActiva Bluetooth.\n4.\tAcerca el dispositivo a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tAvaa käyttäjän %@ iPhone tai iPad.\n2.\tYhdistä Wi‑Fi-verkkoon.\n3.\tLaita Bluetooth päälle.\n4.\tPidä laitetta Apple TV:n lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez lʼiPhone ou lʼiPad de %@.\n2.\tConnectez-vous à un réseau Wi-Fi.\n3.\tActivez le Bluetooth.\n4.\tPlacez l’appareil près de cette Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDéverrouillez l’iPhone ou l’iPad de %@.\n2.\tConnectez l’appareil à un réseau Wi‑Fi.\n3.\tActivez Bluetooth.\n4.\tTenez l’appareil à proximité de l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tיש לבטל את נעילת ה-iPhone או ה-iPad של %@.\n‏2.\tיש להתחבר לרשת אלחוטית.\n‏3.\tיש להפעיל את Bluetooth.\n‏4.\tיש להחזיק את המכשיר קרוב ל-Apple TV זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t%@ का iPhone या iPad अनलॉक करें।\n2.\tकिसी वाई-फ़ाई नेटवर्क से जुड़ें।\n3.\tBluetooth चालू करें।\n4.\tडिवाइस को इस Apple TV के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOtključajte iPhone ili iPad korisnika %@.\n2.\tSpojite se na Wi-Fi mrežu.\n3.\tUključite Bluetooth.\n4.\tDržite uređaj blizu ovog Apple TV-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOldja fel %@ iPhone-ját vagy iPadjét.\n2.\tCsatlakozzon Wi‑Fi-hálózathoz.\n3.\tKapcsolja be a Bluetootht.\n4.\tTartsa közel az eszközt az Apple TV-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka iPhone atau iPad %@.\n2.\tHubungkan ke jaringan Wi-Fi.\n3.\tNyalakan Bluetooth.\n4.\tDekatkan perangkat ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tSblocca l’iPhone o l’iPad di %@.\n2.\tConnettiti a una rete Wi‑Fi.\n3.\tAttiva il Bluetooth.\n4.\tAvvicina il dispositivo ad Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t%@さんのiPhoneまたはiPadをロック解除します。\n2.\tWi‑Fiネットワークに接続します。\n3.\tBluetoothをオンにします。\n4.\tデバイスをこのApple TVに近付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\t%@님의 iPhone 또는 iPad를 잠금 해제하십시오.\n2.\tWi-Fi 네트워크에 연결하십시오.\n3.\tBluetooth를 켜십시오.\n4.\t해당 기기를 이 Apple TV 가까이 들고 있으십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tBuka kunci iPhone atau iPad %@.\n2.\tSambung ke rangkaian Wi‑Fi.\n3.\tAktifkan Bluetooth.\n4.\tPegang peranti berdekatan Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tLås opp %@ sin iPhone eller iPad.\n2.\tKoble til et Wi‑Fi-nettverk.\n3.\tSlå på Bluetooth.\n4.\tHold enheten nær Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOntgrendel de iPhone of iPad van %@.\n2.\tMaak verbinding met een wifinetwerk.\n3.\tSchakel Bluetooth in.\n4.\tHoud het apparaat dicht bij deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tOdblokuj iPhone’a lub iPada, którego używa %@.\n2.\tPołącz się z siecią Wi‑Fi.\n3.\tWłącz Bluetooth.\n4.\tZbliż urządzenie do Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o iPhone ou iPad de %@.\n2.\tConecte-se a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tAproxime o dispositivo desta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDesbloqueie o iPhone ou iPad de %@.\n2.\tEstabeleça ligação a uma rede Wi‑Fi.\n3.\tAtive o Bluetooth.\n4.\tMantenha o dispositivo perto desta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1.\tDeblocați iPhone‑ul sau iPad‑ul utilizatorului %@.\n2.\tConectați‑l la o rețea Wi‑Fi.\n3.\tActivați Bluetooth.\n4.\tȚineți dispozitivul aproape de acest Apple TV."
