    "AXLightSensitivityDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "توفر تعديلات حساسية الضوء الدعم للمستخدمين الذين يفضلون شاشة أكثر تعتيمًا.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Els ajustos de sensibilitat a la llum són útils per als usuaris que prefereixen una pantalla més fosca.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Úpravy citlivosti na světlo poskytují podporu pro uživatele, kteří preferují tlumenější displej.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Justering af lysfølsomhed kan hjælpe brugere, som foretrækker en mørkere skærm.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Anpassungen aufgrund von Lichtempfindlichkeit für Benutzer:innen, die ein dunkleres Display bevorzugen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Οι προσαρμογές ευαισθησίας φωτός παρέχουν υποστήριξη για χρήστες που προτιμούν τον χαμηλότερο φωτισμό στην οθόνη.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Light sensitivity adjustments provide support for users who prefer a dimmer display.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Light sensitivity adjustments provide support for users who prefer a dimmer display.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Light sensitivity adjustments provide support for users who prefer a dimmer display.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Light sensitivity adjustments provide support for users who prefer a dimmer display.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Light sensitivity adjustments provide support for users who prefer a dimmer display.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Los ajustes de sensibilidad a la luz ayudan a los usuarios que prefieren una pantalla atenuada.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "El ajuste para la sensibilidad a la luz ayuda a los usuarios que prefieren menos brillo en la pantalla.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "El ajuste para la sensibilidad a la luz ayuda a los usuarios que prefieren menos brillo en la pantalla.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Valoherkkyyden säätäminen auttaa käyttäjiä, jotka pitävät himmeämmästä näytöstä.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Les utilisateurs peuvent assombrir leur écran grâce aux réglages de sensibilité à la lumière.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Les réglages de sensibilité à la lumière sont conçus pour les utilisateurs qui préfèrent un affichage moins lumineux.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "התאמות רגישות לאור מספקות תמיכה עבור משתמשים שמעדיפים תאורת צג חלשה יותר.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "प्रकाश संवेदनशीलता ऐडजस्टमेंट उन यूज़र के लिए सहायक है जिन्हें मंद डिस्प्ले पसंद है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Podešenja osjetljivosti na svjetlost pružaju podršku korisnicima koji preferiraju tamniji zaslon.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A fényérzékenység beállításai módosítási lehetőséget biztosítanak azoknak a felhasználóknak, akik tompítani szeretnék a kijelző fényerejét",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Penyesuaian sensitivitas cahaya menyediakan dukungan bagi pengguna yang lebih menyukai layar yang lebih redup.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Le regolazioni relative alla sensibilità alla luce forniscono supporto per gli utenti che preferiscono uno schermo più scuro.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "光感受性の調整は暗い画面を好むユーザへのサポートを提供します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "어두운 화면을 선호하는 사용자는 밝기 감도를 통해 조절할 수 있습니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Pelarasan kesensitifan cahaya memberi sokongan untuk pengguna yang lebih menyukai paparan lebih malap.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Gebruikers die een minder helder scherm willen, kunnen de lichtgevoeligheid aanpassen.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Justering av lysfølsomhet kan være til hjelp for brukere som foretrekker en mørkere skjerm.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Korekcje czułości świetlnej są przeznaczone dla użytkowników, którzy preferują przygaszony wyświetlacz.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Os ajustes de sensibilidade à luz oferecem suporte a usuários que preferem uma tela mais escura.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Os ajustes de sensibilidade à luz permitem aos utilizadores que preferem um ecrã menos brilhante reduzir a luminosidade.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Ajustările de sensibilitate la lumină vin în sprijinul utilizatorilor care preferă un afișaj mai întunecat.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Корректировка светочувствительности обеспечивает поддержку пользователей, предпочитающих менее яркий дисплей.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Citlivosť na svetlo ponúka podporu pre užívateľov, ktorí preferujú tmavší displej.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Prilagoditve svetlobne občutljivosti so v podporo uporabnikom, ki raje uporabljajo temnejši zaslon.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Justering av ljusstyrkan underlättar för användare som föredrar en mer nedtonad skärm.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "การปรับความไวแสงจะช่วยเหลือผู้ใช้งานที่ต้องการจอภาพที่สว่างน้อยลง",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Işık duyarlılığı ayarları, daha soluk bir ekran tercih eden kullanıcılar için destek sağlar.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Корекція світлочутливості призначена для тих, хто віддає перевагу темнішому дисплею.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Các điều chỉnh độ nhạy ánh sáng cung cấp hỗ trợ cho người dùng thích màn hình tối hơn.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "光敏度调整为偏好较暗屏幕的用户提供了支持。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "「光源敏感度」能為偏好較暗螢幕的用户提供支援。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "光敏感度調整提供給偏好較暗亮度顯示器的使用者。",
            "state": "translated"
          }
        }
      }
    },
