            "value": "This screen saver will be available after your photos have synced from iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvapantallas estará disponible cuando se terminen de sincronizar tus fotos de iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este protector de pantalla estará disponible cuando tus fotos se hayan sincronizado desde iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Este protector de pantalla estará disponible cuando tus fotos se hayan sincronizado desde iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näytönsäästäjä on käytettävissä sen jälkeen, kun kuvat on synkronoitu iCloudista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet économiseur d’écran sera disponible dès que vos photos auront été synchronisées depuis iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet économiseur d’écran sera disponible une fois que vos photos seront synchronisées avec iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר מסך זה יהיה זמין לאחר השלמת סנכרון התמונות שלך מ-iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से आपकी तस्वीरें सिंक हो जाने के बाद यह स्क्रीन सेवर उपलब्ध होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova zaštita zaslona bit će dostupna nakon što se vaše fotografije sinkroniziraju s iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a képernyővédő akkor lesz elérhető, miután a fotói szinkronizálódtak az iCloudból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghemat layar ini akan tersedia setelah foto Anda diselaraskan dari iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo salvaschermo sarà disponibile al termine della sincronizzazione delle foto da iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスクリーンセーバは、iCloudから写真が同期されたあとに使用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 사진이 동기화된 후에 이 화면 보호기를 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelamat skrin ini akan tersedia selepas foto anda diselaraskan daripada iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skjermspareren blir tilgjengelig etter at bildene dine er ferdig synkronisert fra iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schermbeveiliging is beschikbaar wanneer je foto's vanuit iCloud zijn gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wygaszacz ekranu będzie dostępny, gdy Twoje zdjęcia zostaną zsynchronizowane z iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este protetor de tela ficará disponível depois que as fotos forem sincronizadas do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta proteção de ecrã estará disponível quando terminar a sincronização das fotografias de iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest screensaver va fi disponibil după sincronizarea pozelor dvs. de pe iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта заставка будет доступна после синхронизации фото из iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento šetrič obrazovky bude k dispozícii po dokončení synchronizácie vašich fotiek z iCloudu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ohranjevalnik zaslona bo na voljo, ko bodo fotografije sinhronizirane iz storitve iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här skärmsläckaren blir tillgänglig när bilderna har synkroniserats från iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพพักหน้าจอนี้จะแสดงหลังจากที่รูปภาพของคุณเชื่อมข้อมูลจาก iCloud แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran koruyucu, fotoğraflarınız iCloud’dan eşzamanlandıktan sonra kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця екранна заставка стане доступною, коли ваші фотографії досинхронізуються з iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình bảo vệ màn hình này sẽ khả dụng sau khi ảnh của bạn được đồng bộ hóa từ iCloud."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从iCloud同步照片后，此屏幕保护程序将可用。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
