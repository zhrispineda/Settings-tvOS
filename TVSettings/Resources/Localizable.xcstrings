    "AerialAllCategoriesHiddenAlertDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إخفاء كل الفئات، ولكن ستكون شاشة توقف صورة جوية واحدة متوفرة دومًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots ocultar totes les categories, però sempre hi haurà disponible un estalvi de pantalla de vistes aèries."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt můžete všechny kategorie, ale jeden spořič s leteckými záběry bude k dispozici neustále."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan skjule alle kategorier, men en skærmskåner med luftfotos vil altid være tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst alle Kategorien ausblenden, aber ein Bildschirmschoner des Typs „Luftaufnahme“ ist immer verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να αποκρύψετε όλες τις κατηγορίες αλλά μία προφύλαξη οθόνης αεροβίντεο θα είναι πάντα διαθέσιμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hide all categories, but one Aerial screen saver will always be available."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hide all categories, but one Aerial screen saver will always be available."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hide all categories, but one Aerial screen saver will always be available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ocultar todas las categorías, pero siempre habrá un salvapantallas de vistas aéreas disponible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ocultar todas las categorías, pero siempre estará disponible un protector de pantalla de vista aérea."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ocultar todas las categorías, pero siempre estará disponible un protector de pantalla de vista aérea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kätkeä kaikki kategoriat, mutta yksi Ilmakuvat-näytönsäästäjä on aina saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez masquer toutes les catégories, toutefois une vue aérienne utilisée en tant qu’économiseur d’écran restera disponible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez masquer toutes les catégories, mais une vue aérienne sera toujours disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להסתיר את כל הקטגוריות, אך שומר מסך ״אווירי״ אחד יהיה זמין תמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सभी श्रेणियाँ छिपा सकते हैं, लेकिन एक एरियल स्क्रीन सेवर हमेशा उपलब्ध रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete sakriti sve kategorije, ali jedna zaštita zaslona “Zračna snimka” uvijek će biti dostupna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejtheti az összes kategóriát, azonban egy Légi felvétel típusú képernyővédő mindig elérhető lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menyembunyikan semua kategori, tapi satu penghemat layar Aerial akan selalu tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi nascondere tutte le categorie, ma un salvaschermo “Vista aerea” sarà sempre disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカテゴリを非表示にできますが、1個の“空撮”スクリーンセーバは常に使用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 카테고리를 가릴 수 있지만, 1개의 항공 사진 화면 보호기는 항상 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyembunyikan semua kategori, tetapi satu penyelamat skrin Udara akan sentiasa tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan skjule alle kategorier, men én Luftfoto-skjermsparer vil alltid være tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt alle categorieën verbergen, maar er is altijd één schermbeveiliging 'In vogelvlucht' beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz ukryć wszystkie kategorie, ale jeden wygaszacz Z lotu ptaka będzie zawsze dostępny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ocultar todas as categorias, mas um protetor de tela de Vistas Aéreas sempre estará disponível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ocultar todas as categorias, mas ficará sempre disponível uma proteção de ecrã Vistas aéreas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți ascunde toate categoriile, dar un screensaver „Vedere aeriană” va fi disponibil întotdeauna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно скрыть все категории, но одна аэрозаставка всегда будет видна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete skryť všetky kategórie, jeden šetrič obrazovky z kategórie Letecké zábery však vždy bude k dispozícii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrijete lahko vse kategorije, vendar bo en ohranjevalnik zaslona Posnetek iz zraka vedno na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gömma alla kategorier, men en flygfotoskärmsläckare är alltid tillgänglig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถซ่อนหมวดหมู่ทั้งหมดได้แต่จะมีหนึ่งภาพมุมสูงถูกเก็บไว้เพื่อใช้เป็นภาพพักหน้าจอเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kategorileri gizleyebilirsiniz ama bir adet Havadan ekran koruyucusu her zaman kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна сховати всі категорії, але одна екранна заставка «З повітря» завжди буде доступна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể ẩn tất cả các danh mục nhưng một trình bảo vệ màn hình Không trung sẽ luôn hiển thị."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隐藏所有类别，但始终会有一个航拍屏幕保护程序可用。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隱藏所有類別，但總是有一個「航拍」螢幕保護程式可供使用。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隱藏所有類別，但永遠會有一個「空照」螢幕保護程式可供使用。"
          }
        }
      }
    },
