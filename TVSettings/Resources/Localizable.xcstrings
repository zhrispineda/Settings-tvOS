    "AVDisplayResolutionDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيختار Apple TV أفضل دقة متاحة لتلفزيونك.\nإذا لم تجد دقة تلبي توقعاتك، فتأكد من أن Apple TV\nمتصل بمنفذ ‪HDMI 2.0‬ مدعوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV seleccionarà la gamma de colors més àmplia disponible.\nSi la resolució no és la que esperes, comprova que l’Apple TV\nestigui connectat a un port HDMI 2.0 compatible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vybere pro váš televizor nejvyšší možné rozlišení.\nPokud očekávané rozlišení nevidíte, zkontrolujte, zda je Apple TV\npřipojená k podporovanému portu HDMI 2.0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vælger den bedst tilgængelige opløsning til dit fjernsyn.\nSørg for, at Apple TV er tilsluttet en understøttet HDMI 2.0-port,\nhvis du ikke ser den opløsning, du forventede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV wählt die beste verfügbare Auflösung für dein Fernsehgerät.\nWenn du die erwartete Auflösung nicht siehst, überprüfe, ob Apple TV\nüber einen unterstützten HDMI 2.0-Anschluss mit dem Fernseher verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα επιλέξει τη βέλτιστη δυνατή ανάλυση για την τηλεόρασή σας.\nΑν δεν εμφανίζεται μια αναμενόμενη ανάλυση, βεβαιωθείτε ότι το Apple TV\nείναι συνδεδεμένο σε υποστηριζόμενη θύρα HDMI 2.0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the best available resolution for your TV.\nIf you don’t see a resolution you expect, make sure Apple TV\nis plugged into a supported HDMI 2.0 port."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the best available resolution for your TV.\nIf you don’t see a resolution you expect, make sure Apple TV\nis plugged into a supported HDMI 2.0 port."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the best available resolution for your TV.\nIf you don’t see a resolution you expect, make sure Apple TV\nis plugged into a supported HDMI 2.0 port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV seleccionará la mejor resolución disponible para tu televisor.\nSi no ves la resolución adecuada, asegúrate de que el Apple TV\nesté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV elegirá la mejor resolución para tu TV.\nSi no ves la que esperabas, asegúrate de que tu Apple TV\nesté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV elegirá la mejor resolución para tu TV.\nSi no ves la que esperabas, asegúrate de que tu Apple TV\nesté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV valitsee TV:lle parhaimman saatavilla olevan tarkkuuden.\nJos tarkkuus ei ole odotustesi mukainen, varmista, että Apple TV\non liitetty tuettuun HDMI 2.0 ‑porttiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV choisira la meilleure résolution disponible pour votre téléviseur.\nSi vous ne voyez pas la résolution attendue, assurez-vous que l’Apple TV\nest branchée à un port HDMI 2.0 compatible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV choisira la meilleure résolution disponible de votre télévision.\nSi la résolution affichée n’est pas celle attendue, vérifiez que l’Apple TV\nest connectée à un port HDMI 2.0 pris en charge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יבחר את הרזולוציה הזמינה הטובה ביותר עבור הטלוויזיה שלך.\nאם לא מצאת את הרזולוציה שחיפשת, יש לוודא שה-Apple TV\nמחובר לשקע HDMI 2.0 נתמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV आपके टीवी के लिए सर्वश्रेष्ठ उपलब्ध रिज़ॉल्यूशन चुनेगा।\nयदि आपकी आशा के अनुरूप रिज़ॉल्यूशन नहीं मिलता है, तो सुनिश्चित करें कि Apple TV\nसमर्थित HDMI 2.0 पोर्ट में प्लग इन किया गया हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV odabrat će najbolju dostupnu razlučivost za vaš TV.\nAko ne vidite razlučivost koju očekujete, provjerite je li Apple TV\nspojen na podržanu HDMI 2.0 priključnicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV ki fogja választani a televíziójához használható legjobb felbontást.\nHa nem a várt felbontást látja, akkor győződjön meg róla, hogy az Apple TV\ncsatlakoztatva van egy támogatott HDMI 2.0‑s porthoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memilih resolusi terbaik yang tersedia untuk TV Anda.\nJika Anda tidak melihat resolusi yang diinginkan, pastikan Apple TV\ndicolokkan ke port HDMI 2.0 yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sceglierà la migliore risoluzione disponibile.\nSe ritieni che la risoluzione scelta non sia adatta, assicurati che Apple TV\nsia collegata a una porta HDMI 2.0 supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVはお使いのテレビに最適の解像度を選択します。\nもし解像度が正しく設定されない場合は、Apple TVがHDMI 2.0に対応したポートに\n正しく接続されているかどうか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용자의 TV에서 볼 수 있는 최고 해상도를 선택합니다.\n원하는 해상도가 아닌 경우 Apple TV가 지원되는\nHDMI 2.0 포트에 연결되어 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memilih resolusi terbaik yang tersedia untuk TV anda.\nJika anda tidak melihat resolusi yang anda jangkakan, pastikan Apple TV\ndipasang ke port HDMI 2.0 yang disokong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil velge den beste tilgjengelige oppløsningen for TV-en din.\nHvis du ikke ser den ønskede oppløsningen, må du kontrollere at Apple TV\ner koblet til en HDMI 2.0-kontakt som støttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kiest de best beschikbare resolutie voor je tv.\nAls je een verwachte resolutie niet ziet, controleer je of Apple TV\nis aangesloten op een ondersteunde HDMI 2.0-poort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV wybierze rozdzielczość, która jest optymalna dla Twojego telewizora.\nJeśli nie widzisz oczekiwanej rozdzielczości, sprawdź, czy\nApple TV jest podłączony do zgodnego portu HDMI 2.0."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV escolherá a melhor resolução disponível para a TV.\nSe você não vir a resolução que espera, confira se a Apple TV\nestá conectada a uma porta HDMI 2.0 compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV definirá a melhor resolução disponível para a sua televisão.\nSe não vir a resolução pretendida, certifique‑se de que a Apple TV está\nligada a uma porta HDMI 2.0 compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va alege cea mai bună rezoluție disponibilă pentru televizor.\nDacă nu vedeți rezoluția la care vă așteptați, asigurați‑vă că Apple TV‑ul\neste cuplat la un port HDMI 2.0 compatibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет подобрано наиболее подходящее разрешение.\nЕсли нужный Вам вариант разрешения не отображается, убедитесь, что Apple TV\nподключен к поддерживаемому порту HDMI 2.0."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vyberie najlepšie dostupné rozlíšenie pre vaše TV.\nAk nevidíte požadované rozlíšenie, uistite sa, že je Apple TV\npripojené k podporovanému HDMI 2.0 portu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo izbral najboljšo razpoložljivo ločljivost za vaš televizor.\nČe ne vidite ločljivosti, ki jo želite, se prepričajte, da je Apple TV\npriključen v podprta vrata HDMI 2.0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV väljer den bästa tillgängliga upplösningen för din TV.\nOm du inte ser den upplösning du förväntar dig kontrollerar du att\nApple TV är ansluten till ett HDMI 2.0-uttag som stöds."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะเลือกความละเอียดที่ดีที่สุดที่มีสำหรับทีวีของคุณ\nถ้าคุณไม่เห็นความละเอียดที่คุณต้องการ ตรวจสอบให้แน่ใจว่า Apple TV\nต่ออยู่กับพอร์ต HDMI 2.0 ที่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, TV’niz için kullanılabilir en iyi çözünürlüğü seçer.\nBeklediğiniz çözünürlüğü görmezseniz Apple TV’nin\ndesteklenen HDMI 2.0 girişine takıldığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV обере найкращу роздільність, доступну для вашого телевізора.\nЯкщо очікуваної роздільності немає, перевірте, чи Apple TV\nпідʼєднано до розніму, що підтримує HDMI 2.0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ chọn độ phân giải có sẵn tốt nhất cho TV của bạn.\nNếu bạn không thấy độ phân giải mong muốn, hãy đảm bảo rằng Apple TV\nđược cắm vào cổng HDMI 2.0 được hỗ trợ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将为电视选择最佳可用分辨率。\n如果未看到期望的分辨率，请确保Apple TV\n插入支持的HDMI 2.0端口。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會為你的電視選擇最佳的可用解像度。\n如果你看不到所期望的解像度，請確保Apple TV\n已插入支援的HDMI 2.0傳輸埠。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV將會為你的電視選擇最佳的可用解析度。\n若你看不到預期的解析度，請確認Apple TV\n已插入支援的HDMI 2.0埠。"
          }
        }
      }
    },
