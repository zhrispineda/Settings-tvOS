    "RCCECPowerInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغل التحكم للتلفزيونات وأجهزة الاستقبال.\nلمعرفة كيفية التحكم في التلفزيون باستخدام ريموت، انتقل إلى:\nsupport.apple.com/appletv/home-theater"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el control per als televisors i els receptors.\nPer obtenir informació sobre com controlar el televisor amb un comandament, ves a support.apple.com/appletv/home-theater."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíná ovládání televizorů a receiverů.\nInformace o ovládání televizoru ovladačem najdete na stránce support.apple.com/appletv/home-theater."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå betjening af fjernsyn og modtagere til.\nDu kan lære at betjene dit fjernsyn med en fjernbetjening, hvis du går til support.apple.com/appletv/home-theater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere das Steuern für TV-Geräte und Empfänger.\nNäheres zum Steuern deines TV-Geräts mit einer Fernbedienung ist unter support.apple.com/appletv/home-theater erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τον έλεγχο για τηλεοράσεις και δέκτες.\nΓια να μάθετε τον τρόπο ελέγχου της τηλεόρασής σας με τηλεχειριστήριο, μεταβείτε στη διεύθυνση support.apple.com/appletv/home-theater."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on control for TVs and receivers.\nTo learn how to control your TV with a remote, go to support.apple.com/appletv/home-theater."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on control for TVs and receivers.\nTo learn how to control your TV with a remote, go to support.apple.com/appletv/home-theater"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on control for TVs and receivers.\nTo learn how to control your TV with a remote, go to support.apple.com/appletv/home-theater."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el control para televisores y receptores.\nPara obtener información sobre cómo controlar tu televisor con un mando a distancia, ve a support.apple.com/appletv/home-theater."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Control del encendido de TV y receptores.\nAprende a controlar tu TV con un control remoto en support.apple.com/appletv/home-theater."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Control del encendido de TV y receptores.\nAprende a controlar tu TV con un control remoto en support.apple.com/appletv/home-theater."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota käyttöön ohjaus TV:ille ja vastaanottimille.\nOhjeita TV:n ohjaamiseen kaukosäätimellä löydät osoitteesta support.apple.com/appletv/home-theater."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le contrôle des téléviseurs et des récepteurs.\nApprenez à contrôler votre téléviseur avec une télécommande : support.apple.com/appletv/home-theater."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le contrôle des télévisions et des récepteurs.\nPour apprendre comment contrôler votre télévision avec une télécommande, rendez-vous sur support.apple.com/appletv/home-theater."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפשרותך לשלוט במכשירי טלוויזיה ומגברים.\nפרטים נוספים בנושא שליטה בטלוויזיה באמצעות שלט זמינים בכתובת: support.apple.com/appletv/home-theater."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी और रिसीवर के लिए कंट्रोल चालू करें।\nरिमोट से अपने टीवी को नियंत्रित करने का तरीक़ा जानने के लिए support.apple.com/appletv/home-theater पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite upravljanje za TV i prijemnike.\nZa informacije o upravljanju TV‑om pomoću daljinskog upravljača posjetite support.apple.com/appletv/home-theater."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a tévék és vevőkészülékek vezérléséhez.\nA support.apple.com/appletv/home-theater weboldalon megtudhatja, hogyan vezérelheti távirányítójával a tévéjét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan kontrol untuk TV dan penerima.\nUntuk mempelajari cara mengontrol TV Anda dengan remote, buka support.apple.com/appletv/home-theater."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla TV e ricevitori.\nPer ulteriori informazioni su come controllare la TV con un telecomando, vai alla pagina support.apple.com/appletv/home-theater."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレビとレシーバーの制御をオンにします。\nリモコンでテレビを制御する方法を学習するには、support.apple.com/appletv/home-theater にアクセスしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV 및 수신기에 대한 제어를 켭니다.\n리모컨으로 TV를 제어하는 방법에 관하여 알아보려면 support.apple.com/appletv/home-theater 사이트로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan kawalan untuk TV dan penerima.\nUntuk mengetahui cara mengawal TV anda dengan kawalan jauh, pergi ke support.apple.com/en-my/HT205225."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta styringen av TV-er og forsterkere.\nLær hvordan du styrer TV-en med en fjernkontroll på support.apple.com/appletv/home-theater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bediening van tv's en ontvangers inschakelen.\nGa naar support.apple.com/appletv/home-theater voor informatie over het bedienen van je tv met een afstandsbediening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz sterowanie telewizorami i przystawkami STB.\nAby nauczyć się sterować telewizorem za pomocą pilota, przejdź do witryny support.apple.com/appletv/home-theater."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o controle para TVs e receivers.\nPara saber como controlar sua TV com um controle remoto, visite support.apple.com/appletv/home-theater"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o controlo de televisões e recetores.\nEncontrará informação adicional sobre como controlar a sua televisão com um comando, em support.apple.com/appletv/home-theater."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați controlul pentru televizoare și receivere.\nPentru a afla cum să vă controlați televizorul cu o telecomandă, accesați support.apple.com/appletv/home-theater."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите дистанционное управление для телевизоров и ресиверов.\nПодробнее об управлении телевизором с пульта: support.apple.com/appletv/home-theater."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní ovládať TV a prijímače.\nAk sa chcete dozvedieť viac o ovládaní TV pomocou ovládača, navštívte support.apple.com/appletv/home-theater."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite upravljanje za televizorje in sprejemnike.\nZa več informacij o upravljanju televizorja z daljincem pojdite na support.apple.com/appletv/home-theater."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera fjärrkontroll för TV-apparater och mottagare.\nInformation om hur du styr din TV med en fjärrkontroll hittar du på support.apple.com/appletv/home-theater."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้การควบคุมสำหรับทีวีและเครื่องรับ\nในการเรียนรู้วิธีควบคุมทีวีของคุณด้วยรีโมท ให้ไปที่ support.apple.com/appletv/home-theater"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV’lerin ve alıcıların denetimini açın.\nTV’nizi kumandayla nasıl denetleyeceğinizi öğrenmek için support.apple.com/appletv/home-theater adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть дистанційне керування для телевізорів і приймачів.\nДізнайтеся, як керувати своїм телевізором за допомогою пульта, на вебсторінці support.apple.com/appletv/home-theater."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật điều khiển cho TV và đầu thu.\nĐể tìm hiểu cách điều khiển TV bằng điều khiển từ xa, hãy truy cập support.apple.com/appletv/home-theater."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "启用对电视机和接收器的控制。\n若要了解如何使用遥控器来控制电视机，请访问support.apple.com/appletv/home-theater。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟電視及接收器的控制。\n如要了解如何使用遙控器控制電視，請瀏覽：support.apple.com/appletv/home-theater。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟電視和接收器的控制項目。\n若要瞭解如何使用遙控器來控制電視，請前往：\nsupport.apple.com/appletv/home-theater。"
          }
        }
      }
    },
