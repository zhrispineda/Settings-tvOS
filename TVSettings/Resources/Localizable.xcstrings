    "AVSurroundDolbyAtmosAvailableButDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف \"تغيير التنسيق\" لتمكين Dolby Atmos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva “Canvia el format” per activar Dolby Atmos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutím funkce Změnit formát zapnete Dolby Atmos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Skift format fra for at aktivere Dolby Atmos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere „Format ändern“, um Dolby Atmos zu aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε την «Αλλαγή μορφής» για ενεργοποίηση του Dolby Atmos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Change Format to enable Dolby Atmos."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Change Format to enable Dolby Atmos."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Change Format to enable Dolby Atmos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la opción “Cambiar formato” para activar Dolby Atmos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Cambiar formato para activar Dolby Atmos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva Cambiar formato para activar Dolby Atmos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Dolby Atmos käyttöön laittamalla ”Vaihda muotoa” pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez « Changer de format » pour activer le Dolby Atmos."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez Modifier le format pour activer Dolby Atmos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לאפשר את Dolby Atmos, יש לכבות את ״שינוי פורמט״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos सक्षम करने के लिए “फ़ॉर्मैट बदलें” बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključite opciju “Promijeni format” kako biste omogućili Dolby Atmos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dolby Atmos engedélyezéséhez kapcsolja ki a Formátum módosítása funkciót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Ubah Format untuk mengaktifkan Dolby Atmos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per abilitare la tecnologia Dolby Atmos, disattiva l’opzione “Modifica formato”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドルビーアトモスを有効にするには、“フォーマットを変更”をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos를 활성화하려면 포맷 변경을 끄십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyahaktifkan Tukar Format untuk mendayakan Dolby Atmos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av Bytt format for å aktivere Dolby Atmos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel 'Wijzig structuur' uit om Dolby Atmos in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby włączyć Dolby Atmos, wyłącz opcję Zmień format."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a opção Alterar Formato para ativar o Dolby Atmos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a opção Alterar formato para ativar Dolby Atmos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați opțiunea „Schimbare format” pentru a activa Dolby Atmos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Изменить формат», чтобы включить Dolby Atmos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete povoliť Dolby Atmos, vypnite funkciu Zmeniť formát."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopite možnost Spremeni obliko zapisa, da omogočite Dolby Atmos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av Ändra format om du vill aktivera Dolby Atmos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้เปลี่ยนรูปแบบเพื่อเปิดใช้งาน Dolby Atmos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos’u etkinleştirmek için Biçimi Değiştir’i kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть параметр «Зміна формату», щоб увімкнути Dolby Atmos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt Thay đổi định dạng để bật Dolby Atmos."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“更改格式”来启用杜比全景声。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉「更改格式」來啟用杜比全景聲。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉「更改格式」來啟用杜比全景聲。"
          }
        }
      }
    },
    "AVSurroundDolbyAtmosDisabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة ترميز الصوت بتنسيق\nيدعمه جهازك، أو استبداله بصوت استريو.\nقد يكون هذا التنسيق أكثر توافقًا، لكنه يقلل من جودة الصوت.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recodificarà l’àudio en un format\ncompatible amb l’equip o se substituirà per l’estèreo.\nPot ser que millori la compatibilitat, però es reduirà la qualitat de l’àudio.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk bude znovu kódován do formátu\npodporovaného vaším zařízením nebo nahrazen formátem stereo.\nTím se sice zlepšuje kompatibilita, ale zároveň snižuje kvalita zvuku.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd bliver omkodet til et format,\nsom dit udstyr understøtter, eller erstattes med stereo.\nDette kan være mere kompatibelt, men vil også give dårligere lydkvalitet.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird in einem Format, das deine Geräte\nunterstützen, neu codiert oder durch Stereo ersetzt.\nDies kann die Kompatibilität erhöhen, beeinträchtigt aber die Audioqualität.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος θα κωδικοποιηθεί εκ νέου σε μορφή\nπου υποστηρίζει ο εξοπλισμός σας ή θα αντικατασταθεί με στερεοφωνικό.\nΑυτό μπορεί να βελτιώσει τη συμβατότητα, αλλά θα μειώσει την ποιότητα ήχου.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se recodificará a un formato compatible\ncon tu equipo o se sustituirá por el sistema estéreo.\nLa compatibilidad será mayor, pero se reducirá la calidad del audio.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en un formato compatible con tu equipo\no se reemplazará con estéreo.\nEsto podría ser más compatible, pero reducirá la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en un formato compatible con tu equipo\no se reemplazará con estéreo.\nEsto podría ser más compatible, pero reducirá la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni koodataan uudelleen muotoon,\njota laitteesi tukee, tai korvataan stereolla.\nTämä voi olla yhteensopivampi, mutta se heikentää äänenlaatua.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé dans un format pris en charge\npar votre matériel ou remplacé par le son stéréo.\nCela peut améliorer la compatibilité, mais réduit la qualité audio.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé dans un format\npris en charge par votre équipement ou remplacé par le format stéréo.\nBien que cela améliore la compatibilité, la qualité audio en est réduite.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע יקודד מחדש לפורמט שבו\nהציוד שלך תומך, או יוחלף בסטריאו.\nהוא עשוי להיות תואם יותר, אך יפחית את איכות השמע.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो को ऐसे फ़ॉर्मैट में फिर से एनकोड किया जाएगा जिसका\nआपका उपकरण समर्थन करता है या उसे स्टीरियो से बदल दिया जाएगा।\nयह ज़्यादा संगत हो सकता है, लेकिन इसमें ऑडियो गुणवत्ता कम हो जाती है।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio će se ponovno kodirati u format\nkoji vaša oprema podržava ili zamijeniti stereo signalom.\nOvo je možda kompatibilnije, ali smanjuje kvalitetu zvuka.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang olyan formátumban lesz újrakódolva,\namelyet a berendezése támogat, vagy le lesz cserélve sztereó hangra.\nElképzelhető, hogy a kompatibilitás javul, viszont csökken a hangminőség.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodekan ulang ke format\nyang didukung perlengkapan Anda, atau diganti dengan stereo.\nIni dapat lebih kompatibel, tapi mengurangi kualitas audio.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio verrà ricodificato in un formato\nsupportato dall’impianto o sostituito con audio stereo.\nLa compatibilità potrebbe essere maggiore, ma la qualità audio sarà ridotta.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオはお使いの機器が対応しているフォーマットに再エンコードされるか、\nまたはステレオに置換されます。\nこれにより互換性は向上する場合がありますが、オーディオ品質は低下します。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 사용자의 장비에서 지원하는 포맷으로\n다시 인코딩되거나 스테레오로 대치됩니다.\n호환성이 향상될 수 있으나 오디오 음질이 저하됩니다.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodkan semula kepada format\nyang disokong oleh peralatan anda atau digantikan dengan stereo.\nIni mungkin lebih serasi, namun mengurangkan kualiti audio.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd vil bli kodet på nytt til et format som\nstøttes av utstyret ditt, eller byttes ut med stereo.\nDette kan være mer kompatibelt, men reduserer lydkvaliteten.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt opnieuw gecodeerd in een door je apparaat\nondersteunde structuur of vervangen door stereo.\nHiermee wordt de compatibiliteit mogelijk beter, maar kan ook de audiokwaliteit minder worden.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk będzie kodowany ponownie w formacie obsługiwanym\nprzez Twój sprzęt lub zastępowany dźwiękiem stereo.\nMoże to poprawić zgodność, ale obniża jakość.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado em um formato\ncompatível com o equipamento ou substituído por estéreo.\nEmbora ele fique compatível, sua qualidade será reduzida.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado com um formato\ncompatível ou substituído por estéreo.\nEsta alteração pode melhorar o nível de compatibilidade, mas reduz a qualidade do áudio.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul va fi recodat la un format\nacceptat de echipamentul dvs. sau înlocuit cu stereo.\nPoate fi mai compatibil, dar diminuează calitatea audio.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет перекодирован в формат,\nподдерживаемый Вашим аудиооборудованием, или заменен на стереозвук.\nЭто может улучшить совместимость, но приведет к снижению качества звука.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bude prekódované do formátu podporovaného\nvašou zvukovou aparatúrou alebo nahradené stereom.\nTáto možnosť poskytuje lepšiu kompatibilitu za cenu zníženej kvality zvuku.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok bo znova kodiran v obliko zapisa, ki\njo podpira vaša oprema, ali pa bo zamenjan z zvokom stereo.\nTa oblika zapisa bo morda bolj združljiva, vendar se zmanjša kakovost zvoka.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet kommer att kodas om till ett format\nsom stöds av din utrustning, eller ersättas med stereo.\nDetta kan vara mer kompatibelt, men ljudkvaliteten försämras.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกเข้ารหัสอีกครั้งเป็นรูปแบบ\nที่อุปกรณ์ของคุณรองรับ หรือถูกแทนที่ด้วยเสียงสเตอริโอ\nการทำงานนี้อาจใช้งานร่วมกันได้มากขึ้นแต่ลดคุณภาพเสียง\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, ekipmanınızın desteklediği bir biçim olarak\nyeniden kodlanır veya stereo ile değiştirilir.\nBu, daha uyumlu olabilir ama ses kalitesini düşürür.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук перекодовується в сумісний\nз обладнанням формат або замінюється на стерео.\nЦе підвищує сумісність, проте знижує якість звуку.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh sẽ được mã hóa lại thành định dạng mà\nthiết bị của bạn hỗ trợ hoặc được thay thế bằng stereo.\nĐịnh dạng này có thể tương thích hơn, nhưng làm giảm chất lượng âm thanh.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被重新编码为你设备支持的\n格式，或用立体声替代。\n兼容性可能会提高，但音频质量会降低。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將重新編碼為你設備可支援的格式，\n或以立體聲代替。\n相容性可能會提高，但會降低音訊品質。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被重新編碼為你設備支援的格式，\n或以立體聲替代。\n相容性可能會提高，但會降低音訊品質。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundDolbyAtmosEnabledDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم فك ترميز الصوت وإرساله إلى جهازك بتنسيق\n‏LPCM غير مضغوط متعدد القنوات.\nلا تغيّر التنسيقات إلا إذا كنت تواجه مشكلات في التشغيل.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es descodificarà l’àudio i s’enviarà a l’equip com a\nLPCM multicanal sense comprimir.\nNomés hauràs de canviar de format si tens cap problema amb la reproducció.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukový obsah bude dekódován a odesílán na vaše zařízení ve formátu\nnekomprimovaného vícekanálového zvuku LPCM.\nFormát změňte jen v případě, že máte potíže s přehráváním.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd bliver afkodet og sendt til dit udstyr som\nukomprimeret LPCM med multikanal.\nSkift kun format, hvis du har problemer med afspilningen.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird decodiert und als unkomprimierte\nMehrkanal-LPCM an deine Geräte gesendet.\nÄndere Formate nur, wenn Probleme beim Abspielen auftreten.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος θα αποκωδικοποιηθεί και θα σταλεί στον εξοπλισμό σας ως\nασυμπίεστο πολυκάναλο LPCM.\nΕπιλέξτε αλλαγή μορφής μόνο αν υπάρχουν ζητήματα αναπαραγωγής.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be decoded and sent to your equipment as\nuncompressed multichannel LPCM.\nOnly change formats if you’re experiencing playback problems.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be decoded and sent to your equipment as\nuncompressed multichannel LPCM.\nOnly change formats if you’re experiencing playback problems.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be decoded and sent to your equipment as\nuncompressed multichannel LPCM.\nOnly change formats if you’re experiencing playback problems.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descodificará el audio y se enviará al equipo\nen formato LPCM multicanal sin comprimir.\nConvierte el formato solo si tienes algún problema para\nreproducir el audio. Si quieres obtener más información,\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se decodificará y se enviará a tu equipo como\nLCPM multicanal sin comprimir.\nCambia de formato únicamente si tienes problemas con la reproducción.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se decodificará y se enviará a tu equipo como\nLCPM multicanal sin comprimir.\nCambia de formato únicamente si tienes problemas con la reproducción.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni puretaan ja lähetetään laitteeseesi\npakkaamattomana monikanavaisena LPCM:nä.\nVaihda muotoa vain, jos sinulla on toisto-ongelmia.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera décodé et envoyé à votre matériel au format\nLPCM multicanal sans compression.\nNe changez de format qu’en cas de problèmes de lecture.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera décodé et envoyé à votre équipement en\nformat LPCM multicanal sans compression.\nNe modifiez les formats que si vous rencontrez des problèmes de lecture.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע יפוענח ויישלח אל הציוד שלך בתור\n‏LPCM מרובה ערוצים ולא מכווץ.\nיש לשנות את הפורמט רק במקרה של בעיות בהפעלה.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो को डीकोड करके आपके उपकरण पर\nअनकंप्रेस्ड मल्टीचैनल LPCM के तौर पर भेजा जाएगा।\nफ़ॉर्मेट केवल तभी बदलें, जब आपको प्लेबैक में समस्या हो रही हो।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio će se dekodirati i poslati na vašu opremu kao\nnekomprimirani višekanalni LPCM.\nFormate biste trebali mijenjati samo ako dolazi do problema s reprodukcijom.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang dekódolva lesz, és tömörítetlen többcsatornás\nLPCM formátumban lesz elküldve a berendezésére.\nCsak akkor módosítson formátumot, ha lejátszási problémákat tapasztal.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan didekode dan dikirimkan ke perlengkapan\nAnda sebagai LPCM multisaluran yang tidak diringkas.\nHanya ubah format jika Anda mengalami masalah pemutaran.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio verrà decodificato e inviato all’impianto come\nLPCM multicanale non compresso.\nModifica il formato solo se riscontri problemi di riproduzione.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオはデコードされ非圧縮マルチチャネルLPCMとして\nお使いの機器に送信されます。\n再生に問題があるときだけフォーマットを変換してください。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 비압축 멀티채널 LPCM으로\n디코딩되어 사용자의 장비에 전송됩니다.\n재생에 문제가 있는 경우에만 포맷을 변경하십시오.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dinyahkodkan dan dihantar ke peralatan anda sebagai\nLPCM berbilang saluran yang tidak dimampatkan.\nHanya tukar format jika anda mengalami masalah dengan main balik.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd vil bli dekodet og sendt til utstyret ditt som\nukomprimert LPCM med flere kanaler.\nBytt format kun hvis du har problemer med avspillingen.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt gedecodeerd en in een ongecomprimeerde\nLPCM-structuur met meerdere kanalen naar je apparatuur verstuurd.\nWijzig structuren alleen als je afspeelproblemen ondervindt.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk będzie rozkodowywany i wysyłany do urządzeń\njako nieskompresowany, wielokanałowy LPCM.\nZmieniaj formaty tylko wtedy, gdy występują problemy z odtwarzaniem.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será decodificado e enviado ao seu equipamento como\nLPCM multicanal não comprimido.\nSó altere os formatos se você tiver problemas de reprodução.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será descodificado e enviado para o equipamento\ncomo LPCM multicanal não comprimido.\nOs formatos só devem ser alterados se for detetado algum problema com a reprodução.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul va fi decodat și trimis la echipament ca\nLCPM multicanal necomprimat.\nSchimbați formatul doar dacă întâmpinați probleme de redare.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет декодирован и отправлен на Ваше аудиооборудование\nв многоканальном формате LPCM без сжатия.\nРекомендуется менять форматы только при возникновении проблем с воспроизведением.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bude dekódované a odoslané do vašej zvukovej\naparatúry ako nekomprimované viackanálové LPCM.\nZmenu formátu používajte, len ak máte problémy s prehrávaním zvuku.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok bo dekodiran in poslan v vašo napravo kot\nnestisnjen večkanalni LPCM.\nObliko zapisa spreminjajte le, če imate težave s predvajanjem.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet avkodas och skickas till din utrustning som\nokomprimerat flerkanals-LPCM.\nÄndra format endast om du har problem med uppspelningen.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกถอดรหัสและส่งไปยังอุปกรณ์ของคุณในรูปแบบ\nLPCM แบบหลายช่องทางเสียงที่ไม่บีบอัด\nโดยจะเปลี่ยนรูปแบบเมื่อคุณประสบปัญหาการเล่นเท่านั้น\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin kodu çözülür ve sıkıştırılmamış çok kanallı LPCM olarak\nekipmanınıza gönderilir.\nOynatma sorunu yaşıyorsanız yalnızca biçimleri değiştirin.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук декодуватиметься й надсилатиметься на ваше обладнання\nяк нестиснена багатоканальна LPCM.\nЗмінюйте формати тільки за наявності проблем із відтворенням.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh sẽ được giải mã và gửi đến thiết bị của bạn dưới dạng\nLPCM đa kênh chưa nén.\nChỉ thay đổi định dạng nếu bạn đang gặp phải sự cố phát lại.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被解码并以未压缩多声道LPCM格式\n发送到你的设备上。\n请仅在播放遇到问题时考虑更改格式。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被解碼並以未壓縮多聲道LPCM格式\n傳送至你的設備。\n請只在遇到播放問題時才更改格式。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被解碼並以未壓縮多聲道LPCM格式傳送到你的\n設備。\n請僅在遇到播放問題時才更改格式。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundDolbyAtmosOff": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تجاهل Dolby Atmos وسيتم تشغيل صوت محيطي قياسي بدلاً منه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ignorarà Dolby Atmos i l’àudio es reproduirà en format envoltant estàndard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Formát Dolby Atmos bude ignorován a místo něj se použije standardní vícekanálový zvuk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos bliver ignoreret, og der afspilles standard surroundsound i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos wird ignoriert und stattdessen wird Standard-Surround-Sound wiedergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα αγνοηθεί ο ήχος Dolby Atmos και θα αναπαράγεται τυπικός ήχος surround αντ’ αυτού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos will be ignored and standard surround sound will be played instead."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos will be ignored and standard surround sound will be played instead."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos will be ignored and standard surround sound will be played instead."
          }
        },
        "es": {
