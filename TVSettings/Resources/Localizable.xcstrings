        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απολαύστε τις αγαπημένες σας φωτογραφίες, αναμνήσεις ή εξώφυλλα μουσικών άλμπουμ. Μπορείτε επίσης να τα κοινοποιήσετε από το δίκτυο οικίας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favorite photos, Memories, or Music album art. You can also share from your home network."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favourite photos, Memories or Music album art. You can also share from your home network."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favourite photos, Memories or Music album art. You can also share from your home network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos, recuerdos o ilustraciones de álbumes de música que más te gustan. También puedes compartir contenido desde tu red doméstica."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus recuerdos, fotos o ilustraciones de álbumes favoritos. También puedes compartir contenido desde tu red local."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus recuerdos, fotos o ilustraciones de álbumes favoritos. También puedes compartir contenido desde tu red local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkikuvasi, muistosi tai Musiikki-albumien kuvitus. Voit myös jakaa kotiverkostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos, souvenirs et illustrations d’albums préférés. Vous pouvez également partager du contenu à partir du réseau de votre domicile."
          }
