    "LanguageChangeRestartWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تحديث الشاشة الرئيسية عندما تغيّر لغتك."
