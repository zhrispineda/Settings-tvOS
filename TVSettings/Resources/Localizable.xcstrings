        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume will be automatically adjusted so that all songs will be played at the same volume."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume will be automatically adjusted so that all songs will be played at the same volume."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume will be automatically adjusted so that all songs will be played at the same volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se ajustará automáticamente para que todas las canciones se reproduzcan con el mismo volumen."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se ajustará automáticamente para que todas las canciones se reproduzcan al mismo volumen."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se ajustará automáticamente para que todas las canciones se reproduzcan al mismo volumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänenvoimakkuus säädetään automaattisesti, jotta kaikki kappaleet toistetaan samalla äänenvoimakkuudella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume sera ajusté automatiquement de sorte que tous les morceaux seront lus au même volume."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume sera ajusté automatiquement pour que le volume de toutes les chansons soit semblable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת השמע תותאם באופן אוטומטי כדי שכל השירים יושמעו באותה עוצמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम को ऑटोमैटिकली ऐडजस्ट किया जाएगा जिससे सभी गीत समान वॉल्यूम पर बजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnoća će se automatski prilagoditi kako bi se sve pjesme reproducirale istom glasnoćom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangerő automatikusan úgy módosul, hogy minden dal ugyanazon a hangerőn legyen lejátszva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume akan disesuaikan secara otomatis sehingga semua lagu akan diputar pada volume yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume viene regolato automaticamente affinché tutti i brani siano riprodotti allo stesso livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての曲が同じ音量で再生されるように自動的に調整されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음량이 자동으로 조절되어 모든 음악이 동일한 음량으로 재생됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelantangan akan dilaraskan secara automatik supaya semua lagu akan dimainkan pada kelantangan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumet justeres automatisk slik at alle sanger spilles med samme volumnivå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volume wordt automatisch aangepast zodat alle nummers op hetzelfde niveau worden afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie ustawiana będzie jednakowa głośność dla wszystkich utworów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume será ajustado automaticamente para que todas as músicas sejam reproduzidas no mesmo volume."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume será ajustado automaticamente para todas as músicas serem reproduzidas com o mesmo nível de volume."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul va fi ajustat automat pentru ca toate melodiile să fie redate la același nivel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость будет скорректирована автоматически, чтобы все песни воспроизводились с одинаковой громкостью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitosť sa automaticky upraví tak, aby sa všetky skladby prehrávali s rovnakou hlasitosťou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnost bo samodejno prilagojena, zato se bodo vse skladbe predvajale z enako glasnostjo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymen justeras automatiskt så att alla låtar spelas upp med samma volym."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับเสียงจะถูกปรับโดยอัตโนมัติเพื่อให้เพลงทั้งหมดเล่นด้วยระดับเสียงเท่ากัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, tüm parçalar aynı ses yüksekliğinde çalınacak şekilde otomatik olarak ayarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гучність коригуватиметься автоматично, щоб усі пісні відтворювалися з однаковим рівнем гучності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm lượng sẽ được điều chỉnh tự động sao cho tất cả các bài hát sẽ được phát ở cùng mức âm lượng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音量会自动调整，以便所有歌曲都以相同的音量播放。"
          }
        },
        "zh_HK": {
