        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um novo perfil a esta Apple TV para acessar os programas, filmes, a lista Continue Assistindo, dados de apps no iCloud e a conta do Game Center desse perfil."
