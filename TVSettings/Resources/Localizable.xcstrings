    "NLCProfilesMoreInfoDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "اضغط على تشغيل/إيقاف مؤقت لعرض المزيد من المعلومات عن ملف التعريف.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Prem el botó de reproduir i posar en pausa per obtenir més informació sobre un perfil.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Stisknutím tlačítka přehrát/pozastavit zobrazíte další informace o profilu.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Tryk på Afspil/Pause for at se flere oplysninger om en profil.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Drücke auf „Wiedergabe/Pause“, um weitere Informationen zu einem Profil zu sehen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Πατήστε «Αναπαραγωγή/Παύση» για εμφάνιση περισσότερων πληροφοριών σχετικά με ένα προφίλ.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Press Play/Pause to see more information about a profile.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Press Play/Pause to see more information about a profile.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Press Play/Pause to see more information about a profile.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Press Play/Pause to see more information about a profile.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Pulsa Reproducir/pausar para obtener más información sobre un perfil.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Presiona Reproducir/pausa para saber más sobre un perfil.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Näet lisätietoja profiilista painamalla toistopainiketta.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Appuyez sur Lire/Mettre en pause pour afficher plus d’informations sur un profil.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Appuyez sur Lecture/pause pour afficher plus d’informations sur un profil.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "יש ללחוץ על הפעלה/השהיה כדי להציג מידע נוסף על פרופיל.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "किसी प्रोफ़ाइल के बारे में अधिक जानकारी देखने के लिए “चलाएँ/पॉज़ करें” दबाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Pritisnite Reprodukciju/Pauzu za prikazivanje dodatnih informacija o profilu.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A Lejátszás/Szüneteltetés megnyomásával további információkat jeleníthet meg a profilról.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tekan Putar/Jeda untuk melihat informasi lainnya mengenai profil.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Premi Riproduci/Pausa per visualizzare ulteriori informazioni su un profilo.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "プロファイルについての詳しい情報を表示するには再生/一時停止を押します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "프로필에 관한 자세한 정보를 보려면 재생/일시 정지 버튼을 누르십시오.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tekan Main/Jeda untuk melihat maklumat lanjut tentang profil.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Druk op 'Speel af/pauzeer' om meer informatie over een profiel te zien.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Trykk på Start/pause for å se mer informasjon om en profil.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Naciśnij Odtwarzaj/Pauza, aby wyświetlić więcej informacji o profilu.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Pressione Reproduzir/Pausar para ver mais informações sobre um perfil.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Prima Reproduzir/pausar para ver mais informações sobre um perfil.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Apăsați pe butonul de redare/suspendare pentru a vedea mai multe informații despre un profil.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Чтобы просмотреть подробную информацию о профиле, нажмите кнопку воспроизведения/паузы.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Stlačením Prehrať/Pozastaviť zobrazíte viac informácií o profile.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Za več informacij o profilu pritisnite Predvajaj/Začasno ustavi.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Tryck på uppspelnings- /pausknappen för mer information om en profil.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "กดเล่น/หยุดพักเพื่อดูข้อมูลเพิ่มเติมเกี่ยวกับโปรไฟล์",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Bir profil hakkında daha fazla bilgi görmek için Çal/Durdur’a basın.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Натисніть кнопку «Відтворити/призупинити», щоб переглянути додаткову інформацію про профіль.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Nhấn Phát/Tạm dừng để xem thêm thông tin về một hồ sơ.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "按下播放/暂停查看有关描述文件的更多信息。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "按下播放/暫停以查看有關描述檔的更多資料。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "按下「播放/暫停」來查看更多描述檔的資訊。",
            "state": "translated"
          }
        }
      }
    },
