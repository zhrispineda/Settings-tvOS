    "RCPairRemoteInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الريموت عند إقران أو إلغاء اقتران أحد الأجهزة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza el comandament per enllaçar o desenllaçar un dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K spárování či zrušení spárování zařízení bude používán ovladač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug fjernbetjeningen, når du parrer eller ophæver parring af en enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Fernbedienung zum Koppeln oder Entkoppeln eines Geräts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το τηλεχειριστήριο κατά τη ζευγοποίηση ή την κατάργηση ζευγοποίησης μιας συσκευής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the remote when pairing or unpairing a device."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the remote when pairing or unpairing a device."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the remote when pairing or unpairing a device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el mando a distancia cuando enlaces o desenlaces un dispositivo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el control remoto al enlazar o desenlazar un dispositivo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el control remoto al enlazar o desenlazar un dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tai poista laitepari kaukosäätimen avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la télécommande pour jumeler ou dissocier un appareil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la télécommande pour jumeler ou dissocier un appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש בשלט במהלך קישור או ביטול קישור של מכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी डिवाइस को पेयर या अनपेयर करने के लिए रिमोट का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite upravljač za uparivanje ili rasparivanje uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszköz párosításakor vagy eltávolításakor használja a távirányítót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan remote saat memasangkan atau melepaskan perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per abbinare un dispositivo o annullare l’abbinamento, utilizza il telecomando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのペアリングを登録/登録解除するには、リモコンを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 페어링하거나 페어링 해제할 때 리모컨을 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kawalan jauh semasa memasangkan atau membatalkan berpasangan peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk fjernkontrollen for å opprette eller fjerne en sammenkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de afstandsbediening bij het koppelen of loskoppelen van een apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot umożliwia łączenie urządzeń w parę i rozłączanie takich par."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o controle remoto ao emparelhar ou desemparelhar um dispositivo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o comando para emparelhar ou desemparelhar dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizați telecomanda pentru asocierea sau disocierea unui dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте или разорвите пару с устройством с помощью пульта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri párovaní alebo rušení párovania zariadenia použite ovládač."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite daljinec, ko seznanjate napravo ali preklicujete seznanitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd fjärrkontrollen när du lägger till eller tar bort parkoppling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รีโมทเมื่อจับคู่หรือเลิกจับคู่กับอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıtı eşlerken veya eşlemesini kaldırırken kumandayı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спарюйте або вилучайте пристрої через пульт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng điều khiển từ xa khi ghép đôi và hủy ghép đôi thiết bị."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用遥控器来配对设备或取消配对。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "配對或取消配對裝置時請使用遙控器。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "配對或取消配對裝置時請使用遙控器。"
          }
        }
      }
    },
