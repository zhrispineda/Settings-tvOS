    "AVDisplayDynamicRangeDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيختار Apple TV أكبر مجموعة ألوان متاحة. إذا لم تجد خيارًا يلبي توقعاتك، فتأكد من أن Apple TV متصل بمنفذ ‪HDMI 2.0‬ مدعوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV seleccionarà la gamma de colors més àmplia disponible. Si l’opció no és la que esperes, comprova que l’Apple TV estigui connectat a un port HDMI 2.0 compatible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vybere nejširší možný barevný rozsah. Pokud očekávanou volbu nevidíte, zkontrolujte, zda je Apple TV připojená k podporovanému portu HDMI 2.0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vælger det bredeste farveudsnit, der er tilgængeligt. Sørg for, at Apple TV er tilsluttet en understøttet HDMI 2.0-port, hvis du ikke ser den valgmulighed, du forventede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV wählt den größten verfügbaren Farbbereich. Wenn du die erwartete Option nicht siehst, überprüfe, ob Apple TV über einen unterstützten HDMI 2.0-Anschluss mit dem Fernsehgerät verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV θα επιλέξει το ευρύτερο δυνατό φάσμα χρωμάτων για την τηλεόρασή σας. Αν δεν εμφανίζεται μια αναμενόμενη επιλογή, βεβαιωθείτε ότι το Apple TV είναι συνδεδεμένο σε υποστηριζόμενη θύρα HDMI 2.0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the widest color range available. If you don’t see an option you expect, make sure Apple TV is plugged into a supported HDMI 2.0 port."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the widest colour range available. If you don’t see an option you expect, make sure Apple TV is plugged into a supported HDMI 2.0 port."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV will choose the widest colour range available. If you don’t see an option you expect, make sure Apple TV is plugged into a supported HDMI 2.0 port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV seleccionará el rango cromático más amplio disponible. Si no ves la opción adecuada, asegúrate de que el Apple TV esté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV elegirá la gama de colores más amplia posible. Si no ves alguna de las opciones que esperabas, asegúrate de que tu Apple TV esté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV elegirá la gama de colores más amplia posible. Si no ves alguna de las opciones que esperabas, asegúrate de que tu Apple TV esté conectado a un puerto HDMI 2.0 compatible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV valitsee laajimman saatavilla olevan värialueen. Jos valinta ei ole odotustesi mukainen, varmista, että Apple TV on liitetty tuettuun HDMI 2.0 ‑porttiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV choisira la plus large gamme de couleurs disponible. Si vous ne voyez pas l’option attendue, assurez-vous que l’Apple TV est branchée à un port HDMI 2.0 compatible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV choisira la gamme de couleurs la plus étendue parmi les gammes disponibles. Si l’option attendue n’est pas disponible, vérifiez que l’Apple TV est connectée à un port HDMI 2.0 pris en charge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יבחר את טווח הצבעים הרחב ביותר הזמין. אם לא מצאת את האפשרות שחיפשת, יש לוודא שה-Apple TV מחובר לשקע HDMI 2.0 נתמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV व्यापकतम उपलब्ध रंगों की रेंज में से चुनेगा। यदि आपकी आशा के अनुसार विकल्प नहीं दिखाई देता है, तो सुनिश्चित करें कि Apple TV समर्थित HDMI 2.0 पोर्ट में प्लग इन किया गया हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV odabrat će najširi mogući raspon boja. Ako ne vidite opciju koju očekujete, provjerite je li Apple TV spojen na podržanu HDMI 2.0 priključnicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV ki fogja választani az elérhető legszélesebb színtartományt. Ha nem a várt lehetőséget látja, akkor győződjön meg róla, hogy az Apple TV csatlakoztatva van egy támogatott HDMI 2.0‑s porthoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memilih cakupan warna terbanyak yang tersedia. Jika Anda tidak melihat pilihan yang diinginkan, pastikan Apple TV dicolokkan ke port HDMI 2.0 yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sceglierà la più ampia gamma di colori disponibile. Se ritieni che non sia adatta, assicurati che Apple TV sia collegata a una porta HDMI 2.0 supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVは可能な限り最大の色範囲を選択します。もし、オプションが正しく表示されない場合、Apple TVがHDMI 2.0に対応したポートに正しく接続されているかどうか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 사용 가능한 최대 광역 색상 범위를 선택합니다. 원하는 옵션이 아닌 경우 Apple TV가 지원되는 HDMI 2.0 포트에 연결되어 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV akan memilih julat warna paling luas yang tersedia. Jika anda tidak melihat pilihan yang anda jangkakan, pastikan Apple TV dipasang ke port HDMI 2.0 yang disokong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vil velge det bredeste fargespekteret som er tilgjengelig. Hvis du ikke ser det ønskede valget, må du kontrollere at Apple TV er koblet til en HDMI 2.0-kontakt som støttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kiest het grootst beschikbare kleurbereik. Als je een verwachte optie niet ziet, controleer je of Apple TV is aangesloten op een ondersteunde HDMI 2.0-poort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV wybierze najszerszy dostępny zakres kolorów. Jeśli nie widzisz oczekiwanej opcji, sprawdź, czy Apple TV jest podłączony do zgodnego portu HDMI 2.0."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV escolherá a gama de cores mais ampla disponível. Se você não vir a opção que espera, confira se a Apple TV está conectada a uma porta HDMI 2.0 compatível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV definirá a maior gama de cores disponível. Se não vir a opção pretendida, certifique‑se de que a Apple TV está ligada a uma porta HDMI 2.0 compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul va alege cea mai extinsă gamă cromatică disponibilă. Dacă nu vedeți opțiunea la care vă așteptați, asigurați‑vă că Apple TV‑ul este cuplat la un port HDMI 2.0 compatibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple TV будет подобран наиболее широкий диапазон цветов из доступных. Если нужный Вам параметр не отображается, убедитесь, что Apple TV подключен через поддерживаемый порт HDMI 2.0."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vyberie najširší dostupný farebný rozsah. Ak nevidíte požadovanú možnosť, uistite sa, že je Apple TV pripojené k podporovanému HDMI 2.0 portu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bo izbral najširši barvni razpon, ki je na voljo. Če ne vidite možnosti, ki jo želite, se prepričajte, da je Apple TV priključen v podprta vrata HDMI 2.0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV väljer det bredaste färgomfånget som är tillgängligt. Om du inte ser det alternativ du förväntar dig kontrollerar du att Apple TV är ansluten till ett HDMI 2.0-uttag som stöds."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV จะเลือกช่วงสีที่กว้างที่สุดที่มี ถ้าคุณไม่เห็นตัวเลือกที่คุณต้องการ ตรวจสอบให้แน่ใจว่า Apple TV ต่ออยู่กับพอร์ต HDMI 2.0 ที่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, kullanılabilir en geniş renk aralığını seçer. Beklediğiniz seçeneği görmezseniz Apple TV’nin desteklenen HDMI 2.0 girişine takıldığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV обере найширший доступний діапазон кольорів. Якщо очікуваної опції немає, перевірте, чи підʼєднано Apple TV до розніму, що підтримує HDMI 2.0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sẽ chọn phạm vi màu rộng nhất có sẵn. Nếu bạn không thấy tùy chọn mong muốn, hãy đảm bảo rằng Apple TV được cắm vào cổng HDMI 2.0 được hỗ trợ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV将选择可用的最广色彩范围。如果未看到期望的选项，请确保Apple TV插入支持的HDMI 2.0端口。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會選擇可用的最寬顏色範圍。如果你看不到預期的選項，請確保Apple TV已插入支援的HDMI 2.0傳輸埠。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV將會選擇最寬的可用顏色範圍。若你看不到預期的選項，請確認Apple TV已插入支援的HDMI 2.0埠。"
          }
        }
      }
    },
