        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software Programı için hüküm ve koşullar şu anda mevcut değil. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Умови та положення Програми бета-тестування Apple Beta Software зараз недоступні. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các điều khoản và điều kiện cho Chương trình Apple Beta Software hiện không có sẵn. Hãy thử lại sau."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta版软件计划的条款与条件当前不可用。请稍后再试。"
