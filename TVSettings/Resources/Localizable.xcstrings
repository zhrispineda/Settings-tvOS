    "AXExtendedVoiceIsolationModesDetails": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "إضافة العزل خيار إضافي لميزة تحسين الحوار. عند استخدامه، يُعزل الحوار تمامًا للأشخاص الذين يحتاجون إلى أقصى وضوح. سيتم تقليل العناصر الأخرى من مزيج الصوت بشكل كبير.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Afegeix l’aïllament de veu com a complement de la millora dels diàlegs. Quan actives aquesta opció, s’aïlla el diàleg i els altres components de l’àudio es redueixen considerablement perquè, així, les persones que ho necessiten el rebin amb la màxima claredat.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Volba Izolovat se přidává jako další možnost k volbě Zvýraznit dialogy. Jejím zapnutím bude dialog dokonale izolován od rušivých vlivů s ohledem na osoby, které potřebují co největší srozumitelnost. Hlasitost dalších prvků audio mixu se výrazně sníží.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Tilføjer en mulighed for at isolere under Forbedring af dialog. Når denne mulighed vælges, bliver dialogen fuldstændig isoleret til gavn for personer, der har brug for maksimal tydelighed. De andre elementer i lydmikset reduceres betydeligt.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Dies fügt „Isolieren“ als zusätzliche Option zu „Dialoge verbessern“ hinzu. Bei Verwendung wird der Dialog für Personen, die maximale Verständlichkeit benötigen, vollständig isoliert. Andere Elemente der Audiomischung werden stark reduziert.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Προσθέτει την Απομόνωση ως πρόσθετη επιλογή για τη Βελτίωση διαλόγου. Όταν χρησιμοποιείται, ο διάλογος απομονώνεται πλήρως για άτομα που χρειάζονται μέγιστη καθαρότητα. Άλλα στοιχεία της μείξης ήχου θα μειώνονται σημαντικά.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Adds Isolate as an additional option to Enhance Dialogue. When used, dialogue is completely isolated for people who need maximum clarity. Other elements of the audio mix will be substantially reduced.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Adds Isolate as an additional option to Enhance Dialogue. When used, dialogue is completely isolated for people who need maximum clarity. Other elements of the audio mix will be substantially reduced.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Adds Isolate as an additional option to Enhance Dialogue. When used, dialogue is completely isolated for people who need maximum clarity. Other elements of the audio mix will be substantially reduced.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Adds Isolate as an additional option to Enhance Dialogue. When used, dialogue is completely isolated for people who need maximum clarity. Other elements of the audio mix will be substantially reduced.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Adds Isolate as an additional option to Enhance Dialogue. When used, dialogue is completely isolated for people who need maximum clarity. Other elements of the audio mix will be substantially reduced.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "El aislamiento de voz es una opción adicional de la mejora de diálogos. Permite aislar el diálogo y minimizar el resto de sonidos para poder escucharlo con más claridad.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Agrega Aislar como una opción adicional de Mejorar diálogos. Con el aislamiento, las conversaciones se vuelven más claras porque la voz se hace más nítida y los demás elementos sonoros del ambiente se reducen sensiblemente.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Agrega Aislar como una opción adicional de Mejorar diálogos. Con el aislamiento, las conversaciones se vuelven más claras porque la voz se hace más nítida y los demás elementos sonoros del ambiente se reducen sensiblemente.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Lisää Dialogin korostus -ominaisuudelle Eristä-lisävalinnan. Kun käytössä, dialogi eristetään täysin käyttäjille, jotka tarvitsevat parhaan mahdollisen selkeyden. Muita miksatun äänen elementtejä vaimennetaan huomattavasti.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Ajoute Isoler en tant qu’option supplémentaire de « Améliorer les dialogues ». Lorsque cette option est utilisée, le dialogue est totalement isolé pour les personnes qui ont besoin d’une clarté maximale. D’autres éléments du mix audio seront considérablement réduits.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "L’isolation vocale est une option supplémentaire qui a pour but d’améliorer les dialogues. Son utilisation permet d’isoler complètement les dialogues pour les personnes qui requièrent un maximum de clarté. Les autres éléments du mix audio seront considérablement réduits.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו מוסיפה הפרדת קול כאפשרות נוספת של המאפיין ״שיפור הדיבור״. כאשר אפשרות זו נבחרת, הדיבור מופרד לחלוטין ובכך מסייע לאנשים שזקוקים לצלילות שמע מרבית. מרכיבים אחרים של מיקס השמע יופחתו באופן משמעותי.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "डायलॉग बेहतर बनाएँ के अतिरिक्त विकल्प के रूप में आइसोलेट को जोड़ता है। इसका उपयोग करने पर डायलॉग को उन लोगों के लिए पूरी तरह से आइसोलेट किया जाता है जिन्हें अधिकतम स्पष्टता चाहिए। ऑडियो मिक्स के अन्य एलिमेंट को बहुत कम कर दिया जाएगा।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Dodaje Izoliraj kao dodatnu opciju za Poboljšanje dijaloga. Kad se koristi, dijalog se u potpunosti izolira za osobe kojima je potrebna maksimalna jasnoća. Ostali elementi audio miksa značajno će biti stišani.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Hozzáadja az Izolálás lehetőséget a Beszédhang kiemelése funkció további beállításaként. Amikor használatban van, teljesen izolálja a beszédet, hogy azok a személyek is hallhassák, akiknek maximális hangtisztaságra van szükségük. A funkció az audiomix egyéb elemeit jelentősen csökkenti.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Menambahkan Isolasi sebagai pilihan tambahan bagi Tingkatkan Dialog. Jika digunakan, dialog akan sepenuhnya terisolasi bagi orang yang memerlukan dialog yang paling jelas. Elemen mixing audio lainnya akan berkurang secara drastis.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Aggiunge l’opzione Isolamento a “Migliora dialoghi”. Quando è attiva, i dialoghi vengono isolati completamente per garantirne la massima chiarezza. Gli altri elementi del mix audio verranno notevolmente attenuati.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "“声を分離”を“対話を強調”のオプションとして追加します。このオプションを使用すると、対話は完全に分離され最も明瞭になります。その他のオーディオ要素に関しては大幅に減少されます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "‘분리’를 ‘대화 강조’의 옵션으로 추가합니다. 이 옵션을 사용하면 대화가 최대한 명료하게 들리기를 원하는 사람을 위해 대화 소리가 완전히 분리됩니다. 오디오 믹스의 다른 요소는 대폭 감소됩니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Menambah Asingkan sebagai pilihan tambahan pada Tingkatkan Dialog. Apabila digunakan, dialog diasingkan sepenuhnya untuk orang yang memerlukan kejelasan maksimum. Elemen lain pada campuran audio tersebut akan dikurangkan secara ketara.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Voegt 'Isoleer' als extra optie toe aan 'Verbeter dialogen'. Wanneer deze optie wordt gebruikt, wordt de dialoog volledig geïsoleerd voor personen die maximale duidelijkheid nodig hebben. Andere elementen van de audiomix worden aanzienlijk verminderd.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Legger til Isoler som et alternativ under Framhev dialog. Når dette brukes, blir dialogen isolert fullstendig for personer som trenger den så tydelig som mulig. Andre elementer i lydmiksen blir kraftig redusert.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Dodaje izolację głosu jako osobną opcję funkcji Wzmacniaj dialogi. Pozwala ona osobom wymagającym maksymalnej czystości dźwięku całkowicie izolować dialogi. Głośność innych składników materiału audio zostanie znacznie obniżona.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Adiciona o isolamento como uma opção a mais do recurso Aprimorar Diálogo. Quando usado, os diálogos são totalmente isolados para pessoas que precisam de clareza máxima. Outros elementos do mix de áudio são reduzidos substancialmente.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Adiciona o isolamento como opção adicional para Reforçar vozes. Quanto esta opção é usada, os diálogos são isolados completamente para permitir a maior clareza possível. Os outros elementos da mistura de áudio serão reduzidos significativamente.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Adaugă „Izolare” ca opțiune suplimentară pentru „Îmbunătățire dialog”. Utilizarea opțiunii permite izolarea completă a dialogurilor pentru persoanele care au nevoie de claritate maximă. Celelalte elemente ale mixajului audio vor fi reduse substanțial.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Добавление дополнительного параметра «Изоляция» для функции «Улучшение диалогов». Если этот параметр включен, диалоги отделяются от остальных звуков для максимально четкого звучания. Все остальные звуки значительно приглушаются.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Pridá ďalšiu možnosť Izolácia ku zvýrazňovaniu dialógov. Táto možnosť dokonale izoluje dialógy od rušivých vplyvov a využijú ju najmä osoby, ktoré potrebujú čo najlepšiu zrozumiteľnosť. Hlasitosť ostatných prvkov v mixe audia bude výrazne znížená.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Dodajte izolacijo kot dodatno možnost za izboljšanje dialoga. Ko je uporabljena, je dialog povsem izoliran za osebe, za katere je potrebna največja jasnost. Drugi elementi zvočne slike bodo znatno zmanjšani.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Lägger till Isolering som ett ytterligare alternativ i Framhäv dialog. När det här alternativet används isoleras dialogen fullständigt för personer som behöver maximal tydlighet. Andra element i ljudmixen minskas avsevärt.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เพิ่มการแยกเสียงเป็นตัวเลือกเพิ่มเติมเพื่อปรับเสียงสนทนาให้ชัดเจนมากขึ้น เมื่อเปิดการใช้งานนี้ เสียงสนทนาจะถูกแยกออกจากเสียงทั้งหมดสำหรับผู้ใช้ที่ต้องการเสียงที่มีความชัดเจนสูงสุด เสียงประกอบอื่นๆ จะถูกลดความดังให้เหลือน้อยที่สุด",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Diyalogları İyileştir’e ek bir seçenek olarak izolasyon ekler. Kullanıldığında, diyaloglar maksimum konuşma netliğine ihtiyacı olan kişiler için tamamen izole edilir. Ses miksinin diğer öğeleri oldukça azaltılır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Додає варіант «Ізолювати» до меню «Виокремлення діалогів». Він дає змогу повністю виокремити діалоги для користувачів, що хочуть чути слова максимально чітко. Решта звуків значно приглушується.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Thêm Tách lời nói làm một tùy chọn bổ sung cho Cải thiện hội thoại. Khi được sử dụng, phần hội thoại được tách biệt hoàn toàn đối với những người cần độ rõ tối đa. Các thành phần khác trong âm thanh tổng hợp sẽ được giảm đáng kể.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "将“分离人声”添加为“突显对话”的额外选项。使用时，对话将完全从其他声音中分离，供需要最高清晰度的用户听取。混音中的其他元素将大幅减少。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "將「隔離」加入為「突顯對白」的額外選項。啟用後，對話會被完全隔離，為有需要用户提供最高的清晰度。其他混音元素將大幅降低。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "將「隔離」加入為「突顯對白」的其他選項。若使用「隔離」，系統會為需要最高清晰度的使用者完全隔離對白。混音的其他元素會大幅度降低。",
            "state": "translated"
          }
        }
      }
    },
