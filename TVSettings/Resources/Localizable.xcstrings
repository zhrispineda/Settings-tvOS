          "stringUnit": {
            "state": "translated",
            "value": "This account is used to save data and access Apple Home and iCloud Photos. To use a different account, remove this profile from Apple TV, then add a new default profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se usa para guardar los datos y acceder a Apple Home y a las fotos en iCloud. Para usar otra cuenta, elimina este perfil del Apple TV y añade un perfil por omisión nuevo."
