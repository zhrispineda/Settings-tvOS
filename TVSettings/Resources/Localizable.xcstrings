    "AccountsUserIncomingCallsUnavailableDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بإمكان Apple TV أن يعرض لك من يتصل بك على iPhone ويسمح لك بتعليق المكالمة إلى أن تتمكن من الرد، أو الرد إذا كنت قد وصَّلت HomePods."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV et pot mostrar qui t’està trucant a l’iPhone i posar la trucada en espera fins que puguis respondre. També pots respondre des del HomePod."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple TV se může ukazovat, kdo vám volá na iPhone, a vy na ní můžete hovor přidržet, dokud ho nebudete moct přijmout. Pokud máte připojené HomePody, můžete ho na Apple TV i přijmout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Apple TV kan vise, hvem der ringer til din iPhone, og du kan sætte opkaldet på hold, indtil du kan besvare det, eller du kan besvare opkaldet, hvis du har nogen tilsluttede HomePod-enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV kann dir anzeigen, wer auf deinem iPhone anruft, und den Anruf halten, bis du antworten kannst, oder ihn annehmen, wenn HomePods verbunden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV μπορεί να εμφανίζει ποιο άτομο σάς καλεί στο iPhone σας και σας επιτρέπει είτε να θέσετε την κλήση σε αναμονή έως ότου μπορέσετε να απαντήσετε είτε να απαντήσετε στην κλήση αν έχετε συνδεδεμένα HomePod."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer or answer if you have connected HomePods."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer, or answer if you have connected HomePod speakers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV can show you who’s calling on your iPhone and let you put the call on hold until you can answer, or answer if you have connected HomePods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrar quién te llama al iPhone y poner la llamada en espera hasta que puedas contestar, o bien permitirte contestar si tienes algún HomePod conectado."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrarte quién te llama al iPhone y permitirte poner la llamada en espera hasta que puedas contestar. También puedes contestarla si tienes algún HomePod conectado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede mostrarte quién te llama al iPhone y permitirte poner la llamada en espera hasta que puedas contestar. También puedes contestarla si tienes algún HomePod conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV voi näyttää, kuka soittaa iPhoneesi, ja asettaa puhelun pitoon, kunnes voit vastata. Voit myös vastata, jos sinulla on yhdistetty HomePod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV peut vous indiquer qui appelle votre iPhone et vous permettre de mettre l’appel en attente jusqu’à ce que vous puissiez y répondre ou de répondre si vous avez connecté un HomePod."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV peut afficher qui appelle votre iPhone et vous permettre de mettre l’appel en attente ou d’y répondre si des HomePod sont connectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יכול להראות לך מי מתקשר ל-iPhone שלך ולהעביר את השיחה למצב המתנה עד שיתאפשר לך לענות בטלפון או דרך מכשירי HomePods מחוברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV आपको दिखा सकता है कि आपके iPhone पर कौन कॉल कर रहा है और जब तक आप कॉल का जवाब नहीं दे सकते हैं तब तक कॉल को होल्ड पर रखने या अगर आपके पास कनेक्टेड HomePod हैं, तो जवाब देने की सुविधा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV može prikazati dolazne pozive na vašem iPhoneu i omogućiti vam stavljanje poziva na čekanje dok se ne javite ili omogućiti javljanje ako imate spojene HomePod zvučnike."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV‑je meg tudja jeleníteni, hogy ki hívja Önt az iPhone‑ján, és lehetővé teszi, hogy Ön várakoztassa a hívást, amíg készen áll a hívás fogadására, vagy fogadja a hívást, ha HomePodok vannak csatlakoztatva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda dapat menampilkan siapa yang sedang menelepon di iPhone Anda dan memungkinkan Anda untuk menahan panggilan hingga diangkat atau mengangkatnya jika Anda telah menghubungkan HomePods."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV può mostrarti chi ti sta chiamando su iPhone e consentirti di mettere in attesa la chiamata finché non puoi rispondere, oppure di rispondere se hai connesso un HomePod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVで、iPhoneにかかってきた電話の発信元を表示し、応答するまで通話を保留にすることができます。HomePodを接続している場合は、Apple TVで直接応答することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV에서 iPhone으로 걸려오는 전화의 발신자를 확인하고, 전화를 받을 수 있는 시점까지 통화를 대기할 수 있습니다. HomePod을 연결한 경우에는 전화를 받을 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda boleh menunjukkan kepada anda pemanggil pada iPhone anda dan membolehkan anda menahan panggilan sehingga anda boleh menjawab atau menjawab jika anda mempunyai HomePod bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-en din kan vise deg hvem som ringer til iPhonen din, og la deg sette samtalen på vent til du kan svare eller svare hvis du har tilkoblede HomePoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV kan je laten zien door wie je op je iPhone wordt gebeld en kan het gesprek in de wacht plaatsen totdat je de oproep kunt beantwoorden of het gesprek beantwoorden als je HomePods hebt gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV może pokazywać połączenia przychodzące na Twojego iPhone’a i wstrzymywać je, aby dać Ci czas na odebranie ich na telefonie lub na połączonych HomePodach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode mostrar quem está ligando para o seu iPhone e permitir que você mantenha a ligação em espera até que possa atender, ou permitir que você atenda se tiver HomePods conectados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode mostrar quem está a ligar para o seu iPhone e permitir‑lhe colocar a chamada em espera até que a possa atender, ou pode atender a chamada se tiver HomePods ligados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul poate afișa cine vă apelează pe iPhone și vă poate permite să rețineți apelul până când puteți răspunde sau să răspundeți dacă aveți HomePod‑uri conectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если подключить устройства HomePod к Apple TV, на нем можно будет просматривать уведомления о входящих вызовах на iPhone, отвечать на них или ставить на удержание, когда нет возможности ответить сразу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vám niekto volá na iPhone, Apple TV môže zobraziť volajúceho a umožní vám hovor podržať, kým sa nedostanete k telefónu, prípadne prijať hovor na pripojenom HomePode."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Apple TV-ju je lahko prikazano, čigav klic ste prejeli v iPhone, pri čemer lahko klic postavite na čakanje, dokler ga ne morete sprejeti, ali pa ga sprejmete, če imate povezane zvočnike HomePod."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan visa vem som ringer till iPhone och låta dig parkera samtalet tills du kan svara, eller så kan du svara om du har anslutna HomePod-enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณสามารถแสดงให้คุณดูได้ว่าใครกำลังโทรมาบน iPhone ของคุณและช่วยให้คุณพักสายไว้จนกว่าคุณจะสามารถรับสายได้หรือรับสายหากคุณมี HomePod ที่เชื่อมต่ออยู่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz, iPhone’unuzda kimin aradığını gösterip yanıtlayabileceğiniz zamana kadar aramayı beklemeye almanızı veya bağlı HomePod’larınız varsa yanıtlamanızı sağlayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV може показувати, хто телефонує вам на iPhone, і давати змогу призупиняти виклик, доки ви не зможете відповісти, або відповідати, якщо підʼєднано HomePod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV có thể hiển thị ai đang gọi đến iPhone của bạn và cho phép bạn giữ cuộc gọi đến khi có thể trả lời hoặc trả lời nếu bạn đã kết nối các HomePod."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可显示iPhone上的来电者，并保留通话直至你方便接听，或在已连接的HomePod上接听。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV可以顯示iPhone上的來電者，並讓你保留通話直到你可以接聽，或在已連接的HomePod上接聽。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV可以顯示iPhone上的來電者，並讓你在可接聽前保留通話，或在有已連接的HomePods時接聽。"
          }
        }
      }
    },
