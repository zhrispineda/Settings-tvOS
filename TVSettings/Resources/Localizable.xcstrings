    "DictationDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل الإملاء معلومات، مثل إدخال الصوت والموقع، إلى Apple بهدف معالجة الطلبات. ولن يتم إرسال إدخال الصوت من تهجئة إملاء أسماء المستخدمين أو كلمات السر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictat envia informació a Apple, com ara les ordres de veu i la ubicació, per processar les sol·licituds. No s’enviarà cap nom ni cap contrasenya que dictis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování odesílá informace, jako je váš hlasový vstup a údaje o poloze, společnosti Apple ke zpracování požadavků. Hlasový vstup obsahující hláskování uživatelských jmen a hesel se neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering sender oplysninger om f.eks. taleinput og lokalitet til Apple til behandling af dine anmodninger. Når du staver til brugernavne og adgangskoder vha. diktering, sendes din tale ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diktierfunktion sendet Informationen wie gesprochene Eingaben und Standortdaten an Apple, um deine Anfragen zu bearbeiten. Spracheingaben wie buchstabierte Benutzernamen und Passwörter werden nicht gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Υπαγόρευση στέλνει στην Apple πληροφορίες, όπως δεδομένα φωνητικής εισόδου και την τοποθεσία σας, για επεξεργασία αιτημάτων. Δεν αποστέλλονται δεδομένα φωνητικής εισόδου από υπαγόρευση συλλαβισμού ονομάτων χρηστών και συνθηματικών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of user names and passwords won’t be sent."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of usernames and passwords won’t be sent."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation sends information, such as voice input and location, to Apple to process requests. Voice input from spelling dictation of usernames and passwords won’t be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado envía información (como la voz o la ubicación) a Apple para procesar las peticiones. Los nombres y contraseñas que dictes no se enviarán."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado envía información a Apple, como el registro de tu voz y tu ubicación, para procesar solicitudes. Tu voz proveniente del dictado de nombres de usuario y contraseñas no se enviará."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado envía información a Apple, como el registro de tu voz y tu ubicación, para procesar solicitudes. Tu voz proveniente del dictado de nombres de usuario y contraseñas no se enviará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu lähettää tietoja, kuten puhesyötteesi ja sijaintisi, Applelle pyyntöjesi käsittelyä varten. Puhesyötettä kirjaimittain sanelluista käyttäjätunnuksista ja salasanoista ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictée envoie des informations telles que votre voix et votre position géographique à Apple afin de traiter vos requêtes. Les noms d’utilisateur et mots de passe dictés ne sont pas envoyés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictée envoie des informations à Apple, comme les contenus vocaux et votre position, pour traiter vos demandes. Les contenus vocaux correspondant aux noms d’utilisateurs et aux mots de passe ne sont pas envoyés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאפיין ״הכתבה״ שולח ל-Apple נתונים כגון קלט קולי ופרטי מיקום לצורך עיבוד הבקשות שלך. קלט קולי מהכתבת איות של שמות משתמשים וסיסמאות לא יישלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिक्टेशन अनुरोधों को प्रोसेस करने के लिए आपके वॉइस इनपुट और स्थान जैसी जानकारी Apple को भेजता है। यूज़रनेम और पासवर्ड की वर्तनी के डिक्टेशन का वॉइस इनपुट नहीं भेजा जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat šalje Appleu informacije poput vašeg glasovnog unosa i lokacije kako bi obradio vaše zahtjeve. Glasovni unosi slovkanja korisničkih imena i lozinki neće biti poslani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Diktálás információkat küld az Apple-nek a kérelmek feldolgozásához, például a hangbevitelt és a helyzetet. A felhasználónevek és jelszavak betűzéséhez használt hangbevitel nem lesz elküldve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte mengirimkan informasi, seperti input suara dan lokasi, ke Apple untuk memproses permintaan. Input suara dari dikte ejaan nama pengguna dan kata sandi tidak akan dikirimkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettatura invia informazioni come l’input vocale e la posizione in cui ti trovi ad Apple per elaborare le richieste. L’input vocale per la dettatura dei nomi utente e delle password non verrà inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力を使用すると、リクエストを処理するために、音声入力の内容や位置情報などの情報がAppleに送信されます。ユーザ名およびパスワードのスペルを音声入力したときは内容が送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 사용자의 요청을 처리하기 위해 음성 입력과 위치 등의 정보를 Apple에 보냅니다. 사용자 이름 및 암호의 철자를 받아쓰기한 음성 입력은 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perencanaan menghantar maklumat, seperti input suara dan lokasi, kepada Apple untuk memproses permintaan. Input suara daripada perencanaan ejaan nama pengguna dan kata laluan tidak akan dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering sender informasjon som taleinndata og posisjon til Apple for å behandle forespørsler. Taleinndata med staving av brukernavn og passord sendes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dicteerfunctie stuurt gegevens, zoals steminvoer en locatie, naar Apple om verzoeken te verwerken. Steminvoer voor het spellen van gebruikersnamen en wachtwoorden wordt niet verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wysyła informacje, np. Twoje polecenia głosowe i położenie, do Apple w celu ich przetworzenia. Literowane nazwy użytkownika i hasła nie są wysyłane."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ditado envia dados como a sua voz, contatos e localizações à Apple para processar seus pedidos. Dados de voz que contêm nomes de usuário e senhas não são enviados."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A funcionalidade Ditado envia à Apple informação, como dados de voz e localização, para processar os seus pedidos. Não são enviados dados de voz relacionados com o ditado de nomes de utilizadores e palavras‑passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea trimite la Apple informații, precum comenzile vocale și localizarea dvs., pentru procesarea solicitărilor. Comenzile vocale rezultate din dictarea pe litere a numelor de utilizator și a parolelor nu vor fi trimise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обработки запросов Диктовка отправляет в Apple такую информацию, как голосовой ввод и геопозиция. Надиктованные данные, такие как имена пользователей и пароли, не отправляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvôli spracovaniu žiadostí odosiela Diktovanie do Apple rôzne informácie, napríklad váš hlasový vstup a polohu. Hlasový vstup pri diktovaní pravopisu užívateľských mien a hesiel sa nebude odosielať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcija Narekovanje družbi Apple pošilja podatke, kot so vaš glasovni vnos in lokacija, da lahko obdela vaše zahteve. Glasovni vnos ob narekovanju črkovanja uporabniških imen in gesel ne bo poslan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering skickar information, till exempel din röstinmatning och din plats till Apple för att kunna behandla förfrågningar. Röstinmatning från stavningsdiktering av användarnamn och lösenord skickas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การป้อนตามคำบอกจะส่งข้อมูล เช่น คำพูดและตำแหน่งที่ตั้ง ไปที่ Apple เพื่อดำเนินการตามคำขอ ชื่อผู้ใช้และรหัสผ่านที่คุณพูดเมื่อป้อนตามคำบอกจะไม่ถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte, isteklerinizi işlemek için ses girişleriniz ve konumunuz gibi bilgileri Apple’a gönderir. Kullanıcı adı ve parola dikte ederken hecelenen ses girişleri gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктування надсилає до Apple дані, як‑от голосовий ввід і геопозицію, для опрацювання ваших запитів. Голосові дані посимвольного вводу облікових імен і паролів не надсилаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả gửi thông tin như dữ liệu đầu vào bằng giọng nói và vị trí đến Apple để xử lý các yêu cầu. Dữ liệu đầu vào bằng giọng nói từ đọc chính tả đánh vần tên người dùng và mật khẩu của bạn sẽ không được gửi."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“听写”会将语音输入和位置等信息发送到Apple以处理请求。拼写用户名和密码的语音输入将不会发送。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「聽寫」會將資料（例如語音輸入及位置等）傳送至Apple以處理要求。傳送的資料不會包括串字聽寫用户名稱及密碼的語音輸入。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「聽寫」會將語音輸入和位置等資訊傳送給Apple來處理要求。不會傳送使用者名稱和密碼的拼字聽寫語音輸入。"
          }
        }
      }
    },
    "DictationDisableWarningMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعلومات التي يستخدمها Siri للاستجابة لطلباتك سيتم أيضًا استخدامها للإملاء، وسيتم إبقاؤها على خوادم Apple إلا إذا تم إيقاف Siri أيضًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La informació que Siri utilitza per donar resposta a les teves sol·licituds també s’utilitza per al dictat i es conservarà als servidors d’Apple a menys que també desactivis Siri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, která Siri používá k odpovědím na vaše žádosti, jsou také využívána pro Diktování a budou nadále uložena na serverech společnosti Apple (pokud také nevypnete Siri)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De oplysninger, som Siri bruger til at besvare dine anmodninger, bruges også til diktering og forbliver på Apples servere, medmindre Siri også slås fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von Siri zum Antworten auf Anfragen verwendeten Informationen werden auch von der Diktierfunktion verwendet und bleiben auf den Apple-Servern, es sei denn, Siri ist ebenfalls deaktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πληροφορίες που χρησιμοποιεί το Siri για να αποκρίνεται στα αιτήματά σας χρησιμοποιούνται επίσης για την Υπαγόρευση και θα παραμείνουν στους διακομιστές της Apple μέχρι να απενεργοποιηθεί το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Siri is also turned off."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Siri is also turned off."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The information Siri uses to respond to your requests is also used for Dictation and will remain on Apple servers unless Siri is also turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado también utiliza la información que usa Siri para responder a tus solicitudes, por lo que esta permanece en los servidores de Apple a menos que se desactive Siri."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado usa la misma información que usa Siri para responder a tus peticiones, por lo que esta se conservará en los servidores de Apple, salvo que también desactives Siri."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictado usa la misma información que usa Siri para responder a tus peticiones, por lo que esta se conservará en los servidores de Apple, salvo que también desactives Siri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja, joita Siri käyttää vastatessaan pyyntöihisi, käytetään myös sanelua varten. Tiedot säilyvät Applen palvelimilla ellet laita myös Siriä pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations utilisées par Siri pour répondre à vos requêtes sont également utilisées pour Dictée et resteront sur les serveurs Apple sauf si Siri est aussi désactivé."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations utilisées par Siri pour répondre à vos requêtes sont également utilisées par Dictée et sont conservées sur les serveurs d’Apple, à moins que Siri ne soit désactivé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המידע שמשמש את Siri כדי להגיב לבקשות שלך משמש גם את המאפיין ״הכתבה״ ונשאר בשרתים של Apple, אלא אם כן כיבית גם את Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अनुरोधों का उत्तर देने के लिए Siri द्वारा जिस जानकारी का उपयोग किया जाता है, उसी का उपयोग डिक्टेशन के लिए भी किया जाता है और वह जानकारी Siri के बंद किए जाने तक Apple के सर्वर पर उपलब्ध रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacije koje Siri koristi za odgovaranje na vaše zahtjeve također se koriste za Diktat i zadržat će se na Appleovim serverima osim ako ne isključite i Siri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az az információ, amelyet Siri használ a kérések megválaszolására, szintén fel lesz használva a Diktáláshoz, és az Apple szerverein marad, hacsak Sirit ki nem kapcsolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi yang digunakan Siri untuk merespons permintaan Anda juga digunakan untuk Dikte dan akan tetap berada di server Apple kecuali jika Siri dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni utilizzate da Siri per rispondere alle tue richieste sono usate anche per Dettatura e rimarranno sui server di Apple a meno che non disabiliti anche Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriがユーザのリクエストに応じる際に参照する情報は音声入力でも使用され、Siriもオフになっている場合を除き、Appleサーバからは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri가 사용자의 요청에 응답하기 위해 사용하는 정보는 받아쓰기에서도 사용되며 Siri가 꺼져 있지 않는 한 Apple 서버에 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat yang digunakan oleh Siri untuk membalas permintaan anda turut digunakan untuk Perencanaan dan akan kekal pada pelayan Apple melainkan Siri turut dinyahaktifkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasjonen Siri bruker til å svare på forespørslene dine, brukes også til diktering, og den blir værende på Apples tjenere med mindre Siri også slås av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De informatie die Siri gebruikt om te reageren op je verzoeken wordt ook gebruikt voor de dicteerfunctie en blijft aanwezig op de Apple servers tenzij Siri ook wordt uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje, których Siri używa do przetwarzania Twoich poleceń, są także używane przez funkcję dyktowania i pozostaną na serwerach Apple, o ile nie wyłączysz Siri."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações usadas pela Siri para responder a seus pedidos também são usadas para o Ditado e permanecerão nos servidores da Apple, a menos que o Ditado também seja desativado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A informação usada por Siri para responder aos seus pedidos é igualmente utilizada pela funcionalidade Ditado e permanecerá nos servidores da Apple, a menos que também desative Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informațiile utilizate de Siri pentru a răspunde solicitărilor dvs. sunt utilizate și pentru dictare și vor rămâne pe serverele Apple, cu excepția cazului în care dezactivați și Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация, используемая Siri для ответов на Ваши запросы, также используется для Диктовки и будет храниться на серверах Apple, пока функция Siri также не будет выключена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Informácie, ktoré Siri používa na spracovanie vašich žiadostí, používa aj Diktovanie a zostanú na serveroch Apple, kým nebude vypnutá aj služba Siri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki, ki jih Siri uporablja za odgovarjanje na vaše zahteve, se uporabljajo tudi za funkcijo Narekovanje in bodo ostali v strežnikih Apple, razen če izklopite tudi Siri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationen som Siri använder till att utföra dina instruktioner används även av diktering och kommer att finnas kvar på Apples servrar om inte Siri också stängs av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่ Siri ใช้เพื่อตอบสนองต่อคำขอของคุณจะถูกใช้สำหรับการป้อนตามคำบอกด้วย และจะอยู่บนเซิร์ฟเวอร์ของ Apple นอกจากจะปิดใช้งาน Siri ด้วยเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri’nin isteklerinize yanıt vermek için kullandığı bilgiler Dikte için de kullanılır ve Siri kapatılmadığı sürece de Apple sunucularında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація, яку Siri використовує, щоб відповідати на ваші запити, також використовується для Диктування і лишатиметься на серверах Apple, доки Siri не вимкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin mà Siri sử dụng để đáp ứng yêu cầu của bạn cũng được sử dụng cho Đọc chính tả và sẽ vẫn ở trên máy chủ của Apple trừ khi Siri cũng bị tắt."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri用于回应你请求所用的信息也会用于“听写”，除非也同时关闭Siri，否则这些信息将保留在Apple服务器上。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri用作回應你要求的資料亦同時用於「聽寫」。除非Siri被關上，否則該資料將繼續保留在Apple的伺服器上。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri回應你要求時所用的資訊也會用在「聽寫」，除非關閉Siri，否則此資訊都會保留在Apple伺服器中。"
          }
        }
      }
    },
