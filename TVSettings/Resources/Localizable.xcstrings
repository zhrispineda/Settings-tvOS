    "NetworkTestItemDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا ظهر أن البث أو التنزيل بطيء، فقم بإجراء اختبار لمساعدة Apple في العثور على أي مشاكل محتملة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la reproducció o la descàrrega van lentes, pots executar una prova per ajudar Apple a trobar possibles problemes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se streamování nebo stahování zdá být pomalé, spusťte test, který společnosti Apple umožní zjistit případné problémy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis streaming eller overførsel virker langsom, kan du afvikle en test, der hjælper Apple med at finde eventuelle problemer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Streaming- oder Ladevorgänge langsam erscheinen, starte einen Test, um Apple bei der Diagnose möglicher Probleme zu unterstützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν η αναπαραγωγή ροής ή η λήψη φαίνεται αργή, εκτελέστε μια δοκιμή που θα βοηθήσει την Apple να εντοπίσει πιθανά ζητήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If streaming or downloading appears slow, run a test to help Apple find any potential issues."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If streaming or downloading appears slow, run a test to help Apple find any potential issues."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If streaming or downloading appears slow, run a test to help Apple find any potential issues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la transmisión o la descarga son lentas, puedes ejecutar una prueba para que Apple detecte posibles problemas."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la transmisión o descarga es lenta, realiza una prueba para ayudar a que Apple averigüe si hay un problema."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la transmisión o descarga es lenta, realiza una prueba para ayudar a que Apple averigüe si hay un problema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos striimaus tai lataaminen tuntuu hitaalta, suorita testi, jotta Apple löytäisi mahdolliset ongelmat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la diffusion de contenu ou le téléchargement vous paraissent lents, effectuez un test pour aider Apple à identifier un problème éventuel."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la diffusion ou les téléchargements semblent lents, effectuez un test pour permettre à Apple d’identifier les problèmes potentiels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ההזרמה או ההורדה נראית לך איטית, באפשרותך להפעיל בדיקה כדי לעזור ל-Apple למצוא בעיות פוטנציאליות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि स्ट्रीमिंग या डाउनलोडिंग धीमी गति से हो रही है, तो Apple को संभावित समस्याओं का पता लगाने में मदद करने के लिए जाँच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako su streaming ili preuzimanje spori, pokrenite test koji će pomoći Appleu u otkrivanju problema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a streaming vagy a letöltés lassúnak tűnik, egy teszt futtatásával segíthet az Apple-nek az esetleges problémák meghatározásában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda merasa streaming atau pengunduhan lambat, jalankan tes untuk membantu Apple menemukan masalah yang mungkin ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se noti un rallentamento del download o dello streaming, puoi eseguire un test per consentire ad Apple di riscontrare gli eventuali problemi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングまたはダウンロードが遅いと感じた場合は、テストを実行することによりAppleが潜在的な問題を発見するのにご協力いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍 또는 다운로드 속도가 느리게 느껴질 경우 테스트를 실행하면 Apple에서 문제를 찾는 데 도움이 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika penstriman atau muat turun didapati perlahan, jalankan ujian untuk membantu Apple mencari sebarang potensi isu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis strømming eller nedlasting går tregt, kan du kjøre en test for å hjelpe Apple med å finne årsaken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het streamen of downloaden erg traag is, kun je een test uitvoeren om Apple te helpen bij het opsporen van eventuele problemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli przesyłanie strumieniowe lub pobieranie działa wolno, uruchom test, aby pomóc Apple wykryć potencjalne problemy."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a velocidade de transmissões ou downloads estiver lenta, execute um teste para ajudar a Apple a identificar problemas em potencial."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a velocidade de streaming ou descarga lhe parece lenta, pode fazer um teste para ajudar a Apple a identificar eventuais problemas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă difuzarea în flux sau descărcarea pare lentă, rulați un test care să ajute la identificarea potențialelor probleme de către Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Вам кажется, что стриминг или загрузка идут медленно, запустите проверку, чтобы помочь Apple выяснить причины."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je streamovanie alebo sťahovanie pomalé, spustite test, ktorý pomôže spoločnosti Apple odhaliť potenciálne problémy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če se pretakanje ali prenašanje zdi počasno, zaženite preizkus, ki bo družbi Apple pomagal najti morebitne težave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det verkar som om det går långsamt att streama eller hämta kan du köra ett test som hjälper Apple att hitta eventuella problem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าการสตรีมหรือการดาวน์โหลดช้า ให้เรียกใช้การทดสอบเพื่อช่วย Apple ค้นหาปัญหาที่เกิดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın veya indirme yavaş gibiyse, Apple’ın olası sorunları bulmasına yardımcı olmak üzere bir sınama yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо транслювання чи викачування видаються повільними, виконайте тестування, щоб допомогти Apple виявити потенційні проблеми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu quá trình phát hoặc tải về diễn ra chậm, hãy chạy kiểm tra để giúp Apple tìm bất kỳ sự cố tiềm ẩn nào."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如果流化或下载速度太慢，请运行测试来帮助Apple查找潜在问题。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如串流或下載速度緩慢，你可以執行測試以協助Apple判別任何問題。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果連續播送或下載的速度變慢，請執行測試以協助Apple找出任何可能的問題。"
          }
        }
      }
    },
