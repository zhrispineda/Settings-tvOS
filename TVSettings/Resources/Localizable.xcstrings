    "APPreferCloudAutoInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتشغيل وسيحاول Apple TV تشغيل مشترياتك من iCloud بدلاً من جهاز البث السريع الخاص بك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa aquesta opció i l’Apple TV provarà de reproduir les compres des de l’iCloud en comptes de fer‑ho des del dispositiu AirPlay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV bude přehrávat zakoupené položky z iCloudu namísto přehrávání z vašeho AirPlay zařízení, kdykoli to bude možné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå funktionen til, hvorefter Apple TV vil prøve at afspille dine køb fra iCloud i stedet for fra din AirPlay-enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eingeschaltet, wird das Apple TV versuchen, deine Käufe über iCloud statt vom AirPlay-Gerät wiederzugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ενεργοποιήσετε αυτήν τη ρύθμιση, το Apple TV, αντί της συσκευής AirPlay σας, θα προσπαθήσει να αναπαράγει τις αγορές σας από το iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on and Apple TV will try to play your purchases from iCloud instead of your AirPlay device."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on and Apple TV will try to play your purchases from iCloud instead of your AirPlay device."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on and Apple TV will try to play your purchases from iCloud instead of your AirPlay device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activas esta opción, el Apple TV intentará reproducir tus compras desde iCloud en vez de desde el dispositivo AirPlay."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa esta opción y el Apple TV intentará reproducir tus compras desde iCloud en lugar del contenido de tu dispositivo AirPlay."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa esta opción y el Apple TV intentará reproducir tus compras desde iCloud en lugar del contenido de tu dispositivo AirPlay."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tämä on päällä, Apple TV yrittää toistaa ostojasi iCloudista AirPlay-laitteen sijasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option et l’Apple TV essaiera de lire vos achats depuis iCloud et non depuis votre appareil AirPlay."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option, et Apple TV essaiera de lire vos achats à partir d’iCloud plutôt qu’à partir de votre appareil AirPlay."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל אפשרות זו כדי שה-Apple TV ינסה להפעיל תכנים שרכשת ישר מתוך iCloud במקום מהמכשיר המחובר ב-AirPlay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करने पर Apple TV द्वारा आपके AirPlay डिवाइस के स्थान पर iCloud से ख़रीदे गए कॉन्टेंट को चलाने की कोशिश की जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je ova opcija uključena, Apple TV će kupljene stavke pokušati reproducirati s iClouda umjesto s vašeg AirPlay uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be, és az Apple TV megpróbálja az iCloudból lejátszani a vásárolt tartalmakat, az AirPlay-eszköz helyett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan dan Apple TV akan mencoba memutar pembelian Anda dari iCloud alih-alih dari perangkat AirPlay Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’opzione e Apple TV non riprodurrà i tuoi acquisti tramite il tuo dispositivo AirPlay, ma utilizzerà iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、AirPlayデバイスからではなくiCloudから購入した項目を再生しようとします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 켜면 Apple TV가 AirPlay 기기 대신 iCloud로부터 구입 항목을 재생합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan dan Apple TV akan cuba memainkan pembelian anda daripada iCloud berbanding peranti AirPlay anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når innstillingen er på, vil Apple TV prøve å spille av kjøp fra iCloud i stedet for fra AirPlay-enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je dit inschakelt, probeert Apple TV je aankopen af te spelen vanaf iCloud in plaats van je AirPlay-apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy opcja jest włączona, Apple TV próbuje odtwarzać zakupy z iCloud zamiast z urządzenia AirPlay."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para que a Apple TV tente reproduzir suas compras do iCloud ao invés do seu dispositivo AirPlay."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção e a Apple TV tentará reproduzir as suas compras a partir de iCloud em vez de a partir do dispositivo AirPlay."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați opțiunea, iar Apple TV‑ul va încerca să redea cumpărăturile dvs. de pe iCloud în locul dispozitivului dvs. AirPlay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если этот параметр включен, на Apple TV будет выполнена попытка воспроизведения покупок из iCloud, а не с устройства AirPlay."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV sa pokúsi prehrať zakúpené položky z iCloudu namiesto vášho AirPlay zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob vklopu bo Apple TV poskusil predvajati vaše nakupe prek storitve iCloud, namesto da bi se predvajali prek naprave s funkcijo AirPlay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du aktiverar det här alternativet försöker Apple TV spela upp dina inköp från iCloud istället för från AirPlay-enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้ แล้ว Apple TV จะพยายามเล่นสินค้าที่คุณซื้อจาก iCloud แทนที่จะเล่นจากอุปกรณ์ AirPlay ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçeneği açtığınızda Apple TV, satın alınanları AirPlay aygıtınız yerine iCloud’dan oynatmaya çalışacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть цю опцію і Apple TV буде намагатися відтворювати ваші покупки з iCloud замість пристрою AirPlay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật và Apple TV sẽ cố gắng phát nội dung mua của bạn từ iCloud thay vì thiết bị AirPlay của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后Apple TV将尝试播放iCloud中的已购项目，而非隔空播放设备。"
