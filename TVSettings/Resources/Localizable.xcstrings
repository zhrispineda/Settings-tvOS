    "DevelopmentOverridesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تكوين التجاوزات لتطبيقات الاختبار التي تستخدم \"أصول الخلفية المُدارة\".",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Configura les invalidacions de les apps de proves que fan servir els recursos gestionats en segon pla.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Konfigurace přepisů hodnot pro testování aplikací, které využívají spravovaná data na pozadí.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Konfigurer tilsidesættelser til test af apps, der bruger administrerede baggrundsressourcer.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Konfiguriere Überschreibungen zum Testen von Apps, die verwaltete Hintergrundressourcen verwenden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Ρύθμιση παραμέτρων των παρακάμψεων για δοκιμές σε εφαρμογές που χρησιμοποιούν διαχειριζόμενους πόρους παρασκηνίου.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Configure overrides for testing apps that use Managed Background Assets.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Configure overrides for testing apps that use Managed Background Assets.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Configure overrides for testing apps that use Managed Background Assets.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Configure overrides for testing apps that use Managed Background Assets.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Configura las invalidaciones para las apps de pruebas que usan componentes en segundo plano gestionados.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Configura anulaciones para probar apps que usan activos en segundo plano administrados.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Määritä ohitukset hallittuja taustaresursseja käyttävien appien testausta varten.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Configurez des substitutions pour tester des apps utilisant des ressources d’arrière-plan gérées.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Configurez des mesures de contournement pour tester les apps qui utilisent les ressources en arrière-plan gérées.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להגדיר מעקפים לבדיקת יישומים שמשתמשים בנכסי רקע מנוהלים.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "प्रबंधित बैकग्राउंड ऐसेट का इस्तेमाल करने वाले ऐप्स की टेस्टिंग के लिए ओवरराइड कॉन्फ़िगर करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Konfigurirajte nadjačavanja za testiranje aplikacija koje koriste upravljana pozadinska sredstva.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Felülbírálások konfigurálása a felügyelt háttérerőforrásokat használó appok teszteléséhez.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
