        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er under tilsyn, og %@ kan overvåke nettbruken på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Apple TV wordt beheerd en '%@' kan het internetverkeer op dit apparaat bekijken."
