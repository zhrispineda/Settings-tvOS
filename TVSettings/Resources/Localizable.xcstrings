    "AXVoiceOverMediaDescriptionsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تحديد كيفية إخراج الشرح المكتوب لأحداث العرض + ‏SDH أثناء تشغيل الوسائط.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Determina com es mostren els subtítols descriptius i per a sords durant les reproduccions multimèdia.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Nastavuje využití skrytých titulků a titulků pro neslyšící při přehrávání médií.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Bestemmer, hvordan closed captions (CC) + tekstning (TH) vises ved afspilning af medier.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Bestimmt, wie erweiterte Untertitel (CC) und UT bei der Medienwiedergabe ausgegeben werden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Καθορίζει τον τρόπο εξόδου των Κλειστών λεζαντών και SDH κατά τη διάρκεια της αναπαραγωγής πολυμέσων.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Determines how Closed Captions + SDH are output during media playback.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Determines how Closed Captions + SDH are output during media playback.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Determines how Closed Captions + SDH are output during media playback.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Determines how Closed Captions + SDH are output during media playback.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Determines how Closed Captions + SDH are output during media playback.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Determina cómo se muestran los subtítulos descriptivos y para sordos al reproducir contenido multimedia.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Determina cómo se muestran los subtítulos opcionales y para sordera al reproducir contenido.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Determina cómo se muestran los subtítulos opcionales y para sordera al reproducir contenido.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Määrittää, missä muodossa kuvaileva ja ohjelmatekstitys tuotetaan median toiston aikana.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Détermine la manière dont les sous-titres codés et SM sont générés pendant la lecture de contenus multimédias.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Détermine comment les sous-titres codés et les sous-titres pour sourds et malentendants s’affichent pendant la lecture d’un contenu.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "הגדרה זו קובע את האופן שבו יוצגו תרגום וכתוביות לכבדי שמיעה (SDH) בזמן הפעלת מדיה.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "निर्धारित करता है कि मीडिया प्लेबैक के दौरान क्लोज़्ड कैप्शन + SDH आउटपुट आता है या नहीं।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Određuje način izlaza Proširenih titlova + SDH-a tijekom reprodukcije medija.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Meghatározza, hogyan jelenjenek meg a szöveges átiratok és feliratok médialejátszás alatt.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Menentukan bagaimana Teks Tertulis + SDH ditampilkan selama pemutaran media.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Determina la modalità di visualizzazione dei sottotitoli per non udenti e SDH durante la riproduzione di file multimediali.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "メディアの再生中に、クローズドキャプション+SDHをどのように表示するかを決めます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "이 옵션은 미디어 재생 중에 청각 장애인용 자막 + SDH를 어떤 방식으로 알려줄지 결정합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Menentukan cara Kapsyen Tertutup + SDH dioutput semasa main balik media.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Bepaalt hoe bijschriften geluid + O.D.S. worden weergegeven tijdens het afspelen van media.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Avgjør hvordan skjult teksting + SDH presenteres under avspilling av media.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Określa sposób wyświetlania napisów dla niesłyszących podczas odtwarzania multimediów.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Determina como as Legendas Ocultas + SDH são geradas durante a reprodução de mídia.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Determina o modo de apresentação da legendagem opcional e para surdos durante a reprodução.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Determină modul în care subtitrările complexe și SDH sunt reproduse în timpul redării multimedia.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Определяет, как выводятся субтитры во время воспроизведения медиаконтента.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Nastavenie spôsobu zobrazovania skrytých titulkov a SDH počas prehrávania médií.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Določite način podajanja podnaslovov za gluhe in naglušne med predvajanjem predstavnostnih vsebin.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Anger hur textning för hörselskadade matas ut under uppspelning av medier.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "กำหนดว่าต้องการออกเสียงอ่านคำบรรยาย + SDH อย่างไรในระหว่างเล่นสื่อ",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Açıklamalı Altyazıların ve İşitme Engelliler İçin Altyazının ortam oynatma sırasındaki çıkış şeklini belirler.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Задає, як виводяться закриті титри (CC) + SDH під час відтворення медіавмісту.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Xác định cách hiển thị Chú thích chi tiết + SDH trong khi phát lại phương tiện.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "确定媒体播放时，隐藏式字幕+听障人士字幕(SDH)的输出方式。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "決定在播放媒體時，隱藏式字幕+聽障人士字幕(SDH)的輸出方式。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "決定隱藏式字幕 + SDH在媒體播放時的輸出方式。",
            "state": "translated"
          }
        }
      }
    },
