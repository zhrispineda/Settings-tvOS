    "RCDisabledCECInstructionalText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nللتحكم بشكل أفضل، قم بتمكين CEC على التلفزيون وجهاز الاستقبال."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPer tenir un millor control, activa CEC al televisor i al receptor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPro lepší ovládání zapněte na televizoru a receiveru funkci CEC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSlå CEC til på dit fjernsyn og din modtager for bedre betjening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nZur besseren Steuerung aktiviere CEC auf deinem TV-Gerät und Empfänger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nΓια καλύτερο έλεγχο, ενεργοποιήστε το CEC στην τηλεόραση και στον δέκτη σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nFor better control, enable CEC on your TV and receiver."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nFor better control, enable CEC on your TV and AV Receiver."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nFor better control, enable CEC on your TV and receiver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPara un mejor control, activa CEC en el televisor y en el receptor."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPara un mejor control, activa CEC en tu TV y el receptor."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPara un mejor control, activa CEC en tu TV y el receptor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOhjaus toimii paremmin, jos otat CEC:n käyttöön televisiossa ja vastaanottimessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPour un meilleur contrôle, activez CEC sur votre téléviseur et votre récepteur."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPour plus de contrôle, activez le protocole CEC sur votre télévision et votre récepteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nלשליטה טובה יותר, יש להפעיל את CEC בטלוויזיה ובמגבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nबेहतर नियंत्रण के लिए अपने टीवी और रिसीवर पर CEC को सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nZa bolje upravljanje uključite CEC na vašem TV‑u i prijemniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nA jobb vezérléshez engedélyezze a CEC-t a tv-jén és vevőkészülékén."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nUntuk kontrol yang lebih baik, aktifkan CEC di TV dan penerima Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPer un’esperienza migliore, abilita la funzionalità CEC su televisore e ricevitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nより制御しやすくするには、テレビとレシーバーのCECを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n제어를 더 향상하기 위해 TV 및 수신기에서 CEC를 활성화하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nUntuk kawalan lebih baik, dayakan CEC pada TV dan penerima anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAktiver Consumer Electronics Control (CEC) på TV-en og hjemmekinoen din for forbedret betjening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSchakel voor betere bediening CEC in op je tv en ontvanger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAby uzyskać lepsze sterowanie, włącz CEC w telewizorze i odbiorniku."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPara ter um controle melhor, ative o CEC na sua televisão e receiver."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPara ter melhor controlo, ative CEC na televisão e no recetor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPentru control superior, activați funcția CEC pe televizorul și receiverul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nВключите CEC на телевизоре и ресивере для более надежного управления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPre lepšiu kontrolu povoľte na svojom TV a prijímači funkciu CEC."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nZa boljše upravljanje omogočite možnost CEC v svojem televizorju in sprejemniku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nStyrningen blir bättre om du aktiverar CEC på TV:n och mottagaren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nเพื่อการควบคุมที่ดีขึ้น ให้เปิดใช้งาน CEC บนทีวีและตัวรับสัญญาณของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDaha iyi bir denetim için TV’nizde ve alıcınızda CEC’yi etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nДля кращого керування увімкніть CEC на своєму ТВ і приймачі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nĐể điều khiển tốt hơn, bật CEC trên TV và đầu thu của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n启用电视机和接收器的CEC功能，进行更有效的控制。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n為了更好的控制，請啟用你電視和接收器上的CEC。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n為取得較佳控制，請啟用你電視和接收器上的CEC。"
          }
        }
      }
    },
