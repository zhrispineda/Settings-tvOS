    "SaverBackdropYourPhotosSetupDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لرؤية الصور والذكريات على هذا الـ Apple TV، يجب إعداد \"صور iCloud\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mostrar fotos i records a l’Apple TV, activa les fotos a l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li si na této Apple TV prohlížet fotky a vzpomínky, nastavte službu Fotky na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil se fotos og minder på dette Apple TV, skal du indstille iCloud-fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um auf diesem Apple TV Fotos und Rückblicke anzuzeigen, richte „iCloud-Fotos“ ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για εμφάνιση φωτογραφιών και αναμνήσεων σε αυτό το Apple TV, διαμορφώστε τις Φωτογραφίες iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see photos and Memories on this Apple TV, set up iCloud Photos."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To see photos and Memories on this Apple TV, set up iCloud Photos."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To see photos and Memories on this Apple TV, set up iCloud Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver fotos y recuerdos en este Apple TV, configura Fotos en iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver fotos y recuerdos en este Apple TV, configura Fotos en iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver fotos y recuerdos en este Apple TV, configura Fotos en iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat nähdä kuvia ja muistoja tässä Apple TV:ssä, ota iCloud-kuvat käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher des photos et des souvenirs sur cette Apple TV, configurez Photos iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher des photos et des souvenirs sur cette Apple TV, configurez Photos iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג תמונות וזיכרונות ב‑Apple TV זה יש להגדיר את ״תמונות iCloud״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple TV पर तस्वीरें और यादें देखने के लिए iCloud तस्वीर सेटअप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prikazivanje fotografija i Uspomena na ovom Apple TV-u podesite iCloud fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szeretne fotókat és emlékeket megtekinteni ezen az Apple TV‑n, állítsa be az iCloud‑fotókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat foto dan Memori di Apple TV ini, atur Foto iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere foto e ricordi su questa Apple TV, configura “Foto di iCloud”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVで写真や“メモリー”を表示するには、iCloud写真を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV에서 사진 및 추억을 보려면 iCloud 사진을 설정하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat foto dan Memori pada Apple TV ini, sediakan Foto iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargjør iCloud Bilder for å se bilder og minner på denne Apple TV-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om foto's en terugblikken op deze Apple TV te zien, configureer je iCloud-foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyświetlać zdjęcia i wspomnienia na tym Apple TV, skonfiguruj Zdjęcia w iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver fotos e Memórias nesta Apple TV, configure as Fotos do iCloud."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver fotografias e recordações nesta Apple TV, configure Fotografias em iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vedea poze și amintiri pe acest Apple TV, configurați Poze iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать фото и воспоминания на этом Apple TV, настройте Фото iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete na tomto Apple TV prezerať fotky a spomienky, nastavte službu iCloud Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ogled fotografij in Spominov v tem Apple TV‑ju nastavite Fotografije iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in iCloud‑bilder om du vill visa bilder och minnen på denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการดูรูปภาพและความทรงจำบน Apple TV เครื่องนี้ ให้ตั้งค่า “รูปภาพบน iCloud”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları ve Anılar’ı bu Apple TV’de görmek için iCloud Fotoğrafları’nı ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб переглядати фотографії та спогади на цьому Apple TV, налаштуйте Фото iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem ảnh và kỷ niệm trên Apple TV này, hãy thiết lập Ảnh iCloud."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在此Apple TV上查看照片和“回忆”，请设置“iCloud照片”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要在此Apple TV上查看相片和「回憶」，請設定「iCloud相片」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在此Apple TV上查看照片和「回憶」，請設定「iCloud照片」。"
          }
        }
      }
    },
    "SaverChooseSaverDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار شاشة التوقف المراد استخدامها. يمكنك أيضًا تغيير شاشة التوقف عن طريق السحب إلى الأعلى على الريموت أثناء تشغيل شاشة التوقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria l’estalvi de pantalla que vulguis fer servir. Si l’estalvi de pantalla està activat, també pots fer lliscar un dit al comandament per canviar‑lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte spořič obrazovky, který chcete použít. Chcete‑li změnit spuštěný spořič obrazovky, přejeďte na ovladači Apple TV nahoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg den skærmskåner, som du vil bruge. Du kan også ændre skærmskåneren ved at skubbe opad på fjernbetjeningen, mens skærmskåneren vises på skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welchen Bildschirmschoner du verwenden möchtest. Du kannst den Bildschirmschoner auch ändern, indem du auf der Fernbedienung nach oben streichst, während der Bildschirmschoner aktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την προφύλαξη οθόνης που θέλετε να χρησιμοποιήσετε. Μπορείτε επίσης να αλλάξετε την προφύλαξη οθόνης σαρώνοντας προς τα πάνω στο τηλεχειριστήριο, ενώ η προφύλαξη οθόνης είναι ενεργή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the screen saver you want to use. You can also change the screen saver by swiping up on the remote when the screen saver is running."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the screen saver you want to use. You can also change the screen saver by swiping up on the remote when the screen saver is running."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the screen saver you want to use. You can also change the screen saver by swiping up on the remote when the screen saver is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el salvapantallas que quieras usar. Cuando el salvapantallas esté activo, también podrás cambiarlo deslizando hacia arriba en el mando."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el protector de pantalla que quieres usar. Si ya se está mostrando el protector de pantalla, puedes deslizar hacia arriba en el control remoto para cambiarlo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el protector de pantalla que quieres usar. Si ya se está mostrando el protector de pantalla, puedes deslizar hacia arriba en el control remoto para cambiarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse näytönsäästäjä, jota haluat käyttää. Voit myös vaihtaa näytönsäästäjän pyyhkäisemällä ylöspäin kaukosäätimellä, kun näytönsäästäjä on käynnissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’économiseur d’écran que vous souhaitez utiliser. Vous pouvez également changer d’économiseur d’écran en balayant la surface tactile de la télécommande vers le haut lorsque l’économiseur d’écran est actif."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’économiseur d’écran que vous voulez utiliser. Vous pouvez également changer d’économiseur d’écran en balayant la télécommande vers le haut lorsqu’un économiseur d’écran est affiché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבחור את שומר המסך הרצוי. ניתן גם להחליף את שומר המסך על ידי החלקה מעלה בשלט כששומר המסך פועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह स्क्रीन सेवर चुनें जिसे आप इस्तेमाल करना चाहते हैं। आप स्क्रीन सेवर चलने के दौरान रिमोट पर ऊपर की ओर स्वाइप करके भी स्क्रीन सेवर को बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite zaštitu zaslona koju želite koristiti. Zaštitu zaslona možete promijeniti i povlačenjem prema gore na daljinskom upravljaču dok je zaštita zaslona pokrenuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválaszthatja a használni kívánt képernyővédőt. A képernyővédőt úgy is módosíthatja, hogy felfelé legyint a távirányítón, amikor a képernyővédő fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih penghemat layar yang ingin Anda gunakan. Anda juga dapat mengubah penghemat layar dengan menggesek ke atas pada remote saat penghemat layar aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il salvaschermo che vuoi usare. Puoi anche modificare il salvaschermo mentre è in esecuzione scorrendo verso l’alto sul telecomando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するスクリーンセーバを選択してください。スクリーンセーバの実行中にリモコン上で上にスワイプすることで、スクリーンセーバを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하려는 화면 보호기를 선택합니다. 화면 보호기가 실행 중일 때 리모컨에서 위로 쓸어올려서 화면 보호기를 변경할 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih penyelamat skrin yang anda mahu gunakan. Anda juga boleh menukar penyelamat skrin dengan meleret ke atas pada kawalan jauh semasa penyelamat skrin berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg skjermspareren du vil bruke. Du kan også endre skjermsparer ved å sveipe opp på fjernkontrollen mens skjermspareren er aktiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de schermbeveiliging die je wilt gebruiken. Je kunt de schermbeveiliging ook wijzigen door omhoog te vegen op de afstandsbediening terwijl de schermbeveiliging actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wygaszacz ekranu, którego chcesz użyć. Aby zmienić wygaszacz ekranu, możesz również uruchomić go, a następnie przesunąć palcem w górę po pilocie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o protetor de tela que você deseja usar. Você também pode passar o dedo para cima no controle remoto quando o protetor de tela estiver ativado para alterá‑lo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a proteção de ecrã pretendida. Também pode passar o dedo para cima no comando para alterar a proteção de ecrã quando estiver ativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți screensaverul pe care doriți să îl utilizați. De asemenea, puteți schimba screensaverul glisând în sus pe telecomandă în timp ce acesta rulează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите заставку на свой вкус. Заставку можно легко сменить, смахнув вверх по пульту Apple TV во время ее отображения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte šetrič obrazovky, ktorý chcete použiť. Ak chcete zmeniť spustený šetrič obrazovky, môžete na ovládači potiahnuť nahor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite ohranjevalnik zaslona, ki ga želite uporabiti. Ohranjevalnik zaslona lahko tudi spremenite, in sicer tako, da med njegovim prikazom podrsnete po daljincu navzgor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj skärmsläckaren som du vill använda. Du kan även byta skärmsläckare genom att svepa uppåt på fjärrkontrollen när skärmsläckaren är igång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาพพักหน้าจอที่คุณต้องการใช้ คุณยังสามารถเปลี่ยนภาพพักหน้าจอได้โดยปัดขึ้นบนรีโมทเมื่อภาพพักหน้าจอทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz ekran koruyucuyu seçin. Ekran koruyucu çalışırken kumanda üzerinde yukarı kaydırarak da ekran koruyucuyu değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, яку екранну заставку використовувати. Змінюйте екранну заставку, що наразі відтворюється, проведенням угору на пульті ДК."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn trình bảo vệ màn hình mà bạn muốn sử dụng. Bạn cũng có thể thay đổi trình bảo vệ màn hình bằng cách vuốt lên trên điều khiển từ xa khi trình bảo vệ màn hình đang chạy."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选取要用的屏幕保护程序。你也可以更改屏幕保护程序，运行屏幕保护程序时在遥控器上向上轻扫即可。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你想使用的螢幕保護程式。當螢幕保護程式運行時，你也可以在遙控器上向上掃來更改螢幕保護程式。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你要使用的螢幕保護程式。你也可以在執行螢幕保護程式時，在遙控器上往上滑動來更改螢幕保護程式。"
          }
        }
      }
    },
