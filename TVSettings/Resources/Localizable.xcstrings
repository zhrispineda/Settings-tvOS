    "AXIncreaseContrastDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "زيادة تباين اللون بين ألوان مقدمة وخلفية التطبيق.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Augmenta el contrast entre els colors del fons i del primer pla de les apps.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Zvýší barevný kontrast mezi popředím a pozadím aplikace.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Forøg farvekontrast mellem forgrunds- og baggrundsfarver i app.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Den Farbkontrast zwischen dem App-Vordergrund und dem Hintergrund erhöhen.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αύξηση της χρωματικής αντίθεσης μεταξύ των χρωμάτων προσκηνίου και παρασκηνίου των εφαρμογών.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Increase color contrast between app foreground and background colors.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Increase colour contrast between app foreground and background colours.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Increase colour contrast between app foreground and background colours.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Increase colour contrast between app foreground and background colours.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Increase color contrast between app foreground and background colors.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Aumenta el contraste entre los colores del primer plano y los del fondo de la app.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Aumenta el contraste entre los colores del primer y segundo planos.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Aumenta el contraste entre los colores del primer y segundo planos.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Lisää apin etualan ja taustan värien välistä värikontrastia.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Augmentez le contraste des couleurs entre le premier plan des apps et les couleurs d’arrière-plan.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Augmente le contraste des couleurs entre le premier plan et l’arrière-plan des apps.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להגביר את הניגודיות בין הצבעים של החזית והרקע ביישומים.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "ऐप फ़ोरग्राउंड और बैकग्राउंड रंगों के बीच रंग का कॉन्ट्रास्ट बढ़ाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Povećanje kontrasta boje između prednjih i pozadinskih boja aplikacije.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A színkontraszt növelése az app előterének és hátterének színei között.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tambah kontras warna antara warna latar depan dan latar belakang app.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Aumenta il contrasto tra i colori dell’app in primo piano e di sfondo.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "アプリの前景色と背景色との間のカラーコントラストを上げます。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "앱의 전면 및 후면 배경 색상 간에 색상 대비를 증가합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tingkatkan kontras warna antara warna latar depan dan latar belakang app.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Verhoog het kleurcontrast tussen de voorgrond- en achtergrondkleuren van de app.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Øk fargekontrasten mellom appens forgrunn og bakgrunnsfargene.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Zwiększa kontrast kolorów między zawartością i tłem w aplikacji.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Aumenta o contraste entre as cores de fundo e primeiro plano do app.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Aumenta o contraste entre as cores de primeiro e segundo planos da aplicação.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Sporiți contrastul între culorile din prim‑planul și din fundalul aplicațiilor.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Повысить контраст между цветами переднего и заднего планов приложения.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Zlepší čitateľnosť zvýšením farebného kontrastu medzi popredím a pozadím apiek.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Povečajte barvni kontrast med barvami ospredja in ozadja aplikacije.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Öka färgkontrasten mellan appens förgrunds- och bakgrundsfärger.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เพิ่มความต่างระดับสีระหว่างสีพื้นหน้าของแอปและสีพื้นหลัง",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Uygulamanın ön plan ve arka plan renkleri arasında renk kontrastını artırır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Збільшує контраст між кольорами переднього й заднього планів програми.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Tăng độ tương phản màu giữa các màu nền trước và nền sau của ứng dụng.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "增加App前景色和背景色的对比度。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "增加App前景和背景顏色的色彩對比度。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "增加App前景和背景顏色的色彩對比度。",
            "state": "translated"
          }
        }
      }
    },
    "AXSubtitlesWhenLanguageMismatchDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "إظهار الترجمة تلقائيًا عندما لا تتطابق لغة الفيديو الذي تشاهده مع لغتك المفضلة في Apple TV.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Activa els subtítols automàticament si l’idioma del vídeo que reprodueixes no coincideix amb l’idioma principal de l’Apple TV.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Automaticky zobrazí titulky, pokud se jazyk sledovaného videa liší od preferovaného jazyka Apple TV.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Vis automatisk undertekster, når sproget i den video, du ser, ikke er det samme som dit foretrukne Apple TV-sprog.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Untertitel werden automatisch angezeigt, wenn die Sprache des Videos, das du ansiehst, nicht mit deiner bevorzugten Sprache auf dem Apple TV übereinstimmt.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Αυτόματη εμφάνιση υπότιτλων όταν η γλώσσα του βίντεο που παρακολουθείτε δεν αντιστοιχεί στην προτιμώμενη γλώσσα του Apple TV σας.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Automatically show subtitles when the language of the video you’re watching doesn’t match your preferred Apple TV language.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Los subtítulos se muestran automáticamente cuando el idioma del vídeo que estás viendo no coincide con el idioma principal de tu Apple TV.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Muestra subtítulos automáticamente cuando el video que ves no corresponde a tu idioma preferido en el Apple TV.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Muestra subtítulos automáticamente cuando el video que ves no corresponde a tu idioma preferido en el Apple TV.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Näytä tekstitys automaattisesti, kun katsomasi videon kieli ei ole sama kuin ensisijainen Apple TV -kielesi.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Affichez automatiquement les sous-titres lorsque la langue de la vidéo en cours ne correspond pas à votre langue préférée sur l’Apple TV.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Affiche automatiquement les sous-titres lorsque la langue de la vidéo à l’écoute ne correspond pas à votre langue préférée pour l’Apple TV.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן להציג כתוביות באופן אוטומטי כששפת הווידאו הנצפה אינה תואמת לשפת ה-Apple TV המועדפת שלך.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "सबटाइटल ऑटोमैटिकली दिखाएँ जब आपके द्वारा देखे जा रहे वीडियो की भाषा आपके Apple TV की पसंदीदा भाषा से मेल नहीं खाती है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Automatsko prikazivanje titlova kad se jezik videozapisa koji gledate ne podudara s vašim preferiranim jezikom Apple TV-a.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Automatikusan megjeleníti a feliratokat, amikor a nézett videó nyelve nem felel meg az Ön Apple TV‑n beállított előnyben részesített nyelvének.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tampilkan subtitle secara otomatis saat bahasa video yang sedang Anda tonton tidak sesuai dengan bahasa Apple TV pilihan Anda.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Mostra automaticamente i sottotitoli quando la lingua del video che stai guardando non corrisponde a quella preferita di Apple TV.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "視聴中のビデオの言語がApple TVの優先する言語と一致しないときに自動的に字幕を表示します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "시청 중인 비디오의 언어가 선호하는 Apple TV 언어와 일치하지 않는 경우 자동으로 자막을 표시합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tunjukkan sari kata secara automatik apabila bahasa video yang anda tonton tidak sepadan dengan bahasa Apple TV pilihan anda.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Ondertiteling wordt automatisch weergegeven wanneer de taal van de video die je bekijkt niet overeenkomt met de gewenste Apple TV-taal.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Vis undertekster automatisk når videoer spilles på et annet språk enn det som er ditt foretrukne språk på Apple TV.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Automatycznie wyświetlaj napisy, gdy język wideo nie jest zgodny z preferowanym językiem Apple TV.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Mostra automaticamente as legendas quando o idioma do vídeo que você está vendo não é igual ao seu idioma preferido na Apple TV.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Mostrar legendas automaticamente se o idioma do vídeo em reprodução não corresponder ao idioma preferido configurado na Apple TV.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Subtitrările vor fi afișate automat atunci când limba conținutului video pe care îl vizionați nu corespunde cu limba preferată pentru Apple TV.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Субтитры отображаются автоматически, если язык просматриваемого видео не соответствует предпочитаемому языку Apple TV.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Automaticky zobrazí titulky, keď sa jazyk prehrávaného videa líši od preferovaného jazyka Apple TV.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Omogočite samodejen prikaz podnapisov, kadar se jezik predvajanega videa ne ujema z izbranim jezikom Apple TV-ja.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Visa undertexter automatiskt när språket i videon du tittar på inte matchar ditt föredragna språk på Apple TV.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "แสดงคำบรรยายโดยอัตโนมัติเมื่อภาษาของวิดีโอที่คุณกำลังดูไม่ตรงกับภาษาที่ต้องการของ Apple TV",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "İzlediğiniz videonun dili tercih ettiğiniz Apple TV diliyle eşleşmediğinde altyazıları otomatik olarak gösterir.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Автоматично показувати субтитри, якщо мова відтворюваного відео відрізняється від заданої на Apple TV пріоритетної мови.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Tự động hiển thị phụ đề khi ngôn ngữ của video mà bạn đang xem không khớp với ngôn ngữ Apple TV được ưu tiên của bạn.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "所观看视频的语言与Apple TV首选语言不匹配时自动显示字幕。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "當觀看的影片語言與你偏好的Apple TV語言不相符時，自動顯示字幕。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "在觀看的影片不符合你偏好的Apple TV語言時自動顯示字幕。",
            "state": "translated"
          }
        }
      }
    },
