    "CANT_DOWNLOAD_VOICE": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "قم بالاتصال بشبكة Wi-Fi بهدف تنزيل الصوت ذي الجودة المحسّنة.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Connecta’t a una xarxa Wi‑Fi per descarregar la veu “Qualitat millorada”.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Chcete‑li stáhnout hlas se zvýšenou kvalitou, připojte se k Wi‑Fi síti.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Opret forbindelse til et Wi-Fi-netværk for at kunne hente stemmen i forbedret kvalitet.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Stelle eine Verbindung zu einem WLAN her, um die hochwertige Stimme zu laden.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Συνδεθείτε σε δίκτυο Wi-Fi για λήψη της φωνής βελτιωμένης ποιότητας.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Connect to a Wi-Fi network in order to download the Enhanced Quality voice.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Connect to a Wi-Fi network in order to download the Enhanced Quality voice.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Connect to a Wi-Fi network in order to download the Enhanced Quality voice.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Connect to a Wi-Fi network in order to download the Enhanced Quality voice.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Connect to a Wi-Fi network in order to download the Enhanced Quality voice.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Conéctate a una red Wi-Fi para poder descargar la voz con calidad mejorada.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Conéctate a una red Wi-Fi para poder descargar la voz de calidad mejorada.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Conéctate a una red Wi-Fi para poder descargar la voz de calidad mejorada.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Lataa parempilaatuinen puheääni yhdistämällä Wi‑Fi-verkkoon.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Connectez-vous à un réseau Wi-Fi pour télécharger la voix de qualité améliorée.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Connectez-vous à un réseau Wi-Fi pour télécharger la voix de qualité améliorée.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "כדי להוריד את הקול באיכות גבוהה, יש להתחבר לרשת אלחוטית.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "बेहतर गुणवत्ता वाली आवाज़ डाउनलोड करने के लिए वाई-फ़ाई नेटवर्क से कनेक्ट करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Za preuzimanje glasa poboljšane kvalitete, spojite se na Wi-Fi mrežu.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Csatlakozzon egy Wi-Fi-hálózathoz a Javított minőségű hang letöltéséhez.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Hubungkan ke jaringan Wi-Fi untuk mengunduh suara Kualitas yang Ditingkatkan.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Per scaricare la voce “Qualità avanzata” connettiti a una rete Wi-Fi.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "高品質音声をダウンロードするには、Wi-Fiネットワークに接続してください。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "고품질 음성을 다운로드하려면 Wi‑Fi 네트워크에 연결하십시오.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Sambung ke rangkaian Wi‑Fi untuk memuat turun suara Kualiti Dipertingkat.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Maak verbinding met een wifinetwerk om de stem met betere kwaliteit te downloaden.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Koble til et Wi‑Fi-nettverk for å laste ned stemmen med forbedret kvalitet.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Aby pobrać głos wyższej jakości, połącz się z siecią Wi‑Fi.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Conecte-se a uma rede Wi-Fi para baixar a voz de Qualidade Aprimorada.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Estabeleça ligação a uma rede Wi‑Fi para descarregar a voz Qualidade Melhorada.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Conectați-vă la o rețea Wi-Fi pentru a descărca vocea de calitate sporită.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Подключитесь к сети Wi‑Fi, чтобы загрузить голос улучшенного качества.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Ak chcete stiahnuť hlas vo vylepšenej kvalite, pripojte sa k Wi‑Fi sieti.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Za prenos glasu izboljšane kakovosti vzpostavite povezavo z omrežjem Wi-Fi.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Anslut till ett Wi-Fi-nätverk om du vill hämta rösten med förbättrad kvalitet.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "เชื่อมต่อกับเครือข่าย Wi‑Fi เพื่อดาวน์โหลดเสียงคุณภาพขั้นสูง",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Geliştirilmiş Kalite sesi indirmek için bir Wi‑Fi ağına bağlanın.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Підʼєднайтеся до мережі Wi‑Fi, щоб викачати голос вищої якості.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Kết nối vào mạng Wi-Fi để tải về giọng nói Chất lượng Nâng cao.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "接入Wi-Fi网络以便下载“优化音质”语音。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "請連接Wi-Fi網絡以下載「已強化的質素」聲音。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "請連接Wi-Fi網路來下載「增強音質」聲音。",
            "state": "translated"
          }
        }
      }
    },
