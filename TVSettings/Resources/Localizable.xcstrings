    "SettingsVPNLoadVPNText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمّل ملف تعريف VPN. مطلوب بيانات اعتماد AppleConnect صالحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega el perfil de VPN. Requereix unes credencials de l’AppleConnect vàlides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíst VPN profil. Vyžaduje platné přihlašovací údaje pro AppleConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæs VPN‑profilen. Kræver gyldige AppleConnect-godkendelsesoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the VPN profile. Requires valid AppleConnect credentials."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώστε το προφίλ VPN. Απαιτούνται έγκυρα διαπιστευτήρια AppleConnect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the VPN profile. Requires valid AppleConnect credentials."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the VPN profile. Requires valid AppleConnect credentials."
          }
        },
