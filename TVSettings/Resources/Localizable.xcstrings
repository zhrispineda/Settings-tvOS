    "SiriDeleteHistoryDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف تفاعلات Siri والإملاء المرتبطة حاليًا بهذا الـ Apple TV من خوادم Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’eliminaran dels servidors d’Apple les interaccions de Siri i del dictat que estiguin associades a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data komunikace se Siri a s funkcí diktování, která jsou nyní přidružená k této Apple TV, budou ze serverů Apple smazána."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktioner med Siri og Diktering, der er knyttet til dette Apple TV, bliver slettet fra Apples servere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zurzeit mit diesem Apple TV verknüpften Interaktionen mit Siri und der Diktierfunktion werden von den Apple-Servern gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλληλεπιδράσεις σας με το Siri και την Υπαγόρευση που είναι συσχετισμένες με αυτό το Apple TV θα διαγραφούν από τους διακομιστές της Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri & Dictation interactions currently associated with this Apple TV will be deleted from Apple servers."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri and Dictation interactions currently associated with this Apple TV will be deleted from Apple servers."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri & Dictation interactions currently associated with this Apple TV will be deleted from Apple servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las interacciones de Siri y Dictado actualmente asociadas con este Apple TV se eliminarán de los servidores de Apple."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de los servidores de Apple las interacciones de Siri y el dictado asociadas actualmente con este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de los servidores de Apple las interacciones de Siri y el dictado asociadas actualmente con este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän Apple TV:hen liittyvät Siri-keskustelut ja sanelutoiminnot poistetaan Applen palvelimilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interactions avec Siri et Dictée actuellement associées à cette Apple TV seront supprimées des serveurs Apple."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interactions avec Siri et Dictée actuellement associées à cette Apple TV seront supprimées des serveurs d’Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האינטראקציות עם Siri והכתבה המקושרות כרגע עם Apple TV זה יימחקו מהשרתים של Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple सर्वर से इस Apple TV के साथ अभी संबद्ध Siri और डिक्टेशन इंटरऐक्शन को डिलीट कर दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interakcije sa Siri i Diktatom koje su trenutačno povezane s ovim Apple TV-om obrisat će se s Appleovih servera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer törölni fogja az Apple szervereiről a Sirivel és a Diktálással végzett olyan műveleteket, amelyek jelenleg ezzel az Apple TV-vel vannak társítva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaksi Siri & Dikte yang saat ini dikaitkan dengan Apple TV ini akan dihapus dari server Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le interazioni con Siri e Dettatura attualmente associate a questa Apple TV verranno eliminate dai server Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVに現在関連付けられているSiriと音声入力に対する操作の音声はAppleのサーバから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 서버에서 현재 이 Apple TV와 관련된 Siri 및 받아쓰기 상호 작용이 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaksi Siri & Perencanaan yang pada masa ini dikaitkan dengan Apple TV ini akan dipadamkan daripada pelayan Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri- og Diktering-interaksjon som er tilknyttet denne Apple TV-enheten, vil bli slettet fra Apples tjenere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interacties met Siri en de dicteerfunctie die momenteel met deze Apple TV zijn geassocieerd, worden verwijderd van de Apple servers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interakcje z Siri i funkcją Dyktowanie powiązane obecnie z tym Apple TV zostaną usunięte z serwerów Apple."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As interações com a Siri e o Ditado associadas atualmente a esta Apple TV serão apagadas dos servidores da Apple."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As interações com Siri e o Ditado atualmente associadas a esta Apple TV serão apagadas dos servidores da Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Interacțiunile care implică Siri și dictarea asociate în prezent cu acest Apple TV vor fi șterse de pe serverele Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные взаимодействия с Siri и Диктовкой, ассоциированные с этим Apple TV, будут удалены с серверов Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Interakcie so Siri a Diktovaním priradené k tomuto Apple TV budú vymazané zo serverov spoločnosti Apple."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interakcije s Siri in funkcijo Narekovanje, ki so trenutno povezane s tem Apple TV-jem, bodo izbrisane iz strežnikov Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri- och dikteringsinteraktioner som för närvarande är associerade med denna Apple TV kommer att raderas från Apple-servrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโต้ตอบกับ Siri และการป้อนตามคำบอกที่ปัจจุบันนี้ผูกกับ Apple TV เครื่องนี้จะถูกลบออกจากเซิร์ฟเวอร์ Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV ile ilişkili Siri ve Dikte etkileşimleri Apple sunucularından silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Взаємодії із Siri й Диктуванням, наразі повʼязані з цим Apple TV, буде видалено із серверів Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tương tác Siri & Đọc chính tả hiện được liên kết với Apple TV này sẽ bị xóa khỏi các máy chủ của Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前与这台Apple TV关联的Siri与听写交互将从Apple服务器上删除。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前連繫至此Apple TV的「Siri與聽寫」互動內容將會從Apple伺服器刪除。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將會從Apple伺服器刪除目前與此Apple TV相關的「Siri與聽寫」互動內容。"
          }
        }
      }
    },
