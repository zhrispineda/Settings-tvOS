    "SettingsOSUpdateConfigurationChangedMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير التكوين بنجاح.\nيرجى إعادة التشغيل والتحقق من التكوين قبل محاولة التحديث."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha canviat la configuració correctament.\nAbans de provar d’actualitzar el dispositiu, reinicia’l i verifica’n la configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurace byla úspěšně změněna.\nPřed pokusem o aktualizaci restartujte a konfiguraci ověřte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationen blev ændret.\nStart igen, og bekræft konfigurationen inden forsøg på opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration wurde erfolgreich geändert.\nStarte neu und überprüfe die Konfiguration, bevor du zu aktualisieren versuchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ρύθμιση παραμέτρων άλλαξε επιτυχώς.\nΚάντε επανεκκίνηση και επαληθεύστε τη ρύθμιση παραμέτρων πριν από την απόπειρα ενημέρωσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration was successfully changed.\nPlease restart and Verify Configuration before attempting to update."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration was successfully changed.\nPlease restart and Verify Configuration before attempting to update."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration was successfully changed.\nPlease restart and Verify Configuration before attempting to update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración se ha cambiado correctamente.\nReinicia y verifica la configuración antes de actualizar."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración se cambió correctamente.\nReinicia y verifícala antes de intentar actualizar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración se cambió correctamente.\nReinicia y verifícala antes de intentar actualizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration was successfully changed.\nPlease restart and Verify Configuration before attempting to update."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration a été correctement modifiée.\nRedémarrez l’appareil et utilisez l’option « Vérifier la configuration » avant de tenter la mise à jour."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration a été modifiée avec succès.\nVeuillez procéder au redémarrage et vérifier la configuration avant de tenter une mise à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצורה שונתה בהצלחה.\nנא להפעיל מחדש ולבצע ״אימות תצורה״ לפני ניסיון העדכון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन सफलतापूर्वक बदला गया।\nअपडेट करने की कोशिश करने के पहले रीस्टार्ट करें और कॉन्फ़िगरेशन सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracija je uspješno promijenjena.\nPonovno uključite uređaj i provjerite konfiguraciju prije pokušaja ažuriranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konfiguráció sikeresen módosítva lett.\nKérjük, indítsa újra az eszközt, és ellenőrizze a konfigurációt a frissítés megkísérlése előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi berhasil diubah.\nMulai ulang dan Verifikasi Konfigurasi sebelum mencoba memperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione è stata modificata.\nPrima di procedere con l’aggiornamento, riavvia e verifica la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構成は正しく変更されました。\n再起動し、アップデートをする前に“構成の検証”を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성이 성공적으로 변경되었습니다.\n업데이트하기 전에 재시동한 다음 ‘구성 확인’을 하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi berjaya ditukar.\nSila mula semula dan Sahkan Konfigurasi sebelum cuba mengemas kini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasjonen ble endret.\nStart på nytt og verifiser konfigurasjonen før du prøver å oppdatere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging van de configuratie is geslaagd.\nStart opnieuw op en verifieer de configuratie voordat je gaat bijwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja została zmieniona.\nPrzed rozpoczęciem uaktualniania uruchom ponownie i zweryfikuj konfigurację."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi alterada com êxito.\nReinicie e Verifique a Configuração antes de tentar atualizar."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi alterada com êxito.\nReinicie e valide a configuração antes de tentar atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificarea configurației a reușit.\nReporniți și verificați configurația înainte de a încerca actualizarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация изменена успешно.\nПеред попыткой обновления перезагрузите устройство и проверьте его конфигурацию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurácia bola úspešne zmenená.\nPred aktualizáciou reštartujte zariadenie a overte konfiguráciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracija je bila uspešno spremenjena.\nZnova zaženite napravo in preverite konfiguracijo, preden poskusite izvesti posodobitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationen har ändrats.\nStarta om och verifiera konfigurationen innan du försöker uppdatera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกำหนดค่าถูกเปลี่ยนค่าสำเร็จแล้ว\nโปรดเริ่มการทำงานเครื่องใหม่และตรวจสอบยืนยันการกำหนดค่าก่อนที่จะพยายามอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigürasyon başarıyla değiştirildi.\nLütfen güncellemeyi denemeden önce yeniden başlatın ve konfigürasyonu doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфігурацію було успішно змінено.\nПерезапустіть і перевірте конфігурацію перед спробою оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thay đổi cấu hình thành công.\nVui lòng khởi động lại và xác minh cấu hình trước khi cố gắng cập nhật."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已成功更改。\n请重新启动并验证配置后再尝试更新。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已成功變更設定。\n請重新啟動並在嘗試更新前「驗證設定」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已成功更改設定。\n請重新啟動並在嘗試更新前驗證設定。"
          }
        }
      }
    },
