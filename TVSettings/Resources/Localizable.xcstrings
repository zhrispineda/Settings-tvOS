            "value": "इस सेटिंग के चालू रहने पर उपरोक्त निर्देश निष्क्रियता के दो मिनट के बाद दिखाई देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je ova postavka uključena, gore navedene upute prikazuju se nakon dvije minute neaktivnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a beállítás be van kapcsolva, a fenti utasítások két perc tétlenség után jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pengaturan ini dinyalakan, instruksi di atas akan muncul setelah dua menit tidak aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questa impostazione è attiva, le istruzioni in alto compariranno dopo due minuti di inattività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定をオンにした場合、使用しない状態が2分間続くと上記の手順が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정이 켜지면 2분 동안의 비활성 상태가 지난 후 상단 지침이 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seting ini diaktifkan, arahan di atas kelihatan selepas dua minit tiada aktiviti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis denne innstillingen er slått på, vil instruksjonene over vises etter to minutter uten aktivitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit is ingeschakeld, verschijnen bovenstaande instructies na twee minuten inactiviteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy to ustawienie jest włączone, powyższe instrukcje pojawiają się po 2 minutach bezczynności."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando este ajuste está ativo, as instruções acima aparecem após dois minutos de inatividade."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando esta definição está ativa, as instruções acima aparecem ao fim de dois minutos de inatividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când această configurare este activată, instrucțiunile de mai sus apar după două minute de inactivitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда эта настройка включена, приведенные выше инструкции появятся после двух минут бездействия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je toto nastavenie zapnuté, zobrazia sa po 4 min nečinnosti vyššie uvedené inštrukcie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar je ta nastavitev vklopljena, se bodo po dveh minutah neaktivnosti prikazala zgornja navodila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med den här inställningen på kommer anvisningarna ovan att visas efter två minuters overksamhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการตั้งค่านี้เปิดอยู่ คำแนะนำข้างบนจะแสดงหลังจากที่ไม่ได้ใช้งานนานสองนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayar açıkken, yukarıdaki yönergeler iki dakikalık eylemsizlikten sonra görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли цю опцію ввімкнено, наведені вище інструкції зʼявляються після двох хвилин бездіяльності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cài đặt này được bật, các hướng dẫn trên xuất hiện sau hai phút không hoạt động."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当此设置打开时，上述说明会在闲置两分钟后出现。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如關閉此設定，閒置2分鐘後即會顯示上方的指示。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若開啟此設定，閒置2分鐘後即會顯示上方的指示。"
          }
        }
      }
    },
