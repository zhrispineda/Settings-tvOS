    "MusicAppLyricsLargeTextSettingDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان سيتم عرض كلمات الأغنية أو النطق بحجم أكبر عند عرضهما معًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas que estiguin disponibles tant la lletra de la cançó com la pronunciació, tria quina de les dues vols que es mostri més gran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje vybrat, zda se má větším písmem zobrazovat text, nebo jeho výslovnost, pokud jsou aktivované současně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, om sangtekster eller udtale ser større ud, når begge vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, ob bei gleichzeitiger Anzeige der Liedtext oder die Aussprache größer angezeigt werden soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε αν το μέγεθος των στίχων ή της προφοράς θα είναι μεγαλύτερο σε περίπτωση ταυτόχρονης εμφάνισής τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether lyrics or pronunciation appears larger when both are displayed."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether lyrics or pronunciation appears larger when both are displayed."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether lyrics or pronunciation appears larger when both are displayed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si ver más grande la letra o la pronunciación cuando se muestren ambas a la vez."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuál de las dos, la letra o la pronunciación, quieres que salga de mayor tamaño cuando se muestren al mismo tiempo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuál de las dos, la letra o la pronunciación, quieres que salga de mayor tamaño cuando se muestren al mismo tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse näkyvätkö sanat vai ääntämys suurempana, kun molemmat näkyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez si vous souhaitez afficher les paroles ou la prononciation en plus grand lorsque les deux sont affichées."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si la police des paroles ou de la prononciation doit être plus grande lorsque les deux sont affichées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר מילות שירים מוצגות יחד עם אופן ההגייה שלהן, ניתן לבחור מה יופיע בגודל גדול יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गीत के बोल और उच्चारण दोनों दिखाए जा रहे हों, तो चुनें कि किसको बड़े आकार में दिखाया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite hoće li se stihovi ili izgovor prikazivati uvećani kad je oboje prikazano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megadhatja, hogy a dalszöveg vagy a kiejtés legyen-e nagyobb méretben látható, amikor mindkettő megjelenik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah lirik atau pelafalan muncul lebih besar saat keduanya ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se mostrare il testo o la pronuncia con un font più grande quando vengono visualizzati entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞と発音の両方が表示されている場合、どちらを大きく表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 및 발음이 모두 표시될 때 어떤 항목을 더 크게 표시할지 선택합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sama ada lirik atau sebutan kelihatan lebih besar apabila kedua-duanya dipaparkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg om sangteksten eller uttalen skal ha større tekst når de vises samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of de songtekst of de uitspraak groter moet worden weergegeven wanneer beide worden getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy większą czcionką mają być wyświetlane słowa utworu czy ich wymowa (gdy są widoczne w tym samym czasie)"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tanto a letra da música quanto a pronúncia forem exibidas, escolha qual delas aparecerá em tamanho maior."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a letra ou a pronúncia aparece destacada quando ambas estão disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți dacă doriți ca textul versurilor sau al pronunției să utilizeze un font mai mare atunci când sunt afișate ambele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что показывать крупнее: слова песни или их произношение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje vám vybrať, či sa má väčším písmom zobraziť text skladby alebo jeho výslovnosť (ak sú zobrazené súčasne)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, ali bo v večji pisavi prikazano besedilo ali izgovarjava, ko sta prikazana oba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om låttexter eller uttal ska vara större när båda visas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะให้เนื้อเพลงหรือเนื้อร้องมีขนาดใหญ่ขึ้นหรือไม่เมื่อแสดงทั้งสองรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkı sözleri ve telaffuz aynı anda görüntülenirken hangisinin daha büyük görüneceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, що показуватиметься більшим шрифтом — текст пісні чи вимова, якщо вони зʼявляються одночасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem có hiển thị lời bài hát hoặc cách phát âm lớn hơn không khi cả hai được hiển thị."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示时，选择要以更大字体显示歌词还是发音。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在歌詞和發音同時出現時，選擇哪一個以較大文字顯示。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇在歌詞和發音皆出現時要讓何者放大顯示。"
          }
        }
      }
    },
