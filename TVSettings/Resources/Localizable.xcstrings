    "OSBetaSoftwareEnrollNoTermsMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروط والأحكام الخاصة بـ Apple Beta Software Program غير متوفرة حاليًا. يرجى المحاولة مرة أخرى لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els termes i condicions del programa Apple Beta Software no estan disponibles actualment. Torna‑ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmínky a ujednání pro program Apple Beta Software nejsou momentálně dostupné. Zkuste to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkår og betingelser for Apple Beta Software Program er ikke tilgængelige i øjeblikket. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Beta Software-Programmbestimmungen sind derzeit nicht verfügbar. Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι διαθέσιμοι τώρα οι όροι και προϋποθέσεις για το Πρόγραμμα Apple Beta Software. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terms and conditions for the Apple Beta Software Program aren’t currently available. Try again later."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The terms and conditions for the Apple Beta Software Program aren’t currently available. Try again later."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The terms and conditions for the Apple Beta Software Programme aren’t currently available. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los términos y condiciones del programa Apple Beta Software no están disponibles en estos momentos. Inténtalo de nuevo más tarde."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Términos y condiciones del programa Apple Beta Software no están disponibles. Intenta más tarde."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Términos y condiciones del programa Apple Beta Software no están disponibles. Intenta más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software Program ‑ohjelman käyttöehdot eivät ole tällä hetkellä saatavilla. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conditions générales relatives au Programme de logiciels bêta d’Apple ne sont pas disponibles pour le moment. Réessayez plus tard."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modalités du programme de logiciels bêta d’Apple ne sont pas disponibles pour l’instant. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקנון של תוכנית Apple Beta Software אינו זמין כעת. נא לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software प्रोग्राम के लिए नियम व शर्तें अभी उपलब्ध नहीं हैं। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odredbe i uvjeti Apple Beta Software programa trenutačno nisu dostupni. Pokušajte kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Beta Software program használati feltételei jelenleg nem érhetők el. Próbálkozzon újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Syarat dan Ketentuan untuk Program Apple Beta Software tidak tersedia saat ini. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento, i termini e le condizioni dell’Apple Beta Software Program non sono disponibili. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Beta Software Programの利用規約は現在表示できません。あとでやり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Apple 베타 소프트웨어 프로그램의 이용 약관을 확인할 수 없습니다. 나중에 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terma dan syarat untuk Program Apple Beta Software tidak tersedia pada masa ini. Cuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkår og betingelser for Apple Beta Software-programmet er ikke tilgjengelig nå. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorwaarden voor het Apple Beta Software-programma zijn momenteel niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunki i zasady Apple Beta Software Program nie są aktualnie dostępne. Spróbuj ponownie później."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os termos e condições do Programa Apple Beta Software não estão disponíveis no momento. Tente novamente mais tarde."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento, os termos e condições do Apple Beta Software Program não se encontram disponíveis. Volte a tentar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Termenele și condițiile pentru programul Apple Beta Software nu sunt disponibile momentan. Reîncercați mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условия использования Программы бета-тестирования Apple в настоящий момент недоступны. Повторите попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmluvné podmienky pre Apple Beta Software Program momentálne nie sú k dispozícii. Skúste to znovu neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogoji in določila programa programske opreme Apple Beta trenutno niso na voljo. Poskusite znova pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Villkoren för Apple Beta Software Program är inte tillgängliga just nu. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อกำหนดและเงื่อนไขสำหรับโปรแกรม Apple Beta Software ไม่พร้อมใช้ในตอนนี้ ลองอีกครั้งในภายหลัง"
