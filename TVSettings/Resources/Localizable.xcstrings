    "NetworkTroubleshootingItemDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Apple TV الخاص بك غير متصل بالإنترنت. للمساعدة، حدد \"اكتشاف الأخطاء وإصلاحها\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV no està connectat a internet. Si vols ajuda selecciona “Solució de problemes”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV není připojena k internetu. Vyhledejte informace v Řešení potíží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Apple TV-enhed har ikke forbindelse til internettet. Vælg Fejlfinding for at få hjælp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple TV ist nicht mit dem Internet verbunden. Suche in der Fehlerbehebung nach Lösungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV δεν είναι συνδεδεμένο στο Διαδίκτυο. Για βοήθεια, επιλέξτε «Αντιμετώπιση προβλημάτων»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. For help, select Troubleshooting."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. For help, select Troubleshooting."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV isn’t connected to the internet. For help, select Troubleshooting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV no está conectado a internet. Para obtener ayuda, selecciona “Solución de problemas”."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no está conectado a Internet. Selecciona Solución de problemas para obtener ayuda."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple TV no está conectado a Internet. Selecciona Solución de problemas para obtener ayuda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ei ole yhteydessä internetiin. Lisäohjeita löydät valitsemalla Vianmäärityksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Pour obtenir de l’aide, sélectionnez Dépannage."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple TV n’est pas connectée à Internet. Sélectionnez Dépannage pour obtenir de l’aide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV אינו מחובר לאינטרנט. לקבלת עזרה, יש לבחור ב״פתרון בעיות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple TV इंटरनेट से कनेक्टेड नहीं है। सहायता के लिए समस्या निवारण चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Apple TV nije spojen na internet. Za pomoć odaberite\nopciju: U slučaju problema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV nem csatlakozik az internethez. A Hibaelhárítás kiválasztásával kaphat segítséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV Anda tidak dapat terhubung ke internet. Untuk bantuan, pilih Penyelesaian Masalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV non è connessa a internet. Seleziona “Risoluzione dei problemi” per ottenere aiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVがインターネットに接続されていません。ヘルプを表示するには、“トラブルシューティング”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV가 인터넷에 연결되어 있지 않습니다. 도움말을 보려면 문제 해결을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV anda tidak disambungkan ke Internet. Untuk mendapatkan bantuan, pilih Penyelesaian Masalah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV-enheten er ikke koblet til internett. Velg Feilsøking for å få hjelp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple TV kan geen verbinding maken met het internet. Selecteer 'Problemen oplossen' voor hulp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nie ma połączenia z Internetem. Aby uzyskać pomoc, wybierz Rozwiązywanie problemów."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está conectada à internet. Para obter ajuda, selecione Resolução de Problemas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não está ligada à internet. Encontrará ajuda na secção Resolução de problemas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV‑ul dvs. nu este conectat la internet. Pentru asistență, selectați Depanare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не подключен к интернету. Обратитесь за помощью к разделу «Устранение проблем»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše Apple TV nie je pripojené na internet. Pre pomoc vyberte Riešenie problémov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV nima vzpostavljene internetne povezave. Za pomoč izberite možnost Odpravljanje težav."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV är inte ansluten till internet. Välj Felsökning för att få hjälp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ของคุณไม่ได้เชื่อมต่อกับอินเทอร์เน็ต ให้เลือกวิธีแก้ปัญหาสำหรับความช่วยเหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’niz internete bağlı değil. Yardım için Sorun Giderme’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Apple TV не має інтернет-зʼєднання. За порадою перейдіть до «Виявлення неполадок»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV của bạn không được kết nối vào internet. Để được trợ giúp, chọn Khắc phục sự cố."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV尚未接入互联网。请选择“故障排除”以获得帮助。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV尚未連接互聯網。請選擇「疑難排解」以取得輔助説明。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的Apple TV並未連接網際網路。如需相關協助，請選取「疑難排解」。"
          }
        }
      }
    },
