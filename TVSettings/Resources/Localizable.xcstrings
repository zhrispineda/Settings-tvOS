        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemskärmen uppdateras när du byter siffersystem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอโฮมของคุณจะแสดงผลใหม่เมื่อคุณเปลี่ยนระบบตัวเลขของคุณ"
