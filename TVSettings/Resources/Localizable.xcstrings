    "AXReduceTransparencyDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "تحسين التباين من خلال تقليل الشفافية والضبابية في بعض الخلفيات بهدف زيادة الوضوح.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Augmenta el contrast reduint els valors de transparència i difuminat d’alguns fons per tal de millorar la llegibilitat.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "Zlepší na některých pozadích čitelnost a kontrast omezením průsvitnosti a rozostření.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Forøg kontrasten ved at reducere gennemsigtighed og sløringer på nogle baggrunde, så læsbarheden forøges.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Erhöhe den Kontrast durch Reduzieren von Transparenz und Weichzeichnungen bei manchen Hintergründen, um die Lesbarkeit zu verbessern.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Βελτίωση της αντίθεσης σε κάποια φόντα μέσω μείωσης της διαφάνειας και του θαμπώματος για αύξηση της αναγνωσιμότητας.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Improve contrast by reducing transparency and blurs on some backgrounds to increase legibility.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Improve contrast by reducing transparency and blurs on some backgrounds to increase legibility.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Improve contrast by reducing transparency and blurs on some backgrounds to increase legibility.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Improve contrast by reducing transparency and blurs on some backgrounds to increase legibility.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Improve contrast by reducing transparency and blurs on some backgrounds to increase legibility.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Mejora el contraste reduciendo la transparencia y el desenfoque de algunos fondos para aumentar la legibilidad.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Aumenta el contraste al reducir la transparencia y el difuminado en el fondo para mejorar la legibilidad.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Aumenta el contraste al reducir la transparencia y el difuminado en el fondo para mejorar la legibilidad.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Lisää kontrastia vähentämällä joidenkin taustojen läpinäkyvyyttä ja sumennusta. Tämä parantaa luettavuutta.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Améliorez le contraste de certains arrière-plans en réduisant la transparence et le flou pour augmenter la lisibilité.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Ajuste le contraste pour réduire la transparence, améliorer la netteté de certains arrière-plans et augmenter la lisibilité.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "ניתן לשפר את הניגודיות על ידי הפחתת השקיפות והטשטוש ברקעים מסוימים כדי לשפר את נוחות הקריאה.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "सुपाठ्यता बढ़ाने के लिए कुछ बैकग्राउंड की पारदर्शिता और धुँधलापन कम करके कॉन्ट्रास्ट बढ़ाएँ।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Povećajte kontrast smanjenjem prozirnosti i zamagljenja na nekim pozadinama kako biste poboljšali čitljivost.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Az olvashatóság érdekében javíthatja a kontrasztot az átlátszóság és néhány háttér elmosódásának csökkentésével.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Tingkatkan kontras dengan mengurangi transparansi dan pengaburan di beberapa latar belakang agar lebih mudah dibaca.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Migliora il contrasto riducendo la trasparenza e le sfocature di alcuni sfondi per aumentare la leggibilità.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "文字を判読しやすくするために、一部の背景の透明度とぼかしの度合いを低減してコントラストを調整します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "가독성을 높이기 위해 일부 배경의 투명도 및 흐림 효과를 줄여서 대비를 향상시킵니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Tingkatkan kontras dengan mengurangkan kelutsinaran dan kabur pada sesetengah latar belakang untuk meningkatkan kemudahbacaan.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Verbeter het contrast door de doorzichtigheid en vervaging voor sommige achtergronden te verminderen om de leesbaarheid te vergroten.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Forbedre kontrasten ved å redusere gjennomsiktighet og uskarpheter i noen bakgrunner for å øke lesbarheten.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Poprawia kontrast na niektórych tłach (redukując przezroczystość i rozmycia), aby zwiększyć czytelność elementów interfejsu użytkownika.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Melhora o contraste reduzindo a transparência e o desfoque em alguns fundos para aumentar a legibilidade.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Melhora o contraste, reduzindo a transparência e o desfocado em alguns fundos, para aumentar a legibilidade.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Îmbunătățiți contrastul prin reducerea transparenței și estompărilor pe unele fundaluri pentru a spori lizibilitatea.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Повысить контраст (снизив прозрачность и размытие на некоторых фонах), чтобы текст читался легче.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Zlepší kontrast a čitateľnosť na niektorých pozadiach obmedzením priehľadnosti a rozostrení.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Izboljšajte kontrast z zmanjšanjem prosojnosti in zameglitev na nekaterih ozadjih, da izboljšate berljivost.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Förbättra kontrasten genom att göra vissa bakgrunder mindre genomskinliga och mer skarpa så att läsbarheten ökar.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "ปรับปรุงความต่างระดับสีโดยลดความโปร่งใสและการเบลอบนพื้นหลังบางส่วนเพื่อเพิ่มความชัดเจน",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Bazı arka planlarda okunurluğu artırmak için saydamlığı ve bulanıklığı azaltarak kontrastı artırır.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Покращити контрастність і спростити сприйняття тексту шляхом зменшення прозорості й розмиття для деяких типів тла.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Cải thiện độ tương phản bằng cách giảm độ trong suốt và độ mờ trên một số nền để tăng khả năng đọc.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "通过降低部分背景的透明度和模糊度来增强对比度，以提高易读性。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "減少部份背景的透明度和模糊效果以提升對比度及增加易讀性。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "減少部分背景的透明度和模糊效果來改進對比和增加易讀性。",
            "state": "translated"
          }
        }
      }
    },
