    "RCLearnRemoteInactivityText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إشارة. تأكد أن الريموت لديك قيد التشغيل، وأنه ضمن النطاق، وموجه إلى الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha detectat cap senyal. Comprova que el comandament funcioni, estigui a l’abast i apuntant cap a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl přijat žádný signál. Ujistěte se, že je ovladač v dosahu, funkční a namířený na Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke registreret noget signal. Kontroller, at din fjernbetjening virker, er inden for rækkevidde og peger mod Apple TV-enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Signal entdeckt. Vergewissere dich, dass die Fernbedienung funktioniert, sich in Reichweite befindet und in Richtung Apple TV zeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εντοπίστηκε σήμα. Βεβαιωθείτε ότι το τηλεχειριστήριο λειτουργεί, είναι εντός εμβέλειας και κοιτά προς το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No signal detected. Make sure your remote is working, in range, and pointed towards the Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No signal detected. Make sure your remote is working, in range and pointed towards the Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No signal detected. Make sure your remote is working, in range and pointed towards the Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha detectado ninguna señal. Asegúrate de que el mando funciona y está dentro del radio de alcance y enfocado hacia el Apple TV."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó ninguna señal. Asegúrate de que el control esté funcionando, esté dentro del alcance y apunte hacia el Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó ninguna señal. Asegúrate de que el control esté funcionando, esté dentro del alcance y apunte hacia el Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaalia ei havaittu. Varmista, että kaukosäädin toimii, on kantaman sisällä ja osoitat sitä Apple TV:tä kohti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal détecté. Assurez-vous que votre télécommande fonctionne, qu’elle est à portée de votre Apple TV et dirigée vers cette dernière."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal détecté. Assurez-vous que la télécommande fonctionne, qu’elle est à portée et orientée vers l’Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא זוהה אות. יש לוודא שהשלט פועל, נמצא בטווח ומכוון אל ה-Apple TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सिग्नल प्राप्त नहीं हुआ। निश्चित करें कि आपका रिमोट चालू हो, रेंज में हो और Apple TV की ओर हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal nije detektiran. Provjerite radi li upravljač ispravno, je li u dometu i okrenut prema Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem észlelhető jel. Győződjön meg róla, hogy a távirányító működik, hatótávon belül van, és az Apple TV felé néz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada sinyal yang terdeteksi. Pastikan remote Anda berfungsi, dalam jangkauan, dan diarahkan ke Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato rilevato alcun segnale. Assicurati che il telecomando sia funzionante, nel raggio di azione e correttamente rivolto verso Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号を受信できませんでした。リモコンが動作していて、通信圏内にあり、Apple TVに向けられていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 신호가 없습니다. 사용자의 리모컨이 작동하고 있고, 범위 내에 있으며, Apple TV를 향하고 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada isyarat dikesan. Pastikan kawalan jauh anda berfungsi, berada dalam liputan dan dituding ke arah Apple TV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottar ingen signaler. Kontroller at fjernkontrollen virker, er innenfor rekkevidde og er rettet mot Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen signaal. Controleer of de afstandsbediening goed werkt, zich binnen bereik bevindt en naar de Apple TV wijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto sygnału. Upewnij się, że pilot działa, jest w zasięgu i jest skierowany w stronę Apple TV."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum sinal detectado. Certifique-se de que o controle remoto está funcionando, dentro do alcance e apontado na direção da Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi detetado nenhum sinal. Certifique‑se de que o comando está a funcionar e se encontra dentro do alcance do dispositivo, e aponte‑o para a Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun semnal detectat. Asigurați‑vă că telecomanda dvs. este funcțională, în raza de acțiune și îndreptată spre Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал отсутствует. Убедитесь, что пульт работает, находится в радиусе действия и направлен в сторону Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny signál. Uistite sa, že je váš ovládač funkčný, v dosahu a nasmerovaný na Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni signala. Prepričajte se, da vaš daljinec deluje, da je v dosegu in da je usmerjen proti Apple TV-ju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen signal upptäckt. Kontrollera att fjärrkontrollen fungerar, är inom räckvidd och är riktad mot Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสัญญาณ ให้แน่ใจว่ารีโมทของคุณทำงานอยู่และอยู่ในระยะที่กำหนด และชี้ไปทาง Apple TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal alınamadı. Kumandanızın çalışır durumda, kapsama alanında ve Apple TV’ye yöneltilmiş olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналу не виявлено. Переконайтеся, що пульт працює, перебуває у полі дії і наведено на Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tín hiệu. Đảm bảo điều khiển từ xa của bạn đang hoạt động, ở trong phạm vi và được hướng vào Apple TV."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
