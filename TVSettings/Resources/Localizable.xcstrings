    "APDescriptionText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع البث السريع، يمكنك بث ما يظهر على جهاز iOS أو الكمبيوتر إلى هذا الـ Apple TV. \n\nلمزيد من المعلومات، انتقل إلى:\nsupport.apple.com/ar-ae/apple-tv"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb l’AirPlay pots reproduir contingut del dispositiu iOS o l’ordinador a l’Apple TV. \n\nPer a més informació, ves a support.apple.com/es-es/apple-tv."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přes AirPlay můžete do Apple TV streamovat obsah z iOS zařízení a počítačů. \n\nDalší informace najdete na stránce apple.com/cz/support/appletv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med AirPlay kan du streame det, der er på iOS-enheden eller computeren, til Apple TV. \n\nDer er flere oplysninger på support.apple.com/da-dk/apple-tv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit AirPlay kannst du Inhalte von deinem iOS-Gerät oder Computer auf dieses Apple TV streamen. \n\nWeitere Informationen sind unter apple.com/de/support/appletv erhältlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με το AirPlay μπορείτε να αναπαράγετε στο Apple TV αυτά που βρίσκονται στη συσκευή iOS ή τον υπολογιστή σας. \n\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση support.apple.com/el-gr/apple-tv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With AirPlay, you can stream what’s on your iOS device or computer to this Apple TV. \n\nFor more information, go to support.apple.com/appletv."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "With AirPlay, you can stream what’s on your iOS device or computer to this Apple TV. \n\nFor more information, go to support.apple.com/appletv"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With AirPlay, you can stream what’s on your iOS device or computer to this Apple TV. \n\nFor more information, go to support.apple.com/en-gb/apple-tv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias a AirPlay, puedes reproducir en tiempo real en este Apple TV lo que se ve en el dispositivo iOS o en el ordenador. \n\nPara más información, visita support.apple.com/es-es/apple-tv."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Con AirPlay puedes transmitir lo que se muestra en tu dispositivo iOS o computadora a este Apple TV. \n\nPara más información, visita https://support.apple.com/es-lamr/apple-tv."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Con AirPlay puedes transmitir lo que se muestra en tu dispositivo iOS o computadora a este Apple TV. \n\nPara más información, visita https://support.apple.com/es-lamr/apple-tv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlaylla voit striimata iOS-laitteen tai tietokoneen sisällön tässä Apple TV:ssä. \n\nLisätietoja löytyy osoitteesta https://support.apple.com/fi-fi/apple-tv"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec AirPlay, diffusez le contenu de votre appareil iOS ou ordinateur sur cette Apple TV. \n\nRendez-vous sur apple.com/fr/support/appletv pour en savoir plus."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Grâce à AirPlay, vous pouvez diffuser le contenu de votre appareil iOS ou de votre ordinateur sur cette Apple TV. \n\nPour en savoir plus, consultez support.apple.com/fr-ca/apple-tv."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באמצעות AirPlay, ניתן להזרים תוכן ממכשיר ה-iOS או מהמחשב שלך ל-Apple TV זה. \n\nמידע נוסף זמין בכתובת: support.apple.com/appletv."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay के उपयोग से आप अपने iOS डिवाइस या कंप्यूटर के कॉन्टेंट को इस Apple TV पर स्ट्रीम कर सकते हैं। \n\nज़्यादा जानकारी के लिए support.apple.com/appletv पर जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay vam omogućava streaming sadržaja s vašeg iOS uređaja ili računala na ovaj Apple TV. \n\nZa dodatne informacije posjetite support.apple.com/appletv."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AirPlayjel streamelheti az iOS-eszköze vagy számítógépe kijelzőjének tartalmát erre az Apple TV-re. \n\nTovábbi információkért keresse fel a https://support.apple.com/hu-hu/apple-tv weboldalt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan AirPlay, Anda dapat melakukan streaming konten perangkat iOS atau komputer Anda ke Apple TV ini. \n\nUntuk informasi lainnya, buka support.apple.com/id-id/apple-tv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con AirPlay, puoi riprodurre in streaming i contenuti di un dispositivo iOS o di un computer su Apple TV. \n\nPer ulteriori informazioni, vai alla pagina www.apple.com/it/support/appletv."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayを使うと、iOSデバイスやコンピュータの画面をこのApple TVにストリーミングできます。 \n\n詳しくは、support.apple.com/ja-jp/apple-tv を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay를 사용하여 iOS 기기나 컴퓨터의 화면을 Apple TV로 스트림할 수 있습니다. \n\n자세한 사항은 support.apple.com/appletv 사이트를 참조하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan AirPlay, anda boleh menstrim kandungan peranti iOS atau komputer anda ke Apple TV ini. \n\nUntuk mendapatkan maklumat lanjut, pergi ke support.apple.com/en-my/apple-tv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med AirPlay kan du strømme fra en iOS-enhet eller datamaskin til Apple TV. \n\nFinn ut mer på support.apple.com/appletv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met AirPlay kun je het beeld van je iOS-apparaat of computer naar deze Apple TV streamen. \n\nGa voor meer informatie naar support.apple.com/appletv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay pozwala bezprzewodowo strumieniować zawartość z urządzenia iOS lub komputera na ten Apple TV. \n\nAby uzyskać więcej informacji, odwiedź stronę www.apple.com/pl/support/appletv."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o AirPlay, você pode transmitir o que está no seu dispositivo iOS ou computador para esta Apple TV. \n\nPara obter mais informações, acesse support.apple.com/appletv."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com AirPlay, pode transmitir para esta Apple TV o que está no seu dispositivo iOS ou computador. \n\nEncontrará informação adicional em support.apple.com/pt-pt/apple-tv."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu AirPlay, puteți să difuzați conținutul de pe un dispozitiv iOS sau computer pe acest Apple TV. \n\nPentru mai multe informații, accesați support.apple.com/appletv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через AirPlay можно выполнять потоковую передачу контента с устройства iOS или компьютера на этот Apple TV. \n\nПодробнее на сайте support.apple.com/ru-ru/apple-tv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay vám umožňuje streamovať obsah z vášho iOS zariadenia alebo počítača na toto Apple TV. \n\nViac informácií nájdete na stránke support.apple.com/appletv."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S funkcijo AirPlay lahko v ta Apple TV pretakate vsebino iz svoje naprave iOS ali računalnika. \n\nZa več informacij pojdite na support.apple.com/appletv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med AirPlay kan du streama innehållet på din iOS-enhet eller dator till denna Apple TV. \n\nMer information finns på https://support.apple.com/sv-se/apple-tv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถใช้ AirPlay สตรีมสิ่งต่างๆ ที่อยู่บนอุปกรณ์ iOS หรือคอมพิวเตอร์ของคุณมาที่ Apple TV เครื่องนี้ได้ \n\nสำหรับข้อมูลเพิ่มเติม ให้ไปที่ support.apple.com/th-th/apple-tv"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay ile iOS aygıtınızdakileri veya bilgisayarınızdakileri bu Apple TV’de yayımlayabilirsiniz. \n\nDaha fazla bilgi için support.apple.com/appletv adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через AirPlay можна транслювати медіавміст із пристрою iOS або компʼютера на цей Apple TV. \n\nДокладну інформацію наведено на вебсторінці support.apple.com/uk-ua/apple-tv."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với AirPlay, bạn có thể truyền phát nội dung trên thiết bị iOS hoặc máy tính của bạn đến Apple TV này. \n\nĐể biết thêm thông tin, hãy truy cập support.apple.com/appletv."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过隔空播放，你可以将iOS设备或电脑上的内容流化发送至这台Apple TV。 \n\n更多信息请访问support.apple.com/appletv。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以利用AirPlay串流iOS裝置或電腦上的資料至此Apple TV。 \n\n詳情請瀏覽support.apple.com/zh-hk/apple-tv。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有了AirPlay，你可將iOS裝置或電腦上的內容連續播送到此Apple TV。 \n\n如需更多資訊，請前往：www.apple.com/tw/support/appletv"
          }
        }
      }
    },
