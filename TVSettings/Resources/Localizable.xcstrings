          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מצאנו את מספר הפניה הזה. נא לבדוק את המספר ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें यह टिकट संख्या नहीं मिली। संख्या की जाँच करें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
