          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "VoiceOver énonce les éléments affichés à l’écran et fournit des informations utiles.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "המאפיין VoiceOver מקריא פריטים שנמצאים על המסך ומספק רמזים מועילים.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "VoiceOver स्क्रीन पर मौजूद आइटम को बोलकर बताता है और सहायक जानकारी प्रदान करता है।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "VoiceOver čita stavke na zaslonu i pruža korisne savjete.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "A VoiceOver felolvassa a képernyőn látható elemeket, és hasznos tippeket nyújt.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "VoiceOver mengucapkan item pada layar dan menyediakan petunjuk bermanfaat.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "VoiceOver legge gli elementi presenti sullo schermo e fornisce suggerimenti utili.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "VoiceOverは画面上の項目を読み上げ、役立つヒントを提供します。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "VoiceOver는 화면에 있는 항목을 음성으로 설명하여 도움이 되는 힌트를 제공합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "VoiceOver menyebut item pada skrin dan memberikan pembayang yang berguna.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "VoiceOver spreekt onderdelen op het scherm uit en biedt nuttige aanwijzingen.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "VoiceOver leser opp objektene på skjermen og gir hjelpsomme hint.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "VoiceOver odczytuje rzeczy na ekranie i zapewnia przydatne wskazówki.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "O VoiceOver lê os itens na tela em voz alta e oferece dicas úteis.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "O VoiceOver enuncia os elementos apresentados no ecrã e oferece sugestões úteis.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "VoiceOver enunță articolele de pe ecran și oferă sfaturi utile.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "VoiceOver произносит названия объектов на экране и предоставляет полезные подсказки.",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "VoiceOver nahlas číta položky na obrazovke a poskytuje užitočnú nápovedu.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "VoiceOver izgovarja elemente na zaslonu in podaja priročne napotke.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "VoiceOver läser upp objekten på skärmen och ger användbar hjälp.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "VoiceOver อ่านออกเสียงสิ่งที่เลือกบนหน้าจอและให้คำแนะนำที่เป็นประโยชน์",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "VoiceOver ekrandaki öğeleri seslendirir ve yardımcı ipuçları sunar.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "VoiceOver промовляє елементи на екрані та надає корисні підказки.",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "VoiceOver đọc các mục trên màn hình và cung cấp các gợi ý hữu ích.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "“旁白”会朗读屏幕上的项目并提供帮助性提示。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "「旁白」會朗讀螢幕上的項目並提供有用提示。",
