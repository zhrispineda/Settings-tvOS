    "AVAudioLanguageTitleDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا اخترت \"تلقائي\"، فسيتم تشغيل الفيديوهات بلغتها الافتراضية أو الأصلية تلقائيًا. وفي حالة تعيين لغة صوت مختلفة، سيشغِّل Apple TV صوتًا مدبلجًا بهذه اللغة عند توفره."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si selecciones l’opció automàtica, els vídeos es reproduiran automàticament en l’idioma original o per omissió. Per contra, si configures l’àudio en un altre idioma, l’app TV reproduirà el contingut doblat, sempre que estigui disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnutá volba Automaticky, videa se budou automaticky přehrávat ve výchozím nebo původním jazyce. Pokud nastavíte jiný jazyk, Apple TV bude přehrávat nadabovanou verzi ve vybraném jazyce (je‑li k dispozici)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vælger Auto, bliver videoer automatisk afspillet på standard- eller originalsproget. Hvis du indstiller et andet sprog til lyd, afspiller Apple TV dubbet lyd på det pågældende sprog, når det er tilgængeligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du „Automatisch“ auswählst, werden Videos automatisch in der Standard- oder Originalsprache wiedergegeben. Wenn du eine andere Audiosprache festlegst, gibt das Apple TV eine Audiospur in dieser Sprache wieder, falls verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν επιλέξετε τη ρύθμιση «Αυτόματα», τα βίντεο θα αναπαράγονται αυτόματα στην προεπιλεγμένη ή την αρχική γλώσσα τους. Αν επιλέξετε διαφορετική γλώσσα ήχου, το Apple TV θα αναπαράγει μια μεταγλωττισμένη έκδοση σε αυτήν τη γλώσσα όταν είναι διαθέσιμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you choose Auto, videos will automatically play in their default or original language. If you set a different audio language, Apple TV will play dubbed audio in that language when available."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you choose Auto, videos will automatically play in their default or original language. If you set a different audio language, Apple TV will play dubbed audio in that language when available."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you choose Auto, videos will automatically play in their default or original language. If you set a different audio language, Apple TV will play dubbed audio in that language when available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliges Automático, los vídeos se reproducirán automáticamente en el idioma original o por omisión. Si configuras otro idioma, el Apple TV reproducirá el audio doblado en esa lengua cuando esté disponible."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si seleccionas Automático, los videos se reproducirán automáticamente en su idioma original o predeterminado. Si configuras otro idioma, el Apple TV reproducirá la versión doblada si está disponible."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si seleccionas Automático, los videos se reproducirán automáticamente en su idioma original o predeterminado. Si configuras otro idioma, el Apple TV reproducirá la versión doblada si está disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos valitset Automaattinen, videot toistetaan automaattisesti niiden oletus- tai alkuperäiskielellä. Jos valitset äänelle toisen kielen, Apple TV toistaa äänen päällepuhuttuna kyseisellä kielellä, jos se on saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous choisissez Auto, les vidéos seront automatiquement lues dans leur langue par défaut ou d’origine. Si vous choisissez une langue différente pour l’audio, l’Apple TV activera le doublage audio de cette langue lorsque celle-ci est disponible."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous choisissez « Auto. », les vidéos sont automatiquement diffusées dans la langue par défaut ou d’origine. Si vous définissez une langue audio différente, l’Apple TV fait jouer la version doublée dans cette langue, si elle est disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם בחרת באפשרות ״אוטומטית״, סרטונים יופעלו בשפת ברירת המחדל או בשפת המקור שלהם באופן אוטומטי. אם תוגדר שפה אחרת לשמע, ה‑Apple TV יפעיל דיבוב לשפה זו, אם האפשרות זמינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप ऑटो चुनते हैं, तो वीडियो ऑटोमैटिकली उनकी डिफ़ॉल्ट या मूल भाषा में चलाए जाएँगे। अगर आप कोई अलग ऑडियो भाषा सेट करते हैं, तो Apple TV उपलब्ध होने पर उस भाषा में डब किया गया ऑडियो चलाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odaberete Automatski, videozapisi će se automatski reproducirati na svom standardnom ili originalnom jeziku. Ako podesite drugi jezik audio zapisa, Apple TV reproducirat će sinkronizirani dijalog na tom jeziku kad bude dostupan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az Automatikus beállítást választja, a videók automatikusan az alapértelmezett vagy eredeti nyelven lesznek lejátszva. Ha másik nyelvet állít be a hanghoz, az Apple TV az adott nyelvre szinkronizált verziót fogja lejátszani, amennyiben elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda memilih Otomatis, video akan diputar secara otomatis dalam bahasa default atau aslinya. Jika Anda mengatur bahasa audio yang berbeda, Apple TV akan memutar audio yang disulih dalam bahasa tersebut jika tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionando l’opzione automatica, i video verranno riprodotti automaticamente nella lingua di default o in quella originale. Se invece imposti una lingua audio differente, Apple TV riprodurrà il contenuto nella versione doppiata, quando disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“自動”を選択すると、デフォルトまたは元の言語で自動的にビデオが再生されます。異なる音声の言語を設定すると、Apple TVで多重音声がある場合はその言語で再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘자동’을 선택하면 비디오가 자동으로 기본 언어 또는 원어로 재생됩니다. 오디오 언어를 다른 언어로 설정하면, 가능한 경우 Apple TV가 해당 언어로 더빙된 오디오를 재생합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda memilih Auto, video akan dimainkan dalam bahasa lalai atau asal secara automatik. Jika anda mengesetkan bahasa audio berbeza, Apple TV akan memainkan audio yang dialih suara dalam bahasa tersebut apabila tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du velger Auto, spilles videoer automatisk av på standard- eller originalspråket. Hvis du velger et annet lydspråk, vil Apple TV spille av dubbet lyd på det språket hvis tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je 'Automatisch' kiest, worden video's automatisch afgespeeld in de standaardtaal of de originele taal. Als je een andere audiotaal instelt, speelt de Apple TV gesynchroniseerde audio af in die taal, indien beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy używasz automatycznego wyboru języka, wideo są odtwarzane w języku domyślnym lub oryginalnym. Gdy wybierzesz inny język ścieżki dźwiękowej, Apple TV będzie odtwarzać dubbing w tym języku, gdy jest dostępny."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você escolher Automático, os vídeos serão reproduzidos automaticamente no idioma padrão ou original. Se você definir um idioma de áudio diferente, a Apple TV reproduzirá áudio dublado nesse idioma, quando disponível."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escolher Automático, os vídeos serão reproduzidos automaticamente no idioma predefinido ou original. Se definir um idioma diferente para o áudio, a Apple TV reproduzirá áudio dobrado nesse idioma sempre que disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă alegeți „Automată”, conținutul video va fi redat automat în limba implicită sau originală. Dacă alegeți altă limbă audio, Apple TV‑ul va reda dublajul audio în limba respectivă atunci când este disponibilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выбран вариант «Авто», видео будут автоматически воспроизводиться на языке по умолчанию или на языке оригинала. Если для аудио задан другой язык, Apple TV воспроизведет дублированную аудиодорожку на этом языке при ее наличии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vyberiete možnosť Automaticky, videá budú prehrávané v predvolenom alebo pôvodnom jazyku. Ak nastavíte iný jazyk audia, Apple TV bude prehrávať dabing v danom jazyku, ak je k dispozícii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če izberete samodejno možnost, se bodo videi samodejno predvajali v privzetem ali izvirnem jeziku. Če nastavite drug jezik zvoka, bo Apple TV predvajal sinhronizirani zvok v tem jeziku, kadar je ta na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du väljer Auto spelas videor automatiskt upp på det förvalda språket eller ursprungsspråket. Om du ställer in ett annat ljudspråk spelar Apple TV upp dubbat ljud på det språket om det är tillgängligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณเลือกอัตโนมัติ วิดีโอจะเล่นโดยอัตโนมัติในภาษาเริ่มต้นหรือในภาษาดั้งเดิม ถ้าคุณตั้งค่าเป็นภาษาเสียงอื่น Apple TV จะเล่นเสียงพากย์ในภาษานั้นหากมี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik’i seçerseniz videolar otomatik olarak saptanmış veya özgün dillerinde oynatılır. Farklı bir seslendirme dili ayarlarsanız Apple TV seslendirmeyi varsa bu dilde çalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вибрати «Автоматично», відео автоматично відтворюватимуться типовою мовою або мовою оригіналу. Якщо задано іншу мову, Apple TV відтворюватиме дубльовану аудіодоріжку цією мовою, коли це можливо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn lựa chọn Tự động thì các video sẽ tự động phát bằng ngôn ngữ gốc hoặc mặc định của chúng. Nếu bạn đặt một ngôn ngữ âm thanh khác thì Apple TV sẽ phát âm thanh lồng tiếng bằng ngôn ngữ đó khi khả dụng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若选取“自动”，视频将自动以默认或原始语言播放。若设置为其他音频语言，Apple TV将在该语言可用时播放配音音频。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如選擇「自動」，影片將會自動以預設語言或原始語言播放。如設定其他音訊語言，Apple TV將會在該語言可用時播放配音音訊。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若選擇「自動」，影片會自動以預設語言或原始語言播放。若設定其他音訊語言，Apple TV將在該語言可用時播放配音的音訊。"
          }
        }
      }
    },
