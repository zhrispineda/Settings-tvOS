    "iTMSFreeYesDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم التنزيلات المجانية الخاصة بك نفس القيود المستخدمة في شراء التطبيقات وعمليات الشراء من داخل التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aplicaran a les descàrregues gratuïtes les mateixes restriccions que a les compres d’apps i a les compres integrades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro bezplatná stahování budou použita tatáž omezení jako pro nákupy aplikací a nákupy v aplikacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis overførsler vil bruge de samme begrænsninger som dine appkøb og køb i app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Downloads verwenden dieselben Einschränkungen wie deine App-Käufe und In-App-Käufe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δωρεάν λήψεις θα χρησιμοποιούν τους ίδιους περιορισμούς όπως οι αγορές εφαρμογών και οι αγορές εντός εφαρμογών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free downloads will use the same restrictions as your app purchases and In-App Purchases."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Free downloads will use the same restrictions as your app purchases and In-App Purchases."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Free downloads will use the same restrictions as your app purchases and In-App Purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas gratuitas utilizarán las mismas restricciones que las compras de apps y las compras dentro de la app."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas gratuitas seguirán las mismas restricciones de compras de apps y compras dentro de las apps."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas gratuitas seguirán las mismas restricciones de compras de apps y compras dentro de las apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaiset lataukset käyttävät samoja rajoituksia appiostojesi ja apeissa tekemiesi ostojen kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements gratuits seront soumis aux mêmes restrictions que les achats d’apps et les achats intégrés."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements gratuits seront soumis aux mêmes restrictions que les achats d’apps et les achats intégrés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדות ללא תשלום משתמשות באותן הגבלות כמו רכישות של יישומים ורכישות בתוך יישומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मुफ़्त डाउनलोड के लिए आपकी ख़रीदारी और इन-ऐप ख़रीदारी के समान ही प्रतिबंधों का उपयोग किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na besplatna preuzimanja primjenjivat će se ista ograničenja kao i na vaše kupnje aplikacija i In-App kupnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes letöltések ugyanazt a korlátozást fogják használni, mint az appvásárlások és appbeli vásárlások."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan gratis akan menggunakan pembatasan yang sama dengan pembelian app dan Pembelian Di App Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download gratuiti sono soggetti alle stesse restrizioni valide per gli acquisti standard e in-app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料ダウンロードにも、アプリ購入およびアプリ内課金と同じ制限が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 구입 및 앱 내 구입과 동일한 제한사항이 무료 다운로드 항목에도 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun percuma akan menggunakan pengehadan yang sama seperti pembelian app dan Pembelian In-App anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis nedlastinger vil ha samme restriksjoner som andre appkjøp og kjøp i app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor gratis downloads gelden dezelfde beperkingen\nals voor je app-aankopen en in-app aankopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie bezpłatnych rzeczy będzie podlegało takim samym wymogom jak zakupy aplikacji i zakupy w aplikacjach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads gratuitos usarão as mesmas restrições usadas para suas Compras Dentro de Apps."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As descargas grátis usam as mesmas restrições que as compras e compras integradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcările gratuite vor utiliza aceleași restricții ca și cele utilizate pentru cumpărarea aplicațiilor sau cumpărarea din aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для бесплатных загрузок будут действовать те же ограничения, что и для покупок в обычных приложениях и приложениях со встроенными покупками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sťahovanie bezplatných položiek sa bude riadiť rovnakými pravidlami ako nákupy apiek a nákupy v apkách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za brezplačne prenose veljajo enake omejitve kot za nakupe aplikacij in nakupe v aplikacijah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostnadsfria hämtningar kommer att använda samma begränsningar som dina köp av appar och köp inuti appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการดาวน์โหลดฟรีจะใช้ข้อจำกัดเดียวกันกับแอปที่คุณซื้อและการซื้อภายในแอปของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz indirilenler de uygulama satın alımlarınız ve Uygulama İçi Satın Alımlar ile aynı sınırlamaları kullanacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До безкоштовних викачувань застосовуватимуться такі самі обмеження, що й до придбаних програм і покупок у програмах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải về miễn phí sẽ sử dụng cùng các giới hạn mật khẩu như các giao dịch mua app và Mua In-App."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "免费下载将使用与App购买及App内购买相同的限制。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "免費下載項目將會使用與App購買項目和「App內購買」相同的限制。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "免費下載項目將會使用與App購買項目和「App內購買」相同的密碼限制。"
          }
        }
      }
    },
    "iTMSHDPreviewsOffDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستكون المعاينات بالدقة القياسية. يوصى بهذا الإعداد عندما يكون اتصال الإنترنت بطيئًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les previsualitzacions seran en definició estàndard. És l’opció recomanada si la connexió a internet és lenta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázky se budou přehrávat v standardní kvalitě. Toto nastavení je vhodné pro pomalé připojení k internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempler vil være i SD-format. Denne indstilling anbefales til en langsom internetforbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschauwiedergabe erfolgt im SD-Format. Diese Einstellung wird für langsame Internetverbindungen empfohlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προεπισκοπήσεις θα αναπαράγονται σε Τυπική ευκρίνεια (SD). Αυτή η ρύθμιση συνιστάται αν είναι αργή η ταχύτητα σύνδεσής σας στο Διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews will be in Standard Definition. This setting is recommended for a slow internet connection."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews will be in Standard Definition. This setting is recommended for a slow internet connection."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews will be in Standard Definition. This setting is recommended for a slow internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las previsualizaciones se verán en definición estándar. Este es el ajuste recomendado para conexiones a internet de baja velocidad."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avances estarán en definición estándar. Esta configuración se recomienda cuando la velocidad del Internet es baja."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avances estarán en definición estándar. Esta configuración se recomienda cuando la velocidad del Internet es baja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatselut toistetaan normaalitarkkuudella. Tätä asetusta suositellaan hitaalle internet-yhteydelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits seront en définition standard. Ce réglage est recommandé pour les connexions Internet lentes."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus seront en définition standard. Ce réglage est recommandé si votre connexion Internet est lente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגות מקדימות יוצגו באיכות רגילה. הגדרה זו מומלצת במקרה של חיבורי אינטרנט איטיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्यू स्टैंडर्ड डेफ़िनिशन में रहेंगे। यह सेटिंग धीमी गति वाले इंटरनेट कनेक्शन के लिए अनुशंसित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledi će biti u SD kvaliteti. Ovo podešenje preporučeno je za sporu internetsku vezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézetek normál felbontásban fognak megjelenni. Ez a beállítás lassú internetkapcsolat esetén javasolt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau akan berformat Definisi Standar. Pengaturan ini dianjurkan untuk koneksi internet lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anteprime verranno riprodotte in definizione standard. L’opzione è consigliata per connessioni a internet meno veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューが標準解像度になります。この設定はインターネットの接続速度が遅い場合に推奨されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기가 표준 화질(SD)로 재생됩니다. 이 설정은 인터넷 연결 속도가 느린 경우에 권장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton akan disediakan dalam Definisi Standard. Seting ini disyorkan untuk sambungan internet yang perlahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisninger vises i standard oppløsning. Innstillingen anbefales hvis internettforbindelsen er treg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorvertoningen worden afgespeeld in SD. Deze instelling wordt aangeraden voor een trage internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądy są odtwarzane w rozdzielczości SD. To ustawienie jest zalecane, jeśli masz wolne połączenie z Internetem."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré‑visualizações estarão em Definição Padrão (SD). Este ajuste é recomendado para uma conexão lenta à internet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os excertos serão em SD. A definição SD é recomendada para uma ligação lenta à internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizările vor avea definiție standard. Această configurare este recomandată dacă aveți o conexiune lentă la internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр контента будет воспроизводиться в формате SD. Этот вариант рекомендуется для медленного интернет-соединения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážky budú v štandardnom rozlíšení. Toto nastavenie sa odporúča pre pomalé internetové pripojenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predogledi bodo v standardni ločljivosti. Ta nastavitev je priporočljiva za počasne internetne povezave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsvisningar visas i standardupplösning. Den här inställningen rekommenderas om du har en långsam internetanslutning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงตัวอย่างจะเล่นในแบบความละเอียดมาตรฐาน แนะนำให้ใช้การตั้งค่านี้สำหรับการเชื่อมต่อกับอินเทอร์เน็ตความเร็วต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizlemeler Standart Çözünürlük’te gösterilir. Bu ayar, yavaş bir internet bağlantısı için önerilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передогляди відтворюватимуться у стандартній чіткості. Рекомендовано для повільного інтернет-зʼєднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản xem trước sẽ có định dạng Độ nét chuẩn. Cài đặt này được đề xuất cho kết nối internet chậm."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将以标准清晰度预览。推荐互联网连接较慢时使用此设置。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽會使用標準畫質播放。如果互聯網連線速度緩慢，建議使用此設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽將會以標準畫質格式顯示。此設定適用於低速網際網路連線。"
          }
        }
      }
    },
