    "APSecurityRequirePasswordDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُطلب منك إدخال كلمة السر التي قمت بإعدادها لاستخدام البث السريع على هذا الـ Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per transferir contingut a l’Apple TV per l’AirPlay s’haurà d’introduir la contrasenya que configuris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vás při spuštění přehrávání obsahu přes AirPlay vyzve k zadání hesla, které jste nastavili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal skrive den adgangskode, du indstillede, for at streame med AirPlay til dette Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst das von dir festgelegte Passwort eingeben, wenn du etwas mit AirPlay an dieses Apple TV sendest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα πρέπει να εισαγάγετε το συνθηματικό που θα καθορίσετε για χρήση του AirPlay σε αυτό το Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be required to enter the password you set to AirPlay to this Apple TV."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be required to enter the password you set to AirPlay to this Apple TV."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be required to enter the password you set to AirPlay to this Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar AirPlay para enviar contenido a este Apple TV se pedirá la contraseña que has definido."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te solicitará ingresar la contraseña que configures para transmitir por AirPlay a este Apple TV."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te solicitará ingresar la contraseña que configures para transmitir por AirPlay a este Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettamasi salasana on syötettävä, kun AirPlaylla toistetaan tähän Apple TV:hen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez entrer le mot de passe défini pour pouvoir diffuser du contenu sur cette Apple TV via AirPlay."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez entrer le mot de passe que vous avez défini pour utiliser AirPlay avec cette Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש ב-AirPlay ב-Apple TV זה, יש להזין את הסיסמה שהגדרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको इस Apple TV पर AirPlay के लिए अपना सेट किया गया पासवर्ड दर्ज करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od vas će biti zatražena lozinka koju ste podesili za korištenje AirPlaya na ovom Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meg kell adnia a beállított jelszót, amikor az AirPlayt használja ezen az Apple TV-n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan diharuskan untuk memasukkan kata sandi yang Anda atur untuk menggunakan AirPlay ke Apple TV ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare AirPlay su Apple TV, ti verrà richiesto di inserire la password che hai impostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVにAirPlayするために設定したパスワードの入力が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV로 AirPlay할 때 설정한 암호를 입력해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda perlu memasukkan kata laluan yang anda setkan untuk AirPlay ke Apple TV ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må oppgi passordet du har angitt for å bruke AirPlay med Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet het wachtwoord invoeren dat je hebt ingesteld om AirPlay te gebruiken op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumieniowanie przez AirPlay na ten Apple TV będzie wymagać podania ustawionego przez Ciebie hasła."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você terá que digitar a senha que definiu para o AirPlay nesta Apple TV."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser‑lhe‑á pedida a palavra‑passe que definiu para usar AirPlay nesta Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi se va solicita introducerea parolei pe care ați fixat‑o pentru a difuza prin AirPlay pe acest Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам потребуется вводить пароль, установленный Вами для трансляции через AirPlay на этот Apple TV."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV vás vždy pri spustení prehrávania obsahu cez AirPlay vyzve k zadaniu hesla, ktoré ste si nastavili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če boste želeli uporabljati funkcijo AirPlay s tem Apple TV-jem, boste morali vnesti geslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste ange lösenordet som du har ställt in när du vill använda AirPlay med denna Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะต้องป้อนรหัสผ่านที่คุณตั้งสำหรับ AirPlay กับ Apple TV เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV’ye AirPlay ile bağlanmak için ayarladığınız parolayı girmeniz gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагатиметься введення пароля, який ви задали для трансляції AirPlay на цей Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ phải nhập mật khẩu mà bạn đã đặt để phát AirPlay đến Apple TV này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "需要输入你设置的密码以通过这台Apple TV隔空播放。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay至此Apple TV時需要輸入你設定的密碼。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay到此Apple TV時必須輸入你設定的密碼。"
          }
        }
      }
    },
