    "TimeZoneLocationServicesWarningMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لتطبيق الإعدادات بتحديد موقعك لتعيين نطاقك الزمني."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que la configuració determini la zona horària."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci Nastavení vybrat časové pásmo na základě vaší polohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giver “Indstillinger” lov til at bestemme din lokalitet for at indstille din tidszone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube „Einstellungen“, deinen Standort zum Festlegen der Zeitzone zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να επιτρέπεται ο προσδιορισμός της τοποθεσίας σας από τις «Ρυθμίσεις» για καθορισμό της ζώνης ώρας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows “Settings” to determine your location to set your time zone."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Settings to determine your location to set your time zone."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Settings to determine your location to set your time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los ajustes puedan determinar tu ubicación para definir tu zona horaria."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Configuración determine tu ubicación para establecer tu zona horaria."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Configuración determine tu ubicación para establecer tu zona horaria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallii Asetusten määrittää sijaintisi aikavyöhykkeen asettamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’app Réglages à déterminer votre position pour définir votre fuseau horaire."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’app Réglages à déterminer votre position afin de définir votre fuseau horaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשאה זו מאפשרת ל״הגדרות״ לקבוע את המיקום שלך כדי לכוון את השעון המקומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका समय क्षेत्र सेट करने के लिए सेटिंग को आपका स्थान निर्धारित करने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućava “Postavkama” određivanje vaše lokacije radi podešavanja vaše vremenske zone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzóna beállításához engedélyezze a „Beállítások” számára az Ön helyzetének meghatározását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan “Pengaturan” untuk menentukan lokasi Anda untuk mengatur zona waktu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Impostazioni di determinare la tua posizione per configurare il fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯を設定するために“設定”で現在地を判断することを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대를 설정하기 위해 ‘설정’이 사용자의 위치를 확인하도록 허용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan “Seting” untuk menentukan lokasi anda untuk mengesetkan zon waktu anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat at Innstillinger kan bruke posisjonen din til å angi riktig tidssone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kan Instellingen je locatie bepalen om je tijdzone in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja „Ustawienia” będzie mogła określać Twoje położenie w celu ustawiania Twojej strefy czasowej."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que “Ajustes” determine a sua localização para definir o fuso horário."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Definições determine a sua localização para definir o fuso horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți aplicației „Configurări” să determine localizarea dvs. pentru a fixa fusul orar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить Настройкам определять Вашу геопозицию для установки часового пояса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apka Nastavenia bude môcť stanoviť vašu polohu a nastaviť časové pásmo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite možnosti »Nastavitve«, da določi vašo lokacijo in nastavi vaš časovni pas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt att ”Inställningar” fastställer din plats till att ställa in din tidszon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ “การตั้งค่า” พิจารณาตำแหน่งที่ตั้งของคุณเพื่อตั้งค่าไทม์โซนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ayarlar”ın saat diliminizi ayarlamak için konumunuzu belirlemesine izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша геопозиція визначатиметься Параметрами, щоб задати часовий пояс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép “Cài đặt” xác định vị trí của bạn để đặt múi giờ."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“设置”确定你的位置，以设定时区。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「設定」確定你的位置以設定時區。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「設定」來確認你的位置以設定時區。"
          }
        }
      }
    },
