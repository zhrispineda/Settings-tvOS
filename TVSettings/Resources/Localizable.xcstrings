    "NetworkSecureWiFiProfileLoadOK": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحميل ملف تعريف AppleWiFiSecure بنجاح.\n\nيرجى التأكد من قطع الاتصال من الإيثرنت لاستخدام AppleWiFiSecure."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha carregat el perfil d’AppleWiFiSecure correctament.\n\nAbans d’utilitzar AppleWiFiSecure, assegura’t de desconnectar el cable Ethernet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure byl úspěšně načten.\n\nPřed použitím AppleWiFiSecure se nezapomeňte odpojit od Ethernetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure-profilen blev indlæst.\n\nSørg for at afbryde forbindelsen til Ethernet, hvis du vil bruge AppleWiFiSecure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das AppleWiFiSecure-Profil wurde erfolgreich geladen.\n\nTrenne zum Verwenden von AppleWiFiSecure die Verbindung zum Ethernet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φόρτωση του προφίλ AppleWiFiSecure ήταν επιτυχής.\n\nΒεβαιωθείτε ότι έχετε αποσυνδέσει τη συσκευή από το Ethernet για χρήση του AppleWiFiSecure."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AppleWiFiSecure profile loaded successfully.\n\nPlease make sure to disconnect from Ethernet to use AppleWiFiSecure."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The AppleWiFiSecure profile loaded successfully.\n\nPlease make sure to disconnect from Ethernet to use AppleWiFiSecure."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The AppleWiFiSecure profile loaded successfully.\n\nPlease make sure you disconnect from Ethernet to use AppleWiFiSecure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil de AppleWiFiSecure se ha cargado correctamente.\n\nAsegúrate de desconectarte de Ethernet para usar AppleWiFiSecure."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil AppleWiFiSecure se cargó correctamente.\n\nAsegúrate de desconectar el cable Ethernet para usar AppleWiFiSecure."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil AppleWiFiSecure se cargó correctamente.\n\nAsegúrate de desconectar el cable Ethernet para usar AppleWiFiSecure."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure-profiilin lataus onnistui.\n\nVarmista AppleWiFiSecuren käyttämistä varten, että Ethernet on irrotettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil AppleWiFiSecure a bien été chargé.\n\nAssurez-vous de débrancher le câble Ethernet pour utiliser AppleWiFiSecure."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil AppleWiFiSecure a été chargé correctement.\n\nAssurez-vous d’avoir déconnecté le câble Ethernet pour utiliser AppleWiFiSecure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרופיל ה-AppleWiFiSecure נטען בהצלחה.\n\nנא לוודא שהתנתקת מחיבור ה-Ethernet כדי להשתמש ב-AppleWiFiSecure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure प्रोफ़ाइल सफलतापूर्वक लोड की गई।\n\nAppleWiFiSecure का उपयोग करने के लिए इथरनेट से डिस्कनेक्ट करना सुनिश्चित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure uspješno je učitan.\n\nOdspojite se s Etherneta kako biste mogli koristiti AppleWiFiSecure."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AppleWiFiSecure profil betöltése sikerült.\n\nAz AppleWiFiSecure használatához győződjön meg róla, hogy kihúzta az Ethernet-kábelt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure berhasil dimuat.\n\nPastikan Anda telah terputus dari Ethernet untuk menggunakan AppleWiFiSecure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo AppleWiFiSecure è stato caricato correttamente.\n\nPer utilizzare AppleWiFiSecure, assicurati che il cavo di rete Ethernet sia scollegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecureプロファイルは正常に読み込まれました。\n\nAppleWiFiSecureを使用するには、Ethernetの接続を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure 프로필을 성공적으로 로드했습니다.\n\nAppleWiFiSecure를 이용하려면 이더넷 연결을 해제하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure berjaya dimuatkan.\n\nSila pastikan anda memutuskan sambungan daripada Ethernet untuk menggunakan AppleWiFiSecure."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure-profilen er lastet inn.\n\nHusk å koble fra Ethernet for å bruke AppleWiFiSecure."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AppleWiFiSecure-profiel is geladen.\n\nKoppel de ethernetkabel los om AppleWiFiSecure te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure został wczytany prawidłowo.\n\nAby używać sieci AppleWiFiSecure, odłącz urządzenie od sieci Ethernet."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil AppleWiFiSecure foi carregado com sucesso.\n\nPara usar o perfil AppleWiFiSecure, desconecte‑se da Ethernet."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil AppleWiFiSecure foi carregado com sucesso.\n\nPara usar AppleWiFiSecure, certifique‑se de que desligou o cabo Ethernet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcarea profilului AppleWiFiSecure a reușit.\n\nPentru a utiliza AppleWiFiSecure, trebuie să vă deconectați de la Ethernet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль AppleWiFiSecure успешно загружен.\n\nЧтобы использовать AppleWiFiSecure, отключите устройство от Ethernet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure bol úspešne načítaný.\n\nAk chcete používať AppleWiFiSecure, odpojte zariadenie od ethernetu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil AppleWiFiSecure je uspešno naložen.\n\nČe želite uporabljati AppleWiFiSecure, se prepričajte, da ste prekinili povezavo z Ethernetom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure-profilen lästes in.\n\nKoppla bort Ethernet om du vill använda AppleWiFiSecure."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดโปรไฟล์ AppleWiFiSecure สำเร็จแล้ว\n\nโปรดตรวจสอบให้แน่ใจว่าไม่ได้เชื่อมต่อกับอีเธอร์เน็ตเพื่อใช้ AppleWiFiSecure"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure profili başarıyla yüklendi.\n\nAppleWiFiSecure bağlantısını kullanmak için lütfen Ethernet bağlantısını kestiğinizden emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль AppleWiFiSecure успішно завантажено.\n\nДля використання AppleWiFiSecure необхідно відʼєднатися від Ethernet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ AppleWiFiSecure đã được tải thành công.\n\nVui lòng đảm bảo ngắt kết nối khỏi Ethernet để sử dụng AppleWiFiSecure."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure描述文件已成功载入。\n\n请确保已断开与以太网的连接以使用AppleWiFiSecure。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleWiFiSecure描述檔已成功載入。\n\n請確認已中斷乙太網絡的連線，以使用AppleWiFiSecure。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已成功載入AppleWiFiSecure描述檔。\n\n請確定中斷與乙太網路的連線來使用AppleWiFiSecure。"
          }
        }
      }
    },
