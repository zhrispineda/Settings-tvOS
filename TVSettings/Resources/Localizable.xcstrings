            "value": "Kelantangan media dan panggilan tidak akan berubah apabila VoiceOver sedang bercakap.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Het volume van media en oproepen wordt niet gewijzigd wanneer VoiceOver spreekt.",
