    "AccountsDefaultUserProfileDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافةً إلى الوسائط و\"متابعة المشاهدة\" و Game Center لملف التعريف هذا، سيُستخدم حساب iCloud لملف التعريف الافتراضي في الصور و\"تسجيل الدخول باستخدام Apple\" و\"شاشة One الرئيسية\" وتطبيق المنزل من Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A més d’utilitzar‑se per accedir al contingut multimèdia, a la llista “Continua mirant” i al Game Center, el compte de l’iCloud del perfil per omissió es fa servir per a l’app Fotos, l’inici de sessió amb Apple, l’opció “Una pantalla d’inici” i l’Apple Home."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidají se jeho média, seznam Pokračovat ve sledování a Game Center. Aplikace Fotky a funkce Přihlášení přes Apple, Společná plocha a Domácnost Apple budou používat jeho účet na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardprofilens iCloud-konto bruges til Fotos, Log ind med Apple, Samme hjemmeskærm og Apple Hjem ud over denne brugers egne medier, Se videre og Game Center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich zu den Medien, der „Weiter ansehen“-Liste und dem Game Center dieses Profils wird der Standard-iCloud-Account des zugehörigen Profils für „Fotos“, „Mit Apple anmelden“, „Gleicher Home-Bildschirm“ und Apple Home verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτός από τα πολυμέσα, τη Συνέχιση παρακολούθησης και τον λογαριασμό Game Center αυτού του προφίλ, ο λογαριασμός iCloud του προεπιλεγμένου προφίλ χρησιμοποιείται επίσης για τις Φωτογραφίες, τη Σύνδεση μέσω Apple, τη Μία οθόνη Αφετηρίας και την Οικία Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In addition to this profile’s media, Continue Watching, and Game Center, the default profile’s iCloud account is used for Photos, Sign in with Apple, One Home Screen, and Apple Home."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "In addition to this profile’s media, Continue Watching and Game Center, the default profile’s iCloud account is used for Photos, Sign in with Apple, One Home Screen and Apple Home."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In addition to this profile’s media, Continue Watching and Game Center, the default profile’s iCloud account is used for Photos, Sign in with Apple, One Home Screen and Apple Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además de utilizarse para acceder al contenido multimedia, a la lista “Seguir viendo” y a Game Center, la cuenta de iCloud del perfil por omisión se usará para la app Fotos, el inicio de sesión con Apple, la opción “Una pantalla de inicio” y Apple Home."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Además de usarse para acceder al contenido, la lista Seguir viendo y Game Center, la cuenta de iCloud del perfil predeterminado se usa para Fotos, Iniciar sesión con Apple, la pantalla de inicio única y Casa."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Además de usarse para acceder al contenido, la lista Seguir viendo y Game Center, la cuenta de iCloud del perfil predeterminado se usa para Fotos, Iniciar sesión con Apple, la pantalla de inicio única y Casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletusprofiilin iCloud-tiliä käytetään tämän profiilin medialle, Jatka katsomista -sisällölle, Game Centerille, Kuville, Kirjaudu sisään Applella -ominaisuudelle, Yksi Koti-valikko -ominaisuudelle ja Applen Kodille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plus du contenu multimédia, de la liste « Continuer à regarder » et du compte Game Center de ce profil par défaut, son compte iCloud sera utilisé pour Photos, « Se connecter avec Apple », « Écran d’accueil unique » et Apple Home."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En plus du contenu multimédia, de la liste « Continuer à regarder » et des données Game Center de ce profil, le compte iCloud du profil par défaut sera utilisé avec Photos, Connexion avec Apple, Mon écran d’accueil et Apple Home."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנוסף לתוכני המדיה של פרופיל זה ולתכנים ב״המשך הצפייה״ וב-Game Center, חשבון ה-iCloud המוגדר כחשבון ברירת המחדל של הפרופיל ישמש עבור ״תמונות״, ״התחברות באמצעות Apple״, ״מסך בית יחיד״ ו-Apple Home."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल के मीडिया, देखना जारी रखें और Game Center के अतिरिक्त, डिफ़ॉल्ट प्रोफ़ाइल के iCloud खाते का उपयोग तस्वीर, Apple से साइन इन करें, एक होम स्क्रीन और Apple Home के लिए किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osim za medije ovog profila, odjeljak Nastavite gledati i Game Center, iCloud račun standardnog profila koristi se za aplikaciju Foto, Prijavu s Appleom, Jedan početni zaslon i Apple Dom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profil médiatartalmain, Továbbnézés listáján és Game Center-adatain kívül az alapértelmezett profil iCloud-fiókja van felhasználva a Fotókhoz, a Bejelentkezés az Apple-lel funkcióhoz, az Egy főképernyő funkcióhoz és az Apple Otthonhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selain media, Lanjutkan Menonton, dan Game Center profil ini, akun iCloud profil default akan digunakan untuk Foto, Masuk dengan Apple, Satu Layar Utama, dan Rumah Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre che per i file multimediali, per i contenuti in “Continua a guardare” e per l’account di Game Center del profilo attuale, l’account iCloud del profilo di default viene utilizzato per Foto, “Accedi con Apple”, Apple Home e la schermata Home unica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールのメディア、“続きを観る”、Game Centerに加えて、デフォルトプロフィールのiCloudアカウントは、“写真”、“Appleでサインイン”、“1つのホーム画面”、およびApple Homeでも使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 프로필의 iCloud 계정이 이 프로필의 미디어, ‘계속 보기’, Game Center 외에도 사진, ‘Apple로 로그인’, ‘하나의 홈 화면’ 및 Apple 홈에 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selain media, Teruskan Menonton dan Game Center profil ini, akaun iCloud profil lalai digunakan untuk Foto, Daftar masuk dengan Apple, Satu Skrin Utama serta Apple Home."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-kontoen til denne profilen vil bli brukt til Bilder, Logg på med Apple, Felles Hjem-skjerm og Hjem, i tillegg til profilens medier, Fortsett å se-kø og Game Center."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iCloud-account van het standaardprofiel wordt behalve voor media, 'Kijk verder' en Game Center ook gebruikt voor Foto's, 'Log in met Apple', 'Eén beginscherm' en Apple Woning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprócz multimediów, listy Oglądaj dalej i Game Center, konto iCloud profilu domyślnego jest także używane przez aplikację Zdjęcia, funkcję logowania się przy użyciu konta Apple, funkcję jednego ekranu głównego oraz platformę Apple Home."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Além do conteúdo, da lista Continue Assistindo e do Game Center, a conta do iCloud do perfil padrão é usada para o app Fotos, o Início de Sessão com a Apple, a opção Uma Tela de Início e o Apple Home."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Além dos conteúdos multimédia, Continuar a ver e Game Center deste perfil, a conta iCloud do perfil predefinido é usada para Fotografias, Iniciar sessão com a Apple, ecrã principal e Apple Home."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe lângă conținutul multimedia, secțiunea „Continuați vizionarea” și contul de Game Center ale acestui profil, contul de iCloud al profilului implicit este utilizat pentru Poze, „Autentificare cu Apple”, „Un ecran principal” și Locuință Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учетная запись iCloud профиля по умолчанию используется для доступа к сохраненному в нем медиаконтенту, списку «Продолжить просмотр» и учетной записи Game Center, для функций «Вход с Apple» и «Один экран “Домой”», а также для доступа к приложениям «Фото» и «Дом» от Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple TV budú pridané jeho médiá, položky v zozname Pokračovať v pozeraní a Game Center účet. iCloud účet predvoleného profilu budú používať Fotky, Prihlásenie cez Apple, Zjednotená plocha a Apple Domácnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun iCloud privzetega profila se poleg predstavnostnih vsebin, seznama Nadaljujte ogled in omrežja Game Center tega profila uporablja tudi za aplikacijo Fotografije, funkciji Vpiši se z računom Apple in En domači zaslon ter Dom Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utöver den här profilens medier, Fortsätt titta och Game Center används den förvalda profilens iCloud-konto för Bilder, Logga in med Apple, Samma hemskärm och Hem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี iCloud ของโปรไฟล์เริ่มต้นจะถูกใช้สำหรับรูปภาพ, การลงชื่อเข้าด้วย Apple, หน้าจอโฮมเดียวกัน และ Apple Home รวมทั้งสื่อ ดูต่อ และ Game Center ของโปรไฟล์นี้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin ortamlarına ek olarak İzlemeyi Sürdür’ü ve Game Center’ı da dahil edilir ve saptanmış profilin iCloud hesabı Fotoğraflar, Apple ile Giriş Yap, Bir Ana Ekran ve Apple Ev için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрім доступу до медіавмісту, списку «Продовжити перегляд» та Game Center, обліковий запис iCloud типового профілю використовується для Фотографій, Входу з Apple, Єдиного початкового екрана та програми «Дім» від Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bên cạnh phương tiện, mục Tiếp tục xem và Game Center của hồ sơ này, tài khoản iCloud của hồ sơ mặc định được sử dụng cho Ảnh, Đăng nhập bằng Apple, Một màn hình chính cũng như Nhà Apple."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "除了此个人资料的媒体、“继续观看”和Game Center外，默认个人资料的iCloud账户还会用于“照片”、“通过Apple登录”、“一个主屏幕”和Apple家庭。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "除了此個人檔案的媒體、「繼續觀看」和Game Center外，預設個人檔案的iCloud帳户亦會用於「相片」、「使用Apple登入」、「單一主畫面」和「Apple家居」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "除了該個人檔案的媒體、「繼續觀看」和Game Center，預設個人檔案的iCloud帳號也會用於「照片」、「使用Apple登入」、「單一主畫面」和「Apple家庭」。"
          }
        }
      }
    },
