    "SettingsOSUpdateMismatchedAudienceseMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدمو Pallas غير مناسبين لهذا التكوين. يرجى تجربة التبديل إلى \"Shipping\" والرجوع إلى هذا التكوين ثم إعادة الإقلاع لمحاولة تصحيح المستخدمين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audiència de Pallas no coincideix amb aquesta configuració. Prova de restaurar la configuració de fàbrica, torna a aquesta i, després, reinicia el sistema per provar de corregir l’audiència."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okruh příjemců Pallas neodpovídá této konfiguraci. Zkuste přepnout na konfiguraci nastavenou při vydání a zpět a potom zařízení restartovat – tím by se měl okruh příjemců opravit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas-brugergruppen passer ikke til denne konfiguration. Skift til leveringskonfiguration og tilbage til denne konfiguration. Start derefter igen for at forsøge at rette brugergruppen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pallas-Publikum entspricht nicht dieser Konfiguration. Wechsle zu „Lieferung“ und zurück zu dieser Konfiguration, starte anschließend neu, um eine Publikumskorrektur zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ακροατήριο Pallas δεν αντιστοιχεί σε αυτήν τη ρύθμιση παραμέτρων. Κάντε εναλλαγή στη ρύθμιση «Σε κυκλοφορία», επιστρέψτε σε αυτήν τη ρύθμιση παραμέτρων και μετά κάντε επανεκκίνηση για να γίνει απόπειρα διόρθωσης του ακροατηρίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pallas audience does not match this configuration. Try switching to Shipping and back to this configuration then rebooting to attempt to correct the audience."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pallas audience does not match this configuration. Try switching to Shipping and back to this configuration then rebooting to attempt to correct the audience."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pallas audience does not match this configuration. Try switching to Shipping and back to this configuration, then rebooting to attempt to correct the audience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo de dispositivos Pallas no coincide con el de esta configuración. Prueba a cambiar a la versión pública comercial, vuelve a esta configuración y reinicia para intentar cargar el grupo correcto."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo de Pallas no coincide con esta configuración. Intenta cambiar a la versión comercial (Envío), vuelve a seleccionar esta configuración y reinicia para intentar corregir el grupo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo de Pallas no coincide con esta configuración. Intenta cambiar a la versión comercial (Envío), vuelve a seleccionar esta configuración y reinicia para intentar corregir el grupo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pallas audience does not match this configuration. Try switching to Shipping and back to this configuration then rebooting to attempt to correct the audience."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le public Pallas ne correspond pas à cette configuration. Passez à « Configuration commercialisée » et revenez à cette configuration, puis redémarrez pour tenter de corriger le public."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe d’utilisateurs Pallas ne semble pas correspondre à cette configuration. Essayez de passer en mode Livraison, de revenir à cette configuration, puis de redémarrer l’appareil pour tenter de corriger le groupe d’utilisateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קהל משתמשי Pallas לא תואם לתצורה זו. ניתן לנסות לעבור למצב Shipping, לחזור לתצורה זו ולאחר מכן לבצע אתחול כדי לנסות לתקן את סוג קהל המשתמשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas ऑडियंस इस कॉन्फ़िगरेशन से मेल नहीं खाती है। शिपिंग पर बदलें और फिर इस कॉन्फ़िगरेशन पर वापस जाएँ, फिर रीबूट करके ऑडियंस ठीक करने की कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas publika ne odgovara ovoj konfiguraciji. Pokušajte prebaciti na Isporuku i vratite se na ovu konfiguraciju, zatim ponovno podignite sustav kako biste pokušali ispraviti publiku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pallas közönsége nem felel meg ennek a konfigurációnak. Próbáljon meg átváltani a Szállítási konfigurációra, ezután váltson vissza erre a konfigurációra, majd indítsa újra a rendszert a helyes közönség beállításának megkísérléséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiens Pallas tidak cocok dengan konfigurasi ini. Coba beralih ke Pengiriman dan kembali ke konfigurasi ini, lalu melakukan boot ulang untuk mencoba mengoreksi audiens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo di dispositivi Pallas non corrisponde a questa configurazione. Per cercare di correggerlo, prova a selezionare la configurazione di fabbrica, poi a tornare a questa e a riavviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pallas”の対象ユーザはこの構成と一致しません。“リリース済みGM”に切り替えてからこの構成に戻して、そのあとで再起動して対象ユーザを修正してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas 사용자는 이 구성과 일치하지 않습니다. ‘출시된 빌드’로 전환하고 이 구성으로 되돌아온 다음, 재시동하여 사용자를 올바르게 수정해 보십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Khalayak Pallas tidak sepadan dengan konfigurasi ini. Cuba bertukar kepada Keluaran dan kembali ke konfigurasi ini, kemudian but semula untuk cuba membetulkan khalayak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas-publikumet stemmer ikke med konfigurasjonen. Prøv å bytte til Produksjon og tilbake til denne konfigurasjonen og så starte på nytt for å prøve å laste inn profilen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo te zien past de Pallas-doelgroep niet bij deze configuratie. Schakel over naar 'Verzending' en weer terug naar deze configuratie. Start vervolgens opnieuw op om de doelgroep te corrigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa użytkowników Pallas nie jest zgodna z tą konfiguracją. Spróbuj poprawić grupę odbiorców: przełącz na konfigurację Shipping, wróć do tej konfiguracji, a następnie uruchom ponownie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A audiência do Pallas não corresponde a esta configuração. Tente alternar para Entrega e retorne para esta configuração, depois reinicialize para tentar corrigir a audiência."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo de utilizadores de Pallas não corresponde a esta configuração. Experimente mudar para “Pronta para lançar” e voltar a esta configuração, depois reinicie para tentar corrigir o grupo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicul Pallas nu corespunde acestei configurații. Comutați la Lansate și înapoi la această configurație, apoi reporniți pentru a încerca să corectați publicul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа пользователей Pallas audience не соответствует этой конфигурации. Переключитесь на параметр «Официальная версия», затем обратно на эту конфигурацию, после чего выполните перезагрузку, чтобы попробовать изменить круг пользователей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okruh príjemcov „Pallas“ nezodpovedá tejto konfigurácii. Skúste opraviť okruh príjemcov: prepnite konfiguráciu na Zverejnená, prepnite späť na túto konfiguráciu a reštartujte zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Občinstvo Pallas se ne ujema s to konfiguracijo. Poskusite preklopiti na Pošiljanje in nazaj na to konfiguracijo, nato pa znova zaženite, da poskusite popraviti občinstvo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Pallas audience stämmer inte överens med den här konfigurationen. Försök att rätta till denna audience genom att ändra till Produktion, ändra tillbaka till den här konfigurationen och sedan starta om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ชม Pallas ไม่ตรงกับการกำหนดค่านี้ ลองเปลี่ยนเป็นแบบ Shipping แล้วเปลี่ยนกลับเป็นการกำหนดค่านี้ จากนั้นเริ่มการทำงานเครื่องใหม่เพื่อลองแก้ไขผู้ชม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas hedef kitlesi bu konfigürasyona uymuyor. Hedef kitleyi düzeltmeyi denemek için Çıkan Sürüm’e geçip ardından bu konfigürasyona dönün ve yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця конфігурація не збігається з аудиторією Pallas. Щоб спробувати виправити аудиторію, перемкніться на поточну випущену версію та назад на цю конфігурацію. Потім перезапустіть пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối tượng Pallas không khớp với cấu hình này. Hãy thử chuyển đổi sang Phân phối và quay lại cấu hình này, sau đó khởi động lại để cố gắng hiệu chỉnh đối tượng."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas访问群体与此配置不匹配。请尝试切换至“准备发布”并返回此配置，然后重新启动以尝试纠正访问群体。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas對象與此設定不符。請嘗試切換至「已發佈版本」並返回此設定，然後重新開機來嘗試修正對象。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallas對象不符合此設定。請試著切換到「已發佈」後再切回此設定，然後重新啟動來嘗試修正對象。"
          }
        }
      }
    },
    "SettingsOSUpdateMissingCarryProfileMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه لم يتم تحميل ملف التعريف لهذا التكوين. يرجى تجربة التبديل إلى \"Shipping\" والرجوع إلى هذا التكوين ثم إعادة الإقلاع لمحاولة تحميل ملف التعريف مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembla que no s’ha carregat el perfil d’aquesta configuració. Prova de restaurar la configuració de fàbrica, torna a aquesta i, després, reinicia el sistema per provar de carregar el perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil této konfigurace zřejmě není načtený. Zkuste přepnout na konfiguraci nastavenou při vydání a zpět a potom zařízení restartovat – profil by se měl načíst znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen til denne konfiguration kan tilsyneladende ikke indlæses. Skift til leveringskonfiguration og tilbage til denne konfiguration. Start derefter igen for at forsøge at indlæse profilen igen."
          }
