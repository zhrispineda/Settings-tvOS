    "RestrictionsRestrictBooksDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد \"غير لائق\" للسماح بالكتب ذات المحتوى الجنسي الصريح في تطبيق الكتب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Explícit per permetre llibres amb contingut sexual explícit a l’app Llibres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li v Knihách povolit knihy s explicitním sexuálním obsahem, vyberte volbu Explicitní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Anstødeligt for at tillade bøger med seksuelt indhold i Bøger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Anstößig“, um Bücher mit eindeutig sexuellen Inhalten in „Bücher“ zu erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «Ακατάλληλο» για να επιτρέπονται βιβλία με ακατάλληλο σεξουαλικό περιεχόμενο στα Βιβλία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Explicit to allow books with explicit sexual content in Books."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Explicit to allow books with explicit sexual content in Books."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Explicit to allow books with explicit sexual content in Books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Explícito para permitir libros con contenido sexual explícito en la app Libros."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Explícito para autorizar libros con contenido sexual explícito en Libros."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Explícito para autorizar libros con contenido sexual explícito en Libros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli lapsille sopimatonta sisältöä sisältävät kirjat Kirjat-apissa valitsemalla Kaikki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Explicite pour autoriser les livres avec du contenu sexuel explicite dans Apple Books."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Contenu explicite pour autoriser les livres au contenu sexuellement explicite dans Livres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור ב״תוכן בוטה״ כדי לאפשר ספרים בעלי תוכן מיני בוטה ב״ספרים״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताब में अश्लील यौन कॉन्टेंट सहित किताबों को अनुमति देने के लिए अश्लील चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite Eksplicitno kako biste dozvolili knjige s eksplicitnim seksualnim sadržajem u aplikaciji Knjige."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szókimondó lehetőség választásával engedélyezheti a szókimondó szexuális tartalommal rendelkező könyvek megjelenítését a Könyvekben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Eksplisit untuk mengizinkan buku dengan konten seksual eksplisit di Buku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona “Contenuti espliciti” per consentire libri con contenuti sessuali espliciti sull’app Libri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ブック”で不適切な性的描写のあるブックを許可するには、“不適切な内容を含む”を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도서 앱에서 무삭제판 성인용 콘텐츠가 포함된 책을 허용하려면 무삭제판을 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Eksplisit untuk membenarkan buku dengan kandungan seksual eksplisit dalam Buku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Eksplisitt for å tillate bøker med voksent innhold i Bøker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer 'Expliciet' om boeken met expliciet seksueel materiaal toe te staan in Boeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz Dla dorosłych, aby pozwalać na książki z treściami seksualnymi w Książkach."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Explícito para permitir livros com conteúdo sexual explícito no app Livros."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Explícito para permitir livros com conteúdo sexual explícito na aplicação Livros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați Explicit pentru a permite cărțile care includ conținut sexual explicit în aplicația Cărți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «С ненормативным», чтобы разрешить книги с откровенным сексуальным содержанием в «Книгах»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtnutím možnosti Nevhodné povolíte knihy s nevhodným sexuálnym obsahom v apke Knihy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite možnost Nazorna vsebina, da dovolite knjige z nazorno spolno vsebino v aplikaciji Knjige."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera Explicit om du vill tillåta böcker med explicit sexuellt innehåll i Böcker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไม่เหมาะสม เพื่ออนุญาตหนังสือ\nที่มีเนื้อหาทางเพศที่ไม่เหมาะสมในหนังสือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplar’da uygunsuz cinsel içeriğe sahip kitaplara izin vermek için Uygunsuz İçerik’i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Відверті», щоб дозволити книги з відвертим сексуальним контентом у Книгах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Thô tục để cho phép các sách có nội dung khiêu dâm trong Sách."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“儿童不宜”以允许“图书”中显示含儿童不宜内容的成人图书。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「兒童不宜」以允許「書籍」顯示含有成人內容的書籍。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選取「兒少不宜」來允許「書籍」顯示包含兒少不宜內容的成人書籍。"
          }
        }
      }
    },
