    "RCVCCECAssistantMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على زري مستوى الصوت وكتم الصوت في Siri Remote للتحقق من استجابة تلفزيونك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem els botons de volum i de silenci del Siri Remote per veure si el televisor hi respon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte na ovladači Siri Remote tlačítka hlasitosti a vypnutí zvuku a zkontrolujte, zda televizor reaguje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på knapperne Lydstyrke og Lydløs på din Siri Remote for at se, om fjernsynet reagerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die Tasten für die Lautstärke und die Stummschaltung auf deiner Siri Remote, um zu sehen, ob dein TV-Gerät reagiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τα κουμπιά Έντασης ήχου και Σίγασης στο Siri Remote για να δείτε αν θα αποκριθεί η τηλεόρασή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the Volume and Mute buttons on your Siri Remote to see if your TV responds."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the Volume and Mute buttons on your Siri Remote to see if your TV responds."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the Volume and Mute buttons on your Siri Remote to see if your TV responds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa los botones de volumen y silencio en el Siri Remote para comprobar si el televisor responde."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona los botones de volumen y silencio en tu Siri Remote para verificar si tu TV responde."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona los botones de volumen y silencio en tu Siri Remote para verificar si tu TV responde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile reagoiko TV, kun painat Siri Remoten Äänenvoimakkuus- ja Mykistys-painikkeita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les boutons de réglage du volume et le bouton « Couper le son » de votre télécommande Siri Remote pour voir si votre téléviseur réagit."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les boutons de volume et le bouton « Couper le son » de votre télécommande Siri Remote pour voir si votre télévision réagit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על כפתורי עוצמת השמע וההשתקה ב-Siri Remote כדי לבדוק אם הטלוויזיה שלך מגיבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple TV रिमोट पर वॉल्यूम और म्यूट बटन दबाएँ और देखें कि आपका टीवी कोई प्रतिक्रिया देता है या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite tipke za glasnoću i isključenje zvuka na Siri upravljaču kako biste vidjeli hoće li TV reagirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg az Apple TV Remote Hangerő és Némítás gombjait, és figyelje meg, hogy a tévéje reagál‑e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol Volume dan Bisukan di Siri Remote Anda untuk melihat apakah TV Anda merespons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi i tasti del volume e Silenzioso sul telecomando Siri Remote per verificare se la TV risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレビが応答するかどうかを確かめるには、Siri Remoteで“音量”と“消音”ボタンを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri Remote에서 음량 및 소리 끔 버튼을 눌러 TV가 응답하는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan butang Kelantangan dan Senyap pada Siri Remote anda untuk melihat sama ada TV anda membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på volum- og lydløs-knappene på Siri Remote for å se om TV-en reagerer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de volumeknop en de knop 'Houd stil' op je Siri Remote om te kijken of je tv reageert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij przyciski głośności i wyciszania na pilocie Apple TV Remote, aby sprawdzić, czy telewizor zareaguje."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione os botões de Volume e Silenciar no Siri Remote para ver se a TV responde."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima os botões de volume e de silêncio no Siri Remote para verificar se há resposta da televisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați butoanele de volum și de tăiere a sunetului de pe telecomanda Siri Remote pentru a vedea dacă televizorul dvs. reacționează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопки громкости и выключения звука на пульте Siri Remote и посмотрите на реакцию телевизора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačením tlačidiel hlasitosti a stíšenia na ovládači Siri Remote vyskúšajte, či na ne váš televízor reaguje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite gumba za glasnost in izklop zvoka na daljincu Siri Remote in preverite, ali se televizor odzove."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på volym- och ljud av-knapparna på Siri Remote för att se om TV:n svarar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มปรับเสียงและปุ่มปิดเสียงบน Siri Remote ของคุณเพื่อดูว่าทีวีของคุณตอบสนองหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV’nizin yanıt verip vermediğini görmek için Siri Remote’unuzda Ses Yüksekliği ve Sesi Kapat düğmelerine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопки зміни гучності й вимкнення звуку на пульті Apple TV Remote, щоб перевірити, чи реагує телевізор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn các nút Âm lượng và Tắt tiếng trên Apple TV Remote để xem TV của bạn có phản hồi không."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "按下Apple TV遥控器上的音量和静音按钮，检查电视是否响应。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下Siri Remote上的音量和靜音按鈕，查看你的電視有沒有回應。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下Siri Remote上的音量和靜音按鈕來查看你的電視是否有回應。"
          }
        }
      }
