          }
        },
        "pl": {
          "stringUnit": {
            "value": "Głośność multimediów i połączeń nie będzie zmieniana, gdy funkcja VoiceOver odczytuje rzeczy.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "O volume de chamadas e mídias não será alterado quando o VoiceOver estiver falando.",
