    "SettingsVPNBadURLMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط VPN مفقود أو خاطئ ولا يمكن تحميله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta l‘URL de la VPN o és incorrecte i no es pot carregar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL VPN není k dispozici nebo je nesprávné a nelze ho načíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-adressen til VPN mangler eller er forkert og kan ikke indlæses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VPN-URL fehlt oder ist inkorrekt und kann nicht geladen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση URL του VPN λείπει ή είναι εσφαλμένη και δεν είναι δυνατό να φορτωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN URL is missing or incorrect and cannot be loaded."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN URL is missing or incorrect and cannot be loaded."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN URL is missing or incorrect and cannot be loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cargar la dirección URL del VPN porque no está indicada o es incorrecta."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL de la VPN no se encuentra o es incorrecta y no se puede cargar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL de la VPN no se encuentra o es incorrecta y no se puede cargar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN URL is missing or incorrect and cannot be loaded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du VPN est manquante ou incorrecte et ne peut pas être chargée."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du VPN est manquante ou incorrecte, et ne peut pas être chargée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את כתובת ה-URL של ה-VPN מאחר שהיא חסרה או שגויה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN URL अनुपलब्ध है या ग़लत है और लोड नहीं किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL VPN-a nedostaje ili nije točan i ne može se učitati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN URL-je hiányzik vagy helytelen, ezért nem lehet betölteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "URL VPN hilang atau salah dan tidak dapat dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL della VPN risulta mancante o non corretto e non può essere caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN URLが見つからないか、正しくないため、読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN URL이 없거나 올바르지 않기 때문에 로드할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL VPN tiada atau salah dan tidak boleh dimuatkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-URL-en er feil eller mangler, og kan derfor ikke lastes inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De VPN-URL ontbreekt of is onjuist en kan niet worden geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak adresu URL VPN lub jest on nieprawidłowy i nie można go wczytać."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O URL da VPN está ausente ou incorreto e não pode ser carregado."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O URL da VPN não pode ser carregado porque não foi encontrado ou está incorreto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "URL‑ul VPN‑ului lipsește sau este incorect și nu poate fi încărcat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL‑адрес VPN отсутствует или неверен. Загрузка невозможна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL pre VPN chýba alebo je nesprávna a nie je možné ju načítať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL VPN-ja manjka ali pa je nepravilen in ga ni mogoče naložiti."
