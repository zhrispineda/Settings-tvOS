    "NetworkConfigureRouterEntryPrompt": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تعرف عنوان IP الخاص بجهاز التوجيه لديك، فأدخله ثم حدد \"تم\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si saps l’adreça IP de l’encaminador, introdueix‑la i selecciona “Fet”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud znáte IP adresu směrovače, zadejte ji a vyberte volbu Hotovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du kender din routers IP-adresse, skal du skrive den og vælge OK."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die IP-Adresse deines Routers kennst, gib diese ein und wähle „OK“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν γνωρίζετε τη διεύθυνση IP του δρομολογητή σας, εισαγάγετέ την και μετά επιλέξτε «Τέλος»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you know your router’s IP address, enter it and select Done."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you know your router’s IP address, enter it and select Done."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you know your router’s IP address, enter it and select Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sabes la dirección IP de tu router, introdúcela y selecciona OK."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sabes la dirección IP de tu router, ingrésala y selecciona Listo."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sabes la dirección IP de tu router, ingrésala y selecciona Listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tiedät reitittimen IP-osoitteen, syötä se ja valitse OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous connaissez l’adresse IP d’un routeur, saisissez-la puis sélectionnez OK."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous connaissez l’adresse IP de votre routeur, entrez-la puis sélectionnez OK."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ידועה לך כתובת ה-IP של הנתב, יש להזין אותה ולבחור ב״אישור״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको अपने राउटर का IP पता ज्ञात है, तो उसे दर्ज करें और “पूर्ण” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako znate IP adresu vašeg routera, unesite je pa odaberite Gotovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha tudja a router IP-címét, adja meg azt, majd válassza a Kész lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mengetahui alamat IP ruter Anda, masukkan dan pilih Selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conosci l’indirizzo IP del router, inseriscilo e seleziona Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーターのIPアドレスが分かれば入力して、“完了”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라우터 IP 주소가 있다면 입력한 다음 완료를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda tahu alamat IP penghala anda, masukkannya dan pilih Selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du kjenner IP-adressen til ruteren, skriver du den inn og velger Ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je weet wat het IP-adres van je router is, voer je dat in en selecteer je 'OK'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli znasz adres IP routera, podaj go, a następnie wybierz OK."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você souber o endereço IP do seu roteador, digite-o e selecione OK."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se souber o endereço IP do router, digite‑o e selecione OK."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă știți adresa IP a ruterului dvs., introduceți-o și apoi selectați OK."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При наличии IP‑адреса маршрутизатора введите его и выберите «Готово»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak poznáte IP adresu svojho routera, zadajte ju a vyberte Hotovo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če poznate naslov IP svojega usmerjevalnika, ga vnesite, nato pa izberite Dokončano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du känner till IP-adressen till din router fyller du i den och väljer Klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณทราบที่อยู่ IP สำหรับเราท์เตอร์ของคุณ ให้ป้อนที่อยู่แล้วเลือกเสร็จสิ้น"
