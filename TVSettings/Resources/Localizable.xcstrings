    "AVSurroundConvertFormatDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة ترميز الصوت بتنسيق\nيدعمه جهازك، أو استبداله بصوت استريو.\nقد يكون هذا التنسيق أكثر توافقًا، لكنه يقلل من جودة الصوت.\nلمزيد من المعلومات، يرجى مراجعة\nsupport.apple.com/appletv/audio"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recodificarà l’àudio en un format\ncompatible amb l’equip o se substituirà per l’estèreo.\nPot ser que millori la compatibilitat, però es reduirà la qualitat de l’àudio.\nTrobaràs més informació a\nsupport.apple.com/appletv/audio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk bude znovu kódován do formátu\npodporovaného vaším zařízením nebo nahrazen formátem stereo.\nTím se sice zlepšuje kompatibilita, ale zároveň snižuje kvalita zvuku.\nDalší informace viz\nsupport.apple.com/appletv/audio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd bliver omkodet til et format,\nsom dit udstyr understøtter, eller erstattes med stereo.\nDette kan være mere kompatibelt, men vil også give dårligere lydkvalitet.\nDu kan få flere oplysninger på\nsupport.apple.com/appletv/audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird in einem Format, das deine Geräte\nunterstützen, neu codiert oder durch Stereo ersetzt.\nDies kann die Kompatibilität erhöhen, beeinträchtigt aber die Audioqualität.\nWeitere Infos findest du unter:\nsupport.apple.com/appletv/audio"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος θα κωδικοποιηθεί εκ νέου σε μορφή\nπου υποστηρίζει ο εξοπλισμός σας ή θα αντικατασταθεί με στερεοφωνικό.\nΑυτό μπορεί να βελτιώσει τη συμβατότητα, αλλά θα μειώσει την ποιότητα ήχου.\nΓια περισσότερες πληροφορίες, επισκεφθείτε τη διεύθυνση\nsupport.apple.com/appletv/audio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio will be re-encoded into a format\nyour equipment supports, or replaced with stereo.\nThis may be more compatible, but reduces audio quality.\nFor more information, see\nsupport.apple.com/appletv/audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se recodificará a un formato compatible\ncon tu equipo o se sustituirá por el sistema estéreo.\nLa compatibilidad será mayor, pero se reducirá la calidad del audio.\nSi quieres obtener más información, consulta\nsupport.apple.com/appletv/audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en un formato compatible con tu equipo\no se reemplazará con estéreo.\nEsto podría ser más compatible, pero reducirá la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se volverá a codificar en un formato compatible con tu equipo\no se reemplazará con estéreo.\nEsto podría ser más compatible, pero reducirá la calidad del audio.\nPara más información, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni koodataan uudelleen muotoon,\njota laitteesi tukee, tai korvataan stereolla.\nTämä voi olla yhteensopivampi, mutta se heikentää äänenlaatua.\nKatso lisätietoja osoitteesta\nsupport.apple.com/appletv/audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé dans un format pris en charge\npar votre matériel ou remplacé par le son stéréo.\nCela peut améliorer la compatibilité, mais réduit la qualité audio.\nPour en savoir plus, consultez la page suivante :\nsupport.apple.com/appletv/audio"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son sera réencodé dans un format\npris en charge par votre équipement ou remplacé par le format stéréo.\nBien que cela améliore la compatibilité, la qualité audio en est réduite.\nPour en savoir plus, consultez\nsupport.apple.com/appletv/audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע יקודד מחדש לפורמט שבו\nהציוד שלך תומך, או יוחלף בסטריאו.\nהוא עשוי להיות תואם יותר, אך יפחית את איכות השמע.\nמידע נוסף זמין בכתובת:\nsupport.apple.com/appletv/audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो को ऐसे फ़ॉर्मैट में फिर से एनकोड किया जाएगा जिसका\nआपका उपकरण समर्थन करता है या उसे स्टीरियो से बदल दिया जाएगा।\nयह ज़्यादा संगत हो सकता है, लेकिन इसमें ऑडियो गुणवत्ता कम हो जाती है।\nअधिक जानकारी के लिए, देखें\nsupport.apple.com/appletv/audio"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio će se ponovno kodirati u format\nkoji vaša oprema podržava ili zamijeniti stereo signalom.\nOvo je možda kompatibilnije, ali smanjuje kvalitetu zvuka.\nZa dodatne informacije pogledajte\nsupport.apple.com/appletv/audio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang olyan formátumban lesz újrakódolva,\namelyet a berendezése támogat, vagy le lesz cserélve sztereó hangra.\nElképzelhető, hogy a kompatibilitás javul, viszont csökken a hangminőség.\nTovábbi információkért keresse fel a következőt:\nsupport.apple.com/appletv/audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodekan ulang ke format\nyang didukung perlengkapan Anda, atau diganti dengan stereo.\nIni dapat lebih kompatibel, tapi mengurangi kualitas audio.\nUntuk informasi lainnya, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio verrà ricodificato in un formato\nsupportato dall’impianto o sostituito con audio stereo.\nLa compatibilità potrebbe essere maggiore, ma la qualità audio sarà ridotta.\nPer ulteriori informazioni, consulta\nsupport.apple.com/appletv/audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオはお使いの機器が対応しているフォーマットに再エンコードされるか、\nまたはステレオに置換されます。\nこれにより互換性は向上する場合がありますが、オーディオ品質は低下します。\n詳しくは、\nsupport.apple.com/appletv/audio を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 사용자의 장비에서 지원하는 포맷으로\n다시 인코딩되거나 스테레오로 대치됩니다.\n호환성이 향상될 수 있으나 오디오 음질이 저하됩니다.\n더 자세한 사항은 다음 사이트를 참조하십시오.\nsupport.apple.com/appletv/audio"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio akan dikodkan semula kepada format\nyang disokong oleh peralatan anda atau digantikan dengan stereo.\nIni mungkin lebih serasi, namun mengurangkan kualiti audio.\nUntuk mendapatkan maklumat lanjut, lihat\nsupport.apple.com/appletv/audio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd vil bli kodet på nytt til et format som\nstøttes av utstyret ditt, eller byttes ut med stereo.\nDette kan være mer kompatibelt, men reduserer lydkvaliteten.\nDu finner mer informasjon på\nsupport.apple.com/appletv/audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt opnieuw gecodeerd in een door je apparaat\nondersteunde structuur of vervangen door stereo.\nHiermee wordt de compatibiliteit mogelijk beter, maar kan ook de audiokwaliteit minder worden.\nGa voor meer informatie naar\nsupport.apple.com/appletv/audio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk będzie kodowany ponownie w formacie obsługiwanym\nprzez Twój sprzęt lub zastępowany dźwiękiem stereo.\nMoże to poprawić zgodność, ale obniża jakość.\nAby uzyskać więcej informacji, zobacz:\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado em um formato\ncompatível com o equipamento ou substituído por estéreo.\nEmbora ele fique compatível, sua qualidade será reduzida.\nPara saber mais, visite\nsupport.apple.com/appletv/audio"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio será recodificado com um formato\ncompatível ou substituído por estéreo.\nEsta alteração pode melhorar o nível de compatibilidade, mas reduz a qualidade do áudio.\nEncontrará informação adicional em\nsupport.apple.com/appletv/audio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul va fi recodat la un format\nacceptat de echipamentul dvs. sau înlocuit cu stereo.\nPoate fi mai compatibil, dar diminuează calitatea audio.\nPentru mai multe informații, consultați\nsupport.apple.com/appletv/audio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будет перекодирован в формат,\nподдерживаемый Вашим аудиооборудованием, или заменен на стереозвук.\nЭто может улучшить совместимость, но приведет к снижению качества звука.\nПодробнее:\nsupport.apple.com/appletv/audio"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio bude prekódované do formátu podporovaného\nvašou zvukovou aparatúrou alebo nahradené stereom.\nTáto možnosť poskytuje lepšiu kompatibilitu za cenu zníženej kvality zvuku.\nViac informácií nájdete na stránke\nsupport.apple.com/appletv/audio"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok bo znova kodiran v obliko zapisa, ki\njo podpira vaša oprema, ali pa bo zamenjan z zvokom stereo.\nTa oblika zapisa bo morda bolj združljiva, vendar se zmanjša kakovost zvoka.\nZa več informacij glejte\nsupport.apple.com/appletv/audio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet kodas om till ett format\nsom stöds av din utrustning, eller ersättas med stereo.\nDetta kan vara mer kompatibelt, men ljudkvaliteten försämras.\nMer information finns på\nsupport.apple.com/appletv/audio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกเข้ารหัสอีกครั้งเป็นรูปแบบ\nที่อุปกรณ์ของคุณรองรับ หรือถูกแทนที่ด้วยเสียงสเตอริโอ\nการทำงานนี้อาจใช้งานร่วมกันได้มากขึ้นแต่ลดคุณภาพเสียง\nสำหรับข้อมูลเพิ่มเติม ให้ดูที่\nsupport.apple.com/appletv/audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, ekipmanınızın desteklediği bir biçim olarak\nyeniden kodlanır veya stereo ile değiştirilir.\nBu, daha uyumlu olabilir ama ses kalitesini düşürür.\nDaha fazla bilgi için şu adrese gidin:\nsupport.apple.com/appletv/audio"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук перекодовується в сумісний\nз обладнанням формат або замінюється на стерео.\nЦе підвищує сумісність, проте знижує якість звуку.\nДодаткові відомості наведено на вебсторінці\nsupport.apple.com/appletv/audio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh sẽ được mã hóa lại thành định dạng mà\nthiết bị của bạn hỗ trợ hoặc được thay thế bằng stereo.\nĐịnh dạng này có thể tương thích hơn, nhưng làm giảm chất lượng âm thanh.\nĐể biết thêm thông tin, hãy xem\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将被重新编码为你设备支持的\n格式，或用立体声替代。\n兼容性可能会提高，但音频质量会降低。\n更多信息请访问\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將重新編碼為你設備可支援的格式，\n或以立體聲代替。\n相容性可能會提高，但會降低音訊品質。\n詳情請瀏覽\nsupport.apple.com/appletv/audio"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊將被重新編碼為你設備支援的格式，\n或以立體聲替代。\n相容性可能會提高，但會降低音訊品質。\n如需更多資訊，請參訪\nsupport.apple.com/appletv/audio"
          }
        }
      }
    },
    "AVSurroundConvertFormatDialogAtmosAvailableMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى تقليل جودة الصوت وتعطيل Dolby Atmos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es reduirà la qualitat de l’àudio i es desactivarà Dolby Atmos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dojde ke snížení kvality zvuku a vypnutí Dolby Atmos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil give dårligere lydkvalitet og deaktivere Dolby Atmos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Audioqualität reduziert und Dolby Atmos deaktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα μειώσει την ποιότητα ήχου και θα απενεργοποιήσει το Dolby Atmos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reduce audio quality and disable Dolby Atmos."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reduce audio quality and disable Dolby Atmos."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reduce audio quality and disable Dolby Atmos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operación reducirá la calidad del audio y desactivará Dolby Atmos."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reducirá la calidad de audio y desactivará Dolby Atmos."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reducirá la calidad de audio y desactivará Dolby Atmos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä heikentää äänenlaatua ja poistaa Dolby Atmosin käytöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela réduira la qualité audio et désactivera le Dolby Atmos."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualité audio sera réduite, et Dolby Atmos sera désactivé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תפחית את איכות השמע ותבטל את Dolby Atmos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे ऑडियो गुणवत्ता कम हो जाएगी और Dolby Atmos अक्षम हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovime će se smanjiti kvaliteta zvuka i onemogućiti Dolby Atmos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez csökkenteni fogja a hangminőséget, és letiltja a Dolby Atmost."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengurangi kualitas audio dan menonaktifkan Dolby Atmos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione riduce la qualità del suono e disabilita l’opzione Dolby Atmos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は、オーディオ品質を低下させドルビーアトモスを無効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 음질이 저하되고 Dolby Atmos가 비활성화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengurangkan kualiti audio dan menyahdayakan Dolby Atmos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil gi dårligere lydkvalitet og deaktivere Dolby Atmos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de audiokwaliteit verminderd en Dolby Atmos uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to obniżenie jakości dźwięku i wyłączy Dolby Atmos."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso reduzirá a qualidade do áudio e desativará o Dolby Atmos."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A qualidade de áudio será afetada e Dolby Atmos desativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această opțiune va diminua calitatea audio și va dezactiva Dolby Atmos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этом качество аудио понизится, а Dolby Atmos выключится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto znížite kvalitu audia a zakážete Dolby Atmos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste zmanjšali kakovost zvoka in onemogočili Dolby Atmos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer att försämra ljudkvaliteten och avaktivera Dolby Atmos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานนี้จะลดคุณภาพเสียงและปิดใช้งาน Dolby Atmos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, ses kalitesini düşürür ve Dolby Atmos’u etkisizleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це знизить якість звуку й вимкне Dolby Atmos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này sẽ làm giảm chất lượng âm thanh và tắt Dolby Atmos."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将降低音质并停用杜比全景声。"
