    "AccountsEditUserManualConfirmationMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تسجيل الدخول يدويًا، يمكنك الوصول إلى بيانات الوسائط والاشتراكات والألعاب. وعند تسجيل الدخول باستخدام iPhone، يسمح ذلك لـ Apple TV أيضًا بالوصول إلى بيانات iCloud بأمان."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si inicies sessió manualment, podràs accedir al contingut multimèdia, les subscripcions i les dades dels jocs. Per contra, si ho fas amb l’iPhone, l’Apple TV també podrà accedir de manera segura a les dades de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručním přihlášením získáte přístup k médiím, předplatnému a herním datům. Přihlášením pomocí iPhonu také umožníte této Apple TV bezpečný přístup ke všem vašim datům na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du logger ind manuelt, får du adgang til dine medier, abonnementer og spildata. Når du logger ind med iPhone, får Apple TV adgang til dine iCloud-data på sikker vis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die manuelle Anmeldung ermöglicht den Zugriff auf deine Medien, Abonnements und Spieledaten. Durch das Anmelden mit dem iPhone kann das Apple TV auf sichere Art auf deine iCloud-Daten zugreifen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χειροκίνητη σύνδεση επιτρέπει την πρόσβαση στα πολυμέσα, τις συνδρομές και τα δεδομένα παιχνιδιών σας. Η σύνδεση μέσω iPhone επιτρέπει επίσης στο Apple TV να προσπελάζει με ασφάλεια τα δεδομένα iCloud σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in manually allows access to your media, subscriptions, and game data. Signing in with iPhone also allows Apple TV to securely access your iCloud data."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in manually allows access to your media, subscriptions and game data. Signing in with iPhone also allows Apple TV to securely access your iCloud data."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in manually allows access to your media, subscriptions and game data. Signing in with iPhone also allows Apple TV to securely access your iCloud data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión de forma manual permite acceder a tus contenidos, suscripciones y datos de juegos. Iniciar sesión con el iPhone permite además que el Apple TV pueda acceder de forma segura a tus datos de iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si inicias sesión de forma manual, podrás acceder a tu contenido, suscripciones y datos de juegos. Al hacerlo mediante el iPhone, se permitirá también que el Apple TV acceda de forma segura a tus datos en iCloud."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Si inicias sesión de forma manual, podrás acceder a tu contenido, suscripciones y datos de juegos. Al hacerlo mediante el iPhone, se permitirá también que el Apple TV acceda de forma segura a tus datos en iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kirjaudut sisään käsin, voit käyttää mediaasi, tilauksiasi ja pelitietojasi. Jos kirjaudut sisään iPhonella, voit myös käyttää iCloud-tietojasi suojatusti Apple TV:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous vous connectez manuellement, cette Apple TV aura accès à votre contenu multimédia, à vos abonnements et aux données de vos jeux. Si vous vous connectez avec votre iPhone, elle pourra également accéder en toute sécurité à vos données iCloud."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion manuelle autorise l’accès à vos contenus multimédias, abonnements et données de jeux. La connexion avec votre iPhone permet également à l’Apple TV d’accéder en sécurité à vos données iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברות ידנית מאפשרת גישה אל המדיה, המינויים ונתוני המשחקים שלך. התחברות באמצעות ה-iPhone מאפשרת ל‑Apple TV גם לגשת בצורה מאובטחת לנתוני ה-iCloud שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैनुअली साइन इन करने से आपके मीडिया, सब्सक्रिप्शन और गेम डेटा ऐक्सेस करने अनुमति मिल जाती है। iPhone से साइन इन करने पर Apple TV को आपका iCloud डेटा सुरक्षित रूप से ऐक्सेस करने की भी अनुमति मिल जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručnim prijavljivanjem omogućava se pristupanje medijima, pretplatama i podacima igara. Prijavljivanjem pomoću iPhonea također se Apple TV-u omogućava siguran pristup vašim iCloud podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A manuális bejelentkezéssel hozzáférhet médiatartalmaihoz, előfizetéseihez és játékadataihoz. Az iPhone-nal való bejelentkezés emellett lehetővé teszi az Apple TV számára, hogy biztonságosan hozzáférjen az Ön iCloud-adataihoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk secara manual memungkinkan akses ke media, langganan, dan data game Anda. Masuk dengan iPhone juga memungkinkan Apple TV untuk mengakses data iCloud Anda dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il login manuale consente di accedere ai contenuti multimediali, agli abbonamenti e ai dati di gioco. L’accesso tramite iPhone consente ad Apple TV di accedere in modo sicuro anche ai dati di iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動でサインインすると、メディア、サブスクリプション、およびゲームデータへのアクセスを許可できます。iPhoneでサインインすると、Apple TVのiCloudデータへ安全にアクセスすることも可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동으로 계정에 로그인하면 사용자의 미디어, 구독 및 게임 데이터에 접근할 수 있습니다. iPhone으로 로그인하면 Apple TV에서 iCloud 데이터에 안전하게 접근하는 것도 가능합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendaftar masuk secara manual membenarkan akses kepada media, langganan dan data permainan anda. Mendaftar masuk dengan iPhone juga membolehkan Apple TV mengakses data iCloud anda dengan selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell pålogging gir tilgang til mediene, abonnementene og spilldataene dine. Pålogging fra iPhone gir også Apple TV sikker tilgang til iCloud-dataene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je handmatig inlogt, heb je toegang tot je media, abonnementen en gamegegevens. Als je inlogt met je iPhone heeft je Apple TV bovendien veilig toegang tot je iCloud-gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręczne zalogowanie się daje dostęp do swoich multimediów, subskrypcji i danych gier. Jeśli zalogujesz się, używając iPhone’a, Apple TV będzie mieć także bezpieczny dostęp do Twoich danych iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você iniciar a sessão manualmente, terá acesso aos seus dados de conteúdo, assinaturas e jogos. Se você iniciar a sessão com o iPhone, a Apple TV acessará seus dados do iCloud com segurança."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessão manualmente permite aceder aos seus conteúdos multimédia, assinaturas e dados de jogos. Iniciar sessão com o iPhone também permite que a Apple TV aceda com segurança aos seus dados em iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea manuală vă permite accesul la conținutul multimedia, abonamente și datele jocurilor. Autentificarea cu iPhone‑ul permite în plus Apple TV‑ului să acceseze în mod securizat datele dvs. iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнив вход вручную, Вы получите доступ к своим подпискам, данным игр и медиаконтенту. Если выполнить вход на iPhone, Apple TV также получит безопасный доступ к Вашим данным в iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuálnym prihlásením získate prístup k svojim médiám, odberom a herným dátam. Prihlásením pomocou iPhonu zároveň umožníte Apple TV bezpečne pristupovať k vašim dátam na iCloude."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če se vpišete ročno, boste lahko dostopali do predstavnostnih vsebin, naročnin in podatkov iger. Vpis z iPhonom prav tako omogoča Apple TV-ju, da varno dostopa do vaših podatkov v storitvi iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du loggar in manuellt får du tillgång till dina medier, abonnemang och speldata. När du loggar in med iPhone kan Apple TV även komma åt dina iCloud-data på ett säkert sätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าด้วยตนเองจะอนุญาตการเข้าถึงสื่อ รายการสมัครรับ และข้อมูลเกมของคุณ การลงชื่อเข้าด้วย iPhone ยังอนุญาตให้ Apple TV เข้าถึงข้อมูล iCloud ของคุณอย่างปลอดภัยด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle giriş yapmak ortamlarınıza, aboneliklerinize ve oyun verilerinize erişime izin verir. iPhone ile giriş yapma da Apple TV’nin iCloud verilerinize güvenle erişmesini sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід вручну дає змогу отримати доступ до медіавмісту, підписок і даних ігор. Якщо ввійти через iPhone, Apple TV також матиме захищений доступ до даних iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đăng nhập thủ công cho phép truy cập vào phương tiện, đăng ký và dữ liệu trò chơi của bạn. Việc đăng nhập bằng iPhone cũng cho phép Apple TV truy cập bảo mật vào dữ liệu iCloud của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "手动登录允许访问你的媒体、订阅和游戏数据。通过iPhone登录还允许Apple TV安全访问你的iCloud数据。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以手動登入讓你取用媒體、訂閲項目和遊戲資料。透過iPhone登入也能讓Apple TV安全地取用你的iCloud資料。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手動登入可允許取用你的媒體、訂閱項目和遊戲資料。使用iPhone登入也可讓Apple TV安全地取用你的iCloud資料。"
          }
        }
      }
    },
    "AccountsEditUserManualConfirmationTitle": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب بالتأكيد في تسجيل الدخول يدويًا؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes que vols iniciar sessió manualment?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určitě se chcete ručně přihlásit?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil logge ind manuelt?"
          }
        },
        "de": {
