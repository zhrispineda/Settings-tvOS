    "iCloudPhotoSectionDescriptionInline": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض جميع صورك وفيديوهاتك، شغل صور iCloud أيضًا على iPhone و iPad و Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per veure tots els vídeos i fotos, activa les fotos a l’iCloud a l’iPhone, a l’iPad i al Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li zobrazit všechny fotky a videa, zapněte fotky na iCloudu také na svém iPhonu, iPadu a Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil se alle dine fotos og videoer, skal du også slå iCloud-fotos til på din iPhone, iPad og Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alle Fotos und Videos anzuzeigen, aktiviere iCloud-Fotos auch auf deinem iPhone, iPad und Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για προβολή των φωτό και βίντεό σας, ενεργοποιήστε επίσης τις Φωτογραφίες iCloud στο iPhone, iPad και Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To view all your photos and videos, also turn on iCloud Photos on your iPhone, iPad, and Mac."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To view all your photos and videos, also turn on iCloud Photos on your iPhone, iPad and Mac."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To view all your photos and videos, also turn on iCloud Photos on your iPhone, iPad and Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver todas tus fotos y vídeos, activa las fotos en iCloud también en el iPhone, iPad y Mac."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver todos tus videos y fotos, activa también Fotos en iCloud en tu iPhone, iPad y Mac."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver todos tus videos y fotos, activa también Fotos en iCloud en tu iPhone, iPad y Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kuvasi ja videosi ovat katsottavissa, kun laitat iCloud-kuvat päälle myös iPhonessa, iPadissa ja Macissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher toutes vos photos et vidéos, activez également Photos iCloud sur votre iPhone, votre iPad et votre Mac."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher toutes vos photos et vidéos, activez aussi les photos iCloud sur votre iPhone, votre iPad et votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג את כל התמונות והסרטונים שלך, באפשרותך להפעיל את ״תמונות iCloud״ גם ב-iPhone, ב-iPad וב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सभी तस्वीरें और वीडियो देखने के लिए अपने iPhone, iPad और Mac पर iCloud तस्वीर भी चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za gledanje svih svojih fotografija i videozapisa također uključite iCloud fotografije na iPhoneu, iPadu i Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes fotója és videója megtekintéséhez kapcsolja be az iCloud-fotókat az iPhone-ján, iPadjén és Macjén is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat semua foto dan video, nyalakan juga Foto iCloud di iPhone, iPad, dan Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per visualizzare le foto e i video, attiva l’opzione “Foto di iCloud” anche su iPhone, iPad e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真とビデオを表示するには、iPhone、iPad、およびMacでもiCloud写真をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사진과 비디오를 보려면 iPhone, iPad 및 Mac에서도 iCloud 사진을 켜십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat semua foto dan video anda, turut aktifkan Foto iCloud pada iPhone, iPad dan Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå også på iCloud Bilder på iPhone, iPad og Mac for å se alle bildene og videoene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om al je foto's en video's te zien, schakel je iCloud-foto's ook in op je iPhone, iPad en Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyświetlać wszystkie swoje zdjęcia i wideo, włącz Zdjęcia w iCloud również na iPhonie, iPadzie i Macu."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver todas as suas fotos e vídeos, ative as Fotos do iCloud também no seu iPhone, iPad e Mac."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver todas as suas fotografias e vídeos, ative também Fotografias em iCloud no iPhone, iPad e Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vă vedea toate pozele și clipurile video, activați Poze iCloud și pe iPhone, iPad și Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просмотра всех фотографий и видео включите Фото iCloud на Ваших iPhone, iPad и Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete prezerať všetky svoje fotky a videá, zapnite iCloud Fotky aj na iPhone, iPade a Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če si želite ogledati vse fotografije in videoposnetke, funkcijo Fotografije iCloud vklopite tudi v svojem iPhonu, iPadu in Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill visa alla bilder och videor aktiverar du även iCloud-bilder på iPhone, iPad och datorn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการดูรูปภาพและวิดีโอทั้งหมดของคุณ ให้เปิดใช้ “รูปภาพ iCloud” บน iPhone, iPad และเครื่อง Mac ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınızı ve videolarınızı görüntülemek için iCloud Fotoğrafları’nı iPhone, iPad ve Mac üzerinde de açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб бачити всі свої фото і відео, також увімкніть Фото iCloud на своєму iPhone, iPad і Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem tất cả ảnh và video của bạn, hãy bật đồng thời Ảnh iCloud trên iPhone, iPad và máy Mac của bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要查看所有照片和视频，请在iPhone、iPad和Mac上也打开“iCloud照片”。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要檢視所有相片和影片，也請在iPhone、iPad和Mac上開啟「iCloud相片」。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要檢視所有照片和影片，也請開啟iPhone、iPad和Mac上的「iCloud照片」。"
          }
        }
      }
    },
    "iCloudPhotoSectionDescriptionNew": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمشاهدة صورك وفيديوهاتك على Apple TV، يرجى التأكد من تسجيل الدخول إلى جهاز آخر من Apple تم تشغيل صور iCloud عليه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mostrar les fotos i els vídeos a l’Apple TV, cal que hagis iniciat la sessió en un altre dispositiu Apple que tingui activades les fotos a l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete‑li si své fotky a videa prohlížet na Apple TV, přihlaste se k jinému zařízení Apple, na kterém je zapnutá služba Fotky na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil se dine fotos og videoer på Apple TV, skal du være logget ind på en anden Apple-enhed, hvor iCloud-fotos er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Fotos und Videos auf dem Apple TV zu sehen, stelle sicher, dass du auf einem anderen Apple-Gerät angemeldet bist, auf dem „iCloud-Fotos“ aktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για προβολή των φωτογραφιών και βίντεό σας στο Apple TV, βεβαιωθείτε ότι έχετε συνδεθεί σε μια άλλη συσκευή Apple που έχει ενεργοποιημένες τις Φωτογραφίες iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your photos and videos on Apple TV, make sure you are signed in to another Apple device that has iCloud Photos turned on."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your photos and videos on Apple TV, make sure you are signed in to another Apple device that has iCloud Photos turned on."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your photos and videos on Apple TV, make sure you are signed in to another Apple device that has iCloud Photos turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver tus fotos y vídeos en el Apple TV, debes haber iniciado sesión en otro dispositivo Apple en el que se haya activado Fotos en iCloud."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver tus fotos y videos en el Apple TV, asegúrate de haber iniciado sesión en otro dispositivo Apple donde Fotos en iCloud se encuentre activado."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver tus fotos y videos en el Apple TV, asegúrate de haber iniciado sesión en otro dispositivo Apple donde Fotos en iCloud se encuentre activado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat nähdä kuvasi ja videosi Apple TV:ssä, varmista, että olet kirjautunut toiseen Apple-laitteeseen, jossa iCloud-kuvat on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher vos photos et vos vidéos sur l’Apple TV, Photos iCloud doit être activé sur un autre appareil connecté à votre compte Apple."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que vos photos et vidéos puissent s’afficher sur l’Apple TV, un autre appareil Apple sur lequel l’option Photos iCloud est activée doit être connecté à votre compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לראות את התמונות והסרטונים שלך ב‑Apple TV, יש לוודא שהתחברת למכשיר Apple אחר ש״תמונות iCloud״ מופעל בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV पर अपनी तस्वीरें और वीडियो देखने के लिए सुनिश्चित करें कि आपने ऐसे अन्य Apple डिवाइस पर साइन इन किया हो जिस पर iCloud तस्वीर चालू हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prikazivanje vaših fotografija i videozapisa na Apple TV-u trebate biti prijavljeni na drugi Apple uređaj na kojem su uključene iCloud fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha meg szeretné tekinteni a fotóit és videóit az Apple TV‑n, győződjön meg róla, hogy be van jelentkezve egy másik Apple-eszközön, amelyen az iCloud-fotók be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat foto dan video Anda di Apple TV, pastikan Anda masuk ke perangkat Apple lain yang menyalakan Foto iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere le tue foto e i tuoi video su Apple TV, assicurati di aver effettuato l’accesso a un altro dispositivo Apple su cui è abilitata l’opzione “Foto di iCloud”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVで写真やビデオを表示するには、iCloud写真がオンになっている別のAppleデバイスにサインインしていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV에서 사진 및 비디오를 보려면 iCloud 사진이 켜져 있는 다른 Apple 기기에 로그인되어 있어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat foto dan video anda pada Apple TV, pastikan anda didaftar masuk ke peranti Apple lain yang telah mengaktifkan Foto iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil se bildene og videoene dine på Apple TV, må du være pålogget samme konto på en annen Apple-enhet der iCloud Bilder er slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je foto's en video's te zien op de Apple TV, zorg je dat je ingelogd bent op een ander Apple apparaat waarop iCloud-foto's is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyświetlać swoje zdjęcia i wideo na Apple TV, zaloguj się na innym urządzeniu Apple, na którym włączona jest funkcja Zdjęcia w iCloud."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver suas fotos e vídeos na Apple TV, confira se você iniciou a sessão em outro dispositivo que tenha as Fotos do iCloud ativadas."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver as suas fotografias e vídeos na Apple TV, certifique‑se de que tem sessão iniciada noutro dispositivo Apple com a funcionalidade Fotografias em iCloud ativada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vă vedea pozele și clipurile video pe Apple TV, asigurați‑vă că v‑ați autentificat pe un alt dispozitiv Apple care are activată opțiunea Poze iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать свои фото и видео на Apple TV, убедитесь, что на другом устройстве Apple выполнен вход с тем же Аккаунтом Apple и включена функция «Фото iCloud»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete prezerať svoje fotky a videá na Apple TV, uistite sa, že ste prihlásení na inom Apple zariadení, na ktorom je zapnutá služba iCloud Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ogled fotografij in videov v Apple TV-ju se prepričajte, da ste vpisani v drugo napravo Apple, ki ima vklopljeno funkcijo Fotografije iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill visa bilder och videor på Apple TV måste du vara inloggad på en annan Apple-enhet som har aktiverat iCloud-bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการดูรูปภาพและวิดีโอของคุณบน Apple TV ตรวจสอบให้แน่ใจว่าคุณลงชื่อเข้าอุปกรณ์ Apple เครื่องอื่นที่เปิดใช้ “รูปภาพบน iCloud”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınızı ve videolarınızı Apple TV’de görmek için iCloud Fotoğrafları’nın açık olduğu başka bir Apple aygıtında giriş yaptığınızdan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб переглядати фотографії та відео на Apple TV, функцію «Фото iCloud» має бути ввімкнено на іншому пристрої Apple, який використовує цей обліковий запис Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem ảnh và video của bạn trên Apple TV, hãy đảm bảo rằng bạn đã đăng nhập vào một thiết bị Apple khác được bật Ảnh iCloud."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在Apple TV上查看照片和视频，请确保已在打开“iCloud照片”的另一台Apple设备上登录。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要在Apple TV上查看你的相片和影片，請確定你已在另一部開啟了「iCloud相片」的Apple裝置上登入。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在Apple TV上查看你的照片和影片，請確定你已登入其他開啟「iCloud照片」的Apple裝置。"
          }
        }
      }
    },
