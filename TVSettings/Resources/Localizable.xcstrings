          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavuje hlasitost médií podle toho, v jak hlučném prostředí se právě nacházíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Justerer lydstyrken til medier baseret på dine omgivelser."
          }
        },
        "de": {
          "stringUnit": {
