          "stringUnit": {
            "state": "translated",
            "value": "Pentru a schimba această configurare, trebuie să aveți o telecomandă asociată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы изменить эту настройку, нужен пульт, с которым создана пара."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zmenu tohto nastavenia potrebujete spárovaný ovládač."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite spremeniti to nastavitev, morate imeti seznanjen daljinec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill ändra den här inställningen måste du ha en parkopplad fjärrkontroll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการเปลี่ยนการตั้งค่านี้ คุณต้องมีรีโมทที่จับคู่อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarı değiştirmek için eşlenmiş bir kumandanız olması gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінити це налаштування, вам потрібно спарити пульт."
