    "AVSurroundConvertFormatDialogAtmosUnavailableMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى تقليل جودة الصوت، لكنه قد يكون أكثر توافقًا."
          }
        },
        "ca": {
          "stringUnit": {
