    "SupervisedDeviceDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Apple TV خاضع للإشراف. وبإمكان مؤسستك مراقبة حركة مرور الإنترنت على هذا الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest Apple TV està supervisat. La teva organització pot controlar el trànsit d’internet en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV je pod dohledem. Vaše organizace může monitorovat vaši aktivitu na internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette Apple TV er under tilsyn. Din organisation kan overvåge internettrafikken på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Apple TV wird betreut. Deine Organisation kann den Internetverkehr auf diesem Gerät überwachen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Apple TV είναι επιβλεπόμενο και ο οργανισμός σας μπορεί να παρακολουθεί τη διαδικτυακή δραστηριότητα σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV is supervised. Your organization can monitor the internet traffic on this device."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV is supervised. Your organisation can monitor the internet traffic on this device."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV is supervised. Your organisation can monitor the internet traffic on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Apple TV es un dispositivo supervisado, de modo que tu organización puede monitorizar el tráfico de internet que hay en él."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu organización supervisa este Apple TV y puede observar el tráfico de Internet."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu organización supervisa este Apple TV y puede observar el tráfico de Internet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä Apple TV:tä valvotaan. Organisaatiosi voi tarkkailla tämän laitteen internet-liikennettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV est supervisée. Votre établissement peut surveiller le trafic Internet sur cet appareil."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Apple TV est supervisée. Votre organisation peut surveiller le trafic Internet de cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Apple TV זה נמצא בפיקוח. הארגון שלך יכול לנטר את תעבורת האינטרנט במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Apple TV पर्यवेक्षित है। आपका संगठन इस डिवाइस पर आपके इंटरनेट ट्रैफ़िक की निगरानी कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Apple TV je pod nadzorom. Vaša organizacija može pratiti internetski promet na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy felügyelt Apple TV. A szervezete figyelheti az internetforgalmat ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini diawasi. Organisasi Anda dapat memonitor lalu lintas internet di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV è supervisionata. La tua organizzazione può monitorare il traffico internet su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVは監視されています。企業/団体はこのデバイスのインターネットのトラフィックをモニターできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple TV는 감독 중인 기기입니다. 사용자의 조직에서 이 기기의 인터넷 트래픽을 모니터할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV ini diselia. Organisasi anda boleh memantau trafik Internet pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV er under tilsyn. Organisasjonen kan overvåke nettbruken på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Apple TV wordt beheerd. Je organisatie kan het internetverkeer op dit apparaat bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Apple TV jest nadzorowany. Twoja organizacja może monitorować dane przesyłane przez Internet przy użyciu tego urządzenia."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple TV é supervisionada. A sua organização pode monitorar o tráfego de internet neste dispositivo."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple TV é supervisionada. A sua organização pode controlar a utilização da internet neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Apple TV este supervizat. Organizația dvs. poate să monitorizeze traficul de internet pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Apple TV контролируется. Ваша организация может выполнять мониторинг интернет‑трафика на данном устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto Apple TV je pod dohľadom. Vaša organizácia môže monitorovať internetové pripojenie tohto zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Apple TV je nadzorovan. Vaša organizacija lahko spremlja internetni promet v tej napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Apple TV administreras. Din organisation kan övervaka internetanvändningen på den här enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV เครื่องนี้ถูกกำกับดูแล องค์กรของคุณสามารถสังเกตการณ์ข้อมูลสื่อสารทางอินเทอร์เน็ตบนอุปกรณ์เครื่องนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple TV denetlenip yönetiliyor. Kurumunuz bu aygıttaki internet trafiğini izleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Apple TV перебуває під наглядом. Ваша організація може стежити за інтернет-трафіком на цьому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV này được kiểm soát. Tổ chức của bạn có thể giám sát lưu lượng truy cập internet trên thiết bị này."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV受监管。你的所属机构可以监视此设备的互联网流量。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV已受監管。你的機構可以監控此裝置的互聯網流量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此Apple TV已被監管。你的組織可以監控此裝置上的網際網路流量。"
          }
        }
      }
    },
    "SupervisedDeviceOrgDescriptionFormat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Apple TV خاضع للإشراف وبإمكان \"%@\" مراقبة حركة مرور الإنترنت على هذا الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest Apple TV està supervisat, de manera que “%@” pot controlar el trànsit d’internet en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV je pod dohledem. Organizace %@ může monitorovat vaši aktivitu na internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette Apple TV er under tilsyn, og “%@” kan overvåge internettrafikken på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Apple TV wird betreut und „%@“ kann den Internetverkehr auf diesem Gerät überwachen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Apple TV είναι επιβλεπόμενο και ο οργανισμός «%@» μπορεί να παρακολουθεί τη διαδικτυακή δραστηριότητα σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV is supervised, and “%@” can monitor the internet traffic on this device."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple TV is supervised and “%@” can monitor the internet traffic on this device."
