            "state": "translated",
            "value": "設定你的音量控制。\n已停用，因為沒有連接遙控器。"
          }
        }
      }
    },
    "RCVCInstructionalTextOdeon": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم الريموت تلقائيًا في مستوى صوت سماعات HomePod المحددة في إعدادات إخراج الصوت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El comandament controla automàticament el volum dels HomePod seleccionats a la configuració de sortida d’àudio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovladač automaticky mění hlasitost reproduktorů HomePod, které jsou vybrané v nastavení zvukového výstupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernbetjeningen styrer automatisk lydstyrken på de HomePod-højttalere, der er valgt i indstillingerne til lyd ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fernbedienung regelt die Lautstärke der in den Einstellungen für „Audioausgang“ gewählten HomePod-Lautsprecher automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τηλεχειριστήριό σας ελέγχει αυτόματα την ένταση του ήχου των ηχείων HomePod που έχουν επιλεγεί στις ρυθμίσεις Εξόδου ήχου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your remote automatically controls the volume of the HomePod speakers selected in Audio Output settings."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your remote automatically controls the volume of the HomePod speakers selected in Audio Output settings."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your remote automatically controls the volume of the HomePod speakers selected in Audio Output settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mando a distancia controla automáticamente el volumen de los altavoces HomePod seleccionados en los ajustes de salida de audio."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de cada HomePod seleccionado en la configuración de salida de audio se controla de forma automática mediante tu control remoto."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de cada HomePod seleccionado en la configuración de salida de audio se controla de forma automática mediante tu control remoto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaukosäädin ohjaa Äänilähtö-asetuksissa valittujen HomePod-kaiuttimien äänenvoimakkuutta automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre télécommande contrôle automatiquement le volume des haut-parleurs du HomePod sélectionné dans les réglages Sortie audio."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre télécommande contrôle automatiquement le volume des HomePod sélectionnés dans les réglages Sortie audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלט שלך יכול לשלוט באופן אוטומטי בעוצמת השמע של רמקולי ה-HomePod שנבחרו בהגדרות ״פלט שמע״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका रिमोट ऑडियो आउटपुट सेटिंग में चयनित HomePod स्पीकर का वॉल्यूम ऑटोमैटिकली नियंत्रित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš upravljač automatski upravlja glasnoćom HomePod zvučnika koji su odabrani u postavkama Audio izlaz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távirányítója automatikusan vezérli a Hangkimenet beállításaiban kiválasztott HomePod-hangszórók hangerejét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Anda akan secara otomatis mengontrol volume speaker HomePod yang dipilih di pengaturan Output Audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telecomando controlla automaticamente il volume degli altoparlanti HomePod selezionati nelle impostazioni dell’uscita audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“オーディオ出力”設定で選択されているHomePodスピーカーの音量がリモコンで自動的にコントロールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 출력 설정에서 선택한 HomePod 스피커의 음량을 리모컨이 자동으로 제어합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawalan jauh anda mengawal kelantangan speaker HomePod yang dipilih dalam seting Output Audio secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernkontrollen styrer automatisk volumet på HomePod-høyttalerne som er valgt i Lyd ut-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je afstandsbediening regelt automatisch het volume van de HomePod-luidsprekers die in de instellingen voor audio-uitvoer zijn geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot automatycznie steruje głośnością HomePodów wybranych w ustawieniach wyjścia dźwięku."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle remoto controla automaticamente o volume do HomePod selecionado nos ajustes de Saída de Áudio."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando controla automaticamente o volume das colunas HomePod selecionadas nas definições de Saída de áudio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telecomanda dvs. controlează în mod automat volumul difuzoarelor HomePod selectate în configurările Ieșire audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пульт автоматически управляет громкостью колонок HomePod, выбранных в разделе настроек «Аудиовыход»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládač automaticky mení hlasitosť HomePodov, ktoré sú vybrané v nastaveniach audiovýstupu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daljinec samodejno nadzoruje glasnost zvočnikov HomePod, izbranih v nastavitvah zvočnega izhoda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fjärrkontroll styr automatiskt volymen på HomePod-högtalarna som markerats i inställningarna för Ljud ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโมทของคุณควบคุมระดับเสียงของลำโพง HomePod ที่เลือกได้โดยอัตโนมัติในการตั้งค่าสัญญาณเสียงออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumandanız, Ses Çıkışı ayarlarında seçili HomePod hoparlörlerinin ses yüksekliğini otomatik olarak denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульт автоматично керує гучністю динаміків HomePod, заданих у параметрах аудіовиводу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển từ xa của bạn tự động điều khiển âm lượng của các loa HomePod được chọn trong cài đặt Đầu ra âm thanh."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你的遥控器会自动控制“音频输出”设置中所选HomePod扬声器的音量。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的遙控器會自動控制「音訊輸出」設定中所選HomePod喇叭的音量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的遙控器會自動控制「音訊輸出」設定中所選的HomePod揚聲器音量。"
          }
        }
      }
    },
