            "value": "Ajusta el volumen del contenido en respuesta a tu entorno."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el volumen del contenido en respuesta a tu entorno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säätää median äänenvoimakkuutta ympäristön mukaan."
          }
        },
        "fr": {
