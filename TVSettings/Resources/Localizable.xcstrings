    "AccountsUserPasswordPurchasesAlertMessage": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إجراء عملية شراء ما باستخدام حساب Apple ‏\"%@\"، هل ترغب في المطالبة بإدخال كلمة السر لإجراء عمليات الشراء الإضافية على هذا الجهاز؟ يمكنك تغيير ذلك في أي وقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de fer una compra amb el compte d’Apple %@, vols sol·licitar la contrasenya per fer‑ne més al dispositiu? Pots canviar‑ho en qualsevol moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete po provedení nákupu pod účtem „%@“ požadovat pro další nákupy na tomto zařízení heslo? Vybranou volbu můžete kdykoli změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv adgangskode til flere køb på denne enhed, efter at der er foretaget køb med Apple-kontoen “%@”? Du kan altid ændre denne indstilling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll nach einem Kauf mit dem Apple Account „%@“ für weitere Käufe auf diesem Gerät ein Passwort angefordert werden? Dies kann jederzeit geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την πραγματοποίηση αγοράς με τον λογαριασμό Apple «%@», να απαιτείται συνθηματικό για πρόσθετες αγορές σε αυτήν τη συσκευή; Μπορείτε να αλλάξετε αυτήν την επιλογή ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with the Apple Account “%@”, require password for additional purchases on this device? You can change this at any time."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with the Apple Account “%@”, require password for additional purchases on this device? You can change this at any time."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "After making a purchase with the Apple Account “%@”, require password for additional purchases on this device? You can change this at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras comprar con la cuenta de Apple %@, ¿quieres que se solicite la contraseña para hacer más compras en este dispositivo? Puedes cambiar este ajuste en cualquier momento."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Solicitar la contraseña de la cuenta de Apple “%@” para realizar más compras en este dispositivo después de haber realizado una? Puedes cambiar esto en cualquier momento."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Solicitar la contraseña de la cuenta de Apple “%@” para realizar más compras en este dispositivo después de haber realizado una? Puedes cambiar esto en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaaditaanko lisäostoille salasana tässä laitteessa, kun olet ostanut Apple-tilillä %@? Voit muuttaa tätä milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un premier achat effectué sur cet appareil avec le compte Apple « %@ », exiger le mot de passe pour tout achat supplémentaire ? Vous pouvez modifier ce réglage à tout moment."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger le mot de passe pour effectuer d’autres achats sur cet appareil après avoir effectué un achat avec le compte Apple « %@ »? Vous pouvez modifier ce réglage à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר ביצוע רכישה באמצעות חשבון ה-Apple ״%@״, האם לדרוש סיסמה עבור רכישות נוספות במכשיר זה? ניתן לשנות זאת בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple खाते “%@” से ख़रीदारी करने के बाद इस डिवाइस पर अतिरिक्त ख़रीदारी के लिए पासवर्ड आवश्यक है? आप इसे किसी भी समय बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon obavljanja kupnje Apple računom “%@”, zatražiti lozinku za dodatne kupnje na ovom uređaju? To možete promijeniti u bilo kojem trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja, hogy a(z) „%@” Apple-fiókkal végzett vásárlások után jelszót kelljen megadni az ezen az eszközön végzett további vásárlásokhoz? Ezt bármikor módosíthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah melakukan pembelian dengan Akun Apple “%@”, apakah kata sandi akan diperlukan untuk pembelian tambahan di perangkat ini? Anda dapat mengubah ini kapan pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver effettuato un acquisto con l’Apple Account “%@”, vuoi che ti venga richiesta la password anche per gli eventuali altri acquisti su questo dispositivo? Puoi modificare l’opzione in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account “%@”で購入したあと、このデバイスで追加で購入するときにパスワードを要求しますか? これはいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ Apple 계정으로 구입한 후 이 기기에서 추가 구입을 하는 경우 암호를 요구하겠습니까? 이 설정은 언제든지 변경할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas membuat pembelian dengan Akaun Apple “%@”, perlukan kata laluan untuk pembelian tambahan pada peranti ini? Anda boleh menukarnya pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du kreve passord for ytterligere kjøp på enheten etter at du har gjort et kjøp med Apple-kontoen «%@»? Du kan endre dette når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet na het doen van een aankoop met de Apple Account '%@' een wachtwoord worden ingevoerd voor aanvullende aankopen op dit apparaat? Je kunt dit op elk moment wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy po użyciu konta Apple „%@” do dokonania zakupu na tym urządzeniu kolejne zakupy mają wymagać podania hasła? Możesz to zmienić w dowolnym momencie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após fazer uma compra com a Conta Apple “%@”, exigir senha para compras adicionais com este dispositivo? Você pode alterar essa decisão a qualquer momento."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após efetuar uma compra com a conta Apple “%@”, pedir palavra‑passe para fazer compras adicionais neste dispositivo? Esta opção pode ser alterada em qualquer altura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doriți solicitarea parolei pentru cumpărăturile suplimentare de pe acest dispozitiv după efectuarea unei achiziții cu contul Apple „%@”? Puteți schimba oricând această opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивать пароль для других покупок на этом устройстве после совершения покупки с использованием Аккаунта Apple %@? Этот параметр можно изменить в любое время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete po zakúpení položky pomocou Apple účtu „%@“ vyžadovať heslo pre ďalšie nákupy na tomto zariadení? Môžete to kedykoľvek zmeniť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite po opravljenem nakupu z računom Apple »%@« zahtevati geslo ob naknadnih nakupih s to napravo? To lahko kadarkoli spremenite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du kräva ett lösenord för fler köp på den här enheten när du har köpt något med Apple‑kontot ”%@”? Du kan när som helst ändra detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากที่ใช้บัญชี Apple “%@” ซื้อสินค้าแล้ว คุณต้องการให้ใส่รหัสผ่านสำหรับซื้อสินค้าเพิ่มเติมบนอุปกรณ์เครื่องนี้หรือไม่ คุณสามารถเปลี่ยนการตั้งค่านี้ได้ตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Apple Hesabı ile alışveriş yaptıktan sonra bu aygıttaki diğer alışverişler için parola gereksin mi? Bunu istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитувати пароль для інших покупок на цьому пристрої після здійснення покупки з обліковим записом Apple «%@»? Це можна змінити будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi thực hiện mục mua bằng Tài khoản Apple “%@”, yêu cầu mật khẩu cho các mục mua khác trên thiết bị này? Bạn có thể thay đổi tùy chọn này bất kỳ lúc nào."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过Apple账户“%@”完成一次购买后，在此设备上继续购买还需要输入密码吗？你可以随时更改。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Apple帳户「%@」在此裝置上購物後，再次購買時需要重新輸入密碼嗎？你可隨時更改此設定。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
