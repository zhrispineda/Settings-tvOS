        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "For Apple Media Services terms and conditions, please visit apple.com/au/legal/internet-services/itunes"
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For Apple Media Services terms and conditions, please visit apple.com/uk/legal/internet-services/itunes/"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver los términos y condiciones de los servicios de contenido multimedia de Apple, visita el sitio www.apple.com/es/legal/internet-services/itunes/"
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver los Términos y condiciones de los servicios de contenido multimedia de Apple, visita https://www.apple.com/mx/legal/internet-services/itunes/mx/terms.html."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver los Términos y condiciones de los servicios de contenido multimedia de Apple, visita https://www.apple.com/mx/legal/internet-services/itunes/mx/terms.html."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen mediapalveluiden käyttöehdot löytyvät osoitteesta www.apple.com/fi/legal/internet-services/itunes/"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour consulter les conditions générales des services Apple Media, veuillez vous rendre à l’adresse https://www.apple.com/fr/legal/internet-services/itunes/fr/terms.html"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour consulter les modalités des services multimédias Apple, rendez-vous sur www.apple.com/ca/fr/legal/internet-services/itunes/."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לצפייה בתקנון של ״שירותי המדיה של Apple״ יש לבקר בכתובת www.apple.com/legal/internet-services/itunes/‎"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple मीडिया सेवा के नियमों व शर्तों के लिए कृपया www.apple.com/in/legal/internet-services/itunes/ देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za Odredbe i uvjete Appleovih medijskih usluga posjetite www.apple.com/legal/internet-services/itunes/"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Médiaszolgáltatások használati feltételeinek elolvasásához keresse fel a www.apple.com/legal/internet-services/itunes/ weboldalt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk syarat dan ketentuan Layanan Media Apple, kunjungi www.apple.com/legal/internet-services/itunes/"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per consultare i termini e le condizioni dei servizi multimediali di Apple, vai alla pagina www.apple.com/it/legal/internet-services/itunes/"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleメディアサービスの利用規約については、https://www.apple.com/jp/legal/internet-services/itunes/jp/terms.html をご参照ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 미디어 서비스 이용 약관을 보려면 www.apple.com/legal/internet-services/itunes/ 사이트로 이동하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk terma dan syarat Perkhidmatan Media Apple, sila lawati www.apple.com/legal/internet-services/itunes/my/terms.html"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vilkår og betingelser for Apple Media på www.apple.com/no/legal/internet-services/itunes/."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de voorwaarden voor Apple Media Services te bekijken, ga je naar www.apple.com/nl/legal/internet-services/itunes/"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunki i zasady korzystania z usług Apple Media są dostępne pod adresem www.apple.com/pl/legal/internet-services/itunes/."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesse www.apple.com/br/legal/internet-services/itunes/br/terms.html para ler os termos e condições dos Serviços de Mídia da Apple."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para consultar os termos e condições dos serviços multimédia da Apple, visite www.apple.com/pt/legal/internet-services/itunes/"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru termenele și condițiile Serviciilor multimedia Apple, vizitați www.apple.com/legal/internet-services/itunes/"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы ознакомиться с условиями использования мультимедийных сервисов Apple, перейдите по адресу: www.apple.com/ru/legal/internet-services/itunes/"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmluvné podmienky pre mediálne služby Apple nájdete na stránke www.apple.com/legal/internet-services/itunes/sk/terms.html"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pogoje in določila storitev predstavnostnih vsebin Apple obiščite www.apple.com/legal/internet-services/itunes/"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hittar användarvillkoren för Apple-medietjänster genom att besöka www.apple.com/se/legal/internet-services/itunes/"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับข้อกำหนดและเงื่อนไขของบริการ Apple Media โปรดไปที่ www.apple.com/legal/internet-services/itunes/"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Medya Hizmetleri hüküm ve koşulları için lütfen www.apple.com/tr/legal/internet-services/itunes/tr/terms.html adresine gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Умови та положення медійних сервісів Apple наведено на вебсторінці www.apple.com/legal/internet-services/itunes/"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để biết các điều khoản và điều kiện của Dịch vụ truyền thông của Apple, vui lòng truy cập www.apple.com/legal/internet-services/itunes/"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "如需了解Apple媒体服务的条款与条件，请访问www.apple.com/legal/internet-services/itunes/"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如要了解Apple媒體服務的條款及細則，請瀏覽：https://www.apple.com/hk/legal/internet-services/itunes/hk/terms.html"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若要瞭解「Apple媒體服務」的條款與約定，請參訪：www.apple.com/legal/internet-services/itunes"
          }
        }
      }
