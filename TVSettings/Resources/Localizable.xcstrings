            "state": "translated",
            "value": "Lägg till ett anpassat meddelande i anvisningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มข้อความที่กำหนดเองไปยังคำแนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönergelere özel bir mesaj ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати власне повідомлення до інструкцій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thông báo tùy chỉnh vào hướng dẫn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将自定义信息添加到说明。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在指示中加入自訂訊息。"
          }
        },
        "zh_TW": {
