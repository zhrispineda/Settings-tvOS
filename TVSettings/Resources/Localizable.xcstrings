    "AccountsUserRemoveUserDescriptionAdditionalUser": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل خروج ملف التعريف هذا من هذا الـ Apple TV، ومن ثم إزالة ما يخصه من الوسائط وبيانات التطبيقات في iCloud وحساب Game Center."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca la sessió d’aquest perfil a l’Apple TV i elimina el seu contingut multimèdia, les seves dades d’apps desades a l’iCloud i el seu compte del Game Center."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásí profil z Apple TV a odstraní jeho média, data aplikací na iCloudu a účet v Game Centru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log denne profil ud af dette Apple TV. Brugerens medier, appdata i iCloud og Game Center-konto bliver også fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dieses Profil von diesem Apple TV ab und entferne die zugehörigen Medien, App-Daten in iCloud und den Game Center-Account."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσύνδεση αυτού του προφίλ από αυτό το Apple TV και αφαίρεση των πολυμέσων, των δεδομένων εφαρμογών στο iCloud, και του λογαριασμού Game Center του χρήστη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign this profile out of this Apple TV, removing their media, app data in iCloud, and Game Center account."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign this profile out of this Apple TV, removing their media, app data in iCloud and Game Center account."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign this profile out of this Apple TV, removing their media, app data in iCloud and Game Center account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de este perfil en este Apple TV y se eliminará su contenido multimedia, los datos de sus apps en iCloud y su cuenta de Game Center."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión de este perfil del Apple TV, lo que eliminará sus contenidos multimedia, datos de apps en iCloud y cuenta de Game Center."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión de este perfil del Apple TV, lo que eliminará sus contenidos multimedia, datos de apps en iCloud y cuenta de Game Center."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa tämä profiili ulos tästä Apple TV:stä ja poista sen media, iCloudissa oleva appidata ja Game Center -tili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez ce profil de cette Apple TV pour supprimer ses contenus multimédias, ses données d’apps stockées sur iCloud et son compte Game Center."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez ce profil de cette Apple TV. Cela aura pour effet de supprimer son contenu multimédia, ses données d’apps provenant d’iCloud et son compte Game Center."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנתק פרופיל זה מה-Apple TV ולהסיר את המדיה, את נתוני היישומים ב-iCloud ואת חשבון ה-Game Center שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल को इस Apple TV से साइन आउट करें और उनके मीडिया, iCloud से ऐप डेटा और Game Center खाता हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite ovaj profil s ovog Apple TV-a i time uklonite njegove medije, podatke aplikacija na iCloudu i Game Center račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiléptetheti ezt a profilt erről az Apple TV-ről, valamint eltávolíthatja az iCloud- és Game Center-fiókjában tárolt médiatartalmakat és appadatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarkan profil ini dari Apple TV ini, yang akan menghapus media, data app di iCloud, dan akun Game Center mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il logout di questo profilo su Apple TV, rimuovendone i file multimediali, i dati delle app su iCloud e l’account di Game Center."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple TVからこのプロフィールをサインアウトし、そのプロフィールのメディア、iCloud内のアプリデータ、Game Centerアカウントを削除します。"
