    "AXTypeToSiriDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "value": "اكتب لـ Siri باستخدام لوحة المفاتيح الظاهرة على الشاشة أو لوحة مفاتيح Bluetooth أو تطبيق الريموت.",
            "state": "translated"
          }
        },
        "ca": {
          "stringUnit": {
            "value": "Utilitza “Escriu a Siri” amb el teclat de la pantalla, un teclat Bluetooth o l’app Comandament.",
            "state": "translated"
          }
        },
        "cs": {
          "stringUnit": {
            "value": "K zadávání textu pro Siri můžete použít klávesnici na obrazovce, Bluetooth klávesnici nebo aplikaci Ovladač.",
            "state": "translated"
          }
        },
        "da": {
          "stringUnit": {
            "value": "Skriv til Siri vha. tastaturet på skærmen, et Bluetooth-tastatur eller appen Remote.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Tippe Siri-Anfragen über die Bildschirmtastatur, eine Bluetooth-Tastatur oder die Remote-App ein.",
            "state": "translated"
          }
        },
        "el": {
          "stringUnit": {
            "value": "Πληκτρολογήστε το αίτημά σας για το Siri με το πληκτρολόγιο οθόνης, ένα πληκτρολόγιο Bluetooth ή την εφαρμογή Remote.",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Type to Siri with the onscreen keyboard, a Bluetooth keyboard, or the Remote app.",
            "state": "translated"
          }
        },
        "en_AU": {
          "stringUnit": {
            "value": "Type to Siri with the onscreen keyboard, a Bluetooth keyboard or the Remote app.",
            "state": "translated"
          }
        },
        "en_CA": {
          "stringUnit": {
            "value": "Type to Siri with the onscreen keyboard, a Bluetooth keyboard, or the Remote app.",
            "state": "translated"
          }
        },
        "en_GB": {
          "stringUnit": {
            "value": "Type to Siri with the onscreen keyboard, a Bluetooth keyboard or the Remote app.",
            "state": "translated"
          }
        },
        "en_PH": {
          "stringUnit": {
            "value": "Type to Siri with the onscreen keyboard, a Bluetooth keyboard, or the Remote app.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Escribe a Siri con el teclado en pantalla, con un teclado Bluetooth o con la app Mando.",
            "state": "translated"
          }
        },
        "es_419": {
          "stringUnit": {
            "value": "Escríbele a Siri usando el teclado en pantalla, un teclado Bluetooth o la app Remote.",
            "state": "translated"
          }
        },
        "es_US": {
          "stringUnit": {
            "value": "Escríbele a Siri usando el teclado en pantalla, un teclado Bluetooth o la app Remote.",
            "state": "translated"
          }
        },
        "fi": {
          "stringUnit": {
            "value": "Syötä tekstiä Sirille näytöllä näkyvällä näppäimistöllä, Bluetooth-näppäimistöllä tai Kaukosäädin-apilla.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Écrivez à Siri à l’aide du clavier à l’écran, d’un clavier Bluetooth ou de l’app Remote.",
            "state": "translated"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "value": "Écrivez à Siri avec le clavier à l’écran, un clavier Bluetooth ou l’app Télécommande.",
            "state": "translated"
          }
        },
        "he": {
          "stringUnit": {
            "value": "באפשרותך להקליד את הבקשות שלך ל-Siri באמצעות מקלדת על גבי המסך, מקלדת Bluetooth או היישום ״שלט״.",
            "state": "translated"
          }
        },
        "hi": {
          "stringUnit": {
            "value": "ऑनस्क्रीन कीबोर्ड, Bluetooth कीबोर्ड या रिमोट ऐप से Siri के लिए टाइप करें।",
            "state": "translated"
          }
        },
        "hr": {
          "stringUnit": {
            "value": "Koristite Siri tipkanjem pomoću tipkovnice na zaslonu, Bluetooth tipkovnice ili aplikacije Remote.",
            "state": "translated"
          }
        },
        "hu": {
          "stringUnit": {
            "value": "Sirinek gépelhet a képernyőn megjelenő billentyűzettel, egy Bluetooth-billentyűzettel vagy a Remote appal.",
            "state": "translated"
          }
        },
        "id": {
          "stringUnit": {
            "value": "Ketik ke Siri dengan papan ketik pada layar, papan ketik Bluetooth, atau app Remote.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Scrivi a Siri usando la tastiera su schermo, una tastiera Bluetooth o l’app Remote.",
            "state": "translated"
          }
        },
        "ja": {
          "stringUnit": {
            "value": "オンスクリーンキーボード、Bluetoothキーボード、またはリモコンアプリでSiriにタイプ入力してください。",
            "state": "translated"
          }
        },
        "ko": {
          "stringUnit": {
            "value": "화면상 키보드, Bluetooth 키보드 또는 리모컨 앱에서 타이핑하여 Siri를 사용합니다.",
            "state": "translated"
          }
        },
        "ms": {
          "stringUnit": {
            "value": "Taip kepada Siri dengan papan kekunci atas skrin, papan kekunci Bluetooth atau app Remote.",
            "state": "translated"
          }
        },
        "nl": {
          "stringUnit": {
            "value": "Typ vragen aan Siri met het schermtoetsenbord, een Bluetooth-toetsenbord of de Remote-app.",
            "state": "translated"
          }
        },
        "no": {
          "stringUnit": {
            "value": "Skriv til Siri med tastaturet på skjermen, tilkoblede Bluetooth-tastatur eller fra Fjernkontroll-appen.",
            "state": "translated"
          }
        },
        "pl": {
          "stringUnit": {
            "value": "Z funkcji Napisz do Siri możesz korzystać, używając klawiatury ekranowej lub Bluetooth albo aplikacji Pilot.",
            "state": "translated"
          }
        },
        "pt_BR": {
          "stringUnit": {
            "value": "Digite para a Siri com o teclado na tela, com um teclado Bluetooth ou com o app Remote.",
            "state": "translated"
          }
        },
        "pt_PT": {
          "stringUnit": {
            "value": "Digite para interagir com Siri usando o teclado no ecrã, um teclado Bluetooth ou a aplicação Comando.",
            "state": "translated"
          }
        },
        "ro": {
          "stringUnit": {
            "value": "Tastați pentru Siri cu tastatura de pe ecran, o tastatură Bluetooth sau aplicația Remote.",
            "state": "translated"
          }
        },
        "ru": {
          "stringUnit": {
            "value": "Ввести текст для Siri можно с помощью экранной клавиатуры, клавиатуры Bluetooth или приложения «Пульт».",
            "state": "translated"
          }
        },
        "sk": {
          "stringUnit": {
            "value": "Píšte žiadosti pre Siri na dotykovej klávesnici, Bluetooth klávesnici alebo pomocou apky Ovládač.",
            "state": "translated"
          }
        },
        "sl": {
          "stringUnit": {
            "value": "Vnesite besedilo za Siri z zaslonsko tipkovnico, tipkovnico Bluetooth ali aplikacijo Daljinec.",
            "state": "translated"
          }
        },
        "sv": {
          "stringUnit": {
            "value": "Skriv till Siri med tangentbordet på skärmen, ett Bluetooth-tangentbord eller appen Fjärrkontroll.",
            "state": "translated"
          }
        },
        "th": {
          "stringUnit": {
            "value": "พิมพ์โต้ตอบกับ Siri ด้วยแป้นพิมพ์บนหน้าจอ\nแป้นพิมพ์บลูทูธหรือแป้นพิมพ์ในแอปรีโมท",
            "state": "translated"
          }
        },
        "tr": {
          "stringUnit": {
            "value": "Ekran üzerindeki klavye, bir Bluetooth klavyesi veya Remote uygulaması ile Siri’ye Yazın.",
            "state": "translated"
          }
        },
        "uk": {
          "stringUnit": {
            "value": "Пишіть до Siri за допомогою екранної клавіатури, Bluetooth-клавіатури або програми «Пульт».",
            "state": "translated"
          }
        },
        "vi": {
          "stringUnit": {
            "value": "Nhập liệu vào Siri bằng bàn phím ảo, bàn phím Bluetooth hoặc ứng dụng ĐK từ xa.",
            "state": "translated"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "value": "通过屏幕键盘、蓝牙键盘或“遥控器”App来通过键入使用Siri。",
            "state": "translated"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "value": "使用螢幕鍵盤、藍牙鍵盤或「遙控器」App來輸入以使用Siri。",
            "state": "translated"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "value": "使用螢幕鍵盤、藍牙鍵盤或「遙控器」App以輸入來與Siri對話。",
            "state": "translated"
          }
        }
      }
    },
