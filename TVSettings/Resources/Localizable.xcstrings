    "SelectiveSpeechListeningDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع مستوى صوت الآخرين عندما يوجهون الكلام إليك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenta el volum de la resta de persones quan parlen amb tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zesiluje hlasy lidí, kteří s vámi mluví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forøger lydstyrken fra andre, når de taler til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke anderer Personen wird erhöht, wenn sie mit dir sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυξάνει τον ήχο άλλων ατόμων όταν σας μιλούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increases the volume of others when they are speaking to you."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Increases the volume of others when they are speaking to you."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Increases the volume of others when they are speaking to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de las demás personas aumenta cuando te hablan."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el volumen de las personas cuando te están hablando."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el volumen de las personas cuando te están hablando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää muiden puheäänen voimakkuutta, kun he puhuvat sinulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmente le volume des autres personnes lorsqu’elles vous parlent."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez le son des autres personnes lorsqu’elles s’adressent à vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפיין זה מגביר את עוצמת השמע כאשר אחרים מדברים איתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब अन्य लोग आपसे बात कर रहे होते हैं, तो उनका वॉल्यूम बढ़ाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojačava glasnoću drugih kad vam govore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Növeli a többi személy hangerejét, amikor Önhöz beszélnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningkatkan volume orang lain saat berbicara dengan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza il volume della voce delle altre persone quando ti parlano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人があなたに話しかけているときにその人の声の音量を上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 사용자에게 말할 때 그 사람의 음량을 높입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningkatkan kelantangan orang lain semasa mereka bercakap dengan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrur opp stemmevolumet når andre snakker til deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoog het volume van anderen wanneer ze met je praten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwiększa głośność głosu osób mówiących do Ciebie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o volume de outras pessoas quando elas estão falando com você."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o volume quando alguém fala consigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mărește volumul pentru vocile persoanelor care vorbesc cu dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость речи обращающихся к Вам людей будет повышаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zosilní hlasy ľudí, ktorí s vami hovoria."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povečajte glasnost drugih oseb, kadar govorijo z vami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höjer volymen på andra när de pratar med dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มระดับเสียงของคนที่คุณกำลังพูดด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizinle konuşan diğer kişilerin ses yüksekliğini artırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшує гучність співрозмовників, коли вони говорять до вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng âm lượng của người khác khi họ đang nói với bạn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在他人与你对话时提高其音量。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他人與你交談時提高他們的音量。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他人跟你說話時增加他們的音量。"
          }
        }
      }
    },
