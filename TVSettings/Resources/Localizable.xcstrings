        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils supplémentaires ne sont pas pris en charge sur ce simulateur. Veuillez utiliser un appareil Apple TV."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le simulateur ne prend pas en charge les profils supplémentaires. Veuillez utiliser une Apple TV."
