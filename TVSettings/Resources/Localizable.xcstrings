    "OSUpdateAutomaticallyDescription": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Apple TV تثبيت التحديثات الجديدة تلقائيًا عند توفرها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV pot instal·lar noves actualitzacions automàticament quan estiguin disponibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV může automaticky instalovat nové aktualizace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan automatisk installere nye opdateringer, når de er tilgængelige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kann neue Updates bei deren Verfügbarkeit automatisch installieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple TV μπορεί να εγκαθιστά αυτόματα νέες ενημερώσεις όταν διατίθενται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically install new updates when they’re available."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically install new updates when they’re available."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV can automatically install new updates when they’re available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede instalar automáticamente las actualizaciones nuevas disponibles."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede instalar actualizaciones automáticamente conforme estén disponibles."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple TV puede instalar actualizaciones automáticamente conforme estén disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV voi asentaa uudet päivitykset automaattisesti, kun niitä on saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV peut installer automatiquement les nouvelles mises à jour lorsqu’elles sont disponibles."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV peut installer automatiquement de nouvelles mises à jour lorsqu’elles sont disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Apple TV יכול להתקין באופן אוטומטי עדכונים חדשים כשהם הופכים לזמינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध होने पर Apple TV ऑटोमैटिकली नए अपडेट इंस्टॉल कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV može automatski instalirati nova ažuriranja kad budu dostupna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple TV képes automatikusan telepíteni a frissítéseket, amikor azok elérhetővé válnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV dapat menginstal pembaruan baru secara otomatis saat tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV installerà automaticamente gli aggiornamenti quando saranno disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいアップデートが入手可能になったときに自動的にインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 업데이트가 있으면 Apple TV가 자동으로 설치할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV boleh memasang kemas kini baharu secara automatik apabila tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan automatisk installere nye oppdateringer når de blir tilgjengelige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple TV kan nieuwe updates automatisch installeren wanneer deze beschikbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV może automatycznie instalować nowe uaktualnienia, gdy są dostępne."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV pode instalar novas atualizações automaticamente quando estiverem disponíveis."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando estiverem disponíveis novas atualizações, a Apple TV pode instalá‑las automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noile actualizări disponibile pot fi instalate automat pe Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При наличии обновлений Apple TV может устанавливать их автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV môže automaticky inštalovať nové aktualizácie po ich zverejnení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV lahko samodejno namesti nove posodobitve, ko bodo na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kan installera nya uppdateringar automatiskt när de blir tillgängliga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV สามารถติดตั้งรายการอัปเดตใหม่ได้อัตโนมัติเมื่อมีให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV, kullanılabilir olan yeni güncellemeleri otomatik olarak yükleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV може автоматично інсталювати нові оновлення за наявності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV có thể tự động cài đặt các bản cập nhật mới khi chúng có sẵn."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "有新的更新时，Apple TV会自动安装更新。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會自動安裝可用的更新項目。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV會在有新的更新項目時自動安裝。"
          }
        }
      }
