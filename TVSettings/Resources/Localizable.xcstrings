          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de inicio se actualizará cuando cambies el idioma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koti-valikko päivitetään, kun vaihdat kielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran d’accueil sera actualisé lorsque vous changerez la langue."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran d’accueil se mettra à jour si vous changez de langue."
          }
