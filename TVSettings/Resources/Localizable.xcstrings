          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer le compte Sandbox %@ de cette Apple TV ?"
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous vraiment supprimer le compte Sandbox « %@ » de cette Apple TV?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ברצונך להסיר את חשבון ארגז החול (sandbox) %@ מ-Apple TV זה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निश्चित हैं कि आप इस Apple TV से सैंडबॉक्स खाता %@ को हटाना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurno želite ukloniti račun Sandboxa %@ s ovog Apple TV‑a?"
