    "BTErrorPairingTimeout": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدثت مشكلة أثناء الاقتران مع جهازك. حاول مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha hagut un problema en enllaçar amb el dispositiu. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při párování zařízení došlo k problému. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der var et problem med pardannelse af din enhed. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Koppeln deines Geräts ist ein Problem aufgetreten. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε πρόβλημα κατά τη ζευγοποίηση με τη συσκευή. Δοκιμάστε πάλι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a problem pairing with your device. Try again."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a problem pairing with your device. Try again."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a problem pairing with your device. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha habido un problema al establecer el enlace con tu dispositivo. Inténtalo de nuevo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un problema al enlazar tu dispositivo. Reintenta."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un problema al enlazar tu dispositivo. Reintenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongelma muodostettaessa paria laitteestasi. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors du jumelage de votre appareil. Réessayez."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors du jumelage de votre appareil. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירעה בעיה במהלך הקישור עם המכשיר שלך. נא לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस के साथ पेयरिंग के दौरान समस्या हुई। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo je do problema prilikom uparivanja s vašim uređajem. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Probléma történt az eszközzel való párosításkor. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada masalah saat memasangkan dengan perangkat Anda. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un problema durante l’abbinamento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスとのペアリングで問題が起きました。やり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기와 페어링하는 데 문제가 발생했습니다. 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terdapat masalah berpasangan dengan peranti anda. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppsto et problem under sammenkobling med enhet. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er heeft zich een probleem voorgedaan bij het koppelen met je apparaat. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił problem podczas łączenia w parę z urządzeniem. Spróbuj ponownie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um problema ao emparelhar com o dispositivo. Tente novamente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao emparelhar com o seu dispositivo. Volte a tentar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A existat o problemă la asocierea cu dispozitivul dvs. Reîncercați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать пару с Вашим устройством. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas párovania zariadenia sa vyskytol problém. Skúste to znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri seznanjanju z vašo napravo je prišlo do težave. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det uppstod ett problem när enheten skulle parkopplas. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดปัญหากับการจับคู่กับอุปกรณ์ของคุณ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtınızla eşlemeyle ilgili bir sorun oluştu. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виникла проблема зі спаренням вашого пристрою. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có sự cố trong khi ghép đôi với thiết bị của bạn. Thử lại."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "与你的设备配对时出现问题。请重试。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "配對你的裝置時發生問題。請稍後再試。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "與你的裝置配對發生問題。請再試一次。"
          }
        }
      }
    },
