    "AVChromaSubsampling444Description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفر 4:2:0 صورة عالية الجودة ومتوافقة مع معظم أجهزة التلفزيون وكبلات HDMI، بينما يركز 4:4:4 على مستوى الوضوح ولكنه يحتاج كبلات عالية السرعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El submostratge 4:2:0 proporciona una imatge d’alta qualitat que és compatible amb la majoria de televisors i cables HDMI. El submostratge 4:4:4 augmenta la nitidesa, però necessita cables d’alta velocitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 poskytuje vysoce kvalitní obraz kompatibilní s většinou televizorů a HDMI kabelů. 4:4:4 zlepšuje prokreslení obrazu, vyžaduje však vysokorychlostní kabely."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 giver et billede i høj kvalitet, som er kompatibel med de fleste tv’er og HDMI-kabler. 4:4:4 forbedrer klarheden, men kræver højhastighedskabler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 bietet ein Bild in hochwertiger Qualität, das mit den meisten Fernsehgeräten und HDMI-Kabeln kompatibel ist. 4:4:4 verbessert die Klarheit, erfordert jedoch Hochgeschwindigkeitskabel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μορφή 4:2:0 παρέχει εικόνα υψηλής ποιότητας που είναι συμβατή με τις περισσότερες τηλεοράσεις και καλώδια HDMI. Η μορφή 4:4:4 βελτιώνει την καθαρότητα, όμως απαιτεί καλώδια υψηλής ταχύτητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4:2:0 provides a high-quality picture that is compatible with most TVs and HDMI cables. 4:4:4 improves clarity, but requires high-speed cables."
          }
        },
        "en_AU": {
