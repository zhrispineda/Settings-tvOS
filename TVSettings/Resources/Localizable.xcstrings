    "RCLearnRemoteStartLearningErrorActivityText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على بدء عملية التعرف على الريموت. اضغط على زر Menu (القائمة) أو @@BACK@@ في ريموت Apple TV الأصلي لإعادة المحاولة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut iniciar el procés de reconeixement del comandament. Prem el botó de menú o @@BACK@@ del comandament original de l’Apple TV per tornar‑ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proces nastavení ovladače se nepodařilo zahájit. Na původním ovladači Apple TV stiskněte tlačítko Menu nebo @@BACK@@ a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmering af fjernbetjening kan ikke startes. Tryk på Menu eller @@BACK@@ på den originale Apple TV-fjernbetjening, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anlernen der Fernbedienung konnte nicht gestartet werden. Drücke auf der Apple TV Remote auf „Menu“ oder „@@BACK@@“ und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η έναρξη της διαδικασίας εκμάθησης του τηλεχειριστηρίου. Πατήστε το Menu ή το @@BACK@@ στο Apple TV Remote για νέα δοκιμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start the remote learning process. Press Menu or @@BACK@@ on your original Apple TV Remote to try again."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start the remote learning process. Press Menu or @@BACK@@ on your original Apple TV Remote to try again."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start the remote learning process. Press Menu or @@BACK@@ on your original Apple TV Remote to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar el proceso de configuración del mando a distancia. Pulsa Menú o @@BACK@@ en el mando original del Apple TV para intentarlo de nuevo."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el proceso de aprendizaje del control. Presiona Menu o @@BACK@@ en el control remoto original del Apple TV para reintentar."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el proceso de aprendizaje del control. Presiona Menu o @@BACK@@ en el control remoto original del Apple TV para reintentar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaukosäätimen oppimista ei voida aloittaa. Yritä uudelleen painamalla alkuperäisen Apple TV ‑kaukosäätimen Menu- tai @@BACK@@-painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lancer le processus de mémorisation de la télécommande. Appuyez sur le bouton Menu ou @@BACK@@ de la télécommande d’origine de l’Apple TV et réessayez."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le processus de mémorisation de la télécommande. Appuyez sur le bouton Menu ou @@BACK@@ de la télécommande originale de l’Apple TV pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להפעיל את תהליך למידת השלט. יש ללחוץ על Menu או על @@BACK@@ בשלט המקורי של ה-Apple TV כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट को कॉन्फ़िगर करने का प्रोसेस शुरू करने में असमर्थ। फिर से कोशिश करने के लिए अपने मूल Apple TV रिमोट पर मेन्यू या @@BACK@@ दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupak programiranja upravljača ne može se pokrenuti. Pritisnite Menu ili @@BACK@@ na izvornom upravljaču Apple TV Remote za novi pokušaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távirányító-tanulási folyamat nem indítható el. Nyomja meg az eredeti Apple TV Remote Menu vagy @@BACK@@ gombját az újrapróbálkozáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memulai proses pembelajaran remote. Tekan Menu atau @@BACK@@ di Apple TV Remote asli Anda untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il processo di apprendimento del telecomando. Premi Menu o @@BACK@@ sul telecomando originale per Apple TV per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモコンの学習プロセスを開始できません。元のApple TV RemoteのMENUまたは@@BACK@@を押してから、やり直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리모컨 등록 절차를 시작할 수 없습니다. 다시 시도하려면 원래 Apple TV 리모컨에서 Menu 또는 @@BACK@@ 버튼을 누르십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memulakan proses pembelajaran kawalan jauh. Tekan Menu atau @@BACK@@ pada Apple TV Remote asal anda untuk mencuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke starte læringsprosessen. Trykk på MENU eller @@BACK@@ på den opprinnelige Apple TV-fjernkontrollen for å prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het leren kennen van de afstandsbediening kan niet worden gestart. Druk op de menuknop of @@BACK@@ op de oorspronkelijke Apple TV-afstandsbediening om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można rozpocząć nauki pilota. Naciśnij przycisk Menu lub @@BACK@@ na oryginalnym pilocie Apple TV, aby spróbować ponownie."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível iniciar o processo de aprendizado do controle remoto. Pressione Menu ou @@BACK@@ no controle remoto original da Apple TV para tentar novamente."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o processo de memorização do comando. Prima Menu ou @@BACK@@ no comando original da Apple TV para voltar a tentar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesul de programare a telecomenzii nu a putut fi pornit. Apăsați butonul Meniu sau @@BACK@@ de pe telecomanda originală a Apple TV‑ului pentru a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается начать обучение пульта. Нажмите кнопку Menu или @@BACK@@ на предыдущем пульте Apple TV, затем повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je možné spustiť proces nastavovania ovládača. Stlačte Menu alebo @@BACK@@ na pôvodnom ovládači Apple TV a skúste to znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bilo mogoče zagnati postopka programiranja daljinca. Pritisnite gumb Menu ali @@BACK@@ na originalnem daljincu Apple TV Remote, da poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att starta inlärningsprocessen för fjärrkontrollen. Tryck på menyknappen eller @@BACK@@ på din ursprungliga Apple TV Remote om du vill försöka igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเริ่มกระบวนการเรียนรู้ของรีโมทได้ ให้กดปุ่ม Menu หรือปุ่ม @@BACK@@ บน Apple TV Remote รุ่นเดิมของคุณเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumanda öğrenme işlemi başlatılamadı. Yeniden denemek için ilk Apple TV Remote’ta MENU veya @@BACK@@ düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається запустити процес вивчення пульта. Натисніть кнопку «Меню» чи @@BACK@@ на оригінальному пульті Apple TV, щоб спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu quá trình ghi nhớ điều khiển từ xa. Hãy nhấn Menu hoặc @@BACK@@ trên Apple TV Remote ban đầu của bạn để thử lại."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始遥控器的学习进程。请按下原Apple TV遥控器上的Menu（菜单）按钮或 @@BACK@@，然后重试。"
          }
        },
        "zh_HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動遙控器的學習程序。請按下原有Apple TV遙控器上的Menu（選單）或 @@BACK@@ 以重試。"
          }
        },
        "zh_TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動遙控器的學習程序。請按下原始Apple TV Remote上的Menu（選單）或 @@BACK@@ 按鈕來再試一次。"
          }
        }
      }
    },
    "RCLearnRemoteSubInstructionSuccessText": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمتابعة، توقف عن الضغط على الزر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de prémer el botó per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování tlačítko uvolněte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip knappen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasse die Taste los, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να συνεχίσετε, αφήστε το κουμπί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, stop pressing the button."
          }
        },
        "en_AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, stop pressing the button."
          }
        },
        "en_GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, stop pressing the button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, deja de pulsar el botón."
          }
        },
        "es_419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, suelta el botón."
          }
        },
        "es_US": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, suelta el botón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka lopettamalla painikkeen painaminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, relâchez votre pression sur le bouton."
          }
        },
        "fr_CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, relâchez le bouton."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להמשיך, יש להפסיק ללחוץ על הכפתור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए बटन छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nastavak, prestanite pritiskati tipku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáshoz engedje el a gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melanjutkan, berhenti menekan tombol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare, non premere più il tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには、ボタンを放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 버튼 누르기를 중단하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk meneruskan, hentikan menekan butang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp knappen for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de knop los om verder te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, przestań naciskać przycisk."
          }
        },
        "pt_BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, pare de pressionar o botão."
          }
        },
        "pt_PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, deixe de premir o botão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a continua, încetați apăsarea butonului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, отпустите эту кнопку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre pokračovanie uvoľnite tlačidlo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nadaljevanje prenehajte pritiskati gumb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp upp knappen när du vill fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการดำเนินการต่อ ให้หยุดกดปุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürdürmek için düğmeye basmayı bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, припиніть тиснути кнопку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
